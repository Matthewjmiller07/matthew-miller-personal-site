# Supabase Environment Variables
# Copy this file to .env and fill in your Supabase credentials

# Get these from your Supabase project settings -> API
PUBLIC_SUPABASE_URL=your-supabase-project-url
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Maps browser key used by Ocean Premium (restrict by site and API in Google Cloud)
PUBLIC_OCEAN_PREMIUM_API_KEY=
PUBLIC_GOOGLE_MAPS_API_KEY=

# Printify API
# Personal Access Token (keep secret; do NOT commit real token)
PRINTIFY_API_TOKEN=

# Optional: If you have multiple shops, set this. Otherwise, the first shop will be used.
PRINTIFY_SHOP_ID=

# Daily.co Video Streaming
# Get these from your Daily.co dashboard
DAILY_API_KEY=your-daily-api-key
DAILY_ROOM_URL=https://your-team.daily.co/yahrzeit-shiur

# Yahrzeit host login
YAHRZEIT_ADMIN_PASSWORD=your-yahrzeit-host-password
DAILY_HOST_TOKEN=your-pre-generated-daily-host-token

# Baby Naming Ceremony
# The Daily.co private room URL (e.g. https://theothermatthewmiller.daily.co/Baby)
BABYNAMING_ROOM_URL=https://theothermatthewmiller.daily.co/Baby
# Room name only (must match the room in your Daily.co dashboard)
BABYNAMING_ROOM_NAME=Baby
# Password hosts use to get a meeting token minted for the private room
BABYNAMING_ADMIN_PASSWORD=your-babynaming-host-password

# Google Drive SCP Sync
# Get the folder ID from your Google Drive URL: https://drive.google.com/drive/folders/[FOLDER_ID]
GOOGLE_DRIVE_SCP_FOLDER_ID=1xsWSHOQGk8aO3u2Qq1qVEG2-fhjvhHe6

# Option 1: API Key (easiest for public folders)
# Get from Google Cloud Console: APIs & Services > Credentials > Create API Key
# Folder must be "Anyone with the link can view"
GOOGLE_DRIVE_API_KEY=

# Option 2: Service Account (for private folders)
# Service account JSON key (paste the entire JSON content here)
# OR set GOOGLE_APPLICATION_CREDENTIALS to point to a JSON file
GOOGLE_SERVICE_ACCOUNT_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Sofer AI — Hebrew-aware transcription for SCP shiurim
# Get your API key from https://sofer.ai
# Audio files are auto-transcribed when synced from Drive if this key is set
SOFER_AI_API_KEY=

# Hugging Face (semantic search — embeddings via Inference Providers)
# Create a fine-grained token with "Inference Providers" permission:
# https://huggingface.co/settings/tokens/new?ownUserPermissions=inference.serverless.write&tokenType=fineGrained
# Needed at build time (scripts/build-search-index.mjs) and at runtime (/api/search).
HF_TOKEN=

# Israel life tracker (/israel)
# Reads use the public anon key above (RLS allows SELECT only). Writes go through
# /api/israel, which needs both of these — keep them out of any PUBLIC_ variable.
# Service role key: Supabase dashboard > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=
# Whatever passphrase you want to type before the logging forms appear
ISRAEL_TRACKER_PASSWORD=
