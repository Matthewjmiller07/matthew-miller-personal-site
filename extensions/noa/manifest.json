{
  "manifest_version": 3,
  "name": "Talk to Noa — Hebrew practice",
  "short_name": "Noa",
  "version": "1.0.0",
  "description": "A two-minute Hebrew chat with Noa, a curious seven-year-old. From Kolnoa at theothermatthewmiller.com.",
  "action": {
    "default_title": "Talk to Noa",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "host_permissions": ["https://theothermatthewmiller.com/api/kolnoa-noa"]
}
