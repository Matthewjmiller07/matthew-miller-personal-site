<script is:inline>
  function unfoldIcs(text) {
    return text.replace(/\r\n[ \t]/g, '').replace(/\n[ \t]/g, '');
  }

  function unescapeIcsText(s) {
    return (s ?? '')
      .replace(/\\n/gi, '\n')
      .replace(/\\,/g, ',')
      .replace(/\\;/g, ';')
      .replace(/\\\\/g, '\\');
  }

  function parseIcs(text) {
    const lines = unfoldIcs(text).split(/\r\n|\n/);
    const events = [];
    let cur = null;
    for (const line of lines) {
      if (line === 'BEGIN:VEVENT') { cur = {}; continue; }
      if (line === 'END:VEVENT') { if (cur) events.push(cur); cur = null; continue; }
      if (!cur) continue;
      const idx = line.indexOf(':');
      if (idx === -1) continue;
      const rawKey = line.slice(0, idx);
      const value = line.slice(idx + 1);
      const key = rawKey.split(';')[0];
      if (key === 'DTSTART') {
        cur.allDay = rawKey.includes('VALUE=DATE');
        cur.dtstart = value;
      } else if (key === 'SUMMARY') {
        cur.summary = unescapeIcsText(value);
      } else if (key === 'DESCRIPTION') {
        cur.description = unescapeIcsText(value);
      } else if (key === 'LOCATION') {
        cur.location = unescapeIcsText(value);
      } else if (key === 'URL') {
        cur.url = value;
      }
    }
    return events;
  }

  function parseIcsDate(dtstart, allDay) {
    const y = +dtstart.slice(0, 4), mo = +dtstart.slice(4, 6), d = +dtstart.slice(6, 8);
    if (allDay) return new Date(Date.UTC(y, mo - 1, d));
    const h = +dtstart.slice(9, 11), mi = +dtstart.slice(11, 13), s = +dtstart.slice(13, 15) || 0;
    return new Date(Date.UTC(y, mo - 1, d, h, mi, s));
  }

  function formatEventDate(ev) {
    const date = parseIcsDate(ev.dtstart, ev.allDay);
    const opts = ev.allDay
      ? { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }
      : { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: 'America/Chicago' };
    return date.toLocaleString('en-US', opts);
  }

  function escapeHtml(s) {
    const div = document.createElement('div');
    div.textContent = s ?? '';
    return div.innerHTML;
  }

  // Language of the nearest page-level toggle scope an element sits in
  // (defaults to English when there's no toggle on the page at all).
  function getLang(el) {
    return el.closest('.lang-scope')?.dataset.lang || 'en';
  }

  const STRINGS = {
    en: {
      loading: 'Loading events…',
      loadError: 'Could not load events — try downloading the .ics instead.',
      copied: 'Copied!',
      eventCount: (n) => `${n} event${n === 1 ? '' : 's'}`,
    },
    he: {
      loading: 'טוען אירועים…',
      loadError: 'לא ניתן לטעון את האירועים — נסו להוריד את קובץ ה-.ics במקום.',
      copied: 'הועתק!',
      eventCount: (n) => `${n} אירועים`,
    },
  };

  function renderEvents(listEl, countEl, events, lang) {
    const t = STRINGS[lang] || STRINGS.en;
    const sorted = [...events].sort((a, b) => parseIcsDate(a.dtstart, a.allDay) - parseIcsDate(b.dtstart, b.allDay));
    const frag = document.createDocumentFragment();
    for (const ev of sorted) {
      const li = document.createElement('li');
      li.className = 'event-item py-2.5 border-b border-border-light/50 dark:border-border-dark/50 last:border-0';
      li.dataset.search = `${ev.summary ?? ''} ${ev.description ?? ''} ${ev.location ?? ''}`.toLowerCase();
      const titleHtml = ev.url
        ? `<a href="${ev.url}" target="_blank" rel="noopener noreferrer" class="hover:underline">${escapeHtml(ev.summary)}</a>`
        : escapeHtml(ev.summary);
      const showDescription = ev.description && ev.description !== ev.url;
      li.innerHTML = `
        <div class="flex items-baseline justify-between gap-3">
          <span class="text-sm font-medium text-primary-light dark:text-primary-dark">${titleHtml}</span>
          <span class="text-xs text-secondary-light dark:text-secondary-dark whitespace-nowrap">${formatEventDate(ev)}</span>
        </div>
        ${ev.location ? `<div class="text-xs text-secondary-light dark:text-secondary-dark mt-0.5">📍 ${escapeHtml(ev.location)}</div>` : ''}
        ${showDescription ? `<p class="text-xs text-secondary-light/80 dark:text-secondary-dark/80 mt-1 whitespace-pre-line">${escapeHtml(ev.description)}</p>` : ''}
      `;
      frag.append(li);
    }
    listEl.innerHTML = '';
    listEl.append(frag);
    countEl.textContent = t.eventCount(sorted.length);
  }

  async function loadEventsForButton(btn) {
    const lang = getLang(btn);
    const t = STRINGS[lang] || STRINGS.en;
    const panel = btn.nextElementSibling;
    const listEl = panel.querySelector('.events-list');
    const statusEl = panel.querySelector('.events-status');
    const countEl = panel.querySelector('.events-count');
    statusEl.textContent = t.loading;
    try {
      const res = await fetch(btn.dataset.icsUrl);
      const text = await res.text();
      renderEvents(listEl, countEl, parseIcs(text), lang);
      statusEl.textContent = '';
      btn.dataset.loaded = 'true';
    } catch {
      statusEl.textContent = t.loadError;
    }
  }

  document.addEventListener('astro:page-load', async () => {
    document.querySelectorAll('.view-events-btn').forEach(btn => {
      const panel = btn.nextElementSibling;
      const listEl = panel.querySelector('.events-list');
      const searchInput = panel.querySelector('.events-search');

      btn.addEventListener('click', async () => {
        const wasExpanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!wasExpanded));
        panel.classList.toggle('hidden');
        btn.querySelector('.chevron').classList.toggle('rotate-180');

        if (btn.dataset.loaded === 'true' || wasExpanded) return;
        await loadEventsForButton(btn);
      });

      searchInput.addEventListener('input', () => {
        const q = searchInput.value.trim().toLowerCase();
        listEl.querySelectorAll('.event-item').forEach(li => {
          li.classList.toggle('hidden', q.length > 0 && !li.dataset.search.includes(q));
        });
      });
    });

    // Page-level English/Hebrew toggle — swaps every [data-en]/[data-he] text
    // node and [data-href-en]/[data-href-he] link inside the nearest
    // .lang-scope ancestor (name/description/note, subscribe-button labels
    // and hrefs, the displayed ICS URL, page copy), and — if the inline
    // event viewer is already open — re-fetches it in the new language.
    document.querySelectorAll('.lang-toggle-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const scope = btn.closest('.lang-scope');
        const lang = btn.dataset.lang;
        if (!scope || scope.dataset.lang === lang) return;
        scope.dataset.lang = lang;
        scope.dir = lang === 'he' ? 'rtl' : 'ltr';

        scope.querySelectorAll('.lang-toggle-btn').forEach(b => {
          const active = b.dataset.lang === lang;
          b.classList.toggle('bg-accent', active);
          b.classList.toggle('text-white', active);
          b.classList.toggle('border-accent', active);
          b.classList.toggle('border-border-light', !active);
          b.classList.toggle('dark:border-border-dark', !active);
          b.classList.toggle('text-secondary-light', !active);
          b.classList.toggle('dark:text-secondary-dark', !active);
        });

        scope.querySelectorAll('[data-en]').forEach(el => {
          const val = lang === 'he' ? (el.dataset.he || el.dataset.en) : el.dataset.en;
          el.textContent = val;
        });

        scope.querySelectorAll('[data-en-html]').forEach(el => {
          el.innerHTML = lang === 'he' ? (el.dataset.heHtml || el.dataset.enHtml) : el.dataset.enHtml;
        });

        scope.querySelectorAll('[data-href-en]').forEach(el => {
          const val = lang === 'he' ? (el.dataset.hrefHe || el.dataset.hrefEn) : el.dataset.hrefEn;
          el.setAttribute('href', val);
        });

        scope.querySelectorAll('[data-placeholder-en]').forEach(el => {
          el.placeholder = lang === 'he' ? (el.dataset.placeholderHe || el.dataset.placeholderEn) : el.dataset.placeholderEn;
        });

        scope.querySelectorAll('.copy-btn').forEach(copyBtn => {
          copyBtn.dataset.copy = lang === 'he' ? (copyBtn.dataset.copyHe || copyBtn.dataset.copyEn) : copyBtn.dataset.copyEn;
        });

        scope.querySelectorAll('.view-events-btn').forEach(viewBtn => {
          const url = lang === 'he' ? (viewBtn.dataset.icsUrlHe || viewBtn.dataset.icsUrlEn) : viewBtn.dataset.icsUrlEn;
          if (!url || url === viewBtn.dataset.icsUrl) return;
          viewBtn.dataset.icsUrl = url;
          viewBtn.dataset.loaded = 'false';
          const panel = viewBtn.nextElementSibling;
          if (!panel.classList.contains('hidden')) {
            loadEventsForButton(viewBtn);
          }
        });
      });
    });

    // Upcoming holidays via the whenarethejewishholidays.com API
    const box = document.getElementById('upcoming-holidays');
    const list = document.getElementById('upcoming-holidays-list');
    if (box && list && !list.children.length) {
      try {
        const res = await fetch('https://whenarethejewishholidays.com/api/v1/holidays/next?count=4');
        const data = await res.json();
        const today = new Date(); today.setHours(0, 0, 0, 0);
        for (const h of data.holidays) {
          const days = Math.round((new Date(`${h.date}T00:00:00`) - today) / 86400000);
          const li = document.createElement('li');
          li.className = 'flex items-baseline justify-between gap-3 border-b border-border-light/50 dark:border-border-dark/50 pb-1.5';
          li.innerHTML = `
            <span class="text-primary-light dark:text-primary-dark font-medium"></span>
            <span class="text-xs text-secondary-light dark:text-secondary-dark whitespace-nowrap"></span>`;
          li.children[0].textContent = h.title;
          li.children[1].textContent = `${h.weekday.slice(0, 3)} ${h.date} · in ${days} day${days === 1 ? '' : 's'}`;
          list.append(li);
        }
        box.classList.remove('hidden');
      } catch { /* API unreachable — leave the section hidden */ }
    }

    document.querySelectorAll('.copy-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const text = btn.dataset.copy;
        const label = btn.querySelector('.copy-btn-label');
        navigator.clipboard.writeText(text).then(() => {
          if (!label) return;
          const original = label.textContent;
          label.textContent = STRINGS[getLang(btn)].copied;
          setTimeout(() => { label.textContent = original; }, 2000);
        });
      });
    });
  });
</script>
