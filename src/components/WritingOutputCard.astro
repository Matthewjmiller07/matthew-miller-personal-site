---
// Card used by the Projects page's "Writing & Outputs" section (and its
// "Parasha Sheets" subsection) — pulled out so both grids can share it.
interface Props {
    project: {
        name: string;
        kind?: string;
        description: string;
        rabbanim?: string[];
        descriptionAfter?: string;
        pageUrl?: string;
        downloadUrl?: string;
        previewImage?: string;
    };
}
const { project } = Astro.props;
---
<div class="bg-card-bg-light dark:bg-card-bg-dark rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-300 flex flex-col group hover:bg-accent transition-colors">
    <div class="px-4 pt-4 mb-2">
        {project.kind && (
            <span class="inline-block text-[0.65rem] uppercase tracking-wider bg-accent/10 text-accent dark:bg-accent/20 dark:text-accent-light px-2 py-0.5 rounded-full font-medium mb-1.5 group-hover:bg-white/20 group-hover:text-white transition-colors">
                {project.kind}
            </span>
        )}
        <h3 class="text-lg font-bold text-primary-light dark:text-primary-dark group-hover:text-white transition-colors">{project.name}</h3>
    </div>
    {project.previewImage && (
        <a href={project.pageUrl || project.downloadUrl} class="block aspect-[16/9] bg-white/5 group focus:outline-none">
            <img
                src={project.previewImage}
                alt={`Preview of ${project.name}`}
                class="object-cover w-full h-full group-hover:opacity-80 transition-opacity duration-200"
                loading="lazy"
            />
            <span class="sr-only">Open {project.name}</span>
        </a>
    )}
    <div class="p-4 pt-3 text-sm">
        <div class="flex justify-start items-center mb-2">
            <button class="text-xs bg-accent/10 text-accent dark:bg-accent/20 dark:text-accent-light px-2 py-1 rounded-md hover:bg-accent/20 transition-colors group-hover:bg-white/20 group-hover:text-white expand-btn" data-expanded="false">
                <span class="show-text">Show Details</span>
                <span class="hide-text hidden">Hide Details</span>
            </button>
        </div>

        <div class="description-content hidden overflow-hidden transition-all duration-300" style="max-height: 0;">
            <p class="text-secondary-light dark:text-secondary-dark mb-2 leading-snug group-hover:text-white transition-colors">{project.description}</p>
            {project.rabbanim && (
                <>
                    <p class="mb-1 font-semibold text-primary-light dark:text-primary-dark text-xs group-hover:text-white transition-colors">Featured rabbanim include:</p>
                    <ul class="list-disc pl-5 mb-2 text-secondary-light dark:text-secondary-dark text-xs group-hover:text-white transition-colors">
                        {project.rabbanim.map(rabbi => <li>{rabbi}</li>)}
                    </ul>
                </>
            )}
            {project.descriptionAfter && (
                <p class="text-secondary-light dark:text-secondary-dark text-xs group-hover:text-white transition-colors">{project.descriptionAfter}</p>
            )}
        </div>
        <div class="flex flex-wrap gap-2 mt-2">
            {project.pageUrl && (
                <a
                    href={project.pageUrl}
                    class="inline-flex items-center px-3 py-1.5 bg-accent hover:bg-accent/90 text-white rounded-md text-xs transition-colors duration-200 group-hover:bg-white group-hover:text-accent"
                >
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                    </svg>
                    Read online
                </a>
            )}
            {project.downloadUrl && (
                <a
                    href={project.downloadUrl}
                    class={`inline-flex items-center px-3 py-1.5 rounded-md text-xs transition-colors duration-200 ${project.pageUrl
                        ? 'border border-accent text-accent dark:text-accent-light hover:bg-accent/10 group-hover:border-white group-hover:text-white'
                        : 'bg-accent hover:bg-accent/90 text-white group-hover:bg-white group-hover:text-accent'}`}
                    download
                >
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                    </svg>
                    Download PDF
                </a>
            )}
        </div>
    </div>
</div>
