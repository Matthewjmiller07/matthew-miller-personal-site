---
// Card used by the Projects page's "Writing & Outputs" section (and its
// "Parasha Sheets" subsection) — pulled out so both grids can share it.
// Styles live in projects.astro under `.ws .wcard`.
interface Props {
    project: {
        name: string;
        kind?: string;
        description: string;
        rabbanim?: string[];
        descriptionAfter?: string;
        pageUrl?: string;
        downloadUrl?: string;
        previewImage?: string;
    };
}
const { project } = Astro.props;
const searchText = [project.name, project.kind, project.description, ...(project.rabbanim || []), project.descriptionAfter]
    .filter(Boolean).join(" ").toLowerCase();
const initials = project.name.split(/[\s—-]+/).filter(w => /^[A-Z0-9]/.test(w)).slice(0, 2).map(w => w[0]).join("").toUpperCase();
---
<article class="card wcard" data-cat="writing" data-text={searchText}>
    <a href={project.pageUrl || project.downloadUrl} class="thumb block" tabindex="-1">
        {project.previewImage ? (
            <img src={project.previewImage} alt={`Preview of ${project.name}`} loading="lazy" />
        ) : (
            <div class="mono-tile" aria-hidden="true"><span>{initials}</span></div>
        )}
    </a>
    <div class="card-body">
        {project.kind && <span class="pill">{project.kind}</span>}
        <h3>{project.name}</h3>
        <p class="clamp3">{project.description}</p>
        {(project.rabbanim || project.descriptionAfter) && (
            <details>
                <summary>Details</summary>
                <div class="details">
                    {project.rabbanim && (
                        <>
                            <p class="lbl">Featured rabbanim include:</p>
                            <ul>{project.rabbanim.map(rabbi => <li>{rabbi}</li>)}</ul>
                        </>
                    )}
                    {project.descriptionAfter && <p>{project.descriptionAfter}</p>}
                </div>
            </details>
        )}
        <div class="wactions">
            {project.pageUrl && (
                <a href={project.pageUrl} class="wbtn solid">
                    <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                    </svg>
                    Read online
                </a>
            )}
            {project.downloadUrl && (
                <a href={project.downloadUrl} class={`wbtn ${project.pageUrl ? "" : "solid"}`} download>
                    <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                    </svg>
                    Download PDF
                </a>
            )}
        </div>
    </div>
</article>
