---
// Standalone layout for the WarmHouse brand pages: its own look, no personal-site nav.
export interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const site = 'https://theothermatthewmiller.com';
const url = `${site}${Astro.url.pathname}`;
const og = `${site}/warmhouse/og.jpg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/warmhouse/favicon.svg" />
    <meta name="theme-color" content="#F6EFE4" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={og} />
    <meta property="og:site_name" content="WarmHouse" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={og} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="wh">
    <slot />
  </body>
</html>

<style is:global>
  .wh {
    --paper: #f6efe4;
    --paper-2: #efe5d5;
    --card: #fbf7f0;
    --ink: #2a211b;
    --ink-2: #5d5046;
    --ink-3: #8a7b6e;
    --line: #dccfbb;
    --ember: #b9482a;
    --ember-dark: #973a21;
    --moss: #4f6b4a;
    --brass: #b08d4c;
    --serif: 'Fraunces', 'Iowan Old Style', Georgia, serif;
    --sans: 'DM Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 17px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  .wh *, .wh *::before, .wh *::after { box-sizing: border-box; }
  .wh a { color: inherit; }
  .wh h1, .wh h2, .wh h3 { font-family: var(--serif); font-weight: 500; line-height: 1.1; letter-spacing: -0.015em; margin: 0; text-wrap: balance; }
  .wh p { margin: 0; text-wrap: pretty; }
  .wh-wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px; }
  .wh-eyebrow { font-size: 0.76rem; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 600; color: var(--ember); }
  .wh-btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.5em; padding: 0.85em 1.5em; border-radius: 999px; font: 600 1rem var(--sans); text-decoration: none; border: 1.5px solid var(--ink); cursor: pointer; transition: background 0.15s, color 0.15s, transform 0.15s; }
  .wh-btn:hover { transform: translateY(-1px); }
  .wh-btn-solid { background: var(--ember); border-color: var(--ember); color: #fff8ef !important; }
  .wh-btn-solid:hover { background: var(--ember-dark); border-color: var(--ember-dark); }
  .wh-btn-ghost { background: transparent; color: var(--ink); }
  .wh-btn-ghost:hover { background: var(--ink); color: var(--paper) !important; }
  .wh :focus-visible { outline: 2px solid var(--ember); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) { .wh * { transition: none !important; scroll-behavior: auto !important; } }
  html:has(.wh) { scroll-behavior: smooth; }
</style>
