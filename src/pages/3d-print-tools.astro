---
import Layout from '../layouts/Layout.astro';
---

<Layout
    title="3D Print Tools"
    description="Free browser tools for 3D printing: STL viewer and stats, scaling, print cost estimator, bed-fit checker, filament converter, a sand castle mold generator that turns any STL into a printable beach mold, plus lithophane, QR code plaque, and name tag generators."
>
    <main class="max-w-7xl mx-auto px-4 py-8 text-gray-100">
        <header class="mb-8">
            <h1 class="text-3xl md:text-4xl font-bold">3D Print Tools</h1>
            <p class="mt-2 text-gray-400 max-w-3xl">
                A toolbox that runs entirely in your browser — nothing is uploaded anywhere.
                Load an STL to inspect it, scale it, estimate cost, and (the fun part) turn it into a
                <strong class="text-amber-300">sand castle mold</strong>: a printable negative you pack with wet sand and flip over at the beach.
            </p>
        </header>

        <!-- Upload zone -->
        <div id="dropzone" class="border-2 border-dashed border-gray-600 hover:border-amber-400 transition-colors rounded-xl p-8 text-center cursor-pointer bg-gray-900/40 mb-8">
            <p class="text-lg font-medium">Drop an STL file here, or click to choose one</p>
            <p class="text-sm text-gray-400 mt-1">Binary or ASCII STL · stays on your device</p>
            <p class="mt-4">
                <button id="demo-btn" class="px-4 py-2 rounded-lg bg-amber-600 hover:bg-amber-500 text-white font-medium" type="button">
                    No file handy? Load the demo castle 🏰
                </button>
            </p>
            <input id="file-input" type="file" accept=".stl,model/stl" class="hidden" />
        </div>

        <div id="workspace" class="hidden grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Viewer column -->
            <div class="lg:sticky lg:top-20 self-start">
                <div class="rounded-xl overflow-hidden border border-gray-700 bg-gray-900">
                    <div id="viewer" class="w-full" style="height: 480px;"></div>
                    <div class="flex flex-wrap items-center gap-2 p-3 border-t border-gray-700 text-sm">
                        <span class="text-gray-400 mr-1">Viewing:</span>
                        <button id="view-model-btn" class="px-3 py-1 rounded bg-amber-600 text-white" type="button">Model</button>
                        <button id="view-mold-btn" class="px-3 py-1 rounded bg-gray-700 text-gray-300 disabled:opacity-40" type="button" disabled>Sand mold</button>
                        <span class="flex-1"></span>
                        <span class="text-gray-400 mr-1">Rotate:</span>
                        <button class="rot-btn px-2 py-1 rounded bg-gray-700 hover:bg-gray-600" data-axis="x" type="button">X 90°</button>
                        <button class="rot-btn px-2 py-1 rounded bg-gray-700 hover:bg-gray-600" data-axis="y" type="button">Y 90°</button>
                        <button class="rot-btn px-2 py-1 rounded bg-gray-700 hover:bg-gray-600" data-axis="z" type="button">Z 90°</button>
                    </div>
                </div>
                <p class="text-xs text-gray-500 mt-2">Drag to orbit · scroll to zoom · right-drag to pan. Rotate the model so it stands “up” the way it should sit on the sand before generating a mold.</p>
            </div>

            <!-- Tools column -->
            <div class="space-y-6">
                <!-- Stats -->
                <section class="rounded-xl border border-gray-700 bg-gray-900/60 p-5">
                    <h2 class="text-xl font-semibold mb-3">📐 Model stats</h2>
                    <dl class="grid grid-cols-2 gap-x-6 gap-y-2 text-sm">
                        <dt class="text-gray-400">File</dt><dd id="stat-name" class="text-right font-mono truncate">—</dd>
                        <dt class="text-gray-400">Size (X × Y × Z)</dt><dd id="stat-dims" class="text-right font-mono">—</dd>
                        <dt class="text-gray-400">Volume</dt><dd id="stat-volume" class="text-right font-mono">—</dd>
                        <dt class="text-gray-400">Surface area</dt><dd id="stat-area" class="text-right font-mono">—</dd>
                        <dt class="text-gray-400">Triangles</dt><dd id="stat-tris" class="text-right font-mono">—</dd>
                    </dl>
                    <div class="mt-4">
                        <h3 class="text-sm font-medium text-gray-300 mb-2">Fits on common printers?</h3>
                        <ul id="bed-fit" class="text-sm grid grid-cols-1 sm:grid-cols-2 gap-1"></ul>
                    </div>
                </section>

                <!-- Scale -->
                <section class="rounded-xl border border-gray-700 bg-gray-900/60 p-5">
                    <h2 class="text-xl font-semibold mb-3">📏 Scale &amp; export</h2>
                    <div class="flex flex-wrap items-end gap-3 text-sm">
                        <label class="flex flex-col gap-1">
                            <span class="text-gray-400">Scale by %</span>
                            <input id="scale-pct" type="number" value="100" min="1" step="1" class="w-28 rounded bg-gray-800 border border-gray-600 px-2 py-1.5" />
                        </label>
                        <button id="scale-pct-btn" class="px-3 py-1.5 rounded bg-gray-700 hover:bg-gray-600" type="button">Apply %</button>
                        <label class="flex flex-col gap-1">
                            <span class="text-gray-400">…or longest side → mm</span>
                            <input id="scale-target" type="number" min="1" step="1" placeholder="e.g. 150" class="w-28 rounded bg-gray-800 border border-gray-600 px-2 py-1.5" />
                        </label>
                        <button id="scale-target-btn" class="px-3 py-1.5 rounded bg-gray-700 hover:bg-gray-600" type="button">Resize</button>
                    </div>
                    <button id="export-model-btn" class="mt-4 px-4 py-2 rounded-lg bg-emerald-700 hover:bg-emerald-600 text-white font-medium" type="button">
                        ⬇️ Download model as STL
                    </button>
                    <p class="text-xs text-gray-500 mt-2">Exports include any rotation/scaling you applied here. Units are millimeters (standard STL convention).</p>
                </section>

                <!-- Sand mold -->
                <section class="rounded-xl border border-amber-700/60 bg-amber-950/20 p-5">
                    <h2 class="text-xl font-semibold mb-1">🏖️ Sand castle mold maker</h2>
                    <p class="text-sm text-gray-400 mb-4">
                        Generates a printable <em>negative</em> of your model — a bucket-style mold. Pack it with wet sand,
                        flip it over, lift, and your model appears in sand. The generator views the model from above
                        (overhangs are automatically filled in, just like a real sand mold requires), and the result
                        prints flat-side-down with <strong>zero supports</strong>.
                    </p>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-sm">
                        <label class="flex flex-col gap-1">
                            <span class="text-gray-400">Wall thickness (mm)</span>
                            <input id="mold-wall" type="number" value="4" min="1.2" max="20" step="0.4" class="rounded bg-gray-800 border border-gray-600 px-2 py-1.5" />
                        </label>
                        <label class="flex flex-col gap-1">
                            <span class="text-gray-400">Detail (grid resolution)</span>
                            <select id="mold-res" class="rounded bg-gray-800 border border-gray-600 px-2 py-1.5">
                                <option value="96">Low (96)</option>
                                <option value="160" selected>Medium (160)</option>
                                <option value="224">High (224)</option>
                                <option value="288">Very high (288)</option>
                            </select>
                        </label>
                        <label class="flex flex-col gap-1">
                            <span class="text-gray-400">Smoothing passes</span>
                            <select id="mold-smooth" class="rounded bg-gray-800 border border-gray-600 px-2 py-1.5">
                                <option value="0">None</option>
                                <option value="1" selected>Light</option>
                                <option value="2">Medium</option>
                                <option value="4">Heavy</option>
                            </select>
                        </label>
                    </div>
                    <div class="flex flex-wrap gap-3 mt-4">
                        <button id="mold-btn" class="px-4 py-2 rounded-lg bg-amber-600 hover:bg-amber-500 text-white font-medium" type="button">🪣 Generate mold</button>
                        <button id="export-mold-btn" class="px-4 py-2 rounded-lg bg-emerald-700 hover:bg-emerald-600 text-white font-medium disabled:opacity-40" type="button" disabled>⬇️ Download mold STL</button>
                    </div>
                    <p id="mold-info" class="text-sm text-amber-200/80 mt-3"></p>
                </section>

                <!-- Cost estimator -->
                <section class="rounded-xl border border-gray-700 bg-gray-900/60 p-5">
                    <h2 class="text-xl font-semibold mb-3">💰 Print cost &amp; time estimator</h2>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-sm">
                        <label class="flex flex-col gap-1">
                            <span class="text-gray-400">Material</span>
                            <select id="cost-material" class="rounded bg-gray-800 border border-gray-600 px-2 py-1.5">
                                <option value="1.24" selected>PLA</option>
                                <option value="1.27">PETG</option>
                                <option value="1.04">ABS</option>
                                <option value="1.07">ASA</option>
                                <option value="1.21">TPU</option>
                                <option value="1.14">Nylon</option>
                            </select>
                        </label>
                        <label class="flex flex-col gap-1">
                            <span class="text-gray-400">Infill %</span>
                            <input id="cost-infill" type="number" value="15" min="0" max="100" step="5" class="rounded bg-gray-800 border border-gray-600 px-2 py-1.5" />
                        </label>
                        <label class="flex flex-col gap-1">
                            <span class="text-gray-400">$ / kg</span>
                            <input id="cost-price" type="number" value="20" min="1" step="1" class="rounded bg-gray-800 border border-gray-600 px-2 py-1.5" />
                        </label>
                        <label class="flex flex-col gap-1">
                            <span class="text-gray-400">Quality</span>
                            <select id="cost-quality" class="rounded bg-gray-800 border border-gray-600 px-2 py-1.5">
                                <option value="24">Draft 0.28mm</option>
                                <option value="15" selected>Standard 0.2mm</option>
                                <option value="8">Fine 0.12mm</option>
                            </select>
                        </label>
                    </div>
                    <dl class="grid grid-cols-2 gap-x-6 gap-y-2 text-sm mt-4">
                        <dt class="text-gray-400">Estimated weight</dt><dd id="cost-weight" class="text-right font-mono">—</dd>
                        <dt class="text-gray-400">Filament used (1.75mm)</dt><dd id="cost-length" class="text-right font-mono">—</dd>
                        <dt class="text-gray-400">Material cost</dt><dd id="cost-cost" class="text-right font-mono">—</dd>
                        <dt class="text-gray-400">Rough print time</dt><dd id="cost-time" class="text-right font-mono">—</dd>
                    </dl>
                    <p class="text-xs text-gray-500 mt-2">Rule-of-thumb estimate (walls ≈ 15% of solid volume plus infill). Your slicer has the final word.</p>
                </section>
            </div>
        </div>

        <!-- Generators: create a model from scratch -->
        <section class="mt-8">
            <h2 class="text-2xl font-bold mb-1">✨ Generators</h2>
            <p class="text-sm text-gray-400 mb-4">No STL? Make one. Each generator loads its result into the workspace above, where you can scale it, price it, export it — or turn it into a sand mold.</p>
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Lithophane -->
                <div class="rounded-xl border border-gray-700 bg-gray-900/60 p-5">
                    <h3 class="text-lg font-semibold mb-2">🖼️ Lithophane</h3>
                    <p class="text-sm text-gray-400 mb-3">Turn a photo into a relief that reveals the image when backlit. Print in white, 100% infill, standing vertically.</p>
                    <div class="space-y-3 text-sm">
                        <input id="litho-file" type="file" accept="image/*" class="block w-full text-sm text-gray-300 file:mr-3 file:px-3 file:py-1.5 file:rounded file:border-0 file:bg-gray-700 file:text-gray-200 hover:file:bg-gray-600" />
                        <div class="grid grid-cols-3 gap-2">
                            <label class="flex flex-col gap-1"><span class="text-gray-400">Width mm</span>
                                <input id="litho-width" type="number" value="100" min="20" step="5" class="rounded bg-gray-800 border border-gray-600 px-2 py-1.5" /></label>
                            <label class="flex flex-col gap-1"><span class="text-gray-400">Min mm</span>
                                <input id="litho-min" type="number" value="0.8" min="0.4" step="0.2" class="rounded bg-gray-800 border border-gray-600 px-2 py-1.5" /></label>
                            <label class="flex flex-col gap-1"><span class="text-gray-400">Max mm</span>
                                <input id="litho-max" type="number" value="3" min="1" step="0.2" class="rounded bg-gray-800 border border-gray-600 px-2 py-1.5" /></label>
                        </div>
                        <label class="flex items-center gap-2 text-gray-300"><input id="litho-invert" type="checkbox" class="accent-amber-500" /> Invert (emboss instead)</label>
                        <button id="litho-btn" class="w-full px-4 py-2 rounded-lg bg-amber-600 hover:bg-amber-500 text-white font-medium" type="button">Generate lithophane</button>
                    </div>
                </div>
                <!-- QR plaque -->
                <div class="rounded-xl border border-gray-700 bg-gray-900/60 p-5">
                    <h3 class="text-lg font-semibold mb-2">🔳 QR code plaque</h3>
                    <p class="text-sm text-gray-400 mb-3">A scannable QR code as a printable plaque, previewed in its print colors. Multi-filament printer (Bambu AMS etc.)? Download the two-STL version below, import both files as one object, and assign white/black filaments.</p>
                    <div class="space-y-3 text-sm">
                        <input id="qr-text" type="text" value="https://theothermatthewmiller.com" class="w-full rounded bg-gray-800 border border-gray-600 px-2 py-1.5" />
                        <div class="grid grid-cols-3 gap-2">
                            <label class="flex flex-col gap-1"><span class="text-gray-400">Size mm</span>
                                <input id="qr-size" type="number" value="70" min="30" step="5" class="rounded bg-gray-800 border border-gray-600 px-2 py-1.5" /></label>
                            <label class="flex flex-col gap-1"><span class="text-gray-400">Base mm</span>
                                <input id="qr-base" type="number" value="2.4" min="1" step="0.2" class="rounded bg-gray-800 border border-gray-600 px-2 py-1.5" /></label>
                            <label class="flex flex-col gap-1"><span class="text-gray-400">Relief mm</span>
                                <input id="qr-relief" type="number" value="1.2" min="0.4" step="0.2" class="rounded bg-gray-800 border border-gray-600 px-2 py-1.5" /></label>
                        </div>
                        <button id="qr-btn" class="w-full px-4 py-2 rounded-lg bg-amber-600 hover:bg-amber-500 text-white font-medium" type="button">Generate QR plaque</button>
                        <button id="qr-export2-btn" class="w-full px-4 py-2 rounded-lg bg-emerald-700 hover:bg-emerald-600 text-white font-medium disabled:opacity-40" type="button" disabled>⬇️ 2-color STLs (base + code)</button>
                    </div>
                </div>
                <!-- Name tag / stamp -->
                <div class="rounded-xl border border-gray-700 bg-gray-900/60 p-5">
                    <h3 class="text-lg font-semibold mb-2">🔤 Name tag / stamp</h3>
                    <p class="text-sm text-gray-400 mb-3">Raised text on a plate — keychain tag, label, or a mirrored stamp. Sand-mold it to write names in sand.</p>
                    <div class="space-y-3 text-sm">
                        <input id="tag-text" type="text" value="MATTHEW" maxlength="30" class="w-full rounded bg-gray-800 border border-gray-600 px-2 py-1.5" />
                        <div class="grid grid-cols-2 gap-2">
                            <label class="flex flex-col gap-1"><span class="text-gray-400">Letter height mm</span>
                                <input id="tag-size" type="number" value="14" min="5" step="1" class="rounded bg-gray-800 border border-gray-600 px-2 py-1.5" /></label>
                            <label class="flex flex-col gap-1"><span class="text-gray-400">Relief mm</span>
                                <input id="tag-relief" type="number" value="2" min="0.6" step="0.2" class="rounded bg-gray-800 border border-gray-600 px-2 py-1.5" /></label>
                        </div>
                        <div class="flex flex-wrap gap-4">
                            <label class="flex items-center gap-2 text-gray-300"><input id="tag-loop" type="checkbox" checked class="accent-amber-500" /> Keychain loop</label>
                            <label class="flex items-center gap-2 text-gray-300"><input id="tag-mirror" type="checkbox" class="accent-amber-500" /> Mirror (stamp)</label>
                        </div>
                        <button id="tag-btn" class="w-full px-4 py-2 rounded-lg bg-amber-600 hover:bg-amber-500 text-white font-medium" type="button">Generate tag</button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Standalone tools (work without a model) -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-8">
            <section class="rounded-xl border border-gray-700 bg-gray-900/60 p-5">
                <h2 class="text-xl font-semibold mb-3">🧵 Filament converter (1.75&nbsp;mm)</h2>
                <div class="flex flex-wrap items-end gap-3 text-sm">
                    <label class="flex flex-col gap-1">
                        <span class="text-gray-400">Material</span>
                        <select id="fil-material" class="rounded bg-gray-800 border border-gray-600 px-2 py-1.5">
                            <option value="1.24" selected>PLA</option>
                            <option value="1.27">PETG</option>
                            <option value="1.04">ABS</option>
                            <option value="1.07">ASA</option>
                            <option value="1.21">TPU</option>
                            <option value="1.14">Nylon</option>
                        </select>
                    </label>
                    <label class="flex flex-col gap-1">
                        <span class="text-gray-400">Grams</span>
                        <input id="fil-grams" type="number" value="1000" min="0" step="10" class="w-28 rounded bg-gray-800 border border-gray-600 px-2 py-1.5" />
                    </label>
                    <span class="pb-1.5 text-gray-400">⇄</span>
                    <label class="flex flex-col gap-1">
                        <span class="text-gray-400">Meters</span>
                        <input id="fil-meters" type="number" min="0" step="1" class="w-28 rounded bg-gray-800 border border-gray-600 px-2 py-1.5" />
                    </label>
                </div>
                <p class="text-xs text-gray-500 mt-2">Handy for “is there enough left on this spool?” moments.</p>
            </section>

            <section class="rounded-xl border border-gray-700 bg-gray-900/60 p-5">
                <h2 class="text-xl font-semibold mb-3">🏖️ Sand mold tips</h2>
                <ul class="text-sm text-gray-300 space-y-1.5 list-disc list-inside">
                    <li>Slice with 2–3 walls and 5–10% infill — the mold is mostly shell, so it prints fast.</li>
                    <li>Smoother cavity = cleaner castle: try 0.16&nbsp;mm layers, or sand the inside lightly.</li>
                    <li>Use wet “drip-castle” sand or kinetic sand. Pack firmly, tap the sides, lift straight up.</li>
                    <li>A quick spray of water (or a wipe of oil) inside the mold helps release.</li>
                    <li>PETG or ASA survives a hot beach better than PLA.</li>
                    <li>Also works with snow, chocolate, and jello — but only food-grade printed parts for the last two!</li>
                </ul>
            </section>
        </div>
    </main>

    <script is:inline type="module">
        import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.160.0/+esm';
        import { OrbitControls } from 'https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/controls/OrbitControls.js/+esm';
        import { STLLoader } from 'https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/loaders/STLLoader.js/+esm';
        import { STLExporter } from 'https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/exporters/STLExporter.js/+esm';
        import * as BufferGeometryUtils from 'https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/utils/BufferGeometryUtils.js/+esm';
        import { FontLoader } from 'https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/loaders/FontLoader.js/+esm';
        import { TextGeometry } from 'https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/geometries/TextGeometry.js/+esm';

        function boot() {
            const viewerEl = document.getElementById('viewer');
            if (!viewerEl || viewerEl.dataset.ready) return;
            viewerEl.dataset.ready = '1';
            init(viewerEl);
        }

        function init(viewerEl) {
            const $ = (id) => document.getElementById(id);

            // ---------- three.js scene ----------
            const renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            viewerEl.appendChild(renderer.domElement);

            const scene = new THREE.Scene();
            scene.background = new THREE.Color(0x0f172a);
            const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 5000);
            const controls = new OrbitControls(camera, renderer.domElement);
            controls.enableDamping = true;

            scene.add(new THREE.HemisphereLight(0xffffff, 0x334155, 1.1));
            const dir = new THREE.DirectionalLight(0xffffff, 1.4);
            dir.position.set(1, 2, 1.5);
            scene.add(dir);

            // STL files are Z-up; three.js is Y-up. Display group fixes orientation.
            const displayGroup = new THREE.Group();
            displayGroup.rotation.x = -Math.PI / 2;
            scene.add(displayGroup);

            const modelMat = new THREE.MeshStandardMaterial({ color: 0x7dd3fc, roughness: 0.55, metalness: 0.05, side: THREE.DoubleSide });
            const vertexColorMat = new THREE.MeshStandardMaterial({ vertexColors: true, roughness: 0.5, metalness: 0.0, side: THREE.DoubleSide });
            const moldMat = new THREE.MeshStandardMaterial({ color: 0xd9b574, roughness: 0.8, metalness: 0.0, side: THREE.DoubleSide });
            const modelMesh = new THREE.Mesh(new THREE.BufferGeometry(), modelMat);
            const moldMesh = new THREE.Mesh(new THREE.BufferGeometry(), moldMat);
            moldMesh.visible = false;
            displayGroup.add(modelMesh, moldMesh);

            let grid = null;

            function resize() {
                const w = viewerEl.clientWidth, h = viewerEl.clientHeight;
                if (!w || !h) return;
                renderer.setSize(w, h);
                camera.aspect = w / h;
                camera.updateProjectionMatrix();
            }
            window.addEventListener('resize', resize);
            resize();
            renderer.setAnimationLoop(() => { controls.update(); renderer.render(scene, camera); });

            // ---------- state ----------
            let geom = null;       // model geometry, STL space (Z-up), base at z=0, XY centered
            let moldGeom = null;
            let fileName = 'model.stl';
            const loader = new STLLoader();
            const exporter = new STLExporter();

            // ---------- geometry helpers ----------
            function normalize(g) {
                g.computeBoundingBox();
                const bb = g.boundingBox;
                g.translate(
                    -(bb.min.x + bb.max.x) / 2,
                    -(bb.min.y + bb.max.y) / 2,
                    -bb.min.z
                );
                g.computeBoundingBox();
                return g;
            }

            function meshVolumeArea(g) {
                const p = g.getAttribute('position');
                let vol = 0, area = 0;
                const a = new THREE.Vector3(), b = new THREE.Vector3(), c = new THREE.Vector3(), ab = new THREE.Vector3(), ac = new THREE.Vector3();
                for (let i = 0; i < p.count; i += 3) {
                    a.fromBufferAttribute(p, i); b.fromBufferAttribute(p, i + 1); c.fromBufferAttribute(p, i + 2);
                    vol += a.dot(ab.copy(b).cross(c)) / 6;
                    area += ab.copy(b).sub(a).cross(ac.copy(c).sub(a)).length() / 2;
                }
                return { volume: Math.abs(vol), area };
            }

            function frameCamera(g) {
                g.computeBoundingBox();
                const size = g.boundingBox.getSize(new THREE.Vector3());
                const d = Math.max(size.x, size.y, size.z);
                // displayGroup maps STL (x,y,z) -> world (x,z,-y); center the orbit on mid-height
                controls.target.set(0, size.z / 2, 0);
                camera.position.set(d * 0.9, d * 0.8, d * 1.1);
                camera.near = d / 100; camera.far = d * 20;
                camera.updateProjectionMatrix();
                if (grid) scene.remove(grid);
                grid = new THREE.GridHelper(Math.max(size.x, size.y) * 2.5, 20, 0x475569, 0x1e293b);
                scene.add(grid);
            }

            function setModel(g, name) {
                geom = normalize(g.index ? g.toNonIndexed() : g);
                geom.computeVertexNormals();
                fileName = name;
                modelMesh.geometry.dispose();
                modelMesh.geometry = geom;
                modelMesh.material = geom.getAttribute('color') ? vertexColorMat : modelMat;
                clearMold();
                showView('model');
                frameCamera(geom);
                $('workspace').classList.remove('hidden');
                updateStats();
                resize();
            }

            function clearMold() {
                moldGeom = null;
                $('export-mold-btn').disabled = true;
                $('view-mold-btn').disabled = true;
                $('mold-info').textContent = '';
            }

            function showView(which) {
                modelMesh.visible = which === 'model';
                moldMesh.visible = which === 'mold';
                $('view-model-btn').className = 'px-3 py-1 rounded ' + (which === 'model' ? 'bg-amber-600 text-white' : 'bg-gray-700 text-gray-300');
                $('view-mold-btn').className = 'px-3 py-1 rounded disabled:opacity-40 ' + (which === 'mold' ? 'bg-amber-600 text-white' : 'bg-gray-700 text-gray-300');
            }

            // ---------- stats / cost ----------
            const PRINTERS = [
                ['Bambu A1 mini', 180, 180, 180],
                ['Ender 3 / V3 SE', 220, 220, 250],
                ['Prusa MK4', 250, 210, 220],
                ['Bambu X1/P1/A1', 256, 256, 256],
            ];
            let currentVolumeCm3 = 0;

            function updateStats() {
                if (!geom) return;
                geom.computeBoundingBox();
                const s = geom.boundingBox.getSize(new THREE.Vector3());
                const { volume, area } = meshVolumeArea(geom);
                currentVolumeCm3 = volume / 1000;
                $('stat-name').textContent = fileName;
                $('stat-dims').textContent = `${s.x.toFixed(1)} × ${s.y.toFixed(1)} × ${s.z.toFixed(1)} mm`;
                $('stat-volume').textContent = `${currentVolumeCm3.toFixed(1)} cm³`;
                $('stat-area').textContent = `${(area / 100).toFixed(1)} cm²`;
                $('stat-tris').textContent = (geom.getAttribute('position').count / 3).toLocaleString();
                $('scale-target').placeholder = Math.max(s.x, s.y, s.z).toFixed(0);
                $('bed-fit').innerHTML = PRINTERS.map(([name, x, y, z]) => {
                    const dims = [s.x, s.y, s.z].sort((a, b) => a - b);
                    const bed = [x, y, z].sort((a, b) => a - b);
                    const fits = dims.every((d, i) => d <= bed[i]);
                    return `<li>${fits ? '✅' : '❌'} <span class="text-gray-300">${name}</span> <span class="text-gray-500">(${x}×${y}×${z})</span></li>`;
                }).join('');
                updateCost();
            }

            function updateCost() {
                if (!currentVolumeCm3) return;
                const density = parseFloat($('cost-material').value);
                const infill = Math.min(100, Math.max(0, parseFloat($('cost-infill').value) || 0)) / 100;
                const price = parseFloat($('cost-price').value) || 0;
                const rate = parseFloat($('cost-quality').value);
                const fillFactor = Math.min(1, 0.15 + 0.85 * infill);
                const grams = currentVolumeCm3 * density * fillFactor;
                const meters = grams / density / (Math.PI * 0.0875 * 0.0875) / 100;
                const hours = grams / rate;
                $('cost-weight').textContent = `${grams.toFixed(0)} g`;
                $('cost-length').textContent = `${meters.toFixed(1)} m`;
                $('cost-cost').textContent = `$${(grams / 1000 * price).toFixed(2)}`;
                $('cost-time').textContent = hours < 1 ? `${Math.round(hours * 60)} min` : `${Math.floor(hours)} h ${Math.round((hours % 1) * 60)} min`;
            }

            // ---------- sand mold generation ----------
            // Render a top-down depth map of the model, then build the inverse
            // heightfield as a watertight solid. Every column of the result is
            // solid from the bed up, so it prints with no supports, and the
            // cavity has no undercuts, so sand releases cleanly.
            function buildHeightmap(res, wall) {
                geom.computeBoundingBox();
                const bb = geom.boundingBox;
                const sizeX = bb.max.x - bb.min.x, sizeY = bb.max.y - bb.min.y, H = bb.max.z;
                const w = sizeX + 2 * wall, d = sizeY + 2 * wall;

                const cam = new THREE.OrthographicCamera(-w / 2, w / 2, d / 2, -d / 2, 0.1, H + 1);
                cam.position.set(0, 0, H + 1);
                cam.up.set(0, 1, 0);
                cam.lookAt(0, 0, 0);
                cam.updateMatrixWorld();

                const depthScene = new THREE.Scene();
                depthScene.overrideMaterial = new THREE.MeshDepthMaterial({ depthPacking: THREE.RGBADepthPacking, side: THREE.DoubleSide });
                depthScene.add(new THREE.Mesh(geom, modelMat));
                const ground = new THREE.Mesh(new THREE.PlaneGeometry(w * 2, d * 2), modelMat);
                depthScene.add(ground); // z=0 plane: background reads as height 0

                const rt = new THREE.WebGLRenderTarget(res, res);
                const oldTarget = renderer.getRenderTarget();
                renderer.setRenderTarget(rt);
                renderer.render(depthScene, cam);
                const pixels = new Uint8Array(res * res * 4);
                renderer.readRenderTargetPixels(rt, 0, 0, res, res, pixels);
                renderer.setRenderTarget(oldTarget);
                rt.dispose();

                const near = 0.1, far = H + 1, camZ = H + 1;
                const heights = new Float32Array(res * res);
                for (let i = 0; i < res * res; i++) {
                    const o = i * 4;
                    // unpack RGBADepthPacking (r = least significant byte, a = most)
                    const depth = pixels[o] / 4294967296 + pixels[o + 1] / 16777216 + pixels[o + 2] / 65536 + pixels[o + 3] / 256;
                    const h = camZ - (near + depth * (far - near));
                    heights[i] = Math.min(H, Math.max(0, h < 0.05 ? 0 : h));
                }
                return { heights, res, w, d, H };
            }

            function blurHeights(hm, passes) {
                const { res } = hm;
                let src = hm.heights;
                for (let p = 0; p < passes; p++) {
                    const dst = new Float32Array(res * res);
                    for (let j = 0; j < res; j++) {
                        for (let i = 0; i < res; i++) {
                            let sum = 0, n = 0;
                            for (let dj = -1; dj <= 1; dj++) for (let di = -1; di <= 1; di++) {
                                const ii = i + di, jj = j + dj;
                                if (ii >= 0 && ii < res && jj >= 0 && jj < res) { sum += src[jj * res + ii]; n++; }
                            }
                            dst[j * res + i] = sum / n;
                        }
                    }
                    src = dst;
                }
                hm.heights = src;
            }

            function buildMoldGeometry(hm, wall) {
                const { heights, res, w, d, H } = hm;
                const T = H + wall; // total mold height: cavity depth + back plate
                // outer ring forced to zero so walls are clean rectangles
                for (let i = 0; i < res; i++) {
                    heights[i] = 0; heights[(res - 1) * res + i] = 0;
                    heights[i * res] = 0; heights[i * res + (res - 1)] = 0;
                }
                const dx = w / (res - 1), dy = d / (res - 1);
                const x0 = -w / 2, y0 = -d / 2;
                const zTop = (i, j) => T - heights[j * res + i]; // inverted model = cavity, facing up
                const tris = [];
                const push = (...pts) => { for (const p of pts) tris.push(p[0], p[1], p[2]); };

                // cavity / top surface (outward normal +Z over solid below)
                for (let j = 0; j < res - 1; j++) {
                    for (let i = 0; i < res - 1; i++) {
                        const A = [x0 + i * dx, y0 + j * dy, zTop(i, j)];
                        const B = [x0 + (i + 1) * dx, y0 + j * dy, zTop(i + 1, j)];
                        const C = [x0 + (i + 1) * dx, y0 + (j + 1) * dy, zTop(i + 1, j + 1)];
                        const D = [x0 + i * dx, y0 + (j + 1) * dy, zTop(i, j + 1)];
                        push(A, B, C); push(A, C, D);
                    }
                }
                // flat bottom plate at z=0 (normal -Z)
                {
                    const A = [x0, y0, 0], B = [x0 + w, y0, 0], C = [x0 + w, y0 + d, 0], D = [x0, y0 + d, 0];
                    push(A, C, B); push(A, D, C);
                }
                // side walls (boundary heights are 0, so top edge sits at z=T)
                for (let i = 0; i < res - 1; i++) {
                    const xa = x0 + i * dx, xb = x0 + (i + 1) * dx;
                    // south (y = y0), outward -Y
                    push([xa, y0, 0], [xb, y0, 0], [xb, y0, T]); push([xa, y0, 0], [xb, y0, T], [xa, y0, T]);
                    // north (y = y0 + d), outward +Y
                    const yn = y0 + d;
                    push([xb, yn, 0], [xa, yn, 0], [xa, yn, T]); push([xb, yn, 0], [xa, yn, T], [xb, yn, T]);
                }
                for (let j = 0; j < res - 1; j++) {
                    const ya = y0 + j * dy, yb = y0 + (j + 1) * dy;
                    // east (x = x0 + w), outward +X
                    const xe = x0 + w;
                    push([xe, ya, 0], [xe, yb, 0], [xe, yb, T]); push([xe, ya, 0], [xe, yb, T], [xe, ya, T]);
                    // west (x = x0), outward -X
                    push([x0, yb, 0], [x0, ya, 0], [x0, ya, T]); push([x0, yb, 0], [x0, ya, T], [x0, yb, T]);
                }

                const g = new THREE.BufferGeometry();
                g.setAttribute('position', new THREE.BufferAttribute(new Float32Array(tris), 3));
                g.computeVertexNormals();
                return g;
            }

            function generateMold() {
                if (!geom) return;
                const wall = Math.max(1.2, parseFloat($('mold-wall').value) || 4);
                const res = parseInt($('mold-res').value);
                const smooth = parseInt($('mold-smooth').value);
                $('mold-info').textContent = 'Generating…';
                requestAnimationFrame(() => {
                    try {
                        const hm = buildHeightmap(res, wall);
                        if (smooth) blurHeights(hm, smooth);
                        moldGeom = buildMoldGeometry(hm, wall);
                        moldMesh.geometry.dispose();
                        moldMesh.geometry = moldGeom;
                        $('export-mold-btn').disabled = false;
                        $('view-mold-btn').disabled = false;
                        showView('mold');
                        const { volume } = meshVolumeArea(moldGeom);
                        $('mold-info').textContent =
                            `Mold: ${hm.w.toFixed(0)} × ${hm.d.toFixed(0)} × ${(hm.H + wall).toFixed(0)} mm · ` +
                            `${(volume / 1000).toFixed(0)} cm³ solid (slice at low infill) · ` +
                            `print as-is, flat side down, no supports.`;
                    } catch (e) {
                        console.error(e);
                        $('mold-info').textContent = 'Mold generation failed — try a lower resolution.';
                    }
                });
            }

            // ---------- generators ----------
            // watertight solid from z=0 up to heights[j*nx+i] (all values must be > 0)
            function gridSolid(heights, nx, ny, w, d) {
                const dx = w / (nx - 1), dy = d / (ny - 1), x0 = -w / 2, y0 = -d / 2;
                const z = (i, j) => heights[j * nx + i];
                const tris = [];
                const push = (...pts) => { for (const p of pts) tris.push(p[0], p[1], p[2]); };
                for (let j = 0; j < ny - 1; j++) {
                    for (let i = 0; i < nx - 1; i++) {
                        const A = [x0 + i * dx, y0 + j * dy, z(i, j)];
                        const B = [x0 + (i + 1) * dx, y0 + j * dy, z(i + 1, j)];
                        const C = [x0 + (i + 1) * dx, y0 + (j + 1) * dy, z(i + 1, j + 1)];
                        const D = [x0 + i * dx, y0 + (j + 1) * dy, z(i, j + 1)];
                        push(A, B, C); push(A, C, D);
                    }
                }
                { // bottom plate, normal -Z
                    const A = [x0, y0, 0], B = [x0 + w, y0, 0], C = [x0 + w, y0 + d, 0], D = [x0, y0 + d, 0];
                    push(A, C, B); push(A, D, C);
                }
                for (let i = 0; i < nx - 1; i++) { // south/north walls
                    const xa = x0 + i * dx, xb = x0 + (i + 1) * dx, yn = y0 + d;
                    push([xa, y0, 0], [xb, y0, 0], [xb, y0, z(i + 1, 0)]); push([xa, y0, 0], [xb, y0, z(i + 1, 0)], [xa, y0, z(i, 0)]);
                    push([xb, yn, 0], [xa, yn, 0], [xa, yn, z(i, ny - 1)]); push([xb, yn, 0], [xa, yn, z(i, ny - 1)], [xb, yn, z(i + 1, ny - 1)]);
                }
                for (let j = 0; j < ny - 1; j++) { // east/west walls
                    const ya = y0 + j * dy, yb = y0 + (j + 1) * dy, xe = x0 + w;
                    push([xe, ya, 0], [xe, yb, 0], [xe, yb, z(nx - 1, j + 1)]); push([xe, ya, 0], [xe, yb, z(nx - 1, j + 1)], [xe, ya, z(nx - 1, j)]);
                    push([x0, yb, 0], [x0, ya, 0], [x0, ya, z(0, j)]); push([x0, yb, 0], [x0, ya, z(0, j)], [x0, yb, z(0, j + 1)]);
                }
                const g = new THREE.BufferGeometry();
                g.setAttribute('position', new THREE.BufferAttribute(new Float32Array(tris), 3));
                return g;
            }

            // strip to non-indexed position-only so mixed geometries merge cleanly;
            // optional rgb gives every vertex that color (for multi-color previews)
            function bare(g, rgb) {
                const ni = g.index ? g.toNonIndexed() : g;
                const out = new THREE.BufferGeometry();
                out.setAttribute('position', ni.getAttribute('position').clone());
                if (rgb) {
                    const n = out.getAttribute('position').count;
                    const colors = new Float32Array(n * 3);
                    for (let i = 0; i < n; i++) colors.set(rgb, i * 3);
                    out.setAttribute('color', new THREE.BufferAttribute(colors, 3));
                }
                return out;
            }

            function flipWinding(g) { // for mirrored geometry (negative scale)
                const p = g.getAttribute('position');
                for (let i = 0; i < p.count; i += 3) {
                    for (let k = 0; k < 3; k++) {
                        const tmp = p.getComponent(i + 1, k);
                        p.setComponent(i + 1, k, p.getComponent(i + 2, k));
                        p.setComponent(i + 2, k, tmp);
                    }
                }
                p.needsUpdate = true;
            }

            async function generateLitho() {
                const file = $('litho-file').files[0];
                if (!file) { alert('Choose an image first.'); return; }
                const minT = Math.max(0.4, parseFloat($('litho-min').value) || 0.8);
                const maxT = Math.max(minT + 0.4, parseFloat($('litho-max').value) || 3);
                const width = Math.max(20, parseFloat($('litho-width').value) || 100);
                const invert = $('litho-invert').checked;
                const img = await createImageBitmap(file);
                const nx = 260, ny = Math.max(8, Math.round(nx * img.height / img.width));
                const cv = document.createElement('canvas');
                cv.width = nx; cv.height = ny;
                const ctx = cv.getContext('2d');
                ctx.drawImage(img, 0, 0, nx, ny);
                const px = ctx.getImageData(0, 0, nx, ny).data;
                const heights = new Float32Array(nx * ny);
                for (let j = 0; j < ny; j++) {
                    for (let i = 0; i < nx; i++) {
                        const o = ((ny - 1 - j) * nx + i) * 4; // image row 0 is top; grid j=0 is bottom
                        let lum = (0.2126 * px[o] + 0.7152 * px[o + 1] + 0.0722 * px[o + 2]) / 255;
                        if (invert) lum = 1 - lum;
                        heights[j * nx + i] = maxT - (maxT - minT) * lum; // darker = thicker
                    }
                }
                setModel(gridSolid(heights, nx, ny, width, width * ny / nx), 'lithophane.stl');
                document.getElementById('workspace').scrollIntoView({ behavior: 'smooth' });
            }

            let qrParts = null; // { base, code } geometries, shared origin, for AMS multi-color
            async function generateQR() {
                const text = $('qr-text').value.trim();
                if (!text) return;
                const size = Math.max(30, parseFloat($('qr-size').value) || 70);
                const baseH = Math.max(1, parseFloat($('qr-base').value) || 2.4);
                const relief = Math.max(0.4, parseFloat($('qr-relief').value) || 1.2);
                const { default: qrcode } = await import('https://cdn.jsdelivr.net/npm/qrcode-generator@1.4.4/+esm');
                const qr = qrcode(0, 'M');
                qr.addData(text);
                qr.make();
                const n = qr.getModuleCount(), quiet = 2, cell = size / (n + 2 * quiet);
                const WHITE = [0.93, 0.93, 0.93], BLACK = [0.04, 0.04, 0.04];
                const base = new THREE.BoxGeometry(size, size, baseH);
                base.translate(0, 0, baseH / 2);
                const baseGeom = bare(base, WHITE);
                const modParts = [];
                for (let r = 0; r < n; r++) {
                    for (let c = 0; c < n; c++) {
                        if (!qr.isDark(r, c)) continue;
                        const b = new THREE.BoxGeometry(cell, cell, relief + 0.2);
                        b.translate(
                            -size / 2 + (quiet + c + 0.5) * cell,
                            size / 2 - (quiet + r + 0.5) * cell,
                            baseH - 0.2 + (relief + 0.2) / 2
                        );
                        modParts.push(bare(b, BLACK));
                    }
                }
                const codeGeom = BufferGeometryUtils.mergeGeometries(modParts);
                qrParts = { base: baseGeom, code: codeGeom };
                $('qr-export2-btn').disabled = false;
                setModel(BufferGeometryUtils.mergeGeometries([baseGeom, codeGeom]), 'qr-plaque.stl');
                document.getElementById('workspace').scrollIntoView({ behavior: 'smooth' });
            }

            let fontPromise = null;
            async function generateTag() {
                const text = $('tag-text').value.trim();
                if (!text) return;
                const letterH = Math.max(5, parseFloat($('tag-size').value) || 14);
                const relief = Math.max(0.6, parseFloat($('tag-relief').value) || 2);
                const plateH = 3, pad = 4;
                fontPromise ??= new FontLoader().loadAsync('https://cdn.jsdelivr.net/npm/three@0.160.0/examples/fonts/helvetiker_bold.typeface.json');
                const font = await fontPromise;
                const tg = new TextGeometry(text, { font, size: letterH, height: relief + 0.2, curveSegments: 5, bevelEnabled: false });
                tg.computeBoundingBox();
                const tb = tg.boundingBox;
                const tw = tb.max.x - tb.min.x, th = tb.max.y - tb.min.y;
                tg.translate(-(tb.min.x + tb.max.x) / 2, -(tb.min.y + tb.max.y) / 2, plateH - 0.2);
                const parts = [bare(tg)];
                const plate = new THREE.BoxGeometry(tw + 2 * pad, th + 2 * pad, plateH);
                plate.translate(0, 0, plateH / 2);
                parts.push(bare(plate));
                if ($('tag-loop').checked) {
                    const shape = new THREE.Shape();
                    shape.absarc(0, 0, 5, 0, Math.PI * 2, false);
                    const hole = new THREE.Path();
                    hole.absarc(0, 0, 2.4, 0, Math.PI * 2, true);
                    shape.holes.push(hole);
                    const ring = new THREE.ExtrudeGeometry(shape, { depth: plateH, bevelEnabled: false, curveSegments: 24 });
                    ring.translate(-(tw / 2 + pad) - 3, 0, 0);
                    parts.push(bare(ring));
                }
                const merged = BufferGeometryUtils.mergeGeometries(parts);
                if ($('tag-mirror').checked) {
                    merged.scale(-1, 1, 1);
                    flipWinding(merged);
                }
                setModel(merged, ($('tag-mirror').checked ? 'stamp-' : 'tag-') + text.toLowerCase().replace(/[^a-z0-9]+/gi, '-') + '.stl');
                document.getElementById('workspace').scrollIntoView({ behavior: 'smooth' });
            }

            const guard = (fn, label) => () => fn().catch(e => { console.error(e); alert(label + ' failed — see console.'); });
            $('litho-btn').addEventListener('click', guard(generateLitho, 'Lithophane'));
            $('qr-btn').addEventListener('click', guard(generateQR, 'QR plaque'));
            $('qr-export2-btn').addEventListener('click', () => {
                if (!qrParts) return;
                downloadSTL(qrParts.base, 'qr-plaque-base-white.stl');
                setTimeout(() => downloadSTL(qrParts.code, 'qr-plaque-code-black.stl'), 400);
            });
            $('tag-btn').addEventListener('click', guard(generateTag, 'Tag'));

            // ---------- demo castle ----------
            function demoCastle() {
                const parts = [];
                const zUp = (g, z) => { g.rotateX(Math.PI / 2); g.translate(0, 0, z); return g; };
                parts.push(zUp(new THREE.BoxGeometry(84, 5, 84), 2.5)); // base slab
                for (const sx of [-1, 1]) for (const sy of [-1, 1]) {  // corner towers + roofs
                    const t = zUp(new THREE.CylinderGeometry(10, 11, 38, 28), 5 + 19); t.translate(sx * 28, sy * 28, 0); parts.push(t);
                    const r = zUp(new THREE.ConeGeometry(13, 14, 28), 5 + 38 + 7); r.translate(sx * 28, sy * 28, 0); parts.push(r);
                }
                for (const s of [-1, 1]) { // curtain walls
                    const wx = zUp(new THREE.BoxGeometry(56, 24, 7), 5 + 12); wx.translate(0, s * 28, 0); parts.push(wx);
                    const wy = zUp(new THREE.BoxGeometry(7, 24, 56), 5 + 12); wy.translate(s * 28, 0, 0); parts.push(wy);
                }
                parts.push(zUp(new THREE.CylinderGeometry(15, 16, 50, 36), 5 + 25));   // keep
                parts.push(zUp(new THREE.ConeGeometry(18.5, 18, 36), 5 + 50 + 9));     // keep roof
                setModel(BufferGeometryUtils.mergeGeometries(parts), 'demo-castle.stl');
            }

            // ---------- export ----------
            function downloadSTL(g, name) {
                const mesh = new THREE.Mesh(g);
                mesh.updateMatrixWorld();
                const data = exporter.parse(mesh, { binary: true });
                const blob = new Blob([data], { type: 'model/stl' });
                const a = document.createElement('a');
                a.href = URL.createObjectURL(blob);
                a.download = name;
                a.click();
                setTimeout(() => URL.revokeObjectURL(a.href), 5000);
            }

            // ---------- wiring ----------
            const dropzone = $('dropzone'), fileInput = $('file-input');
            dropzone.addEventListener('click', (e) => { if (e.target.id !== 'demo-btn') fileInput.click(); });
            dropzone.addEventListener('dragover', (e) => { e.preventDefault(); dropzone.classList.add('border-amber-400'); });
            dropzone.addEventListener('dragleave', () => dropzone.classList.remove('border-amber-400'));
            dropzone.addEventListener('drop', (e) => {
                e.preventDefault();
                dropzone.classList.remove('border-amber-400');
                if (e.dataTransfer.files[0]) loadFile(e.dataTransfer.files[0]);
            });
            fileInput.addEventListener('change', () => { if (fileInput.files[0]) loadFile(fileInput.files[0]); });

            async function loadFile(file) {
                try {
                    const buf = await file.arrayBuffer();
                    setModel(loader.parse(buf), file.name);
                    document.getElementById('workspace').scrollIntoView({ behavior: 'smooth', block: 'start' });
                } catch (e) {
                    console.error(e);
                    alert('Could not read that file — is it a valid STL?');
                }
            }

            $('demo-btn').addEventListener('click', (e) => { e.stopPropagation(); demoCastle(); });
            $('view-model-btn').addEventListener('click', () => showView('model'));
            $('view-mold-btn').addEventListener('click', () => showView('mold'));
            document.querySelectorAll('.rot-btn').forEach(btn => btn.addEventListener('click', () => {
                if (!geom) return;
                const axis = btn.dataset.axis;
                if (axis === 'x') geom.rotateX(Math.PI / 2);
                if (axis === 'y') geom.rotateY(Math.PI / 2);
                if (axis === 'z') geom.rotateZ(Math.PI / 2);
                normalize(geom);
                geom.computeVertexNormals();
                modelMesh.geometry = geom;
                clearMold();
                showView('model');
                frameCamera(geom);
                updateStats();
            }));
            $('scale-pct-btn').addEventListener('click', () => {
                const pct = parseFloat($('scale-pct').value);
                if (!geom || !pct || pct <= 0) return;
                geom.scale(pct / 100, pct / 100, pct / 100);
                normalize(geom); clearMold(); frameCamera(geom); updateStats();
                $('scale-pct').value = 100;
            });
            $('scale-target-btn').addEventListener('click', () => {
                const target = parseFloat($('scale-target').value);
                if (!geom || !target || target <= 0) return;
                geom.computeBoundingBox();
                const s = geom.boundingBox.getSize(new THREE.Vector3());
                const f = target / Math.max(s.x, s.y, s.z);
                geom.scale(f, f, f);
                normalize(geom); clearMold(); frameCamera(geom); updateStats();
            });
            $('export-model-btn').addEventListener('click', () => { if (geom) downloadSTL(geom, fileName.replace(/\.stl$/i, '') + '-edited.stl'); });
            $('mold-btn').addEventListener('click', generateMold);
            $('export-mold-btn').addEventListener('click', () => { if (moldGeom) downloadSTL(moldGeom, fileName.replace(/\.stl$/i, '') + '-sand-mold.stl'); });
            ['cost-material', 'cost-infill', 'cost-price', 'cost-quality'].forEach(id => $(id).addEventListener('input', updateCost));

            // filament converter
            const filArea = Math.PI * 0.0875 * 0.0875; // cm² cross-section of 1.75mm filament
            const filDensity = () => parseFloat($('fil-material').value);
            const syncFromGrams = () => { const g = parseFloat($('fil-grams').value) || 0; $('fil-meters').value = (g / filDensity() / filArea / 100).toFixed(1); };
            const syncFromMeters = () => { const m = parseFloat($('fil-meters').value) || 0; $('fil-grams').value = (m * 100 * filArea * filDensity()).toFixed(0); };
            $('fil-grams').addEventListener('input', syncFromGrams);
            $('fil-meters').addEventListener('input', syncFromMeters);
            $('fil-material').addEventListener('change', syncFromGrams);
            syncFromGrams();
        }

        boot();
        document.addEventListener('astro:page-load', boot);
    </script>
</Layout>
