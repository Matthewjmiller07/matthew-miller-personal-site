---
// Hub for everything 3D on the site: Blender-built explainers, printable designs, and the browser print tools.
import Layout from '../layouts/Layout.astro';
import coffee from '../data/coffee-3d/drinks.json';

const explainers = [
    {
        href: '/3d/coffee',
        title: 'The Coffee Bar',
        he: 'מָה יֵשׁ בַּכּוֹס?',
        img: '/3d/coffee-bar/lineup.webp',
        text: `${coffee.drinks.length} café drinks as cutaway cups, poured layer by layer: kafe hafuch, cappuccino, flat white, botz, Turkish, ice kafe and the rest. Modelled in Blender, turned in your browser.`,
        tag: 'New',
    },
];

const prints = [
    {
        href: '/3d-print-tools/leshem-yichud',
        title: 'Leshem Yichud tefillin card',
        he: 'לְשֵׁם יִחוּד · הֲנָחַת תְּפִלִּין',
        img: '/3d/leshem-yichud/leshem-yichud-flat.png',
        text: 'The Leshem Yichud before tefillin with nikkud, three colours, with a mirror on the back for checking the shel rosh. Pocket, standard and display sizes with 3MF and STLs.',
    },
    {
        href: '/3d-print-tools/leshem-yichud#stand',
        title: 'Tefillin card stand',
        img: '/3d/leshem-yichud/leshem-yichud-spin.gif',
        text: 'A sloped plinth the card drops into, leaning back 12°. One colour, no supports, about 36 minutes.',
    },
    {
        href: '/print-quote',
        title: 'Bulk print quotes',
        he: 'הצעת מחיר להדפסה',
        text: 'For print shops: the tefillin card’s specs and files, and a form to quote runs of 25 to 250.',
    },
];

const tools = [
    ['STL viewer & stats', 'size, volume, surface area, and whether it fits common beds'],
    ['Sand castle mold maker', 'turns any STL into a printable negative you pack with wet sand'],
    ['Scale & export', 'resize to a target size and download the new STL'],
    ['Print cost & time', 'filament grams, cost, and an hours estimate'],
    ['Lithophane', 'a photo as a backlit relief'],
    ['QR code plaque', 'single- or two-colour, for the AMS'],
    ['Name tag / stamp', 'raised or mirrored text'],
    ['Filament converter', 'metres ↔ grams for 1.75 mm'],
];
---

<Layout
    title="3D"
    description="Everything 3D on the site: Blender-built explainers like the Coffee Bar, printable Jewish designs like the Leshem Yichud tefillin card, and free browser tools for 3D printing."
    image="/3d/coffee-bar/lineup.webp"
>
    <main class="max-w-6xl mx-auto px-4 py-8 text-gray-100">
        <header class="relative rounded-2xl overflow-hidden border border-gray-700 mb-10">
            <img src="/3d/coffee-bar/lineup.webp" alt="A row of coffee drinks in cutaway cups and glasses" class="w-full h-56 md:h-80 object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent"></div>
            <div class="absolute bottom-0 left-0 p-5 md:p-8">
                <h1 class="text-4xl md:text-5xl font-bold">3D</h1>
                <p class="mt-2 text-gray-200 max-w-2xl">Things to turn around in the browser, things to print, and tools to print them with.</p>
            </div>
        </header>

        <section class="mb-12">
            <h2 class="text-2xl font-bold mb-1">Explainers</h2>
            <p class="text-gray-400 text-sm mb-4">Built in Blender from data, so every model is exact and can be re-made in one command.</p>
            {explainers.map((e) => (
                <a href={e.href} class="group grid md:grid-cols-2 rounded-xl overflow-hidden border border-gray-700 bg-gray-900/60 hover:border-amber-400 transition-colors">
                    <img src={e.img} alt="" class="w-full h-56 md:h-full object-cover" loading="lazy" />
                    <div class="p-6">
                        {e.tag && <span class="text-xs px-2 py-0.5 rounded-full bg-amber-600 text-white">{e.tag}</span>}
                        <h3 class="mt-2 text-2xl font-semibold group-hover:text-amber-300">{e.title}</h3>
                        <p class="text-amber-300" dir="rtl" lang="he">{e.he}</p>
                        <p class="mt-3 text-gray-300">{e.text}</p>
                        <p class="mt-4 text-sm text-amber-300">Open the Coffee Bar →</p>
                    </div>
                </a>
            ))}
        </section>

        <section class="mb-12">
            <h2 class="text-2xl font-bold mb-1">Ready to print</h2>
            <p class="text-gray-400 text-sm mb-4">Designs with files to download, sized for the Bambu A1 mini and bigger printers.</p>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
                {prints.map((p) => (
                    <a href={p.href} class="group rounded-xl overflow-hidden border border-gray-700 bg-gray-900/60 hover:border-amber-400 transition-colors flex flex-col">
                        {p.img
                            ? <img src={p.img} alt="" class="w-full h-48 object-contain bg-slate-900" loading="lazy" />
                            : <div class="h-48 flex items-center justify-center bg-slate-900 text-5xl text-amber-300" dir="rtl" lang="he">ש</div>}
                        <div class="p-4">
                            <h3 class="font-semibold group-hover:text-amber-300">{p.title}</h3>
                            {p.he && <p class="text-sm text-amber-300" dir="rtl" lang="he">{p.he}</p>}
                            <p class="mt-2 text-sm text-gray-400">{p.text}</p>
                        </div>
                    </a>
                ))}
            </div>
        </section>

        <section>
            <h2 class="text-2xl font-bold mb-1"><a href="/3d-print-tools" class="hover:text-amber-300">3D Print Tools →</a></h2>
            <p class="text-gray-400 text-sm mb-4">A toolbox that runs entirely in your browser. Nothing is uploaded.</p>
            <ul class="grid sm:grid-cols-2 gap-x-6 gap-y-2">
                {tools.map(([name, what]) => (
                    <li class="text-sm"><a href="/3d-print-tools" class="font-medium hover:text-amber-300">{name}</a> <span class="text-gray-400">· {what}</span></li>
                ))}
            </ul>
        </section>
    </main>
</Layout>
