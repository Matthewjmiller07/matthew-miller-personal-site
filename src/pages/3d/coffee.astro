---
// The Coffee Bar: café drinks as cutaway 3D cups. Geometry and renders come from Blender
// (scripts/3d-designs/coffee/build.py), which reads the same drinks.json as this page.
import Layout from '../../layouts/Layout.astro';
import data from '../../data/coffee-3d/drinks.json';

const { colors, cups, drinks } = data;
const DIR = '/3d/coffee-bar';
const pours = (d: (typeof drinks)[number]) => d.layers.filter((l) => 'frac' in l);
const maxH = Math.max(...drinks.map((d) => cups[d.cup as keyof typeof cups].H));
---

<Layout
    title="The Coffee Bar in 3D"
    description="Kafe hafuch, cappuccino, flat white, botz, Turkish, ice kafe and more as cutaway 3D cups you can turn around, with each layer poured in the order the barista does it. Modelled in Blender."
    image={`${DIR}/lineup.webp`}
>
    <main class="max-w-7xl mx-auto px-4 py-8 text-gray-100">
        <p class="text-sm mb-4"><a href="/3d" class="text-amber-300 hover:underline">← 3D</a></p>
        <header class="mb-6">
            <h1 class="text-3xl md:text-4xl font-bold">The Coffee Bar in 3D</h1>
            <p class="mt-1 text-2xl text-amber-300" dir="rtl" lang="he">מָה יֵשׁ בַּכּוֹס?</p>
            <p class="mt-3 text-gray-400 max-w-3xl">
                Fifteen drinks, each cut open so you can see the layers, from Israeli café staples
                (<a href="#hafuch" class="text-amber-300 hover:underline">kafe hafuch</a>,
                <a href="#botz" class="text-amber-300 hover:underline">botz</a>,
                <a href="#ice" class="text-amber-300 hover:underline">ice kafe</a>) to the Italian classics.
                Pick a drink and watch it get made, one pour at a time. Drag to turn the cup.
            </p>
        </header>

        <!-- Picker -->
        <nav id="cb-picker" class="flex gap-3 overflow-x-auto pb-3 mb-6 -mx-4 px-4 snap-x" style="scrollbar-color:#4b5563 transparent;scrollbar-width:thin" aria-label="Drinks">
            {drinks.map((d) => (
                <a
                    href={`#${d.id}`}
                    data-drink={d.id}
                    class="cb-pick snap-start shrink-0 w-28 rounded-xl border border-gray-700 bg-gray-900/60 hover:border-amber-400 transition-colors overflow-hidden text-center"
                >
                    <img src={`${DIR}/${d.id}.webp`} alt="" width="112" height="112" loading="lazy" class="w-28 h-28 object-cover" />
                    <span class="block text-sm font-medium px-1 pt-1 leading-tight">{d.name}</span>
                    <span class="block text-xs text-gray-400 pb-2" dir="rtl" lang="he">{d.he}</span>
                </a>
            ))}
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">
            <!-- Viewer -->
            <div class="lg:col-span-3 lg:sticky lg:top-20 self-start">
                <div class="relative rounded-xl overflow-hidden border border-gray-700" style="background:radial-gradient(ellipse at 50% 40%, #3a2618 0%, #1a110c 75%)">
                    <div id="cb-viewer" class="w-full h-[420px] md:h-[540px]"></div>
                    <svg id="cb-lines" class="absolute inset-0 w-full h-full pointer-events-none"></svg>
                    <div id="cb-labels" class="absolute inset-0 pointer-events-none"></div>
                    <img id="cb-fallback" src={`${DIR}/hafuch.webp`} alt="Kafe hafuch in a glass" class="absolute inset-0 w-full h-full object-contain" />
                    <p id="cb-status" class="absolute left-3 bottom-2 text-xs text-gray-400">Loading the 3D cups…</p>
                </div>
                <div class="flex flex-wrap items-center gap-2 mt-3 text-sm">
                    <button id="cb-play" type="button" class="px-3 py-1.5 rounded-lg bg-amber-600 hover:bg-amber-500 text-white font-medium">↻ Make it again</button>
                    <button id="cb-prev" type="button" class="px-3 py-1.5 rounded-lg bg-gray-700 hover:bg-gray-600">← Step</button>
                    <button id="cb-next" type="button" class="px-3 py-1.5 rounded-lg bg-gray-700 hover:bg-gray-600">Step →</button>
                    <span class="flex-1"></span>
                    <label class="flex items-center gap-1.5 text-gray-400"><input id="cb-showlabels" type="checkbox" checked class="accent-amber-500" /> Labels</label>
                    <button id="cb-reset" type="button" class="px-3 py-1.5 rounded-lg bg-gray-700 hover:bg-gray-600">Reset view</button>
                </div>
            </div>

            <!-- Drink panel: one per drink, the script shows the selected one -->
            <div class="lg:col-span-2">
                {drinks.map((d) => {
                    const cup = cups[d.cup as keyof typeof cups];
                    return (
                        <article class="cb-panel hidden" data-drink={d.id}>
                            <h2 class="text-2xl font-bold">{d.name} <span class="text-amber-300 font-normal" dir="rtl" lang="he">{d.he}</span></h2>
                            <p class="mt-2 text-gray-300">{d.tagline}</p>
                            <div class="flex flex-wrap gap-2 mt-3 text-xs">
                                <span class="px-2 py-1 rounded-full bg-gray-800 border border-gray-700">{d.volume}</span>
                                <span class="px-2 py-1 rounded-full bg-gray-800 border border-gray-700">{cup.label}</span>
                                <span class={`px-2 py-1 rounded-full border ${d.dairy ? 'bg-sky-950 border-sky-800 text-sky-200' : 'bg-emerald-950 border-emerald-800 text-emerald-200'}`}>
                                    {d.dairy ? 'Chalavi (dairy)' : 'Pareve'}
                                </span>
                            </div>

                            <div class="mt-5">
                                <div class="flex h-6 rounded-md overflow-hidden border border-gray-700" role="img" aria-label={`Proportions: ${pours(d).map((l) => `${l.name} ${Math.round(l.frac * 100)}%`).join(', ')}`}>
                                    {pours(d).map((l) => (
                                        <div class="cb-swatch h-full" data-layer={l.id} style={`width:${l.frac * 100}%;background:${colors[l.kind as keyof typeof colors]}`} title={`${l.name} · ${Math.round(l.frac * 100)}%`}></div>
                                    ))}
                                </div>
                                <p class="text-xs text-gray-500 mt-1">Bottom of the cup on the left, top on the right, by height.</p>
                            </div>

                            <h3 class="mt-5 text-sm uppercase tracking-wide text-gray-400">How it's made</h3>
                            <ol class="mt-2 space-y-2">
                                {d.steps.map((s, i) => (
                                    <li class="cb-step flex gap-3 rounded-lg p-2 border border-transparent cursor-pointer transition-colors" data-step={i}>
                                        <span class="shrink-0 w-6 h-6 rounded-full bg-gray-800 border border-gray-600 text-xs flex items-center justify-center">{i + 1}</span>
                                        <span class="text-sm text-gray-300">{s.text}</span>
                                    </li>
                                ))}
                            </ol>

                            <h3 class="mt-5 text-sm uppercase tracking-wide text-gray-400">In the cup</h3>
                            <ul class="mt-2 grid grid-cols-2 gap-1.5 text-sm">
                                {d.layers.map((l) => (
                                    <li class="cb-legend flex items-center gap-2 rounded px-1.5 py-1 hover:bg-gray-800 cursor-default" data-layer={l.id}>
                                        <span class="w-3.5 h-3.5 rounded-sm border border-white/20 shrink-0" style={`background:${colors[l.kind as keyof typeof colors]}`}></span>
                                        {l.name}
                                    </li>
                                ))}
                            </ul>
                        </article>
                    );
                })}
            </div>
        </div>

        <!-- At a glance -->
        <section class="mt-14">
            <h2 class="text-2xl font-bold">All fifteen, side by side</h2>
            <p class="text-gray-400 mt-1 text-sm">Each column is the drink at its real height in its usual cup. Click one to open it above.</p>
            <div class="mt-5 flex items-end gap-2 md:gap-3 overflow-x-auto pb-2" style={`scrollbar-color:#4b5563 transparent;scrollbar-width:thin;height:${Math.round(maxH * 1000 * 1.6) + 70}px`}>
                {drinks.map((d) => {
                    const cup = cups[d.cup as keyof typeof cups];
                    const px = cup.H * 1000 * 1.6;
                    return (
                        <a href={`#${d.id}`} class="cb-col group shrink-0 w-12 md:w-14 flex flex-col items-center" title={d.name}>
                            <div class="w-full rounded-b-md border border-t-0 border-gray-500/60 flex flex-col-reverse overflow-hidden group-hover:border-amber-400" style={`height:${px}px`}>
                                {pours(d).map((l) => (
                                    <div style={`height:${l.frac * d.fill * 100}%;background:${colors[l.kind as keyof typeof colors]}`}></div>
                                ))}
                            </div>
                            <span class="mt-1.5 text-[11px] leading-tight text-center text-gray-400 group-hover:text-amber-300 h-8">{d.name}</span>
                        </a>
                    );
                })}
            </div>
        </section>

        <section class="mt-12 grid md:grid-cols-2 gap-6 text-sm text-gray-400">
            <div class="rounded-xl border border-gray-700 bg-gray-900/60 p-5">
                <h2 class="text-lg font-semibold text-gray-100">Hafuch, latte macchiato, latte: what's the difference?</h2>
                <p class="mt-2">All three are espresso and a lot of milk. The difference is order. A latte puts the coffee in first and
                    pours milk onto it, so it mixes. A <a href="#latte-macchiato" class="text-amber-300 hover:underline">latte macchiato</a> and a
                    <a href="#hafuch" class="text-amber-300 hover:underline">hafuch</a> put the milk in first and pour the espresso on top, which is
                    why hafuch is "upside down". Espresso is lighter than hot milk and heavier than foam, so it stops in between in a band.
                    A hafuch usually has more foam and a less tidy band, and the espresso leaves its brown spot on top.</p>
            </div>
            <div class="rounded-xl border border-gray-700 bg-gray-900/60 p-5">
                <h2 class="text-lg font-semibold text-gray-100">And the halacha?</h2>
                <p class="mt-2">The bracha on all of these is shehakol, and the milk ones are chalavi.
                    For the rest (coffee on Shabbat, bishul akum, coffee before davening, coffee in a café),
                    see the living source sheet <a href="/coffee" class="text-amber-300 hover:underline">Coffee in Judaism →</a></p>
                <p class="mt-3 text-xs text-gray-500">Modelled in Blender with a script that lathes each cup and its layers from
                    the same data this page reads. The ceramic cups are drawn with a quarter cut away; the glasses are whole.</p>
            </div>
        </section>
    </main>

    <script type="application/json" id="cb-data" set:html={JSON.stringify({ colors, cups, drinks })} />

    <script is:inline type="module">
        import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.160.0/+esm';
        import { OrbitControls } from 'https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/controls/OrbitControls.js/+esm';
        import { GLTFLoader } from 'https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/loaders/GLTFLoader.js/+esm';
        import { DRACOLoader } from 'https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/loaders/DRACOLoader.js/+esm';
        import { RoomEnvironment } from 'https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/environments/RoomEnvironment.js/+esm';

        const clamp = (x, a = 0, b = 1) => Math.min(b, Math.max(a, x));
        const smooth = (a, b, x) => { const t = clamp((x - a) / (b - a)); return t * t * (3 - 2 * t); };
        const YAW = THREE.MathUtils.degToRad(-40);  // vessels come from behind, spout toward the camera
        const IMPACT = new THREE.Vector3(-0.004, 0, -0.004);  // just behind the axis, visible through the cutaway
        const GRAVITY = 2.6;  // slowed down so you can see the stream fall

        // what pours each kind of layer, unless the layer names its own vessel
        const VESSEL = { espresso: 'portafilter', band: 'portafilter', milk: 'jug', microfoam: 'jug', foam: 'jug', americano: 'kettle',
            chocolate: 'jug', cream: 'spoon', grounds: 'spoon', black: 'kettle', slush: 'jug', nes: 'jug' };
        const WATER = '#cfdde4';

        function boot() {
            const el = document.getElementById('cb-viewer');
            if (!el || el.dataset.ready) return;
            el.dataset.ready = '1';
            const { colors, cups, drinks } = JSON.parse(document.getElementById('cb-data').textContent);
            const byId = Object.fromEntries(drinks.map((d) => [d.id, d]));
            const $ = (s, root = document) => root.querySelector(s);
            const $$ = (s, root = document) => [...root.querySelectorAll(s)];
            const status = $('#cb-status');
            const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

            // ---------- scene ----------
            let renderer;
            try {
                renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
            } catch {
                status.textContent = 'WebGL is off here, so this is a still render';
                return;
            }
            renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
            renderer.outputColorSpace = THREE.SRGBColorSpace;
            renderer.toneMapping = THREE.ACESFilmicToneMapping;
            renderer.toneMappingExposure = 1.05;
            renderer.localClippingEnabled = true;
            renderer.shadowMap.enabled = true;
            renderer.shadowMap.type = THREE.PCFSoftShadowMap;
            renderer.domElement.style.display = 'none';
            el.appendChild(renderer.domElement);

            const scene = new THREE.Scene();
            scene.environment = new THREE.PMREMGenerator(renderer).fromScene(new RoomEnvironment(), 0.04).texture;
            const camera = new THREE.PerspectiveCamera(32, 1, 0.005, 10);
            const controls = new OrbitControls(camera, renderer.domElement);
            controls.enableDamping = true;
            controls.enablePan = false;
            controls.maxPolarAngle = Math.PI * 0.55;
            let touched = false;
            controls.addEventListener('start', () => (touched = true));
            scene.add(new THREE.HemisphereLight(0xfff4e6, 0x2a1a10, 0.6));
            const key = new THREE.DirectionalLight(0xfff0dd, 2.4);
            key.position.set(-0.3, 0.6, 0.45);
            key.castShadow = true;
            key.shadow.mapSize.set(1024, 1024);
            Object.assign(key.shadow.camera, { left: -0.25, right: 0.25, top: 0.25, bottom: -0.25, near: 0.1, far: 2 });
            key.shadow.bias = -0.0005;
            key.shadow.radius = 4;
            scene.add(key);
            const rim = new THREE.DirectionalLight(0xdde8ff, 1.1);
            rim.position.set(0.4, 0.3, -0.5);
            scene.add(rim);
            const floor = new THREE.Mesh(new THREE.CircleGeometry(0.5, 64), new THREE.ShadowMaterial({ opacity: 0.38 }));
            floor.rotation.x = -Math.PI / 2;
            floor.receiveShadow = true;
            scene.add(floor);

            function resize() {
                const w = el.clientWidth, h = el.clientHeight;
                renderer.setSize(w, h);
                camera.aspect = w / h;
                camera.updateProjectionMatrix();
                $('#cb-lines').setAttribute('viewBox', `0 0 ${w} ${h}`);
            }
            new ResizeObserver(resize).observe(el);
            resize();

            // ---------- materials ----------
            const glassMat = new THREE.MeshPhysicalMaterial({
                color: 0xffffff, roughness: 0.05, metalness: 0, transmission: 1, thickness: 0.003, ior: 1.5,
                specularIntensity: 1, clearcoat: 1, clearcoatRoughness: 0.04, side: THREE.DoubleSide,
            });
            const steel = new THREE.MeshStandardMaterial({ color: 0xe6e9ee, metalness: 0.8, roughness: 0.26, envMapIntensity: 1.8, side: THREE.DoubleSide });
            const darkSteel = new THREE.MeshStandardMaterial({ color: 0x55575c, metalness: 1, roughness: 0.3, side: THREE.DoubleSide });
            const brass = new THREE.MeshStandardMaterial({ color: 0xc89640, metalness: 1, roughness: 0.28, side: THREE.DoubleSide });
            const wood = new THREE.MeshStandardMaterial({ color: 0x2a1a12, roughness: 0.6 });

            // ---------- vessels ----------
            const lathe = (pts, mat, segs = 48) => new THREE.Mesh(new THREE.LatheGeometry(pts.map(([r, y]) => new THREE.Vector2(r, y)), segs), mat);
            function makeJug(mat, scale = 1, longHandle = false) {
                const g = new THREE.Group();
                g.add(lathe([[0, 0], [0.026, 0], [0.03, 0.004], [0.033, 0.03], [0.031, 0.058], [0.027, 0.076], [0.029, 0.085], [0.0288, 0.0862]], mat));
                const spout = new THREE.Mesh(new THREE.ConeGeometry(0.009, 0.016, 20, 1, true), mat);
                spout.rotation.z = -Math.PI / 2 + 0.45;
                spout.position.set(0.031, 0.081, 0);
                g.add(spout);
                if (longHandle) {
                    const h = new THREE.Mesh(new THREE.CylinderGeometry(0.004, 0.005, 0.11, 12), wood);
                    h.rotation.z = Math.PI / 2 - 0.35;
                    h.position.set(-0.08, 0.075, 0);
                    g.add(h);
                } else {
                    const h = new THREE.Mesh(new THREE.TorusGeometry(0.02, 0.0035, 10, 28, Math.PI), mat);
                    h.rotation.z = Math.PI / 2;
                    h.position.set(-0.031, 0.047, 0);
                    g.add(h);
                }
                g.scale.setScalar(scale);
                g.userData.spouts = [new THREE.Vector3(0.039, 0.086, 0).multiplyScalar(scale)];
                g.userData.tilt = THREE.MathUtils.degToRad(longHandle ? 70 : 62);
                return g;
            }
            function makePortafilter() {
                const g = new THREE.Group();
                g.add(lathe([[0, -0.012], [0.03, -0.012], [0.033, 0.0], [0.034, 0.01], [0.0, 0.01]], steel));
                const handle = new THREE.Mesh(new THREE.CylinderGeometry(0.008, 0.011, 0.11, 20), wood);
                handle.rotation.z = Math.PI / 2;
                handle.position.set(-0.088, 0, 0);
                g.add(handle);
                const spouts = [];
                for (const dz of [-0.0065, 0.0065]) {
                    const s = new THREE.Mesh(new THREE.CylinderGeometry(0.0034, 0.0022, 0.012, 14), steel);
                    s.position.set(0, -0.018, dz);
                    g.add(s);
                    spouts.push(new THREE.Vector3(0, -0.024, dz));
                }
                g.userData.spouts = spouts;
                g.userData.tilt = 0;
                return g;
            }
            function makeSpoon() {
                const g = new THREE.Group();
                const bowl = new THREE.Mesh(new THREE.SphereGeometry(0.011, 24, 12, 0, Math.PI * 2, Math.PI / 2, Math.PI / 2), steel);
                bowl.scale.set(1.45, 0.55, 1);
                g.add(bowl);
                const stem = new THREE.Mesh(new THREE.CylinderGeometry(0.0018, 0.0026, 0.1, 10), steel);
                stem.rotation.z = Math.PI / 2 - 0.25;
                stem.position.set(-0.064, 0.012, 0);
                g.add(stem);
                g.userData.spouts = [new THREE.Vector3(0.012, 0, 0)];
                g.userData.tilt = THREE.MathUtils.degToRad(80);
                return g;
            }
            const vessels = {
                jug: makeJug(steel), kettle: makeJug(darkSteel, 1.25), finjan: makeJug(brass, 0.62, true),
                portafilter: makePortafilter(), spoon: makeSpoon(),
            };
            Object.values(vessels).forEach((v) => {
                v.visible = false;
                v.traverse((o) => { if (o.isMesh) o.castShadow = true; });
            });

            // stream: an open tube from the spout down to the surface, wobbling
            const streamGeo = new THREE.CylinderGeometry(1, 1, 1, 12, 24, true).translate(0, -0.5, 0);
            const streamBase = streamGeo.attributes.position.array.slice();
            function makeStream() {
                const m = new THREE.Mesh(streamGeo.clone(), new THREE.MeshPhysicalMaterial({ roughness: 0.2, clearcoat: 0.6, side: THREE.DoubleSide,
                    clippingPlanes: [new THREE.Plane(new THREE.Vector3(0, -1, 0), 10)] }));  // same shader as the liquids
                m.userData.base = streamBase;
                m.visible = false;
                return m;
            }
            const streams = [makeStream(), makeStream()];

            // the rising liquid surface, with ripples spreading from where the stream lands
            const surfMat = new THREE.MeshPhysicalMaterial({ roughness: 0.3, clearcoat: 0.5, side: THREE.DoubleSide, clippingPlanes: [new THREE.Plane(new THREE.Vector3(0, -1, 0), 10)] });
            let surface = null;
            function makeSurface(sweep) {
                const geo = new THREE.RingGeometry(0.0004, 1, 64, 10, 0, sweep);
                const m = new THREE.Mesh(geo, surfMat);
                m.rotation.x = -Math.PI / 2;
                m.userData.base = geo.attributes.position.array.slice();
                m.visible = false;
                return m;
            }

            // splash droplets
            const MAXD = 80;
            const drops = new THREE.InstancedMesh(new THREE.SphereGeometry(1, 8, 6), new THREE.MeshStandardMaterial({ roughness: 0.3 }), MAXD);
            drops.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
            drops.frustumCulled = false;
            drops.setColorAt(0, new THREE.Color());  // create the colour buffer now, not mid-pour
            const dropState = Array.from({ length: MAXD }, () => ({ life: 0, p: new THREE.Vector3(), v: new THREE.Vector3(), r: 0, c: new THREE.Color() }));
            const tmpM = new THREE.Matrix4();
            let dropIdx = 0;
            function spawnDrop(p, color, up = 1) {
                const d = dropState[dropIdx++ % MAXD];
                d.life = 0.35 + Math.random() * 0.3;
                d.p.copy(p);
                const a = Math.random() * Math.PI * 2, s = 0.04 + Math.random() * 0.08;
                d.v.set(Math.cos(a) * s, up * (0.12 + Math.random() * 0.18), Math.sin(a) * s);
                d.r = 0.0006 + Math.random() * 0.0009;
                d.c.set(color);
            }

            // steam
            const steamTex = (() => {
                const c = document.createElement('canvas');
                c.width = c.height = 64;
                const x = c.getContext('2d');
                const g = x.createRadialGradient(32, 32, 0, 32, 32, 32);
                g.addColorStop(0, 'rgba(255,255,255,1)');
                g.addColorStop(1, 'rgba(255,255,255,0)');
                x.fillStyle = g;
                x.fillRect(0, 0, 64, 64);
                return new THREE.CanvasTexture(c);
            })();
            const steam = Array.from({ length: 16 }, (_, i) => {
                const s = new THREE.Sprite(new THREE.SpriteMaterial({ map: steamTex, transparent: true, depthWrite: false, opacity: 0 }));
                s.userData = { phase: i / 16, dx: Math.random() - 0.5, dz: Math.random() - 0.5, sway: Math.random() * 6 };
                return s;
            });

            // latte art, drawn on a canvas
            function artTexture(kind) {
                const c = document.createElement('canvas');
                c.width = c.height = 512;
                const x = c.getContext('2d');
                x.fillStyle = '#b98352';
                x.beginPath(); x.arc(256, 256, 256, 0, Math.PI * 2); x.fill();
                const g = x.createRadialGradient(256, 256, 180, 256, 256, 256);
                g.addColorStop(0, 'rgba(250,244,232,0)');
                g.addColorStop(1, 'rgba(250,244,232,0.9)');
                x.fillStyle = g;
                x.fillRect(0, 0, 512, 512);
                x.translate(256, 256);
                x.rotate(THREE.MathUtils.degToRad(-50));  // point the heart at the camera
                x.fillStyle = '#fbf6ec';
                x.shadowColor = 'rgba(251,246,236,0.9)';
                x.shadowBlur = 14;
                const heart = (cy, s) => {
                    x.beginPath();
                    x.moveTo(0, cy + 95 * s);
                    x.bezierCurveTo(-150 * s, cy - 10 * s, -95 * s, cy - 120 * s, 0, cy - 55 * s);
                    x.bezierCurveTo(95 * s, cy - 120 * s, 150 * s, cy - 10 * s, 0, cy + 95 * s);
                    x.fill();
                };
                if (kind === 'tulip') { heart(-70, 0.62); heart(10, 0.78); heart(95, 0.9); }
                else heart(0, 1.15);
                x.fillRect(-3, -150, 6, 260 * (kind === 'tulip' ? 1.1 : 0.9));  // the pull-through line
                const t = new THREE.CanvasTexture(c);
                t.colorSpace = THREE.SRGBColorSpace;
                t.anisotropy = 4;
                return t;
            }
            const artMat = new THREE.MeshStandardMaterial({ roughness: 0.75, transparent: true, opacity: 0 });
            const artCache = {};

            // ---------- drinks ----------
            const roots = {};
            let cur = null;
            let step = -1;
            let anims = [];      // layer reveals
            let sessions = [];   // vessel visits
            let timer = null;
            let art = null, artAt = Infinity;

            const innerR = (cup, y) => {
                const lift = cup.saucer ? 0.0058 : 0;
                const t = clamp((y - cup.base - lift) / cup.H);
                return (cup.r0 + (cup.r1 - cup.r0) * Math.pow(t, cup.p)) * (cup.glass ? 0.994 : 0.998);
            };

            function prepare(root, d) {
                const layers = {};
                root.traverse((o) => {
                    if (!o.isMesh) return;
                    o.castShadow = true;
                    o.receiveShadow = true;
                    if (o.material?.name === 'glass') {
                        o.material = glassMat;
                        o.castShadow = false;
                        return;
                    }
                    const ud = o.userData.layer ? o.userData : o.parent?.userData;
                    if (!ud?.layer) return;
                    const src = o.material;
                    // every liquid shares one shader: same features, one clipping plane that is moved, never swapped
                    const kind = d.layers.find((l) => l.id === ud.layer)?.kind;
                    const gloss = ['espresso', 'americano', 'black', 'chocolate'].includes(kind) ? 1 : ['milk', 'band', 'nes'].includes(kind) ? 0.35 : 0.05;
                    const plane = new THREE.Plane(new THREE.Vector3(0, -1, 0), 10);
                    const m = new THREE.MeshPhysicalMaterial({ color: src.color, roughness: src.roughness, metalness: 0, side: THREE.DoubleSide,
                        clearcoat: gloss, clearcoatRoughness: gloss > 0.5 ? 0.08 : 0.3, clippingPlanes: [plane] });
                    o.material = m;
                    const shape = d.layers.find((l) => l.id === ud.layer)?.shape;
                    layers[ud.layer] = { mesh: o, z0: ud.z0, z1: ud.z1, anchor: new THREE.Vector3(...ud.anchor), baseY: o.position.y, shape, plane };
                });
                const fx = new THREE.Group();
                fx.name = 'fx';
                root.add(fx);
                return { layers, fx, rimY: root.userData.rim, cup: cups[d.cup] };
            }

            function frame(root, id) {
                const box = new THREE.Box3();
                root.children.forEach((ch) => { if (ch.name !== 'fx') box.expandByObject(ch); });  // not the vessels or steam
                const sphere = box.getBoundingSphere(new THREE.Sphere());
                const c = sphere.center, r = sphere.radius * 1.3;  // headroom for the jug and portafilter above the cup
                const fov = THREE.MathUtils.degToRad(camera.fov);
                const fit = Math.min(fov, 2 * Math.atan(Math.tan(fov / 2) * camera.aspect));
                const dist = (r / Math.sin(fit / 2)) * 0.95;
                const yaw = THREE.MathUtils.degToRad(40), pitch = THREE.MathUtils.degToRad(byId[id].cup === 'tallglass' ? 14 : 22);
                const dir = new THREE.Vector3(Math.cos(pitch) * Math.cos(yaw), Math.sin(pitch), Math.cos(pitch) * Math.sin(yaw));
                const right = new THREE.Vector3().crossVectors(new THREE.Vector3(0, 1, 0), dir).normalize();
                controls.target.copy(c).addScaledVector(right, r * (camera.aspect > 1 ? 0.3 : 0.12));
                controls.target.y += r * 0.3;
                camera.position.copy(controls.target).addScaledVector(dir, dist);
                controls.minDistance = r * 1.4;
                controls.maxDistance = r * 8;
                controls.update();
            }

            function setReveal(L, t, how) {
                const m = L.mesh;
                m.visible = t > 0;
                m.position.y = L.baseY;
                m.scale.setScalar(1);
                L.plane.normal.set(0, -1, 0);
                L.plane.constant = 10;  // keeps everything
                L.h = null;
                if (t <= 0 || t >= 1) return;
                const e = how === 'up' || how === 'down' ? t : 1 - Math.pow(1 - t, 3);
                if (how === 'dot') { m.scale.set(e, 1, e); return; }
                if (how === 'drop') { m.position.y = L.baseY + (1 - e) * 0.12; return; }
                const h = how === 'down' ? L.z1 - (L.z1 - L.z0) * e : L.z0 + (L.z1 - L.z0) * e;
                L.h = h;
                if (how === 'down') { L.plane.normal.set(0, 1, 0); L.plane.constant = -h; }
                else L.plane.constant = h;
            }

            const layerOf = (d, id) => d.layers.find((x) => x.id === id);
            const howOf = (l) => (l.shape === 'dot' ? 'dot' : l.shape === 'scoop' || l.shape === 'straw' ? 'drop' : l.pour || 'up');
            const vesselOf = (l) => ('vessel' in l ? l.vessel : VESSEL[l.kind] ?? null);
            const streamColor = (l, v) => (v === 'kettle' ? WATER : v === 'portafilter' ? '#6e3818' : l.kind === 'nes' ? colors.milk : colors[l.kind]);

            function clearFx() {
                Object.values(vessels).forEach((v) => (v.visible = false));
                streams.forEach((s) => (s.visible = false));
                if (surface) surface.visible = false;
                dropState.forEach((d) => (d.life = 0));
            }

            function showStep(n, animate = true) {
                const d = cur.d;
                step = Math.max(-1, Math.min(n, d.steps.length - 1));
                anims = [];
                sessions = [];
                clearFx();
                const shown = new Set(d.steps.slice(0, step).flatMap((s) => s.reveal));
                const now = step >= 0 ? d.steps[step].reveal : [];
                for (const [id, L] of Object.entries(cur.layers)) setReveal(L, shown.has(id) ? 1 : 0, 'up');
                const last = step === d.steps.length - 1;
                if (art) { art.material.opacity = 0; artAt = Infinity; }
                let t = performance.now() + 120, prev = null;
                for (const id of now) {
                    const L = cur.layers[id];
                    if (!L) continue;
                    const l = layerOf(d, id);
                    const how = howOf(l);
                    const vessel = animate && !reduced ? vesselOf(l) : null;
                    const pre = vessel && vessel !== prev ? 650 : 0;
                    const dur = reduced || !animate ? 0 : how === 'up' || how === 'down' ? clamp((L.z1 - L.z0) * 30000, 800, 2400) : 650;
                    const start = t + pre;
                    anims.push({ L, l, how, start, dur, vessel });
                    if (vessel) {
                        const s = sessions[sessions.length - 1];
                        if (s && s.vessel === vessel && prev === vessel) s.end = start + dur;
                        else sessions.push({ vessel, from: start - pre, end: start + dur });
                    }
                    t = start + dur * (vessel ? 1 : 0.85);
                    prev = vessel;
                }
                const total = Math.max(t, ...sessions.map((s) => s.end + 500)) - performance.now();
                if (art && last) artAt = performance.now() + total - 200;
                $$('.cb-panel.is-on .cb-step').forEach((li, i) => {
                    li.classList.toggle('bg-amber-500/10', i === step);
                    li.classList.toggle('border-amber-500/40', i === step);
                    li.classList.toggle('opacity-50', i > step);
                });
                return total;
            }

            function play() {
                clearTimeout(timer);
                const go = (i) => {
                    const t = showStep(i);
                    if (i < cur.d.steps.length - 1) timer = setTimeout(() => go(i + 1), t + (reduced ? 900 : 700));
                };
                showStep(-1);
                timer = setTimeout(() => go(0), 400);
            }

            function select(id, { autoplay = true } = {}) {
                if (!byId[id]) id = 'hafuch';
                $$('.cb-panel').forEach((p) => { const on = p.dataset.drink === id; p.classList.toggle('hidden', !on); p.classList.toggle('is-on', on); });
                $$('.cb-pick').forEach((a) => {
                    const on = a.dataset.drink === id;
                    a.classList.toggle('border-amber-400', on);
                    a.classList.toggle('ring-2', on);
                    a.classList.toggle('ring-amber-500/40', on);
                    if (on) a.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
                });
                if (!roots[id]) return;  // model not loaded yet; select() runs again once it is
                Object.entries(roots).forEach(([k, r]) => (r.root.visible = k === id));
                cur = roots[id];
                cur.root.rotation.y = 0;
                touched = false;
                // move the shared effects into this drink
                const sweep = cur.cup.glass ? Math.PI * 2 : Math.PI * 1.5;
                if (!cur.surface) cur.surface = makeSurface(sweep);
                surface = cur.surface;
                cur.fx.add(surface, drops, ...streams, ...Object.values(vessels), ...steam);
                art = null;
                if (cur.d.art) {
                    if (!cur.art) {
                        const top = Math.max(...cur.d.layers.filter((l) => !l.shape && cur.layers[l.id]).map((l) => cur.layers[l.id].z1));
                        const tex = artCache[cur.d.art] ??= artTexture(cur.d.art);
                        const m = new THREE.Mesh(new THREE.RingGeometry(0.0004, innerR(cur.cup, top), 64, 1, 0, sweep), artMat.clone());
                        m.material.map = tex;
                        m.rotation.x = -Math.PI / 2;
                        m.position.y = top + 0.0004;
                        cur.art = m;
                    }
                    art = cur.art;
                    cur.fx.add(art);
                }
                frame(cur.root, id);
                if (autoplay) play(); else showStep(cur.d.steps.length - 1, false);
            }

            // ---------- per-frame effects ----------
            const v3 = new THREE.Vector3(), q = new THREE.Quaternion(), eul = new THREE.Euler(0, 0, 0, 'YXZ');
            const back = new THREE.Vector3(-Math.cos(-YAW), 0, -Math.sin(-YAW));  // away from the camera
            function liquidTop(exceptL) {
                let top = cur.cup.base + (cur.cup.saucer ? 0.0058 : 0);
                for (const L of Object.values(cur.layers)) {
                    if (L === exceptL || !L.mesh.visible || L.shape === 'straw' || L.shape === 'dot') continue;
                    top = Math.max(top, L.h ?? L.z1);
                }
                return top;
            }

            function updateFx(now, dt) {
                if (!cur) return;
                const rimY = cur.rimY;
                Object.values(vessels).forEach((v) => (v.visible = false));
                streams.forEach((s) => (s.visible = false));
                surface.visible = false;

                // every vessel on stage now (one may be leaving while the next comes in)
                const spoutsOf = {};
                let spoonTilt = 0;
                for (const s of sessions) {
                    if (now < s.from || now > s.end + 600) continue;
                    const vessel = vessels[s.vessel];
                    const p = smooth(s.from, s.from + 380, now) * (1 - smooth(s.end + 180, s.end + 600, now));
                    const tilt = smooth(s.from + 280, s.from + 650, now) * (1 - smooth(s.end, s.end + 260, now));
                    const target = new THREE.Vector3(IMPACT.x, rimY + (s.vessel === 'portafilter' ? 0.075 : s.vessel === 'spoon' ? 0.018 : 0.03), IMPACT.z);
                    eul.set(0, YAW, -vessel.userData.tilt * tilt);
                    q.setFromEuler(eul);
                    vessel.quaternion.copy(q);
                    const sp = vessel.userData.spouts, k = vessel.scale.x;
                    const mid = sp.reduce((a, b) => a.clone().add(b), new THREE.Vector3()).multiplyScalar(k / sp.length);
                    vessel.position.copy(target).sub(mid.applyQuaternion(q));
                    if (s.vessel !== 'portafilter') vessel.position.addScaledVector(back, (1 - p) * 0.09);
                    vessel.position.y += (1 - p) * 0.09;
                    vessel.visible = p > 0.01;
                    spoutsOf[s.vessel] = sp.map((x) => x.clone().multiplyScalar(k).applyQuaternion(q).add(vessel.position));
                    if (s.vessel === 'spoon') spoonTilt = tilt;
                }

                // streams and the rising surface for the layer being poured
                for (const a of anims) {
                    if (!a.vessel || a.vessel === 'spoon') continue;
                    const t0 = a.start - 120, t1 = a.start + a.dur;
                    const spoutsW = spoutsOf[a.vessel];
                    if (now < t0 || now > t1 + 700 || !spoutsW) continue;
                    const surfY = a.how === 'down' ? liquidTop(a.L) : a.L.h ?? (now < a.start ? a.L.z0 : a.L.z1);
                    const col = streamColor(a.l, a.vessel);
                    spoutsW.forEach((sp, i) => {
                        const st = streams[i];
                        const fall = (tt) => sp.y - 0.5 * GRAVITY * Math.pow(Math.max(0, (now - tt) / 1000), 2);
                        const front = Math.max(fall(t0), surfY);
                        const top = now > t1 ? fall(t1) : sp.y;
                        if (top <= front + 0.0005) return;
                        const r = a.vessel === 'portafilter' ? 0.00105 : a.vessel === 'finjan' ? 0.0022 : a.l.kind === 'foam' ? 0.0038 : 0.003;
                        st.visible = true;
                        st.position.set(sp.x, top, sp.z);
                        st.scale.set(1, top - front, 1);
                        st.material.color.set(col);
                        st.material.transparent = a.vessel === 'kettle';
                        st.material.opacity = a.vessel === 'kettle' ? 0.55 : 1;
                        // narrow as it falls, and wobble
                        const pos = st.geometry.attributes.position, b = st.userData.base;
                        for (let k = 0; k < pos.count; k++) {
                            const by = b[k * 3 + 1];  // 0 at the spout, -1 at the surface
                            const w = (1 - 0.45 * Math.min(1, -by * 2)) * r * (1 + 0.12 * Math.sin(by * 40 + now * 0.03));
                            const wob = Math.sin(by * 9 + now * 0.012) * 0.0007 * -by;
                            pos.setXYZ(k, b[k * 3] * w + wob, by, b[k * 3 + 2] * w + wob * 0.6);
                        }
                        pos.needsUpdate = true;
                        if (front <= surfY + 0.0001 && Math.random() < 0.7) spawnDrop(new THREE.Vector3(sp.x, surfY, sp.z), col);
                    });
                    if (a.how === 'up' && a.L.h != null) {
                        const flatTop = a.L.z1 - (a.l.dome || 0);
                        if (a.L.h < flatTop) {
                            const R = innerR(cur.cup, a.L.h);
                            surface.visible = true;
                            surface.position.y = a.L.h + 0.0002;
                            surface.scale.set(R, R, 1);
                            surfMat.color.set(colors[a.l.kind]);
                            const pos = surface.geometry.attributes.position, b = surface.userData.base;
                            const ix = IMPACT.x / R, iy = -IMPACT.z / R;
                            for (let k = 0; k < pos.count; k++) {
                                const x = b[k * 3], y = b[k * 3 + 1];
                                const dd = Math.hypot(x - ix, y - iy) * R;
                                pos.setZ(k, 0.0007 * Math.sin(dd * 700 - now * 0.014) * Math.exp(-dd * 70));
                            }
                            pos.needsUpdate = true;
                            surface.geometry.computeVertexNormals();
                        }
                    }
                }

                // a spoon tips its contents out
                if (spoonTilt > 0.55 && spoutsOf.spoon) {
                    const a = anims.find((x) => x.vessel === 'spoon' && now >= x.start - 300 && now <= x.start + x.dur);
                    if (a && Math.random() < 0.8) spawnDrop(spoutsOf.spoon[0], colors[a.l.kind], -0.4);
                }

                // droplets
                const floorY = liquidTop(null);
                dropState.forEach((d, i) => {
                    if (d.life > 0) {
                        d.life -= dt;
                        d.v.y -= GRAVITY * 1.4 * dt;
                        d.p.addScaledVector(d.v, dt);
                        if (d.p.y < floorY - 0.002 && d.v.y < 0) d.life = 0;
                    }
                    const r = d.life > 0 ? d.r : 0;
                    tmpM.makeScale(r, r, r).setPosition(d.p);
                    drops.setMatrixAt(i, tmpM);
                    drops.setColorAt(i, d.c);
                });
                drops.instanceMatrix.needsUpdate = true;
                if (drops.instanceColor) drops.instanceColor.needsUpdate = true;

                // steam over hot drinks once something is in the cup
                const hot = !['ice', 'affogato'].includes(cur.d.id) && step >= 0;
                const R = innerR(cur.cup, rimY);
                steam.forEach((sp) => {
                    const u = sp.userData, age = (now / 4200 + u.phase) % 1;
                    sp.visible = hot;
                    sp.position.set(u.dx * R * 0.9 + Math.sin(age * u.sway) * 0.006, floorY + 0.004 + age * 0.07, u.dz * R * 0.9);
                    const sc = 0.012 + age * 0.03;
                    sp.scale.set(sc, sc, sc);
                    sp.material.opacity = 0.09 * Math.sin(Math.PI * age);
                });

                // latte art appears at the end
                if (art) art.material.opacity = smooth(artAt, artAt + 900, now);
            }

            // ---------- labels ----------
            const labelsEl = $('#cb-labels'), linesEl = $('#cb-lines');
            let showLabels = true;
            const v = new THREE.Vector3();
            function drawLabels() {
                labelsEl.innerHTML = '';
                linesEl.innerHTML = '';
                if (!cur || !showLabels) return;
                const w = el.clientWidth, h = el.clientHeight;
                let right = -Infinity;
                const box = new THREE.Box3();
                Object.values(cur.layers).forEach((L) => box.expandByObject(L.mesh));
                cur.root.traverse((o) => { if (o.isMesh && /__(cup|saucer)$/.test(o.name)) box.expandByObject(o); });
                for (const x of [0, 1]) for (const y of [0, 1]) for (const z of [0, 1]) {
                    v.set(x ? box.max.x : box.min.x, y ? box.max.y : box.min.y, z ? box.max.z : box.min.z).project(camera);
                    right = Math.max(right, (v.x + 1) / 2 * w);
                }
                const items = [];
                for (const [id, L] of Object.entries(cur.layers)) {
                    if (!L.mesh.visible) continue;
                    v.copy(L.anchor);
                    v.y += L.mesh.position.y - L.baseY;
                    if (L.h != null) v.y = Math.min(v.y, (L.z0 + L.h) / 2);
                    cur.root.localToWorld(v).project(camera);
                    const l = layerOf(cur.d, id);
                    items.push({ id, x: (v.x + 1) / 2 * w, y: (1 - v.y) / 2 * h, name: l.name, color: colors[l.kind] });
                }
                items.sort((a, b) => a.y - b.y);
                const lx = Math.min(right + 18, w - 150);
                let last = -Infinity;
                for (const it of items) { it.ly = Math.max(it.y, last + 24); last = it.ly; }
                for (const it of items) {
                    linesEl.insertAdjacentHTML('beforeend',
                        `<circle cx="${it.x}" cy="${it.y}" r="3" fill="#fff" stroke="#000" stroke-opacity=".4"/>` +
                        `<polyline points="${it.x},${it.y} ${lx - 6},${it.ly} ${lx},${it.ly}" fill="none" stroke="rgba(255,255,255,.55)" stroke-width="1"/>`);
                    const tag = document.createElement('span');
                    tag.className = 'absolute text-xs px-2 py-0.5 rounded-full bg-black/60 border border-white/15 whitespace-nowrap flex items-center gap-1.5 -translate-y-1/2';
                    tag.style.left = `${lx}px`;
                    tag.style.top = `${it.ly}px`;
                    tag.innerHTML = `<i class="inline-block w-2 h-2 rounded-full" style="background:${it.color}"></i>`;
                    tag.append(it.name);
                    labelsEl.append(tag);
                }
            }

            // ---------- load ----------
            const draco = new DRACOLoader().setDecoderPath('/draco/');
            new GLTFLoader().setDRACOLoader(draco).load('/3d/coffee-bar/coffee-bar.glb', (g) => {
                for (const root of [...g.scene.children]) {
                    const id = root.name.replace(/^drink_/, '');
                    if (!byId[id]) continue;
                    scene.add(root);
                    roots[id] = { d: byId[id], root, ...prepare(root, byId[id]) };
                }
                // compile every shader up front (all drinks, vessels, streams) so pours don't stall on it
                status.textContent = 'Warming up the espresso machine…';
                const warm = new THREE.Group();
                const tmpSurf = makeSurface(Math.PI * 2);
                const tmpArt = new THREE.Mesh(new THREE.CircleGeometry(0.03), artMat);
                warm.add(...Object.values(vessels), ...streams, tmpSurf, tmpArt, drops, ...steam);
                warm.traverse((o) => (o.visible = true));
                scene.add(warm);
                const done = () => {
                    scene.remove(warm);
                    clearFx();
                    renderer.domElement.style.display = 'block';
                    $('#cb-fallback')?.remove();
                    status.textContent = '';
                    select(location.hash.slice(1));
                };
                (renderer.compileAsync ? renderer.compileAsync(scene, camera) : Promise.resolve(renderer.compile(scene, camera))).then(done, done);
            }, undefined, () => { status.textContent = '3D unavailable here, showing a still render'; });

            select(location.hash.slice(1) || 'hafuch');
            addEventListener('hashchange', () => el.isConnected && select(location.hash.slice(1)));
            addEventListener('popstate', () => el.isConnected && byId[location.hash.slice(1)] && select(location.hash.slice(1)));
            // Astro's router turns #drink links into pushState, which never fires hashchange, so handle them here.
            // Clicking the drink that's already up makes it again.
            el.closest('main').addEventListener('click', (e) => {
                const a = e.target.closest('a[href^="#"]');
                const id = a?.getAttribute('href').slice(1);
                if (!byId[id] || e.button || e.metaKey || e.ctrlKey || e.shiftKey) return;
                e.preventDefault();
                history.replaceState(history.state, '', `#${id}`);
                select(id);
                const view = el.getBoundingClientRect();
                if (!a.closest('#cb-picker') && (view.top < 0 || view.bottom > innerHeight)) el.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'center' });
            });
            $('#cb-play').addEventListener('click', () => cur && play());
            $('#cb-next').addEventListener('click', () => { if (cur) { clearTimeout(timer); showStep(step + 1); } });
            $('#cb-prev').addEventListener('click', () => { if (cur) { clearTimeout(timer); showStep(step - 1, false); } });
            $('#cb-reset').addEventListener('click', () => { if (cur) { touched = false; frame(cur.root, cur.d.id); } });
            $('#cb-showlabels').addEventListener('change', (e) => (showLabels = e.target.checked));
            $$('.cb-step').forEach((li) => li.addEventListener('click', () => { if (cur) { clearTimeout(timer); showStep(+li.dataset.step); } }));
            const highlight = (id) => cur && Object.entries(cur.layers).forEach(([k, L]) => L.mesh.material.emissive.setHex(k === id ? 0x4a3018 : 0));
            $$('.cb-legend, .cb-swatch').forEach((x) => {
                x.addEventListener('mouseenter', () => highlight(x.dataset.layer));
                x.addEventListener('mouseleave', () => highlight(null));
            });

            let lastT = performance.now();
            renderer.setAnimationLoop((now) => {
                const dt = Math.min(0.05, (now - lastT) / 1000);
                lastT = now;
                for (const a of anims) {
                    const t = a.dur ? (now - a.start) / a.dur : 1;
                    if (t >= 0 && !a.done) setReveal(a.L, Math.min(t, 1), a.how);
                    if (t >= 1) a.done = true;
                }
                if (cur && !touched && !reduced) cur.root.rotation.y = Math.sin(now / 3200) * 0.12;  // a slow sway while idle
                updateFx(now, dt);
                controls.update();
                renderer.render(scene, camera);
                drawLabels();
            });
        }

        boot();
        document.addEventListener('astro:page-load', boot);
    </script>
</Layout>
