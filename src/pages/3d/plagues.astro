---
// The Ten Plagues as snap-together toys for the Bambu A1 mini. Models and files come from
// scripts/3d-designs/plagues/build.py; card images from render.py.
import Layout from '../../layouts/Layout.astro';
import data from '../../../public/3d/plagues/kits.json';

const DIR = '/3d/plagues';
const kits = data.kits;
// a plague with more than one reading (arov, choshech) gets one kit per opinion
const groups = [...new Set(kits.map((k) => k.number))].map((n) => kits.filter((k) => k.number === n));
const plain = (he: string) => he.replace(/[\u0591-\u05C7]/g, '');
const groupEn = (g: typeof kits) => ({ 4: 'Arov, the mixture', 9: 'Darkness' } as Record<number, string>)[g[0].number] ?? g[0].en;
const fmt = (min: number) => (min >= 60 ? `${Math.floor(min / 60)} h ${String(min % 60).padStart(2, '0')} m` : `${min} m`);
const firsts = groups.map((g) => g[0]);
const totalPieces = firsts.reduce((n, k) => n + k.pieces, 0);
const totalGrams = Math.round(firsts.reduce((n, k) => n + k.grams, 0));
---

<Layout
    title="The Ten Plagues · עשר מכות: 3D-printable toys"
    description="Snap-together toys for each of the ten plagues in Exodus, with a kit for each reading where the commentators disagree, made to print on a Bambu A1 mini: pegs, slots and pins, no supports, with a 3MF plate and STLs for each."
    image={`${DIR}/hail/hail.webp`}
>
    <main class="max-w-6xl mx-auto px-4 py-8 text-gray-100">
        <p class="text-sm mb-4"><a href="/3d" class="text-amber-300 hover:underline">← 3D</a></p>
        <header class="mb-8">
            <h1 class="text-3xl md:text-4xl font-bold">The Ten Plagues</h1>
            <p class="mt-1 text-2xl text-amber-300" dir="rtl" lang="he">עֶשֶׂר מַכּוֹת</p>
            <p class="mt-3 text-gray-300 max-w-3xl">
                One small toy for each plague, the kind that comes out of a chocolate egg in pieces and clicks together.
                Each one stands on a 40&nbsp;mm stage with the plague's name sunk into the top and its number under it.
                They print on a Bambu A1 mini with no supports, one plate per plague, and go together with pegs, slots and little pins.
            </p>
            <p class="mt-2 text-gray-300 max-w-3xl">Where the commentators disagree about what a plague was, there's a toy for each reading: arov as wild animals or as hornets and mosquitoes, and choshech as darkness over the land or, with the Torah Temimah, a film over the eye.</p>
            <p class="mt-2 text-sm text-gray-400">{groups.length} plagues · {kits.length} toys · a set of ten is {totalPieces} pieces and about {totalGrams} g of PLA.</p>
        </header>

        <div class="grid grid-cols-2 sm:grid-cols-5 gap-2 mb-10">
            {groups.map((g) => (
                <a href={`#${g[0].slug}`} data-pick={g[0].slug} class="group relative rounded-lg overflow-hidden border border-gray-700 hover:border-amber-400 bg-gray-900">
                    <img src={`${DIR}/${g[0].slug}/${g[0].slug}.webp`} alt={`${plain(g[0].he)}: the printed toy`} width="720" height="720" loading="lazy" class="w-full aspect-square object-cover" />
                    <span class="absolute top-1.5 left-2 text-xs text-gray-300 drop-shadow">{g[0].number}</span>
                    {g.length > 1 && <span class="absolute top-1.5 right-1.5 text-[10px] px-1.5 py-0.5 rounded-full bg-amber-600 text-white">{g.length} views</span>}
                    <span class="block text-center py-1.5 border-t border-gray-800">
                        <span class="block text-2xl md:text-3xl font-bold text-amber-300 leading-tight" dir="rtl" lang="he">{g[0].he}</span>
                        <span class="block text-[11px] text-gray-400">{groupEn(g)}</span>
                    </span>
                </a>
            ))}
        </div>

        <section class="grid grid-cols-1 lg:grid-cols-5 gap-6 mb-12">
            <div class="lg:col-span-3">
                <div class="rounded-xl overflow-hidden border border-gray-700 bg-gray-900">
                    <div id="pl-viewer" class="w-full relative" style="height: 480px;">
                        <img id="pl-fallback" src={`${DIR}/blood/blood.webp`} alt="" class="absolute inset-0 w-full h-full object-contain" />
                    </div>
                    <div class="flex flex-wrap items-center gap-3 p-3 border-t border-gray-700 text-sm">
                        <label for="pl-explode" class="text-gray-300">Pull apart</label>
                        <input id="pl-explode" type="range" min="0" max="1" step="0.01" value="0" class="flex-1 min-w-[8rem] accent-amber-500" />
                        <button id="pl-spin" type="button" class="px-3 py-1 rounded bg-gray-700 hover:bg-gray-600" aria-pressed="true">Spin</button>
                    </div>
                </div>
                <p id="pl-status" class="text-xs text-gray-500 mt-2">Drag to orbit, scroll to zoom. Slide to see how the pieces go together.</p>
            </div>
            <aside id="pl-info" class="lg:col-span-2 rounded-xl border border-gray-700 bg-gray-900/60 p-5"></aside>
        </section>

        <section class="mb-12">
            <h2 class="text-2xl font-bold mb-3">Printing them</h2>
            <div class="grid md:grid-cols-3 gap-4 text-sm text-gray-300">
                <div class="rounded-xl border border-gray-700 bg-gray-900/60 p-4">
                    <h3 class="font-semibold text-gray-100 mb-1">Settings</h3>
                    <p>PLA, 0.4 nozzle, 0.2&nbsp;mm layers, 15% infill, <strong>no supports</strong>. Every part is already turned onto its print face. Open the plate 3MF and slice: it's laid out for the A1 mini's 180&nbsp;mm bed.</p>
                </div>
                <div class="rounded-xl border border-gray-700 bg-gray-900/60 p-4">
                    <h3 class="font-semibold text-gray-100 mb-1">Colours</h3>
                    <p>The 3MF already has a colour on each part, so with an AMS you match them to your spools. Without one, print each colour as its own plate from the STLs. The few two-colour details (the blood on the doorposts, the cow's patches, the lit window, the lens) are separate STLs. They sit 0.6&nbsp;mm proud, so you can paint them instead.</p>
                </div>
                <div class="rounded-xl border border-gray-700 bg-gray-900/60 p-4">
                    <h3 class="font-semibold text-gray-100 mb-1">Fit</h3>
                    <p>Pins are Ø3&nbsp;mm in Ø3.3 holes, and slots have 0.15&nbsp;mm each side: a firm push fit on a tuned A1 mini. If one is tight, roll the pin on sandpaper. If it's loose, add a drop of glue. Don't rescale a kit, or the pins stop fitting their holes.</p>
                </div>
            </div>
            <p class="text-xs text-gray-500 mt-3">Times and grams are rough estimates for Bambu default speeds. The slicer has the final word. For the hail, print the hailstone halves in clear or translucent PLA/PETG and the flame shows through.</p>
        </section>

        <section>
            <h2 class="text-2xl font-bold mb-3">All ten</h2>
            <div class="space-y-4">
                {groups.map((g) => (
                    <article class="rounded-xl border border-gray-700 bg-gray-900/60 p-4">
                        <header class="flex flex-wrap items-baseline gap-x-3 mb-3">
                            <span class="text-gray-500">{g[0].number}.</span>
                            <h3 class="text-3xl font-bold text-amber-300" dir="rtl" lang="he">{g[0].he}</h3>
                            <span class="text-lg text-gray-300">{groupEn(g)}</span>
                            <span class="text-xs text-gray-500">{g[0].verse}</span>
                        </header>
                        <div class="space-y-4">
                            {g.map((k) => (
                                <div id={k.slug} class="scroll-mt-20 grid sm:grid-cols-[160px_1fr] gap-4">
                                    <img src={`${DIR}/${k.slug}/${k.slug}.webp`} alt="" width="160" height="160" loading="lazy" class="w-40 h-40 rounded-lg object-cover" />
                                    <div>
                                        {k.opinion && <p class="font-semibold">{k.opinion} <span class="text-xs font-normal text-gray-400">· {k.source}</span></p>}
                                        <p class="text-sm text-gray-300 mt-1">{k.story}</p>
                                        <p class="text-xs text-gray-400 mt-2">
                                            {k.parts.map((p) => `${p.label}${p.qty > 1 && !p.label.includes('×') ? ` ×${p.qty}` : ''}`).join(' · ')}
                                        </p>
                                        <div class="flex flex-wrap items-center gap-2 mt-3 text-sm">
                                            <a href={`${DIR}/${k.slug}/${k.files.plate}`} download class="px-3 py-1 rounded bg-amber-600 hover:bg-amber-500 text-white font-medium">⬇️ Plate (3MF)</a>
                                            <a href={`${DIR}/${k.slug}/${k.files.zip}`} download class="px-3 py-1 rounded bg-gray-700 hover:bg-gray-600">STLs (zip)</a>
                                            <button type="button" data-pick={k.slug} class="px-3 py-1 rounded bg-gray-700 hover:bg-gray-600">View in 3D ↑</button>
                                            <span class="text-gray-400 text-xs">{k.pieces} pieces · ≈ {k.grams} g · ≈ {fmt(k.minutes)}</span>
                                        </div>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </article>
                ))}
            </div>
        </section>
    </main>

    <script type="application/json" id="pl-data" set:html={JSON.stringify({ dir: DIR, kits })} />

    <script is:inline type="module">
        import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.160.0/+esm';
        import { OrbitControls } from 'https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/controls/OrbitControls.js/+esm';
        import { GLTFLoader } from 'https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/loaders/GLTFLoader.js/+esm';
        import { RoomEnvironment } from 'https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/environments/RoomEnvironment.js/+esm';

        const { dir, kits } = JSON.parse(document.getElementById('pl-data').textContent);
        const bySlug = Object.fromEntries(kits.map((k) => [k.slug, k]));
        const host = document.getElementById('pl-viewer');
        const info = document.getElementById('pl-info');
        const slider = document.getElementById('pl-explode');
        const spinBtn = document.getElementById('pl-spin');
        const fmt = (m) => (m >= 60 ? `${Math.floor(m / 60)} h ${String(m % 60).padStart(2, '0')} m` : `${m} m`);
        const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);

        const renderer = new THREE.WebGLRenderer({ antialias: true });
        renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        const scene = new THREE.Scene();
        scene.background = new THREE.Color(0x111318);
        scene.environment = new THREE.PMREMGenerator(renderer).fromScene(new RoomEnvironment(), 0.04).texture;
        const sun = new THREE.DirectionalLight(0xffffff, 1.2);
        sun.position.set(-40, 80, 60);
        scene.add(sun);
        const camera = new THREE.PerspectiveCamera(35, 1, 1, 2000);
        const controls = new OrbitControls(camera, renderer.domElement);
        controls.enableDamping = true;
        controls.autoRotate = true;
        controls.autoRotateSpeed = 1.2;

        function resize() {
            const w = host.clientWidth, h = host.clientHeight;
            renderer.setSize(w, h);
            camera.aspect = w / h;
            camera.updateProjectionMatrix();
        }

        const loader = new GLTFLoader();
        const cache = {};
        let current = null; // { root, moves: [[object, home, vector]] }

        function explodeVector(kit, nodeName) {
            const base = nodeName.split('--')[0];
            const part = kit.parts.find((p) => p.name === base) || (base.startsWith('pin-') && kit.parts.find((p) => p.name === 'pin'));
            return part ? new THREE.Vector3(...part.explode) : new THREE.Vector3();
        }

        function applyExplode() {
            if (!current) return;
            const t = Number(slider.value);
            const e = t * t * (3 - 2 * t);
            for (const [obj, home, v] of current.moves) obj.position.copy(home).addScaledVector(v, e);
        }

        function showInfo(kit) {
            const swatch = (hex) => `<span class="inline-block w-3.5 h-3.5 rounded border border-gray-600 align-middle" style="background:${hex}"></span>`;
            const rows = kit.parts.map((p, n) => {
                const extra = p.inlays.map((i) => ` + ${swatch(i.hex)} ${esc(i.name)}`).join('');
                const qty = p.qty > 1 && !p.label.includes('×') ? ` ×${p.qty}` : '';
                return `<li class="flex gap-2"><span class="text-gray-500 w-4 text-right shrink-0">${n + 1}</span><span>${swatch(p.hex)} ${esc(p.label)}${qty}${extra}</span></li>`;
            }).join('');
            const siblings = kits.filter((k) => k.number === kit.number);
            const tabs = siblings.length > 1 ? `<div class="flex flex-wrap gap-2 mt-3" role="tablist">${siblings.map((k) => `
                <button type="button" data-pick="${k.slug}" role="tab" aria-selected="${k.slug === kit.slug}" class="text-left px-3 py-1.5 rounded-lg border text-sm ${k.slug === kit.slug ? 'border-amber-400 bg-amber-600/20' : 'border-gray-700 hover:border-gray-500'}">
                    <span class="block font-medium">${esc(k.opinion)}</span><span class="block text-[11px] text-gray-400">${esc(k.source)}</span></button>`).join('')}</div>` : '';
            info.innerHTML = `
                <p class="text-xs text-gray-500">${kit.number} of 10 · ${esc(kit.verse)}</p>
                <h2 class="text-5xl font-bold text-amber-300 leading-tight mt-1" dir="rtl" lang="he">${esc(kit.he)}</h2>
                <p class="text-lg text-gray-300">${esc(kit.en)}</p>
                ${tabs}
                <p class="text-sm text-gray-300 mt-3">${esc(kit.story)}</p>
                <h3 class="font-semibold mt-4 mb-1 text-sm">Pieces, in the order they go together</h3>
                <ol class="text-sm text-gray-300 space-y-1">${rows}</ol>
                <dl class="grid grid-cols-2 gap-y-1 text-sm mt-4">
                    <dt class="text-gray-400">Pieces</dt><dd class="text-right font-mono">${kit.pieces}</dd>
                    <dt class="text-gray-400">Filament</dt><dd class="text-right font-mono">≈ ${kit.grams} g · ${kit.metres} m</dd>
                    <dt class="text-gray-400">Print time</dt><dd class="text-right font-mono">≈ ${fmt(kit.minutes)}</dd>
                </dl>
                <div class="flex flex-wrap gap-2 mt-4 text-sm">
                    <a href="${dir}/${kit.slug}/${kit.files.plate}" download class="px-3 py-1 rounded bg-amber-600 hover:bg-amber-500 text-white font-medium">⬇️ Plate (3MF)</a>
                    <a href="${dir}/${kit.slug}/${kit.files.zip}" download class="px-3 py-1 rounded bg-gray-700 hover:bg-gray-600">STLs (zip)</a>
                </div>`;
        }

        function show(slug) {
            const kit = bySlug[slug];
            if (!kit) return;
            showInfo(kit);
            info.querySelectorAll('[data-pick]').forEach((el) => el.addEventListener('click', () => show(el.dataset.pick)));
            document.querySelectorAll('[data-pick]').forEach((el) => el.classList.toggle('border-amber-400', bySlug[el.dataset.pick]?.number === kit.number));
            const use = (gltf) => {
                if (current) scene.remove(current.root);
                const root = gltf.scene;
                const moves = [];
                root.traverse((o) => {
                    if (o.isMesh) moves.push([o, o.position.clone(), explodeVector(kit, o.name)]);
                });
                current = { root, moves };
                scene.add(root);
                const box = new THREE.Box3().setFromObject(root);
                const c = box.getCenter(new THREE.Vector3());
                const r = box.getSize(new THREE.Vector3()).length() / 2;
                controls.target.copy(c);
                camera.position.copy(c).add(new THREE.Vector3(-0.45, 0.55, 1).normalize().multiplyScalar(r * 3.4));
                camera.near = r / 20;
                camera.far = r * 40;
                camera.updateProjectionMatrix();
                applyExplode();
            };
            if (cache[slug]) use(cache[slug]);
            else loader.load(`${dir}/${slug}/${kit.files.glb}`, (g) => { cache[slug] = g; use(g); });
        }

        host.appendChild(renderer.domElement);
        document.getElementById('pl-fallback').remove();
        resize();
        addEventListener('resize', resize);
        slider.addEventListener('input', applyExplode);
        spinBtn.addEventListener('click', () => {
            controls.autoRotate = !controls.autoRotate;
            spinBtn.setAttribute('aria-pressed', String(controls.autoRotate));
        });
        document.querySelectorAll('[data-pick]').forEach((el) => el.addEventListener('click', (ev) => {
            ev.preventDefault();
            show(el.dataset.pick);
            host.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }));
        show(bySlug[location.hash.slice(1)] ? location.hash.slice(1) : 'blood');
        renderer.setAnimationLoop(() => { controls.update(); renderer.render(scene, camera); });
    </script>
</Layout>
