---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="Illuminated Bible Chapters · 929">
  <section class="mx-auto max-w-3xl rounded-lg border border-amber-300/60 bg-white/60 p-6 shadow-inner prose prose-slate dark:prose-invert">
    <h1>Illuminated Bible Chapters · 929</h1>
    <p class="opacity-80">Enter a Sefaria reference like <code>Genesis 1</code> or <code>Genesis 1:1-5</code>, choose a language, and view the page.</p>

    <form id="goform" class="flex flex-wrap items-end gap-3 not-prose" onsubmit="return go(event)">
      <label class="flex flex-col gap-1">
        <span class="font-semibold">Sefaria ref</span>
        <input id="ref" type="text" value="Genesis 1" placeholder="e.g. Genesis 1 or Exodus 3" class="min-w-[260px] rounded-md border border-slate-300 bg-white px-3 py-2 text-slate-800 dark:bg-slate-900 dark:text-slate-100" />
      </label>
      <label class="flex flex-col gap-1">
        <span class="font-semibold">Language</span>
        <select id="lang" class="rounded-md border border-slate-300 bg-white px-3 py-2 text-slate-800 dark:bg-slate-900 dark:text-slate-100">
          <option value="en" selected>English</option>
          <option value="he">Hebrew</option>
        </select>
      </label>
      <button type="submit" class="rounded-md border border-amber-400 bg-amber-100 px-4 py-2 font-semibold text-slate-800 hover:bg-amber-200">Open</button>
    </form>

    <div class="not-prose pt-4 text-sm">
      <strong>Examples:</strong>
      <a class="ml-2 underline" href="/929/Genesis%201?lang=en">Genesis 1 (EN)</a>
      <a class="ml-2 underline" href="/929/Exodus%203?lang=en">Exodus 3 (EN)</a>
      <a class="ml-2 underline" href="/929/%D7%91%D7%A8%D7%90%D7%A9%D7%99%D7%AA%201?lang=he">בראשית 1 (HE)</a>
    </div>
  </section>

  <script is:inline>
    function go(e){
      e.preventDefault();
      const refEl = document.getElementById('ref');
      const langEl = document.getElementById('lang');
      const ref = (refEl && 'value' in refEl) ? (refEl as HTMLInputElement).value.trim() : '';
      const lang = (langEl && 'value' in langEl) ? (langEl as HTMLSelectElement).value : 'en';
      if(!ref){ alert('Please enter a reference'); return false; }
      const url = '/929/' + encodeURIComponent(ref) + '?lang=' + encodeURIComponent(lang);
      window.location.href = url;
      return false;
    }
  </script>
</Layout>
