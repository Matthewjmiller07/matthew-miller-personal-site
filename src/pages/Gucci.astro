---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="The Fifth Avenue Fabulist — SATIRE"
  description="100% fabricated satirical tabloid. Not real news. AI-illustrated absurdist headlines about Gucci fleeing New York City."
>
  <main class="min-h-screen bg-[#f4ecd8] text-black">

    <!-- Top satire banner -->
    <div class="bg-red-700 text-white text-center py-2 px-4 font-bold tracking-wide text-sm sm:text-base">
      ⚠️ SATIRE — EVERYTHING ON THIS PAGE IS FICTIONAL AND MADE UP FOR COMEDY. NONE OF IT HAPPENED. ⚠️
    </div>

    <!-- Tabloid masthead -->
    <div class="border-b-4 border-black px-4 py-6 text-center relative overflow-hidden">
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-[0.06] rotate-[-20deg] select-none">
        <span class="text-[10rem] sm:text-[14rem] font-black tracking-widest whitespace-nowrap">SATIRE</span>
      </div>
      <div class="relative">
        <div class="text-xs uppercase tracking-[0.3em] text-red-700 font-bold mb-1">A Totally Made-Up Satirical Gazette</div>
        <h1 class="text-4xl sm:text-6xl font-black tracking-tight" style="font-family: Georgia, 'Times New Roman', serif;">
          THE FIFTH AVENUE FABULIST
        </h1>
        <div class="text-xs sm:text-sm text-black/60 mt-2 italic">
          "If it's absurd enough to be funny, we printed it" · Est. never · Not a real newspaper
        </div>
      </div>
    </div>

    <div class="max-w-4xl mx-auto px-4 py-10">

      <p class="text-center text-sm text-black/70 mb-10 max-w-2xl mx-auto italic">
        The stories and images below are <strong>satire</strong> — invented for absurdist comedy, not factual reporting.
        Gucci has not left New York City, no company has relocated to the Moon, and City Hall has not banned handbags.
        Any resemblance to real policy is intentionally ridiculous.
      </p>

      <!-- Generate all button -->
      <div class="text-center mb-10">
        <button id="generate-all-btn"
          class="px-6 py-3 rounded-none border-2 border-black bg-black text-white font-bold uppercase tracking-wider text-sm hover:bg-white hover:text-black transition-colors disabled:opacity-40 disabled:cursor-not-allowed">
          🖼️ Illustrate These Fake Headlines (AI, low-cost)
        </button>
        <div class="text-xs text-black/50 mt-2">Uses GPT Image 2 on Replicate at low quality — a couple cents total.</div>
      </div>

      <div id="stories" class="space-y-14"></div>

    </div>

    <p class="text-center text-black/50 text-xs pb-4 px-4">
      Images generated on demand via <a href="https://replicate.com/openai/gpt-image-2" target="_blank" rel="noopener" class="underline hover:text-black">OpenAI GPT Image 2 on Replicate</a>.
    </p>

    <!-- Bottom satire banner -->
    <div class="bg-red-700 text-white text-center py-3 px-4 font-bold text-sm sm:text-base">
      SATIRE / PARODY. This page is a comedy bit, not journalism. No real events, companies, or officials' actions are being reported on factually.
    </div>
  </main>
</Layout>

<script>
const STORIES = [
  {
    headline: "Gucci Relocates Global HQ To The Moon After Mamdani's 'Handbags Must Be Shared Communally' Ordinance",
    dek: "CEO cites 'zero-gravity is the only place my Jackie 1961 is safe from mandatory neighborhood borrowing.'",
    prompt: "Absurdist satirical editorial illustration, obviously fake tabloid style, bold SATIRE watermark stamped diagonally across the whole image: a Gucci storefront being loaded onto a cartoonish rocket ship on a New York City street, moving boxes labeled 'HANDBAGS', a bewildered mannequin astronaut, exaggerated comedic proportions, bright satirical editorial cartoon style, low quality, playful and silly, clearly not photorealistic",
  },
  {
    headline: "Local Pigeons Officially Inherit Gucci's Fifth Avenue Flagship, City Declares Store A 'Bird Sanctuary'",
    dek: "Pigeons reportedly 'thrilled' with the loafer selection. Deed transfer ceremony held at dawn.",
    prompt: "Absurdist satirical editorial illustration, obviously fake tabloid style, bold SATIRE watermark stamped diagonally across the whole image: dozens of cartoon pigeons wearing tiny designer sunglasses strutting through a luxury storefront like they own it, a 'BIRD SANCTUARY' banner over the entrance, exaggerated comedic proportions, bright satirical editorial cartoon style, low quality, playful and silly, clearly not photorealistic",
  },
  {
    headline: "Gucci CEO Flees To Underwater Bunker, Cites 'Permission Slip Required For Loafers' Rule",
    dek: "Sources say the bunker is fully stocked with monogrammed flippers.",
    prompt: "Absurdist satirical editorial illustration, obviously fake tabloid style, bold SATIRE watermark stamped diagonally across the whole image: a cartoon fashion executive in a diving helmet and designer suit descending a ladder into a whimsical underwater bunker filled with shoeboxes, comically exaggerated, bright satirical editorial cartoon style, low quality, playful and silly, clearly not photorealistic",
  },
];

function storyCardHTML(i, story) {
  return `
    <article class="border-2 border-black bg-white/40">
      <div class="p-5 sm:p-6 border-b-2 border-black">
        <div class="text-[10px] uppercase tracking-[0.25em] text-red-700 font-bold mb-2">Satire · Fabricated Story #${i + 1}</div>
        <h2 class="text-2xl sm:text-3xl font-black leading-tight mb-2" style="font-family: Georgia, 'Times New Roman', serif;">${story.headline}</h2>
        <p class="text-black/70 italic text-sm">${story.dek}</p>
      </div>
      <div class="relative bg-black/5 min-h-[260px] flex items-center justify-center" id="art-slot-${i}">
        <div class="text-black/40 text-sm p-8 text-center" id="art-idle-${i}">Click "Illustrate These Fake Headlines" above to generate a silly AI image for this made-up story.</div>
      </div>
    </article>
  `;
}

function renderStories() {
  document.getElementById('stories').innerHTML = STORIES.map((s, i) => storyCardHTML(i, s)).join('');
}
renderStories();

function setSlotLoading(i) {
  document.getElementById(`art-slot-${i}`).innerHTML = `
    <div class="flex flex-col items-center justify-center gap-3 p-10 text-center">
      <div class="relative w-12 h-12">
        <div class="absolute inset-0 rounded-full border-4 border-black/10"></div>
        <div class="absolute inset-0 rounded-full border-4 border-transparent border-t-red-700 animate-spin"></div>
      </div>
      <div class="text-black/50 text-xs" id="art-status-${i}">Generating…</div>
    </div>
  `;
}

function setSlotError(i, msg) {
  document.getElementById(`art-slot-${i}`).innerHTML = `
    <div class="p-8 text-center text-red-700 text-sm">⚠️ ${msg}</div>
  `;
}

function setSlotResult(i, url) {
  document.getElementById(`art-slot-${i}`).innerHTML = `
    <div class="relative w-full">
      <img src="${url}" alt="Satirical illustration" class="w-full object-cover" style="max-height:480px" />
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
        <span class="text-white font-black text-3xl sm:text-5xl tracking-widest rotate-[-20deg] opacity-70" style="text-shadow: 2px 2px 6px rgba(0,0,0,0.8);">SATIRE</span>
      </div>
    </div>
  `;
}

async function pollPrediction(id) {
  for (let i = 0; i < 30; i++) {
    await new Promise(r => setTimeout(r, 2500));
    const r = await fetch(`/api/flux-poll?id=${id}`);
    const d = await r.json();
    if (d.status === 'succeeded' && d.output) return Array.isArray(d.output) ? d.output[0] : d.output;
    if (d.status === 'failed') throw new Error(d.error || 'Generation failed');
  }
  throw new Error('Timed out waiting for image');
}

async function generateStory(i) {
  const story = STORIES[i];
  setSlotLoading(i);
  try {
    const resp = await fetch('/api/gpt-image-2', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ prompt: story.prompt, noReference: true }),
    });
    const data = await resp.json();
    if (!resp.ok) throw new Error(data.error || 'Failed to start generation');

    let url;
    if (data.status === 'succeeded' && data.output) {
      url = Array.isArray(data.output) ? data.output[0] : data.output;
    } else if (data.id) {
      url = await pollPrediction(data.id);
    } else {
      throw new Error('Unexpected response from image API');
    }
    setSlotResult(i, url);
  } catch (err) {
    setSlotError(i, err.message);
  }
}

document.getElementById('generate-all-btn').addEventListener('click', async (e) => {
  const btn = e.currentTarget;
  btn.disabled = true;
  btn.textContent = 'Generating…';
  await Promise.all(STORIES.map((_, i) => generateStory(i)));
  btn.textContent = '🖼️ Regenerate Fake Headlines';
  btn.disabled = false;
});
</script>
