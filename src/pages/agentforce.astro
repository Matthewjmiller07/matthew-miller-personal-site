---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Agentforce Academy - Level Up Your AI Agent Skills">
    <main>
        <div class="container">
            <div class="header">
                <h1><i class="fas fa-robot"></i> Agentforce Academy</h1>
                <p>Master the art of AI agents with Salesforce Agentforce</p>
                <div class="stats">
                    <div class="stat-card">
                        <h3 id="totalXP">0</h3>
                        <p>Total XP</p>
                    </div>
                    <div class="stat-card">
                        <h3 id="level">1</h3>
                        <p>Level</p>
                    </div>
                    <div class="stat-card">
                        <h3 id="completedChallenges">0</h3>
                        <p>Challenges</p>
                    </div>
                    <div class="stat-card">
                        <h3 id="badges">0</h3>
                        <p>Badges</p>
                    </div>
                </div>
            </div>

            <div class="game-grid">
                <div class="game-card" onclick="openChallenge('foundations')">
                    <h3><i class="fas fa-foundation"></i> Agentforce Foundations</h3>
                    <span class="difficulty beginner">Beginner</span>
                    <p>Learn the basics of what Agentforce is and how it revolutionizes digital labor.</p>
                    <button class="play-btn">Start Challenge</button>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: 0%" id="foundations-progress"></div>
                    </div>
                </div>

                <div class="game-card" onclick="openChallenge('atlas')">
                    <h3><i class="fas fa-brain"></i> Atlas Reasoning Engine</h3>
                    <span class="difficulty intermediate">Intermediate</span>
                    <p>Dive deep into the reasoning engine that powers intelligent decision-making.</p>
                    <button class="play-btn">Start Challenge</button>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: 0%" id="atlas-progress"></div>
                    </div>
                </div>

                <div class="game-card" onclick="openChallenge('builder')">
                    <h3><i class="fas fa-tools"></i> Agent Builder Mastery</h3>
                    <span class="difficulty intermediate">Intermediate</span>
                    <p>Master the low-code Agent Builder to create custom AI agents.</p>
                    <button class="play-btn">Start Challenge</button>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: 0%" id="builder-progress"></div>
                    </div>
                </div>

                <div class="game-card" onclick="openChallenge('usecases')">
                    <h3><i class="fas fa-briefcase"></i> Use Case Explorer</h3>
                    <span class="difficulty beginner">Beginner</span>
                    <p>Explore real-world applications across different industries and departments.</p>
                    <button class="play-btn">Start Challenge</button>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: 0%" id="usecases-progress"></div>
                    </div>
                </div>

                <div class="game-card" onclick="openChallenge('integration')">
                    <h3><i class="fas fa-plug"></i> Integration Specialist</h3>
                    <span class="difficulty advanced">Advanced</span>
                    <p>Learn how to integrate Agentforce with existing systems and workflows.</p>
                    <button class="play-btn">Start Challenge</button>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: 0%" id="integration-progress"></div>
                    </div>
                </div>

                <div class="game-card" onclick="openChallenge('security')">
                    <h3><i class="fas fa-shield-alt"></i> Trust & Security</h3>
                    <span class="difficulty advanced">Advanced</span>
                    <p>Master the security and trust features that make Agentforce enterprise-ready.</p>
                    <button class="play-btn">Start Challenge</button>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: 0%" id="security-progress"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal for challenges -->
        <div id="challengeModal" class="modal">
            <div class="modal-content">
                <span class="close" onclick="closeChallenge()">&times;</span>
                <div id="challengeContent"></div>
            </div>
        </div>
    </main>
</Layout>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    main {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        color: #333;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    .header {
        text-align: center;
        margin-bottom: 30px;
        background: rgba(255, 255, 255, 0.1);
        padding: 30px;
        border-radius: 20px;
        backdrop-filter: blur(10px);
    }

    .header h1 {
        color: white;
        font-size: 2.5em;
        margin-bottom: 10px;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
    }

    .header p {
        color: rgba(255, 255, 255, 0.9);
        font-size: 1.2em;
        margin-bottom: 20px;
    }

    .stats {
        display: flex;
        justify-content: space-around;
        margin-bottom: 30px;
        flex-wrap: wrap;
    }

    .stat-card {
        background: rgba(255, 255, 255, 0.2);
        padding: 20px;
        border-radius: 15px;
        text-align: center;
        backdrop-filter: blur(10px);
        margin: 10px;
        min-width: 150px;
    }

    .stat-card h3 {
        color: #4CAF50;
        font-size: 2em;
        margin-bottom: 5px;
    }

    .stat-card p {
        color: white;
        font-size: 0.9em;
    }

    .game-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .game-card {
        background: rgba(255, 255, 255, 0.15);
        padding: 25px;
        border-radius: 15px;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        cursor: pointer;
    }

    .game-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }

    .game-card h3 {
        color: white;
        margin-bottom: 15px;
        font-size: 1.4em;
    }

    .game-card p {
        color: rgba(255, 255, 255, 0.9);
        margin-bottom: 15px;
        line-height: 1.5;
    }

    .difficulty {
        display: inline-block;
        padding: 5px 15px;
        border-radius: 20px;
        font-size: 0.8em;
        font-weight: bold;
        margin-bottom: 15px;
    }

    .difficulty.beginner {
        background: #4CAF50;
        color: white;
    }

    .difficulty.intermediate {
        background: #FF9800;
        color: white;
    }

    .difficulty.advanced {
        background: #F44336;
        color: white;
    }

    .play-btn {
        background: linear-gradient(45deg, #4CAF50, #45a049);
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 25px;
        cursor: pointer;
        font-weight: bold;
        transition: all 0.3s ease;
    }

    .play-btn:hover {
        background: linear-gradient(45deg, #45a049, #4CAF50);
        transform: scale(1.05);
    }

    .progress-bar {
        width: 100%;
        height: 10px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 5px;
        overflow: hidden;
        margin-top: 10px;
    }

    .progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #4CAF50, #45a049);
        transition: width 0.3s ease;
    }

    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.8);
        backdrop-filter: blur(5px);
    }

    .modal-content {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        margin: 5% auto;
        padding: 30px;
        border-radius: 20px;
        width: 90%;
        max-width: 800px;
        max-height: 80vh;
        overflow-y: auto;
        position: relative;
    }

    .close {
        position: absolute;
        right: 20px;
        top: 20px;
        font-size: 28px;
        font-weight: bold;
        color: white;
        cursor: pointer;
    }

    .close:hover {
        color: #ccc;
    }

    .quiz-container {
        background: rgba(255, 255, 255, 0.1);
        padding: 25px;
        border-radius: 15px;
        margin-bottom: 20px;
    }

    .question {
        color: white;
        font-size: 1.2em;
        margin-bottom: 20px;
    }

    .options {
        display: grid;
        gap: 10px;
    }

    .option {
        background: rgba(255, 255, 255, 0.2);
        padding: 15px;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.3s ease;
        border: 2px solid transparent;
    }

    .option:hover {
        background: rgba(255, 255, 255, 0.3);
        border-color: rgba(255, 255, 255, 0.5);
    }

    .option.selected {
        background: rgba(76, 175, 80, 0.3);
        border-color: #4CAF50;
    }

    .option.correct {
        background: rgba(76, 175, 80, 0.5);
        border-color: #4CAF50;
    }

    .option.incorrect {
        background: rgba(244, 67, 54, 0.5);
        border-color: #F44336;
    }

    .next-btn {
        background: linear-gradient(45deg, #2196F3, #1976D2);
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 25px;
        cursor: pointer;
        font-weight: bold;
        margin-top: 20px;
        transition: all 0.3s ease;
    }

    .next-btn:hover {
        background: linear-gradient(45deg, #1976D2, #2196F3);
        transform: scale(1.05);
    }

    .score-display {
        text-align: center;
        color: white;
        font-size: 1.5em;
        margin-top: 20px;
    }

    .achievement {
        background: rgba(255, 215, 0, 0.2);
        border: 2px solid #FFD700;
        padding: 15px;
        border-radius: 10px;
        margin: 10px 0;
        text-align: center;
    }

    .achievement h4 {
        color: #FFD700;
        margin-bottom: 5px;
    }

    .achievement p {
        color: white;
        font-size: 0.9em;
    }

    @media (max-width: 768px) {
        .stats {
            flex-direction: column;
            align-items: center;
        }
        
        .game-grid {
            grid-template-columns: 1fr;
        }
        
        .header h1 {
            font-size: 2em;
        }
    }
</style>

<script>
    // Game State
    let gameState = {
        totalXP: 0,
        level: 1,
        completedChallenges: 0,
        badges: 0,
        progress: {
            foundations: 0,
            atlas: 0,
            builder: 0,
            usecases: 0,
            integration: 0,
            security: 0
        }
    };

    // Challenge Data
    const challenges = {
        foundations: {
            title: "Agentforce Foundations",
            questions: [
                {
                    question: "What is Agentforce?",
                    options: [
                        "A traditional chatbot platform",
                        "An autonomous AI platform for building and deploying AI agents at scale",
                        "A customer service tool only",
                        "A data analytics platform"
                    ],
                    correct: 1,
                    explanation: "Agentforce is described as the world's #1 digital labor platform for building and deploying AI agents at scale."
                },
                {
                    question: "What is the core reasoning engine that powers Agentforce?",
                    options: [
                        "Einstein Engine",
                        "Salesforce AI",
                        "Atlas Reasoning Engine",
                        "Neural Network Core"
                    ],
                    correct: 2,
                    explanation: "The Atlas Reasoning Engine is the core component that enables understanding and executing tasks in Agentforce."
                },
                {
                    question: "Which of these is NOT a key feature of Agentforce?",
                    options: [
                        "Low-code Agent Builder",
                        "Deep data integration",
                        "Manual task execution",
                        "Robust trust and security guardrails"
                    ],
                    correct: 2,
                    explanation: "Agentforce is designed for autonomous action, not manual task execution."
                },
                {
                    question: "What makes Agentforce different from traditional AI solutions?",
                    options: [
                        "It only works with Salesforce data",
                        "It requires extensive coding knowledge",
                        "It can take autonomous actions across business systems",
                        "It only handles customer service"
                    ],
                    correct: 2,
                    explanation: "Agentforce's ability to take autonomous actions across entire enterprise systems is what sets it apart."
                }
            ]
        },
        atlas: {
            title: "Atlas Reasoning Engine",
            questions: [
                {
                    question: "What is the primary function of the Atlas Reasoning Engine?",
                    options: [
                        "Data storage and retrieval",
                        "Understanding and executing tasks intelligently",
                        "User interface design",
                        "Network communication"
                    ],
                    correct: 1,
                    explanation: "The Atlas Reasoning Engine is responsible for understanding context and executing tasks intelligently."
                },
                {
                    question: "How does Atlas enable agents to make decisions?",
                    options: [
                        "By following pre-programmed scripts",
                        "By using Large Language Models (LLMs) for reasoning",
                        "By asking users for every decision",
                        "By random selection"
                    ],
                    correct: 1,
                    explanation: "Atlas uses Large Language Models to enable intelligent reasoning and decision-making."
                },
                {
                    question: "What type of tasks can Atlas help agents understand?",
                    options: [
                        "Only simple, repetitive tasks",
                        "Complex, context-dependent business tasks",
                        "Only mathematical calculations",
                        "Only data entry tasks"
                    ],
                    correct: 1,
                    explanation: "Atlas is designed to handle complex, context-dependent business tasks that require understanding and reasoning."
                }
            ]
        },
        builder: {
            title: "Agent Builder Mastery",
            questions: [
                {
                    question: "What is the Agent Builder in Agentforce?",
                    options: [
                        "A complex programming environment",
                        "A low-code tool for creating AI agents",
                        "A database management system",
                        "A reporting tool"
                    ],
                    correct: 1,
                    explanation: "The Agent Builder is a low-code tool that allows users to create custom AI agents without extensive programming."
                },
                {
                    question: "What can you customize in the Agent Builder?",
                    options: [
                        "Only the agent's name",
                        "Topics, actions, and instructions",
                        "Only the visual appearance",
                        "Only the data sources"
                    ],
                    correct: 1,
                    explanation: "The Agent Builder allows customization of topics, actions, and instructions to create specialized agents."
                },
                {
                    question: "How does Agent Builder integrate with existing systems?",
                    options: [
                        "It replaces all existing systems",
                        "It works in isolation",
                        "It integrates with Flows, APIs, and custom code",
                        "It only works with Salesforce"
                    ],
                    correct: 2,
                    explanation: "Agent Builder supports integration with Flows, APIs, and custom code to work with existing business logic."
                }
            ]
        },
        usecases: {
            title: "Use Case Explorer",
            questions: [
                {
                    question: "Which of these is a primary use case for Agentforce?",
                    options: [
                        "Customer Service",
                        "Sales Development",
                        "Employee Support",
                        "All of the above"
                    ],
                    correct: 3,
                    explanation: "Agentforce supports multiple use cases including customer service, sales development, and employee support."
                },
                {
                    question: "What type of support can Agentforce provide for employees?",
                    options: [
                        "Only IT support",
                        "Coaching, teaching, and general support",
                        "Only payroll questions",
                        "Only scheduling"
                    ],
                    correct: 1,
                    explanation: "Agentforce can provide coaching, teaching, and comprehensive employee support across various domains."
                },
                {
                    question: "How can Agentforce help with sales development?",
                    options: [
                        "By providing product recommendations",
                        "By scheduling appointments",
                        "By conducting deep research",
                        "All of the above"
                    ],
                    correct: 3,
                    explanation: "Agentforce supports sales development through product recommendations, appointment scheduling, and deep research capabilities."
                }
            ]
        },
        integration: {
            title: "Integration Specialist",
            questions: [
                {
                    question: "What platforms does Agentforce integrate with?",
                    options: [
                        "Only Salesforce products",
                        "Only cloud-based systems",
                        "Existing apps, data, and business logic across the enterprise",
                        "Only Microsoft products"
                    ],
                    correct: 2,
                    explanation: "Agentforce is designed to integrate with existing apps, data, and business logic across the entire enterprise."
                },
                {
                    question: "What is required for Agentforce to work with existing systems?",
                    options: [
                        "Complete system replacement",
                        "Minimal integration using APIs and existing infrastructure",
                        "Manual data entry",
                        "New hardware installation"
                    ],
                    correct: 1,
                    explanation: "Agentforce can integrate with existing systems through APIs and existing infrastructure with minimal disruption."
                },
                {
                    question: "How does Agentforce handle data integration?",
                    options: [
                        "It requires all data to be migrated to Salesforce",
                        "It works with data in place through deep integration",
                        "It only uses publicly available data",
                        "It doesn't integrate with data sources"
                    ],
                    correct: 1,
                    explanation: "Agentforce provides deep data integration, working with existing data sources in place."
                }
            ]
        },
        security: {
            title: "Trust & Security",
            questions: [
                {
                    question: "What security features does Agentforce include?",
                    options: [
                        "Basic password protection",
                        "Robust trust and security guardrails",
                        "No security features",
                        "Only user authentication"
                    ],
                    correct: 1,
                    explanation: "Agentforce includes robust trust and security guardrails to ensure enterprise-level security."
                },
                {
                    question: "How does Agentforce ensure data privacy?",
                    options: [
                        "By storing all data publicly",
                        "By implementing enterprise-grade security measures",
                        "By avoiding data processing",
                        "By using only encrypted storage"
                    ],
                    correct: 1,
                    explanation: "Agentforce implements enterprise-grade security measures to ensure data privacy and protection."
                },
                {
                    question: "What is the Command Center in Agentforce?",
                    options: [
                        "A dashboard for monitoring performance",
                        "A tool for agent supervision and governance",
                        "A customer interface",
                        "A data storage system"
                    ],
                    correct: 1,
                    explanation: "The Command Center provides agent supervision and governance capabilities for managing AI agents."
                }
            ]
        }
    };

    // Initialize game on page load
    document.addEventListener('DOMContentLoaded', function() {
        loadGameState();
        updateUI();
    });

    function loadGameState() {
        const saved = localStorage.getItem('agentforce-game-state');
        if (saved) {
            gameState = { ...gameState, ...JSON.parse(saved) };
        }
    }

    function saveGameState() {
        localStorage.setItem('agentforce-game-state', JSON.stringify(gameState));
    }

    function updateUI() {
        document.getElementById('totalXP').textContent = gameState.totalXP;
        document.getElementById('level').textContent = gameState.level;
        document.getElementById('completedChallenges').textContent = gameState.completedChallenges;
        document.getElementById('badges').textContent = gameState.badges;

        // Update progress bars
        Object.keys(gameState.progress).forEach(key => {
            const element = document.getElementById(key + '-progress');
            if (element) {
                element.style.width = gameState.progress[key] + '%';
            }
        });
    }

    function openChallenge(challengeId) {
        const challenge = challenges[challengeId];
        if (!challenge) return;

        let currentQuestionIndex = 0;
        let score = 0;
        let answers = [];

        function showQuestion() {
            const question = challenge.questions[currentQuestionIndex];
            const content = `
                <h2>${challenge.title}</h2>
                <div class="quiz-container">
                    <div class="question">
                        Question ${currentQuestionIndex + 1} of ${challenge.questions.length}
                    </div>
                    <div class="question">${question.question}</div>
                    <div class="options">
                        ${question.options.map((option, index) => `
                            <div class="option" onclick="selectOption(${index})" data-index="${index}">
                                ${option}
                            </div>
                        `).join('')}
                    </div>
                    <button class="next-btn" onclick="nextQuestion()" style="display: none;">Next Question</button>
                </div>
                <div class="score-display">Score: ${score}/${challenge.questions.length}</div>
            `;
            document.getElementById('challengeContent').innerHTML = content;
        }

        window.selectOption = function(selectedIndex) {
            const question = challenge.questions[currentQuestionIndex];
            const options = document.querySelectorAll('.option');
            
            // Remove previous selections
            options.forEach(option => {
                option.classList.remove('selected', 'correct', 'incorrect');
            });

            // Mark selected option
            options[selectedIndex].classList.add('selected');
            
            // Show correct answer
            setTimeout(() => {
                options[question.correct].classList.add('correct');
                if (selectedIndex !== question.correct) {
                    options[selectedIndex].classList.add('incorrect');
                }

                // Update score
                if (selectedIndex === question.correct) {
                    score++;
                }

                answers.push(selectedIndex === question.correct);
                
                // Show explanation
                const explanation = document.createElement('div');
                explanation.className = 'achievement';
                explanation.innerHTML = `
                    <h4>${selectedIndex === question.correct ? 'Correct!' : 'Incorrect'}</h4>
                    <p>${question.explanation}</p>
                `;
                document.querySelector('.quiz-container').appendChild(explanation);

                // Show next button
                document.querySelector('.next-btn').style.display = 'block';
            }, 500);
        };

        window.nextQuestion = function() {
            currentQuestionIndex++;
            if (currentQuestionIndex < challenge.questions.length) {
                showQuestion();
            } else {
                showResults();
            }
        };

        function showResults() {
            const percentage = Math.round((score / challenge.questions.length) * 100);
            let xpEarned = score * 10;
            
            // Bonus XP for perfect score
            if (percentage === 100) {
                xpEarned += 50;
            }

            // Update game state
            gameState.totalXP += xpEarned;
            gameState.level = Math.floor(gameState.totalXP / 100) + 1;
            gameState.progress[challengeId] = percentage;
            
            if (percentage >= 70) {
                gameState.completedChallenges++;
                if (percentage === 100) {
                    gameState.badges++;
                }
            }

            const content = `
                <h2>Challenge Complete!</h2>
                <div class="quiz-container">
                    <div class="score-display">Final Score: ${score}/${challenge.questions.length} (${percentage}%)</div>
                    <div class="achievement">
                        <h4>XP Earned: ${xpEarned}</h4>
                        <p>Total XP: ${gameState.totalXP}</p>
                    </div>
                    ${percentage === 100 ? '<div class="achievement"><h4>🏆 Perfect Score Badge!</h4><p>You mastered this challenge!</p></div>' : ''}
                    ${percentage >= 70 ? '<div class="achievement"><h4>✅ Challenge Completed!</h4><p>Great job! You can move on to the next challenge.</p></div>' : '<div class="achievement"><h4>📚 Keep Learning!</h4><p>Try again to improve your score!</p></div>'}
                    <button class="next-btn" onclick="closeChallenge()">Continue</button>
                </div>
            `;
            document.getElementById('challengeContent').innerHTML = content;
            
            saveGameState();
            updateUI();
        }

        showQuestion();
        document.getElementById('challengeModal').style.display = 'block';
    }

    function closeChallenge() {
        document.getElementById('challengeModal').style.display = 'none';
    }

    // Close modal when clicking outside
    document.getElementById('challengeModal').addEventListener('click', function(e) {
        if (e.target === this) {
            closeChallenge();
        }
    });
</script>

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">