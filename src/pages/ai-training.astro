---
import Layout from '../layouts/Layout.astro';
import FaceTracker from '../components/FaceTracker.tsx';

const pricing = {
  standard: 2000,
  promo: 1500,
  promoCode: 'CHEZCHAYA'
};
---

<Layout
  title="AI & Claude Training"
  description="Master AI and Claude with personalized training from Matthew Miller, former G2 Principal Analyst in AI, Automation, and Analytics. Learn prompt engineering, AI strategy, and workflow automation."
  image="/og-ai-training.png"
>
  <main class="min-h-screen bg-gradient-to-br from-slate-50 to-blue-50 dark:from-gray-900 dark:to-slate-800">
    <!-- Hero Section -->
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-r from-primary-light/10 to-purple-500/10 dark:from-primary-dark/20 dark:to-purple-500/20"></div>
      <div class="container mx-auto px-4 py-20 relative">
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center gap-2 px-4 py-2 bg-white dark:bg-gray-800 rounded-full shadow-sm mb-8">
            <span class="text-2xl">🤖</span>
            <span class="text-sm font-medium text-gray-600 dark:text-gray-300">AI Training & Claude Mastery</span>
          </div>
          
          <h1 class="text-5xl md:text-6xl font-bold text-gray-900 dark:text-white mb-6 leading-tight">
            Unlock the Power of <span class="text-primary-light dark:text-primary-dark">Claude & AI</span>
          </h1>
          
          <p class="text-xl text-gray-600 dark:text-gray-300 mb-8 max-w-2xl mx-auto">
            Personalized training from a former Principal Analyst at G2, specializing in AI, Automation, and Analytics. 
            Learn to think like an AI strategist, not just a prompt typer.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
            <a href="#pricing" class="px-8 py-4 bg-primary-light dark:bg-primary-dark text-white rounded-lg font-semibold hover:bg-primary-dark/80 transition-all shadow-lg hover:shadow-xl">
              View Training Options
            </a>
            <a href="#about" class="px-8 py-4 bg-white dark:bg-gray-800 text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700 rounded-lg font-semibold hover:bg-gray-50 dark:hover:bg-gray-700 transition-all">
              Why Learn From Me?
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- What You Get Section -->
    <section class="py-16 bg-white dark:bg-gray-900">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-bold text-center text-gray-900 dark:text-white mb-12">
          What You'll Master
        </h2>
        
        <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
          <div class="bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-gray-800 dark:to-gray-700 p-8 rounded-2xl">
            <div class="w-12 h-12 bg-blue-500 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Prompt Engineering</h3>
            <ul class="space-y-2 text-gray-600 dark:text-gray-300 text-sm">
              <li>• Chain-of-thought prompting</li>
              <li>• Few-shot & zero-shot techniques</li>
              <li>• Context window optimization</li>
              <li>• System prompt design</li>
              <li>• Claude-specific features (Artifacts, Projects)</li>
            </ul>
          </div>

          <div class="bg-gradient-to-br from-purple-50 to-pink-50 dark:from-gray-800 dark:to-gray-700 p-8 rounded-2xl">
            <div class="w-12 h-12 bg-purple-500 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">AI Strategy</h3>
            <ul class="space-y-2 text-gray-600 dark:text-gray-300 text-sm">
              <li>• AI opportunity assessment</li>
              <li>• Workflow automation design</li>
              <li>• Tool selection & integration</li>
              <li>• ROI measurement frameworks</li>
              <li>• Change management for AI adoption</li>
            </ul>
          </div>

          <div class="bg-gradient-to-br from-green-50 to-teal-50 dark:from-gray-800 dark:to-gray-700 p-8 rounded-2xl">
            <div class="w-12 h-12 bg-green-500 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Hands-On Projects</h3>
            <ul class="space-y-2 text-gray-600 dark:text-gray-300 text-sm">
              <li>• Build your first AI agent</li>
              <li>• Create automated content workflows</li>
              <li>• Develop custom GPTs/Claude projects</li>
              <li>• Integrate AI with existing tools</li>
              <li>• Document processing pipelines</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Instructor Section -->
    <section id="about" class="py-16 bg-gradient-to-br from-gray-50 to-blue-50 dark:from-gray-800 dark:to-slate-900">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="flex flex-col md:flex-row items-center gap-12">
            <div class="w-48 h-48 flex-shrink-0">
              <FaceTracker client:load width={192} height={192} />
            </div>
            
            <div>
              <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">
                Learn From an AI Industry Insider
              </h2>
              
              <div class="space-y-4 text-gray-600 dark:text-gray-300">
                <p>
                  I spent years as a <strong>Principal Analyst at G2</strong>, the world's largest software marketplace, 
                  where I led research on AI, Automation, and Analytics. I spoke with hundreds of AI vendors, 
                  analyzed thousands of products, and helped define market categories.
                </p>
                
                <div class="grid sm:grid-cols-2 gap-4 mt-6">
                  <div class="flex items-start gap-3">
                    <span class="text-2xl">🏢</span>
                    <div>
                      <p class="font-semibold text-gray-900 dark:text-white">G2 Research</p>
                      <p class="text-sm">Principal Analyst, AI & Automation</p>
                    </div>
                  </div>
                  <div class="flex items-start gap-3">
                    <span class="text-2xl">💡</span>
                    <div>
                      <p class="font-semibold text-gray-900 dark:text-white">VAICE</p>
                      <p class="text-sm">Co-Founder, AI Consultancy</p>
                    </div>
                  </div>
                  <div class="flex items-start gap-3">
                    <span class="text-2xl">📊</span>
                    <div>
                      <p class="font-semibold text-gray-900 dark:text-white">$1.4M+</p>
                      <p class="text-sm">Revenue influenced through insights</p>
                    </div>
                  </div>
                  <div class="flex items-start gap-3">
                    <span class="text-2xl">🎓</span>
                    <div>
                      <p class="font-semibold text-gray-900 dark:text-white">M.A. Linguistics</p>
                      <p class="text-sm">Queen Mary University of London</p>
                    </div>
                  </div>
                </div>

                <p class="mt-6">
                  <a href="/about" class="text-primary-light dark:text-primary-dark font-semibold hover:underline">
                    View full background →
                  </a>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Trusted By / Social Proof -->
    <section class="py-16 bg-white dark:bg-gray-900">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-bold text-center text-gray-900 dark:text-white mb-12">
            Trusted By
          </h2>
          
          <div class="bg-gradient-to-br from-gray-50 to-blue-50 dark:from-gray-800 dark:to-gray-700 p-8 rounded-2xl">
            <p class="text-center text-gray-600 dark:text-gray-400 mb-8">
              Matthew's AI expertise and digital strategy work is trusted by leading voices in the Jewish community:
            </p>
            
            <div class="grid md:grid-cols-3 gap-6 text-center">
              <div class="p-4">
                <p class="font-semibold text-gray-900 dark:text-white text-lg">Rabbi Efrem Goldberg</p>
                <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Boca Raton Synagogue</p>
              </div>
              <div class="p-4">
                <p class="font-semibold text-gray-900 dark:text-white text-lg">Rabbi Dovi Nadel</p>
                <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Content & Education</p>
              </div>
              <div class="p-4">
                <p class="font-semibold text-gray-900 dark:text-white text-lg">Rabbi Joseph Dweck</p>
                <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Senior Rabbi</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Pricing Section -->
    <section id="pricing" class="py-20 bg-gradient-to-br from-primary-light/5 to-purple-500/5 dark:from-primary-dark/10 dark:to-purple-500/10">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-bold text-center text-gray-900 dark:text-white mb-4">
          Training Investment
        </h2>
        <p class="text-center text-gray-600 dark:text-gray-400 mb-12 max-w-2xl mx-auto">
          Personalized 1-on-1 training tailored to your specific needs and industry context.
        </p>

        <div class="max-w-xl mx-auto">
          <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl p-8 border-2 border-gray-200 dark:border-gray-700" id="pricing-card">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Standard Training</h3>
            
            <!-- Price display -->
            <div class="flex items-baseline gap-3 mb-4" id="price-display">
              <span class="text-5xl font-bold text-gray-900 dark:text-white" id="current-price">${pricing.standard}</span>
              <span class="text-gray-500 dark:text-gray-400" id="price-label">one-time</span>
              <span class="hidden text-2xl text-green-600 dark:text-green-400 font-semibold" id="promo-badge">50% off applied</span>
            </div>
            
            <!-- Promo message (hidden by default) -->
            <div class="hidden bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg p-4 mb-6" id="promo-message">
              <p class="text-sm text-green-800 dark:text-green-200">
                <strong>Partner rate activated.</strong> In exchange for this discount, you'll provide one testimonial or social post about your training experience. Details will be shared after signup.
              </p>
            </div>
            
            <p class="text-sm text-gray-600 dark:text-gray-400 mb-6">
              Complete AI mastery program
            </p>
            
            <!-- Promo code input -->
            <div class="bg-gray-50 dark:bg-gray-700/50 rounded-lg p-4 mb-6">
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                Have a referral code?
              </label>
              <div class="flex gap-2">
                <input 
                  type="text" 
                  id="promo-input"
                  placeholder="Enter code..."
                  class="flex-1 px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-800 text-gray-900 dark:text-white text-sm focus:ring-2 focus:ring-primary-light focus:border-primary-light"
                />
                <button 
                  id="promo-apply"
                  class="px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-md text-sm font-medium hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors"
                >
                  Apply
                </button>
              </div>
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-2" id="promo-hint">
                Enter code to unlock partner pricing
              </p>
            </div>
            
            <ul class="space-y-3 text-gray-600 dark:text-gray-300 mb-8">
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>4 hours of 1-on-1 live training</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Custom curriculum based on your goals</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>2 weeks of follow-up support</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Prompt library & templates</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Recording of all sessions</span>
              </li>
            </ul>

            <a 
              href="mailto:matthewjmiller07@gmail.com?subject=AI Training Inquiry" 
              class="block w-full py-3 px-6 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-lg font-semibold text-center hover:bg-gray-800 dark:hover:bg-gray-100 transition-colors"
              id="cta-button"
            >
              Get Started
            </a>
          </div>
        </div>

        <div class="max-w-2xl mx-auto mt-12 text-center">
          <p class="text-sm text-gray-500 dark:text-gray-400">
            All training sessions are conducted virtually via Zoom. 
            Custom enterprise packages available for teams. 
            <a href="mailto:matthewjmiller07@gmail.com" class="text-primary-light dark:text-primary-dark hover:underline">Contact for details</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-16 bg-white dark:bg-gray-900">
      <div class="container mx-auto px-4 max-w-3xl">
        <h2 class="text-3xl font-bold text-center text-gray-900 dark:text-white mb-12">
          Frequently Asked Questions
        </h2>
        
        <div class="space-y-6">
          <div class="border-b border-gray-200 dark:border-gray-700 pb-6">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
              Who is this training for?
            </h3>
            <p class="text-gray-600 dark:text-gray-400">
              Professionals who want to move beyond basic prompting and truly understand how to leverage AI 
              strategically. Ideal for product marketers, content creators, researchers, founders, and knowledge workers 
              who want to 10x their productivity.
            </p>
          </div>

          <div class="border-b border-gray-200 dark:border-gray-700 pb-6">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
              Do I need technical background?
            </h3>
            <p class="text-gray-600 dark:text-gray-400">
              No. The training is designed for business users, not engineers. I focus on practical applications 
              you can use immediately, regardless of technical background.
            </p>
          </div>

          <div class="border-b border-gray-200 dark:border-gray-700 pb-6">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
              How is the training customized?
            </h3>
            <p class="text-gray-600 dark:text-gray-400">
              Before our first session, I'll send you a brief questionnaire about your role, current AI usage, 
              and specific challenges. The curriculum is then tailored to your industry, workflow, and goals.
            </p>
          </div>

          <div class="border-b border-gray-200 dark:border-gray-700 pb-6">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
              What makes this different from free online courses?
            </h3>
            <p class="text-gray-600 dark:text-gray-400">
              Most courses teach you to copy-paste prompts. I teach you to <em>think</em> about AI strategically—
              how to design workflows, evaluate tools, and build sustainable AI-powered processes. 
              Plus, you get direct access to someone who analyzed the entire AI vendor landscape for a living.
            </p>
          </div>

          <div class="border-b border-gray-200 dark:border-gray-700 pb-6">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
              Do you offer partner or referral pricing?
            </h3>
            <p class="text-gray-600 dark:text-gray-400">
              Yes — select partners and community members can access discounted rates. 
              If you have a referral code, enter it on the pricing page. Partner rates typically 
              involve a contra arrangement (such as a testimonial or social post) in exchange for the discount. 
              <a href="mailto:matthewjmiller07@gmail.com?subject=Partner Pricing Inquiry" class="text-primary-light dark:text-primary-dark hover:underline">Contact me</a> 
              to discuss partnership opportunities.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 bg-gradient-to-r from-primary-light to-purple-600 dark:from-primary-dark dark:to-purple-700">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
          Ready to Master AI?
        </h2>
        <p class="text-xl text-white/90 mb-8 max-w-2xl mx-auto">
          Don't just use AI. Understand it. Leverage it. Transform your workflow.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="mailto:matthewjmiller07@gmail.com?subject=AI Training Inquiry"
            class="px-8 py-4 bg-white text-primary-light rounded-lg font-semibold hover:bg-gray-100 transition-colors shadow-lg"
          >
            Book Your Training
          </a>
          <a 
            href="/about"
            class="px-8 py-4 bg-white/10 text-white border border-white/30 rounded-lg font-semibold hover:bg-white/20 transition-colors"
          >
            Learn More About Me
          </a>
        </div>
      </div>
    </section>
  </main>

  <script define:vars={{ standardPrice: pricing.standard, promoPrice: pricing.promo }}>
    // Promo code logic
    const promoInput = document.getElementById('promo-input');
    const promoApply = document.getElementById('promo-apply');
    const promoHint = document.getElementById('promo-hint');
    const currentPrice = document.getElementById('current-price');
    const promoBadge = document.getElementById('promo-badge');
    const promoMessage = document.getElementById('promo-message');
    const ctaButton = document.getElementById('cta-button');
    
    let isPromoApplied = false;
    
    function applyPromo() {
      const code = promoInput.value.trim().toLowerCase();
      
      if (code === 'chezchaya') {
        // Apply discount
        currentPrice.textContent = '$' + promoPrice;
        currentPrice.classList.add('text-green-600', 'dark:text-green-400');
        promoBadge.classList.remove('hidden');
        promoMessage.classList.remove('hidden');
        promoHint.textContent = 'Partner pricing unlocked!';
        promoHint.classList.add('text-green-600', 'dark:text-green-400');
        
        // Update CTA link
        ctaButton.href = 'mailto:matthewjmiller07@gmail.com?subject=AI Training Inquiry - Partner Rate (chezchaya)';
        ctaButton.textContent = 'Claim Partner Rate';
        
        isPromoApplied = true;
      } else if (code === '') {
        promoHint.textContent = 'Please enter a code';
        promoHint.classList.remove('text-green-600', 'dark:text-green-400');
      } else {
        promoHint.textContent = 'Invalid code. Contact for partnership inquiries.';
        promoHint.classList.remove('text-green-600', 'dark:text-green-400');
      }
    }
    
    promoApply.addEventListener('click', applyPromo);
    
    promoInput.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') {
        applyPromo();
      }
    });
  </script>
</Layout>
