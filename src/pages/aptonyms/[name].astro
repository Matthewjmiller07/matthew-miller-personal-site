---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';
import { highlightAptonym } from '../../utils/aptonymUtils';

const { name } = Astro.params;
const decodedName = decodeURIComponent(name ?? '');

const { data: aptonym, error } = await supabase
  .from('Serendipitous Names')
  .select('*')
  .eq('Name', decodedName)
  .single();

if (error || !aptonym) {
  return Astro.redirect('/aptonyms');
}

const pageTitle = `${aptonym.Name} — Aptonym`;
const pageDescription = `${aptonym.Name} is an aptonym: ${aptonym['How the Name Fits the Role']}`;
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="max-w-2xl mx-auto px-4 py-12">
    <a
      href="/aptonyms"
      class="inline-flex items-center text-sm text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 mb-8 transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      All Aptonyms
    </a>

    <article class="bg-white dark:bg-gray-800 rounded-lg shadow-lg border border-gray-100 dark:border-gray-700 p-8">
      <div class="flex items-start justify-between mb-4">
        <h1
          class="text-4xl font-bold text-gray-900 dark:text-white"
          set:html={highlightAptonym(aptonym.Name, aptonym['Aptonym Part'])}
        />
        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200 ml-4 shrink-0">
          {aptonym['Aptonym Part'] === 'Both' ? 'Both names' : `${aptonym['Aptonym Part']} name`}
        </span>
      </div>

      <h2 class="text-xl font-semibold text-gray-700 dark:text-gray-300 mb-4">
        {aptonym['Profession / Role']}
      </h2>

      <div class="p-4 bg-gray-50 dark:bg-gray-700/50 rounded-lg mb-6">
        <p class="text-gray-600 dark:text-gray-300 italic leading-relaxed">
          {aptonym['How the Name Fits the Role']}
        </p>
      </div>

      {aptonym.Link && aptonym.Link !== 'N/A' && aptonym.Link.trim() !== '' && (
        <a
          href={aptonym.Link}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center text-sm font-medium text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300 transition-colors"
        >
          Read more
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      )}
    </article>

    {aptonym.created_at && (
      <p class="text-xs text-gray-400 dark:text-gray-500 mt-4 text-right">
        Added {new Date(aptonym.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>
    )}
  </div>
</Layout>
