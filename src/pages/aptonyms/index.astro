---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';
import { highlightAptonym } from '../../utils/aptonymUtils';

let { data: aptonyms, error } = await supabase
  .from('Serendipitous Names')
  .select('*')
  .order('Name', { ascending: true });

if (error) {
  console.error('Error fetching aptonyms:', error);
  aptonyms = [];
}

const sixtyDaysAgo = new Date();
sixtyDaysAgo.setDate(sixtyDaysAgo.getDate() - 60);

const recentAptonyms = (aptonyms ?? []).filter(
  (a) => a.created_at && new Date(a.created_at) > sixtyDaysAgo
);

const pageTitle = 'Aptonyms';
const pageDescription = 'A collection of serendipitous names and their fitting professions';
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <header class="mb-12">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
        <div>
          <h1 class="text-4xl font-bold text-gray-900 dark:text-white">{pageTitle}</h1>
          <p class="text-lg text-gray-500 dark:text-gray-400 mt-1">
            {aptonyms.length} entries and counting
          </p>
        </div>
        <a
          href="mailto:matthewjmiller07@gmail.com?subject=New%20Aptonym%20Suggestion&body=Name%3A%20%5BEnter%20Name%5D%0D%0A%0D%0AAptonym%20Part%3A%20%5BFirst%2FLast%2FBoth%5D%0D%0A%0D%0AProfession%2FRole%3A%20%5BEnter%20Profession%5D%0D%0A%0D%0AHow%20the%20Name%20Fits%3A%20%5BExplain%20the%20connection%5D%0D%0A%0D%0ALink%20(optional)%3A%20%5BURL%5D"
          class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 dark:bg-blue-700 dark:hover:bg-blue-600 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
            <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
            <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
          </svg>
          Suggest an Aptonym
        </a>
      </div>
      <p class="text-gray-500 dark:text-gray-400 text-sm mt-2">
        Highlighted in yellow is the part of the name that makes it an aptonym. Click any name to see its own page.
      </p>
    </header>

    {recentAptonyms.length > 0 && (
      <section class="mb-12">
        <h2 class="text-xl font-semibold text-gray-800 dark:text-gray-200 mb-4 flex items-center gap-2">
          <span class="inline-block w-2 h-2 rounded-full bg-green-500"></span>
          Recently Added
        </h2>
        <div class="grid gap-6 md:grid-cols-2">
          {recentAptonyms.map((aptonym) => (
            <a href={`/aptonyms/${encodeURIComponent(aptonym.Name)}`} class="block group">
              <article class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden group-hover:shadow-lg transition-shadow duration-300 border border-green-200 dark:border-green-800 h-full">
                <div class="p-6">
                  <div class="flex flex-col">
                    <div class="flex items-start justify-between mb-3">
                      <h2
                        class="text-2xl font-semibold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors"
                        set:html={highlightAptonym(aptonym.Name, aptonym['Aptonym Part'])}
                      />
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200 ml-2 shrink-0">
                        {aptonym['Aptonym Part'] === 'Both' ? 'Both names' : `${aptonym['Aptonym Part']} name`}
                      </span>
                    </div>
                    <div class="mb-4">
                      <h3 class="text-lg font-medium text-gray-700 dark:text-gray-300">
                        {aptonym['Profession / Role']}
                      </h3>
                      <div class="mt-2 p-3 bg-gray-50 dark:bg-gray-700/50 rounded-md">
                        <p class="text-sm text-gray-600 dark:text-gray-300 italic">
                          {aptonym['How the Name Fits the Role']}
                        </p>
                      </div>
                    </div>
                    {aptonym.Link && aptonym.Link !== 'N/A' && aptonym.Link.trim() !== '' && (
                      <div class="mt-auto">
                        <span class="inline-flex items-center text-sm font-medium text-blue-600 dark:text-blue-400">
                          Read more
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                          </svg>
                        </span>
                      </div>
                    )}
                  </div>
                </div>
              </article>
            </a>
          ))}
        </div>
        <hr class="mt-10 border-gray-200 dark:border-gray-700" />
      </section>
    )}

    {aptonyms && aptonyms.length > 0 ? (
      <>
        {recentAptonyms.length > 0 && (
          <h2 class="text-xl font-semibold text-gray-800 dark:text-gray-200 mb-4">All Entries</h2>
        )}
        <div class="grid gap-6 md:grid-cols-2">
          {aptonyms.map((aptonym) => (
            <a href={`/aptonyms/${encodeURIComponent(aptonym.Name)}`} class="block group">
              <article class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden group-hover:shadow-lg transition-shadow duration-300 border border-gray-100 dark:border-gray-700 h-full">
                <div class="p-6">
                  <div class="flex flex-col">
                    <div class="flex items-start justify-between mb-3">
                      <h2
                        class="text-2xl font-semibold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors"
                        set:html={highlightAptonym(aptonym.Name, aptonym['Aptonym Part'])}
                      />
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200 ml-2 shrink-0">
                        {aptonym['Aptonym Part'] === 'Both' ? 'Both names' : `${aptonym['Aptonym Part']} name`}
                      </span>
                    </div>

                    <div class="mb-4">
                      <h3 class="text-lg font-medium text-gray-700 dark:text-gray-300">
                        {aptonym['Profession / Role']}
                      </h3>

                      <div class="mt-2 p-3 bg-gray-50 dark:bg-gray-700/50 rounded-md">
                        <p class="text-sm text-gray-600 dark:text-gray-300 italic">
                          {aptonym['How the Name Fits the Role']}
                        </p>
                      </div>
                    </div>

                    {aptonym.Link && aptonym.Link !== 'N/A' && aptonym.Link.trim() !== '' && (
                      <div class="mt-auto">
                        <span class="inline-flex items-center text-sm font-medium text-blue-600 dark:text-blue-400">
                          Read more
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                          </svg>
                        </span>
                      </div>
                    )}
                  </div>
                </div>
              </article>
            </a>
          ))}
        </div>
      </>
    ) : (
      <div class="text-center py-12">
        <p class="text-gray-600 dark:text-gray-400">
          {error ? 'Failed to load aptonyms. Please try again later.' : 'No aptonyms found.'}
        </p>
      </div>
    )}
  </div>
</Layout>

<style>
  html {
    scroll-behavior: smooth;
  }

  a:focus, button:focus {
    @apply outline-none ring-2 ring-blue-500 ring-offset-2 ring-offset-white dark:ring-offset-gray-900 rounded;
  }

  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }

    * {
      transition: background-color 0.2s ease, border-color 0.2s ease;
    }
  }
</style>
