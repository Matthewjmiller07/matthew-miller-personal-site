          e.preventDefault();
          cursor = (cursor + (e.key === 'ArrowDown' ? 1 : -1) + shown.length) % shown.length;
          list.querySelectorAll('button').forEach((b, i) => b.classList.toggle('is-on', i === cursor));
        } else if (e.key === 'Enter' && shown[cursor]) {
          list.hidden = true; q.blur(); select(shown[cursor]);
        } else if (e.key === 'Escape') {
          q.value = ''; search(); q.blur();
        }
      }, on);

      const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.atlas-chip'));
      function focusGroup(id: string | null) {
        activeGroup = id;
        chips.forEach((c) => c.classList.toggle('is-on', c.dataset.group === id));
        if (!id) return home();
        const g = groupOf.get(id)!;
        const z = Math.min((Math.min(W, H) * 0.42) / g.r, 2.2);
        flyTo(g.x, g.y + (W < 760 ? 30 / z : 0), z, 1000);
      }
      chips.forEach((c) => c.addEventListener('click', () => { select(null, false); focusGroup(activeGroup === c.dataset.group ? null : c.dataset.group!); }, on));

      $('atlas-jump').addEventListener('click', () => {
        const pool = stars.filter((s) => s !== selected);
        const s = pool[Math.floor(Math.random() * pool.length)];
        focusGroup(null); tween = null;
        q.value = ''; search();
        select(s, true, 1700);
        touch();
      }, on);
      $('atlas-in').addEventListener('click', () => flyTo(cam.x, cam.y, cam.z * 1.6, 350), on);
      $('atlas-out').addEventListener('click', () => flyTo(cam.x, cam.y, cam.z / 1.6, 350), on);
      $('atlas-reset').addEventListener('click', () => { select(null, false); focusGroup(null); }, on);
      $('atlas-card-close').addEventListener('click', () => select(null, false), on);

      function touch() {
        if (touched) return;
        touched = true; $('atlas-hint').classList.add('is-gone');
      }

      // ── Pointer: drag, pinch, wheel, pick ───────────────────────────────
      const ptrs = new Map<number, { x: number; y: number }>();
      let moved = 0, pinch = 0, lastMove = 0;
      function pick(px: number, py: number): S | null {
        let best: S | null = null, bd = 22;
        for (const s of stars) {
          if (!visible(s)) continue;
          const d = Math.hypot(sx(s.x) - px, sy(s.y) - py);
          if (d < bd) { bd = d; best = s; }
        }
        return best;
      }
      const visible = (s: S) => (!matches || matches.has(s));
      const local = (e: PointerEvent | WheelEvent) => { const r = canvas!.getBoundingClientRect(); return { x: e.clientX - r.left, y: e.clientY - r.top }; };

      canvas.addEventListener('pointerdown', (e) => {
        canvas!.setPointerCapture(e.pointerId);
        ptrs.set(e.pointerId, local(e)); moved = 0; tween = null; vel = { x: 0, y: 0 };
        if (ptrs.size === 2) { const [a, b] = [...ptrs.values()]; pinch = Math.hypot(a.x - b.x, a.y - b.y); }
        q.blur(); list.hidden = true;
      }, on);
      canvas.addEventListener('pointermove', (e) => {
        const p = local(e), prev = ptrs.get(e.pointerId);
        if (!prev) { hover = pick(p.x, p.y); canvas!.classList.toggle('is-hot', !!hover); return; }
        if (ptrs.size === 1) {
          const dx = p.x - prev.x, dy = p.y - prev.y;
          moved += Math.abs(dx) + Math.abs(dy);
          cam.x -= dx / cam.z; cam.y -= dy / cam.z;
          vel = { x: -dx / cam.z, y: -dy / cam.z }; lastMove = performance.now();
          if (moved > 6) { canvas!.classList.add('is-drag'); touch(); }
        }
        ptrs.set(e.pointerId, p);
        if (ptrs.size === 2) {
          const [a, b] = [...ptrs.values()];
          const d = Math.hypot(a.x - b.x, a.y - b.y);
          if (pinch) zoomAt((a.x + b.x) / 2, (a.y + b.y) / 2, d / pinch);
          pinch = d; moved += 10; touch();
        }
      }, on);
      const up = (e: PointerEvent) => {
        const p = local(e);
        const wasDown = ptrs.delete(e.pointerId);
        canvas!.classList.remove('is-drag');
        if (ptrs.size < 2) pinch = 0;
        if (!wasDown || ptrs.size) return;
        if (performance.now() - lastMove > 60) vel = { x: 0, y: 0 };
        if (moved <= 6 && e.type === 'pointerup') {
          const s = pick(p.x, p.y);
          if (s) { select(s); touch(); }
