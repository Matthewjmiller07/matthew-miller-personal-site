      }
      function zoomAt(px: number, py: number, factor: number) {
        const wx = (px - W / 2) / cam.z + cam.x, wy = (py - H / 2) / cam.z + cam.y;
        cam.z = clamp(cam.z * factor, fitZ * 0.8, 6);
        cam.x = wx - (px - W / 2) / cam.z; cam.y = wy - (py - H / 2) / cam.z;
        tween = null;
      }

      // ── Selection, card, search ─────────────────────────────────────────
      const card = $('atlas-card');
      function select(s: S | null, fly = true, dur = 1100) {
        selected = s;
        if (!s) { card.hidden = true; history.replaceState(null, '', location.pathname + location.search); return; }
        const g = groupOf.get(s.g)!;
        $('atlas-card-title').textContent = s.t;
        $('atlas-card-desc').textContent = s.d || g.name;
        $('atlas-card-group').textContent = g.name;
        ($('atlas-card-dot') as HTMLElement).style.cssText = `background:${g.color};box-shadow:0 0 10px ${g.color}`;
        $('atlas-card-path').textContent = s.p;
        $('atlas-card-new').hidden = !s.n;
        ($('atlas-card-open') as HTMLAnchorElement).href = s.p;
        card.hidden = true; void card.offsetWidth; card.hidden = false; // replay the entrance
        history.replaceState(null, '', '#' + s.p);
        if (fly) {
          const z = Math.max(cam.z, W < 760 ? 1.5 : 1.9);
          // keep the star clear of the card: left of it on desktop, above it on a phone
          const ox = W < 760 ? 0 : 170 / z, oy = W < 760 ? 90 / z : 0;
          flyTo(s.x + ox, s.y + oy, z, dur);
        }
      }

      const q = $('atlas-q') as HTMLInputElement;
      const list = $('atlas-results');
      let shown: S[] = [], cursor = 0;
      function search() {
        const words = q.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
        list.textContent = '';
        if (!words.length) { matches = null; list.hidden = true; shown = []; return; }
        const found = stars.filter((s) => words.every((w) => s.hay.includes(w)));
        // title hits first
        found.sort((a, b) => Number(words.every((w) => b.t.toLowerCase().includes(w))) - Number(words.every((w) => a.t.toLowerCase().includes(w))) || b.m - a.m);
        matches = new Set(found);
        shown = found.slice(0, 8); cursor = 0;
        if (activeGroup) { activeGroup = null; chips.forEach((c) => c.classList.remove('is-on')); }
        if (found.length) {
          const xs = found.map((s) => s.x), ys = found.map((s) => s.y);
          const x0 = Math.min(...xs), x1 = Math.max(...xs), y0 = Math.min(...ys), y1 = Math.max(...ys);
          const z = Math.min((W * 0.6) / Math.max(120, x1 - x0), (H * 0.5) / Math.max(120, y1 - y0), 1.6);
          flyTo((x0 + x1) / 2, (y0 + y1) / 2, Math.max(z, fitZ), 700);
        }
        if (!found.length) {
          const li = document.createElement('li');
          li.className = 'atlas-none'; li.textContent = 'No star by that name.';
          list.append(li);
        }
        shown.forEach((s, i) => {
          const li = document.createElement('li');
          const b = document.createElement('button');
          b.type = 'button'; b.style.setProperty('--c', s.c);
          if (i === 0) b.className = 'is-on';
          const dot = document.createElement('i'); const label = document.createElement('span');
          label.textContent = s.t; b.append(dot, label);
          b.addEventListener('click', () => { list.hidden = true; select(s); });
          li.append(b); list.append(li);
        });
        list.hidden = false;
      }
      q.addEventListener('input', search, on);
      q.addEventListener('focus', () => { if (q.value.trim()) list.hidden = false; }, on);
      q.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
