          ctx.globalAlpha = a * birth;
          ctx.fillStyle = '#fffaf0';
          ctx.beginPath(); ctx.arc(x, y, core, 0, Math.PI * 2); ctx.fill();
          if (s.n && a > 0.5) {
            // new this month: a slow ripple
            const ph = reduce ? 0.5 : (time * 0.5 + s.seed) % 1;
            ctx.globalAlpha = (1 - ph) * 0.7; ctx.strokeStyle = '#fffaf0'; ctx.lineWidth = 1;
            ctx.beginPath(); ctx.arc(x, y, core + 3 + ph * 14, 0, Math.PI * 2); ctx.stroke();
          }
          if (isSel) {
            const rr = core + 11, rot = reduce ? 0 : time * 0.8;
            ctx.globalAlpha = 0.95; ctx.strokeStyle = '#f4eee1'; ctx.lineWidth = 1.4;
            for (let i = 0; i < 4; i++) { ctx.beginPath(); ctx.arc(x, y, rr, rot + i * (Math.PI / 2) + 0.25, rot + (i + 1) * (Math.PI / 2) - 0.25); ctx.stroke(); }
          }
          const need = s.m === 3 ? 1.25 : s.m === 2 ? 1.7 : 3.1;
          const zr = cam.z / fitZ;
          if (a > 0.5 && (isSel || isHov || zr > need || (matches && matches.size <= 12))) labelQueue.push([s, x, y, core]);
        }

        // labels: the chosen and the bright ones claim their space first
        labelQueue.sort((a, b) => Number(b[0] === selected) - Number(a[0] === selected) || Number(b[0] === hover) - Number(a[0] === hover) || b[0].m - a[0].m);
        ctx.textBaseline = 'alphabetic';
        for (const [s, x, y, core] of labelQueue) {
          const strong = s === selected || s === hover;
          const text = s.t.length > 44 ? s.t.slice(0, 42) + '…' : s.t;
          label(text, x + core + 7, y + 4, strong ? 1 : 0.86, `${strong || s.m > 1 ? 600 : 500} ${strong ? 13 : 12}px Inter, system-ui, sans-serif`, strong ? '#fffaf0' : '#d9d0bc', strong);
        }

        // constellation names, like the lettering on an old chart
        const nameAlpha = clamp(2.6 - cam.z / fitZ, 0, 1) * (reduce ? 1 : clamp((time - 1.2) / 1, 0, 1));
        if (nameAlpha > 0.02) {
          for (const g of groups) {
            const gx = sx(g.x), gy = sy(g.y - g.r) - 10;
            const dimmed = (activeGroup && activeGroup !== g.id) || matches;
            ctx.font = `700 ${W < 760 ? 11 : 13}px 'Frank Ruhl Libre', Georgia, serif`;
            (ctx as any).letterSpacing = W < 760 ? '0.14em' : '0.22em';
            const text = g.name.toUpperCase();
            const w = ctx.measureText(text).width;
            ctx.globalAlpha = nameAlpha * (dimmed ? 0.25 : 0.95);
            ctx.lineWidth = 4; ctx.strokeStyle = 'rgba(8,7,6,0.8)'; ctx.strokeText(text, gx - w / 2, gy);
            ctx.fillStyle = g.color; ctx.fillText(text, gx - w / 2, gy);
            (ctx as any).letterSpacing = '0px';
            ctx.font = `400 ${W < 760 ? 12 : 14}px 'Frank Ruhl Libre', 'Noto Serif Hebrew', serif`;
            const hw = ctx.measureText(g.he).width;
            if (W >= 760) {
              // no room for the second line on a phone
              ctx.globalAlpha = nameAlpha * (dimmed ? 0.15 : 0.55);
              ctx.fillStyle = '#c9c0ad'; ctx.fillText(g.he, gx - hw / 2, gy - 18);
            }
          }
        }
        ctx.globalAlpha = 1;
        raf = requestAnimationFrame(frame);
      }

      resize();
      // arrive at a shared star, e.g. /atlas#/mega-bible
      const want = decodeURIComponent(location.hash.slice(1));
      const linked = want.startsWith('/') ? stars.find((s) => s.p === want) : null;
      if (linked) { stars.forEach((s) => (s.born = -10)); select(linked, true, 1); touch(); }
      else if (!reduce) { cam.z = fitZ * 0.72; home(); }
      if (matchMedia('(pointer: coarse)').matches) $('atlas-hint').textContent = 'Drag to move · pinch to zoom · tap a star';
      raf = requestAnimationFrame(frame);
    }

    document.addEventListener('astro:page-load', init);
    if (document.readyState !== 'loading') init(); else document.addEventListener('DOMContentLoaded', init);
  </script>
</Layout>
