        }
      };
      canvas.addEventListener('pointerup', up, on);
      canvas.addEventListener('pointercancel', up, on);
      canvas.addEventListener('pointerleave', () => { hover = null; canvas!.classList.remove('is-hot'); }, on);
      canvas.addEventListener('wheel', (e) => {
        e.preventDefault();
        const p = local(e);
        zoomAt(p.x, p.y, Math.exp(-e.deltaY * (e.ctrlKey ? 0.012 : 0.0016)));
        touch();
      }, { passive: false, signal: life.signal });
      canvas.addEventListener('dblclick', (e) => { const p = local(e); const wx = (p.x - W / 2) / cam.z + cam.x, wy = (p.y - H / 2) / cam.z + cam.y; flyTo(wx, wy, cam.z * 1.8, 400); }, on);

      window.addEventListener('keydown', (e) => {
        const el = e.target as HTMLElement;
        if (el && /INPUT|TEXTAREA|SELECT/.test(el.tagName)) return;
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        const step = 90 / cam.z;
        if (e.key === '/') { e.preventDefault(); q.focus(); }
        else if (e.key === 'Escape') { select(null, false); focusGroup(null); }
        else if (e.key === '+' || e.key === '=') flyTo(cam.x, cam.y, cam.z * 1.4, 250);
        else if (e.key === '-') flyTo(cam.x, cam.y, cam.z / 1.4, 250);
        else if (e.key === 'ArrowLeft') { cam.x -= step; tween = null; }
        else if (e.key === 'ArrowRight') { cam.x += step; tween = null; }
        else if (e.key === 'ArrowUp' && document.activeElement === document.body) { e.preventDefault(); cam.y -= step; tween = null; }
        else if (e.key === 'ArrowDown' && document.activeElement === document.body) { e.preventDefault(); cam.y += step; tween = null; }
      }, on);
      window.addEventListener('resize', resize, on);
      window.addEventListener('hashchange', () => {
        const p = decodeURIComponent(location.hash.slice(1));
        const s = p.startsWith('/') ? stars.find((x) => x.p === p) : null;
        if (s && s !== selected) select(s);
      }, on);

      // ── Draw ─────────────────────────────────────────────────────────────
      let running = true, raf = 0;
      const io = new IntersectionObserver(([en]) => { running = en.isIntersecting; if (running) { cancelAnimationFrame(raf); raf = requestAnimationFrame(frame); } });
      io.observe(stage);

      const boxes: number[][] = [];
      function label(text: string, x: number, y: number, alpha: number, font: string, color: string, force = false) {
        ctx.font = font;
        const w = ctx.measureText(text).width, h = 14;
        const box = [x - 3, y - h, x + w + 3, y + 4];
        if (!force) for (const b of boxes) if (box[0] < b[2] && box[2] > b[0] && box[1] < b[3] && box[3] > b[1]) return;
        boxes.push(box);
        ctx.globalAlpha = alpha;
        ctx.lineWidth = 3; ctx.strokeStyle = 'rgba(8,7,6,0.85)'; ctx.strokeText(text, x, y);
        ctx.fillStyle = color; ctx.fillText(text, x, y);
      }

      function frame(now: number) {
        if (!canvas!.isConnected) { life.abort(); io.disconnect(); return; }
        if (!running || document.hidden) { raf = requestAnimationFrame(frame); return; }
        const time = (now - t0) / 1000;
        const px = cam.x, py = cam.y, pz = cam.z;

        if (tween) {
          const k = clamp((now - tween.t0) / tween.dur, 0, 1), e = ease(k);
          // long hops pull back mid-flight, like looking up from the page to find your place
          const far = Math.hypot(tween.tx - tween.fx, tween.ty - tween.fy) * Math.min(tween.fz, tween.tz);
          const dip = far > Math.max(W, H) * 0.6 ? Math.sin(k * Math.PI) * 0.45 : 0;
          cam.x = tween.fx + (tween.tx - tween.fx) * e; cam.y = tween.fy + (tween.ty - tween.fy) * e;
          cam.z = Math.exp(Math.log(tween.fz) + (Math.log(tween.tz) - Math.log(tween.fz)) * e) * (1 - dip);
          if (k >= 1) tween = null;
        } else if (!ptrs.size && (Math.abs(vel.x) > 0.01 || Math.abs(vel.y) > 0.01)) {
          cam.x += vel.x; cam.y += vel.y; vel.x *= 0.93; vel.y *= 0.93;
        }
        cam.x = clamp(cam.x, -world.w / 2, world.w / 2); cam.y = clamp(cam.y, -world.h / 2, world.h / 2);
        const mvx = (cam.x - px) * cam.z, mvy = (cam.y - py) * cam.z;
        speed = speed * 0.7 + Math.hypot(mvx, mvy) * 0.3 + Math.abs(cam.z - pz) * 40;

        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, W, H);

        // dust, with parallax; it smears into streaks when the camera moves fast
        const streak = clamp((speed - 6) / 30, 0, 1);
        for (const d of dust) {
          const par = 0.04 + d.layer * 0.07;
          const span = 1600;
          let x = ((d.x * span - cam.x * par * cam.z) % span + span) % span;
          let y = ((d.y * span - cam.y * par * cam.z) % span + span) % span;
          x = (x / span) * (W + 200) - 100; y = (y / span) * (H + 200) - 100;
          const tw = reduce ? 1 : 0.7 + 0.3 * Math.sin(time * (0.6 + d.layer * 0.4) + d.tw);
          ctx.globalAlpha = d.a * tw * (0.35 + d.layer * 0.2);
          if (streak > 0.02) {
            const dx = x - W / 2, dy = y - H / 2, len = streak * (10 + d.layer * 16), n = Math.hypot(dx, dy) || 1;
            ctx.strokeStyle = '#e9dfc8'; ctx.lineWidth = 0.8 + d.layer * 0.3;
            ctx.beginPath(); ctx.moveTo(x, y); ctx.lineTo(x + (dx / n) * len, y + (dy / n) * len); ctx.stroke();
          } else {
            ctx.fillStyle = '#e9dfc8';
            const r = 0.5 + d.layer * 0.35;
            ctx.fillRect(x - r, y - r, r * 2, r * 2);
          }
        }

        // the chart's own furniture: orbit rings and tick marks in bronze ink
        const ox = sx(0), oy = sy(0);
        ctx.strokeStyle = '#c9a86a'; ctx.lineWidth = 1;
        const rings = [0.34, 0.68, 1.02];
        const base = Math.min(world.w, world.h) / 2;
        rings.forEach((r, i) => {
          ctx.globalAlpha = 0.07 + (i === 2 ? 0.04 : 0);
          ctx.beginPath(); ctx.ellipse(ox, oy, ringX * r * cam.z, ringY * r * cam.z, 0, 0, Math.PI * 2); ctx.stroke();
        });
        ctx.globalAlpha = 0.16;
        for (let i = 0; i < 72; i++) {
          const a = (i / 72) * Math.PI * 2, long = i % 6 === 0;
          const rx = ringX * 1.02 * cam.z, ry = ringY * 1.02 * cam.z;
          const k = 1 + (long ? 16 : 7) / Math.max(40, base * cam.z);
          ctx.beginPath(); ctx.moveTo(ox + Math.cos(a) * rx, oy + Math.sin(a) * ry); ctx.lineTo(ox + Math.cos(a) * rx * k, oy + Math.sin(a) * ry * k); ctx.stroke();
        }

        // nebulae
        ctx.globalCompositeOperation = 'lighter';
        for (const g of groups) {
          const gx = sx(g.x), gy = sy(g.y), gr = g.r * 1.9 * cam.z;
          if (gx + gr < 0 || gx - gr > W || gy + gr < 0 || gy - gr > H) continue;
          const on2 = !activeGroup || activeGroup === g.id;
          ctx.globalAlpha = (on2 ? 0.2 : 0.06) * (matches ? 0.4 : 1);
          ctx.drawImage(sprites.get(g.color)!, gx - gr, gy - gr, gr * 2, gr * 2);
        }
        ctx.globalCompositeOperation = 'source-over';

        // constellation figures
        for (const g of groups) {
          if (g.path.length < 2) continue;
          const lit = (!activeGroup || activeGroup === g.id) && !matches;
          ctx.globalAlpha = lit ? (g.id === 'talmud' ? 0.3 : 0.38) : 0.08;
          ctx.strokeStyle = g.color; ctx.lineWidth = 1;
          ctx.beginPath();
          const reveal = reduce ? 1 : clamp((time - 0.5) / 1.8, 0, 1);
          const n = Math.max(2, Math.ceil(g.path.length * reveal));
          g.path.slice(0, n).forEach((s, i) => (i ? ctx.lineTo(sx(s.x), sy(s.y)) : ctx.moveTo(sx(s.x), sy(s.y))));
          ctx.stroke();
        }

        // stars
        boxes.length = 0;
        const labelQueue: [S, number, number, number][] = [];
        for (const s of stars) {
          const x = sx(s.x), y = sy(s.y);
          if (x < -60 || x > W + 60 || y < -60 || y > H + 60) continue;
          if (!s.born) s.born = reduce ? -10 : 0.15 + Math.hypot(s.x, s.y) / 1500 + s.seed * 0.3;
          const birth = clamp((time - s.born) / 0.7, 0, 1);
          if (birth <= 0) continue;
          const isSel = s === selected, isHov = s === hover;
          let a = 1;
          if (matches && !matches.has(s)) a = 0.07;
          else if (activeGroup && activeGroup !== s.g) a = 0.22;
          const tw = reduce ? 1 : 0.82 + 0.18 * Math.sin(time * (1.1 + s.seed * 1.6) + s.seed * 40);
          const zoomK = clamp(Math.pow(cam.z / fitZ, 0.42), 1, 2.6);
          const core = (s.m === 3 ? 3 : s.m === 2 ? 2.2 : 1.45) * zoomK * (isSel || isHov ? 1.35 : 1);
          const glow = core * (s.m === 3 ? 8.5 : 6.5) * (0.9 + 0.1 * tw) * (2 - birth);
