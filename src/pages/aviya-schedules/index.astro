---
import Layout from '../../layouts/Layout.astro';
import { GOOGLE_SHEETS_CONFIG } from '../api/config.js';
import { listSheets, getSheetData } from '../../utils/googleSheetsClient.js';

let schedules = [];
let error = null;

try {
  const allSheets = await listSheets(GOOGLE_SHEETS_CONFIG.spreadsheetId);
  const schedulesSheet = allSheets.find(sheet => sheet.title === 'schedules');

  if (schedulesSheet) {
    const scheduleData = await getSheetData(
      GOOGLE_SHEETS_CONFIG.spreadsheetId,
      'schedules!A:F'
    );
    if (scheduleData && scheduleData.length > 1) {
      schedules = scheduleData.slice(1).map(row => ({
        name: row[0] || '',
        sheetName: row[1] || '',
        createdAt: row[2] ? new Date(row[2]).toLocaleDateString() : '',
        entryCount: parseInt(row[3]) || 0,
        dateRange: row[4] || '',
        description: row[5] || '',
      }));
    }
  } else {
    const systemSheets = ['Sheet1', 'schedules'];
    schedules = allSheets
      .filter(sheet => !systemSheets.includes(sheet.title))
      .map(sheet => ({
        name: sheet.title,
        sheetName: sheet.title,
        createdAt: '',
        entryCount: 0,
        dateRange: '',
        description: 'Schedule sheet'
      }));
  }

  schedules.unshift({
    name: 'Original Aviya Schedule',
    sheetName: 'default',
    createdAt: '',
    entryCount: 0,
    dateRange: '',
    description: 'The original Aviya Schedule'
  });
} catch (e) {
  console.error('Error loading schedules:', e);
  error = e.message;
  schedules = [{
    name: 'Original Aviya Schedule',
    sheetName: 'default',
    createdAt: '',
    entryCount: 0,
    dateRange: '',
    description: 'The original Aviya Schedule'
  }];
}

const today = new Date().toISOString().split('T')[0];
---

<Layout title="Aviya Torah Schedules">
  <main class="max-w-5xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-center mb-8">Aviya Torah Schedules</h1>

    {error &&
      <div class="bg-red-100 dark:bg-red-900/30 border border-red-400 text-red-800 dark:text-red-300 rounded-lg p-4 mb-6">
        Error loading schedules: {error}
      </div>
    }

    <div class="flex justify-between items-center mb-6">
      <h2 class="text-xl font-semibold">Available Schedules</h2>
      <a href="/torahschedule" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition">
        Create New Schedule
      </a>
    </div>

    {schedules.length === 0 ? (
      <div class="bg-blue-50 dark:bg-blue-900/30 border border-blue-300 text-blue-800 dark:text-blue-300 rounded-lg p-4">
        No schedules found. You can create one using the Torah Schedule generator.
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {schedules.map(schedule => (
          <div class="border border-gray-200 dark:border-gray-700 rounded-xl p-6 bg-white dark:bg-gray-800 flex flex-col gap-3">
            <h3 class="text-lg font-semibold">{schedule.name}</h3>
            {schedule.description && <p class="text-sm text-gray-600 dark:text-gray-400">{schedule.description}</p>}

            <ul class="text-sm text-gray-600 dark:text-gray-400 space-y-1">
              {schedule.createdAt && <li><span class="font-medium">Created:</span> {schedule.createdAt}</li>}
              {schedule.entryCount > 0 && <li><span class="font-medium">Entries:</span> {schedule.entryCount}</li>}
              {schedule.dateRange && <li><span class="font-medium">Date Range:</span> {schedule.dateRange}</li>}
            </ul>

            <a
              href={`/torah-schedules/${today}?schedule=${schedule.sheetName}`}
              class="mt-auto border border-blue-600 text-blue-600 hover:bg-blue-600 hover:text-white px-4 py-2 rounded-lg text-sm font-medium text-center transition"
            >
              Open Schedule
            </a>
          </div>
        ))}
      </div>
    )}
  </main>
</Layout>
