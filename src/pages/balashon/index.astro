---
// /balashon → this week's Balashon 2-pager (the first Shabbat on or after today, Israel time).
export const prerender = false;
import { weeks } from '../../data/parasha-hub';

const today = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Jerusalem' });
const week = weeks.find((w) => w.date >= today) ?? weeks[0];
return Astro.redirect(`/balashon/${week.slug}`, 302);
---
