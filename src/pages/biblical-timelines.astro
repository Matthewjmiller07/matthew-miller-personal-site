---
import Layout from '../layouts/Layout.astro';

const pageTitle = 'Biblical Character Timelines';
const pageDescription = 'Explore the ages and timelines of biblical characters at key events based on different commentaries and biblical texts';

// Sample data structure for biblical character timelines
const characterTimelines = [
  {
    character: "Isaac",
    events: [
      {
        eventName: "Binding (Akedah)",
        biblicalReference: "Genesis 22",
        age: 37,
        source: "Rashi (based on Sarah's age at death 127 and Isaac born when she was 90)",
        alternativeViews: [
          { age: 13, source: "Josephus" },
          { age: 25, source: "Some Midrashic traditions" }
        ]
      },
      {
        eventName: "Marriage to Rebecca",
        biblicalReference: "Genesis 25:20",
        age: 40,
        source: "Straightforward calculation from biblical text",
        alternativeViews: []
      },
      {
        eventName: "Birth of Jacob and Esau",
        biblicalReference: "Genesis 25:26",
        age: 60,
        source: "Biblical text states Isaac was 60 at their birth",
        alternativeViews: []
      }
    ]
  },
  {
    character: "Rebecca",
    events: [
      {
        eventName: "At the Well",
        biblicalReference: "Genesis 24",
        age: 3,
        source: "Seder Olam Rabbah",
        alternativeViews: [
          { age: 14, source: "Rashi" },
          { age: 10, source: "Other traditional sources" }
        ]
      },
      {
        eventName: "Marriage to Isaac",
        biblicalReference: "Genesis 24:67",
        age: 3,
        source: "Seder Olam Rabbah (married immediately after meeting)",
        alternativeViews: [
          { age: 14, source: "Rashi" },
          { age: 10, source: "Other traditional sources" }
        ]
      }
    ]
  },
  {
    character: "Jacob",
    events: [
      {
        eventName: "Birthright Sale",
        biblicalReference: "Genesis 25:29-34",
        age: 15,
        source: "Traditional calculation based on timeline",
        alternativeViews: [
          { age: 13, source: "Some commentaries" }
        ]
      },
      {
        eventName: "Blessing from Isaac",
        biblicalReference: "Genesis 27",
        age: 63,
        source: "Calculated from Isaac's age (123) and Jacob's birth when Isaac was 60",
        alternativeViews: []
      },
      {
        eventName: "Fleeing to Laban",
        biblicalReference: "Genesis 28",
        age: 63,
        source: "Immediately after blessing",
        alternativeViews: []
      },
      {
        eventName: "Marriage to Leah and Rachel",
        biblicalReference: "Genesis 29",
        age: 77,
        source: "After 14 years working for Laban (7+7)",
        alternativeViews: []
      }
    ]
  },
  {
    character: "Joseph",
    events: [
      {
        eventName: "Sold into Slavery",
        biblicalReference: "Genesis 37",
        age: 17,
        source: "Biblical text (Genesis 37:2)",
        alternativeViews: []
      },
      {
        eventName: "Dreams in Prison",
        biblicalReference: "Genesis 40",
        age: 28,
        source: "Traditional calculation based on 11 years as slave + 2 years in prison",
        alternativeViews: []
      },
      {
        eventName: "Becomes Viceroy",
        biblicalReference: "Genesis 41",
        age: 30,
        source: "Biblical text (Genesis 41:46)",
        alternativeViews: []
      },
      {
        eventName: "Reveals Identity to Brothers",
        biblicalReference: "Genesis 45",
        age: 39,
        source: "After 7 years of plenty + 2 years of famine",
        alternativeViews: []
      }
    ]
  },
  {
    character: "Moses",
    events: [
      {
        eventName: "Birth",
        biblicalReference: "Exodus 2",
        age: 0,
        source: "Biblical text",
        alternativeViews: []
      },
      {
        eventName: "Fleeing to Midian",
        biblicalReference: "Exodus 2:15",
        age: 40,
        source: "Traditional calculation based on 40 years as prince, 40 years as shepherd, 40 years as leader",
        alternativeViews: []
      },
      {
        eventName: "Burning Bush",
        biblicalReference: "Exodus 3",
        age: 80,
        source: "Traditional calculation",
        alternativeViews: []
      },
      {
        eventName: "Exodus from Egypt",
        biblicalReference: "Exodus 12",
        age: 80,
        source: "Biblical text and tradition",
        alternativeViews: []
      },
      {
        eventName: "Giving of Torah",
        biblicalReference: "Exodus 19-20",
        age: 80,
        source: "50 days after Exodus",
        alternativeViews: []
      },
      {
        eventName: "Death",
        biblicalReference: "Deuteronomy 34",
        age: 120,
        source: "Biblical text (Deuteronomy 34:7)",
        alternativeViews: []
      }
    ]
  }
];
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="max-w-7xl mx-auto px-4 py-12">
    <header class="mb-12">
      <div class="text-center">
        <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">{pageTitle}</h1>
        <p class="text-lg text-gray-600 dark:text-gray-400 max-w-3xl mx-auto">
          Explore the ages and timelines of biblical characters at significant events. This tool presents different interpretations from traditional commentaries, helping you understand the various perspectives on biblical chronology.
        </p>
      </div>
    </header>

    <!-- Introduction -->
    <section class="mb-12 bg-blue-50 dark:bg-blue-900/20 rounded-lg p-6 border border-blue-200 dark:border-blue-800">
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="flex-1">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Understanding Biblical Chronology</h3>
          <p class="text-sm text-gray-700 dark:text-gray-300 mb-3">
            Biblical chronology often involves careful calculation and interpretation of textual clues. Different commentators and traditions sometimes arrive at varying conclusions about the ages of characters at specific events. This tool presents multiple perspectives to help you appreciate the richness of biblical interpretation.
          </p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
            <div class="bg-white dark:bg-gray-800 rounded-md p-3 border border-gray-200 dark:border-gray-600">
              <h4 class="font-medium text-gray-900 dark:text-white mb-1">Traditional Sources</h4>
              <p class="text-gray-600 dark:text-gray-400">Rashi, Seder Olam Rabbah, and other classic commentators</p>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-md p-3 border border-gray-200 dark:border-gray-600">
              <h4 class="font-medium text-gray-900 dark:text-white mb-1">Historical Perspectives</h4>
              <p class="text-gray-600 dark:text-gray-400">Josephus and other ancient historical sources</p>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-md p-3 border border-gray-200 dark:border-gray-600">
              <h4 class="font-medium text-gray-900 dark:text-white mb-1">Biblical Text</h4>
              <p class="text-gray-600 dark:text-gray-400">Direct calculations from the biblical narrative</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Character Selection -->
    <section class="mb-8">
      <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-6">Select a Character</h2>
      <div class="flex flex-wrap gap-3" id="characterTabs">
        {characterTimelines.map((character, index) => (
          <button 
            class={`character-tab px-4 py-2 rounded-lg font-medium transition-all duration-200 ${
              index === 0 
                ? 'bg-blue-600 text-white shadow-lg' 
                : 'bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 border border-gray-300 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700'
            }`}
            data-character={character.character}
            onclick={`selectCharacter('${character.character}')`}
          >
            {character.character}
          </button>
        ))}
      </div>
    </section>

    <!-- Timeline Display -->
    <section id="timelineDisplay" class="space-y-6">
      {characterTimelines.map((character) => (
        <div 
          class={`character-timeline ${character.character === 'Isaac' ? '' : 'hidden'}`}
          data-character={character.character}
        >
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
            <div class="bg-gradient-to-r from-blue-600 to-blue-700 dark:from-blue-700 dark:to-blue-800 p-6">
              <h3 class="text-2xl font-bold text-white">{character.character}</h3>
              <p class="text-blue-100 text-sm mt-1">Timeline of key events and ages</p>
            </div>
            
            <div class="p-6">
              <div class="space-y-6">
                {character.events.map((event, eventIndex) => (
                  <div class="relative pl-8 pb-6 border-l-2 border-gray-200 dark:border-gray-600 last:border-l-0">
                    <div class="absolute left-0 top-0 w-4 h-4 bg-blue-600 rounded-full -translate-x-1/2 border-2 border-white dark:border-gray-800"></div>
                    
                    <div class="bg-gray-50 dark:bg-gray-700/50 rounded-lg p-4">
                      <div class="flex items-start justify-between mb-3">
                        <div>
                          <h4 class="text-lg font-semibold text-gray-900 dark:text-white">{event.eventName}</h4>
                          <p class="text-sm text-gray-600 dark:text-gray-400">
                            <span class="font-medium">Reference:</span> {event.biblicalReference}
                          </p>
                        </div>
                        <div class="text-right">
                          <div class="text-2xl font-bold text-blue-600 dark:text-blue-400">Age {event.age}</div>
                          <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">Primary view</div>
                        </div>
                      </div>
                      
                      <div class="mb-3">
                        <p class="text-sm text-gray-700 dark:text-gray-300">
                          <span class="font-medium">Source:</span> {event.source}
                        </p>
                      </div>
                      
                      {event.alternativeViews && event.alternativeViews.length > 0 && (
                        <div class="border-t border-gray-200 dark:border-gray-600 pt-3">
                          <h5 class="text-sm font-medium text-gray-900 dark:text-white mb-2">Alternative Views:</h5>
                          <div class="space-y-2">
                            {event.alternativeViews.map((altView) => (
                              <div class="flex items-center justify-between text-sm bg-white dark:bg-gray-800 rounded p-2">
                                <span class="text-gray-700 dark:text-gray-300">{altView.source}</span>
                                <span class="font-medium text-blue-600 dark:text-blue-400">Age {altView.age}</span>
                              </div>
                            ))}
                          </div>
                        </div>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </section>

    <!-- Timeline Visualization -->
    <section class="mt-12">
      <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-6">Visual Timeline</h2>
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 border border-gray-200 dark:border-gray-700">
        <div id="timelineChart" class="h-96">
          <canvas id="characterTimelineChart"></canvas>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  // Character selection functionality
  function selectCharacter(characterName) {
    // Hide all timelines
    document.querySelectorAll('.character-timeline').forEach(timeline => {
      timeline.classList.add('hidden');
    });
    
    // Show selected timeline
    const selectedTimeline = document.querySelector(`[data-character="${characterName}"]`);
    if (selectedTimeline) {
      selectedTimeline.classList.remove('hidden');
    }
    
    // Update tab styles
    document.querySelectorAll('.character-tab').forEach(tab => {
      if (tab.dataset.character === characterName) {
        tab.className = 'character-tab px-4 py-2 rounded-lg font-medium transition-all duration-200 bg-blue-600 text-white shadow-lg';
      } else {
        tab.className = 'character-tab px-4 py-2 rounded-lg font-medium transition-all duration-200 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 border border-gray-300 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700';
      }
    });
    
    // Update chart
    updateTimelineChart(characterName);
  }
  
  // Make function globally available
  window.selectCharacter = selectCharacter;
  
  // Timeline chart functionality (placeholder for now)
  function updateTimelineChart(characterName) {
    // This would update a visual timeline chart
    // For now, we'll just log the selection
    console.log('Selected character:', characterName);
  }
  
  // Initialize chart on page load
  document.addEventListener('DOMContentLoaded', function() {
    updateTimelineChart('Isaac');
  });
</script>

<style>
  /* Timeline styles */
  .character-timeline {
    animation: fadeIn 0.3s ease-in-out;
  }
  
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  /* Timeline line styles */
  .character-timeline .relative:last-child {
    border-left-color: transparent !important;
  }
  
  /* Chart container */
  #timelineChart {
    position: relative;
    height: 400px;
  }
</style>
