---
import Layout from '../layouts/Layout.astro';

const siteBase = 'https://theothermatthewmiller.com';

const calendars = [
  {
    id: 'hayom_yom',
    name: 'Hayom Yom — Tackling Life\'s Tasks',
    description: 'Daily Chassidic teachings from the Lubavitcher Rebbe. Each event links directly to the corresponding entry on Chabad.org. Covers the first 8 days of each month (112 daily entries) spanning Kislev 5786 through Kislev 5787.',
    file: '/calendar/hayom_yom.ics',
    source: 'https://www.chabad.org/therebbe/article_cdo/aid/3314961/jewish/Hayom-Yom-Tackling-Lifes-Tasks.htm',
    tags: ['Jewish', 'Chassidic', 'Daily Study'],
    eventCount: 113,
    note: 'Adar I entries are placed in the 5787 leap year (Feb 2027). Adar II entries serve as the regular Adar in non-leap years.',
  },
];
---

<Layout
  title="Calendars"
  description="Subscribe to or download ICS calendars for Jewish study schedules, daily learning, and more."
>
  <main class="max-w-4xl mx-auto px-4 py-10">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-primary-light dark:text-primary-dark mb-2">Calendars</h1>
      <p class="text-secondary-light dark:text-secondary-dark">
        Subscribe to these calendars directly in Apple Calendar, Google Calendar, or any app that supports ICS / webcal links.
        Each calendar entry links to the relevant source material.
      </p>
    </div>

    <!-- How to subscribe -->
    <div class="bg-accent/10 border border-accent/30 rounded-xl p-5 mb-8">
      <h2 class="font-semibold text-accent dark:text-accent-dark mb-2">How to subscribe</h2>
      <ul class="text-sm text-secondary-light dark:text-secondary-dark space-y-1 list-disc list-inside">
        <li><strong>Google Calendar:</strong> Click "Add to Google Calendar" above, or go to Other Calendars → "+" → "From URL" and paste the <code class="text-xs bg-slate-200 dark:bg-slate-700 px-1 rounded">https://</code> URL.</li>
        <li><strong>Apple Calendar:</strong> Click "Apple / Outlook (webcal)" — the app will open and prompt you to subscribe.</li>
        <li><strong>Outlook / Thunderbird:</strong> Copy the <code class="text-xs bg-slate-200 dark:bg-slate-700 px-1 rounded">https://</code> URL and add it as a calendar from internet/URL.</li>
        <li><strong>One-time import:</strong> Use "Download .ics" to import a static snapshot (won't auto-update).</li>
      </ul>
    </div>

    <!-- Calendar cards -->
    <div class="space-y-6">
      {calendars.map(cal => (
        <div class="bg-card-bg-light dark:bg-card-bg-dark border border-border-light dark:border-border-dark rounded-xl p-6 shadow-sm">
          <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
            <div class="flex-1">
              <div class="flex flex-wrap items-center gap-2 mb-1">
                <h2 class="text-xl font-bold text-primary-light dark:text-primary-dark">{cal.name}</h2>
                {cal.tags.map(tag => (
                  <span class="text-xs px-2 py-0.5 rounded-full bg-accent/10 text-accent dark:text-accent-dark border border-accent/20">
                    {tag}
                  </span>
                ))}
              </div>
              <p class="text-sm text-secondary-light dark:text-secondary-dark mb-2">{cal.description}</p>
              {cal.note && (
                <p class="text-xs text-secondary-light/70 dark:text-secondary-dark/70 italic mb-3">{cal.note}</p>
              )}
              <div class="flex flex-wrap items-center gap-4 text-xs text-secondary-light dark:text-secondary-dark">
                <span>📅 {cal.eventCount} events</span>
                <a
                  href={cal.source}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-accent dark:text-accent-dark hover:underline"
                >
                  View source ↗
                </a>
              </div>
            </div>

            <!-- Action buttons -->
            <div class="flex flex-col gap-2 sm:min-w-[200px]">
              <a
                href={`https://calendar.google.com/calendar/render?cid=${encodeURIComponent(`webcal://theothermatthewmiller.com${cal.file}`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-accent text-white dark:text-white font-medium text-sm hover:opacity-90 transition-opacity"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                Add to Google Calendar
              </a>
              <a
                href={`webcal://theothermatthewmiller.com${cal.file}`}
                class="flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg border border-border-light dark:border-border-dark text-primary-light dark:text-primary-dark font-medium text-sm hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                Apple / Outlook (webcal)
              </a>
              <a
                href={cal.file}
                download
                class="flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg border border-border-light dark:border-border-dark text-primary-light dark:text-primary-dark font-medium text-sm hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                Download .ics
              </a>
            </div>
          </div>

          <!-- ICS URL display -->
          <div class="mt-4 pt-4 border-t border-border-light dark:border-border-dark">
            <p class="text-xs text-secondary-light dark:text-secondary-dark mb-2 font-medium">Paste this URL into any calendar app (Outlook, Thunderbird, etc.):</p>
            <div class="flex items-center gap-2">
              <code class="text-xs bg-slate-100 dark:bg-slate-800 text-accent dark:text-accent-dark px-3 py-1.5 rounded flex-1 break-all">
                https://theothermatthewmiller.com{cal.file}
              </code>
              <button
                data-copy={`https://theothermatthewmiller.com${cal.file}`}
                class="copy-btn shrink-0 flex items-center gap-1.5 px-3 py-1.5 rounded border border-border-light dark:border-border-dark text-secondary-light dark:text-secondary-dark text-xs font-medium hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                Copy
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Add a calendar section -->
    <div class="mt-10 border border-dashed border-border-light dark:border-border-dark rounded-xl p-6 text-center">
      <div class="text-3xl mb-2">➕</div>
      <h3 class="font-semibold text-primary-light dark:text-primary-dark mb-1">Want another calendar added?</h3>
      <p class="text-sm text-secondary-light dark:text-secondary-dark">
        More study schedules and topic-based calendars coming soon.
      </p>
    </div>
  </main>

  <script is:inline>
    document.addEventListener('astro:page-load', () => {
      document.querySelectorAll('.copy-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const text = btn.dataset.copy;
          navigator.clipboard.writeText(text).then(() => {
            const original = btn.innerHTML;
            btn.innerHTML = btn.innerHTML.replace('Copy link', 'Copied!');
            setTimeout(() => { btn.innerHTML = original; }, 2000);
          });
        });
      });
    });
  </script>
</Layout>
