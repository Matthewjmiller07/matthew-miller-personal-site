---
// Server-rendered (not statically prerendered) so the page can read the
// ?lang= query param on each request and bake the right language into the
// <title>/meta/OG tags — a static build can't vary those by query string,
// which is why link previews (WhatsApp, etc.) for a ?lang=he URL were
// showing the English title/description. Slug matching is case-insensitive.
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import CalendarCard from '../../components/CalendarCard.astro';
import CalendarEventsScript from '../../components/CalendarEventsScript.astro';
import { getCalendarBySlug } from '../../lib/calendars';

const cal = getCalendarBySlug(Astro.params.slug);
if (!cal) {
  return Astro.redirect('/calendars');
}

const hasHebrew = Boolean(cal.nameHe);
const requestedLang = Astro.url.searchParams.get('lang');
const lang = requestedLang === 'he' && hasHebrew ? 'he' : 'en';
const t = (en, he) => (lang === 'he' && he) ? he : en;

const pageTitle = t(cal.name, cal.nameHe);
const pageDescription = t(cal.description, cal.descriptionHe);

const subscribeItemsEn = [
  '<strong>Google Calendar:</strong> Click "Add to Google Calendar" below, or go to Other Calendars → "+" → "From URL" and paste the <code class="text-xs bg-slate-200 dark:bg-slate-700 px-1 rounded">https://</code> URL.',
  '<strong>Apple Calendar:</strong> Click "Apple / Outlook (webcal)" — the app will open and prompt you to subscribe.',
  '<strong>Outlook / Thunderbird:</strong> Copy the <code class="text-xs bg-slate-200 dark:bg-slate-700 px-1 rounded">https://</code> URL and add it as a calendar from internet/URL.',
  '<strong>One-time import:</strong> Use "Download .ics" to import a static snapshot (won\'t auto-update).',
];
const subscribeItemsHe = [
  '<strong>יומן Google:</strong> לחצו על "הוספה ליומן Google" למטה, או עברו אל יומנים אחרים ← "+" ← "מכתובת URL" והדביקו את הכתובת <code class="text-xs bg-slate-200 dark:bg-slate-700 px-1 rounded">https://</code>.',
  '<strong>יומן Apple:</strong> לחצו על "Apple / Outlook (webcal)" — האפליקציה תיפתח ותציע להירשם.',
  '<strong>Outlook / Thunderbird:</strong> העתיקו את הכתובת <code class="text-xs bg-slate-200 dark:bg-slate-700 px-1 rounded">https://</code> והוסיפו אותה כיומן מהאינטרנט/מכתובת URL.',
  '<strong>ייבוא חד-פעמי:</strong> השתמשו ב"הורדת קובץ .ics" כדי לייבא תמונת מצב סטטית (לא תתעדכן אוטומטית).',
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
>
  <main class="lang-scope max-w-4xl mx-auto px-4 py-10" data-lang={lang} dir={lang === 'he' ? 'rtl' : 'ltr'}>
    <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
      <a
        href="/calendars"
        class="inline-flex items-center gap-1 text-sm text-secondary-light dark:text-secondary-dark hover:text-accent dark:hover:text-accent-dark transition-colors"
        data-en="All calendars"
        data-he="כל הלוחות"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        {t('All calendars', 'כל הלוחות')}
      </a>

      {hasHebrew && (
        <div class="flex gap-1" role="group" aria-label="Language">
          <button
            type="button"
            class:list={[
              'lang-toggle-btn text-sm font-medium px-3 py-1.5 rounded-full border transition-colors',
              lang === 'en' ? 'bg-accent text-white border-accent' : 'border-border-light dark:border-border-dark text-secondary-light dark:text-secondary-dark',
            ]}
            data-lang="en"
          >
            English
          </button>
          <button
            type="button"
            class:list={[
              'lang-toggle-btn text-sm font-medium px-3 py-1.5 rounded-full border transition-colors',
              lang === 'he' ? 'bg-accent text-white border-accent' : 'border-border-light dark:border-border-dark text-secondary-light dark:text-secondary-dark',
            ]}
            data-lang="he"
          >
            עברית
          </button>
        </div>
      )}
    </div>

    <!-- How to subscribe -->
    <div class="bg-accent/10 border border-accent/30 rounded-xl p-5 mb-8">
      <h2 class="font-semibold text-accent dark:text-accent-dark mb-2" data-en="How to subscribe" data-he="איך להירשם">{t('How to subscribe', 'איך להירשם')}</h2>
      <ul class="text-sm text-secondary-light dark:text-secondary-dark space-y-1 list-disc list-inside">
        {subscribeItemsEn.map((html, i) => (
          <li data-en-html={html} data-he-html={subscribeItemsHe[i]} set:html={t(html, subscribeItemsHe[i])} />
        ))}
      </ul>
    </div>

    {cal.id === 'jewish_holidays' && (
      <div id="upcoming-holidays" class="bg-card-bg-light dark:bg-card-bg-dark border border-border-light dark:border-border-dark rounded-xl p-5 mb-8 hidden">
        <div class="flex items-center justify-between mb-3">
          <h2 class="font-semibold text-primary-light dark:text-primary-dark">Coming up on the Jewish calendar</h2>
          <a href="https://whenarethejewishholidays.com" target="_blank" rel="noopener noreferrer" class="text-xs text-accent dark:text-accent-dark hover:underline">whenarethejewishholidays.com ↗</a>
        </div>
        <ul id="upcoming-holidays-list" class="grid sm:grid-cols-2 gap-x-6 gap-y-2 text-sm"></ul>
      </div>
    )}

    <CalendarCard cal={cal} linkTitle={false} lang={lang} />
  </main>

  <CalendarEventsScript />
</Layout>
