---
import Layout from '../layouts/Layout.astro';
import data from '../data/competitive-intel-2026.json';
import gtmTableCsv from '../data/gtm-positioning.csv?raw';

const pricingRows = data.pricingComparison.flagship;
const competitors = data.competitors;
const benchmarks = data.benchmarkComparison;

const parseCsvLine = (line: string) => {
  const cells: string[] = [];
  let current = '';
  let inQuotes = false;

  for (let i = 0; i < line.length; i += 1) {
    const char = line[i];
    const next = line[i + 1];

    if (char === '"') {
      if (inQuotes && next === '"') {
        current += '"';
        i += 1;
      } else {
        inQuotes = !inQuotes;
      }
      continue;
    }

    if (char === ',' && !inQuotes) {
      cells.push(current);
      current = '';
      continue;
    }

    current += char;
  }

  cells.push(current);
  return cells;
};

const csvLines = gtmTableCsv.trim().split(/\r?\n/);
const headers = parseCsvLine(csvLines.shift() ?? '');
const tableRows = csvLines.map((line) => {
  const cells = parseCsvLine(line);
  return headers.reduce<Record<string, string>>((acc, header, index) => {
    acc[header] = cells[index] ?? '';
    return acc;
  }, {});
});

const tableColumns = [
  'Feature/Capability',
  'OpenAI ChatGPT/AgentKit Approach',
  'Anthropic Claude/MCP Apps Approach',
  'Competitive Positioning Strategy',
  'Key Enterprise Advantage (Inferred)',
  'Source',
];
---

<Layout title="ChatGPT vs Claude War Room" description="OpenAI GTM arsenal to dismantle Claude Plugins — assets, battlecards, and competitive intel. Built for sales teams closing enterprise deals." image="/og-competitive-intel.png" imageAlt="ChatGPT vs Claude Plugin War Room — GTM assets for OpenAI sales teams">
