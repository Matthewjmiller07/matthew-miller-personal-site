                Generate Battlecard
              </button>
              <span id="copilot-status" class="text-xs text-gray-400"></span>
            </div>
            <p id="voice-status" class="text-xs text-cyan-300"></p>
          </div>
        </form>

        <div id="live-suggestions" class="mt-4 hidden rounded-xl border border-cyan-500/30 bg-cyan-500/5 p-4">
