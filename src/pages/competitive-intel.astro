---
import Layout from '../layouts/Layout.astro';
import data from '../data/competitive-intel-2026.json';

const pricingRows = data.pricingComparison.flagship;
const competitors = data.competitors;
const benchmarks = data.benchmarkComparison;
---

<Layout title="AI Competitive Intelligence 2026" description="Interactive competitive intelligence on OpenAI and the field — pricing, benchmarks, corporate developments.">
  <main class="bg-gray-950 min-h-screen text-white">
    <div class="container mx-auto px-4 lg:px-8 py-10 max-w-7xl">

      <!-- Header -->
      <header class="mb-10">
        <div class="flex items-center gap-3 mb-2">
          <span class="text-xs font-bold uppercase tracking-widest text-yellow-400 bg-yellow-400/10 px-3 py-1 rounded-full">Live Intel</span>
          <span class="text-xs text-gray-500">Updated {data.updated}</span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white">AI Competitive Intelligence</h1>
        <p class="mt-3 text-lg text-gray-400 max-w-3xl">Executive-grade analysis of OpenAI and 9 competitors — pricing pressure, benchmark performance, funding, and strategic positioning.</p>
      </header>

      <!-- OpenAI Snapshot -->
      <section class="mb-12 bg-gray-900 rounded-xl border border-gray-800 p-6">
        <div class="flex items-center gap-2 mb-3">
          <span class="w-3 h-3 rounded-full bg-green-400 inline-block"></span>
          <h2 class="text-xl font-bold text-white">OpenAI — Current Position</h2>
        </div>
        <p class="text-gray-300 text-sm leading-relaxed">{data.openai.headline}</p>
        <div class="mt-4 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
          {data.openai.pricing.map((p) => (
            <div class="bg-gray-800 rounded-lg p-3 border border-gray-700">
              <div class="text-xs text-gray-400 font-mono truncate">{p.model}</div>
              <div class="mt-1 text-sm font-bold text-green-400">${p.input} in</div>
              <div class="text-sm text-gray-300">${p.output} out</div>
            </div>
          ))}
        </div>
      </section>

      <!-- Charts Row -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-12">

        <!-- Pricing Chart -->
        <div class="bg-gray-900 rounded-xl border border-gray-800 p-6">
          <h2 class="text-lg font-bold text-white mb-1">Flagship Model Pricing</h2>
          <p class="text-xs text-gray-500 mb-4">Output price per 1M tokens — log scale. Click bars to filter.</p>
          <div class="relative h-72">
            <canvas id="pricingChart"></canvas>
          </div>
        </div>

        <!-- Benchmark Chart -->
        <div class="bg-gray-900 rounded-xl border border-gray-800 p-6">
          <h2 class="text-lg font-bold text-white mb-1">Benchmark Comparison</h2>
          <p class="text-xs text-gray-500 mb-4">MMLU / GPQA Diamond / Coding scores where available.</p>
          <div class="relative h-72">
            <canvas id="benchmarkChart"></canvas>
          </div>
        </div>
      </div>

      <!-- Interactive Pricing Table -->
      <section class="mb-12">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xl font-bold text-white">Pricing Comparison — Flagship Models</h2>
          <div class="flex gap-2">
            <button id="sort-input" class="text-xs px-3 py-1 rounded bg-gray-800 border border-gray-700 hover:border-yellow-400 transition-colors">Sort: Input ↕</button>
            <button id="sort-output" class="text-xs px-3 py-1 rounded bg-gray-800 border border-gray-700 hover:border-yellow-400 transition-colors">Sort: Output ↕</button>
          </div>
        </div>
        <div class="overflow-x-auto rounded-xl border border-gray-800">
          <table class="min-w-full text-sm" id="pricing-table">
            <thead class="bg-gray-900 border-b border-gray-800">
              <tr>
                <th class="text-left p-3 font-semibold text-gray-400">Company</th>
                <th class="text-left p-3 font-semibold text-gray-400">Flagship Model</th>
                <th class="text-right p-3 font-semibold text-gray-400">Input / 1M</th>
                <th class="text-right p-3 font-semibold text-gray-400">Output / 1M</th>
                <th class="text-right p-3 font-semibold text-gray-400">vs. GPT-5.2</th>
              </tr>
            </thead>
            <tbody id="pricing-tbody">
              {pricingRows.map((row) => {
                const vsGPT = row.input === 1.75 ? '—' : row.input < 1.75 ? `${Math.round((1 - row.input/1.75)*100)}% cheaper` : `${Math.round((row.input/1.75 - 1)*100)}% pricier`;
                const vsClass = row.input < 1.75 ? 'text-green-400' : row.input === 1.75 ? 'text-gray-400' : 'text-red-400';
                return (
                  <tr class="border-t border-gray-800 hover:bg-gray-800/50 transition-colors" data-input={row.input} data-output={row.output}>
                    <td class="p-3 font-semibold text-white">{row.company}</td>
                    <td class="p-3 font-mono text-gray-300 text-xs">{row.model}</td>
                    <td class="p-3 text-right text-yellow-300">${row.input}</td>
                    <td class="p-3 text-right text-orange-300">${row.output}</td>
                    <td class={`p-3 text-right text-xs font-semibold ${vsClass}`}>{vsGPT}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Competitor Cards with filter tabs -->
      <section class="mb-12">
        <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
          <h2 class="text-xl font-bold text-white">Competitor Briefs</h2>
          <div class="flex gap-2 flex-wrap" id="threat-filters">
            <button class="filter-btn active text-xs px-3 py-1 rounded-full bg-yellow-400 text-gray-900 font-bold" data-filter="all">All</button>
            <button class="filter-btn text-xs px-3 py-1 rounded-full bg-gray-800 border border-gray-700 hover:border-yellow-400 transition-colors" data-filter="High">High Threat</button>
            <button class="filter-btn text-xs px-3 py-1 rounded-full bg-gray-800 border border-gray-700 hover:border-yellow-400 transition-colors" data-filter="Medium">Medium</button>
            <button class="filter-btn text-xs px-3 py-1 rounded-full bg-gray-800 border border-gray-700 hover:border-yellow-400 transition-colors" data-filter="Partner/Competitor">Partner</button>
          </div>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-5" id="competitor-grid">
          {competitors.map((c) => {
            const threatColor = c.threat === 'High' ? 'text-red-400 border-red-400/30 bg-red-400/5' : c.threat === 'Medium' ? 'text-yellow-400 border-yellow-400/30 bg-yellow-400/5' : 'text-blue-400 border-blue-400/30 bg-blue-400/5';
            return (
              <article class="competitor-card bg-gray-900 rounded-xl border border-gray-800 p-5 hover:border-gray-600 transition-colors" data-threat={c.threat}>
                <div class="flex items-start justify-between gap-2 mb-3">
                  <div>
                    <h3 class="text-lg font-extrabold text-white">{c.name}</h3>
                    <p class="text-xs text-gray-400 mt-0.5 font-mono">{c.flagship_model} · ${c.flagship_input} in / ${c.flagship_output} out</p>
                  </div>
                  <span class={`text-xs font-bold px-2 py-1 rounded-full border shrink-0 ${threatColor}`}>{c.threat}</span>
                </div>
                <p class="text-sm text-gray-300 mb-4 leading-relaxed">{c.headline}</p>

                <details class="group">
                  <summary class="text-xs text-yellow-400 cursor-pointer hover:text-yellow-300 font-semibold select-none">Show details ▸</summary>
                  <div class="mt-3 space-y-3">
                    <div>
                      <div class="text-xs font-bold text-green-400 mb-1">Strengths</div>
                      <ul class="text-xs text-gray-400 space-y-0.5 list-disc pl-4">
                        {c.strengths.map((s) => <li>{s}</li>)}
                      </ul>
                    </div>
                    <div>
                      <div class="text-xs font-bold text-red-400 mb-1">Weaknesses</div>
                      <ul class="text-xs text-gray-400 space-y-0.5 list-disc pl-4">
                        {c.weaknesses.map((w) => <li>{w}</li>)}
                      </ul>
                    </div>
                    <div>
                      <div class="text-xs font-bold text-blue-400 mb-1">Corporate Developments</div>
                      <p class="text-xs text-gray-400 leading-relaxed">{c.corporate_developments}</p>
                    </div>
                    <a href={c.source} target="_blank" rel="noopener noreferrer" class="inline-block text-xs text-blue-400 hover:underline">Source ↗</a>
                  </div>
                </details>
              </article>
            );
          })}
        </div>
      </section>

      <!-- Benchmark Table -->
      <section class="mb-12">
        <h2 class="text-xl font-bold text-white mb-4">Benchmark Scores (where published)</h2>
        <div class="overflow-x-auto rounded-xl border border-gray-800">
          <table class="min-w-full text-sm">
            <thead class="bg-gray-900 border-b border-gray-800">
              <tr>
                <th class="text-left p-3 font-semibold text-gray-400">Company / Model</th>
                <th class="text-right p-3 font-semibold text-gray-400">SWE-bench</th>
                <th class="text-right p-3 font-semibold text-gray-400">MMLU</th>
                <th class="text-right p-3 font-semibold text-gray-400">GPQA Diamond</th>
                <th class="text-right p-3 font-semibold text-gray-400">Coding</th>
              </tr>
            </thead>
            <tbody>
              {benchmarks.map((b) => (
                <tr class="border-t border-gray-800 hover:bg-gray-800/50 transition-colors">
                  <td class="p-3 font-semibold text-white">{b.company}</td>
                  <td class="p-3 text-right text-gray-300">{b.SWE_bench != null ? `${b.SWE_bench}%` : '—'}</td>
                  <td class="p-3 text-right text-gray-300">{b.MMLU != null ? `${b.MMLU}%` : '—'}</td>
                  <td class="p-3 text-right text-gray-300">{b.GPQA != null ? `${b.GPQA}%` : '—'}</td>
                  <td class="p-3 text-right text-gray-300">{b.Coding != null ? `${b.Coding}%` : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

    </div>
  </main>
</Layout>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js" is:inline></script>
<script define:vars={{ pricingRows, benchmarks }}>
  // ── Pricing Bar Chart ──────────────────────────────────────────────
  const pricingCtx = document.getElementById('pricingChart').getContext('2d');
  new Chart(pricingCtx, {
    type: 'bar',
    data: {
      labels: pricingRows.map(r => r.company),
      datasets: [
        {
          label: 'Input ($/1M)',
          data: pricingRows.map(r => r.input),
          backgroundColor: 'rgba(250, 204, 21, 0.7)',
          borderColor: 'rgba(250, 204, 21, 1)',
          borderWidth: 1,
        },
        {
          label: 'Output ($/1M)',
          data: pricingRows.map(r => r.output),
          backgroundColor: 'rgba(251, 146, 60, 0.7)',
          borderColor: 'rgba(251, 146, 60, 1)',
          borderWidth: 1,
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      scales: {
        y: {
          type: 'logarithmic',
          ticks: { color: '#9ca3af', callback: v => `$${v}` },
          grid: { color: '#1f2937' }
        },
        x: {
          ticks: { color: '#9ca3af', maxRotation: 45 },
          grid: { color: '#1f2937' }
        }
      },
      plugins: {
        legend: { labels: { color: '#d1d5db', boxWidth: 12 } },
        tooltip: {
          callbacks: { label: ctx => ` $${ctx.parsed.y} per 1M tokens` }
        }
      }
    }
  });

  // ── Benchmark Grouped Bar Chart ────────────────────────────────────
  const bmCtx = document.getElementById('benchmarkChart').getContext('2d');
  const bmColors = ['#facc15','#f97316','#22d3ee','#a78bfa','#34d399'];
  new Chart(bmCtx, {
    type: 'bar',
    data: {
      labels: ['SWE-bench', 'MMLU', 'GPQA Diamond', 'Coding'],
      datasets: benchmarks.map((b, i) => ({
        label: b.company.split(' ')[0],
        data: [b.SWE_bench, b.MMLU, b.GPQA, b.Coding],
        backgroundColor: bmColors[i] + 'b3',
        borderColor: bmColors[i],
        borderWidth: 1,
      }))
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      scales: {
        y: {
          min: 0, max: 100,
          ticks: { color: '#9ca3af', callback: v => `${v}%` },
          grid: { color: '#1f2937' }
        },
        x: {
          ticks: { color: '#9ca3af' },
          grid: { color: '#1f2937' }
        }
      },
      plugins: {
        legend: { labels: { color: '#d1d5db', boxWidth: 12 } },
        tooltip: {
          callbacks: { label: ctx => ctx.parsed.y != null ? ` ${ctx.parsed.y}%` : ' N/A' }
        }
      }
    }
  });

  // ── Pricing table sort ─────────────────────────────────────────────
  function sortTable(col) {
    const tbody = document.getElementById('pricing-tbody');
    const rows = Array.from(tbody.querySelectorAll('tr'));
    rows.sort((a, b) => parseFloat(a.dataset[col]) - parseFloat(b.dataset[col]));
    rows.forEach(r => tbody.appendChild(r));
  }
  document.getElementById('sort-input').addEventListener('click', () => sortTable('input'));
  document.getElementById('sort-output').addEventListener('click', () => sortTable('output'));

  // ── Competitor card filter ─────────────────────────────────────────
  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn').forEach(b => {
        b.classList.remove('active', 'bg-yellow-400', 'text-gray-900', 'font-bold');
        b.classList.add('bg-gray-800', 'border', 'border-gray-700');
      });
      btn.classList.add('active', 'bg-yellow-400', 'text-gray-900', 'font-bold');
      btn.classList.remove('bg-gray-800', 'border', 'border-gray-700');

      const filter = btn.dataset.filter;
      document.querySelectorAll('.competitor-card').forEach(card => {
        card.style.display = (filter === 'all' || card.dataset.threat === filter) ? '' : 'none';
      });
    });
  });
</script>
