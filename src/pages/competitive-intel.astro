      <!-- Live GTM Copilot -->
      <section class="bg-gray-900 rounded-xl border border-gray-800 p-6">
        <div class="flex flex-col gap-2 mb-4">
          <h2 class="text-2xl font-bold text-white">Live GTM Sales Copilot</h2>
