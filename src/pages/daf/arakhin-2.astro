---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Who Does “Everyone” Add? — Daf Yomi Game: Arakhin 2"
  description="Arakhin 2: the Gemara keeps asking what the word “everyone” (hakol) quietly adds. Spotlight the hidden person in ten mishnayot, then fit the three mentions of “his offering” for the Rabbis and Rabbi Yehuda."
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@300;400;700;900&display=swap" />

  <style is:global>
    :root { --night:#101820; --card:#18242f; --line:#32465a; --ink:#ece8df; --mist:#9fb2c4; --gold:#f0c35c; --grass:#8fd0a0; --red:#ee8470; }
    .frank { font-family: 'Frank Ruhl Libre', serif; }
    .he { font-family: 'Frank Ruhl Libre', serif; direction: rtl; }
    .t-ink { color: var(--ink) !important; } .t-mist { color: var(--mist) !important; } .t-gold { color: var(--gold) !important; }
    a.ref { color: var(--gold) !important; text-decoration: underline; text-underline-offset: 2px; }
    .stn { border-top: 1px solid var(--line); padding: 2.25rem 0; }
    .card { background: var(--card); border: 1px solid var(--line); border-radius: .6rem; padding: 1rem; }
    .btn { border: 1px solid var(--line); border-radius: .4rem; padding: .5rem .8rem; font-size: .92rem; line-height: 1.4; background: transparent; color: var(--ink) !important; cursor: pointer; }
    .btn:hover:not(:disabled) { background: var(--card); }
    .btn:disabled { cursor: default; }
    .btn.on { border-color: var(--gold); box-shadow: inset 0 0 0 1px var(--gold); background: var(--card); }
    button:focus-visible, a:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
    .note { border-inline-start: 3px solid var(--line); padding: .3rem .8rem; font-size: .93rem; line-height: 1.65; margin-top: .75rem; color: var(--ink) !important; }
    .note.ok { border-color: var(--grass); } .note.no { border-color: var(--red); } .note.tk { border-color: var(--gold); }
    .stage { position: relative; display: grid; grid-template-columns: repeat(auto-fit, minmax(7.2rem, 1fr)); gap: .5rem; padding: 1rem; border-radius: .8rem; background: radial-gradient(ellipse at 50% 0%, #26394b 0%, #0b1118 75%); border: 1px solid var(--line); }
    .fig { display: flex; flex-direction: column; align-items: center; gap: .25rem; padding: .6rem .3rem; border-radius: .6rem; border: 1px solid transparent; background: rgba(0,0,0,.35); color: var(--mist) !important; cursor: pointer; font-size: .78rem; line-height: 1.25; text-align: center; transition: filter .3s, transform .3s, border-color .3s; filter: brightness(.55); }
    .fig .e { font-size: 2rem; }
    .fig:hover:not(:disabled), .fig:focus-visible { filter: brightness(1.1); transform: translateY(-3px); border-color: var(--gold); }
    .fig.ok { filter: brightness(1.4); border-color: var(--grass); background: #17321f; transform: translateY(-4px) scale(1.04); }
    .fig.no { filter: brightness(.8); border-color: var(--red); background: #3b1d18; }
    .fig.dim { filter: brightness(.35); }
    .slots { display: grid; grid-template-columns: repeat(3, 1fr); gap: .5rem; }
    .slot { min-height: 4.4rem; border: 2px dashed var(--line); border-radius: .5rem; padding: .4rem; font-size: .82rem; color: var(--ink) !important; background: transparent; text-align: start; cursor: pointer; }
    .slot.full { border-style: solid; border-color: var(--gold); background: var(--card); }
    .slot.ok { border-color: var(--grass); background: #17321f; } .slot.no { border-color: var(--red); background: #3b1d18; }
    .slot b { display: block; font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; color: var(--mist) !important; }
    .tok { display: inline-block; margin: .15rem; }
    .tok[disabled] { opacity: .3; }
    .bar { height: .45rem; border-radius: 1rem; background: var(--line); overflow: hidden; }
    .bar > i { display: block; height: 100%; background: var(--gold); transition: width .4s; }
    @media (prefers-reduced-motion: reduce) { .fig, .bar > i { transition: none; } }
    @media (max-width: 520px) { .slots { grid-template-columns: 1fr; } }
  </style>

  <main class="frank max-w-3xl mx-auto px-4 py-8" style="background:var(--night)">
    <p class="text-sm"><a class="ref" href="/daf/">← Daf Yomi games</a></p>
    <h1 class="text-4xl font-black !text-amber-300 mt-2">🔦 Who Does “Everyone” Add?</h1>
    <p class="he text-xl t-mist mt-1">ערכין ב׳</p>
    <p class="t-ink mt-4 leading-relaxed">
      The first mishna of Arakhin opens: <i>“Everyone [<span class="he">הכל</span>] takes vows of valuation…”</i>
      The Gemara can't help itself: a Torah that says “everyone” must mean <i>someone</i> extra. So it asks, again and again, in mishna after mishna:
      <b>what does “everyone” add?</b> (<a class="ref" href="https://www.sefaria.org/Arakhin.2a.4" target="_blank" rel="noopener">2a:4</a>)
      Two rounds: shine the spotlight on the hidden person, then fit the three mentions of “his offering” for the Rabbis and Rabbi Yehuda.
    </p>

    <section class="stn" id="spot">
      <h2 class="text-2xl font-bold !text-amber-300">Round 1 · The Spotlight</h2>
      <p class="t-mist text-sm mt-1">Read the clause, then tap the person the word “everyone” quietly adds.</p>
      <div class="bar mt-3" aria-hidden="true"><i id="prog" style="width:0%"></i></div>
      <div class="card mt-3">
        <p class="text-xs t-mist" id="rsrc"></p>
        <p class="text-lg t-ink mt-1" id="rclause"></p>
      </div>
      <div class="stage mt-3" id="stage" role="group" aria-label="Who does the word everyone add?"></div>
      <div id="rout" aria-live="polite"></div>
      <div class="row mt-3"><button class="btn" id="next" hidden>Next clause →</button></div>
      <p class="mt-3 t-ink" id="score"></p>
    </section>

    <section class="stn" id="offering">
      <h2 class="text-2xl font-bold !text-amber-300">Round 2 · Three Times “His Offering”</h2>
      <p class="t-ink mt-2 leading-relaxed">
        The Torah says “<span class="he">קרבנו</span>” (his offering) three times in the laws of laying hands on an offering
        (<a class="ref" href="https://www.sefaria.org/Leviticus.3.2" target="_blank" rel="noopener">Lev. 3:2, 7, 12</a>).
        Each mention teaches one thing. Pick a sage, then tap a teaching and a slot to fill it (<a class="ref" href="https://www.sefaria.org/Arakhin.2a.16-17" target="_blank" rel="noopener">2a:16–17</a>).
      </p>
      <div class="row mt-3" id="sages" role="group" aria-label="Choose a position"></div>
      <div class="mt-3" id="toks"></div>
      <div class="slots mt-3" id="slots"></div>
      <div class="row mt-3"><button class="btn" id="check">Check my slots</button><button class="btn" id="reset">Clear</button></div>
      <div id="sout" aria-live="polite"></div>

      <h3 class="text-lg font-bold !text-amber-300 mt-6">And the doubled “<span class="he">המר ימיר</span>” (hamer yamir)</h3>
      <p class="t-ink mt-1">With the sage still selected: what does the doubled verb in the law of substitution
        (<a class="ref" href="https://www.sefaria.org/Leviticus.27.10" target="_blank" rel="noopener">Lev. 27:10</a>) teach?</p>
      <div class="row mt-2" id="ham"></div>
      <div id="hout" aria-live="polite"></div>
    </section>

    <section class="stn" id="learn">
      <h2 class="text-2xl font-bold !text-amber-300">Learn the real daf</h2>
      <ul class="t-ink mt-3 space-y-2 list-disc ps-5">
        <li><a class="ref" href="https://www.sefaria.org/Arakhin.2a" target="_blank" rel="noopener">Arakhin 2a</a> and <a class="ref" href="https://www.sefaria.org/Arakhin.2b" target="_blank" rel="noopener">2b</a> on Sefaria</li>
        <li><a class="ref" href="https://www.sefaria.org/Rashi_on_Arakhin.2a.1" target="_blank" rel="noopener">Rashi</a> (33 comments), <a class="ref" href="https://www.sefaria.org/Tosafot_on_Arakhin.2a.1" target="_blank" rel="noopener">Tosafot</a> (32), <a class="ref" href="https://www.sefaria.org/Rabbeinu_Gershom_on_Arakhin.2a.1" target="_blank" rel="noopener">Rabbeinu Gershom</a> (30) and <a class="ref" href="https://www.sefaria.org/Steinsaltz_on_Arakhin.2a.1" target="_blank" rel="noopener">Steinsaltz</a> (35)</li>
        <li>The valuation chapter: <a class="ref" href="https://www.sefaria.org/Leviticus.27.2" target="_blank" rel="noopener">Lev. 27:2–8</a></li>
        <li>The mishnayot the Gemara quotes: <a class="ref" href="https://www.sefaria.org/Mishnah_Sukkah.3.15" target="_blank" rel="noopener">Sukka</a>, <a class="ref" href="https://www.sefaria.org/Mishnah_Chagigah.1.1" target="_blank" rel="noopener">Ḥagiga 1:1</a>, <a class="ref" href="https://www.sefaria.org/Mishnah_Pesachim.8.8" target="_blank" rel="noopener">Pesaḥim 8:8</a>, <a class="ref" href="https://www.sefaria.org/Mishnah_Rosh_Hashanah.3.8" target="_blank" rel="noopener">Rosh HaShana</a></li>
      </ul>
    </section>
  </main>

  <script is:inline>
    const R = (r, l) => `<a class="ref" href="https://www.sefaria.org/${r}" target="_blank" rel="noopener">${l}</a>`;
    const $ = (id) => document.getElementById(id);

    /* ---------- Round 1 ---------- */
    const F = {
      mufla: ['🧒', 'Discriminating minor, year before majority'],
      ugly: ['🤕', 'Repulsive man, or one with boils'],
      infant: ['👶', 'Baby under a month old'],
      heir: ['🧑‍🦱', 'An heir'],
      night: ['🌙', 'Minor who doesn\'t need his mother at night'],
      lulav: ['🌿', 'Minor who knows how to wave the lulav'],
      wrap: ['🧣', 'Minor who knows how to wrap himself in a garment'],
      clean: ['🧼', 'Minor who can guard tefillin\'s cleanliness'],
      half: ['⛓️', 'Half-slave, half-freeman'],
      train: ['📯', 'Minor at the age of training in mitzvot'],
      woman: ['👩', 'A woman'],
      gentile: ['🌍', 'A gentile'],
      lame: ['🦽', 'Man lame on day one, healed on day two'],
    };
    const ROUNDS = [
      { id: 'mufla', clause: '“Everyone takes vows of valuation…”', src: 'Arakhin 2a:4', ref: 'Arakhin.2a.4', opts: ['mufla', 'woman', 'gentile', 'infant'],
        why: 'The Gemara: “everyone” adds a <b>discriminating minor on the brink of adulthood</b> (<i>mufla samukh le\'ish</i>), the year before majority.' },
      { id: 'ugly', clause: '“…and everyone is valuated.”', src: 'Arakhin 2a:5–7', ref: 'Arakhin.2a.5-7', opts: ['ugly', 'infant', 'heir', 'half'],
        why: 'It adds a <b>repulsive man and one afflicted with boils</b>, who have no market value. You might have thought that someone not subject to “assessment” escapes valuation too, but the verse says “persons [<i>nefashot</i>]”: anyone with any life in him is valuated.' },
      { id: 'infant', clause: '“…and everyone is the object of a vow.”', src: 'Arakhin 2a:9–10', ref: 'Arakhin.2a.9-10', opts: ['infant', 'gentile', 'woman', 'train'],
        why: 'The Gemara rules out the cases the mishna already names (tumtum, androginos, deaf-mute, imbecile, minor, gentile), and lands on a <b>child under a month old</b>: not valuated, yet subject to assessment, spelled out later in the tractate.' },
      { id: 'heir', clause: 'Menaḥot 93a: “Everyone who brings an offering lays hands on the animal.”', src: 'Arakhin 2a:11', ref: 'Arakhin.2a.11', opts: ['heir', 'mufla', 'night', 'woman'],
        why: 'It adds an <b>heir</b>, who lays hands on the offering of the deceased, against Rabbi Yehuda, who says an heir doesn\'t.' },
      { id: 'night', clause: 'A baraita: “Everyone is obligated in the mitzva of sukka.”', src: 'Arakhin 2b:4', ref: 'Arakhin.2b.4', opts: ['night', 'lulav', 'clean', 'ugly'],
        why: 'It adds a <b>minor who doesn\'t need his mother</b> when he wakes at night (Sukka 28a).' },
      { id: 'lulav', clause: 'A baraita: “Everyone is obligated in the mitzva of lulav.”', src: 'Arakhin 2b:5', ref: 'Arakhin.2b.5', opts: ['lulav', 'night', 'wrap', 'half'],
        why: 'It adds a <b>minor who knows how to wave the lulav</b> (Sukka 42a).' },
      { id: 'wrap', clause: 'A baraita: “Everyone is obligated in the mitzva of tzitzit.”', src: 'Arakhin 2b:6', ref: 'Arakhin.2b.6', opts: ['wrap', 'clean', 'lulav', 'train'],
        why: 'It adds a <b>minor who knows how to wrap himself in a garment</b>.' },
      { id: 'clean', clause: 'A baraita: “Everyone is obligated in the mitzva of tefillin.”', src: 'Arakhin 2b:7', ref: 'Arakhin.2b.7', opts: ['clean', 'wrap', 'night', 'infant'],
        why: 'It adds a <b>minor who knows how to keep tefillin clean</b>: his father buys him a pair.' },
      { id: 'half', clause: 'Ḥagiga 2a: “Everyone is obligated in the mitzva of appearing [at the Temple].”', src: 'Arakhin 2b:8–16', ref: 'Arakhin.2b.8-16', opts: ['half', 'gentile', 'mufla', 'heir'],
        why: 'Its first answer: a <b>half-slave, half-freeman</b>. (Ravina, who exempts him, says instead: a man lame on day one who is healed on day two, or a one-eyed man. The Gemara then reconciles Ravina with the “initial” and “ultimate” versions of the mishna in Pesaḥim 88a.)' },
      { id: 'train', clause: 'A baraita: “Everyone is obligated to sound the shofar.”', src: 'Arakhin 2b:17', ref: 'Arakhin.2b.17', opts: ['train', 'half', 'ugly', 'wrap'],
        why: 'It adds a <b>minor at the age of training</b>: we don\'t stop minors from sounding the shofar on Rosh HaShana (Rosh HaShana 32b).' },
    ];
    const rnd = (a, seed) => { const x = [...a]; let s = seed; for (let i = x.length - 1; i > 0; i--) { s = (s * 9301 + 49297) % 233280; const j = s % (i + 1); [x[i], x[j]] = [x[j], x[i]]; } return x; };
    let ri = 0, hits = 0, answered = false;
    function renderRound() {
      const r = ROUNDS[ri]; answered = false;
      $('rsrc').textContent = `Clause ${ri + 1} of ${ROUNDS.length} · ${r.src}`;
      $('rclause').textContent = r.clause;
      $('prog').style.width = (ri / ROUNDS.length * 100) + '%';
      $('stage').innerHTML = rnd(r.opts, ri * 7 + 3).map((k) => `<button class="fig" data-k="${k}"><span class="e" aria-hidden="true">${F[k][0]}</span>${F[k][1]}</button>`).join('');
      $('rout').innerHTML = ''; $('next').hidden = true;
      document.querySelectorAll('#stage .fig').forEach((b) => b.addEventListener('click', () => pick(b)));
    }
    function pick(b) {
      if (answered) return; answered = true;
      const r = ROUNDS[ri], good = b.dataset.k === r.id;
      if (good) hits++;
      document.querySelectorAll('#stage .fig').forEach((x) => { x.disabled = true; if (x.dataset.k === r.id) x.classList.add('ok'); else if (x === b) x.classList.add('no'); else x.classList.add('dim'); });
      $('rout').innerHTML = `<div class="note ${good ? 'ok' : 'no'}">${good ? 'Lit up. ' : 'Not quite. '}${r.why} (${R(r.ref, r.src)})</div>`;
      $('next').hidden = false; $('next').textContent = ri === ROUNDS.length - 1 ? 'Finish' : 'Next clause →';
    }
    $('next').addEventListener('click', () => {
      if (ri < ROUNDS.length - 1) { ri++; renderRound(); }
      else {
        $('prog').style.width = '100%';
        $('stage').innerHTML = ''; $('rout').innerHTML = ''; $('next').hidden = true; $('rclause').textContent = 'The word “everyone” is never empty.'; $('rsrc').textContent = 'Done';
        $('score').textContent = `You spotted ${hits} of ${ROUNDS.length}. On this daf, the Gemara's habit is to treat every “everyone” as a clue.`;
      }
    });
    renderRound();

    /* ---------- Round 2 ---------- */
    const SAGES = { rabbis: 'The Rabbis', yehuda: 'Rabbi Yehuda' };
    const TOKS = {
      gentile: 'Not a gentile\'s offering', other: 'Not another person\'s offering', partners: 'All partners lay hands',
      heir: 'Not an inherited offering (heir)', both: 'Gentile and another person (one mention for both)',
    };
    const SOLS = {
      rabbis: [['gentile', 'other', 'partners']],
      yehuda: [['gentile', 'other', 'heir'], ['both', 'heir', 'partners']],
    };
    const HAM = {
      rabbis: { heir: 'The doubled verb includes an <b>heir</b> as one who can substitute (and, from it, an heir lays hands).', woman: 'A woman can substitute, derived from the extra “and” in “and if he shall substitute.”' },
      yehuda: { heir: 'Rabbi Yehuda says an heir cannot substitute (he derives that from the heir not laying hands).', woman: 'The doubled verb includes a <b>woman</b>. He does not expound the extra “and” at all.' },
    };
    const HAM_ANS = { rabbis: 'heir', yehuda: 'woman' };
    let sage = 'rabbis', slots = [null, null, null], sel = null;
    function tokAvail() {
      const base = sage === 'rabbis' ? ['gentile', 'other', 'partners', 'heir', 'both'] : ['gentile', 'other', 'partners', 'heir', 'both'];
      return base;
    }
    function renderSages() {
      $('sages').innerHTML = Object.entries(SAGES).map(([k, v]) => `<button class="btn ${k === sage ? 'on' : ''}" aria-pressed="${k === sage}" data-k="${k}">${v}</button>`).join('');
      document.querySelectorAll('#sages button').forEach((b) => b.addEventListener('click', () => { sage = b.dataset.k; slots = [null, null, null]; sel = null; $('sout').innerHTML = ''; $('hout').innerHTML = ''; renderSages(); renderSlots(); renderHam(); }));
    }
    function renderSlots() {
      $('toks').innerHTML = tokAvail().map((k) => `<button class="btn tok ${sel === k ? 'on' : ''}" data-k="${k}" ${slots.includes(k) ? 'disabled' : ''}>${TOKS[k]}</button>`).join('');
      $('slots').innerHTML = slots.map((k, i) => `<button class="slot ${k ? 'full' : ''}" data-i="${i}"><b>“his offering” #${i + 1}</b>${k ? TOKS[k] : '<span class="t-mist">empty: tap to fill</span>'}</button>`).join('');
      document.querySelectorAll('#toks button').forEach((b) => b.addEventListener('click', () => { sel = b.dataset.k; renderSlots(); }));
      document.querySelectorAll('#slots button').forEach((b) => b.addEventListener('click', () => {
        const i = +b.dataset.i;
        if (slots[i] && !sel) { slots[i] = null; } else if (sel) { slots[i] = sel; sel = null; }
        renderSlots();
      }));
    }
    $('reset').addEventListener('click', () => { slots = [null, null, null]; sel = null; $('sout').innerHTML = ''; renderSlots(); });
    $('check').addEventListener('click', () => {
      if (slots.includes(null)) { $('sout').innerHTML = '<div class="note tk">Fill all three mentions first.</div>'; return; }
      const mine = [...slots].sort().join(), ok = SOLS[sage].some((s) => [...s].sort().join() === mine);
      document.querySelectorAll('#slots .slot').forEach((s) => s.classList.add(ok ? 'ok' : 'no'));
      const exp = sage === 'rabbis'
        ? 'For the Rabbis the three mentions exclude a gentile, exclude another person\'s offering, and include every co-owner of a joint offering. The heir isn\'t excluded: they learn the heir from “hamer yamir” (below).'
        : 'Rabbi Yehuda has two ways: (1) one of the partners lays hands on behalf of all, so the spare mention excludes an <b>heir</b>; or (2) the gentile and other-person exclusions share <b>one</b> mention, leaving one for the heir and one for the partners.';
      $('sout').innerHTML = `<div class="note ${ok ? 'ok' : 'no'}">${ok ? 'Fits. ' : 'Doesn\'t fit. '}${exp} (${R('Arakhin.2a.16-17', '2a:16–17')}, ${R('Arakhin.2b.1', '2b:1')})</div>`;
    });
    function renderHam() {
      $('ham').innerHTML = ['heir', 'woman'].map((k) => `<button class="btn" data-k="${k}">${k === 'heir' ? 'Includes an heir' : 'Includes a woman'}</button>`).join('');
      document.querySelectorAll('#ham button').forEach((b) => b.addEventListener('click', () => {
        const good = b.dataset.k === HAM_ANS[sage];
        $('hout').innerHTML = `<div class="note ${good ? 'ok' : 'no'}">${good ? 'Yes. ' : 'Not for this sage. '}${HAM[sage][good ? b.dataset.k : HAM_ANS[sage]]}
          ${sage === 'rabbis' ? 'Then they get a woman from the extra “and.”' : 'Then the heir is out for substitution, matching his rule for laying hands.'} (${R('Arakhin.2a.15', '2a:15')}, ${R('Arakhin.2b.2-3', '2b:2–3')})</div>`;
      }));
    }
    renderSages(); renderSlots(); renderHam();
  </script>
</Layout>
