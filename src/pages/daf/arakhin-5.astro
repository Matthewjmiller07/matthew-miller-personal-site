---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="The Two Gates — Daf Yomi Game: Arakhin 5"
  description="Arakhin 5: send gentiles, minors and a tumtum through the Temple's two gates (who may vow, who may be valued) as Rabbi Meir and Rabbi Yehuda, then rule on vows made for naught."
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@300;400;700;900&display=swap" />

  <style is:global>
    :root { --night:#15130f; --card:#252017; --line:#4d4430; --ink:#f1ebdc; --mist:#c2b697; --gold:#f0c35c; --grass:#8fd0a0; --red:#ee8470; }
    .frank { font-family: 'Frank Ruhl Libre', serif; }
    .he { font-family: 'Frank Ruhl Libre', serif; direction: rtl; }
    .t-ink { color: var(--ink) !important; } .t-mist { color: var(--mist) !important; } .t-gold { color: var(--gold) !important; }
    a.ref { color: var(--gold) !important; text-decoration: underline; text-underline-offset: 2px; }
    .stn { border-top: 1px solid var(--line); padding: 2.25rem 0; }
    .card { background: var(--card); border: 1px solid var(--line); border-radius: .6rem; padding: 1rem; }
    .btn { border: 1px solid var(--line); border-radius: .4rem; padding: .5rem .8rem; font-size: .95rem; line-height: 1.4; background: transparent; color: var(--ink) !important; cursor: pointer; text-align: start; }
    .btn:hover:not(:disabled) { background: var(--card); }
    .btn:disabled { cursor: default; opacity: .8; }
    .btn.ok { border-color: var(--grass); background: #17321f; } .btn.no { border-color: var(--red); background: #3b1d18; }
    button:focus-visible, a:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
    .note { border-inline-start: 3px solid var(--line); padding: .3rem .8rem; font-size: .93rem; line-height: 1.65; margin-top: .75rem; color: var(--ink) !important; }
    .note.ok { border-color: var(--grass); } .note.no { border-color: var(--red); }
    .row { display: flex; flex-wrap: wrap; gap: .5rem; }
    .counter { border: 1px solid var(--line); border-radius: .8rem; padding: 1rem; background: radial-gradient(ellipse at 50% 0%, #3b311c 0%, #100e0a 80%); }
    .till { display:flex; gap:.25rem; flex-wrap:wrap; min-height:1.8rem; font-size:1.3rem; margin-top:.5rem; }
    .vw { font-size: 1.7rem; line-height: 2.4; }
    .vw button { font-family: inherit; font-size: inherit; background: transparent; border: 1px dashed var(--line); border-radius: .35rem; padding: 0 .4rem; margin: 0 .15rem; color: var(--ink) !important; cursor: pointer; }
    .vw button:hover:not(:disabled) { border-color: var(--gold); }
    .vw button.ok { border-color: var(--grass); background: #17321f; } .vw button.no { border-color: var(--red); background: #3b1d18; }
    .bar { height: .45rem; border-radius: 1rem; background: var(--line); overflow: hidden; }
    .bar > i { display: block; height: 100%; background: var(--gold); transition: width .4s; }
    @keyframes drop { from { transform: translateY(-14px); opacity: 0; } to { transform: none; opacity: 1; } }
    .till span { animation: drop .25s ease-out; }
    @media (prefers-reduced-motion: reduce) { .bar > i { transition: none; } .till span { animation: none; } }
    .sw { display:inline-flex; border:1px solid var(--line); border-radius:.4rem; overflow:hidden; }
    .sw button { background:transparent; border:0; padding:.4rem .8rem; color:var(--ink) !important; cursor:pointer; font-family:inherit; font-size:.95rem; }
    .sw button[aria-pressed="true"] { background:#4d4430; color:var(--gold) !important; }
    .gate { display:grid; grid-template-columns: 1fr auto auto; gap:.5rem; align-items:center; padding:.6rem 0; border-top:1px solid var(--line); }
    .tg { border:1px solid var(--line); border-radius:.4rem; padding:.4rem .7rem; background:transparent; color:var(--mist) !important; cursor:pointer; font-size:.9rem; min-width:7.5rem; }
    .tg[aria-pressed="true"] { border-color:var(--gold); color:var(--gold) !important; background:#3b311c; }
    .tg.ok { border-color:var(--grass); background:#17321f; color:var(--ink) !important; } .tg.no { border-color:var(--red); background:#3b1d18; color:var(--ink) !important; }
  </style>

  <main class="frank max-w-3xl mx-auto px-4 py-8" style="background:var(--night)">
    <p class="text-sm"><a class="ref" href="/daf/">← Daf Yomi games</a></p>
    <h1 class="text-4xl font-black !text-amber-300 mt-2">🚪 The Two Gates</h1>
    <p class="he text-xl t-mist mt-1">ערכין ה׳</p>
    <p class="t-ink mt-4 leading-relaxed">
      Valuations have two doors: <b>vowing</b> a valuation, and <b>being valued</b>. Arakhin 5 asks who passes each — Rabbi Meir and Rabbi Yehuda read
      <a class="ref" href="https://www.sefaria.org/Leviticus.27.2" target="_blank" rel="noopener">Lev. 27:2</a> in opposite ways for the gentile —
      and then asks whether a vow that makes no sense is simply void, or whether a person “does not speak for naught.”
    </p>

    <section class="stn" id="gates">
      <h2 class="text-2xl font-bold !text-amber-300">Round 1 · Open the gates</h2>
      <p class="t-mist text-sm mt-1">Per the mishna (<a class="ref" href="https://www.sefaria.org/Arakhin.2a" target="_blank" rel="noopener">2a</a>, <a class="ref" href="https://www.sefaria.org/Arakhin.5b.7" target="_blank" rel="noopener">5b</a>) set each person: can they <b>vow</b> a valuation? can they <b>be valued</b>? The gentile depends on whom you ask.</p>
      <div class="mt-3 row items-center"><span class="t-ink text-sm">Gentile according to:</span>
        <span class="sw" role="group" aria-label="Opinion"><button id="om" aria-pressed="true">Rabbi Meir</button><button id="oy" aria-pressed="false">Rabbi Yehuda</button></span></div>
      <div class="card mt-3" id="grid"></div>
      <div class="mt-3 row"><button class="btn" id="gcheck">Check the gates</button></div>
      <div id="gfb" aria-live="polite"></div>
    </section>

    <section class="stn" id="naught">
      <h2 class="text-2xl font-bold !text-amber-300">Round 2 · Speaking for naught</h2>
      <p class="t-mist text-sm mt-1">Rabbi Meir: a person <i>does not</i> speak for naught, so a strange vow is read as a pledge of the item's assessment (market value). The Rabbis: he does, so it is void. Decide what each vow owes.</p>
      <div class="mt-3 row items-center"><span class="t-ink text-sm">Where it applies, rule like:</span>
        <span class="sw" role="group" aria-label="Opinion for round 2"><button id="nm" aria-pressed="true">Rabbi Meir</button><button id="nr" aria-pressed="false">The Rabbis</button></span></div>
      <div id="nlist" class="card mt-3"></div>
      <div id="nfb" aria-live="polite"></div>
    </section>

    <section class="stn" id="rava">
      <h2 class="text-2xl font-bold !text-amber-300">Round 3 · Rava's verdicts</h2>
      <p class="t-mist text-sm mt-1">Rava (<a class="ref" href="https://www.sefaria.org/Arakhin.5b.14" target="_blank" rel="noopener">5b:14</a>): each rabbi has a ruling and a reason. Mark each as reasonable or not.</p>
      <div id="rlist" class="card mt-3"></div>
      <div id="rfb" aria-live="polite"></div>
      <div class="card mt-3">
        <p class="t-ink">Yehuda lets gentiles vow, yet Ezra 4:3 says “You have nothing to do with us.” How does Rava finally answer?</p>
        <div class="mt-2" id="eopts" style="display:grid;gap:.5rem"></div>
        <div id="efb" aria-live="polite"></div>
      </div>
    </section>

    <section class="stn" id="learn">
      <h2 class="text-2xl font-bold !text-amber-300">Learn the real daf</h2>
      <ul class="t-ink leading-relaxed mt-2 list-disc ps-5">
        <li><a class="ref" href="https://www.sefaria.org/Arakhin.5a" target="_blank" rel="noopener">Arakhin 5a</a> and <a class="ref" href="https://www.sefaria.org/Arakhin.5b" target="_blank" rel="noopener">5b</a> on Sefaria</li>
        <li><a class="ref" href="https://www.sefaria.org/Rashi_on_Arakhin.5a" target="_blank" rel="noopener">Rashi on 5a</a> · <a class="ref" href="https://www.sefaria.org/Rashi_on_Arakhin.5b" target="_blank" rel="noopener">Rashi on 5b</a></li>
        <li><a class="ref" href="https://www.sefaria.org/Rabbeinu_Gershom_on_Arakhin.5a" target="_blank" rel="noopener">Rabbeinu Gershom</a> · <a class="ref" href="https://www.sefaria.org/Steinsaltz_on_Arakhin.5a" target="_blank" rel="noopener">Steinsaltz</a> · <a class="ref" href="https://www.sefaria.org/Leviticus.27" target="_blank" rel="noopener">Leviticus 27</a></li>
      </ul>
      <p class="t-mist text-sm mt-3">The top half of 5a closes the dispute over a consecrated limb (Rava vs Abaye, Rabba's unresolved dilemmas on a head's value, a valuation for the altar, and an ancestral field); this game covers the sugya from the mishna on 5a:16.</p>
    </section>
  </main>

  <script is:inline>
    (function () {
      var $ = function (i) { return document.getElementById(i); };
      var esc = function (s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };

      /* ---------- Round 1 ---------- */
      var P = [
        { n: 'Adult Israelite', v: 1, e: 1, why: 'Passes both gates.' },
        { n: 'Deaf-mute, imbecile, minor', v: 0, e: 1, why: 'Can be vowed about and valued, but cannot vow (mishna, 2a); they lack the presumed competence to commit.' },
        { n: 'Tumtum / hermaphrodite', v: 1, e: 0, why: 'They vow and are vowed about, but are not valued (mishna, 2a).' },
        { n: 'Gentile', g: 1, m: { v: 0, e: 1 }, y: { v: 1, e: 0 }, why: 'Meir: valued, but cannot vow (“a man” adds him to the objects; “children of Israel” excludes him from the vowers). Yehuda: the reverse. Both agree he can vow assessments and be the subject of one.' }
      ];
      var op = 'm', pick = P.map(function () { return { v: null, e: null }; }), checked = false;
      function tgt(p) { return p.g ? p[op] : p; }
      function drawGrid() {
        $('grid').innerHTML = P.map(function (p, i) {
          function b(k, lab) { var s = pick[i][k]; return '<button class="tg" data-i="' + i + '" data-k="' + k + '" aria-pressed="' + (s === 1) + '">' + lab + ': ' + (s === null ? '?' : s ? 'open' : 'shut') + '</button>'; }
          return '<div class="gate"><span class="t-ink">' + esc(p.n) + '</span>' + b('v', 'Vows') + b('e', 'Valued') + '</div>';
        }).join('');
        [].forEach.call($('grid').querySelectorAll('.tg'), function (el) {
          el.onclick = function () { var i = +el.dataset.i, k = el.dataset.k; pick[i][k] = pick[i][k] === 1 ? 0 : 1; checked = false; $('gfb').innerHTML = ''; drawGrid(); };
        });
      }
      function setOp(o) { op = o; $('om').setAttribute('aria-pressed', o === 'm'); $('oy').setAttribute('aria-pressed', o === 'y'); $('gfb').innerHTML = ''; drawGrid(); }
      $('om').onclick = function () { setOp('m'); }; $('oy').onclick = function () { setOp('y'); };
      $('gcheck').onclick = function () {
        var good = 0, notes = '';
        P.forEach(function (p, i) {
          var t = tgt(p), ok = pick[i].v === t.v && pick[i].e === t.e; if (ok) good++;
          notes += '<li><b>' + esc(p.n) + '</b> — ' + (ok ? '✓ ' : '✗ (should be Vows ' + (t.v ? 'open' : 'shut') + ', Valued ' + (t.e ? 'open' : 'shut') + ') ') + esc(p.why) + '</li>';
        });
        $('gfb').innerHTML = '<div class="note ' + (good === P.length ? 'ok' : 'no') + '"><b>' + good + ' / ' + P.length + '.</b> Flip the opinion switch and set the gentile again.<ul class="list-disc ps-5 mt-1">' + notes + '</ul></div>';
      };
      drawGrid();

      /* ---------- Round 2 ---------- */
      var N = [
        { t: 'A man vows the <b>valuation</b> of a child under one month old.', m: 1, r: 0, ref: 'Arakhin.5a.17',
          why: 'Meir: a person does not speak for naught — he meant the child\'s assessment. The Rabbis: he said nothing. (Meir adds a decree so people do not neglect valuations of a one-month-old.)' },
        { t: 'A man says: “I must give the <b>valuation of this utensil</b>.”', m: 1, r: 0, ref: 'Arakhin.5a.19',
          why: 'Rav (Rav Giddel) rules like Meir: he owes its assessment. The Rabbis hold he speaks for naught here too, since nobody errs about utensils.' },
        { t: 'A man says to the treasury: “I must give the valuation of <b>another person\'s animal</b>.”', m: 1, r: 1, only: 'm', ref: 'Arakhin.5b.3',
          why: 'Rav rules like Meir: he knows he cannot consecrate what is not his, so he owes its assessment. (The Gemara states this only on Meir\'s view.)' },
        { t: 'A man says: “<b>This animal</b> [belonging to another] is consecrated.”', m: 0, r: 0, only: 'm', ref: 'Arakhin.5b.6',
          why: 'Rav Ashi: only if he said “I must give to the treasury.” Saying “this animal is consecrated” shows he meant the animal itself, which he cannot consecrate, so he owes nothing.' }
      ];
      var no = 'm', ans = N.map(function () { return null; });
      function drawN() {
        $('nlist').innerHTML = N.map(function (c, i) {
          var a = ans[i], cls = function (v) { return a === null ? '' : (v === a ? (a === exp(c) ? ' ok' : ' no') : ''); };
          return '<div class="gate" style="grid-template-columns:1fr auto auto"><span class="t-ink">' + c.t + (c.only ? ' <span class="t-mist text-xs">(Meir’s line)</span>' : '') + '</span>' +
            '<button class="tg' + cls(1) + '" data-i="' + i + '" data-v="1">Pays assessment</button><button class="tg' + cls(0) + '" data-i="' + i + '" data-v="0">Owes nothing</button></div>' +
            (a !== null ? '<div class="note ' + (a === exp(c) ? 'ok' : 'no') + '">' + (a === exp(c) ? '✓ ' : '✗ ') + c.why + ' <a class="ref" href="https://www.sefaria.org/' + c.ref + '" target="_blank" rel="noopener">source</a></div>' : '');
        }).join('');
        [].forEach.call($('nlist').querySelectorAll('.tg'), function (el) { el.onclick = function () { ans[+el.dataset.i] = +el.dataset.v; drawN(); score(); }; });
      }
      function exp(c) { return c.only ? c[c.only] : (no === 'm' ? c.m : c.r); }
      function score() {
        if (ans.some(function (a) { return a === null; })) { $('nfb').innerHTML = ''; return; }
        var g = ans.filter(function (a, i) { return a === exp(N[i]); }).length;
        $('nfb').innerHTML = '<div class="note ' + (g === N.length ? 'ok' : 'no') + '"><b>' + g + ' / ' + N.length + '.</b> Switch to the Rabbis to see the first two rulings flip.</div>';
      }
      function setN(o) { no = o; $('nm').setAttribute('aria-pressed', o === 'm'); $('nr').setAttribute('aria-pressed', o === 'r'); ans = N.map(function () { return null; }); $('nfb').innerHTML = ''; drawN(); }
      $('nm').onclick = function () { setN('m'); }; $('nr').onclick = function () { setN('r'); };
      drawN();

      /* ---------- Round 3 ---------- */
      var R = [
        { t: 'Rabbi Meir\'s <b>ruling</b>: gentiles cannot vow valuations.', a: 1, why: 'Reasonable: “You have nothing to do with us to build a house to our God” (Ezra 4:3).' },
        { t: 'Rabbi Meir\'s <b>reason</b>: a deaf-mute, imbecile and minor cannot vow either.', a: 0, why: 'Not reasonable: they lack mental competence; a gentile does not.' },
        { t: 'Rabbi Yehuda\'s <b>reason</b>: a tumtum, though competent, is excluded from being valued — so a gentile can be too.', a: 1, why: 'Reasonable: a competent person, yet the Merciful One excludes him.' },
        { t: 'Rabbi Yehuda\'s <b>ruling</b>: gentiles can vow valuations.', a: 0, why: 'Not reasonable at first: Ezra 4:3 suggests they may contribute nothing to the Temple.' }
      ];
      var ra = R.map(function () { return null; });
      function drawR() {
        $('rlist').innerHTML = R.map(function (c, i) {
          var a = ra[i], cls = function (v) { return a === v ? (a === c.a ? ' ok' : ' no') : ''; };
          return '<div class="gate"><span class="t-ink">' + c.t + '</span><button class="tg' + cls(1) + '" data-i="' + i + '" data-v="1">Reasonable</button><button class="tg' + cls(0) + '" data-i="' + i + '" data-v="0">Not reasonable</button></div>' +
            (a !== null ? '<div class="note ' + (a === c.a ? 'ok' : 'no') + '">' + (a === c.a ? '✓ ' : '✗ ') + c.why + '</div>' : '');
        }).join('');
        [].forEach.call($('rlist').querySelectorAll('.tg'), function (el) { el.onclick = function () { ra[+el.dataset.i] = +el.dataset.v; drawR(); }; });
      }
      drawR();
      var E = [
        { t: 'Their money is buried, never used for the Temple.', a: 0, why: 'That was Avimi\'s answer, and the Gemara rejected it: then no one would be liable for misusing it, yet the baraita says they are.' },
        { t: 'The refusal in Ezra was not about halakha — the people of the land were weakening the builders\' hands (Ezra 4:4).', a: 1, why: 'Correct: Rava says the rebuff was circumstantial, so the gentile\'s valuation goes to Temple maintenance.' },
        { t: 'Only gentiles from Babylonia are excluded.', a: 0, why: 'Not in the Gemara.' }
      ];
      $('eopts').innerHTML = E.map(function (e, i) { return '<button class="btn" data-i="' + i + '">' + esc(e.t) + '</button>'; }).join('');
      [].forEach.call($('eopts').querySelectorAll('.btn'), function (b) {
        b.onclick = function () { var e = E[+b.dataset.i]; b.classList.add(e.a ? 'ok' : 'no'); $('efb').innerHTML = '<div class="note ' + (e.a ? 'ok' : 'no') + '">' + e.why + ' <a class="ref" href="https://www.sefaria.org/Arakhin.5b.20" target="_blank" rel="noopener">5b:20</a></div>'; };
      });
    })();
  </script>
</Layout>
