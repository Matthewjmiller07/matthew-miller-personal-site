---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Your Donkey Is Gone, Tarfon — Daf Yomi Game: Bekhorot 28"
  description="Bekhorot 28: test three readings of the firstborn's thirty days against a baraita, rule on blemishes found after slaughter, write the bill, find the judge's hand, and defend Rabbi Tarfon at Yavne."
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@300;400;700;900&display=swap" />

  <style>
    .frank { font-family: 'Frank Ruhl Libre', serif; }
    .card { background: #151a1e; border: 1px solid #2b3338; border-radius: 1rem; }
    .chip { border: 1px solid #3a444a; border-radius: 0.6rem; padding: 0.45rem 0.75rem; font-size: 0.8rem; transition: background .15s, border-color .15s; }
    .chip:hover { background: #1f272c; }
    .chip[aria-pressed="true"] { background: #3a1f1a; border-color: #b5432f; }
    .chip.ok { background: #1b2e22; border-color: #4f9a6a; }
    .chip.bad { background: #331a18; border-color: #b5432f; }
    .seal { width: 3.2rem; height: 3.2rem; border-radius: 9999px; display: inline-flex; align-items: center; justify-content: center; font-size: .7rem; font-weight: 700; border: 2px dashed #4a555c; transition: transform .25s, background .2s, border-color .2s; }
    .seal.permit { background: #23402c; border: 2px solid #5fae78; transform: rotate(-8deg); }
    .seal.forbid { background: #4a1d17; border: 2px solid #c8513a; transform: rotate(7deg); }
    .marker { transition: transform .7s cubic-bezier(.4,0,.2,1), opacity .3s; }
    .cornea { transition: fill 1.6s ease, opacity 1.6s ease; }
    .strike { text-decoration: line-through; opacity: .55; }
    .route-step { transition: background .2s, border-color .2s; }
    @keyframes stamp { 0% { transform: scale(1.6) rotate(-20deg); opacity: 0; } 100% { transform: scale(1) rotate(-6deg); opacity: 1; } }
    .stamp-in { animation: stamp .45s ease-out both; }
    @media (prefers-reduced-motion: reduce) {
      .marker, .cornea, .seal, .route-step { transition: none; }
      .stamp-in { animation: none; }
    }
    button:focus-visible, input:focus-visible { outline: 2px solid #c9a24a; outline-offset: 2px; }
  </style>

  <main class="min-h-screen bg-[#0d1114] !text-[#e9dcc0]">

    <!-- HERO -->
    <div class="border-b border-[#2b3338] bg-gradient-to-b from-[#1a1f22] to-transparent px-4 pt-10 pb-8 text-center">
      <p class="mb-3 text-xs tracking-[0.22em] !text-[#7c8a90]">
        <a href="/daf" class="transition-colors hover:!text-[#e9dcc0]">daf yomi arcade</a>
        <span class="mx-2 opacity-40">·</span>bekhorot 28<span class="mx-2 opacity-40">·</span>2026-10-16
      </p>
      <h1 class="frank text-4xl font-black tracking-tight sm:text-5xl !text-[#efe3c6]">Your Donkey Is Gone, Tarfon</h1>
      <p class="frank mt-3 text-3xl font-light !text-[#c9a24a]" dir="rtl" lang="he">הָלְכָה חֲמוֹרְךָ טַרְפוֹן</p>
      <p class="mt-1 text-xs italic !text-[#7c8a90]">Rabbi Tarfon, on hearing the Sages of Yavne overrule him · Bekhorot 28b:14</p>
      <p class="mx-auto mt-5 max-w-lg text-sm leading-relaxed !text-[#b9b09a]">
        This daf is about who answers for a wrong ruling. Five stations take you from the shepherd's
        thirty-day deadline to the court at Yavne, where Rabbi Akiva gets Rabbi Tarfon off the hook.
      </p>
      <p class="mt-4 text-xs !text-[#7c8a90]">Score: <span id="score" class="font-bold !text-[#c9a24a]">0</span> / <span id="scoreMax">0</span></p>
    </div>

    <div class="mx-auto max-w-2xl space-y-10 px-4 pb-20 pt-8">

      <!-- STATION 1 -->
      <section class="card p-5" aria-labelledby="s1h">
        <p class="text-xs tracking-widest !text-[#c9a24a]">STATION 1 · 28a:5–11</p>
        <h2 id="s1h" class="frank mt-1 text-2xl font-bold !text-[#efe3c6]">The Thirty-Day Clock</h2>
        <p class="mt-2 text-sm leading-relaxed !text-[#b9b09a]">
          The mishna says a firstborn that gets a blemish in its first year may be kept for the whole twelve months,
          and one blemished after its year for thirty days. But does a first-year blemish also earn thirty days after
          the year? Three readings are on the table. One baraita settles it:
        </p>
        <blockquote class="mt-3 rounded-lg border-l-4 border-[#b5432f] bg-[#1b1416] p-3">
          <p class="frank text-lg !text-[#efe3c6]" dir="rtl" lang="he">נוֹלַד לוֹ מוּם בַּחֲמִשָּׁה עָשָׂר יוֹם בְּתוֹךְ שְׁנָתוֹ — מַשְׁלִימִין לוֹ חֲמִשָּׁה עָשָׂר יוֹם אַחַר שְׁנָתוֹ</p>
          <p class="mt-1 text-xs !text-[#b9b09a]">"If it developed a blemish fifteen days before the end of its year, one completes for it fifteen days after its year." (28a:9)</p>
        </blockquote>

        <svg id="clock" viewBox="0 0 600 120" class="mt-4 w-full" role="img" aria-label="Timeline of the firstborn's year with the baraita's deadline">
          <rect x="40" y="50" width="440" height="16" rx="3" fill="#2b3338" />
          <rect x="480" y="50" width="54" height="16" rx="3" fill="#3a2a1c" />
          <text x="40" y="44" fill="#7c8a90" font-size="11">birth</text>
          <text x="480" y="44" fill="#c9a24a" font-size="11" text-anchor="middle">end of year</text>
          <line x1="480" y1="46" x2="480" y2="72" stroke="#c9a24a" stroke-width="2" />
          <text x="534" y="44" fill="#7c8a90" font-size="10" text-anchor="middle">+30</text>
          <line x1="534" y1="48" x2="534" y2="70" stroke="#7c8a90" stroke-dasharray="2 2" />
          <g id="blemishPin"><circle cx="462" cy="58" r="6" fill="#b5432f" /><text x="462" y="90" fill="#e08a74" font-size="10" text-anchor="middle">blemish</text></g>
          <g id="baraitaPin"><polygon points="498,72 492,84 504,84" fill="#efe3c6" /><text x="498" y="100" fill="#efe3c6" font-size="10" text-anchor="middle">baraita: +15</text></g>
          <g id="hypMarkers"></g>
        </svg>

        <div id="hyps" class="mt-4 space-y-3"></div>
        <div id="s1q" class="mt-5 hidden"></div>

        <div id="s1slider" class="mt-6 hidden rounded-xl border border-[#2b3338] bg-[#11161a] p-4">
          <p class="text-xs font-bold !text-[#c9a24a]">Try any blemish day (on the reading the baraita supports)</p>
          <label for="bday" class="mt-2 block text-xs !text-[#b9b09a]">Blemish appears on day <span id="bdayV" class="font-bold !text-[#efe3c6]">350</span> of the animal's life</label>
          <input id="bday" type="range" min="1" max="395" value="350" class="mt-2 w-full accent-[#b5432f]" />
          <p id="bdayOut" class="mt-2 text-sm !text-[#efe3c6]" aria-live="polite"></p>
        </div>
      </section>

      <!-- STATION 2 -->
      <section class="card p-5" aria-labelledby="s2h">
        <p class="text-xs tracking-widest !text-[#c9a24a]">STATION 2 · 28a:12–28b:5</p>
        <h2 id="s2h" class="frank mt-1 text-2xl font-bold !text-[#efe3c6]">The Post-Mortem Table</h2>
        <p class="mt-2 text-sm leading-relaxed !text-[#b9b09a]">
          Someone slaughtered a firstborn first and showed the blemish to an expert afterward. Rabbi Yehuda permits it and Rabbi Meir forbids it.
          Rabba bar bar Ḥana: they argue only about <em>body</em> blemishes. Blemishes on the cornea
          (<span class="frank" dir="rtl" lang="he">דּוּקִּין שֶׁבָּעַיִן</span>) can change after death, so everyone forbids those.
          Press each sage's seal to cycle through <em>permitted</em> and <em>forbidden</em>, then check your ruling.
        </p>

        <div class="mt-4 flex items-center justify-center gap-6">
          <svg viewBox="0 0 220 120" class="w-56" role="img" aria-label="A slaughtered firstborn lamb on the table; its eye clouds over after death">
            <ellipse cx="110" cy="72" rx="68" ry="30" fill="#d9ccb0" />
            <circle cx="52" cy="54" r="24" fill="#e6dbc2" />
            <ellipse cx="38" cy="36" rx="8" ry="13" fill="#cdbf9f" transform="rotate(-30 38 36)" />
            <circle cx="46" cy="52" r="7" fill="#1d2326" />
            <circle id="cornea" class="cornea" cx="46" cy="52" r="5" fill="#3b6c8a" />
            <rect x="80" y="96" width="8" height="18" fill="#cdbf9f" /><rect x="140" y="96" width="8" height="18" fill="#cdbf9f" />
            <rect x="0" y="114" width="220" height="6" fill="#3a2a1c" />
          </svg>
          <button id="eyeBtn" class="chip !text-[#efe3c6]" type="button">Watch the eye after death</button>
        </div>
        <p id="eyeNote" class="mt-2 text-center text-xs !text-[#7c8a90]" aria-live="polite"></p>

        <div id="pm" class="mt-5 space-y-4"></div>
      </section>

      <!-- STATION 3 -->
      <section class="card p-5" aria-labelledby="s3h">
        <p class="text-xs tracking-widest !text-[#c9a24a]">STATION 3 · 28b:6–7</p>
        <h2 id="s3h" class="frank mt-1 text-2xl font-bold !text-[#efe3c6]">The Bill</h2>
        <p class="mt-2 text-sm leading-relaxed !text-[#b9b09a]">
          A non-expert ruled, the firstborn was slaughtered on his word, and now it has to be buried. He pays the kohen from his own pocket.
          But he doesn't pay full value. Set each payment.
        </p>
        <div id="bill" class="mt-4 space-y-4"></div>
        <div id="billQ" class="mt-4 hidden"></div>
      </section>

      <!-- STATION 4 -->
      <section class="card p-5" aria-labelledby="s4h">
        <p class="text-xs tracking-widest !text-[#c9a24a]">STATION 4 · 28b:8–11</p>
        <h2 id="s4h" class="frank mt-1 text-2xl font-bold !text-[#efe3c6]">The Judge's Hand</h2>
        <p class="mt-2 text-sm leading-relaxed !text-[#b9b09a]">
          A judge who errs pays from his own home, unless he was an expert for the court. Isn't that just Rabbi Meir, who holds people
          liable for damage they cause indirectly (<em>garmi</em>)? Rav says no: the mishna is about a judge who did the damage
          <strong>with his own hand</strong>. That's easy when he took money from an innocent man. For each of the mishna's four errors, find the act the Gemara pins on his hand.
        </p>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <div>
            <p class="mb-2 text-xs font-bold !text-[#c9a24a]">The error</p>
            <div id="errs" class="space-y-2"></div>
          </div>
          <div>
            <p class="mb-2 text-xs font-bold !text-[#c9a24a]">What his hand did</p>
            <div id="acts" class="space-y-2"></div>
          </div>
        </div>
        <p id="matchNote" class="mt-3 text-xs !text-[#b9b09a]" aria-live="polite">Pick an error, then the act that matches it.</p>

        <div id="router" class="mt-6 hidden">
          <p class="text-xs font-bold !text-[#c9a24a]">Route the docket</p>
          <p class="mt-1 text-xs !text-[#b9b09a]">Send each judge through the court's gates. At each gate, answer for this case.</p>
          <div id="routeBox" class="mt-3"></div>
        </div>
      </section>

      <!-- STATION 5 -->
      <section class="card p-5" aria-labelledby="s5h">
        <p class="text-xs tracking-widest !text-[#c9a24a]">STATION 5 · 28b:12–16</p>
        <h2 id="s5h" class="frank mt-1 text-2xl font-bold !text-[#efe3c6]">The Cow from Alexandria</h2>
        <div id="story" class="mt-3 space-y-3"></div>
      </section>

      <div id="final" class="hidden rounded-2xl border border-[#c9a24a] bg-[#1d1a12] p-5 text-center">
        <p class="frank text-2xl font-bold !text-[#efe3c6]">The court rises.</p>
        <p id="finalMsg" class="mt-2 text-sm !text-[#b9b09a]"></p>
        <p class="mt-3 text-xs italic !text-[#7c8a90]">The daf ends on a new mishna (28b:17): someone who takes a fee to examine firstborns can't be relied on to permit slaughter, unless he is an expert like Ila in Yavne. That's tomorrow.</p>
      </div>

      <!-- LEARN MORE -->
      <section class="card p-6">
        <h2 class="frank mb-3 text-lg font-bold !text-[#efe3c6]">Learn the real daf</h2>
        <div class="mb-4 flex flex-wrap gap-3">
          <a href="https://www.sefaria.org/Bekhorot.28a" target="_blank" rel="noopener" class="rounded-lg border border-[#2b3338] px-4 py-2 text-xs font-bold !text-[#c9a24a] transition-colors hover:bg-[#1f272c]">Bekhorot 28a on Sefaria ↗</a>
          <a href="https://www.sefaria.org/Bekhorot.28b" target="_blank" rel="noopener" class="rounded-lg border border-[#2b3338] px-4 py-2 text-xs font-bold !text-[#c9a24a] transition-colors hover:bg-[#1f272c]">Bekhorot 28b on Sefaria ↗</a>
          <a href="https://www.sefaria.org/Chullin.54a" target="_blank" rel="noopener" class="rounded-lg border border-[#2b3338] px-4 py-2 text-xs font-bold !text-[#c9a24a] transition-colors hover:bg-[#1f272c]">Chullin 54a: the womb-removed cow is kosher ↗</a>
        </div>
        <p class="mb-2 text-xs font-bold !text-[#7c8a90]">Top commentaries</p>
        <ul class="grid grid-cols-2 gap-x-4 gap-y-1 text-xs sm:grid-cols-3">
          <li><a href="https://www.sefaria.org/Rashi_on_Bekhorot.28b" target="_blank" rel="noopener" class="!text-[#b9b09a] transition-colors hover:!text-[#c9a24a]">Rashi (49) ↗</a></li>
          <li><a href="https://www.sefaria.org/Rabbeinu_Gershom_on_Bekhorot.28a" target="_blank" rel="noopener" class="!text-[#b9b09a] transition-colors hover:!text-[#c9a24a]">Rabbeinu Gershom (39) ↗</a></li>
          <li><a href="https://www.sefaria.org/Steinsaltz_on_Bekhorot.28a" target="_blank" rel="noopener" class="!text-[#b9b09a] transition-colors hover:!text-[#c9a24a]">Steinsaltz (32) ↗</a></li>
          <li><a href="https://www.sefaria.org/Tosafot_on_Bekhorot.28a" target="_blank" rel="noopener" class="!text-[#b9b09a] transition-colors hover:!text-[#c9a24a]">Tosafot (10) ↗</a></li>
          <li><a href="https://www.sefaria.org/Rashash_on_Bekhorot.28a" target="_blank" rel="noopener" class="!text-[#b9b09a] transition-colors hover:!text-[#c9a24a]">Rashash (9) ↗</a></li>
          <li><a href="https://www.sefaria.org/Tur%2C_Yoreh_De'ah.310" target="_blank" rel="noopener" class="!text-[#b9b09a] transition-colors hover:!text-[#c9a24a]">Tur, Yoreh De'ah 310 ↗</a></li>
        </ul>
      </section>

    </div>
  </main>

  <script is:inline>
  (function () {
    var score = 0, max = 0;
    var scoreEl = document.getElementById('score');
    var maxEl = document.getElementById('scoreMax');
    function addMax(n) { max += n; maxEl.textContent = max; }
    function award(n) { score += n; scoreEl.textContent = score; }
    function el(tag, cls, html) { var e = document.createElement(tag); if (cls) e.className = cls; if (html != null) e.innerHTML = html; return e; }
    function sef(ref) { return '<a class="underline decoration-dotted !text-[#c9a24a] hover:!text-[#efe3c6]" target="_blank" rel="noopener" href="https://www.sefaria.org/' + ref.replace(/ /g, '_') + '">' + ref + ' ↗</a>'; }
    var stationsDone = 0;
    function stationDone() {
      stationsDone++;
      if (stationsDone === 5) {
        document.getElementById('final').classList.remove('hidden');
        var pct = Math.round(100 * score / max);
        document.getElementById('finalMsg').textContent = 'You scored ' + score + ' of ' + max + ' (' + pct + '%). ' +
          (pct >= 85 ? 'You can sit on the Yavne bench, and you are exempt from paying.' : pct >= 60 ? 'A solid ruling. Have another look at Rashi before you take the bench.' : 'Go back over the daf. It\'s better to be wrong in a game than with someone\'s cow.');
      }
    }

    // ===== STATION 1: hypotheses vs the baraita =====
    // positions on the SVG: year end x=480, 1.2px/day after
    var POS = { end: 480, p15: 498, p30: 516 };
    var hyps = [
      { id: 'h1', name: 'Twelve months, nothing more', who: 'The mishna read as two separate cases (28a:5)', claim: 'A first-year blemish lets you keep it to the end of the year. Not a day later.', predict: 'end', keep: false,
        why: 'This reading allows nothing after the year, but the baraita gives fifteen more days. Refuted: a first-year blemish can earn time past the year.' },
      { id: 'h2', name: 'Year + thirty days, always', who: 'Rabbi Elazar, second version (28a:10)', claim: '"Year by year" (Deut. 15:20): thirty days count as a year, so every first-year blemish gets thirty days after the year.', predict: 'p30', keep: false,
        why: 'This reading would give the full thirty days after the year. The baraita only completes the thirty: "completing, yes; giving, no." תְּיוּבְתָּא, a conclusive refutation (28a:11).' },
      { id: 'h3', name: 'Thirty days from the blemish', who: 'Rabbi Elazar, first version (28a:9)', claim: 'Count thirty days from when the blemish appeared, even if that runs past the year.', predict: 'p15', keep: true,
        why: 'Fifteen days before the year ends plus fifteen after makes thirty from the blemish. The baraita supports it: מְסַיַּיע לְרַבִּי אֶלְעָזָר.' }
    ];
    var predLabels = { end: 'year-end', p15: '+15 days', p30: '+30 days' };
    var hypsBox = document.getElementById('hyps');
    var markers = document.getElementById('hypMarkers');
    var hypsDone = 0;
    addMax(hyps.length + 1);
    hyps.forEach(function (h, i) {
      var c = el('div', 'rounded-xl border border-[#2b3338] bg-[#11161a] p-3');
      c.innerHTML = '<p class="text-sm font-bold !text-[#efe3c6]">' + (i + 1) + '. ' + h.name + '</p>' +
        '<p class="text-xs italic !text-[#7c8a90]">' + h.who + '</p>' +
        '<p class="mt-1 text-xs !text-[#b9b09a]">' + h.claim + '</p>' +
        '<p class="mt-2 text-xs !text-[#c9a24a]">If this reading is right, when is the deadline for a blemish 15 days before year-end?</p>';
      var row = el('div', 'mt-2 flex flex-wrap gap-2');
      var fb = el('p', 'mt-2 text-xs hidden');
      var tries = 0;
      ['end', 'p15', 'p30'].forEach(function (k) {
        var b = el('button', 'chip !text-[#efe3c6]', predLabels[k]);
        b.type = 'button';
        b.addEventListener('click', function () {
          if (c.dataset.done) return;
          tries++;
          if (k !== h.predict) { b.classList.add('bad'); b.disabled = true; return; }
          b.classList.add('ok'); c.dataset.done = '1';
          if (tries === 1) award(1);
          var colors = { h1: '#7fa7c0', h2: '#e0a24a', h3: '#7fd19a' };
          var g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
          g.setAttribute('class', 'marker');
          var y = 22 - i * 0;
          g.innerHTML = '<line x1="' + POS[h.predict] + '" y1="' + (30 + i * 6) + '" x2="' + POS[h.predict] + '" y2="66" stroke="' + colors[h.id] + '" stroke-width="2"/>' +
            '<circle cx="' + POS[h.predict] + '" cy="' + (30 + i * 6) + '" r="5" fill="' + colors[h.id] + '"/><text x="' + (POS[h.predict] + 8) + '" y="' + (33 + i * 6) + '" fill="' + colors[h.id] + '" font-size="10">' + (i + 1) + '</text>';
          markers.appendChild(g);
          fb.className = 'mt-2 text-xs ' + (h.keep ? '!text-[#7fd19a]' : '!text-[#e08a74]');
          fb.innerHTML = (h.keep ? '✓ Matches the baraita. ' : '✗ Misses the baraita\'s pin. ') + h.why;
          if (!h.keep) c.querySelector('p').classList.add('strike');
          hypsDone++;
          if (hypsDone === hyps.length) showS1Q();
        });
        row.appendChild(b);
      });
      c.appendChild(row); c.appendChild(fb);
      hypsBox.appendChild(c);
    });

    function showS1Q() {
      var q = document.getElementById('s1q');
      q.classList.remove('hidden');
      q.innerHTML = '<p class="text-sm !text-[#efe3c6]">The same fifteen-day baraita appears twice in the Gemara. What does it do to each version of Rabbi Elazar?</p>';
      var opts = [
        { t: 'It supports the first version and refutes the second', ok: true },
        { t: 'It refutes the first version and supports the second', ok: false },
        { t: 'It supports both: they are really the same claim', ok: false }
      ];
      var row = el('div', 'mt-2 flex flex-col gap-2');
      var fb = el('p', 'mt-2 text-xs !text-[#b9b09a]');
      var tries = 0, done = false;
      opts.forEach(function (o) {
        var b = el('button', 'chip text-left !text-[#efe3c6]', o.t); b.type = 'button';
        b.addEventListener('click', function () {
          if (done) return; tries++;
          if (!o.ok) { b.classList.add('bad'); b.disabled = true; return; }
          done = true; b.classList.add('ok'); if (tries === 1) award(1);
          fb.innerHTML = 'Right. "Thirty days from the blemish" is supported (מְסַיַּיע). "Thirty days after the year, from <em>year by year</em>" is refuted (תְּיוּבְתָּא), because the baraita only <em>completes</em> thirty. ' + sef('Bekhorot 28a:9') + ' · ' + sef('Bekhorot 28a:11');
          document.getElementById('s1slider').classList.remove('hidden');
          updSlider(); stationDone();
        });
        row.appendChild(b);
      });
      q.appendChild(row); q.appendChild(fb);
    }
    var bday = document.getElementById('bday');
    function updSlider() {
      var d = +bday.value;
      document.getElementById('bdayV').textContent = d;
      var deadline = Math.max(365, d + 30);
      var after = deadline - 365;
      var txt = d <= 365
        ? 'Blemish in the first year (' + (365 - d) + ' days before year-end): keep it until day ' + deadline + ', ' + (after === 0 ? 'the end of its year, since it already has at least thirty days.' : after + ' days after its year, completing thirty from the blemish.')
