            sel.forEach(function (k) { grid.children[k].classList.add('ok'); });
            fb.className = 'mt-3 text-xs !text-[#7fd19a]';
            fb.innerHTML = '✓ חֲדָא: the womb-removed cow is kosher in an explicit mishna (' + sef('Chullin 54a') + '), and an error in a mishna is reversed. Rashi: if the cow had still been alive the ruling would simply have been withdrawn, so the man who fed it to the dogs caused his own loss. וְעוֹד: even if it had been an error of judgment, which can\'t be withdrawn, "you are an expert for the court, and any expert for the court is exempt from paying." Tarfon keeps his donkey. ' + sef('Bekhorot 28b:16');
            stationDone();
          }
        });
        grid.appendChild(b);
      });
      lock.appendChild(grid); lock.appendChild(fb);
    });
  })();
  </script>
