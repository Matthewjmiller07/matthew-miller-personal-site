    // ===== STATION 4: beit haperas =====
    (function () {
      var COLS = 8, ROWS = 4;
      var field = document.getElementById('field');
      var msg = document.getElementById('fieldMsg');
      var mBlow = document.getElementById('modeBlow'), mRisk = document.getElementById('modeRisk');
      var mode = 'blow';
      var grid, pos, won = false, dead = false, cleanWalk = true, qsShown = false;
      addMax(1);
      mBlow.addEventListener('click', function () { mode = 'blow'; mBlow.setAttribute('aria-pressed', 'true'); mRisk.setAttribute('aria-pressed', 'false'); });
      mRisk.addEventListener('click', function () { mode = 'risk'; mRisk.setAttribute('aria-pressed', 'true'); mBlow.setAttribute('aria-pressed', 'false'); });
      document.getElementById('fieldReset').addEventListener('click', function () { if (!won) newField(); });
      function newField() {
        grid = [];
        for (var r = 0; r < ROWS; r++) { grid.push([]); for (var c = 0; c < COLS; c++) grid[r].push({ dust: c > 0 && c < COLS - 1, bone: false }); }
        var n = 0;
        while (n < 9) {
          var rr = Math.floor(Math.random() * ROWS), cc = 1 + Math.floor(Math.random() * (COLS - 2));
          if (!grid[rr][cc].bone) { grid[rr][cc].bone = true; n++; }
        }
        pos = { r: Math.floor(Math.random() * ROWS), c: 0 };
        dead = false;
        cleanWalk = true;
        msg.textContent = 'The field is covered in ploughed dust. Somewhere under it are bone fragments the size of barley grains.';
        draw();
      }
      function adj(r, c) { return Math.abs(r - pos.r) + Math.abs(c - pos.c) === 1; }
      function draw() {
        field.innerHTML = '';
        for (var r = 0; r < ROWS; r++) for (var c = 0; c < COLS; c++) (function (r, c) {
          var t = grid[r][c];
          var cls = 'tile ' + (t.dust ? 'dust' : 'clear');
          if (!won && adj(r, c)) cls += ' adj';
          if (c === COLS - 1) cls += ' goal';
          var b = el('button', cls, '');
          var content = '';
          if (r === pos.r && c === pos.c) content = '🧔';
          else if (!t.dust && t.bone) content = '🦴';
          else if (c === COLS - 1 && r === 1) content = '🐂';
          b.textContent = content;
          b.setAttribute('aria-label', 'Row ' + (r + 1) + ', column ' + (c + 1) + (t.dust ? ', dust' : t.bone ? ', bone' : ', clear') + (r === pos.r && c === pos.c ? ', kohen here' : ''));
          b.addEventListener('click', function () { act(r, c, b); });
          field.appendChild(b);
        })(r, c);
      }
      function pushBone(r, c) {
        // Rashi: blowing pushes the bone away in front of him (מדחיא מקמיה)
        var opts = [[r - 1, c], [r + 1, c], [r, c + 1], [r, c - 1]].filter(function (p) {
          return p[0] >= 0 && p[0] < ROWS && p[1] > 0 && p[1] < COLS - 1 && !(p[0] === pos.r && p[1] === pos.c) && !grid[p[0]][p[1]].bone;
        });
        grid[r][c].bone = false;
        if (opts.length) { var p = opts[Math.floor(Math.random() * opts.length)]; grid[p[0]][p[1]].bone = true; grid[p[0]][p[1]].dust = false; }
      }
      function act(r, c, btn) {
        if (won || dead || !adj(r, c)) return;
        var t = grid[r][c];
        if (t.dust && mode === 'blow') {
          t.dust = false;
          if (t.bone) { pushBone(r, c); msg.textContent = '💨 A bone was there, and the blowing pushed it out of the way. Rashi: a barley-grain bone makes you impure by touching or carrying, not by being under the same roof, and the blowing moves it before you touch it. Now step.'; }
          else msg.textContent = '💨 Clear. Tap again to step.';
          draw();
          return;
        }
        if (t.dust && mode === 'risk') {
          t.dust = false;
          if (t.bone) {
            cleanWalk = false; dead = true;
            msg.innerHTML = '<span class="!text-[#f0937f]">🦴 Your foot came down on a bone. The kohen is impure from the dead, which a kohen is forbidden to become. Rav only allows crossing the field by blowing first.</span> Press ↺ New field to start again.';
            draw();
            return;
          }
          cleanWalk = false;
          msg.textContent = 'You got away with it, but you stepped without checking. That isn\'t the walk Rav allowed.';
        }
        if (!t.dust && t.bone) { msg.textContent = 'That square has the bone you pushed aside. Go around it.'; return; }
        pos = { r: r, c: c };
        if (c === COLS - 1) {
          won = true;
          if (cleanWalk) award(1);
          msg.innerHTML = (cleanWalk ? '✓ ' : '') + 'The kohen reaches the firstborn having blown his way across. Going through the field was allowed. But Rashi adds that he still can\'t eat teruma tonight: "we check for those offering the Pesach, but not for those eating teruma." ' + sef('Chagigah 25b') + ' That lost teruma is why you owe him food, drink and oil.';
          showQs();
        }
        draw();
      }
      function showQs() {
        if (qsShown) return; qsShown = true;
        var q = document.getElementById('fieldQs');
        q.classList.remove('hidden');
        var left = 2;
        function d() { left--; if (left === 0) stationDone(); }
        mcq(q, 'Rav Yehuda bar Ami adds: a beit haperas that people have trodden into a path is…', ['Still forbidden to a kohen', 'Pure'], 1,
          'בֵּית הַפְּרָס שֶׁנִּידַּשׁ טָהוֹר. Rashi: the only worry in a beit haperas is a barley-grain bone, and no bone that small survives people walking all over it. ' + sef('Bekhorot 29b:1'), d);
        mcq(q, 'The Gemara\'s other answer: how else could a kohen get impure on the job without breaking a prohibition?', ['From other kinds of impurity, which kohanim aren\'t warned against', 'He can\'t, so the mishna must be about a Levite', 'By entering a tent with a corpse in it, if it was urgent'], 0,
          'אִי נָמֵי בִּשְׁאָר טוּמְאוֹת דְּלָא מַזְהַר עֲלַיְיהוּ. A kohen is only forbidden to become impure from the dead, but any impurity stops him eating teruma. ' + sef('Bekhorot 29b:2'), d);
      }
      newField();
    })();

