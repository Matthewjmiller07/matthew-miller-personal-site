---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Buy the Truth, Don't Sell It — Daf Yomi Game: Bekhorot 29"
  description="Bekhorot 29: design Ila's fee so nobody can suspect him, rule on paid judges and paid purification water, pay a carpenter for his idle day, blow your way across a beit haperas, and shop at the suspects' stalls."
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@300;400;700;900&display=swap" />

  <style>
    .frank { font-family: 'Frank Ruhl Libre', serif; }
    .card { background: #18140f; border: 1px solid #3a2f24; border-radius: 1rem; }
    .chip { border: 1px solid #4a3c2e; border-radius: 0.6rem; padding: 0.45rem 0.75rem; font-size: 0.8rem; transition: background .15s, border-color .15s; }
    .chip:hover { background: #251d15; }
    .chip[aria-pressed="true"] { background: #3b2516; border-color: #c7764a; }
    .chip.ok { background: #1c2c1f; border-color: #5f9e6c; }
    .chip.bad { background: #351a14; border-color: #c0503a; }
    .chip:disabled { cursor: default; }
    .needle { transition: transform .6s cubic-bezier(.4,0,.2,1); transform-origin: 120px 120px; }
    .jarwater { transition: fill 1.2s ease; }
    .tile { aspect-ratio: 1; border-radius: .4rem; border: 1px solid #3a2f24; font-size: 1.1rem; display: flex; align-items: center; justify-content: center; transition: background .25s, transform .2s; }
    .tile.dust { background: repeating-linear-gradient(45deg, #5a4630 0 4px, #4d3b28 4px 8px); }
    .tile.clear { background: #2a2118; }
    .tile.adj { outline: 2px dashed #c7764a; outline-offset: -3px; }
    .tile.goal { box-shadow: inset 0 0 0 2px #5f9e6c; }
    @keyframes puff { 0% { transform: scale(1); } 50% { transform: scale(.85); } 100% { transform: scale(1); } }
    .puff { animation: puff .35s ease-out; }
    @keyframes stamp { 0% { transform: scale(1.6) rotate(-20deg); opacity: 0; } 100% { transform: scale(1) rotate(-6deg); opacity: 1; } }
    .stamp-in { animation: stamp .45s ease-out both; }
    @media (prefers-reduced-motion: reduce) {
      .needle, .jarwater, .tile { transition: none; }
      .puff, .stamp-in { animation: none; }
    }
    button:focus-visible, input:focus-visible { outline: 2px solid #e0a46a; outline-offset: 2px; }
  </style>

  <main class="min-h-screen bg-[#100d0a] !text-[#efe6d2]">

    <!-- HERO -->
    <div class="border-b border-[#3a2f24] bg-gradient-to-b from-[#221a12] to-transparent px-4 pt-10 pb-8 text-center">
      <p class="mb-3 text-xs tracking-[0.22em] !text-[#8f7f6a]">
        <a href="/daf" class="transition-colors hover:!text-[#efe6d2]">daf yomi arcade</a>
        <span class="mx-2 opacity-40">·</span>bekhorot 29<span class="mx-2 opacity-40">·</span>2026-10-18
      </p>
      <h1 class="frank text-4xl font-black tracking-tight sm:text-5xl !text-[#f3e9d2]">Buy the Truth, Don't Sell It</h1>
      <p class="frank mt-3 text-3xl font-light !text-[#e0a46a]" dir="rtl" lang="he">אֱמֶת קְנֵה וְאַל תִּמְכֹּר</p>
      <p class="mt-1 text-xs italic !text-[#8f7f6a]">Proverbs 23:23, quoted in the baraita · Bekhorot 29a:8</p>
      <p class="mx-auto mt-5 max-w-lg text-sm leading-relaxed !text-[#c4b59c]">
        This daf is about money and trust. When can a Torah expert be paid, and when does the
        payment ruin the ruling? And what can you buy from someone you don't trust? Five stations,
        from Ila's fee at Yavne to the market stalls of the suspects.
      </p>
      <p class="mt-4 text-xs !text-[#8f7f6a]">Score: <span id="score" class="font-bold !text-[#e0a46a]">0</span> / <span id="scoreMax">0</span></p>
    </div>

    <div class="mx-auto max-w-2xl space-y-10 px-4 pb-20 pt-8">

      <!-- STATION 1 -->
      <section class="card p-5" aria-labelledby="s1h">
        <p class="text-xs tracking-widest !text-[#e0a46a]">STATION 1 · 29a:1–4</p>
        <h2 id="s1h" class="frank mt-1 text-2xl font-bold !text-[#f3e9d2]">Ila's Fee Schedule</h2>
        <p class="mt-2 text-sm leading-relaxed !text-[#c4b59c]">
          An examiner who takes a fee for inspecting firstborns can't normally be trusted. But the Sages of
          Yavne let Ila charge. Write his price list, then set the payment rules so that no one can suspect him.
        </p>

        <div class="mt-4 grid gap-3 sm:grid-cols-2" id="feeBoxes"></div>
        <div id="feeWhy" class="mt-4 hidden"></div>

        <div id="policyWrap" class="mt-6 hidden">
          <p class="text-sm font-bold !text-[#f3e9d2]">When does Ila get paid?</p>
          <p class="text-xs !text-[#8f7f6a]">Turn the rules on and off. The gauge shows what the neighbours will whisper.</p>
          <div class="mt-3 flex flex-col items-center gap-4 sm:flex-row sm:items-start">
            <svg viewBox="0 0 240 140" class="w-56 shrink-0" role="img" aria-label="Suspicion gauge">
              <path d="M20 120 A100 100 0 0 1 220 120" fill="none" stroke="#3a2f24" stroke-width="18" />
              <path d="M20 120 A100 100 0 0 1 80 28" fill="none" stroke="#3f7a4d" stroke-width="18" />
              <path d="M160 28 A100 100 0 0 1 220 120" fill="none" stroke="#a5422f" stroke-width="18" />
              <g id="needle" class="needle" style="transform: rotate(0deg)">
                <line x1="120" y1="120" x2="120" y2="34" stroke="#efe6d2" stroke-width="4" stroke-linecap="round" />
              </g>
              <circle cx="120" cy="120" r="8" fill="#e0a46a" />
              <text x="22" y="138" font-size="10" fill="#8f7f6a">trusted</text>
              <text x="178" y="138" font-size="10" fill="#8f7f6a">suspect</text>
            </svg>
            <div class="w-full space-y-2" id="policyToggles"></div>
          </div>
          <p id="policyMsg" class="mt-3 rounded-lg border border-[#3a2f24] bg-[#14100c] p-3 text-xs leading-relaxed !text-[#c4b59c]"></p>
          <button id="policySubmit" class="chip mt-3 font-bold !text-[#e0a46a]">Seal the ordinance</button>
        </div>
      </section>

      <!-- STATION 2 -->
      <section class="card p-5" aria-labelledby="s2h">
        <p class="text-xs tracking-widest !text-[#e0a46a]">STATION 2 · 29a:5–11</p>
        <h2 id="s2h" class="frank mt-1 text-2xl font-bold !text-[#f3e9d2]">Paid For, and Void</h2>
        <p class="mt-2 text-sm leading-relaxed !text-[#c4b59c]">
          The mishna: a paid judge's rulings are void, a paid witness's testimony is void, and paid
          purification water is just cave water. Rule on each case. Watch the jar of red-heifer water.
        </p>
        <div class="mt-4 flex gap-4">
          <svg viewBox="0 0 80 120" class="w-16 shrink-0 sm:w-20" role="img" aria-label="Jar of purification water">
            <path d="M22 10 h36 v10 c10 6 16 18 16 34 v46 c0 8 -6 14 -14 14 h-40 c-8 0 -14 -6 -14 -14 v-46 c0 -16 6 -28 16 -34 z" fill="#2a2118" stroke="#8f7f6a" stroke-width="2" />
            <path id="jarWater" class="jarwater" d="M8 60 h64 v40 c0 8 -6 14 -14 14 h-36 c-8 0 -14 -6 -14 -14 z" fill="#5f8fc0" />
            <text id="jarLabel" x="40" y="92" text-anchor="middle" font-size="9" fill="#efe6d2">mei ḥatat</text>
          </svg>
          <div class="w-full" id="voidCard"></div>
        </div>
        <p id="voidProgress" class="mt-3 text-xs !text-[#8f7f6a]"></p>
      </section>

      <!-- STATION 3 -->
      <section class="card p-5" aria-labelledby="s3h">
        <p class="text-xs tracking-widest !text-[#e0a46a]">STATION 3 · 29a:6, 29b:3</p>
        <h2 id="s3h" class="frank mt-1 text-2xl font-bold !text-[#f3e9d2]">Not a Wage, but Something</h2>
        <p class="mt-2 text-sm leading-relaxed !text-[#c4b59c]">
          The expert may not take a fee, but you can't make him lose out either. Make three visitors whole.
        </p>
        <div id="s3" class="mt-4 space-y-5"></div>
      </section>

      <!-- STATION 4 -->
      <section class="card p-5" aria-labelledby="s4h">
        <p class="text-xs tracking-widest !text-[#e0a46a]">STATION 4 · 29a:12–29b:2</p>
        <h2 id="s4h" class="frank mt-1 text-2xl font-bold !text-[#f3e9d2]">Blow and Walk</h2>
        <p class="mt-2 text-sm leading-relaxed !text-[#c4b59c]">
          The Gemara asks how a kohen became impure on the way to examine a firstborn, since a kohen may not
          make himself impure. Answer: he crossed a <span class="italic">beit haperas</span>, a field where a
          grave was ploughed up and a bone the size of a barley grain could be anywhere. That ban is only
          rabbinic, and Rav says <span class="frank" dir="rtl" lang="he">מְנַפֵּחַ אָדָם בֵּית הַפְּרָס וְהוֹלֵךְ</span>:
          blow on the dust ahead of you, then step.
        </p>
        <p class="mt-2 text-xs !text-[#8f7f6a]">
          Get the kohen 🧔 to the firstborn 🐂 on the far side. Tap a dashed square next to him: 💨 blows on it, and then 👣 steps onto it. Pick "Step without blowing" if you want to take your chances.
        </p>
        <div class="mt-3 flex flex-wrap gap-2">
          <button id="modeBlow" class="chip" aria-pressed="true">💨 Blow, then step</button>
          <button id="modeRisk" class="chip" aria-pressed="false">Step without blowing</button>
          <button id="fieldReset" class="chip">↺ New field</button>
        </div>
        <div id="field" class="mt-3 grid gap-1" style="grid-template-columns: repeat(8, minmax(0, 1fr));" role="grid" aria-label="Beit haperas field"></div>
        <p id="fieldMsg" class="mt-3 text-xs leading-relaxed !text-[#c4b59c]" aria-live="polite"></p>
        <div id="fieldQs" class="mt-4 hidden space-y-4"></div>
      </section>

      <!-- STATION 5 -->
      <section class="card p-5" aria-labelledby="s5h">
        <p class="text-xs tracking-widest !text-[#e0a46a]">STATION 5 · 29b:4–14</p>
        <h2 id="s5h" class="frank mt-1 text-2xl font-bold !text-[#f3e9d2]">The Suspects' Market</h2>
        <p class="mt-2 text-sm leading-relaxed !text-[#c4b59c]">
          Three sellers are suspected of three kinds of cheating. Go down the row: buy or pass on each item.
          The rule of thumb: would he have bothered putting this much work into something forbidden?
        </p>
        <div id="stalls" class="mt-4 space-y-6"></div>
        <div id="hideWrap" class="mt-6 hidden"></div>
      </section>

      <div id="final" class="hidden rounded-2xl border border-[#c7764a] bg-[#1d1610] p-6 text-center">
        <p class="frank text-2xl font-bold !text-[#f3e9d2]">The market closes.</p>
        <p id="finalMsg" class="mt-2 text-sm !text-[#c4b59c]"></p>
        <p class="mt-3 text-xs italic !text-[#7f705c]">The daf breaks off mid-story (29b:15): "There was a certain butcher who was suspected of selling…" The rest is on 30a, tomorrow.</p>
      </div>

      <!-- LEARN MORE -->
      <section class="card p-6">
        <h2 class="frank mb-3 text-lg font-bold !text-[#f3e9d2]">Learn the real daf</h2>
        <div class="mb-4 flex flex-wrap gap-3">
          <a href="https://www.sefaria.org/Bekhorot.29a" target="_blank" rel="noopener" class="rounded-lg border border-[#3a2f24] px-4 py-2 text-xs font-bold !text-[#e0a46a] transition-colors hover:bg-[#251d15]">Bekhorot 29a on Sefaria ↗</a>
          <a href="https://www.sefaria.org/Bekhorot.29b" target="_blank" rel="noopener" class="rounded-lg border border-[#3a2f24] px-4 py-2 text-xs font-bold !text-[#e0a46a] transition-colors hover:bg-[#251d15]">Bekhorot 29b on Sefaria ↗</a>
          <a href="https://www.sefaria.org/Mishnah_Bekhorot.4" target="_blank" rel="noopener" class="rounded-lg border border-[#3a2f24] px-4 py-2 text-xs font-bold !text-[#e0a46a] transition-colors hover:bg-[#251d15]">Mishnah Bekhorot 4 ↗</a>
          <a href="https://www.sefaria.org/Chagigah.25b" target="_blank" rel="noopener" class="rounded-lg border border-[#3a2f24] px-4 py-2 text-xs font-bold !text-[#e0a46a] transition-colors hover:bg-[#251d15]">Chagigah 25b: checking a beit haperas ↗</a>
        </div>
        <p class="mb-2 text-xs font-bold !text-[#8f7f6a]">Top commentaries</p>
        <ul class="grid grid-cols-2 gap-x-4 gap-y-1 text-xs sm:grid-cols-3">
          <li><a href="https://www.sefaria.org/Rashi_on_Bekhorot.29a" target="_blank" rel="noopener" class="!text-[#c4b59c] transition-colors hover:!text-[#e0a46a]">Rashi (47) ↗</a></li>
          <li><a href="https://www.sefaria.org/Rabbeinu_Gershom_on_Bekhorot.29a" target="_blank" rel="noopener" class="!text-[#c4b59c] transition-colors hover:!text-[#e0a46a]">Rabbeinu Gershom (30) ↗</a></li>
          <li><a href="https://www.sefaria.org/Steinsaltz_on_Bekhorot.29a" target="_blank" rel="noopener" class="!text-[#c4b59c] transition-colors hover:!text-[#e0a46a]">Steinsaltz (28) ↗</a></li>
          <li><a href="https://www.sefaria.org/Rashash_on_Bekhorot.29a" target="_blank" rel="noopener" class="!text-[#c4b59c] transition-colors hover:!text-[#e0a46a]">Rashash (8) ↗</a></li>
          <li><a href="https://www.sefaria.org/Tosafot_on_Bekhorot.29a" target="_blank" rel="noopener" class="!text-[#c4b59c] transition-colors hover:!text-[#e0a46a]">Tosafot (7) ↗</a></li>
          <li><a href="https://www.sefaria.org/Tur%2C_Choshen_Mishpat.9" target="_blank" rel="noopener" class="!text-[#c4b59c] transition-colors hover:!text-[#e0a46a]">Tur, Choshen Mishpat 9 ↗</a></li>
        </ul>
      </section>

    </div>
  </main>

  <script is:inline>
  (function () {
    var score = 0, max = 0;
    var scoreEl = document.getElementById('score');
    var maxEl = document.getElementById('scoreMax');
    function addMax(n) { max += n; maxEl.textContent = max; }
    function award(n) { score += n; scoreEl.textContent = score; }
    function el(tag, cls, html) { var e = document.createElement(tag); if (cls) e.className = cls; if (html != null) e.innerHTML = html; return e; }
    function sef(ref) { return '<a class="underline decoration-dotted !text-[#e0a46a] hover:!text-[#f3e9d2]" target="_blank" rel="noopener" href="https://www.sefaria.org/' + ref.replace(/ /g, '_') + '">' + ref + ' ↗</a>'; }
    var OK = 'mt-2 text-xs leading-relaxed !text-[#8fd19e]';
    var BAD = 'mt-2 text-xs leading-relaxed !text-[#f0937f]';
    var stationsDone = 0;
    function stationDone() {
      stationsDone++;
      if (stationsDone === 5) {
        document.getElementById('final').classList.remove('hidden');
        var pct = Math.round(100 * score / max);
        document.getElementById('finalMsg').textContent = 'You scored ' + score + ' of ' + max + ' (' + pct + '%). ' +
          (pct >= 85 ? 'Yavne would let you examine firstborns, and you would only charge once.' : pct >= 60 ? 'Decent shopping. Go over the mishnayot once more before your next trip to market.' : 'Go back over the daf. Learn it for free if you can, and pay if you have to.');
      }
    }

    // A multiple-choice question. First try scores 1 point.
    function mcq(parent, q, opts, correctIdx, okText, onDone) {
      var box = el('div', '');
      box.appendChild(el('p', 'text-sm font-bold !text-[#f3e9d2]', q));
      var row = el('div', 'mt-2 flex flex-col gap-2');
      var fb = el('p', 'hidden');
      var tries = 0, done = false;
      addMax(1);
      opts.forEach(function (o, i) {
        var b = el('button', 'chip text-left !text-[#efe6d2]', o);
        b.addEventListener('click', function () {
          if (done) return;
          tries++;
          if (i === correctIdx) {
            done = true;
            if (tries === 1) award(1);
            b.classList.add('ok');
            Array.prototype.forEach.call(row.children, function (c) { c.disabled = true; });
            fb.className = OK; fb.innerHTML = '✓ ' + okText;
            if (onDone) onDone();
          } else {
            b.classList.add('bad');
            fb.className = BAD; fb.textContent = 'Not that one. Try again.';
          }
        });
        row.appendChild(b);
      });
      box.appendChild(row); box.appendChild(fb);
      parent.appendChild(box);
      return box;
    }

    // ===== STATION 1: Ila's fee =====
    (function () {
      var boxes = document.getElementById('feeBoxes');
      var animals = [
        { key: 'small', label: '🐑 Small animal (lamb or kid)', target: 4 },
        { key: 'large', label: '🐂 Large animal (calf)', target: 6 }
      ];
      var vals = { small: 1, large: 1 };
      var set = { small: false, large: false };
      var tries = { small: 0, large: 0 };
      addMax(2);
      animals.forEach(function (a) {
        var c = el('div', 'rounded-xl border border-[#3a2f24] bg-[#14100c] p-3');
        c.appendChild(el('p', 'text-sm font-bold !text-[#f3e9d2]', a.label));
        var coins = el('div', 'my-2 flex min-h-[2rem] flex-wrap gap-1');
        var ctr = el('div', 'flex items-center gap-2');
        var minus = el('button', 'chip !text-[#efe6d2]', '−');
        var num = el('span', 'w-20 text-center text-sm !text-[#e0a46a]');
        var plus = el('button', 'chip !text-[#efe6d2]', '+');
        var go = el('button', 'chip font-bold !text-[#e0a46a]', 'Set fee');
        minus.setAttribute('aria-label', 'One issar less'); plus.setAttribute('aria-label', 'One issar more');
        var fb = el('p', 'hidden');
        function draw() {
          num.textContent = vals[a.key] + ' issar';
          coins.innerHTML = '';
          for (var i = 0; i < vals[a.key]; i++) coins.appendChild(el('span', 'inline-block h-6 w-6 rounded-full border border-[#a07a3a] bg-[#7a5a28] text-center text-[10px] leading-6 !text-[#f3e9d2]', 'א'));
        }
        minus.addEventListener('click', function () { if (!set[a.key] && vals[a.key] > 1) { vals[a.key]--; draw(); } });
        plus.addEventListener('click', function () { if (!set[a.key] && vals[a.key] < 10) { vals[a.key]++; draw(); } });
        go.addEventListener('click', function () {
          if (set[a.key]) return;
          tries[a.key]++;
          if (vals[a.key] === a.target) {
            set[a.key] = true;
            if (tries[a.key] === 1) award(1);
            fb.className = OK;
            fb.innerHTML = '✓ ' + (a.key === 'small' ? 'אַרְבַּע אִיסָּרוֹת לִבְהֵמָה דַּקָּה: four issar for a small animal.' : 'וְשִׁשָּׁה לְגַסָּה: six for a large one.') + ' ' + sef('Bekhorot 29a:1');
            go.disabled = true; minus.disabled = true; plus.disabled = true;
            if (set.small && set.large) showWhy();
          } else {
            fb.className = BAD;
            fb.textContent = vals[a.key] < a.target ? 'Yavne allowed him more than that.' : 'Too much. Yavne capped it lower.';
          }
        });
        ctr.appendChild(minus); ctr.appendChild(num); ctr.appendChild(plus); ctr.appendChild(go);
        c.appendChild(coins); c.appendChild(ctr); c.appendChild(fb);
        boxes.appendChild(c);
        draw();
      });
      function showWhy() {
        var w = document.getElementById('feeWhy');
        w.classList.remove('hidden');
        mcq(w, 'Why does the calf cost two issar more?', [
          'A calf is worth more, so the fee is a share of its value',
          'Examining a large animal for blemishes is more work',
          'The examiner gets to eat more of a large firstborn'
        ], 1, 'הַאי טְרַח בֵּיהּ, וְהַאי לָא טְרַח בֵּיהּ: checking a large animal takes real effort, and a small one doesn\'t. The fee pays for work, not value. ' + sef('Bekhorot 29a:2'), function () {
          document.getElementById('policyWrap').classList.remove('hidden');
        });
      }

      // policy gauge
      var rules = [
        { key: 'blem', label: 'Paid when he finds a blemish (the animal may be eaten)', on: true },
        { key: 'tam', label: 'Paid when he finds it unblemished', on: false },
        { key: 'twice', label: 'Paid again when the same animal comes back for another look', on: false }
      ];
      var state = { blem: true, tam: false, twice: false };
      var tg = document.getElementById('policyToggles');
      var msg = document.getElementById('policyMsg');
      var needle = document.getElementById('needle');
      rules.forEach(function (r) {
        var b = el('button', 'chip w-full text-left !text-[#efe6d2]', '');
        b.setAttribute('aria-pressed', r.on ? 'true' : 'false');
        function lbl() { b.innerHTML = (state[r.key] ? '☑ ' : '☐ ') + r.label; }
        lbl();
        b.addEventListener('click', function () {
          if (sealed) return;
          state[r.key] = !state[r.key];
          b.setAttribute('aria-pressed', state[r.key] ? 'true' : 'false');
          lbl(); evalPolicy();
        });
        tg.appendChild(b);
      });
      var sealed = false, policyTries = 0;
      addMax(2);
      function evalPolicy() {
        var s = state, level, text;
        if (!s.blem && !s.tam) { level = 10; text = 'No fee at all. That\'s fine for anyone else, but Yavne specifically allowed Ila a fee. Give him one.'; }
        else if (s.blem && !s.tam) { level = 90; text = '"He only gets paid when he says blemished, so he calls them all blemished." People will say the animal he permitted was really unblemished and he declared it blemished for his fee. (29a:3)'; }
        else if (!s.blem && s.tam) { level = 80; text = 'Now the payout points the other way: he only earns when he calls an animal unblemished, which gives him a reason to say it.'; }
        else if (s.twice) { level = 70; text = '"He says unblemished now so he can charge again next time." If a second look pays, he has a reason to call a blemished animal unblemished today. (29a:4)'; }
        else { level = 0; text = 'He gets paid the same whatever he finds, and only once per animal. He gains nothing by getting it wrong, and the neighbours have nothing to say.'; }
        needle.style.transform = 'rotate(' + (-80 + level * 1.6) + 'deg)';
        msg.textContent = text;
        return level;
      }
      evalPolicy();
      var sub = document.getElementById('policySubmit');
      sub.addEventListener('click', function () {
