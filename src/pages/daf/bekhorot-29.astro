              } else {
                b.classList.add('bad');
                fb.className = BAD; fb.textContent = o[1] ? 'You can\'t trust this from him.' : 'This one is fine to buy. Ask yourself whether he would have put that much work into a forbidden item.';
              }
            });
            btns.appendChild(b);
          });
          top.appendChild(btns);
          row.appendChild(top); row.appendChild(fb);
          list.appendChild(row);
        });
        c.appendChild(list);
        root.appendChild(c);
      });

      function showHide() {
        var w = document.getElementById('hideWrap');
        w.classList.remove('hidden');
        w.appendChild(el('p', 'text-sm font-bold !text-[#f3e9d2]', 'Rabbi Eliezer\'s eye: "בֵּי עַכְבָּרִים מִידָּע יְדִיעַ", you can tell where mice have been.'));
        w.appendChild(el('p', 'mt-1 text-xs !text-[#c4b59c]', 'The seller hands you two hides, each with a piece missing, and says mice got both. One is telling the truth. Which one was cut with a knife?'));
        var row = el('div', 'mt-3 grid grid-cols-2 gap-3');
        // A: ragged mouse bites; B: clean knife cut
        var hideA = '<svg viewBox="0 0 120 100" class="w-full"><path d="M10 15 Q60 0 110 15 L105 85 Q60 100 15 85 Z" fill="#8a5e3a" stroke="#5a3a20" stroke-width="2"/><path d="M70 70 q4 -6 8 -2 q3 -7 9 -3 q4 -5 8 1 q2 6 -3 9 q4 5 -2 9 q-5 3 -9 -1 q-5 4 -9 -1 q-6 -2 -2 -12 z" fill="#14100c"/></svg>';
        var hideB = '<svg viewBox="0 0 120 100" class="w-full"><path d="M10 15 Q60 0 110 15 L105 85 Q60 100 15 85 Z" fill="#8a5e3a" stroke="#5a3a20" stroke-width="2"/><path d="M68 62 L96 62 L96 90 L68 90 Z" fill="#14100c"/></svg>';
        var fb = el('p', 'hidden'), tries = 0, done = false;
        addMax(1);
        [[hideA, false, 'Hide A'], [hideB, true, 'Hide B']].forEach(function (h) {
          var b = el('button', 'chip flex flex-col items-center !text-[#efe6d2]', h[0] + '<span class="mt-1 text-xs">' + h[2] + '</span>');
          b.addEventListener('click', function () {
            if (done) return;
            tries++;
            if (h[1]) {
              done = true; if (tries === 1) award(1);
              b.classList.add('ok');
              fb.className = OK;
              fb.innerHTML = '✓ Straight edges and square corners: that\'s a knife, not mice. Rashi: he cuts away the male parts so the hide looks female, and when asked "what is this cut?" he says "mice ate it." The first tanna doesn\'t trust you to spot it, so he forbids even female hides. Rabbi Eliezer thinks anyone can tell. ' + sef('Bekhorot 29b:8');
              stationDone();
            } else { b.classList.add('bad'); fb.className = BAD; fb.textContent = 'Those ragged little nibbles look like real mice. Look at the other one.'; }
          });
          row.appendChild(b);
        });
        w.appendChild(row); w.appendChild(fb);
      }
    })();
  })();
  </script>
</Layout>
