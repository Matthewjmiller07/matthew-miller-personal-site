---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Say It in My Name — Daf Yomi Game: Bekhorot 31"
  description="Bekhorot 31: open the door for the returning ḥaver, inspect your own animals without a conflict of interest, choose market or home for blemished offerings, fold tithe meat into the price of its horns, and build the citation chains that make a scholar's lips move in the grave."
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@300;400;700;900&display=swap" />

  <style>
    .frank { font-family: 'Frank Ruhl Libre', serif; }
    .card { background: #17111a; border: 1px solid #3a2a3f; border-radius: 1rem; }
    .chip { border: 1px solid #4b3752; border-radius: 0.6rem; padding: 0.45rem 0.75rem; font-size: 0.8rem; transition: background .15s, border-color .15s, transform .15s; }
    .chip:hover:not(:disabled) { background: #251a2b; }
    .chip[aria-pressed="true"] { background: #3a1f3f; border-color: #b46fc0; }
    .chip.ok { background: #1b2b1f; border-color: #5f9e6c; }
    .chip.bad { background: #351a1d; border-color: #c0503a; }
    .chip:disabled { cursor: default; opacity: .85; }
    .door { width: 100%; min-height: 5.5rem; border-radius: .7rem .7rem .2rem .2rem; border: 2px solid #5a4262; background: linear-gradient(#2b1d31, #1e1523); transition: background .25s, border-color .25s; position: relative; overflow: hidden; }
    .door[aria-pressed="true"] { background: linear-gradient(#e7c27a22, #e7c27a08); border-color: #e7c27a; }
    .door.ok { box-shadow: 0 0 0 2px #5f9e6c; }
    .door.bad { box-shadow: 0 0 0 2px #c0503a; }
    .gauge-fill { transition: width .7s cubic-bezier(.4,0,.2,1), background .4s; }
    .beam { transition: transform .8s cubic-bezier(.4,0,.2,1); transform-origin: 150px 40px; }
    .tile { border: 1px solid #5a4262; border-radius: 999px; padding: .4rem .8rem; font-size: .8rem; background: #211727; transition: background .15s, transform .15s; }
    .tile:hover:not(:disabled) { background: #2f2036; }
    .tile.used { opacity: .25; }
    .tile.shake { animation: shake .3s; }
    @keyframes shake { 25% { transform: translateX(-4px); } 75% { transform: translateX(4px); } }
    .lip-top, .lip-bot { transition: transform .25s ease-in-out; transform-box: fill-box; }
    .speaking .lip-top { animation: lipT .5s ease-in-out 6 alternate; }
    .speaking .lip-bot { animation: lipB .5s ease-in-out 6 alternate; }
    @keyframes lipT { to { transform: translateY(-3px); } }
    @keyframes lipB { to { transform: translateY(4px); } }
    .grape { transition: transform .3s; }
    .bubbling .grape { animation: bub .6s ease-in-out 4 alternate; }
    .bubbling .grape:nth-child(2n) { animation-delay: .15s; }
    .bubbling .grape:nth-child(3n) { animation-delay: .3s; }
    @keyframes bub { to { transform: translateY(-3px); } }
    @keyframes stamp { 0% { transform: scale(1.6) rotate(-20deg); opacity: 0; } 100% { transform: scale(1) rotate(-6deg); opacity: 1; } }
    .stamp-in { animation: stamp .45s ease-out both; }
    @media (prefers-reduced-motion: reduce) {
      .gauge-fill, .beam, .door, .tile { transition: none; }
      .speaking .lip-top, .speaking .lip-bot, .bubbling .grape, .stamp-in, .tile.shake { animation: none; }
    }
    button:focus-visible { outline: 2px solid #e7c27a; outline-offset: 2px; }
  </style>

  <main class="min-h-screen bg-[#0e0a10] !text-[#efe4ec]">

    <!-- HERO -->
    <div class="border-b border-[#3a2a3f] bg-gradient-to-b from-[#24162a] to-transparent px-4 pt-10 pb-8 text-center">
      <p class="mb-3 text-xs tracking-[0.22em] !text-[#8f7a92]">
        <a href="/daf" class="transition-colors hover:!text-[#efe4ec]">daf yomi arcade</a>
        <span class="mx-2 opacity-40">·</span>bekhorot 31<span class="mx-2 opacity-40">·</span>2026-10-19
      </p>
      <h1 class="frank text-4xl font-black tracking-tight sm:text-5xl !text-[#f5e9f0]">Say It in My Name</h1>
      <p class="frank mt-3 text-3xl font-light !text-[#e7c27a]" dir="rtl" lang="he">דּוֹבֵב שִׂפְתֵי יְשֵׁנִים</p>
      <p class="mt-1 text-xs italic !text-[#8f7a92]">"Moving gently the lips of those who sleep" · Song of Songs 7:10, quoted on Bekhorot 31b:11</p>
      <p class="mx-auto mt-5 max-w-lg text-sm leading-relaxed !text-[#c9b6c6]">
        Rav Sheshet worked out a hard question overnight. His attendant repeated the answer in the study
        hall and left out whose it was, and Rav Sheshet was furious. Before you reach that story, the daf
        asks who gets let back in, who can judge his own animals, and how to sell meat you aren't allowed to sell.
        Five stations.
      </p>
      <p class="mt-4 text-xs !text-[#8f7a92]">Score: <span id="score" class="font-bold !text-[#e7c27a]">0</span> / <span id="scoreMax">0</span></p>
    </div>

    <div class="mx-auto max-w-2xl space-y-10 px-4 pb-20 pt-8">

      <!-- STATION 1 -->
      <section class="card p-5 sm:p-6" aria-labelledby="s1h">
        <p class="text-xs font-bold tracking-[0.2em] !text-[#b46fc0]">STATION 1 · 31a:1–6</p>
        <h2 id="s1h" class="frank mt-1 text-2xl font-bold !text-[#f5e9f0]">The Door Back</h2>
        <p class="mt-2 text-sm leading-relaxed !text-[#c9b6c6]">
          An am ha'aretz took on the strict practices of a <em>ḥaver</em>, then dropped them, and now wants back in.
          Each row is one opinion. Tap the doors that opinion would <strong class="!text-[#e7c27a]">open</strong>, leave the
          rest shut, then check your answers.
        </p>
        <div id="doors" class="mt-5 space-y-5"></div>
        <button id="doorCheck" class="chip mt-5 font-bold !text-[#e7c27a]">Check all the doors</button>
        <p id="doorFb" class="hidden"></p>
        <div id="s1more" class="mt-6 hidden space-y-6"></div>
      </section>

      <!-- STATION 2 -->
      <section class="card p-5 sm:p-6" aria-labelledby="s2h">
        <p class="text-xs font-bold tracking-[0.2em] !text-[#b46fc0]">STATION 2 · 31a:7–12</p>
        <h2 id="s2h" class="frank mt-1 text-2xl font-bold !text-[#f5e9f0]">Judge Your Own Flock</h2>
        <p class="frank mt-2 text-lg !text-[#e7c27a]" dir="rtl" lang="he">כׇּל הַבְּכוֹרוֹת אָדָם רוֹאֶה, חוּץ מִשֶּׁל עַצְמוֹ</p>
        <p class="mt-2 text-sm leading-relaxed !text-[#c9b6c6]">
          You're an expert, and these are your own animals and your own food. The gauge shows how much you stand to gain.
          For each one, decide if you can rule on it yourself. If you can, pick the <strong class="!text-[#e7c27a]">way out</strong>
          that empties the gauge: something else you could have done to get the same result, so you have no reason to lie.
        </p>
        <div id="valves" class="mt-5 space-y-5"></div>
        <div id="s2more" class="mt-6 hidden"></div>
      </section>

      <!-- STATION 3 -->
      <section class="card p-5 sm:p-6" aria-labelledby="s3h">
        <p class="text-xs font-bold tracking-[0.2em] !text-[#b46fc0]">STATION 3 · Mishna 31a:14–16 · 31b:1–5</p>
        <h2 id="s3h" class="frank mt-1 text-2xl font-bold !text-[#f5e9f0]">Market or Home</h2>
        <p class="mt-2 text-sm leading-relaxed !text-[#c9b6c6]">
          Three blemished animals are ready to sell. For each one, set both switches: <em>where</em> it's sold and slaughtered,
          and <em>how</em> the meat is priced. Then stamp it.
        </p>
        <div id="stalls" class="mt-5 space-y-4"></div>
        <div id="scaleWrap" class="mt-8 hidden"></div>
        <div id="s3more" class="mt-6 hidden"></div>
      </section>

      <!-- STATION 4 -->
      <section class="card p-5 sm:p-6" aria-labelledby="s4h">
        <p class="text-xs font-bold tracking-[0.2em] !text-[#b46fc0]">STATION 4 · 31b:6–8, 12–20</p>
        <h2 id="s4h" class="frank mt-1 text-2xl font-bold !text-[#f5e9f0]">Fold It Into the Horns</h2>
        <p class="frank mt-2 text-lg !text-[#e7c27a]" dir="rtl" lang="he">מַבְלִיעוֹ בְּעוֹרוֹ, בְּחֶלְבּוֹ, וּבְגִידוֹ, וּבְקַרְנָיו</p>
        <p class="mt-2 text-sm leading-relaxed !text-[#c9b6c6]">
          Animal-tithe meat may not be sold. But a baraita allows <em>havla'ah</em>, "folding in": you sell the hide, fat, sinews
          and horns, which are allowed, at a price that also covers the meat. Abaye and Rava read that baraita differently.
          Pick a reader, then price each item the way he would.
        </p>
        <div class="mt-4 flex gap-2" role="tablist" aria-label="Reader">
          <button class="chip font-bold" data-reader="abaye" aria-pressed="true">Abaye's reading</button>
          <button class="chip font-bold" data-reader="rava" aria-pressed="false">Rava's reading</button>
        </div>
        <div id="tags" class="mt-4 space-y-3"></div>
        <button id="tagCheck" class="chip mt-4 font-bold !text-[#e7c27a]">Check this reading</button>
        <p id="tagFb" class="hidden"></p>
        <div id="s4more" class="mt-6 hidden space-y-6"></div>
      </section>

      <!-- STATION 5 -->
      <section class="card p-5 sm:p-6" aria-labelledby="s5h">
        <p class="text-xs font-bold tracking-[0.2em] !text-[#b46fc0]">STATION 5 · 31a:3, 9 · 31b:8–11</p>
        <h2 id="s5h" class="frank mt-1 text-2xl font-bold !text-[#f5e9f0]">Say It in My Name</h2>
        <p class="mt-2 text-sm leading-relaxed !text-[#c9b6c6]">
          "Whenever a Torah scholar is quoted by name in this world, his lips move in the grave."
          Build each chain of who said it in whose name. Start with the person speaking and work back to whoever
          said it first. If you get the chain right, the lips move and the grapes in the pile start to stir.
        </p>
        <div class="mt-5 grid grid-cols-[1fr_auto] items-center gap-4">
          <div>
            <p id="chainNum" class="text-xs font-bold tracking-[0.18em] !text-[#8f7a92]"></p>
            <p id="chainTeaching" class="mt-1 text-sm leading-relaxed !text-[#f5e9f0]"></p>
          </div>
          <svg id="grave" viewBox="0 0 120 110" class="h-28 w-28" role="img" aria-label="A sleeping scholar's lips and a pile of grapes">
            <rect x="8" y="8" width="104" height="58" rx="28" fill="#211727" stroke="#4b3752" />
            <path d="M30 34 q8 -5 16 0" stroke="#8f7a92" stroke-width="2" fill="none" />
            <path d="M74 34 q8 -5 16 0" stroke="#8f7a92" stroke-width="2" fill="none" />
            <g>
              <path class="lip-top" d="M42 48 q9 -7 18 -2 q9 -5 18 2 q-18 3 -36 0z" fill="#b5566e" />
              <path class="lip-bot" d="M42 49 q18 2 36 0 q-8 9 -18 9 q-10 0 -18 -9z" fill="#9c4359" />
            </g>
            <g id="grapes">
              <circle class="grape" cx="40" cy="98" r="6" fill="#6d3b7a" />
              <circle class="grape" cx="52" cy="98" r="6" fill="#7c4589" />
              <circle class="grape" cx="64" cy="98" r="6" fill="#6d3b7a" />
              <circle class="grape" cx="76" cy="98" r="6" fill="#7c4589" />
              <circle class="grape" cx="46" cy="88" r="6" fill="#86509a" />
              <circle class="grape" cx="58" cy="88" r="6" fill="#6d3b7a" />
              <circle class="grape" cx="70" cy="88" r="6" fill="#86509a" />
              <circle class="grape" cx="52" cy="78" r="6" fill="#7c4589" />
              <circle class="grape" cx="64" cy="78" r="6" fill="#86509a" />
            </g>
          </svg>
        </div>
        <div class="mt-4 min-h-[3rem] rounded-xl border border-dashed border-[#4b3752] p-3">
          <p id="chainBuilt" class="text-sm !text-[#e7c27a]" aria-live="polite"></p>
        </div>
        <div id="chainTiles" class="mt-4 flex flex-wrap gap-2"></div>
        <p id="chainFb" class="hidden"></p>
        <button id="chainNext" class="chip mt-4 hidden font-bold !text-[#e7c27a]">Next chain →</button>
      </section>

      <div id="final" class="hidden rounded-2xl border border-[#b46fc0] bg-[#1b1220] p-6 text-center">
        <p class="frank text-2xl font-bold !text-[#f5e9f0]">The lips are still moving.</p>
        <p id="finalMsg" class="mt-2 text-sm !text-[#c9b6c6]"></p>
        <p class="mt-3 text-xs italic !text-[#7f6a82]">The daf stops partway through Rava's argument (31b:20). The Sages barred selling only the part of the animal that is valued while it's alive. Rava finishes the thought tomorrow, on 32a.</p>
      </div>

      <!-- LEARN MORE -->
      <section class="card p-6">
        <h2 class="frank mb-3 text-lg font-bold !text-[#f5e9f0]">Learn the real daf</h2>
        <div class="mb-4 flex flex-wrap gap-3">
          <a href="https://www.sefaria.org/Bekhorot.31a" target="_blank" rel="noopener" class="rounded-lg border border-[#3a2a3f] px-4 py-2 text-xs font-bold !text-[#e7c27a] transition-colors hover:bg-[#251a2b]">Bekhorot 31a on Sefaria ↗</a>
          <a href="https://www.sefaria.org/Bekhorot.31b" target="_blank" rel="noopener" class="rounded-lg border border-[#3a2a3f] px-4 py-2 text-xs font-bold !text-[#e7c27a] transition-colors hover:bg-[#251a2b]">Bekhorot 31b on Sefaria ↗</a>
          <a href="https://www.sefaria.org/Mishnah_Bekhorot.5.1" target="_blank" rel="noopener" class="rounded-lg border border-[#3a2a3f] px-4 py-2 text-xs font-bold !text-[#e7c27a] transition-colors hover:bg-[#251a2b]">Mishnah Bekhorot 5:1 ↗</a>
          <a href="https://www.sefaria.org/Yevamot.96b" target="_blank" rel="noopener" class="rounded-lg border border-[#3a2a3f] px-4 py-2 text-xs font-bold !text-[#e7c27a] transition-colors hover:bg-[#251a2b]">Yevamot 96b–97a: lips in the grave, again ↗</a>
        </div>
        <p class="mb-2 text-xs font-bold !text-[#8f7a92]">Top commentaries</p>
        <ul class="grid grid-cols-2 gap-x-4 gap-y-1 text-xs sm:grid-cols-3">
          <li><a href="https://www.sefaria.org/Rashi_on_Bekhorot.31a" target="_blank" rel="noopener" class="!text-[#c9b6c6] transition-colors hover:!text-[#e7c27a]">Rashi (60) ↗</a></li>
          <li><a href="https://www.sefaria.org/Rabbeinu_Gershom_on_Bekhorot.31a" target="_blank" rel="noopener" class="!text-[#c9b6c6] transition-colors hover:!text-[#e7c27a]">Rabbeinu Gershom (36) ↗</a></li>
          <li><a href="https://www.sefaria.org/Steinsaltz_on_Bekhorot.31a" target="_blank" rel="noopener" class="!text-[#c9b6c6] transition-colors hover:!text-[#e7c27a]">Steinsaltz (35) ↗</a></li>
          <li><a href="https://www.sefaria.org/Mishneh_Torah%2C_Firstlings.6" target="_blank" rel="noopener" class="!text-[#c9b6c6] transition-colors hover:!text-[#e7c27a]">Rambam, Firstlings 6 ↗</a></li>
          <li><a href="https://www.sefaria.org/Kessef_Mishneh_on_Mishneh_Torah%2C_Firstlings.6" target="_blank" rel="noopener" class="!text-[#c9b6c6] transition-colors hover:!text-[#e7c27a]">Kessef Mishneh (9) ↗</a></li>
          <li><a href="https://www.sefaria.org/Har_HaMoriyah_on_Mishneh_Torah%2C_Firstlings.6" target="_blank" rel="noopener" class="!text-[#c9b6c6] transition-colors hover:!text-[#e7c27a]">Har HaMoriyah (9) ↗</a></li>
        </ul>
      </section>

    </div>
  </main>

  <script is:inline>
  (function () {
    var score = 0, max = 0;
    var scoreEl = document.getElementById('score');
    var maxEl = document.getElementById('scoreMax');
    function addMax(n) { max += n; maxEl.textContent = max; }
    function award(n) { score += n; scoreEl.textContent = score; }
    function el(tag, cls, html) { var e = document.createElement(tag); if (cls) e.className = cls; if (html != null) e.innerHTML = html; return e; }
    function sef(ref) { return '<a class="underline decoration-dotted !text-[#e7c27a] hover:!text-[#f5e9f0]" target="_blank" rel="noopener" href="https://www.sefaria.org/' + ref.replace(/ /g, '_') + '">' + ref + ' ↗</a>'; }
    var OK = 'mt-3 text-xs leading-relaxed !text-[#8fd19e]';
    var BAD = 'mt-3 text-xs leading-relaxed !text-[#f0937f]';
    var NOTE = 'mt-3 text-xs leading-relaxed !text-[#c9b6c6]';
    var TOTAL_STATIONS = 5, stationsDone = 0;
    function stationDone() {
      stationsDone++;
      if (stationsDone === TOTAL_STATIONS) {
        var f = document.getElementById('final');
        f.classList.remove('hidden');
        var pct = Math.round(100 * score / max);
        document.getElementById('finalMsg').textContent = 'You scored ' + score + ' of ' + max + ' (' + pct + '%). ' +
          (pct >= 85 ? 'Rav Sheshet would happily let you repeat his teachings, as long as you name him.' :
           pct >= 60 ? 'Not bad. Go back over the mishna and the Abaye–Rava argument once more.' :
           'Go back and learn the daf. Return, backsliding children: the door is open.');
      }
    }

    // Multiple-choice question. Scores 1 point if right on the first try.
    function mcq(parent, q, opts, correctIdx, okHtml, onDone) {
      addMax(1);
      var box = el('div', '');
      box.appendChild(el('p', 'text-sm font-bold !text-[#f5e9f0]', q));
      var row = el('div', 'mt-2 flex flex-col gap-2');
      var fb = el('p', 'hidden');
      var tries = 0, done = false;
      opts.forEach(function (o, i) {
        var b = el('button', 'chip text-left !text-[#efe4ec]', o);
        b.addEventListener('click', function () {
          if (done) return;
          tries++;
          if (i === correctIdx) {
            done = true; if (tries === 1) award(1);
            b.classList.add('ok'); fb.className = OK; fb.innerHTML = '✓ ' + okHtml;
            row.querySelectorAll('button').forEach(function (x) { x.disabled = true; });
            if (onDone) onDone();
          } else { b.classList.add('bad'); b.disabled = true; fb.className = BAD; fb.textContent = 'Not that one. Try again.'; }
        });
        row.appendChild(b);
      });
      box.appendChild(row); box.appendChild(fb);
      parent.appendChild(box);
    }

    // ---------- STATION 1: The Door Back ----------
    (function () {
      var A = { l: 'Dropped it in private, still acts as a ḥaver in public' };
      var B = { l: 'Dropped it openly, in public' };
      var C = { l: 'When he was a ḥaver, kept the practices in private too' };
      var D = { l: 'When he was a ḥaver, kept them only where people could see' };
      var rows = [
        { who: 'Rabbi Meir', he: 'רַבִּי מֵאִיר', doors: [A, B], open: [false, false],
          why: 'Rabbi Meir: once they go back, <em>they are never accepted</em>.' },
        { who: 'Rabbi Yehuda', he: 'רַבִּי יְהוּדָה', doors: [A, B], open: [false, true],
          why: 'Rabbi Yehuda: someone who drops it secretly but keeps up appearances is a fake, so he is not accepted. Someone who drops it openly, <em>befarheseya</em>, was honest even when leaving, so he can be trusted.' },
        { who: 'The other version (אִיכָּא דְּאָמְרִי)', he: 'אִיכָּא דְּאָמְרִי', doors: [C, D], open: [true, false],
          why: 'The other version looks at how he acted <em>while he was a ḥaver</em>. If he kept the practices in private too, he meant it, so he is accepted back. If he only kept them in public, he is not.' },
        { who: 'Rabbi Shimon & Rabbi Yehoshua ben Korḥa', he: 'ר׳ שִׁמְעוֹן וְר׳ יְהוֹשֻׁעַ בֶּן קׇרְחָה', doors: [A, B], open: [true, true],
          why: 'Rabbi Shimon and Rabbi Yehoshua ben Korḥa: <em>either way they are accepted</em>, because "Return, you backsliding children" (Jeremiah 3:22).' }
      ];
      addMax(rows.length);
      var wrap = document.getElementById('doors');
      var state = rows.map(function (r) { return r.doors.map(function () { return false; }); });
      var btns = [];
      rows.forEach(function (r, ri) {
        var box = el('div', '');
        box.appendChild(el('p', 'text-sm font-bold !text-[#f5e9f0]', r.who + ' <span class="frank font-normal !text-[#8f7a92]" dir="rtl" lang="he">' + r.he + '</span>'));
        var g = el('div', 'mt-2 grid grid-cols-2 gap-3');
        btns[ri] = [];
        r.doors.forEach(function (d, di) {
          var b = el('button', 'door p-3 text-left');
          b.setAttribute('aria-pressed', 'false');
          b.innerHTML = '<span class="block text-[0.65rem] font-bold tracking-widest !text-[#8f7a92]">' + (di === 0 ? 'DOOR ONE' : 'DOOR TWO') + ' · <span class="st">SHUT</span></span><span class="mt-1 block text-xs leading-snug !text-[#efe4ec]">' + d.l + '</span>';
          b.addEventListener('click', function () {
            if (b.disabled) return;
            state[ri][di] = !state[ri][di];
            b.setAttribute('aria-pressed', String(state[ri][di]));
            b.querySelector('.st').textContent = state[ri][di] ? 'OPEN' : 'SHUT';
          });
          g.appendChild(b); btns[ri].push(b);
        });
        box.appendChild(g);
        box.appendChild(el('p', 'hidden why'));
        wrap.appendChild(box);
      });
      var check = document.getElementById('doorCheck');
      var fb = document.getElementById('doorFb');
      check.addEventListener('click', function () {
        var got = 0;
        rows.forEach(function (r, ri) {
          var right = r.open.every(function (o, di) { return o === state[ri][di]; });
          if (right) got++;
          btns[ri].forEach(function (b, di) {
            b.disabled = true;
            b.classList.add(r.open[di] === state[ri][di] ? 'ok' : 'bad');
            b.setAttribute('aria-pressed', String(r.open[di]));
            b.querySelector('.st').textContent = r.open[di] ? 'OPEN' : 'SHUT';
