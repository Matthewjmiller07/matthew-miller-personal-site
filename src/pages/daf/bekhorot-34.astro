---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Fined in What He Did — Daf Yomi Game: Bekhorot 34"
  description="Bekhorot 34: read a word as written and as pronounced, find which Rabbi Shimon Shmuel meant, sentence the man who slit a firstborn's ear and the man who cut off his baheret, flip one vav to rule on a bridegroom, and decide whether a fine passes to the son."
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@300;400;700;900&display=swap" />

  <style>
    .frank { font-family: 'Frank Ruhl Libre', serif; }
    .card { background: #13120f; border: 1px solid #36302a; border-radius: 1rem; }
    .chip { border: 1px solid #4a4239; border-radius: 0.6rem; padding: 0.45rem 0.75rem; font-size: 0.8rem; transition: background .15s, border-color .15s; text-align: left; }
    .chip:hover:not(:disabled) { background: #221e19; }
    .chip[aria-pressed="true"] { background: #2e2316; border-color: #d29a52; }
    .chip.ok { background: #18261b; border-color: #66a072; }
    .chip.bad { background: #351b17; border-color: #c4503d; }
    .chip:disabled { cursor: default; opacity: .92; }
    .lens { transition: letter-spacing .35s, color .35s; }
    .cell { border: 1px dashed #4a4239; border-radius: .8rem; padding: .7rem; min-height: 7rem; transition: border-color .2s, background .2s; }
    .cell.ok { border-style: solid; border-color: #66a072; background: #15201a; }
    .cell.cross { box-shadow: 0 0 0 2px #c4503d inset; }
    .vavslot { width: 2.6rem; height: 3.4rem; border: 2px dashed #6a5d4f; border-radius: .6rem; display: inline-flex; align-items: center; justify-content: center; transition: background .2s, border-color .2s, transform .2s; }
    .vavslot[aria-pressed="true"] { border-style: solid; border-color: #d29a52; background: #2e2316; transform: translateY(-3px); }
    .day { flex: 1; height: 2.4rem; border-radius: .4rem; border: 1px solid #36302a; display: flex; align-items: center; justify-content: center; font-size: .7rem; transition: background .35s; }
    .day.pure { background: #e9e4d6; }
    .day.impure { background: #5a2420; }
    .seal { width: 2rem; height: 2rem; border-radius: 999px; background: radial-gradient(circle at 35% 35%, #d8664f, #8e2c20); box-shadow: 0 2px 6px #0008; transition: transform .7s cubic-bezier(.4,0,.2,1), opacity .5s; }
    .seal.down { transform: translateY(4.2rem); }
    .seal.dead { opacity: .25; }
    .fade { transition: opacity .5s; }
    .stamp { display: inline-block; border: 3px solid #c4503d; color: #c4503d; padding: .2rem .8rem; border-radius: .4rem; transform: rotate(-6deg); font-weight: 900; letter-spacing: .2em; }
    @media (prefers-reduced-motion: reduce) {
      .chip, .lens, .cell, .vavslot, .day, .seal, .fade { transition: none; }
    }
    button:focus-visible { outline: 2px solid #d29a52; outline-offset: 2px; }
  </style>

  <main class="min-h-screen bg-[#0c0b09] !text-[#ece6dc]">

    <!-- HERO -->
    <div class="border-b border-[#36302a] bg-gradient-to-b from-[#221a12] to-transparent px-4 pt-10 pb-8 text-center">
      <p class="mb-3 text-xs tracking-[0.22em] !text-[#968a7b]">
        <a href="/daf" class="transition-colors hover:!text-[#ece6dc]">daf yomi arcade</a>
        <span class="mx-2 opacity-40">·</span>bekhorot 34<span class="mx-2 opacity-40">·</span>2026-10-22
      </p>
      <h1 class="frank text-4xl font-black tracking-tight sm:text-5xl !text-[#f4efe6]">Fined in What He Did</h1>
      <p class="frank mt-3 text-3xl font-light !text-[#d29a52]" dir="rtl" lang="he">בְּמַאי דַּעֲבַד קַנְסוּהּ</p>
      <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed !text-[#b8ad9f]">
        A man slits the ear of his own firstborn so he can eat it. Another man cuts the white leprous spot off his skin
        so he can be pure. How long are they fined, why, and does the fine outlive them? Five rounds, straight from the daf.
      </p>
      <p class="mt-4 text-xs !text-[#968a7b]">Score: <span id="score" class="font-bold !text-[#d29a52]">0</span> / <span id="max">0</span></p>
    </div>

    <div class="mx-auto max-w-3xl space-y-8 px-4 py-8">

      <!-- ROUND 1 -->
      <section class="card p-5" aria-labelledby="r1h">
        <p class="text-[0.65rem] tracking-[0.2em] !text-[#968a7b]">ROUND 1 · 34a:2–6</p>
        <h2 id="r1h" class="frank mb-2 text-2xl font-bold !text-[#f4efe6]">Two layers of one word</h2>
        <p class="mb-4 text-sm leading-relaxed !text-[#b8ad9f]">
          The Torah has a spelling (<em>masoret</em>) and a reading (<em>mikra</em>). Flip the lens, then put each derivation on the layer it comes from.
        </p>
        <div class="mb-4 grid gap-3 sm:grid-cols-2">
          <div class="rounded-xl border border-[#36302a] p-4 text-center">
            <p class="text-xs !text-[#968a7b]">Numbers 18:8</p>
            <p class="frank lens mt-1 text-4xl !text-[#f4efe6]" dir="rtl" lang="he" data-w="0">תרומתי</p>
            <p class="mt-1 text-xs !text-[#b8ad9f]" data-g="0"></p>
          </div>
          <div class="rounded-xl border border-[#36302a] p-4 text-center">
            <p class="text-xs !text-[#968a7b]">Exodus 21:8</p>
            <p class="frank lens mt-1 text-4xl !text-[#f4efe6]" dir="rtl" lang="he" data-w="1">בבגדו</p>
            <p class="mt-1 text-xs !text-[#b8ad9f]" data-g="1"></p>
          </div>
        </div>
        <div class="mb-5 text-center">
          <button id="lensBtn" class="chip !text-[#ece6dc]" aria-pressed="false">🔍 Showing: <b>as written</b> — tap to hear it read</button>
        </div>
        <div id="r1cards" class="space-y-3"></div>
        <div id="r1after" class="mt-5 hidden"></div>
      </section>

      <!-- ROUND 2 -->
      <section class="card p-5" aria-labelledby="r2h">
        <p class="text-[0.65rem] tracking-[0.2em] !text-[#968a7b]">ROUND 2 · 34a:1, 34a:7–9</p>
        <h2 id="r2h" class="frank mb-2 text-2xl font-bold !text-[#f4efe6]">The dog, the dough, and the other Rabbi Shimon</h2>
        <div id="r2" class="space-y-5"></div>
      </section>

      <!-- ROUND 3 -->
      <section class="card p-5" aria-labelledby="r3h">
        <p class="text-[0.65rem] tracking-[0.2em] !text-[#968a7b]">ROUND 3 · 34a:10–34b:7</p>
        <h2 id="r3h" class="frank mb-2 text-2xl font-bold !text-[#f4efe6]">The sentencing bench</h2>
        <p class="mb-4 text-sm leading-relaxed !text-[#b8ad9f]">
          Two offenders. <b class="!text-[#ece6dc]">The ear-slitter</b> slit the ear of a firstborn (our mishna).
          <b class="!text-[#ece6dc]">The spot-cutter</b> deliberately cut off his <em>baheret</em> to become pure (Nega'im 7:5).
          Set each sentence for each side.
        </p>
        <div class="mb-2 grid grid-cols-[5.5rem_1fr_1fr] gap-2 text-xs">
          <div></div>
          <div class="text-center font-bold !text-[#d29a52]">Rabbi Eliezer</div>
          <div class="text-center font-bold !text-[#d29a52]">The Rabbis</div>
        </div>
        <div id="bench" class="grid grid-cols-[5.5rem_1fr_1fr] gap-2"></div>
        <div id="r3after" class="mt-5 hidden space-y-5"></div>
      </section>

      <!-- ROUND 4 -->
      <section class="card p-5" aria-labelledby="r4h">
        <p class="text-[0.65rem] tracking-[0.2em] !text-[#968a7b]">ROUND 4 · 34b:8–12</p>
        <h2 id="r4h" class="frank mb-2 text-2xl font-bold !text-[#f4efe6]">One vav, one bridegroom</h2>
        <p class="mb-4 text-sm leading-relaxed !text-[#b8ad9f]">
          Rabbi Eliezer: when another mark appears, he becomes pure from the first. Rav Pappa asks: did we learn
          <span class="frank !text-[#ece6dc]" lang="he">יִטְהַר</span> (he becomes pure <em>now</em>) or
          <span class="frank !text-[#ece6dc]" lang="he">וְיִטְהַר</span> (and he becomes pure, once the new mark is ruled pure)?
          Test it on a spot-cutter who gets a new mark during his seven wedding days. A bridegroom's mark isn't examined until the seven days are over (Nega'im 3:2).
        </p>
        <div class="mb-4 flex items-center justify-center gap-1" dir="rtl">
          <button id="vav" class="vavslot frank text-3xl !text-[#d29a52]" aria-pressed="false" aria-label="Toggle the letter vav"></button>
          <span class="frank text-5xl !text-[#f4efe6]" lang="he">יִטְהַר</span>
        </div>
        <p id="vavLabel" class="mb-4 text-center text-xs !text-[#968a7b]"></p>
        <p class="mb-2 text-sm !text-[#ece6dc]">Under this reading, what is he during the seven days?</p>
        <div id="vavPick" class="mb-4 flex flex-wrap gap-2"></div>
        <div class="flex gap-1" id="days"></div>
        <p id="vavMsg" class="mt-3 text-sm leading-relaxed !text-[#b8ad9f]"></p>
        <div id="teiku" class="mt-4 hidden text-center"></div>
      </section>

      <!-- ROUND 5 -->
      <section class="card p-5" aria-labelledby="r5h">
        <p class="text-[0.65rem] tracking-[0.2em] !text-[#968a7b]">ROUND 5 · 34b:13–35a:1</p>
        <h2 id="r5h" class="frank mb-2 text-2xl font-bold !text-[#f4efe6]">Does the fine pass to the son?</h2>
        <p class="mb-4 text-sm leading-relaxed !text-[#b8ad9f]">
          Rabbi Yirmeya asks Rabbi Zeira: the ear-slitter died. Is his son fined after him? Walk the precedents.
          Send the wax seal down to the son, or let it die with the father, then say why.
        </p>
        <div id="heirs" class="space-y-4"></div>
      </section>

      <div id="final" class="card hidden p-5 text-center"></div>

      <!-- LEARN -->
      <section class="card p-5">
        <h2 class="frank mb-3 text-lg font-bold !text-[#f4efe6]">Learn the real daf</h2>
        <div class="mb-4 flex flex-wrap gap-2">
          <a href="https://www.sefaria.org/Bekhorot.34a" target="_blank" rel="noopener" class="rounded-lg border border-[#36302a] px-4 py-2 text-xs font-bold !text-[#d29a52] transition-colors hover:bg-[#221e19]">Bekhorot 34a on Sefaria ↗</a>
          <a href="https://www.sefaria.org/Bekhorot.34b" target="_blank" rel="noopener" class="rounded-lg border border-[#36302a] px-4 py-2 text-xs font-bold !text-[#d29a52] transition-colors hover:bg-[#221e19]">Bekhorot 34b on Sefaria ↗</a>
          <a href="https://www.sefaria.org/Mishnah_Negaim.7.5" target="_blank" rel="noopener" class="rounded-lg border border-[#36302a] px-4 py-2 text-xs font-bold !text-[#d29a52] transition-colors hover:bg-[#221e19]">Mishnah Nega'im 7:5 ↗</a>
          <a href="https://www.sefaria.org/Mishnah_Sheviit.4.2" target="_blank" rel="noopener" class="rounded-lg border border-[#36302a] px-4 py-2 text-xs font-bold !text-[#d29a52] transition-colors hover:bg-[#221e19]">Mishnah Shevi'it 4:2 ↗</a>
          <a href="https://www.sefaria.org/Bekhorot.35a" target="_blank" rel="noopener" class="rounded-lg border border-[#36302a] px-4 py-2 text-xs font-bold !text-[#d29a52] transition-colors hover:bg-[#221e19]">Continue: Bekhorot 35a ↗</a>
        </div>
        <p class="mb-2 text-xs !text-[#968a7b]">Top commentaries linked to this daf:</p>
        <ul class="grid gap-1 text-sm sm:grid-cols-2">
          <li><a href="https://www.sefaria.org/Rashi_on_Bekhorot.34a" target="_blank" rel="noopener" class="!text-[#c3b8a9] transition-colors hover:!text-[#d29a52]">Rashi (36) ↗</a></li>
          <li><a href="https://www.sefaria.org/Steinsaltz_on_Bekhorot.34a" target="_blank" rel="noopener" class="!text-[#c3b8a9] transition-colors hover:!text-[#d29a52]">Steinsaltz (29) ↗</a></li>
          <li><a href="https://www.sefaria.org/Rabbeinu_Gershom_on_Bekhorot.34a" target="_blank" rel="noopener" class="!text-[#c3b8a9] transition-colors hover:!text-[#d29a52]">Rabbeinu Gershom (26) ↗</a></li>
          <li><a href="https://www.sefaria.org/Tosafot_on_Bekhorot.34a" target="_blank" rel="noopener" class="!text-[#c3b8a9] transition-colors hover:!text-[#d29a52]">Tosafot (13) ↗</a></li>
          <li><a href="https://www.sefaria.org/Rashash_on_Bekhorot.34a" target="_blank" rel="noopener" class="!text-[#c3b8a9] transition-colors hover:!text-[#d29a52]">Rashash (8) ↗</a></li>
        </ul>
      </section>
    </div>
  </main>

  <script is:inline>
    (function () {
      var score = 0, max = 0;
      var $ = function (id) { return document.getElementById(id); };
      function sef(ref) { return '<a class="underline decoration-dotted !text-[#d29a52] hover:!text-[#f4efe6]" target="_blank" rel="noopener" href="https://www.sefaria.org/' + ref.replace(/ /g, '_') + '">' + ref + ' ↗</a>'; }
      function addMax(n) { max += n; $('max').textContent = max; }
      function award() { score++; $('score').textContent = score; checkDone(); }
      var done = 0, totalTasks = 0;
      function task() { totalTasks++; }
      function finish() { done++; checkDone(); }
      function checkDone() {
        if (totalTasks && done >= totalTasks) {
          var f = $('final'); f.classList.remove('hidden');
          f.innerHTML = '<p class="frank text-2xl font-bold !text-[#f4efe6]">' + score + ' / ' + max + '</p>' +
            '<p class="mt-2 text-sm !text-[#b8ad9f]">Next daf (35a): a Roman quaestor slits an old ram’s ear with a dagger, and the Sages permit it — once.</p>';
        }
      }
      // One multiple-choice question. opts: [{t, ok, why}]
      function mcq(host, prompt, opts, ref, after) {
        addMax(1); task();
        var box = document.createElement('div');
        box.innerHTML = '<p class="mb-2 text-sm !text-[#ece6dc]">' + prompt + '</p><div class="flex flex-col gap-2"></div><p class="mt-2 text-sm leading-relaxed !text-[#b8ad9f]"></p>';
        var list = box.children[1], msg = box.children[2], first = true;
        opts.forEach(function (o) {
          var b = document.createElement('button');
          b.className = 'chip !text-[#ece6dc]'; b.innerHTML = o.t;
          b.onclick = function () {
            if (o.ok) {
              if (first) award();
              b.classList.add('ok');
              Array.prototype.forEach.call(list.children, function (x) { x.disabled = true; });
              msg.innerHTML = o.why + (ref ? ' ' + sef(ref) : '');
              finish(); if (after) after();
            } else {
              first = false; b.classList.add('bad'); b.disabled = true;
              msg.innerHTML = o.why || 'Not quite. Try again.';
            }
          };
          list.appendChild(b);
        });
        host.appendChild(box);
        return box;
      }

      // ---------- ROUND 1: ktiv / kri lens ----------
      var forms = [
        { written: 'תרומתי', read: 'תְּרוּמֹתָי', gw: 'written without a vav: can be read terumati, “My teruma” (one)', gr: 'read terumotai, “My terumot” (plural)' },
        { written: 'בבגדו', read: 'בְּבִגְדוֹ', gw: 'written without a yod: can be read bevagdo, “when he betrayed her”', gr: 'read bevigdo, “with his garment”' }
      ];
      var showRead = false;
      function paintLens() {
        forms.forEach(function (f, i) {
          var w = document.querySelector('[data-w="' + i + '"]'), g = document.querySelector('[data-g="' + i + '"]');
          w.textContent = showRead ? f.read : f.written;
          w.style.letterSpacing = showRead ? '0' : '.12em';
          g.textContent = showRead ? f.gr : f.gw;
        });
        $('lensBtn').setAttribute('aria-pressed', showRead ? 'true' : 'false');
        $('lensBtn').innerHTML = '🔍 Showing: <b>' + (showRead ? 'as read (mikra)' : 'as written (masoret)') + '</b>: tap to flip';
      }
      $('lensBtn').onclick = function () { showRead = !showRead; paintLens(); };
      paintLens();

      var derivs = [
        { who: 'Rabbi Eliezer', on: 'תרומתי', says: 'The verse speaks of two terumot, the definitely pure and the uncertain (teluya). Guard both.', layer: 'read' },
        { who: 'Rabbi Yehoshua', on: 'תרומתי', says: '“Terumati” is written. Only one teruma, the definitely pure, must be guarded.', layer: 'written' },
        { who: 'Rabbi Akiva', on: 'בבגדו', says: 'Once the master spread his garment over her (designated her as his wife), the father may not sell her again.', layer: 'read' },
        { who: 'Rabbi Eliezer', on: 'בבגדו', says: 'Since the father betrayed her by selling her once, he may not sell her again.', layer: 'written' }
      ];
      var r1left = derivs.length;
      derivs.forEach(function (d) {
        addMax(1); task();
        var c = document.createElement('div');
        c.className = 'rounded-xl border border-[#36302a] p-3';
        c.innerHTML = '<p class="text-xs !text-[#968a7b]"><b class="!text-[#d29a52]">' + d.who + '</b> on <span class="frank" lang="he">' + d.on + '</span></p>' +
          '<p class="my-1 text-sm !text-[#ece6dc]">' + d.says + '</p><div class="flex gap-2"></div><p class="mt-1 text-xs !text-[#b8ad9f]"></p>';
        var row = c.children[2], msg = c.children[3], first = true;
        [['written', 'Spelling layer'], ['read', 'Reading layer']].forEach(function (L) {
          var b = document.createElement('button'); b.className = 'chip !text-[#ece6dc]'; b.textContent = L[1];
          b.onclick = function () {
            if (L[0] === d.layer) {
              if (first) award(); b.classList.add('ok');
              Array.prototype.forEach.call(row.children, function (x) { x.disabled = true; });
              msg.textContent = d.layer === 'read' ? 'Yesh em la-mikra: the pronunciation is authoritative.' : 'Yesh em la-masoret: the spelling is authoritative.';
              finish(); if (--r1left === 0) r1contradiction();
            } else { first = false; b.classList.add('bad'); b.disabled = true; msg.textContent = 'Flip the lens and look at which form gives that meaning.'; }
          };
          row.appendChild(b);
        });
        $('r1cards').appendChild(c);
      });
      function r1contradiction() {
        var a = $('r1after'); a.classList.remove('hidden');
        a.innerHTML = '<p class="mb-3 rounded-lg border border-[#c4503d] bg-[#2a1613] p-3 text-sm !text-[#ece6dc]">⚠️ Rabbi Eliezer is standing on <b>both</b> layers. The Gemara: “Does Rabbi Eliezer hold the reading is authoritative? But in the maidservant baraita he follows the spelling!”</p>';
        mcq(a, '“Rather, here they disagree about this.” What do they really disagree about? The verse says “I have given <b>you</b> (lekha)…”', [
          { t: 'Rabbi Eliezer changed his mind between the two baraitot.', ok: false, why: 'The Gemara doesn’t say anyone retracted. It moves the dispute somewhere else.' },
          { t: 'Rabbi Yehoshua: guard only teruma that is fit for you to eat. Rabbi Eliezer: uncertain teruma is also fit for you, since perhaps Elijah will come and declare it pure.', ok: true, why: 'Right. The dispute is about “lekha”, not about spelling vs. reading, so Rabbi Eliezer can keep following the spelling.' },
          { t: 'Both agree uncertain teruma is fit to eat; they disagree about whether it may be burned.', ok: false, why: 'Rabbi Yehoshua holds uncertain teruma is not fit for you. That is why you don’t have to guard it.' }
        ], 'Bekhorot 34a:6');
      }

      // ---------- ROUND 2 ----------
      mcq($('r2'), 'The Torah forbids putting a blemish on a consecrated animal. What about smearing pressed figs or dough on a firstborn’s ear so a dog will come, eat it, and bite the ear?', [
        { t: 'Permitted: he didn’t make the blemish himself.', ok: false, why: 'The baraita reads an extra word to forbid this too.' },
        { t: 'Forbidden: “any blemish” (kol mum, Leviticus 22:21) covers a blemish made directly and one made indirectly.', ok: true, why: '“Echad mum ve-echad kol mum”: a blemish and “any” blemish.' },
        { t: 'Forbidden only if the dog actually bites it.', ok: false, why: 'The baraita forbids putting the dough there in the first place.' }
      ], 'Bekhorot 34a:1');
      mcq($('r2'), 'Shmuel: “The halakha follows Rabbi Shimon.” Shmuel already ruled elsewhere that an unintended act (davar she-eino mitkaven) is permitted, as Rabbi Shimon holds. So which Rabbi Shimon does he mean here, or else he’d be repeating himself?', [
        { t: 'Rabbi Shimon of the mishna: you may let the blood even though a blemish results, since you don’t intend it.', ok: false, why: 'That is just the unintended-act rule again, and Shmuel already said it. Rav Naḥman bar Yitzḥak’s objection.' },
        { t: 'Rabbi Shimon of the baraita (33b): you may let the dying firstborn’s blood, and you may even slaughter and eat it on account of that blemish.', ok: true, why: 'Rav Sheisha son of Rav Idi teaches it explicitly: “the halakha follows Rabbi Shimon of the baraita.”' }
      ], 'Bekhorot 34a:7-9');

      // ---------- ROUND 3: sentencing bench ----------
      var sent = {
        fb: [ { k: 'forever', t: 'Never slaughter it' }, { k: 'another', t: 'Slaughter once another blemish appears' }, { k: 'now', t: 'Slaughter on this blemish' } ],
        bh: [ { k: 'forever', t: 'Impure until it spreads over his whole body (unless it had already shrunk below a bean’s size)' }, { k: 'another', t: 'Pure once another mark comes and is ruled pure' }, { k: 'now', t: 'Pure now' } ]
      };
      var truth = { 'fb-E': 'forever', 'fb-R': 'another', 'bh-E': 'another', 'bh-R': 'forever' };
      var refs = { fb: 'Bekhorot 34a:10', bh: 'Mishnah Negaim 7:5' };
      var benchLeft = 4;
      task(); // Rava void-the-act panel
      [['fb', '✂️ Ear-slitter<br><span class="opacity-60">firstborn</span>'], ['bh', '⚪ Spot-cutter<br><span class="opacity-60">baheret</span>']].forEach(function (row) {
        var lab = document.createElement('div'); lab.className = 'flex items-center text-xs !text-[#ece6dc]'; lab.innerHTML = row[1];
        $('bench').appendChild(lab);
        ['E', 'R'].forEach(function (side) {
          addMax(1); task();
          var key = row[0] + '-' + side, first = true;
          var cell = document.createElement('div'); cell.className = 'cell'; cell.id = 'cell-' + key;
          sent[row[0]].forEach(function (o) {
            var b = document.createElement('button'); b.className = 'chip mb-1 w-full !text-[#ece6dc] text-[0.72rem]'; b.textContent = o.t;
            b.onclick = function () {
              if (o.k === truth[key]) {
                if (first) award(); b.classList.add('ok'); cell.classList.add('ok');
                Array.prototype.forEach.call(cell.querySelectorAll('button'), function (x) { x.disabled = true; if (x !== b) x.style.display = 'none'; });
                var p = document.createElement('p'); p.className = 'mt-1 text-[0.65rem]'; p.innerHTML = sef(refs[row[0]]); cell.appendChild(p);
                finish(); if (--benchLeft === 0) benchDone();
              } else { first = false; b.classList.add('bad'); b.disabled = true; }
            };
            cell.appendChild(b);
          });
          $('bench').appendChild(cell);
        });
      });
      function benchDone() {
        ['fb-E', 'bh-R'].forEach(function (k) { $('cell-' + k).classList.add('cross'); });
        var a = $('r3after'); a.classList.remove('hidden');
        a.innerHTML = '<p class="rounded-lg border border-[#c4503d] bg-[#2a1613] p-3 text-sm !text-[#ece6dc]">⚠️ The heavy sentence crosses over. Rabbi Eliezer is strict with the ear and lenient with the skin; the Rabbis are lenient with the ear and strict with the skin. The Gemara asks why Rabbi Eliezer is so harsh here; Rava adds that the Rabbis contradict themselves too.</p>';
        var e = document.createElement('div'); a.appendChild(e);
        mcq(e, 'Rabba and Rav Yosef: why is Rabbi Eliezer harsh only with the ear-slitter?', [
          { t: 'He fines a man’s property, not his body. A firstborn is forbidden to its owner until it’s blemished anyway, so he loses nothing by blemishing it and needs a stronger deterrent. Would anyone cut off a spot when no new mark may ever come?', ok: true, why: 'Kanes be-mamono, be-gufo lo kanes: mamono, itka lemeimar de-atei lemeevad.' },
          { t: 'Leprosy is a Torah impurity, so the Sages may not add to it.', ok: false, why: 'The Sages do add a fine to the spot-cutter. The difference is property vs. body.' },
          { t: 'The ear-slitter sinned against the Temple; the spot-cutter only against himself.', ok: false, why: 'The Gemara’s reason is the deterrent: would he actually come to do it?' }
        ], 'Bekhorot 34b:3-4', voidPanel);
      }
      function voidPanel() {
        var a = $('r3after');
        var w = document.createElement('div');
        w.innerHTML = '<p class="mb-2 text-sm !text-[#ece6dc]"><b class="!text-[#d29a52]">Rava</b> on the Rabbis: “Here they fined him in what he did, and there they fined him in what he did.” Void each man’s own act and see what’s left.</p>' +
          '<div class="grid gap-3 sm:grid-cols-2">' +
          '<div class="rounded-xl border border-[#36302a] p-3 text-center"><svg viewBox="0 0 120 80" class="mx-auto h-24" aria-hidden="true"><ellipse cx="62" cy="50" rx="34" ry="18" fill="#e9e4d6"/><circle cx="28" cy="38" r="13" fill="#e9e4d6"/><path d="M20 28 L10 16 L24 24 Z" fill="#e9e4d6"/><path id="slit" d="M15 18 L19 26" stroke="#c4503d" stroke-width="2.5"/><circle cx="24" cy="36" r="1.8" fill="#222"/><rect x="40" y="62" width="5" height="14" fill="#cfc7b5"/><rect x="78" y="62" width="5" height="14" fill="#cfc7b5"/><circle id="blem2" cx="86" cy="44" r="4" fill="#c4503d" opacity="0"/></svg>' +
          '<p id="fbStat" class="text-xs !text-[#b8ad9f]">Ear slit (he did it on purpose)</p><div class="mt-2 flex flex-wrap justify-center gap-2"><button id="fbVoid" class="chip !text-[#ece6dc]">Void his act</button><button id="fbNew" class="chip !text-[#ece6dc]" disabled>Another blemish appears</button></div></div>' +
          '<div class="rounded-xl border border-[#36302a] p-3 text-center"><svg viewBox="0 0 120 80" class="mx-auto h-24" aria-hidden="true"><rect x="20" y="10" width="80" height="60" rx="12" fill="#b78d6c"/><circle id="spot" cx="60" cy="40" r="10" fill="#f6f6f2" opacity="0.15" stroke="#f6f6f2" stroke-dasharray="3 3"/><rect id="whole" x="20" y="10" width="80" height="60" rx="12" fill="#f6f6f2" opacity="0"/></svg>' +
          '<p id="bhStat" class="text-xs !text-[#b8ad9f]">Spot cut off (he did it on purpose)</p><div class="mt-2 flex flex-wrap justify-center gap-2"><button id="bhVoid" class="chip !text-[#ece6dc]">Void his act</button><button id="bhNew" class="chip !text-[#ece6dc]" disabled>It spreads over his whole body</button></div></div></div>' +
          '<p id="rava" class="mt-3 text-sm leading-relaxed !text-[#b8ad9f]"></p>';
        a.appendChild(w);
        var steps = 0;
        function step() { if (++steps === 4) { $('rava').innerHTML = 'He meant to permit the firstborn <em>with this blemish</em>, so this blemish doesn’t count. He meant to purify himself <em>with this cutting</em>, so the cutting doesn’t count and the spot is treated as if it were still there. The same rule, two results. ' + sef('Bekhorot 34b:5-7'); finish(); } }
        $('fbVoid').onclick = function () { $('slit').setAttribute('stroke-dasharray', '1 3'); $('slit').setAttribute('opacity', '.4'); $('fbStat').textContent = 'This blemish doesn’t count: treated as unblemished, may not be slaughtered'; this.disabled = true; $('fbNew').disabled = false; step(); };
        $('fbNew').onclick = function () { $('blem2').setAttribute('opacity', '1'); $('fbStat').innerHTML = '<b class="!text-[#66a072]">A new blemish he didn’t cause: may be slaughtered on it</b>'; this.disabled = true; step(); };
        $('bhVoid').onclick = function () { var s = $('spot'); s.setAttribute('opacity', '1'); s.removeAttribute('stroke-dasharray'); $('bhStat').textContent = 'The cutting doesn’t count: as if the baheret is still there, so he stays impure'; this.disabled = true; $('bhNew').disabled = false; step(); };
        $('bhNew').onclick = function () { $('whole').setAttribute('opacity', '1'); $('bhStat').innerHTML = '<b class="!text-[#66a072]">White over his whole body: pure (Leviticus 13:12–13)</b>'; this.disabled = true; step(); };
      }

      // ---------- ROUND 4: the vav ----------
      var hasVav = false, picked = { plain: false, vav: false };
      addMax(2); task(); task();
      for (var i = 1; i <= 7; i++) { var d = document.createElement('div'); d.className = 'day !text-[#968a7b]'; d.textContent = 'day ' + i; $('days').appendChild(d); }
      function paintVav() {
        $('vav').textContent = hasVav ? 'וְ' : '';
        $('vav').setAttribute('aria-pressed', hasVav ? 'true' : 'false');
        $('vavLabel').textContent = hasVav ? 'וְיִטְהַר: “and he will become pure”, once the new mark is ruled pure' : 'יִטְהַר: “he becomes pure” from the first mark as soon as the new mark appears (tap the slot to add a vav)';
        var k = hasVav ? 'vav' : 'plain';
        Array.prototype.forEach.call($('days').children, function (x) { x.className = 'day ' + (picked[k] ? (hasVav ? 'impure !text-[#ece6dc]' : 'pure !text-[#3a332b]') : '!text-[#968a7b]'); });
        $('vavPick').innerHTML = '';
        if (picked[k]) { $('vavMsg').innerHTML = hasVav ? 'Impure all week. The new mark isn’t examined yet, but the fine from the first mark still holds until the new one is ruled pure, so the grace period gains him nothing. ' + sef('Bekhorot 34b:12') : 'Pure all week. He was purified from the first mark the moment the new one appeared, and the new mark waits until after the seven days of feasting. ' + sef('Bekhorot 34b:11'); return; }
        $('vavMsg').textContent = '';
        var first = true;
        [['pure', 'Pure for the seven days'], ['impure', 'Impure for the seven days']].forEach(function (o) {
          var b = document.createElement('button'); b.className = 'chip !text-[#ece6dc]'; b.textContent = o[1];
          b.onclick = function () {
            var right = hasVav ? 'impure' : 'pure';
            if (o[0] === right) { if (first) award(); picked[k] = true; finish(); paintVav(); if (picked.plain && picked.vav) teiku(); }
            else { first = false; b.classList.add('bad'); b.disabled = true; $('vavMsg').textContent = 'Think about whether the first mark’s fine is still in force.'; }
          };
          $('vavPick').appendChild(b);
        });
      }
      $('vav').onclick = function () { hasVav = !hasVav; paintVav(); };
      function teiku() { var t = $('teiku'); t.classList.remove('hidden'); t.innerHTML = '<span class="stamp frank text-2xl" lang="he">תֵּיקוּ</span><p class="mt-3 text-sm !text-[#b8ad9f]">Which did we learn? Nobody knows. The question stands unresolved.</p>'; }
      paintVav();

      // ---------- ROUND 5: heir seal ----------
      var heirs = [
        { case: 'He sold his Canaanite slave to gentiles, then died.', passes: true, by: 'Precedent',
          why: [ { t: 'Every day the slave is kept from mitzvot.', ok: true }, { t: 'The slave was worth a lot of money.', ok: false }, { t: 'The son lives with the gentile buyer.', ok: false } ],
          note: 'The Sages fined the son too and made him redeem the slave. But that doesn’t settle the firstborn, where nothing like this happens every day.', ref: 'Bekhorot 34b:14' },
        { case: 'He planned his work for Chol HaMoed (to claim it was an emergency), then died before the festival.', passes: false, by: 'Precedent',
          why: [ { t: 'He never actually did the forbidden act.', ok: true }, { t: 'Chol HaMoed labor is only rabbinic.', ok: false }, { t: 'The son didn’t know about the plan.', ok: false } ],
          note: 'The son isn’t fined, but the ear-slitter did act, so this doesn’t settle it either.', ref: 'Bekhorot 34b:15' },
        { case: 'He fertilized his field during the Sabbatical Year (it may not be sown after the year), then died.', passes: false, by: 'Rabbi Zeira, from Rav Asi son of Rabbi Ḥanina',
          why: [ { t: 'The Sages fined him, not his son, even though the fine was on the field.', ok: true }, { t: 'The Sabbatical Year had ended.', ok: false }, { t: 'Fertilizing isn’t real labor.', ok: false } ],
          note: '“His son may sow it.” Rabbi Zeira: there it is, in a mishna. A fine attached to property still doesn’t pass to the son.', ref: 'Bekhorot 34b:17' },
        { case: 'He made someone else’s pure food impure, then died before paying.', passes: false, by: 'Abaye',
          why: [ { t: 'Damage you can’t see isn’t damage by Torah law; the rabbinic fine was only on him.', ok: true }, { t: 'Pure food has no value.', ok: false }, { t: 'The owner should have guarded it.', ok: false } ],
          note: '“We have a tradition”: the son doesn’t pay.', ref: 'Bekhorot 35a:1' },
        { case: 'He slit his firstborn’s ear, then died. The animal now belongs to his son.', passes: false, by: 'Rabbi Zeira, applying the Sabbatical field',
          why: [ { t: 'Like the field: the Sages fined the father, and the father is gone.', ok: true }, { t: 'Firstborns can’t be inherited.', ok: false }, { t: 'The blemish healed.', ok: false } ],
          note: 'Rabbi Yirmeya’s dilemma was whether they fined him (and he’s gone) or his property (which is still here). The Sabbatical field shows a property-fine stops with him too.', ref: 'Bekhorot 34b:16-17' }
      ];
      heirs.forEach(function (h, idx) {
        addMax(2); task();
        var c = document.createElement('div'); c.className = 'rounded-xl border border-[#36302a] p-3';
        c.innerHTML = '<div class="flex gap-3"><div class="flex w-12 flex-col items-center"><span class="text-[0.6rem] !text-[#968a7b]">father</span><div class="seal"></div><div class="h-6"></div><span class="mt-4 text-[0.6rem] !text-[#968a7b]">son</span></div>' +
          '<div class="flex-1"><p class="text-[0.65rem] !text-[#968a7b]">' + h.by + '</p><p class="mb-2 text-sm !text-[#ece6dc]">' + h.case + '</p><div class="flex flex-wrap gap-2 a"></div><div class="mt-2 flex flex-col gap-1 b"></div><p class="mt-2 text-xs leading-relaxed !text-[#b8ad9f] m"></p></div></div>';
        var seal = c.querySelector('.seal'), A = c.querySelector('.a'), B = c.querySelector('.b'), M = c.querySelector('.m'), f1 = true;
        [[true, '⬇ Fine passes to the son'], [false, '✕ Fine dies with him']].forEach(function (o) {
          var b = document.createElement('button'); b.className = 'chip !text-[#ece6dc]'; b.textContent = o[1];
          b.onclick = function () {
            if (o[0] === h.passes) {
              if (f1) award(); b.classList.add('ok');
              Array.prototype.forEach.call(A.children, function (x) { x.disabled = true; });
              seal.classList.add(h.passes ? 'down' : 'dead');
              M.textContent = 'Now: why?';
              var f2 = true;
              h.why.slice().sort(function () { return Math.random() - .5; }).forEach(function (w) {
                var r = document.createElement('button'); r.className = 'chip !text-[#ece6dc]'; r.textContent = w.t;
                r.onclick = function () {
                  if (w.ok) { if (f2) award(); r.classList.add('ok'); Array.prototype.forEach.call(B.children, function (x) { x.disabled = true; }); M.innerHTML = h.note + ' ' + sef(h.ref); finish(); }
                  else { f2 = false; r.classList.add('bad'); r.disabled = true; }
                };
                B.appendChild(r);
              });
            } else { f1 = false; b.classList.add('bad'); b.disabled = true; }
          };
          A.appendChild(b);
        });
        $('heirs').appendChild(c);
      });
    })();
  </script>
</Layout>
