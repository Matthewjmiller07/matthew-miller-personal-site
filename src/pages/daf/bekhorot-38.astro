      var vessels = [
        { shape: 'cup', mat: 'clay', t: 'An <b>earthenware</b> cup. A dead creeping thing (sheretz) touches its <b>outside</b>.', touch: 'out', ans: [], why: 'Nothing. “Every earthen vessel into whose <b>interior</b> any of them falls” (Lev. 11:33): earthenware is defiled only through its inside.', ref: 'Bekhorot 38a:8' },
        { shape: 'cup', mat: 'clay', t: 'The same <b>earthenware</b> cup. The sheretz is inside it.', touch: 'in', ans: CUP, why: 'All of it. Once the inside is impure, the outside is too (38a:7).', ref: 'Bekhorot 38a:7' },
        { shape: 'flat', mat: 'clay', t: 'A flat <b>earthenware</b> tray, no receptacle. The sheretz touches its upper side.', touch: 'up', ans: [], why: 'Nothing. An earthenware vessel without a receptacle has no inside, so it can never become impure. That’s why Rabbi Yitzḥak bar Avin says Ḥizkiyya’s testimony must be about mikveh vessels.', ref: 'Bekhorot 38a:4-5' },
        { shape: 'cup', mat: 'wood', t: 'A <b>wooden</b> cup. The sheretz touches its <b>outside</b>. This is Torah-law impurity.', touch: 'out', ans: CUP, why: 'All of it. The Torah never said a mikveh vessel is defiled only from inside.', ref: 'Bekhorot 38a:8-9' },
        { shape: 'cup', mat: 'wood', t: 'The <b>wooden</b> cup again. This time <b>impure liquid</b> touches its outside: impurity by rabbinic law only.', touch: 'out', ans: ['out'], why: 'Only the outside. “Its inside, its rim, its ear-handle and its straight handle are pure” (Kelim 25:6). The Sages treated it like earthenware.', ref: 'Bekhorot 38a:9-11' },
        { shape: 'cup', mat: 'wood', t: 'Impure liquid touches the wooden cup’s <b>inside</b>.', touch: 'in', ans: CUP, why: '“If its inside became impure, it becomes impure in its entirety.”', ref: 'Bekhorot 38a:9' },
        { shape: 'flat', mat: 'wood', t: 'A flat <b>wooden</b> bench, made for sitting (so a zav’s treading can defile it). Impure liquid touches its <b>underside</b>.', touch: 'down', ans: FLAT, why: 'Both sides. This is Ḥizkiyya’s testimony: a vessel with no receptacle has no distinction of sides.', ref: 'Bekhorot 38a:5, 15' },
        { shape: 'flat', mat: 'clay', t: 'A flat <b>earthenware</b> slab you could sit on. Impure liquid touches it.', touch: 'down', ans: [], why: 'Nothing. Why didn’t the Sages decree for it, as for the bench? There is no treading impurity for earthenware at all.', ref: 'Bekhorot 38a:15' }
      ];
      var v2 = 0, v2first = true, marked = {};
