      // ---------- ROUND 3: the lens ----------
      var eyes = [
        { at: [200, 120], draw: '<circle cx="200" cy="120" r="20" fill="#2c2d33" opacity=".95" filter="url(#sink)" /><circle cx="200" cy="120" r="20" fill="none" stroke="#000" stroke-width="3" opacity=".6" />', read: 'A <b>black</b> film, <b>sunk into</b> the pupil.', blem: true, why: 'A black cataract that is sunken: a blemish (Yoshiya of Usha).', ref: 'Bekhorot 38b:3' },
        { at: [215, 110], draw: '<circle cx="215" cy="110" r="18" fill="#34353d" filter="url(#float)" /><ellipse cx="209" cy="104" rx="6" ry="3" fill="#8e909c" opacity=".7" />', read: 'A <b>black</b> film, <b>floating</b> above the pupil, casting a shadow.', blem: false, why: 'A black cataract that floats: not a blemish.', ref: 'Bekhorot 38b:3' },
