      // ---------- ROUND 4: the fodder trial ----------
      function r4start() {
        chain($('r4a'), [
          ['The mishna says constant pale spots are ones that lasted <b>eighty days</b>, and the tears follow the moist-then-dry test. Whose view is it?', [
            { t: 'Rabbi Yehuda.', ok: true, why: 'Rabbi Meir: pale spots 40 days, tears 80. Rabbi Yehuda: pale spots 80, and the fodder test for tears. Rabbi Ḥananya ben Antigonus adds: examine three times within the eighty.' },
            { t: 'Rabbi Meir.', ok: false, why: 'Rabbi Meir gives pale spots only forty days.' },
            { t: 'Rabbi Ḥananya ben Antigonus.', ok: false, why: 'He only adds the three examinations.' }
          ], 'Bekhorot 38b:10-12'],
          ['The mishna reads as if rain-fed fodder, moist and dry, that doesn’t heal is “not a blemish.” Rabbi Yehuda mentions only irrigated fodder. How does the Gemara square them?', [
            { t: 'The mishna is missing words: <b>rain-fed</b> moist then dry, unhealed, <b>is</b> a blemish; irrigated fodder proves nothing; dry before moist proves nothing.', ok: true, why: 'Only rain-watered fodder is a real cure. The order matters too: moist first, then dry.' },
            { t: 'The mishna isn’t Rabbi Yehuda after all.', ok: false, why: 'The Gemara keeps the attribution and fills in the mishna.' },
            { t: 'Rain-fed and irrigated fodder are the same.', ok: false, why: 'The whole answer depends on them being different.' }
          ], 'Bekhorot 38b:13-15']
        ], function () { show('r4cal'); calStart(); });
      }
      var MONTHS = ['Adar', 'Nisan', 'Iyar', 'Sivan', 'Tammuz', 'Av', 'Elul', 'Tishrei'], cells = [], calStep = 0, calFirst = true;
      function calStart() {
        MONTHS.forEach(function (m, mi) {
          var col = document.createElement('div'); col.className = 'flex flex-col gap-1';
          col.innerHTML = '<span class="text-center text-[10px] !text-[#959bb3]">' + m + '</span>';
          [0, 1].forEach(function (h) {
            var c = document.createElement('button'); c.className = 'cell rounded !text-[#e7e9f0]'; c.setAttribute('data-v', '');
            c.textContent = h ? '2nd ½' : '1st ½'; c.setAttribute('aria-label', m + ', ' + (h ? 'second' : 'first') + ' half: empty');
            c.onclick = function () {
              var nv = { '': 'm', m: 'd', d: '' }[c.getAttribute('data-v')]; c.setAttribute('data-v', nv);
              c.setAttribute('aria-label', m + ', ' + (h ? 'second' : 'first') + ' half: ' + ({ '': 'empty', m: 'moist', d: 'dry' }[nv]));
              tally();
            };
            cells.push(c); col.appendChild(c);
          });
          $('cal').appendChild(col);
        });
        addMax(2); task(); task();
        $('r4calPrompt').innerHTML = 'Rabbi Yehuda’s baraita: the moist-then-dry treatment lasts <b>three months</b>. Rav Idi bar Avin, for Rav Yitzḥak bar Ashiyan: “<b>Adar and Nisan</b> are the moist; <b>Elul and Tishrei</b> are the dry.” Paint Rav Yitzḥak’s statement as he said it.';
        tally();
      }
      function tally() {
        var m = 0, d = 0; cells.forEach(function (c) { var v = c.getAttribute('data-v'); if (v === 'm') m++; if (v === 'd') d++; });
        $('calTally').textContent = 'moist ' + (m / 2) + ' mo · dry ' + (d / 2) + ' mo · total ' + ((m + d) / 2) + ' months';
      }
      function want(step) {
        var w = cells.map(function () { return ''; });
        if (step === 0) { [0, 1, 2, 3].forEach(function (i) { w[i] = 'm'; }); [12, 13, 14, 15].forEach(function (i) { w[i] = 'd'; }); }
        else { [0, 1, 2].forEach(function (i) { w[i] = 'm'; }); [12, 13, 14].forEach(function (i) { w[i] = 'd'; }); }
        return w;
      }
      $('calCheck').onclick = function () {
        var w = want(calStep), wrong = 0;
        cells.forEach(function (c, i) { if (c.getAttribute('data-v') !== w[i]) wrong++; });
        if (wrong) { calFirst = false; $('calMsg').textContent = wrong + ' half-month(s) off.' + (calStep ? ' Keep the order: moist first, then dry, each a month and a half.' : ' Two whole months moist, two whole months dry.'); return; }
        if (calFirst) award(); finish(); calFirst = true;
        if (calStep === 0) {
          calStep = 1;
          $('calMsg').innerHTML = 'That’s <b>four</b> months, and the baraita said three. <span class="frank" lang="he">וְהָא תַּנְיָא…</span> Contradiction. The Gemara’s fix: “Adar and <b>half</b> of Nisan are the moist; Elul and <b>half</b> of Tishrei are the dry.” ' + sef('Bekhorot 38b:16');
          $('r4calPrompt').innerHTML = 'Now repaint it the Gemara’s way, so the total is three months.';
        } else {
          $('calCheck').disabled = true; cells.forEach(function (c) { c.disabled = true; });
          $('calMsg').innerHTML = 'Three months: a month and a half of spring grass, a month and a half of end-of-summer hay. ' + sef('Bekhorot 38b:16');
          r4more();
        }
      };
      function r4more() {
        mcq(show('r4more'), 'Must the animal eat moist fodder <i>in</i> Adar and dry fodder <i>in</i> Elul? Or may it eat moist fodder in Adar and then last summer’s leftover hay, all in the moist season?', [
          { t: 'The proof from Rav Yitzḥak’s months is refuted, and the daf doesn’t settle it.', ok: true, why: 'His months may only name <i>which produce</i> to feed: perhaps one feeds Elul–Tishrei hay in Adar–Nisan. The dilemma stays open here.' },
          { t: 'Rav Yitzḥak proves each fodder must be fed in its own season.', ok: false, why: 'That proof is pushed off: he may mean the produce, not the time of feeding.' },
          { t: 'Leftover hay is explicitly allowed.', ok: false, why: 'Nobody says so explicitly.' }
        ], 'Bekhorot 38b:17-18');
      }
    })();
  </script>
</Layout>
