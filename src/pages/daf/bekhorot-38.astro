      function snailQs() {
        chain(show('r3more'), [
          ['The mishna lists “a snail, a snake.” One blemish or two?', [
            { t: 'One. Rabbi Shimon ben Yosei Lakonya: “This snail… <b>is the snake</b> the Sages spoke of.”', ok: true, why: 'Rabbi Yoḥanan ben Elazar had never passed before the old man; the one time he did, he heard: <span class="frank" lang="he">שֵׁב בְּנִי, שֵׁב</span>, “Sit, my son, sit, and I’ll teach you one thing.”' },
            { t: 'Two distinct growths.', ok: false, why: 'That was the side of the dilemma that was rejected.' },
