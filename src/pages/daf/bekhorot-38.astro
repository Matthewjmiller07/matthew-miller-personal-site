          { t: 'That hole too must let the vetch go <b>in and come out</b>.', ok: true, why: 'Just as a drilled hole is measured with room for the drill to enter and leave, so is the vetch-sized hole.' },
          { t: 'The vetch is measured exactly, with no allowance.', ok: false, why: 'The derivation runs the other way: the same allowance applies.' },
          { t: 'The vetch is the same size as a sela.', ok: false, why: 'Nobody says that. The point is how the hole is measured, not its size.' }
        ], 'Bekhorot 38a:2', function () { show('r2'); r2load(); });
      }

      // ---------- ROUND 2: inside, outside ----------
      var CUP = ['in', 'out', 'rim', 'ear', 'yad'], FLAT = ['up', 'down'];
