---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Downstream — Daf Yomi Game: Bekhorot 55"
  description="Bekhorot 55: link two flocks thirty-two mil apart, test two reasons the Jordan splits a flock, pour a vow down the rivers of Eden to see how far it reaches, and time Shmuel's father's mikveh by the rain."
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@300;400;700;900&display=swap" />

  <style is:global>
    :root { --basalt:#0f1d24; --deep:#16303b; --line:#2f5361; --lime:#ece3cc; --silt:#a9b4ad; --river:#4fb3c4; --reed:#9cc77a; --vow:#e07b62; --sun:#e9c46a; }
    .frank { font-family: 'Frank Ruhl Libre', serif; }
    .t-lime { color: var(--lime) !important; }
    .t-silt { color: var(--silt) !important; }
    .t-river { color: var(--river) !important; }
    .t-reed { color: var(--reed) !important; }
    .t-vow { color: var(--vow) !important; }
    .t-sun { color: var(--sun) !important; }
    a.ref { color: var(--river) !important; text-decoration: underline; text-underline-offset: 2px; }
    .stn { border-top: 1px solid var(--line); padding: 2.25rem 0; }
    .he { font-family: 'Frank Ruhl Libre', serif; direction: rtl; }
    .btn { border: 1px solid var(--line); border-radius: .4rem; padding: .5rem .8rem; font-size: .92rem; line-height: 1.4; text-align: start; background: transparent; color: var(--lime) !important; }
    .btn:hover:not(:disabled) { background: var(--deep); }
    .btn:disabled { cursor: default; opacity: .6; }
    .btn.on { border-color: var(--river); box-shadow: inset 0 0 0 1px var(--river); background: var(--deep); }
    .btn.ok { background: #1d3a26; border-color: var(--reed); opacity: 1; }
    .btn.no { background: #45231b; border-color: var(--vow); opacity: 1; }
    .btn.go { background: var(--river); border-color: var(--river); color: #0f1d24 !important; font-weight: 700; }
    .btn.go:hover:not(:disabled) { background: #8fd3de; }
    button:focus-visible, a:focus-visible { outline: 2px solid var(--sun); outline-offset: 2px; }
    .note { border-inline-start: 3px solid var(--line); padding: .3rem .8rem; font-size: .93rem; line-height: 1.65; margin-top: .75rem; color: var(--lime) !important; }
    .note.ok { border-color: var(--reed); }
    .note.no { border-color: var(--vow); }
    .note.tk { border-color: var(--sun); }
    .quote { background: #132730; border: 1px solid var(--line); border-radius: .5rem; padding: .8rem 1rem; }
    .row { display: flex; flex-wrap: wrap; gap: .4rem; align-items: center; }
    .lbl { font-size: .85rem; color: var(--silt) !important; min-width: 7.5rem; }
    svg text { font-family: 'Frank Ruhl Libre', serif; }
    .lamp { display: inline-flex; align-items: center; gap: .5rem; font-weight: 700; padding: .45rem .8rem; border-radius: 999px; border: 1px solid var(--line); }
    .lamp i { width: .8rem; height: .8rem; border-radius: 50%; background: #555; display: inline-block; }
    .lamp.yes i { background: var(--reed); box-shadow: 0 0 10px var(--reed); }
    .lamp.nope i { background: var(--vow); box-shadow: 0 0 10px var(--vow); }
    .lamp.tk i { background: var(--sun); box-shadow: 0 0 10px var(--sun); }
    .goals li { list-style: none; padding: .2rem 0; color: var(--silt) !important; }
    .goals li.hit { color: var(--reed) !important; }
    .goals li::before { content: '○ '; }
    .goals li.hit::before { content: '● '; }
    /* river network */
    .flow { fill: none; stroke: #2b5a68; stroke-width: 5; stroke-linecap: round; }
    .flow.wet { stroke: var(--vow); stroke-dasharray: 14 8; animation: run 1s linear infinite; }
    @keyframes run { to { stroke-dashoffset: -22; } }
    .cup { cursor: pointer; }
    .cup circle { fill: #16303b; stroke: var(--river); stroke-width: 2; }
    .cup.pick circle { fill: #4a2a22; stroke: var(--vow); stroke-width: 3; }
    .cup.right circle { stroke: var(--reed); stroke-width: 4; }
    .cup.wrong circle { stroke: var(--sun); stroke-width: 4; stroke-dasharray: 4 3; }
    .cup:focus-visible circle { stroke: var(--sun); stroke-width: 4; }
    .gauge { height: 160px; width: 80px; border: 2px solid var(--line); border-radius: .4rem; position: relative; overflow: hidden; background: #0c181e; }
    .gauge .spring, .gauge .rain { position: absolute; left: 0; right: 0; transition: height .6s ease, bottom .6s ease; }
    .gauge .spring { bottom: 0; background: var(--river); }
    .gauge .rain { background: repeating-linear-gradient(135deg, #8aa4ad 0 6px, #6d8a94 6px 12px); }
    @media (prefers-reduced-motion: reduce) { .flow.wet { animation: none; stroke-dasharray: none; } .gauge .spring, .gauge .rain { transition: none; } svg * { transition: none !important; } }
  </style>

  <div class="min-h-screen" style="background: var(--basalt);">
    <div class="max-w-3xl mx-auto px-4 py-10">
      <p class="text-sm t-silt"><a href="/daf/" class="ref">Daf Yomi Arcade</a> · Bekhorot 55 · <span class="he">בכורות נ״ה</span></p>
      <h1 class="frank text-5xl sm:text-6xl font-black t-lime mt-2">Downstream</h1>
      <p class="he text-2xl mt-3 t-river">זַכְרוּתָא דְּמַיָּא — פְּרָת</p>
      <p class="t-lime mt-3 text-lg leading-relaxed">
        Bekhorot 55 starts with shepherds and the animal tithe and then follows the water. How far apart can two flocks be
        and still count as one? Why does the Jordan split them? Rav Kahana says the Euphrates is "the source of all water".
        If someone swears off it, how much water is he left with?
      </p>
      <p class="t-silt mt-2 text-sm">Score: <span id="score" class="t-sun font-bold">0</span> / <span id="scoreMax">0</span> right on the first try</p>

      <!-- 1 -->
      <section class="stn" aria-labelledby="h1">
        <h2 id="h1" class="frank text-3xl font-bold t-lime">1 · The shepherd in the middle</h2>
        <p class="t-silt mt-2 leading-relaxed">
          The mishna (<a class="ref" href="https://www.sefaria.org/Bekhorot.54b" target="_blank" rel="noopener">54b</a>): animals join for the tithe
          within sixteen mil, as far as a shepherd's eye can see. Two flocks thirty-two mil apart do not join unless he has animals in the middle.
          How many? Rav says five; Shmuel says even one. Then a baraita puts five sheep in Kfar Ḥananya, five in Kfar Otnai and one in Tzippori, and says they join.
          Is that the end of Rav's view? Set up the map and complete the five goals.
        </p>

        <svg viewBox="0 0 640 210" class="w-full mt-4" role="img" aria-label="Map: Kfar Ḥananya, Tzippori in the middle, Kfar Otnai, thirty-two mil apart">
          <circle id="eyeL" cx="320" cy="110" r="150" fill="#4fb3c4" fill-opacity=".06" stroke="#4fb3c4" stroke-opacity=".35" stroke-dasharray="5 5" />
          <line x1="70" y1="110" x2="570" y2="110" stroke="#2f5361" stroke-width="2" stroke-dasharray="3 6" />
          <line id="linkL" x1="90" y1="110" x2="300" y2="110" stroke="#9cc77a" stroke-width="5" opacity="0" style="transition: opacity .4s" />
          <line id="linkR" x1="340" y1="110" x2="550" y2="110" stroke="#9cc77a" stroke-width="5" opacity="0" style="transition: opacity .4s" />
          <text x="195" y="100" text-anchor="middle" fill="#a9b4ad" font-size="13">16 mil</text>
          <text x="445" y="100" text-anchor="middle" fill="#a9b4ad" font-size="13">16 mil</text>
          <g><circle cx="70" cy="110" r="26" fill="#16303b" stroke="#ece3cc" stroke-width="2" /><text id="nL" x="70" y="116" text-anchor="middle" fill="#ece3cc" font-size="18" font-weight="700">5</text>
            <text x="70" y="160" text-anchor="middle" fill="#ece3cc" font-size="14">Kfar Ḥananya</text><text x="70" y="180" text-anchor="middle" fill="#a9b4ad" font-size="15">כפר חנניה</text></g>
          <g><circle cx="570" cy="110" r="26" fill="#16303b" stroke="#ece3cc" stroke-width="2" /><text id="nR" x="570" y="116" text-anchor="middle" fill="#ece3cc" font-size="18" font-weight="700">5</text>
            <text x="570" y="160" text-anchor="middle" fill="#ece3cc" font-size="14">Kfar Otnai</text><text x="570" y="180" text-anchor="middle" fill="#a9b4ad" font-size="15">כפר עותני</text></g>
          <g><circle cx="320" cy="110" r="22" fill="#16303b" stroke="#4fb3c4" stroke-width="2" /><text id="nM" x="320" y="118" text-anchor="middle" font-size="20">·</text>
            <text x="320" y="160" text-anchor="middle" fill="#ece3cc" font-size="14">Tzippori</text><text x="320" y="180" text-anchor="middle" fill="#a9b4ad" font-size="15">ציפורי</text></g>
          <text x="320" y="30" text-anchor="middle" fill="#a9b4ad" font-size="13">← 32 mil →</text>
        </svg>

        <div class="space-y-2 mt-2">
          <div class="row"><span class="lbl">Opinion</span><span id="opi" class="row"></span></div>
          <div class="row"><span class="lbl">Kfar Ḥananya</span><span id="sideL" class="row"></span></div>
          <div class="row"><span class="lbl">Kfar Otnai</span><span id="sideR" class="row"></span></div>
          <div class="row"><span class="lbl">In Tzippori</span><span id="mid" class="row"></span></div>
        </div>
        <p class="mt-4"><span id="lamp1" class="lamp"><i></i><span id="lampTxt" class="t-lime">—</span></span></p>
        <div id="why1" class="note"></div>
        <ul id="goals1" class="goals mt-4 text-sm"></ul>
      </section>

      <!-- 2 -->
      <section class="stn" aria-labelledby="h2">
        <h2 id="h2" class="frank text-3xl font-bold t-lime">2 · Why does the Jordan split a flock?</h2>
        <p class="t-silt mt-2 leading-relaxed">
          Rabbi Meir: <span class="he">הַיַּרְדֵּן מַפְסִיק לְמַעְשַׂר בְּהֵמָה</span>, the Jordan separates flocks for the tithe even when they are close.
          The Gemara tries two reasons. Rule each case using the reason that is currently loaded. If a case breaks the reason, you'll have to switch to the other one.
        </p>
        <div class="grid sm:grid-cols-[230px_1fr] gap-4 mt-4 items-start">
          <svg viewBox="0 0 230 420" class="w-full max-w-[230px] mx-auto" role="img" aria-label="Map of the Jordan from the Cave of Pamyas to the Dead Sea">
            <rect x="0" y="0" width="230" height="420" fill="#132730" rx="8" />
            <path d="M118 30 C 122 60, 112 70, 116 95 C 120 120, 108 140, 112 170 C 116 200, 104 230, 110 260 C 116 290, 106 310, 112 340" fill="none" stroke="#4fb3c4" stroke-width="4" />
            <ellipse cx="116" cy="88" rx="9" ry="13" fill="#4fb3c4" />
            <ellipse cx="112" cy="160" rx="18" ry="30" fill="#4fb3c4" />
            <ellipse cx="114" cy="370" rx="20" ry="40" fill="#4fb3c4" />
            <circle cx="118" cy="28" r="7" fill="#0f1d24" stroke="#ece3cc" stroke-width="2" />
            <text x="132" y="32" fill="#ece3cc" font-size="12">Cave of Pamyas</text>
            <text x="132" y="92" fill="#a9b4ad" font-size="11">Sea of Sivkhi</text>
            <text x="138" y="164" fill="#a9b4ad" font-size="11">Sea of Tiberias</text>
            <line x1="70" y1="300" x2="160" y2="300" stroke="#e9c46a" stroke-width="1.5" stroke-dasharray="4 3" />
            <text x="164" y="304" fill="#e9c46a" font-size="11">Beit Jericho</text>
            <text x="142" y="380" fill="#a9b4ad" font-size="11">Sea of Sodom</text>
            <text x="8" y="240" fill="#a9b4ad" font-size="11">west</text>
            <text x="190" y="240" fill="#a9b4ad" font-size="11">east</text>
            <rect id="bridge" x="96" y="316" width="34" height="7" fill="#e9c46a" opacity="0" />
            <g id="flockA" opacity="0" style="transition: transform .5s"><circle r="11" fill="#ece3cc" /><text y="5" text-anchor="middle" font-size="13">🐑</text></g>
            <g id="flockB" opacity="0" style="transition: transform .5s"><circle r="11" fill="#ece3cc" /><text y="5" text-anchor="middle" font-size="13">🐑</text></g>
          </svg>
          <div>
            <p class="text-sm t-silt">Loaded reason:</p>
            <div id="reasons" class="row mt-1"></div>
            <div id="jcase" class="quote mt-4"></div>
            <div id="jbtns" class="row mt-3"></div>
            <div id="jwhy"></div>
          </div>
        </div>
      </section>

      <!-- 3 -->
      <section class="stn" aria-labelledby="h3">
        <h2 id="h3" class="frank text-3xl font-bold t-lime">3 · Pour the vow</h2>
        <p class="t-silt mt-2 leading-relaxed">
          Rav Kahana names three sources. The Jordan's source is the Cave of Pamyas. Blood's source is the liver: per Rabbi Yitzḥak, a dissolved liver from a corpse
          imparts impurity at a quarter-<i>log</i>, like blood. The source of all water is the Euphrates. Rav says all rivers flow out of three rivers, and those three flow out of the Euphrates.
          What about springs higher than the Euphrates? Rav Mesharshiyya says they are its <i>ladders</i>
          (<a class="ref" href="https://www.sefaria.org/Bekhorot.55a.18-55b.1" target="_blank" rel="noopener">55a:18–55b:1</a>).
          But vows follow how people actually talk. Choose a vow and tap every cup it forbids. Then pour it and see how far it reaches.
        </p>
        <div id="vows" class="grid gap-2 mt-4"></div>
        <svg id="net" viewBox="0 0 640 330" class="w-full mt-4" role="group" aria-label="River map: Eden, Euphrates, the three rivers, all rivers, mountain springs, the Cave of Pamyas and the Jordan">
          <rect width="640" height="330" rx="10" fill="#132730" />
          <path id="f-eden" class="flow" d="M60 50 L170 50" />
          <path id="f-three" class="flow" d="M200 50 C 260 50, 260 120, 320 120" />
          <path id="f-rivers" class="flow" d="M340 120 L470 120" />
          <path id="f-ladder" class="flow" d="M200 60 C 240 200, 280 230, 330 230" />
          <path id="f-pam" class="flow" d="M350 230 L420 230" />
          <path id="f-upper" class="flow" d="M440 230 C 480 230, 490 270, 520 270" />
          <path id="f-lower" class="flow" d="M540 270 L600 300" />
          <text x="40" y="40" fill="#a9b4ad" font-size="13">Eden</text>
          <line x1="520" y1="250" x2="560" y2="290" stroke="#e9c46a" stroke-dasharray="3 3" />
          <text x="556" y="262" fill="#e9c46a" font-size="11">Beit Jericho</text>
          <g id="cups"></g>
        </svg>
        <div class="row mt-3"><button id="pour" class="btn go" type="button" disabled>Pour the vow</button><span id="vowHint" class="text-sm t-silt">Choose a vow first.</span></div>
        <div id="vowWhy"></div>
        <div id="names" class="mt-6"></div>
      </section>

      <!-- 4 -->
      <section class="stn" aria-labelledby="h4">
        <h2 id="h4" class="frank text-3xl font-bold t-lime">4 · Shmuel's father and the river</h2>
        <p class="t-silt mt-2 leading-relaxed">
          Rainwater purifies only when it is collected and still. A river purifies while flowing only if its water is really its own.
          Shmuel's father held like Rav: "when rain falls in the West, the Euphrates is the great witness", because the river swells
          (<a class="ref" href="https://www.sefaria.org/Bekhorot.55b.5-8" target="_blank" rel="noopener">55b:5–8</a>).
          Pick a month and see what the river carries. Then decide where his daughters immerse.
        </p>
        <div class="flex gap-6 items-end mt-4 flex-wrap">
          <div class="text-center">
            <div class="gauge" aria-hidden="true"><div class="rain" id="gRain"></div><div class="spring" id="gSpring"></div></div>
            <p class="text-xs t-silt mt-1">Euphrates, per Rav</p>
          </div>
          <div class="flex-1 min-w-[220px]">
            <div id="months" class="row"></div>
            <p id="gaugeTxt" class="text-sm t-silt mt-2"></p>
            <div id="mikveh" class="row mt-3"></div>
            <div id="mikWhy"></div>
          </div>
        </div>
      </section>

      <!-- 5 -->
      <section class="stn" aria-labelledby="h5">
        <h2 id="h5" class="frank text-3xl font-bold t-lime">5 · The next mishna: bought and gifted</h2>
        <p class="t-silt mt-2 leading-relaxed">
          <span class="he">הַלּוֹקֵחַ אוֹ שֶׁנִּתַּן לוֹ בְּמַתָּנָה — פָּטוּר מִמַּעְשַׂר בְּהֵמָה</span>
          (<a class="ref" href="https://www.sefaria.org/Bekhorot.55b.9-10" target="_blank" rel="noopener">55b:9–10</a>).
          Which of these lambs go into this year's tithe pen?
        </p>
        <div id="pen" class="grid sm:grid-cols-2 gap-2 mt-3"></div>
        <div id="penWhy"></div>
        <p id="final" class="t-lime mt-8 text-lg"></p>
      </section>

      <section class="stn" aria-labelledby="h6">
        <h2 id="h6" class="frank text-3xl font-bold t-lime">Learn the real daf</h2>
        <ul class="t-lime mt-3 space-y-2 list-disc ps-5">
          <li><a class="ref" href="https://www.sefaria.org/Bekhorot.55a" target="_blank" rel="noopener">Bekhorot 55a</a> and <a class="ref" href="https://www.sefaria.org/Bekhorot.55b" target="_blank" rel="noopener">55b</a> on Sefaria, with the mishna at the end of <a class="ref" href="https://www.sefaria.org/Bekhorot.54b" target="_blank" rel="noopener">54b</a></li>
          <li><a class="ref" href="https://www.sefaria.org/Rashi_on_Bekhorot.55a" target="_blank" rel="noopener">Rashi</a> (39 comments) and <a class="ref" href="https://www.sefaria.org/Rabbeinu_Gershom_on_Bekhorot.55a" target="_blank" rel="noopener">Rabbeinu Gershom</a> (26), on Tzippori in the middle, the bridge and the ladders of the Euphrates</li>
          <li><a class="ref" href="https://www.sefaria.org/Steinsaltz_on_Bekhorot.55a" target="_blank" rel="noopener">Steinsaltz</a> (32), <a class="ref" href="https://www.sefaria.org/Tosafot_on_Bekhorot.55a.8.1" target="_blank" rel="noopener">Tosafot</a> (11) and <a class="ref" href="https://www.sefaria.org/Rashash_on_Bekhorot.55a.2" target="_blank" rel="noopener">Rashash</a> (17)</li>
          <li>The verses: <a class="ref" href="https://www.sefaria.org/Joshua.18.20" target="_blank" rel="noopener">Josh. 18:20</a>, <a class="ref" href="https://www.sefaria.org/Joshua.18.12-14" target="_blank" rel="noopener">Josh. 18:12–14</a>, <a class="ref" href="https://www.sefaria.org/Numbers.34.12-15" target="_blank" rel="noopener">Num. 34:12–15</a>, <a class="ref" href="https://www.sefaria.org/Numbers.35.10" target="_blank" rel="noopener">Num. 35:10</a>, <a class="ref" href="https://www.sefaria.org/Joshua.19.47" target="_blank" rel="noopener">Josh. 19:47</a>, <a class="ref" href="https://www.sefaria.org/Genesis.2.10-14" target="_blank" rel="noopener">Gen. 2:10–14</a>, <a class="ref" href="https://www.sefaria.org/Jeremiah.17.8" target="_blank" rel="noopener">Jer. 17:8</a>, <a class="ref" href="https://www.sefaria.org/Exodus.22.28-29" target="_blank" rel="noopener">Ex. 22:28–29</a></li>
          <li><a class="ref" href="https://www.sefaria.org/Torah_Temimah_on_Torah,_Genesis.2.14.3" target="_blank" rel="noopener">Torah Temimah on Gen. 2:14</a> and <a class="ref" href="https://www.sefaria.org/Torah_Temimah_on_Torah,_Numbers.34.12.1" target="_blank" rel="noopener">on Num. 34:12</a></li>
        </ul>
      </section>
    </div>
  </div>

  <script is:inline>
  (() => {
    const $ = (s, r = document) => r.querySelector(s);
    const el = (tag, cls, html) => { const e = document.createElement(tag); if (cls) e.className = cls; if (html != null) e.innerHTML = html; return e; };
    const ref = (r, label) => `<a class="ref" href="https://www.sefaria.org/${r.replace(/ /g, '_')}" target="_blank" rel="noopener">${label}</a>`;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const sleep = (ms) => new Promise(r => setTimeout(r, reduce ? 0 : ms));
    let score = 0, max = 0;
    const done = new Set();
    const bump = (ok) => { if (ok) score++; $('#score').textContent = score; };
    const register = (n) => { max += n; $('#scoreMax').textContent = max; };
    const finish = (k) => {
      done.add(k);
      if (done.size === 5) {
        const pct = score / max;
        $('#final').innerHTML = `You scored <b class="t-sun">${score} / ${max}</b>. ` + (pct > .8
          ? 'You followed every flock and every stream back to its source. <span class="he">זַכְרוּתָא דְּמַיָּא — פְּרָת</span>.'
          : 'The Gemara needed two tries at the Jordan too. Play again and see where else your ruling changes.');
      }
    };

    // ---------- 1. Shepherd in the middle ----------
    const s1 = { op: 'shmuel', L: 5, R: 5, M: 'none' };
    const MID = [
      ['none', 'nothing', ''], ['one', '1 sheep', '🐑'], ['five', '5 sheep', '🐑×5'],
      ['shep', 'the shepherd', '🧑‍🌾'], ['kit', "the shepherd's bag and staff", '🎒'], ['dog', "the shepherd's dog", '🐕'],
    ];
    const rule1 = ({ op, L, R, M }) => {
      if (M === 'none') return ['nope', "Don't join", "With nothing in the middle, thirty-two mil is too far. The mishna only joins them when he has animals in the middle (54b)."];
      if (M === 'five') return ['yes', 'Join', op === 'rav'
        ? `Rav: five in the middle can make ten with either side, so all three flocks are one (${ref('Bekhorot 54b', '54b')}).`
        : `Shmuel accepts five too, since he would accept even one. Count all three in one pen in the middle.`];
      if (M === 'one') {
        if (op === 'shmuel') return ['yes', 'Join', `Shmuel: we see the shepherd standing in the middle as "the one who counts them" (Jer. 33:13), and one sheep there is enough (${ref('Bekhorot 54b', '54b')}).`];
        if (L === 9 && R === 9) return ['yes', 'Join', `Shmuel explained the baraita in line with Rav (<span class="he">תַּרְגְּמַהּ שְׁמוּאֵל אַלִּיבָּא דְּרַב</span>): nine on each side and one in the middle. That one sheep makes ten with this side and ten with that side (${ref('Bekhorot 55a.2', '55a:2')}).`];
        return ['nope', "Don't join", `By Rav's reasoning the middle animals must be able to make ten with <i>each</i> side. One sheep only does that when both sides have nine (${ref('Bekhorot 55a.2', '55a:2')}). ${L === 5 && R === 5 ? 'This is the baraita, read literally. It refutes Rav (<span class="he">תְּיוּבְתָּא דְּרַב</span>) until it is reread.' : ''}`];
      }
      if (op === 'rav') return ['nope', "Don't join", `Rav needs animals in the middle that can make ten. Rav Pappa's extensions are said "according to Shmuel" (<span class="he">וְלִשְׁמוּאֵל</span>, ${ref('Bekhorot 55a.3', '55a:3')}).`];
      if (M === 'shep') return ['yes', 'Join', `Rav Pappa: according to Shmuel, even the shepherd himself in the middle joins them (${ref('Bekhorot 55a.3', '55a:3')}).`];
      if (M === 'kit') return ['yes', 'Join', `Rav Pappa: even the shepherd's gear in the middle joins them. He will have to come back for it, so it is as if he were already there (${ref('Bekhorot 55a.3', '55a:3')}).`];
      return ['tk', 'Unresolved (teiku)', `Rav Ashi asks: he calls the dog and it comes, so he doesn't have to go there? Or sometimes it won't come, and he has to go and fetch it? <span class="he">תֵּיקוּ</span>, the question stands (${ref('Bekhorot 55a.4', '55a:4')}).`];
    };
    const GOALS = [
      ['Make the baraita refute Rav (5 · 1 · 5, "don\'t join")', s => s.op === 'rav' && s.L === 5 && s.R === 5 && s.M === 'one'],
      ["Rescue Rav with Shmuel's reading of the baraita", s => s.op === 'rav' && s.L === 9 && s.R === 9 && s.M === 'one'],
      ['Join two flocks with no animal in the middle', s => s.op === 'shmuel' && (s.M === 'shep' || s.M === 'kit')],
      ["Find Rav Ashi's unresolved question", s => s.op === 'shmuel' && s.M === 'dog'],
      ["Join the flocks Rav's own way, with five", s => s.op === 'rav' && s.M === 'five'],
    ];
    const hit1 = new Set();
    register(0);
    const draw1 = () => {
      const mk = (box, items, key) => { const b = $(box); b.innerHTML = ''; items.forEach(([v, lab]) => { const x = el('button', 'btn' + (s1[key] === v ? ' on' : ''), lab); x.type = 'button'; x.setAttribute('aria-pressed', s1[key] === v); x.onclick = () => { s1[key] = v; draw1(); }; b.append(x); }); };
      mk('#opi', [['rav', 'Rav'], ['shmuel', 'Shmuel']], 'op');
      mk('#sideL', [[5, '5 sheep'], [9, '9 sheep']], 'L');
      mk('#sideR', [[5, '5 sheep'], [9, '9 sheep']], 'R');
      mk('#mid', MID.map(m => [m[0], m[1]]), 'M');
      $('#nL').textContent = s1.L; $('#nR').textContent = s1.R;
      const m = MID.find(x => x[0] === s1.M);
      $('#nM').textContent = m[2] ? (m[0] === 'five' ? '5' : m[2]) : '·';
      $('#nM').setAttribute('fill', '#ece3cc');
      const [k, txt, why] = rule1(s1);
      $('#lamp1').className = 'lamp ' + k; $('#lampTxt').textContent = txt;
      $('#why1').className = 'note ' + (k === 'yes' ? 'ok' : k === 'tk' ? 'tk' : 'no'); $('#why1').innerHTML = why;
      const on = k === 'yes' ? 1 : k === 'tk' ? .45 : 0;
      $('#linkL').setAttribute('opacity', on); $('#linkR').setAttribute('opacity', on);
      $('#linkL').setAttribute('stroke', k === 'tk' ? '#e9c46a' : '#9cc77a'); $('#linkR').setAttribute('stroke', k === 'tk' ? '#e9c46a' : '#9cc77a');
      GOALS.forEach((g, i) => { if (g[1](s1) && !hit1.has(i)) { hit1.add(i); bump(true); } });
      const ul = $('#goals1'); ul.innerHTML = '';
      GOALS.forEach((g, i) => ul.append(el('li', hit1.has(i) ? 'hit' : '', g[0])));
      if (hit1.size === GOALS.length) finish('s1');
    };
    max += GOALS.length; $('#scoreMax').textContent = max;
    draw1();

    // ---------- 2. Jordan ----------
    const REASONS = {
      ami: ['Rabbi Ami: they can\'t cross', 'Rabbi Ami (55a:5): the river separates because the animals cannot cross to each other. So a bridge joins them.'],
      yoh: ['Rabbi Yoḥanan: the verse makes it a border', 'Rabbi Ḥiyya bar Abba citing Rabbi Yoḥanan (55a:8): "And the Jordan shall border it on the east" (Josh. 18:20). The verse makes the Jordan a border in its own right.'],
    };
    let reason = 'ami';
    // positions on the svg map
    const P = { wS: [80, 330], eS: [150, 330], wN: [80, 200], eN: [150, 200], in: [70, 120], out: [200, 60], ben: [50, 280], jud: [50, 315], nm1: [175, 120], nm2: [205, 140] };
    const JC = [
      { pos: ['wS', 'eS'], bridge: false, text: 'Flocks on both banks below Beit Jericho, a short walk apart. No bridge.', ans: { ami: false, yoh: false },
        why: { ami: `The river is in the way, so the animals can't cross (${ref('Bekhorot 55a.5', '55a:5')}).`, yoh: `The verse makes the Jordan a border (${ref('Bekhorot 55a.8', '55a:8')}).` } },
      { pos: ['wS', 'eS'], bridge: true, text: 'The same two flocks, but now a bridge crosses the river.', ans: { ami: true, yoh: false },
        why: { ami: `<span class="he">יֵשׁ שָׁם גֶּשֶׁר — גֶּשֶׁר מְצָרְפָן</span>: a bridge joins them (${ref('Bekhorot 55a.5', '55a:5')}).`, yoh: `A Torah border doesn't care about bridges: "the verse made it a border in its own right" (${ref('Bekhorot 55a.8', '55a:8')}).` } },
      { pos: ['in', 'out'], bridge: false, text: "One flock just inside Eretz Yisrael, one just outside it, with dry land between them. It's as if there were a bridge.", ans: { ami: true, yoh: false }, breaksAmi: true,
        why: { ami: `The baraita says they <b>do not</b> join, even though nothing stops the animals from crossing (${ref('Bekhorot 55a.6-7', '55a:6–7')}). Rabbi Ami's reason can't explain that, so the Gemara drops it: <span class="he">אֶלָּא</span>… Load Rabbi Yoḥanan's reason and keep going.`, yoh: `They don't join. The baraita treats the Land's own boundary as a border (${ref('Bekhorot 55a.6-7', '55a:6–7')}).` } },
      { pos: ['nm1', 'nm2'], bridge: false, text: 'Two flocks in two neighbouring counties, Namer and Namori, under the same ruler, less than 32 mil apart, with no river between.', ans: { ami: false, yoh: false },
        why: { ami: `The baraita: they don't join, even under one ruler (${ref('Bekhorot 55a.6', '55a:6')}).`, yoh: `The baraita: they don't join, even under one ruler (${ref('Bekhorot 55a.6', '55a:6')}).` } },
      { pos: ['ben', 'jud'], bridge: false, text: "Flocks on either side of the line between Benjamin and Judah, near Kiriath Jearim. Joshua 18:14 calls that line a border too.", ans: { ami: true, yoh: true }, onlyYoh: true,
        why: { yoh: `They join. "This shall be your land according to its borders round about" (Num. 34:12) makes the whole Land one border, whatever the tribal lines inside it (${ref('Bekhorot 55a.9-10', '55a:9–10')}). The Jordan is different: "your <i>land</i>" means connected land, and the Jordan is water (${ref('Bekhorot 55a.11', '55a:11')}).` } },
      { pos: ['wN', 'eN'], bridge: false, text: 'Flocks on both banks of the river south of the Sea of Tiberias, above Beit Jericho.', ans: { ami: true, yoh: true }, onlyYoh: true,
        why: { yoh: `Rabba bar bar Ḥana citing Rabbi Yoḥanan: <span class="he">אֵין ״יַרְדֵּן״ אֶלָּא מִבֵּית יְרֵחוֹ וּלְמַטָּה</span>. For the animal tithe it is "the Jordan" only from Beit Jericho south, so up here it doesn't divide. That can't be about vows, because vows follow ordinary speech (${ref('Bekhorot 55a.15-16', '55a:15–16')}).` } },
    ];
    register(JC.length);
    let ji = 0, jFirst = true, amiBroken = false;
    const place = (id, key) => { const g = $(id); const [x, y] = P[key]; g.setAttribute('opacity', 1); g.setAttribute('transform', `translate(${x} ${y})`); };
    const drawReasons = () => {
      const b = $('#reasons'); b.innerHTML = '';
      Object.entries(REASONS).forEach(([k, [lab]]) => {
        const x = el('button', 'btn' + (reason === k ? ' on' : ''), lab); x.type = 'button'; x.setAttribute('aria-pressed', reason === k);
        if (k === 'ami' && amiBroken) { x.disabled = true; x.innerHTML = lab + ' <span class="t-vow">(dropped)</span>'; }
        x.onclick = () => { reason = k; drawReasons(); drawJ(); }; b.append(x);
      });
    };
    const drawJ = () => {
      const c = JC[ji];
      $('#jwhy').innerHTML = '';
      if (!c) {
        $('#jcase').innerHTML = `<p class="t-lime">The Jordan's line is drawn. One question is left over. If Rabbi Ami were right, why didn't Rabbi Meir say "every river you can't cross"? <span class="he">קַשְׁיָא</span>, the difficulty stands (${ref('Bekhorot 55a.12', '55a:12')}).</p>
          <p class="t-silt mt-2 text-sm">And is the riverbed itself part of the Land? Rabbi Yehuda ben Beteira reads "<i>into</i> the land" (Num. 35:10) as no. Rabbi Shimon bar Yoḥai reads "the Jordan at Jericho" (Num. 34:15) as yes: just as Jericho is in Canaan, so is the Jordan (${ref('Bekhorot 55a.13-14', '55a:13–14')}).</p>`;
        $('#jbtns').innerHTML = ''; ['#flockA', '#flockB'].forEach(i => $(i).setAttribute('opacity', 0)); $('#bridge').setAttribute('opacity', 0);
        finish('s2'); return;
      }
      place('#flockA', c.pos[0]); place('#flockB', c.pos[1]);
      $('#bridge').setAttribute('opacity', c.bridge ? 1 : 0);
      $('#jcase').innerHTML = `<p class="text-sm t-silt">Case ${ji + 1} of ${JC.length}</p><p class="t-lime mt-1">${c.text}</p>`;
      const b = $('#jbtns'); b.innerHTML = '';
      if (c.onlyYoh && reason !== 'yoh') { b.append(el('p', 'text-sm t-sun', 'This case comes after the Gemara drops Rabbi Ami. Load Rabbi Yoḥanan\'s reason.')); return; }
      [[true, 'They join'], [false, "They don't join"]].forEach(([v, lab]) => {
        const x = el('button', 'btn', lab); x.type = 'button';
        x.onclick = async () => {
          const ok = c.ans[reason] === v;
          if (jFirst) { bump(ok && !(c.breaksAmi && reason === 'ami')); jFirst = false; }
          [...b.children].forEach(y => y.disabled = true); x.classList.add(ok ? 'ok' : 'no');
          let why = c.why[reason];
          if (c.breaksAmi && reason === 'ami') { amiBroken = true; why = (ok ? 'By Rabbi Ami\'s logic, yes, they should join. ' : '') + why; }
          $('#jwhy').innerHTML = `<div class="note ${ok && !(c.breaksAmi && reason === 'ami') ? 'ok' : 'no'}">${ok ? '' : 'Not under this reason. '}${why}</div>`;
          if (c.breaksAmi && reason === 'ami') { drawReasons(); const n = el('button', 'btn go mt-3', 'Load Rabbi Yoḥanan and re-rule'); n.type = 'button'; n.onclick = () => { reason = 'yoh'; drawReasons(); jFirst = false; drawJ(); }; $('#jwhy').append(n); return; }
          const n = el('button', 'btn go mt-3', 'Next case'); n.type = 'button';
          n.onclick = () => { ji++; jFirst = true; drawJ(); }; $('#jwhy').append(n);
          if (ji === 1 && reason === 'ami') $('#jwhy').append(el('p', 'text-sm t-silt mt-2', 'Tip: try the bridge again later under the other reason.'));
        };
        b.append(x);
      });
    };
    drawReasons(); drawJ();

    // ---------- 3. Pour the vow ----------
    const CUPS = [
      { id: 'eu', x: 185, y: 50, label: 'Euphrates', flows: ['f-eden'] },
      { id: 'tig', x: 330, y: 120, label: 'Tigris, Gihon, Pishon', flows: ['f-three'] },
      { id: 'riv', x: 480, y: 120, label: 'any river', flows: ['f-rivers'] },
      { id: 'spr', x: 210, y: 175, label: 'a mountain spring', flows: [] },
      { id: 'pam', x: 340, y: 230, label: 'Cave of Pamyas', flows: ['f-ladder'] },
      { id: 'up', x: 430, y: 230, label: 'Jordan above Jericho', flows: ['f-pam'] },
      { id: 'lo', x: 600, y: 300, label: 'Jordan below Jericho', flows: ['f-upper', 'f-lower'] },
    ];
    const VOWS = [
      { he: 'לָא שָׁתֵינָא מַיִם מִמְּעָרַת פַּמְיָיס', en: '"I will not drink water from the Cave of Pamyas."', forb: ['pam', 'up', 'lo'], wet: ['f-pam', 'f-upper', 'f-lower'],
        why: `Rav Kahana: the Jordan's source (<span class="he">זַכְרוּתֵיהּ דְּיַרְדְּנָא</span>) is the Cave of Pamyas, so he may not drink from the whole Jordan. The name says so too: <i>Yarden</i> "goes down from Dan", and Leshem, renamed Dan, is Pamyas (Josh. 19:47; ${ref('Bekhorot 55a.17-18', '55a:17–18')}). The Euphrates and other rivers are still permitted.` },
      { he: 'נֶדֶר מִמֵּי הַיַּרְדֵּן', en: '"Jordan water is forbidden to me."', forb: ['up', 'lo'], wet: ['f-upper', 'f-lower'],
        why: `Vows follow how people talk (<span class="he">הַלֵּךְ אַחַר לְשׁוֹן בְּנֵי אָדָם</span>). Wherever people call it the Jordan is forbidden, above Beit Jericho as well as below. Rabbi Yoḥanan's "only from Beit Jericho down" applies to the tithe, not to vows (${ref('Bekhorot 55a.15', '55a:15')}). Nobody calls the cave "the Jordan".` },
      { he: 'הַנּוֹדֵר מִמֵּימֵי פְּרָת', en: '"I will not drink the water of the Euphrates."', forb: ['eu'], wet: ['f-eden'],
        why: `In ordinary speech, "Euphrates water" means the Euphrates itself, so he may still drink from any other river (${ref('Bekhorot 55a.21', '55a:21')}).` },
      { he: 'לָא שָׁתֵינָא מִמַּיִם דְּאָתוּ מִפְּרָת', en: '"I will not drink any water that comes from the Euphrates."', forb: ['eu', 'tig', 'riv', 'spr', 'pam', 'up', 'lo'], wet: ['f-eden', 'f-three', 'f-rivers', 'f-ladder', 'f-pam', 'f-upper', 'f-lower'],
        why: `Rav: all rivers flow out of the three rivers, and the three flow out of the Euphrates. Mountain springs higher than the river are "ladders of the Euphrates", where its water rises up through the ground (Rav Mesharshiyya). This vow forbids every water in the world (${ref('Bekhorot 55a.22-55b.1', '55a:22–55b:1')}).` },
    ];
    register(VOWS.length);
    let vow = null; const picked = new Set(); const vowDone = new Set();
    const cupG = $('#cups');
    CUPS.forEach(c => {
      const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      g.setAttribute('class', 'cup'); g.setAttribute('tabindex', '0'); g.setAttribute('role', 'button'); g.setAttribute('aria-pressed', 'false'); g.setAttribute('aria-label', 'Cup: ' + c.label); g.dataset.id = c.id;
      g.innerHTML = `<circle cx="${c.x}" cy="${c.y}" r="13"></circle><text x="${c.x}" y="${c.y + 5}" text-anchor="middle" font-size="13">🥛</text><text x="${c.x}" y="${c.y + (c.id === 'lo' ? -20 : 30)}" text-anchor="middle" fill="#ece3cc" font-size="12">${c.label}</text>`;
      const tog = () => { if (!vow || g.dataset.locked) return; picked.has(c.id) ? picked.delete(c.id) : picked.add(c.id); g.classList.toggle('pick', picked.has(c.id)); g.setAttribute('aria-pressed', picked.has(c.id)); };
      g.addEventListener('click', tog); g.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); tog(); } });
      cupG.append(g);
    });
    const resetNet = () => { picked.clear(); document.querySelectorAll('.cup').forEach(g => { g.classList.remove('pick', 'right', 'wrong'); g.setAttribute('aria-pressed', 'false'); delete g.dataset.locked; }); document.querySelectorAll('.flow').forEach(f => f.classList.remove('wet')); $('#vowWhy').innerHTML = ''; };
    const drawVows = () => {
      const b = $('#vows'); b.innerHTML = '';
      VOWS.forEach((v, i) => {
        const x = el('button', 'btn' + (vow === i ? ' on' : '') + (vowDone.has(i) ? ' ok' : ''), `<span class="he text-lg block">${v.he}</span><span class="text-sm">${v.en}</span>`);
        x.type = 'button'; x.setAttribute('aria-pressed', vow === i);
        x.onclick = () => { vow = i; resetNet(); drawVows(); $('#pour').disabled = false; $('#vowHint').textContent = 'Tap every cup this vow forbids, then pour.'; };
        b.append(x);
      });
    };
    $('#pour').onclick = async () => {
      if (vow == null) return;
      const v = VOWS[vow]; $('#pour').disabled = true;
      document.querySelectorAll('.cup').forEach(g => g.dataset.locked = '1');
      for (const f of ['f-eden', 'f-three', 'f-rivers', 'f-ladder', 'f-pam', 'f-upper', 'f-lower']) if (v.wet.includes(f)) { $('#' + f).classList.add('wet'); await sleep(260); }
      let ok = true;
      document.querySelectorAll('.cup').forEach(g => { const id = g.dataset.id; const f = v.forb.includes(id); const p = picked.has(id); if (f === p) { if (f) g.classList.add('right'); } else { ok = false; g.classList.add('wrong'); } });
      if (!vowDone.has(vow)) { vowDone.add(vow); bump(ok); }
      $('#vowWhy').innerHTML = `<div class="note ${ok ? 'ok' : 'no'}">${ok ? 'Exactly right.' : 'Not quite. Dashed yellow rings mark the cups you got wrong.'} ${v.why}</div>`;
      $('#vowHint').textContent = vowDone.size < VOWS.length ? 'Choose another vow.' : 'All four vows poured.';
      drawVows();
      if (vowDone.size === VOWS.length && !$('#names').innerHTML) drawNames();
    };
    drawVows();

    const drawNames = () => {
      const q = { q: 'Why is the Euphrates called <span class="he">פְּרָת</span>, and what was its name where it leaves Eden?', opts: [
        ['Its waters are fruitful and multiply (<i>parim ve-ravim</i>) without rain. At Eden it is called <i>Yuval</i>.', true],
        ['It divides (<i>poret</i>) into four heads. At Eden it is called <i>Gihon</i>.', false],
        ['It is the fourth and least of the rivers, so it got a short name. At Eden it is called <i>Pishon</i>.', false]],
        why: `Rabbi Meir: "like a tree planted by the waters, spreading its roots by the <i>yuval</i>" (Jer. 17:8). And though Genesis lists it last, Rav Naḥman bar Yitzḥak says the Euphrates is the river that "went out of Eden" and kept flowing after the other three branched off (${ref('Bekhorot 55b.2-4', '55b:2–4')}).` };
      register(1);
      const box = $('#names'); box.innerHTML = `<p class="t-lime">${q.q}</p>`;
      const r = el('div', 'grid gap-2 mt-2'); box.append(r);
      q.opts.forEach(([t, v]) => { const x = el('button', 'btn', t); x.type = 'button'; x.onclick = () => { [...r.children].forEach(y => y.disabled = true); x.classList.add(v ? 'ok' : 'no'); bump(v); box.append(el('div', 'note ' + (v ? 'ok' : 'no'), q.why)); finish('s3'); }; r.append(x); });
    };

    // ---------- 4. Shmuel's father ----------
    const MONTHS = {
      nisan: { lab: 'Nisan (after the rainy season)', spring: 40, rain: 60, txt: 'The winter rain in the West has swollen the river. Rainwater may now be most of what flows past.', ans: 'mik' },
      tishrei: { lab: 'Tishrei (after the dry summer)', spring: 85, rain: 0, txt: 'No rain all summer. What flows now is the river\'s own water.', ans: 'mats' },
    };
    register(2);
    let month = null; const mDone = new Set();
    const drawMonths = () => {
      const b = $('#months'); b.innerHTML = '';
      Object.entries(MONTHS).forEach(([k, m]) => { const x = el('button', 'btn' + (month === k ? ' on' : '') + (mDone.has(k) ? ' ok' : ''), m.lab); x.type = 'button'; x.setAttribute('aria-pressed', month === k); x.onclick = () => { month = k; drawMonths(); drawMik(); }; b.append(x); });
      const m = MONTHS[month];
      $('#gSpring').style.height = (m ? m.spring : 50) + '%';
      $('#gRain').style.bottom = (m ? m.spring : 50) + '%'; $('#gRain').style.height = (m ? m.rain : 0) + '%';
      $('#gaugeTxt').textContent = m ? m.txt : 'Choose a month.';
    };
    const drawMik = () => {
      const b = $('#mikveh'); b.innerHTML = ''; $('#mikWhy').innerHTML = '';
      if (!month) return;
      if (mDone.has(month)) { b.append(el('p', 'text-sm t-silt', 'Already decided. Try the other month.')); return; }
      [['mik', 'Build a mikveh of still water'], ['mats', 'Immerse in the river, behind mats']].forEach(([v, lab]) => {
        const x = el('button', 'btn', lab); x.type = 'button';
        x.onclick = () => {
          const ok = MONTHS[month].ans === v; mDone.add(month); bump(ok);
          [...b.children].forEach(y => y.disabled = true); x.classList.add(ok ? 'ok' : 'no');
          $('#mikWhy').innerHTML = `<div class="note ${ok ? 'ok' : 'no'}">${month === 'nisan'
            ? `In Nisan he made them a mikveh. Rainwater and snowmelt might be the majority of the river, and rainwater does not purify while it flows (${ref('Bekhorot 55b.6', '55b:6')}).`
            : `In Tishrei he set up mats in the Euphrates so his daughters could immerse in private. The river's water was its own, and that purifies even while flowing (${ref('Bekhorot 55b.7', '55b:7')}).`}</div>`;
          drawMonths();
          if (mDone.size === 2) {
            $('#mikWhy').append(el('div', 'note tk', `And Shmuel himself? He said "the river is blessed from its own bed", which agrees with Rabbi Meir's <i>parim ve-ravim</i>. But he also ruled that flowing water purifies "only the Euphrates in the days of Tishrei", which sounds like his father's view. <span class="he">פְּלִיגָא דִּידֵיהּ אַדִּידֵיהּ</span>: his two statements disagree (${ref('Bekhorot 55b.5', '55b:5')}, ${ref('Bekhorot 55b.8', '55b:8')}).`));
            finish('s4');
          }
        };
        b.append(x);
      });
    };
    drawMonths();

    // ---------- 5. Bought and gifted ----------
    const LAMBS = [
      ['🐑 Born this year in his own flock', true, 'Born in his own flock: tithed.'],
      ['🛒 Bought at the market last month', false, 'Bought animals are exempt (55b:9).'],
      ['🎁 A gift from his brother-in-law', false, 'An animal received as a gift is exempt too (55b:9).'],
      ['🍼 Born this year to an ewe he had bought', true, 'Born in his own flock: tithed. Only an animal that was itself bought or gifted is exempt.'],
    ];
    register(LAMBS.length);
    let penCount = 0;
    const pen = $('#pen');
    LAMBS.forEach(([lab, tithe, why]) => {
      const card = el('div', 'quote');
      card.append(el('p', 't-lime', lab));
      const r = el('div', 'row mt-2'); card.append(r);
      [[true, 'Into the pen'], [false, 'Exempt']].forEach(([v, l]) => {
        const x = el('button', 'btn', l); x.type = 'button';
        x.onclick = () => { const ok = v === tithe; bump(ok); [...r.children].forEach(y => y.disabled = true); x.classList.add(ok ? 'ok' : 'no'); card.append(el('div', 'note ' + (ok ? 'ok' : 'no'), why)); if (++penCount === LAMBS.length) { $('#penWhy').innerHTML = `<div class="note">Where does the rule come from? Rav Kahana cites "So you shall do with <i>your</i> oxen and with <i>your</i> sheep" (Ex. 22:29). The derivation continues on ${ref('Bekhorot 56a', '56a')} (${ref('Bekhorot 55b.10', '55b:10')}).</div>`; finish('s5'); } };
        r.append(x);
      });
      pen.append(card);
    });
  })();
  </script>
</Layout>
