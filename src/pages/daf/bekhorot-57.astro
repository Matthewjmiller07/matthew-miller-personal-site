---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Under the Rod — Daf Yomi Game: Bekhorot 57"
  description="Bekhorot 57: work the gate of the tithe pen, citing the word of the verse that turns each animal away; see why ten lambs swapped for one dog are all forbidden; and turn the year wheel to see which lambs join for the animal tithe under Rabbi Meir, Ben Azzai, and Rabbi Elazar and Rabbi Shimon."
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@300;400;700;900&display=swap" />

  <style is:global>
    :root { --dusk:#121a24; --pen:#1c2733; --line:#34465a; --wool:#ece4d3; --mist:#9fb0c2; --ochre:#c9472f; --lamp:#e7b75a; --grass:#8fbf7a; }
    .frank { font-family: 'Frank Ruhl Libre', serif; }
    .t-wool { color: var(--wool) !important; }
    .t-mist { color: var(--mist) !important; }
    .t-lamp { color: var(--lamp) !important; }
    .t-grass { color: var(--grass) !important; }
    .t-ochre { color: #e0705a !important; }
    a.ref { color: var(--lamp) !important; text-decoration: underline; text-underline-offset: 2px; }
    .stn { border-top: 1px solid var(--line); padding: 2.25rem 0; }
    .he { font-family: 'Frank Ruhl Libre', serif; direction: rtl; }
    .btn { border: 1px solid var(--line); border-radius: .4rem; padding: .5rem .8rem; font-size: .92rem; line-height: 1.4; text-align: start; background: transparent; color: var(--wool) !important; }
    .btn:hover:not(:disabled) { background: var(--pen); }
    .btn:disabled { cursor: default; opacity: .6; }
    .btn.on { border-color: var(--lamp); box-shadow: inset 0 0 0 1px var(--lamp); background: var(--pen); opacity: 1; }
    .btn.ok { background: #20331f; border-color: var(--grass); opacity: 1; }
    .btn.no { background: #3d1f1a; border-color: var(--ochre); opacity: 1; }
    button:focus-visible, a:focus-visible, input:focus-visible, select:focus-visible { outline: 2px solid var(--lamp); outline-offset: 2px; }
    .note { border-inline-start: 3px solid var(--line); padding: .3rem .8rem; font-size: .93rem; line-height: 1.65; margin-top: .75rem; color: var(--wool) !important; }
    .note.ok { border-color: var(--grass); }
    .note.no { border-color: var(--ochre); }
    .note.tk { border-color: var(--lamp); }
    .card { background: var(--pen); border: 1px solid var(--line); border-radius: .6rem; padding: 1rem; }
    .row { display: flex; flex-wrap: wrap; gap: .4rem; align-items: center; }
    .phrase { border: 1px dashed var(--line); border-radius: .4rem; padding: .35rem .6rem; background: transparent; color: var(--wool) !important; text-align: center; }
    .phrase:hover:not(:disabled) { border-style: solid; border-color: var(--lamp); }
    .phrase .gl { display: block; font-family: system-ui, sans-serif; font-size: .7rem; color: var(--mist) !important; direction: ltr; }
    .phrase.ok { border: 1px solid var(--grass); background: #20331f; }
    .phrase.no { border: 1px solid var(--ochre); background: #3d1f1a; }
    .rod { height: 4px; background: linear-gradient(90deg, #6b4a2b, #a9784a); border-radius: 2px; }
    .animal { font-size: 3rem; line-height: 1; transition: transform .45s ease; }
    .animal.in { transform: translateX(40%) scale(.9); }
    .animal.out { transform: translateX(-40%) rotate(-8deg); opacity: .6; }
    .chip { border: 1px solid var(--line); border-radius: 999px; padding: .35rem .8rem; color: var(--wool) !important; background: transparent; }
    .chip.ex { border-color: var(--ochre); background: #3d1f1a; }
    .chip.ad { border-color: var(--grass); background: #20331f; }
    select { background: var(--dusk); color: var(--wool); border: 1px solid var(--line); border-radius: .4rem; padding: .35rem .5rem; max-width: 100%; }
    input[type=range] { accent-color: var(--lamp); width: 100%; }
    .lamp { display: inline-flex; align-items: center; gap: .4rem; border: 1px solid var(--line); border-radius: .4rem; padding: .3rem .6rem; font-size: .88rem; color: var(--wool) !important; }
    .lamp i { width: .7rem; height: .7rem; border-radius: 50%; background: #3a4654; display: inline-block; }
    .lamp.y i { background: var(--grass); box-shadow: 0 0 8px var(--grass); }
    .lamp.n i { background: var(--ochre); box-shadow: 0 0 8px var(--ochre); }
    .bar { transition: fill .4s ease, height .4s ease, y .4s ease; }
    @media (prefers-reduced-motion: reduce) { .animal, .bar { transition: none !important; } }
  </style>

  <div class="min-h-screen" style="background: var(--dusk);">
    <main class="max-w-3xl mx-auto px-4 py-10">
      <p class="text-sm uppercase tracking-widest t-mist"><a href="/daf/" class="ref">Daf Yomi Arcade</a> · Bekhorot 57 · <span class="he">בכורות נ״ז</span></p>
      <h1 class="frank text-5xl font-black mt-2 t-wool">Under the Rod</h1>
      <p class="mt-3 text-lg t-mist">
        Once a year (well, three times) the shepherd herds the year's newborns into a pen, and they file out one by one
        under his rod. Every tenth gets a dab of red ochre: it is holy. Today's daf asks <i>who gets into the pen at all</i>,
        and <i>which lambs are counted together</i>.
      </p>
      <div class="rod mt-6"></div>

      <!-- 1. GATE -->
      <section class="stn" aria-labelledby="h1">
        <h2 id="h1" class="frank text-3xl font-bold t-wool">1 · Work the gate</h2>
        <p class="mt-2 t-mist">
          The mishna: <span class="he t-wool">הַכֹּל נִכְנָסִין לַדִּיר לְהִתְעַשֵּׂר</span>, everything enters the pen to be tithed, except
          five (<a class="ref" href="https://www.sefaria.org/Bekhorot.57a.6" target="_blank" rel="noopener">57a:6</a>). The Gemara takes the exclusions from the verse on offerings,
          "<i>under</i> its mother," via a <i>gezeira shava</i> with the tithe's "<i>under</i> the rod"
          (<a class="ref" href="https://www.sefaria.org/Bekhorot.57a.7-8" target="_blank" rel="noopener">57a:7–8</a>).
          Admit each animal, or turn it away by tapping the words that exclude it.
        </p>
        <div class="card mt-5">
          <div class="flex items-center justify-between gap-3">
            <p class="text-sm t-mist" id="gCount"></p>
            <p class="text-sm t-lamp" id="gScore"></p>
          </div>
          <div class="flex items-center gap-4 mt-3">
            <div class="animal" id="gEmoji" aria-hidden="true">🐑</div>
            <div>
              <p class="frank text-xl font-bold t-wool" id="gTitle"></p>
              <p class="t-wool mt-1" id="gDesc"></p>
            </div>
          </div>
          <p class="text-xs uppercase tracking-widest t-mist mt-5">Leviticus 22:27 (offerings)</p>
          <div class="he row mt-2 text-xl" id="gVerse1"></div>
          <p class="text-xs uppercase tracking-widest t-mist mt-4">Leviticus 27:32 (animal tithe)</p>
          <div class="he row mt-2 text-xl" id="gVerse2"></div>
          <div class="row mt-5">
            <button class="btn" id="gAdmit">🐾 Admit to the pen</button>
            <button class="btn hidden" id="gNext">Next animal →</button>
          </div>
          <div id="gNote" aria-live="polite"></div>
        </div>
      </section>

      <!-- 2. BARTOTA -->
      <section class="stn" aria-labelledby="h2">
        <h2 id="h2" class="frank text-3xl font-bold t-wool">2 · Two students of Rabbi Yehoshua</h2>
        <p class="mt-2 t-mist">
          A baraita: Rabbi Elazar of Bartota, quoting Rabbi Yehoshua, keeps only <i>some</i> of the mishna's five out of the pen. Rabbi Akiva says he heard
          from Rabbi Yehoshua that the rest are excluded too (<a class="ref" href="https://www.sefaria.org/Bekhorot.57a.17" target="_blank" rel="noopener">57a:17</a>).
          Tap each chip to set what <b class="t-wool">Rabbi Elazar of Bartota</b> excludes.
        </p>
        <div class="card mt-5">
          <div class="row" id="bChips"></div>
          <div class="row mt-4"><button class="btn" id="bCheck">Check</button></div>
          <div id="bNote" aria-live="polite"></div>
          <div id="bReasons" class="hidden mt-5">
            <p class="t-wool">He also derives the <i>gezeira shava</i> (that's how he excludes hybrids). So why does he let these three in? Pick the Gemara's answer for each
              (<a class="ref" href="https://www.sefaria.org/Bekhorot.57a.18-57b.2" target="_blank" rel="noopener">57a:18–57b:2</a>).</p>
            <div id="bSelects" class="mt-3 space-y-3"></div>
            <div class="row mt-4"><button class="btn" id="bCheck2">Check reasons</button></div>
            <div id="bNote2" aria-live="polite"></div>
          </div>
        </div>
      </section>

      <!-- 3. DOG -->
      <section class="stn" aria-labelledby="h3">
        <h2 id="h3" class="frank text-3xl font-bold t-wool">3 · Ten lambs for a dog</h2>
        <p class="mt-2 t-mist">
          Rabbi Yoḥanan holds that brothers who split an estate are <i>purchasers</i> from each other, not heirs each receiving what was "always" his;
          they even return the land to each other at the Jubilee (<a class="ref" href="https://www.sefaria.org/Bekhorot.57a.1-3" target="_blank" rel="noopener">57a:1–3</a>).
          The Gemara tests the other view, retroactive designation (<i>bereira</i>), against a baraita. Two partners split their flock: one takes <b class="t-wool">ten lambs</b>,
          the other <b class="t-wool">nine lambs and a dog</b>. All ten lambs are forbidden on the altar as "the price of a dog"
          (<a class="ref" href="https://www.sefaria.org/Deuteronomy.23.19" target="_blank" rel="noopener">Deut. 23:19</a>). With <i>bereira</i>, why not say one lamb was the price of the dog
          and free the other nine (<a class="ref" href="https://www.sefaria.org/Bekhorot.57a.4" target="_blank" rel="noopener">57a:4</a>)?
        </p>
        <div class="card mt-5">
          <label class="t-wool text-sm" for="dExtra">The dog is worth one lamb plus <b id="dExtraLbl" class="t-lamp"></b></label>
          <input id="dExtra" type="range" min="0" max="40" step="5" value="20" />
          <svg id="dSvg" viewBox="0 0 560 190" class="w-full mt-3" role="img" aria-label="Values of ten lambs against a dog"></svg>
          <p class="text-sm t-mist mt-2">Tap a lamb to make it "the one that paid for the dog."</p>
          <div class="row mt-3"><button class="btn" id="dReset">Reset</button></div>
          <div id="dNote" aria-live="polite"></div>
        </div>
      </section>

      <!-- 4. WHEEL -->
      <section class="stn" aria-labelledby="h4">
        <h2 id="h4" class="frank text-3xl font-bold t-wool">4 · The year wheel</h2>
        <p class="mt-2 t-mist">
          The animal tithe has three <i>gorens</i>, "threshing floors" for the herd (<a class="ref" href="https://www.sefaria.org/Bekhorot.57b.6-7" target="_blank" rel="noopener">57b:6–7</a>):
          Rabbi Akiva puts them near Pesach, Shavuot and Sukkot; Ben Azzai on 29 Adar, 1 Sivan and 29 Av; Rabbi Elazar and Rabbi Shimon on 1 Nisan, 1 Sivan and 29 Elul
          (not 1 Tishrei, which is Rosh HaShana, a festival on which one can't tithe). But a goren doesn't split the count. Only the <b class="t-wool">new year</b> does
          (<a class="ref" href="https://www.sefaria.org/Bekhorot.57b.8-9" target="_blank" rel="noopener">57b:8–9</a>):
        </p>
        <ul class="mt-2 t-mist text-sm list-disc ps-5 space-y-1">
          <li><b class="t-wool">Rabbi Meir:</b> the tithe year begins 1 Elul.</li>
          <li><b class="t-wool">Rabbi Elazar &amp; Rabbi Shimon:</b> it begins 1 Tishrei.</li>
          <li><b class="t-wool">Ben Azzai:</b> since we don't know which, lambs born in Elul are tithed by themselves.</li>
        </ul>
        <div class="card mt-5">
          <div class="flex items-center justify-between gap-3">
            <p class="text-sm t-mist" id="wCount"></p>
            <p class="text-sm t-lamp" id="wScore"></p>
          </div>
          <div class="grid md:grid-cols-2 gap-4 mt-3 items-center">
            <svg id="wSvg" viewBox="-130 -130 260 260" class="w-full max-w-xs mx-auto" role="img" aria-label="Hebrew year wheel"></svg>
            <div>
              <p class="text-xs uppercase tracking-widest t-mist" id="wWho"></p>
              <p class="t-wool mt-1" id="wQ"></p>
              <div class="row mt-3" id="wBtns"></div>
              <div id="wNote" aria-live="polite"></div>
              <button class="btn hidden mt-3" id="wNext">Next →</button>
            </div>
          </div>
        </div>
        <div class="card mt-5">
          <p class="frank text-xl font-bold t-wool">Free pasture</p>
          <p class="text-sm t-mist">Move two lambs around the year and watch all three lamps.</p>
          <label class="text-sm t-wool mt-3 block" for="sA">First lamb born: <b id="sALbl" class="t-lamp"></b></label>
          <input id="sA" type="range" min="0" max="353" value="320" />
          <label class="text-sm t-wool mt-2 block" for="sB">Second lamb born: <b id="sBLbl" class="t-lamp"></b></label>
          <input id="sB" type="range" min="1" max="353" value="20" />
          <svg id="sSvg" viewBox="-130 -130 260 260" class="w-full max-w-xs mx-auto mt-3" role="img" aria-label="Free pasture wheel"></svg>
          <div class="row mt-3" id="sLamps"></div>
        </div>
      </section>

      <!-- 5. CODA -->
      <section class="stn" aria-labelledby="h5">
        <h2 id="h5" class="frank text-3xl font-bold t-wool">5 · Reports from Arkat Leveina</h2>
        <p class="mt-2 t-mist">
          Rabbi Yishmael ben Satriel of Arkat Leveina testified before Rabbi Yehuda HaNasi: back home, when a ewe dies giving birth, they flay her and dress the newborn
          in her hide. "You've told me the reason for the mishna," said Rebbi: the hide stands in for the mother
          (<a class="ref" href="https://www.sefaria.org/Bekhorot.57b.3" target="_blank" rel="noopener">57b:3</a>). Then he kept testifying
          (<a class="ref" href="https://www.sefaria.org/Bekhorot.57b.4-5" target="_blank" rel="noopener">57b:4–5</a>). Tap each report.
        </p>
        <div class="grid sm:grid-cols-3 gap-3 mt-5" id="cCards"></div>
        <div class="card mt-4 hidden" id="cEgg">
          <p class="t-wool">But Job says the <i>kenaf renanim</i>, which the Sages identify with the bar yokhani, "leaves her eggs on the earth"
            (<a class="ref" href="https://www.sefaria.org/Job.39.13-14" target="_blank" rel="noopener">Job 39:13–14</a>). She lays on the ground, so how did an egg <i>fall</i>?</p>
          <div class="row mt-3" id="cEggBtns"></div>
          <div id="cEggNote" aria-live="polite"></div>
        </div>
      </section>

      <!-- LEARN -->
      <section class="stn" aria-labelledby="h6">
        <h2 id="h6" class="frank text-3xl font-bold t-wool">Learn the real daf</h2>
        <ul class="mt-3 space-y-2 t-wool list-disc ps-5">
          <li><a class="ref" href="https://www.sefaria.org/Bekhorot.57a" target="_blank" rel="noopener">Bekhorot 57a</a> and <a class="ref" href="https://www.sefaria.org/Bekhorot.57b" target="_blank" rel="noopener">57b</a> on Sefaria</li>
          <li><a class="ref" href="https://www.sefaria.org/Rashi_on_Bekhorot.57a" target="_blank" rel="noopener">Rashi</a> (58 comments), on the dog's extra value and on why Elul animals stand alone</li>
          <li><a class="ref" href="https://www.sefaria.org/Steinsaltz_on_Bekhorot.57a" target="_blank" rel="noopener">Steinsaltz</a> (30), <a class="ref" href="https://www.sefaria.org/Rabbeinu_Gershom_on_Bekhorot.57a" target="_blank" rel="noopener">Rabbeinu Gershom</a> (26) and <a class="ref" href="https://www.sefaria.org/Ktav_Yad_Rashi_on_Bekhorot.57a" target="_blank" rel="noopener">Ktav Yad Rashi</a> (23)</li>
          <li>The verses: <a class="ref" href="https://www.sefaria.org/Leviticus.22.27" target="_blank" rel="noopener">Lev. 22:27</a>, <a class="ref" href="https://www.sefaria.org/Leviticus.22.25" target="_blank" rel="noopener">Lev. 22:25</a>, <a class="ref" href="https://www.sefaria.org/Leviticus.27.32-33" target="_blank" rel="noopener">Lev. 27:32–33</a>, <a class="ref" href="https://www.sefaria.org/Genesis.6.12" target="_blank" rel="noopener">Gen. 6:12</a>, <a class="ref" href="https://www.sefaria.org/Deuteronomy.4.16" target="_blank" rel="noopener">Deut. 4:16</a>, <a class="ref" href="https://www.sefaria.org/Deuteronomy.23.19" target="_blank" rel="noopener">Deut. 23:19</a></li>
          <li>The new-year dispute in its home: <a class="ref" href="https://www.sefaria.org/Mishnah_Rosh_Hashanah.1.1" target="_blank" rel="noopener">Mishna Rosh HaShana 1:1</a>; on the caesarean birth, <a class="ref" href="https://www.sefaria.org/Niddah.40a" target="_blank" rel="noopener">Nidda 40a</a></li>
        </ul>
      </section>
    </main>
  </div>

  <script is:inline>
  (() => {
    const $ = (id) => document.getElementById(id);
    const ref = (r, label) => `<a class="ref" href="https://www.sefaria.org/${r.replace(/ /g, '_')}" target="_blank" rel="noopener">${label}</a>`;
    const note = (el, cls, html) => { el.innerHTML = `<p class="note ${cls}">${html}</p>`; };

    /* ---------- 1. GATE ---------- */
    const V1 = [
      { id: 'shor', he: 'שׁוֹר אוֹ כֶשֶׂב', gl: 'a bull or a sheep' },
      { id: 'ez', he: 'אוֹ עֵז', gl: 'or a goat' },
      { id: 'yivaled', he: 'כִּי יִוָּלֵד', gl: 'when it is born' },
      { id: 'shivat', he: 'וְהָיָה שִׁבְעַת יָמִים', gl: 'seven days' },
      { id: 'imo', he: 'תַּחַת אִמּוֹ', gl: 'under its mother' },
    ];
    const V2 = [{ id: 'rod', he: 'כֹּל אֲשֶׁר יַעֲבֹר תַּחַת הַשָּׁבֶט', gl: 'whatever passes under the rod' }];
    const A = [
      { e: '🐐', t: 'The half-and-half kid', d: 'Its sire was a ram, its dam a goat: a sheep–goat hybrid (kilayim).', a: 'shor',
        n: `“A bull <i>or</i> a sheep” means a definite species, which excludes a hybrid. (“Or a goat” excludes an animal that only <i>looks</i> like another species.) ${ref('Bekhorot 57a:7', '57a:7')}` },
      { e: '🩹', t: 'The torn lamb', d: 'Mauled by a wolf with a fatal wound (tereifa). It can\'t walk on its own.', a: 'rod',
        n: `“Whatever <i>passes</i> under the rod”: a tereifa can't pass under it. This one runs the other way: the tithe verse teaches the offerings, through the same “under.” ${ref('Bekhorot 57a:8', '57a:8')}` },
      { e: '🐄', t: 'The calf from the flank', d: 'Delivered by caesarean section through its mother\'s side (yotzei dofen).', a: 'yivaled',
        n: `“When it is <i>born</i>” means a normal birth, which excludes yotzei dofen. ${ref('Bekhorot 57a:7', '57a:7')}` },
      { e: '🐣', t: 'The five-day-old', d: 'A lamb born five days ago.', a: 'shivat',
        n: `“It shall be <i>seven days</i> under its mother”: before the eighth day it is meḥusar zman, its time hasn't come. ${ref('Bekhorot 57a:7', '57a:7')}` },
      { e: '🥀', t: 'The orphan', d: 'Its mother was slaughtered mid-birth, and only then was the birth completed.', a: 'imo',
        n: `“<i>Under its mother</i>”: it never had a living mother to be under. The mishna's definition of an orphan. ${ref('Bekhorot 57a:6-7', '57a:6–7')}` },
      { e: '👁️', t: 'The one-eyed ewe', d: 'Blind in one eye: a blemish that would keep it off the altar.', a: 'admit',
        n: `In. Of the tithe it says “he shall not inquire whether it is good or bad” ${ref('Leviticus 27:33', '(Lev. 27:33)')}: a blemish doesn't disqualify a tithe animal. ${ref('Bekhorot 57a:13', '57a:13')}` },
      { e: '🐏', t: 'The violated ram', d: 'An animal involved in bestiality (rova\'/nirva\').', a: 'admit',
        n: `In. The mishna's word “<i>all</i>” brings it in. The Torah calls such animals “corruption… a blemish in them” ${ref('Leviticus 22:25', '(Lev. 22:25)')}, and “corruption” always means licentiousness or idolatry ${ref('Genesis 6:12', '(Gen. 6:12;')} ${ref('Deuteronomy 4:16', 'Deut. 4:16)')}. Wherever a blemish doesn't disqualify, neither does this. ${ref('Bekhorot 57a:9-14', '57a:9–14')}` },
      { e: '🗿', t: 'The idol\'s goat', d: 'Set aside for idol worship (muktzeh), though not yet offered.', a: 'admit',
        n: `In. Idolatry is “corruption,” and corruption is treated like a blemish, which the tithe ignores. The same goes for an animal that was itself worshipped. ${ref('Bekhorot 57a:14', '57a:14')}` },
      { e: '💰', t: 'The harlot\'s fee', d: 'A lamb paid as a prostitute\'s fee (etnan).', a: 'admit',
        n: `In. Licentiousness is “corruption,” which counts as a blemish, so it still enters the pen. ${ref('Bekhorot 57a:14', '57a:14')}` },
      { e: '🐕', t: 'The dog\'s price', d: 'A lamb received in trade for a dog (meḥir kelev).', a: 'admit',
        n: `In. The verse sets the dog's price beside the harlot's fee ${ref('Deuteronomy 23:19', '(Deut. 23:19)')}, so it is treated the same way. ${ref('Bekhorot 57a:14', '57a:14')}` },
      { e: '❔', t: 'The tumtum (per the first tanna)', d: 'Its sexual organs are concealed. Rule by the baraita\'s first tanna.', a: 'admit',
        n: `In. To the first tanna it is a doubtful male or female, not a creature of its own, so it is tithed. <b>But</b> Rabbi Shimon ben Yehuda, in Rabbi Shimon's name, keeps the tumtum and the hermaphrodite <i>out</i>: the altar takes only a definite male or a definite female, and “under” carries that to the tithe. ${ref('Bekhorot 57a:15-16', '57a:15–16')}` },
      { e: '🧥', t: 'The lamb in its mother\'s coat (per Rabbi Yehoshua)', d: 'Its mother was slaughtered mid-birth, but her flayed hide was kept and wrapped around the newborn.', a: 'admit',
        n: `In, says Rabbi Yehoshua: “Even if its mother was slaughtered, if the hide exists, it is not an orphan.” Rebbi learned the reason from Arkat Leveina, where they dress orphaned lambs in their mother's skin (see §5). ${ref('Bekhorot 57a:6', '57a:6')}, ${ref('Bekhorot 57b:3', '57b:3')}` },
    ];
    let gi = 0, gs = 0, gLocked = false;
    const gEl = { e: $('gEmoji'), t: $('gTitle'), d: $('gDesc'), c: $('gCount'), s: $('gScore'), n: $('gNote'), next: $('gNext'), admit: $('gAdmit') };
    const drawVerse = (box, list) => {
      box.innerHTML = list.map(p => `<button class="phrase frank" data-p="${p.id}">${p.he}<span class="gl">${p.gl}</span></button>`).join('');
    };
    drawVerse($('gVerse1'), V1); drawVerse($('gVerse2'), V2);
    const phrases = () => document.querySelectorAll('.phrase');
    const gShow = () => {
      if (gi >= A.length) {
        gEl.e.textContent = '🏁'; gEl.t.textContent = 'The pen is full';
        gEl.d.textContent = `You ruled ${gs} of ${A.length} correctly. Five kinds are turned away; corruption, blemishes and (to the first tanna) doubt all walk in.`;
        gEl.admit.classList.add('hidden'); gEl.next.classList.add('hidden'); gEl.n.innerHTML = '';
        phrases().forEach(b => b.disabled = true);
        return;
      }
      const a = A[gi]; gLocked = false;
      gEl.e.className = 'animal'; gEl.e.textContent = a.e; gEl.t.textContent = a.t; gEl.d.textContent = a.d;
      gEl.c.textContent = `Animal ${gi + 1} of ${A.length}`; gEl.s.textContent = `${gs} correct`;
      gEl.n.innerHTML = ''; gEl.next.classList.add('hidden'); gEl.admit.classList.remove('hidden', 'ok', 'no'); gEl.admit.disabled = false;
      phrases().forEach(b => { b.disabled = false; b.classList.remove('ok', 'no'); });
    };
    const gAnswer = (pick, btn) => {
      if (gLocked) return; gLocked = true;
      const a = A[gi], right = pick === a.a;
      if (right) gs++;
      btn.classList.add(right ? 'ok' : 'no');
      if (!right) {
        const tgt = a.a === 'admit' ? gEl.admit : document.querySelector(`.phrase[data-p="${a.a}"]`);
        tgt && tgt.classList.add('ok');
      }
      gEl.e.classList.add(a.a === 'admit' ? 'in' : 'out');
      phrases().forEach(b => b.disabled = true); gEl.admit.disabled = true;
      note(gEl.n, right ? 'ok' : 'no', (right ? '✓ ' : '✗ ') + (a.a === 'admit' ? '' : '<b>Out.</b> ') + a.n);
      gEl.s.textContent = `${gs} correct`;
      gEl.next.classList.remove('hidden'); gEl.next.focus();
    };
    document.querySelectorAll('.phrase').forEach(b => b.addEventListener('click', () => gAnswer(b.dataset.p, b)));
    gEl.admit.addEventListener('click', () => gAnswer('admit', gEl.admit));
    gEl.next.addEventListener('click', () => { gi++; gShow(); });
    gShow();

    /* ---------- 2. BARTOTA ---------- */
    const CATS = [
      { id: 'kil', l: 'Hybrid', ex: true },
      { id: 'ter', l: 'Tereifa', ex: true },
      { id: 'dof', l: 'Caesarean', ex: false },
      { id: 'zman', l: 'Under 8 days', ex: false },
      { id: 'yat', l: 'Orphan', ex: false },
    ];
    const REASONS = [
      { id: 'dof', l: 'He follows Rabbi Shimon: a caesarean birth is a real birth, fit even for the altar (not as Rabbi Yoḥanan reads Rabbi Shimon).' },
      { id: 'zman', l: 'He follows Rabbi Shimon ben Yehuda: the tithe applies even before the eighth day.' },
      { id: 'yat', l: 'He means a case where the mother\'s hide exists, following Rabbi Yehoshua\'s own view.' },
    ];
    const bState = Object.fromEntries(CATS.map(c => [c.id, false]));
    const bChips = $('bChips');
    const drawChips = () => {
      bChips.innerHTML = CATS.map(c => `<button class="chip ${bState[c.id] ? 'ex' : 'ad'}" data-c="${c.id}" aria-pressed="${bState[c.id]}">${bState[c.id] ? '🚫' : '✅'} ${c.l}</button>`).join('');
      bChips.querySelectorAll('button').forEach(b => b.addEventListener('click', () => { bState[b.dataset.c] = !bState[b.dataset.c]; drawChips(); }));
    };
    drawChips();
    $('bCheck').addEventListener('click', () => {
      const wrong = CATS.filter(c => bState[c.id] !== c.ex);
      if (wrong.length) {
        note($('bNote'), 'no', `Not yet: ${wrong.map(c => c.l).join(', ')} ${wrong.length > 1 ? 'are' : 'is'} set wrong. Rabbi Akiva's report adds three categories to his; which two are left?`);
      } else {
        note($('bNote'), 'ok', `✓ Rabbi Elazar of Bartota excludes only the <b>hybrid</b> and the <b>tereifa</b>. Rabbi Akiva heard that the caesarean, the under-eight-days and the orphan are out too. ${ref('Bekhorot 57a:17', '57a:17')}`);
        $('bReasons').classList.remove('hidden');
      }
    });
    const opts = ['<option value="">Choose…</option>'].concat(REASONS.map(r => `<option value="${r.id}">${r.l}</option>`)).join('');
    $('bSelects').innerHTML = CATS.filter(c => !c.ex).map(c => `<label class="block"><span class="t-wool text-sm font-bold">${c.l}</span><br><select data-c="${c.id}" class="mt-1 w-full">${opts}</select></label>`).join('');
    $('bCheck2').addEventListener('click', () => {
      const sels = [...$('bSelects').querySelectorAll('select')];
      const ok = sels.every(s => s.value === s.dataset.c);
      note($('bNote2'), ok ? 'ok' : 'no', ok
        ? `✓ Each admission comes from someone else's view: Rabbi Shimon on the caesarean (${ref('Bekhorot 57b:1', '57b:1')}), Rabbi Shimon ben Yehuda on the under-eight-days, and Rabbi Yehoshua's hide (${ref('Bekhorot 57b:2', '57b:2')}). His “orphan” is the lamb in its mother's coat from the gate.`
        : 'Some reasons are crossed. Each of the three is answered by a different sage.');
    });

    /* ---------- 3. DOG ---------- */
    const dSvg = $('dSvg'), dEx = $('dExtra');
    let dPick = null;
    const drawDog = () => {
      const ex = +dEx.value / 100; $('dExtraLbl').textContent = ex ? `${Math.round(ex * 100)}% more` : 'nothing (exactly equal)';
      const base = 100, H = 150, top = 20, w = 34, gap = 10;
      let s = '';
      for (let i = 0; i < 10; i++) {
        const x = 10 + i * (w + gap);
        let col = '#8fbf7a', part = 0;
        if (dPick !== null) {
          if (i === dPick) col = '#c9472f';
          else if (ex > 0) { col = '#c9472f'; part = ex / 9; }
        }
        const h = base;
        s += `<g role="button" tabindex="0" data-l="${i}" aria-label="Lamb ${i + 1}" style="cursor:pointer">`
          + `<rect class="bar" x="${x}" y="${top + H - h}" width="${w}" height="${h}" rx="4" fill="${dPick === null ? '#4f6b45' : col}" opacity="${dPick === null ? 1 : .9}"/>`
          + (part ? `<rect class="bar" x="${x}" y="${top + H - h}" width="${w}" height="${Math.max(3, part * 100 * 1.4)}" fill="#e7b75a"/>` : '')
          + `<text x="${x + w / 2}" y="${top + H - h + 30}" font-size="18" text-anchor="middle">🐑</text></g>`;
      }
      const dx = 10 + 10 * (w + gap) + 6, dh = base * (1 + ex);
      s += `<rect x="${dx}" y="${top + H - dh}" width="${w + 20}" height="${dh}" rx="4" fill="#6b4a2b"/>`
        + (ex ? `<rect x="${dx}" y="${top + H - dh}" width="${w + 20}" height="${ex * base}" fill="#e7b75a"/>` : '')
        + `<text x="${dx + (w + 20) / 2}" y="${top + H - dh + 30}" font-size="20" text-anchor="middle">🐕</text>`
        + `<line x1="0" x2="560" y1="${top + H}" y2="${top + H}" stroke="#34465a"/>`
        + `<text x="${dx + (w + 20) / 2}" y="${top + H + 16}" font-size="11" fill="#9fb0c2" text-anchor="middle">dog</text>`
        + `<text x="215" y="${top + H + 16}" font-size="11" fill="#9fb0c2" text-anchor="middle">the ten lambs one partner took</text>`;
      dSvg.innerHTML = s;
      dSvg.querySelectorAll('g[data-l]').forEach(g => {
        const go = () => { dPick = +g.dataset.l; drawDog(); dVerdict(); };
        g.addEventListener('click', go);
        g.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); } });
      });
    };
    const dVerdict = () => {
      const ex = +dEx.value;
      if (dPick === null) { $('dNote').innerHTML = ''; return; }
      if (!ex) note($('dNote'), 'ok', `With equal values, it works: lamb ${dPick + 1} is the dog's price and the other nine go free. Rav Ashi agrees, <i>if</i> they're all equal. ${ref('Bekhorot 57a:5', '57a:5')}`);
      else note($('dNote'), 'no', `Lamb ${dPick + 1} covers one lamb's worth of dog, but ${ex}% of the dog's value is left over (gold). It has to be spread across the other nine, so a sliver of the dog's price sits in <b>every</b> lamb, and all ten are forbidden. Rav Ashi: the baraita means a dog worth “one and a little more.” <i>Bereira</i> survives. ${ref('Bekhorot 57a:5', '57a:5')}`);
    };
    dEx.addEventListener('input', () => { drawDog(); dVerdict(); });
    $('dReset').addEventListener('click', () => { dPick = null; drawDog(); dVerdict(); });
    drawDog();

    /* ---------- 4. WHEEL ---------- */
    const MONTHS = [['Tishrei', 30], ['Ḥeshvan', 29], ['Kislev', 30], ['Tevet', 29], ['Shevat', 30], ['Adar', 29], ['Nisan', 30], ['Iyar', 29], ['Sivan', 30], ['Tammuz', 29], ['Av', 30], ['Elul', 29]];
    const START = []; { let s = 0; MONTHS.forEach(m => { START.push(s); s += m[1]; }); }
    const YEAR = 354;
    const D = (day, mon) => START[MONTHS.findIndex(m => m[0] === mon)] + day - 1;
    const fmt = (i) => { i = ((i % YEAR) + YEAR) % YEAR; let m = 11; while (START[m] > i) m--; return `${i - START[m] + 1} ${MONTHS[m][0]}`; };
    const OP = {
      res: { name: 'Rabbi Elazar & Rabbi Shimon', cuts: [D(1, 'Tishrei')], gorens: [D(1, 'Nisan'), D(1, 'Sivan'), D(29, 'Elul')] },
      meir: { name: 'Rabbi Meir', cuts: [D(1, 'Elul')], gorens: [] },
      ba: { name: 'Ben Azzai', cuts: [D(1, 'Elul'), D(1, 'Tishrei')], gorens: [D(29, 'Adar'), D(1, 'Sivan'), D(29, 'Av')] },
    };
    // does a new-year cut fall in (a, a+len] going forward?
    const joins = (op, a, len) => !OP[op].cuts.some(c => { const d = ((c - a) % YEAR + YEAR) % YEAR; return d > 0 && d <= len; });
    const ang = (i) => (i / YEAR) * 2 * Math.PI - Math.PI / 2;
    const pt = (i, r) => [Math.cos(ang(i)) * r, Math.sin(ang(i)) * r];
    const arc = (a, b, r) => { const [x1, y1] = pt(a, r), [x2, y2] = pt(b, r); const large = ((b - a + YEAR) % YEAR) > YEAR / 2 ? 1 : 0; return `M${x1.toFixed(1)},${y1.toFixed(1)} A${r},${r} 0 ${large} 1 ${x2.toFixed(1)},${y2.toFixed(1)}`; };
    const drawWheel = (svg, op, a, len, join) => {
      let s = '';
      MONTHS.forEach((m, k) => {
        const s0 = START[k], s1 = s0 + m[1];
        s += `<path d="${arc(s0 + .5, s1 - .5, 100)}" stroke="${m[0] === 'Elul' ? '#4b5a3a' : '#2b3a4b'}" stroke-width="22" fill="none"/>`;
        const [tx, ty] = pt(s0 + m[1] / 2, 100);
        s += `<text x="${tx.toFixed(1)}" y="${(ty + 3).toFixed(1)}" font-size="8.5" fill="#9fb0c2" text-anchor="middle">${m[0]}</text>`;
      });
      if (op) {
        OP[op].gorens.forEach(g => { const [x, y] = pt(g, 76); s += `<circle cx="${x}" cy="${y}" r="4" fill="#e7b75a"><title>goren ${fmt(g)}</title></circle>`; });
        OP[op].cuts.forEach(c => { const [x1, y1] = pt(c, 64), [x2, y2] = pt(c, 116); s += `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="#c9472f" stroke-width="3"/>`; });
      }
      if (len !== undefined) {
        const b = (a + len) % YEAR;
        s += `<path d="${arc(a, b, 58)}" stroke="${join === undefined ? '#9fb0c2' : join ? '#8fbf7a' : '#c9472f'}" stroke-width="4" fill="none" stroke-dasharray="${join === false ? '6 4' : ''}"/>`;
        [[a, '🐑'], [b, '🐑']].forEach(([i, e], k) => { const [x, y] = pt(i, 58); s += `<text x="${x}" y="${y + 5}" font-size="15" text-anchor="middle">${e}</text>`; });
      }
      s += `<text x="0" y="-4" font-size="10" fill="#ece4d3" text-anchor="middle">${op ? OP[op].name.replace(' & ', ' &amp; ') : ''}</text>`;
      s += `<text x="0" y="10" font-size="8" fill="#9fb0c2" text-anchor="middle">${op ? 'red = new year · gold = goren' : ''}</text>`;
      svg.innerHTML = s;
    };
    const R = [
      { op: 'res', a: D(25, 'Elul'), b: D(3, 'Tishrei'), ans: 'no', n: `“Five before Rosh HaShana and five after do not join.” The new year falls between them. ${ref('Bekhorot 57b:9', '57b:9')}` },
      { op: 'res', a: D(20, 'Adar'), b: D(10, 'Nisan'), ans: 'yes', n: `They join. The goren of 1 Nisan sits between them, but “five before the goren and five after join.” A goren isn't a new year. ${ref('Bekhorot 57b:9', '57b:9')}` },
      { op: 'res', a: D(10, 'Tishrei'), b: D(20, 'Elul'), ans: 'yes', n: `They join. Everything born from 1 Tishrei to 29 Elul counts together, eleven months apart or not. ${ref('Bekhorot 57b:9', '57b:9')}` },
      { op: 'meir', a: D(20, 'Av'), b: D(10, 'Elul'), ans: 'no', n: `For Rabbi Meir, 1 Elul is the new year for the animal tithe, so Av and Elul are different years. ${ref('Bekhorot 57b:8', '57b:8')}` },
      { op: 'meir', a: D(10, 'Elul'), b: D(10, 'Tishrei'), ans: 'yes', n: `They join. Rabbi Meir's year began on 1 Elul, and Rosh HaShana in Tishrei doesn't cut it. ${ref('Bekhorot 57b:8', '57b:8')}` },
      { op: 'ba', a: D(5, 'Elul'), b: D(25, 'Elul'), ans: 'yes', n: `They join. Ben Azzai: “the Elul-born are tithed by themselves,” together with each other. ${ref('Bekhorot 57b:8', '57b:8')}` },
      { op: 'ba', a: D(25, 'Av'), b: D(5, 'Elul'), ans: 'no', n: `If Rabbi Meir is right, Elul starts a new year. Out of doubt, Elul can't join Av. ${ref('Bekhorot 57b:8', '57b:8')}` },
      { op: 'ba', a: D(25, 'Elul'), b: D(5, 'Tishrei'), ans: 'no', n: `And if Rabbi Elazar and Rabbi Shimon are right, Tishrei starts a new year. So Elul can't join Tishrei either: it stands alone. ${ref('Bekhorot 57b:8', '57b:8')}` },
      { op: 'res', a: D(10, 'Kislev'), b: D(20, 'Adar'), q: 'It is 20 Adar. Untithed lambs born in Kislev are in the pen. May the owner sell or slaughter one now?', opts: [['yes', 'Allowed'], ['no', 'Forbidden']], ans: 'yes', n: `Allowed: the goren hasn't arrived. “Until the goren arrives it is permitted to sell and to slaughter.” ${ref('Bekhorot 57b:9', '57b:9')}` },
      { op: 'res', a: D(10, 'Kislev'), b: D(2, 'Nisan'), q: 'It is 2 Nisan: the goren has come. May he slaughter one before tithing?', opts: [['yes', 'Allowed'], ['no', 'Forbidden']], ans: 'no', n: `Forbidden. “Once the goren has arrived he may not slaughter.” ${ref('Bekhorot 57b:9', '57b:9')}` },
      { op: 'res', a: D(10, 'Kislev'), b: D(2, 'Nisan'), q: 'He slaughtered it anyway, untithed. Does he owe anything for that lamb?', opts: [['owe', 'Owes the tithe'], ['ex', 'Exempt']], ans: 'ex', n: `Exempt. “If he slaughtered, he is exempt.” The goren only stops him before the fact. ${ref('Bekhorot 57b:9', '57b:9')}` },
    ];
    let wi = 0, ws = 0;
    const wShow = () => {
      $('wNote').innerHTML = ''; $('wNext').classList.add('hidden');
      if (wi >= R.length) {
        $('wWho').textContent = 'Done'; $('wQ').innerHTML = `You read the wheel right ${ws} of ${R.length} times. A <b>goren</b> is a deadline for slaughtering; only a <b>new year</b> separates the count.`;
        $('wBtns').innerHTML = ''; drawWheel($('wSvg'), 'ba'); return;
      }
      const r = R[wi], len = ((r.b - r.a) % YEAR + YEAR) % YEAR;
      $('wCount').textContent = `Round ${wi + 1} of ${R.length}`; $('wScore').textContent = `${ws} correct`;
      $('wWho').textContent = `According to ${OP[r.op].name}`;
      $('wQ').innerHTML = r.q || `One lamb is born on <b>${fmt(r.a)}</b>, another on <b>${fmt(r.b)}</b>. Do they join for the tithe count?`;
      const opts = r.opts || [['yes', 'They join'], ['no', 'They don\'t join']];
      $('wBtns').innerHTML = opts.map(([v, l]) => `<button class="btn" data-v="${v}">${l}</button>`).join('');
      drawWheel($('wSvg'), r.op, r.a, len);
      $('wBtns').querySelectorAll('button').forEach(b => b.addEventListener('click', () => {
        const ok = b.dataset.v === r.ans; if (ok) ws++;
        $('wBtns').querySelectorAll('button').forEach(x => { x.disabled = true; if (x.dataset.v === r.ans) x.classList.add('ok'); });
        if (!ok) b.classList.add('no');
        if (!r.q) drawWheel($('wSvg'), r.op, r.a, len, joins(r.op, r.a, len));
        note($('wNote'), ok ? 'ok' : 'no', (ok ? '✓ ' : '✗ ') + r.n);
        $('wScore').textContent = `${ws} correct`;
        $('wNext').classList.remove('hidden'); $('wNext').focus();
      }));
    };
    $('wNext').addEventListener('click', () => { wi++; wShow(); });
    wShow();

    const sA = $('sA'), sB = $('sB');
    const drawFree = () => {
      const a = +sA.value, len = +sB.value;
      $('sALbl').textContent = fmt(a); $('sBLbl').textContent = `${fmt(a + len)} (${len} days later)`;
      const all = ['res', 'meir', 'ba'].map(op => [op, joins(op, a, len)]);
      drawWheel($('sSvg'), null, a, len);
      // overlay every opinion's cut faintly
      const svg = $('sSvg');
      const extra = [[D(1, 'Elul'), 'R. Meir'], [D(1, 'Tishrei'), 'R. Elazar & R. Shimon']].map(([c, l]) => { const [x1, y1] = pt(c, 64), [x2, y2] = pt(c, 116); return `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="#c9472f" stroke-width="2" stroke-dasharray="3 2"><title>${l}: new year</title></line>`; }).join('');
      svg.insertAdjacentHTML('beforeend', extra);
      $('sLamps').innerHTML = all.map(([op, j]) => `<span class="lamp ${j ? 'y' : 'n'}"><i></i>${OP[op].name}: ${j ? 'join' : 'separate'}</span>`).join('');
    };
    sA.addEventListener('input', drawFree); sB.addEventListener('input', drawFree);
    drawFree();

    /* ---------- 5. CODA ---------- */
    const C = [
      { e: '🥬', t: 'The lettuce', n: 'Our lettuce has <b>600,000</b> leaves in its heart.' },
      { e: '🌲', t: 'The cedar', n: 'A cedar fell, and <b>sixteen wagons</b> drove side by side along its trunk.' },
      { e: '🥚', t: 'The egg', n: 'A bar yokhani\'s egg fell. It flooded <b>sixty cities</b> and snapped <b>three hundred cedars</b>.', egg: true },
    ];
    $('cCards').innerHTML = C.map((c, i) => `<button class="card text-start" data-i="${i}" aria-expanded="false"><span class="text-3xl" aria-hidden="true">${c.e}</span><span class="block frank text-lg font-bold t-wool mt-1">${c.t}</span><span class="block text-sm t-mist mt-1" data-body>Tap to hear the testimony</span></button>`).join('');
    $('cCards').querySelectorAll('button').forEach(b => b.addEventListener('click', () => {
      const c = C[+b.dataset.i]; b.querySelector('[data-body]').innerHTML = `<span class="t-wool">“${c.n}”</span>`; b.setAttribute('aria-expanded', 'true');
      if (c.egg) $('cEgg').classList.remove('hidden');
    }));
    const EGG = [
      ['wind', 'A storm blew it out of the nest', false],
      ['rotten', 'It was unfertilized, so she threw it away', true],
      ['other', 'It was a different bird after all', false],
    ];
    $('cEggBtns').innerHTML = EGG.map(([v, l]) => `<button class="btn" data-v="${v}">${l}</button>`).join('');
    $('cEggBtns').querySelectorAll('button').forEach(b => b.addEventListener('click', () => {
      const ok = EGG.find(x => x[0] === b.dataset.v)[2];
      $('cEggBtns').querySelectorAll('button').forEach(x => { x.disabled = true; if (EGG.find(y => y[0] === x.dataset.v)[2]) x.classList.add('ok'); });
      if (!ok) b.classList.add('no');
      note($('cEggNote'), ok ? 'ok' : 'no', `Rav Ashi: <b>that egg was addled</b>. It would never hatch, so the bird threw it down. ${ref('Bekhorot 57b:5', '57b:5')}`);
    }));
  })();
  </script>
</Layout>
