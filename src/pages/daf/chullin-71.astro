---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="The Swallowed Ring — Daf Yomi Game: Chullin 71"
  description="You are the posek: rule tamei or tahor on ten real cases of encapsulated impurity from Chullin 71 — the sugya of tumah belu'ah."
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;700;900&display=swap"
  />

  <main class="min-h-screen bg-[#0b0e14] !text-slate-100">
    <!-- ============ Hero ============ -->
    <div class="border-b border-amber-900/20 bg-gradient-to-b from-amber-950/25 to-transparent px-4 pt-10 pb-8 text-center">
      <p class="mb-3 text-xs uppercase tracking-[0.3em] !text-amber-500/80">
        <a href="/daf" class="hover:!text-amber-400">daf yomi arcade</a> · chullin 71 · 2026-07-10
      </p>
      <h1 class="frank text-4xl font-black tracking-tight sm:text-5xl">💍 The Swallowed Ring</h1>
      <p class="frank mt-1 text-2xl !text-amber-200/90" dir="rtl" lang="he">טוּמְאָה בְּלוּעָה</p>
      <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed !text-slate-400">
        On today's daf, Rabba teaches: what is <em>swallowed</em> inside a living body is sealed off
        from the laws of impurity — a swallowed impure ring contaminates no one, and a swallowed pure
        ring cannot be contaminated. <strong class="!text-slate-200">You are the posek.</strong>
        Ten real cases from Chullin 71. Rule on each: <span class="font-bold !text-[#d4604a]">tamei</span> or
        <span class="font-bold !text-[#4ec2b8]">tahor</span>?
      </p>
    </div>

    <div class="mx-auto max-w-2xl px-4 pb-16 pt-8">
      <!-- ============ Score track: the swallowed rings ============ -->
      <div class="mb-6 flex items-center justify-between gap-4">
        <div id="ring-track" class="flex gap-1.5" aria-label="Score: one brass ring per correct ruling"></div>
        <div class="text-right text-xs !text-slate-500">
          <span id="progress-label">Case 1 of 10</span>
          <span id="streak-label" class="ml-2 hidden !text-amber-400"></span>
        </div>
      </div>

      <!-- ============ Case card (klaf) ============ -->
      <div id="game-area">
        <div id="case-card" class="klaf rounded-2xl p-6 sm:p-8">
          <div class="mb-2 flex items-baseline justify-between">
            <span id="case-kicker" class="text-[11px] font-bold uppercase tracking-[0.2em] !text-[#8a6d3b]"></span>
            <span id="case-heb-num" class="frank text-lg !text-[#8a6d3b]" dir="rtl"></span>
          </div>
          <h2 id="case-title" class="frank mb-3 text-2xl font-bold !text-[#23201a]"></h2>
          <p id="case-body" class="text-[15px] leading-relaxed !text-[#3a3527]"></p>
          <p id="case-question" class="mt-3 text-[15px] font-bold !text-[#23201a]"></p>
        </div>

        <div id="verdict-buttons" class="mt-5 grid grid-cols-2 gap-3">
          <button
            id="btn-tamei"
            class="verdict-btn group rounded-2xl border-2 border-[#b4432f]/40 bg-[#b4432f]/10 px-4 py-5 text-center transition-colors hover:border-[#b4432f] hover:bg-[#b4432f]/25 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#d4604a]"
          >
            <span class="frank block text-3xl font-black !text-[#d4604a]" dir="rtl" lang="he">טָמֵא</span>
            <span class="mt-1 block text-xs uppercase tracking-widest !text-[#d4604a]/70">tamei · impure <kbd class="kbd">1</kbd></span>
          </button>
          <button
            id="btn-tahor"
            class="verdict-btn group rounded-2xl border-2 border-[#2f7c74]/40 bg-[#2f7c74]/10 px-4 py-5 text-center transition-colors hover:border-[#3fa89e] hover:bg-[#2f7c74]/25 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#4ec2b8]"
          >
            <span class="frank block text-3xl font-black !text-[#4ec2b8]" dir="rtl" lang="he">טָהוֹר</span>
            <span class="mt-1 block text-xs uppercase tracking-widest !text-[#4ec2b8]/70">tahor · pure <kbd class="kbd">2</kbd></span>
          </button>
        </div>

        <!-- ============ Result panel ============ -->
        <div id="result-panel" class="mt-5 hidden rounded-2xl border p-5 sm:p-6">
          <div id="result-headline" class="mb-2 text-sm font-black uppercase tracking-widest"></div>
          <p id="result-explanation" class="text-sm leading-relaxed !text-slate-300"></p>
          <blockquote
            id="result-hebrew"
            class="frank mt-4 border-r-2 border-amber-700/50 pr-3 text-lg leading-relaxed !text-amber-100/90"
            dir="rtl"
            lang="he"
          ></blockquote>
          <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
            <a id="result-source" href="#" target="_blank" rel="noopener" class="text-xs !text-amber-500 hover:!text-amber-300 hover:underline"></a>
            <button
              id="btn-next"
              class="rounded-xl bg-amber-600 px-5 py-2.5 text-sm font-bold !text-slate-950 transition-colors hover:bg-amber-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-400"
            >
              Next case →
            </button>
          </div>
        </div>
      </div>

      <!-- ============ End screen ============ -->
      <div id="end-screen" class="hidden text-center">
        <div class="klaf rounded-2xl p-8">
          <p class="text-[11px] font-bold uppercase tracking-[0.2em] !text-[#8a6d3b]">Your ruling record</p>
          <div id="final-score" class="frank mt-2 text-6xl font-black !text-[#23201a]"></div>
          <div id="final-grade" class="frank mt-2 text-2xl font-bold !text-[#6b4f1d]"></div>
          <p id="final-line" class="mx-auto mt-3 max-w-md text-sm !text-[#3a3527]"></p>
        </div>
        <div class="mt-5 flex flex-wrap justify-center gap-3">
          <button id="btn-replay" class="rounded-xl border border-slate-700 px-5 py-2.5 text-sm font-bold !text-slate-200 transition-colors hover:border-amber-600 hover:!text-amber-300">↻ Judge again</button>
          <button id="btn-share" class="rounded-xl bg-amber-600 px-5 py-2.5 text-sm font-bold !text-slate-950 transition-colors hover:bg-amber-500">Share score</button>
        </div>
        <div id="review-list" class="mt-8 space-y-2 text-left"></div>
      </div>

      <!-- ============ Learn the real daf ============ -->
      <div class="mt-14 border-t border-slate-800 pt-8">
        <h3 class="frank mb-3 text-xl font-bold !text-amber-200">Learn the real daf</h3>
        <p class="text-sm leading-relaxed !text-slate-400">
          Every case above is straight from the Gemara. The mishnah (71a) rules on the midwife and the
          mother; Rabba states the twin principle of טומאה בלועה; the Gemara derives it from the eater
          of a carcass (Leviticus 11:40) and a chain of <em>kal va-chomer</em> arguments; and Rava
          answers that both halves were already taught in Mikvaot 10:8 — the swallowed rings — leaving
          Rabba only the case of two rings swallowed together. A language bonus: in this daf
          <span class="frank" dir="rtl" lang="he">חַיָּה</span> means <em>wild animal</em> in the first
          sugya and <em>midwife</em> in the mishnah.
        </p>
        <div class="mt-4 flex flex-wrap gap-2 text-xs">
          <a href="https://www.sefaria.org/Chullin.71a" target="_blank" rel="noopener" class="rounded-full border border-amber-800/50 bg-amber-950/30 px-3 py-1.5 !text-amber-300 hover:border-amber-600">Chullin 71 on Sefaria ↗</a>
          <span class="rounded-full border border-slate-800 px-3 py-1.5 !text-slate-400">Rashi ×59</span>
          <span class="rounded-full border border-slate-800 px-3 py-1.5 !text-slate-400">Steinsaltz ×38</span>
          <span class="rounded-full border border-slate-800 px-3 py-1.5 !text-slate-400">Rabbeinu Gershom ×31</span>
          <span class="rounded-full border border-slate-800 px-3 py-1.5 !text-slate-400">Tosafot ×11</span>
        </div>
        <p class="mt-6 text-xs !text-slate-600">
          Part of the <a href="/daf" class="underline decoration-slate-700 hover:!text-slate-400">Daf Yomi Arcade</a> —
          a new game from every daf. Texts and links via the Sefaria API.
        </p>
      </div>
    </div>
  </main>

  <style>
    .frank {
      font-family: 'Frank Ruhl Libre', Georgia, 'Times New Roman', serif;
    }
    .klaf {
      background:
        radial-gradient(ellipse at 20% 10%, rgba(255, 252, 240, 0.5), transparent 60%),
        linear-gradient(160deg, #efe5cd, #e4d6b6 70%, #dccca8);
      box-shadow:
        inset 0 0 40px rgba(120, 90, 40, 0.15),
        0 10px 30px rgba(0, 0, 0, 0.45);
    }
    .kbd {
      display: inline-block;
      border: 1px solid currentColor;
      border-radius: 4px;
      padding: 0 4px;
      font-size: 9px;
      opacity: 0.6;
    }
    .ring-slot {
      transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .ring-slot.earned {
      transform: scale(1.15);
    }
    @keyframes ring-drop {
      from { transform: translateY(-14px) scale(1.4); opacity: 0; }
      to { transform: translateY(0) scale(1.15); opacity: 1; }
    }
    .ring-slot.earned circle.fill {
      animation: ring-drop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    @media (prefers-reduced-motion: reduce) {
      .ring-slot, .ring-slot.earned circle.fill { transition: none; animation: none; }
    }
  </style>

  <script>
    const SEFARIA = 'https://www.sefaria.org/';

    const CASES = [
      {
        title: "The Midwife's Hand",
        body: 'A fetus has died inside its mother’s womb. The midwife reaches her hand in and touches it, to help deliver it.',
        question: 'The midwife — how do you rule?',
        answer: 'tamei',
        explanation:
          'The mishnah rules the midwife is tamei with seven-day corpse impurity: her hand actually touched a corpse, and SHE is not encapsulated inside anything. (Delicious detail: the mishnah’s word for midwife is חַיָּה — the same word that means "wild animal" in the first half of this very daf.)',
        hebrew: 'הָאִשָּׁה שֶׁמֵּת וְלָדָהּ בְּתוֹךְ מֵעֶיהָ, וּפָשְׁטָה חַיָּה אֶת יָדָהּ וְנָגְעָה בּוֹ — הַחַיָּה טְמֵאָה טוּמְאַת שִׁבְעָה',
        source: 'Mishnah · Chullin 71a:16',
        url: 'Chullin.71a.16',
      },
      {
        title: 'The Mother',
        body: 'Same scene. The dead fetus is still within its mother — it has not emerged.',
        question: 'The mother herself — how do you rule?',
        answer: 'tahor',
        explanation:
          'She remains completely pure until the fetus emerges. The fetus is belu’a — swallowed within a living body — and encapsulated impurity does not escape to contaminate. This is the mishnah’s own ruling, and the launchpad for Rabba’s principle.',
        hebrew: 'וְהָאִשָּׁה טְהוֹרָה עַד שֶׁיֵּצֵא הַוָּלָד. אָמַר רַבָּה: כְּשֵׁם שֶׁטּוּמְאָה בְּלוּעָה אֵינָהּ מְטַמְּאָה, כָּךְ טׇהֳרָה בְּלוּעָה אֵינָהּ מִיטַּמְּאָה',
        source: 'Chullin 71a:16–17',
        url: 'Chullin.71a.16',
      },
      {
        title: 'The Carcass Eater',
        body: 'A man ate meat of a neveilah (an animal that died without slaughter — a source of impurity). He immersed in a mikveh, and the sun has set. The meat is still in his stomach.',
        question: 'Right now — how do you rule?',
        answer: 'tahor',
        explanation:
          'The Torah itself says the eater of a carcass washes his clothes, immerses, "and is impure until the evening" — meaning at evening he is PURE, even though the carcass is still inside him. This verse (Leviticus 11:40) is where the whole principle of swallowed impurity comes from.',
        hebrew: 'דִּכְתִיב: ״וְהָאֹכֵל מִנִּבְלָתָהּ יְכַבֵּס בְּגָדָיו״ — מִי לָא עָסְקִינַן דַּאֲכַל סָמוּךְ לִשְׁקִיעַת הַחַמָּה, וְקָאָמַר רַחֲמָנָא טָהוֹר',
        source: 'Chullin 71a:18',
        url: 'Chullin.71a.18',
      },
      {
        title: 'The Swallowed Ring',
        body: 'A kohen swallowed a ring that had contracted corpse impurity. He immersed in a mikveh. Evening arrives, and his teruma is on the table. The ring is still inside him.',
        question: 'May he eat? Is he tahor?',
        answer: 'tahor',
        explanation:
          'The mishnah in Mikvaot rules: he immerses and eats his teruma. The impure ring inside him is sealed off by his body — it cannot render him (or anything else) impure while swallowed.',
        hebrew: 'בָּלַע טַבַּעַת טְמֵאָה — טוֹבֵל וְאוֹכֵל בִּתְרוּמָתוֹ',
        source: 'Mikvaot 10:8, cited at Chullin 71b:12',
        url: 'Chullin.71b.12',
      },
      {
        title: 'The Ring Returns',
        body: 'Days later, the same kohen vomits the ring back up.',
        question: 'The ring — and whoever now touches it?',
        answer: 'tamei',
        explanation:
          'The ring never lost its impurity — the body shielded others FROM it, but did not purify it. Once it re-emerges, it is impure as ever and contaminates on contact. Encapsulation is a shield, not a mikveh.',
        hebrew: 'הֱקִיאָהּ — טְמֵאָה, וְטִמְּאַתּוּ',
        source: 'Mikvaot 10:8, cited at Chullin 71b:12',
        url: 'Chullin.71b.12',
      },
      {
        title: 'The Pure Ring',
        body: 'Another man swallowed a PURE ring — then walked into a tent over a corpse, becoming tamei himself. He was sprinkled on day three and day seven, immersed, and is pure again. Then he vomits up the ring.',
        question: 'The ring — how do you rule?',
        answer: 'tahor',
        explanation:
          'The ring is "as it was" — still pure. Encapsulated inside his body, it was shielded from the corpse impurity that struck him. The pure stays pure inside, just as the impure stays contained. This is the mirror half of Rabba’s principle.',
        hebrew: 'בָּלַע טַבַּעַת טְהוֹרָה וְנִכְנַס לְאֹהֶל הַמֵּת, וְהִזָּה וְשָׁנָה וְטָבַל וֶהֱקִיאָהּ — הֲרֵי הִיא כְּמוֹת שֶׁהָיְתָה',
        source: 'Mikvaot 10:8, cited at Chullin 71b:13',
        url: 'Chullin.71b.13',
      },
      {
        title: 'The Sealed Jar',
        body: 'A clay jar, its lid sealed tight (tzamid patil), holds a piece of a corpse. The jar sits inside a house. Elsewhere in the house sit vessels and food.',
        question: 'The rest of the house — how do you rule?',
        answer: 'tamei',
        explanation:
          'A sealed clay vessel shields its CONTENTS from impurity outside — but it does not shield the house from the impurity within it; corpse impurity bursts out and fills the tent. That is exactly the daf’s kal va-chomer: if even the sealed jar fails here, the living body — which DOES contain its impurity — surely shields what is pure inside it.',
        hebrew: 'וּמָה כְּלִי חֶרֶס הַמּוּקָּף צָמִיד פָּתִיל, שֶׁאֵינוֹ מַצִּיל עַל טוּמְאָה שֶׁבְּתוֹכוֹ מִלְּטַמֵּא...',
        source: 'Chullin 71a:24',
        url: 'Chullin.71a.24',
      },
      {
        title: 'From Below',
        body: 'The impure item did not go in through the mouth: it entered the body from below. While it is inside —',
        question: 'Does its impurity escape? How do you rule?',
        answer: 'tahor',
        explanation:
          'Still encapsulated, still contained. The Gemara derives it a fortiori from digestion: if entry from above — where digestion is weaker — contains impurity, entry below, where "the digestion is greater," certainly does.',
        hebrew: 'אַשְׁכְּחַן בָּלוּעַ דִּלְמַעְלָה, בָּלוּעַ דִּלְמַטָּה מְנָלַן?... עִיכּוּל דִּלְמַטָּה רַב',
        source: 'Chullin 71b:5–6',
        url: 'Chullin.71b.5',
      },
      {
        title: 'Cloak on the Shoulder',
        body: 'A man enters a house struck with tzara’at (leprosy of houses). His cloak is slung over his shoulder — not worn — and his sandals and rings are carried in his hands.',
        question: 'The cloak, sandals, and rings — immediately?',
        answer: 'tamei',
        explanation:
          'He and they are impure immediately. Only clothes WORN normally get a grace period (pure until he lingers long enough to eat half a loaf). Carried items count as separate vessels entering the house — the same reason utensils strapped to an animal’s back become impure at once. The daf uses this to extend encapsulation from humans to animals.',
        hebrew: 'הַנִּכְנָס לְבַיִת הַמְנוּגָּע וְכֵלָיו עַל כְּתֵפָיו, וְסַנְדָּלָיו וְטַבְּעוֹתָיו בְּיָדָיו — הוּא וְהֵן טְמֵאִין מִיָּד',
        source: 'Mishnah Nega’im 13:9, cited at Chullin 71b:10',
        url: 'Chullin.71b.10',
      },
      {
        title: 'Two Rings — the Finale',
        body: 'One man swallows TWO rings: one corpse-impure, one pure. Both now sit together, side by side, in his innards.',
        question: 'Does the impure ring contaminate the pure one?',
        answer: 'tahor',
        explanation:
          'This is Rabba’s actual chiddush. Rava objected that both halves of the principle were already taught in Mikvaot — so what did Rabba add? This: INSIDE the body, impurity neither escapes nor spreads, not even from one swallowed item to its neighbor. The body shields everything it swallows, even from each other.',
        hebrew: 'כִּי קָאָמַר רַבָּה — כְּגוֹן שֶׁבָּלַע שְׁתֵּי טַבָּעוֹת, אַחַת טְמֵאָה וְאַחַת טְהוֹרָה, דְּלָא מְטַמְּיָא לַהּ',
        source: 'Chullin 71b:14',
        url: 'Chullin.71b.14',
      },
    ];

    const HEB_NUMS = ['א', 'ב', 'ג', 'ד', 'ה', 'ו', 'ז', 'ח', 'ט', 'י'];

    let idx = 0;
    let score = 0;
    let streak = 0;
    let answered = false;
    const record = [];

    const $ = (id) => document.getElementById(id);

    function buildRingTrack() {
      const track = $('ring-track');
      track.innerHTML = CASES.map(
        (_, i) => `
        <svg class="ring-slot" data-slot="${i}" width="18" height="18" viewBox="0 0 20 20" aria-hidden="true">
          <circle cx="10" cy="10" r="7" fill="none" stroke="#3f4656" stroke-width="2.5"/>
        </svg>`
      ).join('');
    }

    function earnRing(i) {
      const slot = document.querySelector(`[data-slot="${i}"]`);
      slot.classList.add('earned');
      slot.innerHTML =
        '<circle class="fill" cx="10" cy="10" r="7" fill="none" stroke="#c9a227" stroke-width="4"/>';
    }

    function renderCase() {
      const c = CASES[idx];
      answered = false;
      $('case-kicker').textContent = `Case ${idx + 1} of ${CASES.length}`;
      $('case-heb-num').textContent = HEB_NUMS[idx];
      $('case-title').textContent = c.title;
      $('case-body').textContent = c.body;
      $('case-question').textContent = c.question;
      $('progress-label').textContent = `Case ${idx + 1} of ${CASES.length}`;
      $('result-panel').classList.add('hidden');
      $('verdict-buttons').classList.remove('hidden');
      $('btn-tamei').disabled = false;
      $('btn-tahor').disabled = false;
      $('case-card').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function rule(verdict) {
      if (answered) return;
      answered = true;
      const c = CASES[idx];
      const correct = verdict === c.answer;
      record.push({ title: c.title, correct, answer: c.answer, source: c.source, url: c.url });

      if (correct) {
        score++;
        streak++;
        earnRing(idx);
      } else {
        streak = 0;
      }
      const streakEl = $('streak-label');
      if (streak >= 3) {
        streakEl.textContent = `🔥 ${streak} straight`;
        streakEl.classList.remove('hidden');
      } else {
        streakEl.classList.add('hidden');
      }

      const panel = $('result-panel');
      const isTahor = c.answer === 'tahor';
      panel.className = `mt-5 rounded-2xl border p-5 sm:p-6 ${
        isTahor ? 'border-[#2f7c74]/50 bg-[#2f7c74]/10' : 'border-[#b4432f]/50 bg-[#b4432f]/10'
      }`;
      $('result-headline').innerHTML = correct
        ? `<span class="!text-emerald-400">✓ Correct.</span> <span class="${isTahor ? '!text-[#4ec2b8]' : '!text-[#d4604a]'}">The ruling is ${c.answer.toUpperCase()}.</span>`
        : `<span class="!text-rose-400">✗ Not this time.</span> <span class="${isTahor ? '!text-[#4ec2b8]' : '!text-[#d4604a]'}">The ruling is ${c.answer.toUpperCase()}.</span>`;
      $('result-explanation').textContent = c.explanation;
      $('result-hebrew').textContent = c.hebrew;
      const src = $('result-source');
      src.textContent = `${c.source} ↗`;
      src.href = SEFARIA + c.url;
      panel.classList.remove('hidden');
      $('verdict-buttons').classList.add('hidden');
      $('btn-next').textContent = idx === CASES.length - 1 ? 'See your record →' : 'Next case →';
      $('btn-next').focus();
    }

    function gradeFor(s) {
      if (s === 10) return ['רַבָּה', 'A perfect record — you saw the chiddush inside the chiddush. Rabba would nod.'];
      if (s >= 8) return ['רָבָא', 'Sharp. Like Rava, you knew most of it was already in the Mishnah.'];
      if (s >= 6) return ['בַּר פְּלוּגְתָּא', 'A worthy disputant — you win some kal va-chomers and lose some.'];
      if (s >= 3) return ['תַּלְמִיד', 'The sugya swallowed you a few times. Open the daf and re-emerge.'];
      return ['הַטַּבַּעַת', 'You are the ring: fully encapsulated. Time to learn the daf itself.'];
    }

    function endGame() {
      $('game-area').classList.add('hidden');
      const [heb, line] = gradeFor(score);
      $('final-score').textContent = `${score}/10`;
      $('final-grade').textContent = heb;
      $('final-line').textContent = line;
      $('review-list').innerHTML = record
        .map(
          (r) => `
        <a href="${SEFARIA + r.url}" target="_blank" rel="noopener"
           class="flex items-center justify-between gap-3 rounded-xl border border-slate-800 bg-slate-900/50 px-4 py-2.5 text-sm hover:border-amber-800">
          <span>${r.correct ? '✅' : '❌'} ${r.title}</span>
          <span class="text-xs ${r.answer === 'tahor' ? '!text-[#4ec2b8]' : '!text-[#d4604a]'}">${r.answer}</span>
        </a>`
        )
        .join('');
      $('end-screen').classList.remove('hidden');
      $('end-screen').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function next() {
      if (idx === CASES.length - 1) return endGame();
      idx++;
      renderCase();
    }

    function replay() {
      idx = 0;
      score = 0;
      streak = 0;
      record.length = 0;
      buildRingTrack();
      $('streak-label').classList.add('hidden');
      $('end-screen').classList.add('hidden');
      $('game-area').classList.remove('hidden');
      renderCase();
    }

    async function share() {
      const rings = record.map((r) => (r.correct ? '⭕' : '➖')).join('');
      const text = `The Swallowed Ring (Daf Yomi · Chullin 71): I ruled ${score}/10 correctly.\n${rings}\n`;
      const url = location.href;
      try {
        if (navigator.share) await navigator.share({ title: 'The Swallowed Ring', text, url });
        else {
          await navigator.clipboard.writeText(text + url);
          $('btn-share').textContent = 'Copied!';
          setTimeout(() => ($('btn-share').textContent = 'Share score'), 1500);
        }
      } catch {}
    }

    $('btn-tamei').addEventListener('click', () => rule('tamei'));
    $('btn-tahor').addEventListener('click', () => rule('tahor'));
    $('btn-next').addEventListener('click', next);
    $('btn-replay').addEventListener('click', replay);
    $('btn-share').addEventListener('click', share);
    document.addEventListener('keydown', (e) => {
      if (e.target.closest('input,textarea')) return;
      if (!answered && e.key === '1') rule('tamei');
      else if (!answered && e.key === '2') rule('tahor');
      else if (answered && (e.key === 'Enter' || e.key === ' ')) {
        if (document.activeElement !== $('btn-next')) next();
      }
    });

    buildRingTrack();
    renderCase();
  </script>
</Layout>
