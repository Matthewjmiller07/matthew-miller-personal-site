              },
              {
                t: 'Ulla: hidden contact defiles in animals but not in garments.',
                why: 'Invented — Ulla’s distinction is not what the thing is, but when: the instant of separation, before the parting is complete.',
              },
            ],
            forged: {
              who: 'Ulla',
              text: 'At the moment of parting from their parent, the pieces take impurity from it — all agree.',
              he: 'בִּשְׁעַת פְּרִישָׁתָן מֵאֲבִיהֶן, מְקַבְּלוֹת טוּמְאָה מֵאֲבִיהֶן',
              ref: 'Chullin 72b:12–13',
              url: 'Chullin.72b.12',
            },
          },
          {
            prompt: 'Ravina forges a different link — the last of the daf:',
            choices: [
              {
                t: 'A garment does not stand to be cut; the emerged foreleg does stand to be cut — forbidden flesh joined to permitted flesh. And whatever stands to be cut… is as cut already: the seam counts as exposed, not hidden.',
                ok: true,
              },
              {
                t: 'Ravina: the foreleg is drawn back and rejoins the mother’s body.',
                why: 'Invented — Ravina’s move runs the other way: the limb is so surely destined for the knife that it is already, in law, severed.',
              },
              {
                t: 'Ravina: the impurity here is rabbinic, so even hidden contact suffices.',
                why: 'Invented — the “rabbinic” answer belonged to the midwife’s chain. Ravina answers with destiny: what stands to be cut is as cut.',
              },
            ],
            forged: {
              who: 'Ravina',
              text: 'The foreleg stands to be cut — and whatever stands to be cut is as cut.',
              he: 'עוּבָּר – לַחֲתִיכָה קָאֵי, וְכׇל הָעוֹמֵד לַחְתּוֹךְ... כְּחָתוּךְ דָּמֵי',
              ref: 'Chullin 72b:14 → 73a:1',
              url: 'Chullin.72b.14',
              severed: true,
            },
          },
        ],
      },
    ];

    const TOTAL = CHAINS.reduce((n, ch) => n + ch.steps.length, 0);

    let c = 0;
    let s = 0;
    let picksThisStep = 0;
    let score = 0;
    const chainScores = CHAINS.map(() => 0);

    const $ = (id) => document.getElementById(id);

    function linkSVG(severed) {
      if (severed) {
        return `<svg width="26" height="40" viewBox="0 0 26 40" aria-hidden="true" class="shrink-0">
          <path class="hot" d="M 13 4 a 8 9 0 0 0 -8 9 v 6 M 13 4 a 8 9 0 0 1 8 9 v 2" fill="none" stroke="#e0862f" stroke-width="4" stroke-linecap="round"/>
          <path class="hot" d="M 5 27 v 0 a 8 9 0 0 0 8 9 a 8 9 0 0 0 8 -9 v -4" fill="none" stroke="#e0862f" stroke-width="4" stroke-linecap="round" opacity="0.45"/>
        </svg>`;
      }
      return `<svg width="26" height="40" viewBox="0 0 26 40" aria-hidden="true" class="shrink-0">
        <rect class="hot" x="5" y="3" width="16" height="34" rx="8" fill="none" stroke="#e0862f" stroke-width="4"/>
      </svg>`;
    }

    function buildBadges() {
      $('chain-badges').innerHTML = CHAINS.map((ch, i) => {
        const state = i < c ? 'done' : i === c ? 'now' : 'wait';
        const cls =
          state === 'done'
            ? 'border-orange-600/70 bg-orange-950/40 !text-orange-300'
            : state === 'now'
              ? 'border-slate-500 bg-[#1a1f28] !text-slate-200'
              : 'border-slate-800 !text-slate-600';
        const mark = state === 'done' ? `⛓ ${chainScores[i]}/${CHAINS[i].steps.length}` : `${i + 1}`;
        return `<span class="rounded-full border px-2.5 py-1 text-[11px] font-bold ${cls}">${mark}</span>`;
      }).join('');
      $('forge-label').textContent = `⚒ ${score} first-strike link${score === 1 ? '' : 's'}`;
    }

    function renderChainHeader() {
      const ch = CHAINS[c];
      $('chain-kicker').textContent = ch.kicker;
      $('chain-heb').textContent = ch.heb;
      $('chain-title').textContent = ch.title;
      $('chain-intro').textContent = ch.intro;
      $('forged-list').innerHTML = '';
    }

    function appendForgedLink(f) {
      const li = document.createElement('li');
      li.className = 'forged-item flex gap-3 py-1';
      li.innerHTML = `
        ${linkSVG(f.severed)}
        <div class="min-w-0 pb-2">
          <p class="text-[13px] leading-snug !text-slate-200"><span class="font-bold !text-orange-300/90">${f.who}:</span> ${f.text}</p>
          <p class="frank mt-0.5 text-[15px] leading-snug !text-slate-400" dir="rtl" lang="he">${f.he}</p>
          <a href="${SEFARIA + f.url}" target="_blank" rel="noopener" class="text-[11px] !text-slate-500 hover:!text-orange-400 hover:underline">${f.ref} ↗</a>
        </div>`;
      $('forged-list').appendChild(li);
    }

    function shuffled(arr) {
      const a = arr.map((x, i) => [Math.random(), i]);
      a.sort((p, q) => p[0] - q[0]);
      return a.map(([, i]) => arr[i]);
    }

    let currentOrder = [];

    function renderStep() {
      const step = CHAINS[c].steps[s];
      picksThisStep = 0;
      $('anvil').classList.remove('hidden');
      $('chain-done').classList.add('hidden');
      $('step-prompt').textContent = step.prompt;
      currentOrder = shuffled(step.choices);
      $('choices').innerHTML = currentOrder
        .map(
          (ch, i) => `
        <button class="choice-card" data-i="${i}">
          <span class="flex items-start gap-3">
            <kbd class="kbd mt-0.5 shrink-0">${i + 1}</kbd>
            <span class="text-sm leading-relaxed !text-slate-200">${ch.t}</span>
          </span>
          <span class="why mt-2 hidden border-t border-[#cf5b47]/30 pt-2 text-xs leading-relaxed !text-[#e0938a]"></span>
        </button>`
        )
        .join('');
      document.querySelectorAll('#choices .choice-card').forEach((btn) => {
        btn.addEventListener('click', () => pick(Number(btn.dataset.i)));
      });
    }

    function pick(i) {
      const btn = document.querySelector(`#choices [data-i="${i}"]`);
      if (!btn || btn.disabled) return;
      const choice = currentOrder[i];
      if (!choice.ok) {
        picksThisStep++;
        btn.disabled = true;
        btn.classList.add('cracked');
        const why = btn.querySelector('.why');
        why.textContent = '✗ ' + choice.why;
        why.classList.remove('hidden');
        return;
      }
      if (picksThisStep === 0) score++;
      btn.classList.add('forged-pick');
      document.querySelectorAll('#choices .choice-card').forEach((b) => (b.disabled = true));
      const step = CHAINS[c].steps[s];
      window.setTimeout(() => {
        appendForgedLink(step.forged);
        s++;
        buildBadges();
        if (s === CHAINS[c].steps.length) chainDone();
        else renderStep();
      }, 350);
    }

    function chainDone() {
      chainScores[c] = countChainScore();
      $('anvil').classList.add('hidden');
      const ch = CHAINS[c];
      $('chain-done-line').textContent = ch.doneLine;
      $('chain-done-sub').textContent = ch.doneSub;
      const src = $('chain-done-src');
      src.textContent = `Read this sugya inside · ${ch.kicker.split('· ')[1]} ↗`;
      src.href = SEFARIA + ch.url;
      $('btn-next-chain').textContent =
        c === CHAINS.length - 1 ? 'The daf’s last link →' : `Next chain: ${CHAINS[c + 1].title} →`;
      $('chain-done').classList.remove('hidden');
      $('btn-next-chain').focus();
      buildBadges();
    }

    let forgedFirstTryAtChainStart = 0;
    function countChainScore() {
      const earned = score - forgedFirstTryAtChainStart;
      return earned;
    }

    function nextChain() {
      $('chain-done').classList.add('hidden');
      if (c === CHAINS.length - 1) {
        $('coda').classList.remove('hidden');
        $('coda').scrollIntoView({ behavior: 'smooth', block: 'center' });
        $('btn-end').focus();
        return;
      }
      c++;
      s = 0;
      forgedFirstTryAtChainStart = score;
      buildBadges();
      renderChainHeader();
      renderStep();
      $('chain-header').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function gradeFor(n) {
      if (n === TOTAL)
        return ['רָבִינָא', 'A flawless forge — you spoke the daf’s last word before the page was cut.'];
      if (n >= 14) return ['עוּלָּא', 'You reconcile mishnayot in your sleep. Almost every link rang true.'];
      if (n >= 10)
        return ['פּוּמְבְּדִיתָאֵי', 'The scholars of Pumbedita know the reason of the matter — and so, mostly, do you.'];
      if (n >= 5)
        return ['תַּלְמִיד בַּמַּפָּחָה', 'An apprentice at the bellows: some links cracked on the anvil. Reheat and strike again.'];
      return ['בֶּגֶד שֶׁנֶּחְלַק', 'The split garment: pieces everywhere. Open the daf and forge it whole.'];
    }

    function endGame() {
      $('coda').classList.add('hidden');
      $('game-area').classList.add('hidden');
      const [heb, line] = gradeFor(score);
      $('final-score').textContent = `${score}/${TOTAL}`;
      $('final-grade').textContent = heb;
      $('final-line').textContent = line;
      $('review-list').innerHTML = CHAINS.map(
        (ch, i) => `
        <a href="${SEFARIA + ch.url}" target="_blank" rel="noopener"
           class="flex items-center justify-between gap-3 rounded-xl border border-slate-800 bg-slate-900/50 px-4 py-2.5 text-sm hover:border-orange-800">
          <span class="!text-slate-200">⛓ ${ch.title}</span>
          <span class="text-xs !text-orange-300">${chainScores[i]}/${ch.steps.length} first-strike</span>
        </a>`
      ).join('');
      $('end-screen').classList.remove('hidden');
      $('end-screen').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function replay() {
      c = 0;
      s = 0;
      score = 0;
      picksThisStep = 0;
      forgedFirstTryAtChainStart = 0;
      chainScores.fill(0);
      $('end-screen').classList.add('hidden');
      $('coda').classList.add('hidden');
      $('game-area').classList.remove('hidden');
      buildBadges();
      renderChainHeader();
      renderStep();
    }

    async function share() {
      const bars = chainScores.map((n, i) => `${n}/${CHAINS[i].steps.length}`).join(' · ');
      const text = `The Severed Link (Daf Yomi · Chullin 72): I forged ${score}/${TOTAL} links on the first strike.\n⛓ ${bars}\n`;
      const url = location.href;
      try {
        if (navigator.share) await navigator.share({ title: 'The Severed Link', text, url });
        else {
          await navigator.clipboard.writeText(text + url);
          $('btn-share').textContent = 'Copied!';
          setTimeout(() => ($('btn-share').textContent = 'Share score'), 1500);
        }
      } catch {}
    }

    $('btn-next-chain').addEventListener('click', () => {
      chainScores[c] = countChainScore();
      nextChain();
    });
    $('btn-end').addEventListener('click', endGame);
    $('btn-replay').addEventListener('click', replay);
    $('btn-share').addEventListener('click', share);
    document.addEventListener('keydown', (e) => {
      if (e.target.closest('input,textarea')) return;
      if (['1', '2', '3'].includes(e.key) && !$('anvil').classList.contains('hidden')) {
        pick(Number(e.key) - 1);
      }
    });

    buildBadges();
    renderChainHeader();
    renderStep();
  </script>
</Layout>
