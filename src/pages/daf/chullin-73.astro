---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="The Phantom Knife — Daf Yomi Game: Chullin 73"
  description="Six scenes from Chullin 73 — the vessel's handle, the emerged foreleg, the dangling limb. Click where the halakhic knife falls: whatever stands to be cut is as though already cut."
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;700;900&display=swap"
  />

  <main class="min-h-screen bg-[#090d11] !text-slate-100">
    <!-- ============ Hero ============ -->
    <div class="border-b border-cyan-900/30 bg-gradient-to-b from-cyan-950/25 to-transparent px-4 pt-10 pb-8 text-center">
      <p class="mb-3 text-xs uppercase tracking-[0.3em] !text-cyan-500/80">
        <a href="/daf" class="hover:!text-cyan-300">daf yomi arcade</a> · chullin 73 · 2026-07-12
      </p>
      <h1 class="frank text-4xl font-black tracking-tight sm:text-5xl">🔪 The Phantom Knife</h1>
      <p class="frank mt-1 text-2xl !text-cyan-200/90" dir="rtl" lang="he">כְּחָתוּךְ דָּמֵי</p>
      <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed !text-slate-400">
        Yesterday's daf was severed mid-sentence. Today's opens with the missing words:
        <span class="frank !text-cyan-300" dir="rtl" lang="he">כְּחָתוּךְ דָּמֵי</span> —
        <em>whatever stands to be cut is regarded as already cut.</em>
        All of Chullin 73 is ruled by a knife that never touches anything, yet severs handles,
        forelegs, and dangling limbs in the eyes of the law.
        <strong class="!text-slate-200">You hold that knife.</strong>
        In each scene, decide where the phantom cut falls — or whether it stays in its sheath.
      </p>
    </div>

    <div class="mx-auto max-w-2xl px-4 pb-16 pt-8">
      <!-- ============ Blade tally ============ -->
      <div class="mb-6 flex items-center justify-between gap-4">
        <div id="scene-badges" class="flex flex-wrap gap-2" aria-label="Progress: six scenes"></div>
        <div class="shrink-0 text-right text-xs !text-slate-500">
          <span id="tally-label">🔪 0 clean cuts</span>
        </div>
      </div>

      <div id="game-area">
        <!-- ============ Scene card ============ -->
        <div class="mb-5 rounded-2xl border border-slate-800 bg-[#111820] p-5">
          <div class="flex items-baseline justify-between gap-3">
            <span id="scene-kicker" class="text-[11px] font-bold uppercase tracking-[0.2em] !text-cyan-500/90"></span>
            <span id="scene-heb" class="frank text-lg !text-cyan-200/80" dir="rtl" lang="he"></span>
          </div>
          <h2 id="scene-title" class="frank mt-1 text-2xl font-bold !text-slate-100"></h2>
          <p id="scene-sage" class="mt-2 text-[11px] font-bold uppercase tracking-[0.15em] !text-slate-500"></p>
          <p id="scene-prompt" class="mt-2 text-sm leading-relaxed !text-slate-300"></p>
        </div>

        <!-- ============ The scene ============ -->
        <div class="scene-frame rounded-2xl p-3 sm:p-4">
          <div id="scene-svg"></div>
        </div>

        <!-- ============ Choices ============ -->
        <div id="choices" class="mt-4 space-y-3" role="group" aria-label="Choose where the cut falls"></div>

        <!-- ============ Reveal ============ -->
        <div id="reveal" class="mt-4 hidden rounded-2xl border border-cyan-800/40 bg-cyan-950/20 p-5">
          <p class="text-[11px] font-bold uppercase tracking-[0.2em] !text-cyan-400">the cut, as ruled</p>
          <p class="mt-2 text-sm leading-relaxed !text-slate-200"><span id="reveal-who" class="font-bold !text-cyan-300"></span> <span id="reveal-text"></span></p>
          <p id="reveal-he" class="frank mt-2 text-lg leading-snug !text-slate-300" dir="rtl" lang="he"></p>
          <a id="reveal-src" href="#" target="_blank" rel="noopener" class="mt-2 inline-block text-xs !text-cyan-400 hover:!text-cyan-300 hover:underline"></a>
          <div class="mt-4">
            <button id="btn-next" class="rounded-xl bg-cyan-600 px-5 py-2.5 text-sm font-bold !text-slate-950 transition-colors hover:bg-cyan-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"></button>
          </div>
        </div>
      </div>

      <!-- ============ Coda: the sugya itself is cut ============ -->
      <div id="coda" class="hidden rounded-2xl border border-slate-700 bg-[#111820] p-6 text-center">
        <p class="frank text-3xl font-black !text-cyan-300" dir="rtl" lang="he">אֶלָּא —</p>
        <p class="mt-3 text-sm leading-relaxed !text-slate-400">
          One last cut. Rabbi Meir's own baraita slices down the first version of the dispute you
          just played, and the Gemara re-states it in reverse:
          <span class="frank !text-slate-300" dir="rtl" lang="he">אִי אִתְּמַר הָכִי אִתְּמַר</span>
          — <em>"if it was stated, thus it was stated"</em> (73b:3). On a daf where whatever stands
          to be cut is already cut, even the sugya stood to be cut. What survives is the blade you
          tested in scenes 4 and 5 — Rav Yosef says: <strong class="!text-cyan-300">take it in your
          hand</strong>. Death makes the limb fall; slaughter does not.
        </p>
        <div class="mt-4">
          <button id="btn-end" class="rounded-xl bg-cyan-600 px-5 py-2.5 text-sm font-bold !text-slate-950 transition-colors hover:bg-cyan-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">Sheathe the knife →</button>
        </div>
      </div>

      <!-- ============ End screen ============ -->
      <div id="end-screen" class="hidden text-center">
        <div class="rounded-2xl border border-cyan-800/40 bg-gradient-to-b from-cyan-950/30 to-[#111820] p-8">
          <p class="text-[11px] font-bold uppercase tracking-[0.2em] !text-cyan-400/90">Your blade record</p>
          <div id="final-score" class="frank mt-2 text-6xl font-black !text-slate-100"></div>
          <p class="text-xs uppercase tracking-widest !text-slate-500">clean cuts on the first stroke</p>
          <div id="final-grade" class="frank mt-3 text-2xl font-bold !text-cyan-300" dir="rtl" lang="he"></div>
          <p id="final-line" class="mx-auto mt-2 max-w-md text-sm !text-slate-400"></p>
        </div>
        <div class="mt-5 flex flex-wrap justify-center gap-3">
          <button id="btn-replay" class="rounded-xl border border-slate-700 px-5 py-2.5 text-sm font-bold !text-slate-200 transition-colors hover:border-cyan-600 hover:!text-cyan-300">↻ Whet the blade again</button>
          <button id="btn-share" class="rounded-xl bg-cyan-600 px-5 py-2.5 text-sm font-bold !text-slate-950 transition-colors hover:bg-cyan-500">Share score</button>
        </div>
        <div id="review-list" class="mt-8 space-y-2 text-left"></div>
      </div>

      <!-- ============ Learn the real daf ============ -->
      <div class="mt-14 border-t border-slate-800 pt-8">
        <h3 class="frank mb-3 text-xl font-bold !text-cyan-200">Learn the real daf</h3>
        <p class="text-sm leading-relaxed !text-slate-400">
          Every cut above is straight from the Gemara. Chullin 73 opens by tracing Ravina's phantom
          cut to Rabbi Meir's ruling on over-long vessel handles in a mikveh (Mikvaot 10:5) — and
          answers that even the Rabbis, who demand the whole vessel go under, concede the cut for
          <em>food</em>. It then replays the mishna's duel between Rabbi Meir and the Rabbis over
          the fetus's emerged foreleg, asks whether their dispute extends to a limb dangling from
          the animal itself — a machloket between Reish Lakish and Rabbi Yoḥanan that the Gemara
          cuts down and re-states in reverse — and closes with the ruling Rav Yosef says to take in
          your hand: <span class="frank" dir="rtl" lang="he">מִיתָה עוֹשָׂה נִיפּוּל, וְאֵין שְׁחִיטָה עוֹשָׂה נִיפּוּל</span> —
          death makes a dangling limb as though fallen; slaughter does not.
        </p>
        <div class="mt-4 flex flex-wrap gap-2 text-xs">
          <a href="https://www.sefaria.org/Chullin.73a" target="_blank" rel="noopener" class="rounded-full border border-cyan-800/50 bg-cyan-950/30 px-3 py-1.5 !text-cyan-300 hover:border-cyan-600">Chullin 73 on Sefaria ↗</a>
          <span class="rounded-full border border-slate-800 px-3 py-1.5 !text-slate-400">Rashi ×45</span>
          <span class="rounded-full border border-slate-800 px-3 py-1.5 !text-slate-400">Steinsaltz ×30</span>
          <span class="rounded-full border border-slate-800 px-3 py-1.5 !text-slate-400">Rabbeinu Gershom ×27</span>
          <span class="rounded-full border border-slate-800 px-3 py-1.5 !text-slate-400">Tosafot ×7</span>
        </div>
        <p class="mt-6 text-xs !text-slate-600">
          Part of the <a href="/daf" class="underline decoration-slate-700 hover:!text-slate-400">Daf Yomi Arcade</a> —
          a new game from every daf. Texts and links via the Sefaria API.
        </p>
      </div>
    </div>
  </main>

  <style>
    .frank {
      font-family: 'Frank Ruhl Libre', Georgia, 'Times New Roman', serif;
    }
    .scene-frame {
      background: linear-gradient(170deg, #131b23, #0d1319 70%);
      border: 1px solid #263340;
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.04),
        0 10px 30px rgba(0, 0, 0, 0.5);
    }
    .choice-card {
      width: 100%;
      text-align: left;
      border-radius: 1rem;
      border: 2px solid #2d3a47;
      background: #111820;
      padding: 1rem 1.1rem;
      transition: border-color 0.2s, background-color 0.2s, transform 0.2s;
    }
    .choice-card:hover:not(:disabled) {
      border-color: #59b7d3;
      background: #131c25;
    }
    .choice-card:focus-visible {
      outline: 2px solid #59b7d3;
      outline-offset: 2px;
    }
    .choice-card.botched {
      border-color: rgba(208, 90, 90, 0.7);
      background: rgba(208, 90, 90, 0.08);
      animation: botch-shake 0.35s ease-out;
    }
    .choice-card.clean-pick {
      border-color: #59b7d3;
      background: rgba(89, 183, 211, 0.12);
    }
    .choice-card:disabled { cursor: default; }
    @keyframes botch-shake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-5px); }
      55% { transform: translateX(4px); }
      80% { transform: translateX(-2px); }
    }
    .kbd {
      display: inline-block;
      border: 1px solid currentColor;
      border-radius: 4px;
      padding: 0 4px;
      font-size: 9px;
      opacity: 0.6;
    }
    /* --- SVG scene mechanics --- */
    #scene-svg svg { display: block; width: 100%; height: auto; }
    .cutline {
      stroke: #e0b45c;
      stroke-width: 2.5;
      stroke-dasharray: 6 5;
      stroke-linecap: round;
      fill: none;
    }
    .cutline.peek { stroke: #ffd98a; filter: drop-shadow(0 0 3px rgba(255, 217, 138, 0.7)); }
    .cutline.active {
      stroke: #9fe3f7;
      stroke-dasharray: none;
      filter: drop-shadow(0 0 5px rgba(140, 220, 245, 0.9));
    }
    .marker-dot { fill: #0b1117; stroke: #e0b45c; stroke-width: 2; }
    .marker-num { fill: #e0b45c; font: bold 11px system-ui, sans-serif; text-anchor: middle; }
    .sever { transition: transform 0.8s ease, opacity 0.8s ease; }
    .sever.drift-up { transform: translateY(-16px); opacity: 0.5; }
    .sever.drift-down { transform: translateY(14px); opacity: 0.65; }
    .sever.drift-right { transform: translateX(14px); }
    .sever.slide-home { transform: translateX(-52px); }
    .sever.plunge { transform: translateY(54px); }
    .held { stroke: #9fe3f7 !important; filter: drop-shadow(0 0 5px rgba(140, 220, 245, 0.9)); }
    @media (prefers-reduced-motion: reduce) {
      .choice-card.botched { animation: none; }
      .sever { transition: none; }
    }
  </style>

  <script>
    const SEFARIA = 'https://www.sefaria.org/';

    // ---------- Scene renderers ----------
    // Every scene is decorative (aria-hidden); the real controls are the buttons below.
    // Dashed .cutline elements carry data-marker ids so choices can peek/activate them.

    function sceneMikveh() {
      return `<svg viewBox="0 0 340 214" aria-hidden="true">
        <rect x="8" y="70" width="324" height="138" rx="10" fill="#10303f" opacity="0.75"/>
        <line x1="8" y1="70" x2="332" y2="70" stroke="#5aa8c4" stroke-width="2"/>
        <path d="M22 80 q8 -5 16 0 t16 0 t16 0" stroke="#3d7c95" fill="none" stroke-width="1.5" opacity="0.6"/>
        <path d="M238 86 q8 -5 16 0 t16 0" stroke="#3d7c95" fill="none" stroke-width="1.5" opacity="0.5"/>
        <g id="vessel" class="sever">
          <rect x="120" y="122" width="96" height="62" rx="12" fill="#1b232c" stroke="#9db4c0" stroke-width="3"/>
          <rect x="160" y="70" width="15" height="56" fill="#1b232c" stroke="#9db4c0" stroke-width="3"/>
          <g id="sever-top" class="sever">
            <rect x="160" y="16" width="15" height="54" fill="#1b232c" stroke="#9db4c0" stroke-width="3"/>
          </g>
        </g>
        <line class="cutline" data-marker="m1" x1="146" y1="124" x2="190" y2="124"/>
        <circle class="marker-dot" cx="206" cy="124" r="9"/><text class="marker-num" x="206" y="128">1</text>
        <line class="cutline" data-marker="m2" x1="146" y1="70" x2="190" y2="70"/>
        <circle class="marker-dot" cx="206" cy="70" r="9"/><text class="marker-num" x="206" y="74">2</text>
        <text x="264" y="46" fill="#7b93a3" font-size="11" text-anchor="middle" font-style="italic">the extra handle</text>
        <text x="60" y="160" fill="#4d7c93" font-size="11" text-anchor="middle" font-style="italic">mikveh</text>
      </svg>`;
    }

    function sceneFetus() {
      return `<svg viewBox="0 0 340 214" aria-hidden="true">
        <ellipse cx="148" cy="108" rx="128" ry="86" fill="#141b22" stroke="#9db4c0" stroke-width="3"/>
        <path d="M 196 84 A 55 55 0 1 0 196 132" fill="#0f151b" stroke="#5f7684" stroke-width="2.5"/>
        <circle cx="143" cy="108" r="30" fill="#1e2933" stroke="#c8d6de" stroke-width="2.5"/>
        <circle cx="150" cy="100" r="3" fill="#8fb3c7"/>
        <g id="sever-limb" class="sever">
          <rect x="170" y="100" width="142" height="16" rx="8" fill="#1e2933" stroke="#c8d6de" stroke-width="2.5"/>
        </g>
        <line class="cutline" data-marker="m1" x1="176" y1="86" x2="176" y2="130"/>
        <circle class="marker-dot" cx="176" cy="70" r="9"/><text class="marker-num" x="176" y="74">1</text>
        <line class="cutline" data-marker="m2" x1="272" y1="86" x2="272" y2="130"/>
        <circle class="marker-dot" cx="272" cy="70" r="9"/><text class="marker-num" x="272" y="74">2</text>
        <text x="66" y="196" fill="#7b93a3" font-size="11" font-style="italic">the mother, mid-labor</text>
        <text x="296" y="136" fill="#7b93a3" font-size="11" text-anchor="middle" font-style="italic">the foreleg</text>
      </svg>`;
    }

    function sceneDangle(variant) {
      const head =
        variant === 'death'
          ? `<g stroke="#d05a5a" stroke-width="2.5" stroke-linecap="round">
               <line x1="272" y1="78" x2="282" y2="88"/><line x1="282" y1="78" x2="272" y2="88"/>
             </g>
             <text x="282" y="42" fill="#d08a8a" font-size="14" text-anchor="middle" class="frank">מֵתָה</text>`
          : `<circle cx="277" cy="82" r="3.5" fill="#8fb3c7"/>
             <g id="shechita-knife">
               <polygon points="228,34 268,34 260,46 228,44" fill="#aebfc9"/>
               <rect x="208" y="35" width="20" height="8" rx="3" fill="#5f7684"/>
             </g>
             <line x1="252" y1="50" x2="256" y2="62" stroke="#d05a5a" stroke-width="2.5" stroke-linecap="round"/>
             <text x="292" y="40" fill="#8fc4d6" font-size="14" text-anchor="middle" class="frank">נִשְׁחֲטָה</text>`;
      return `<svg viewBox="0 0 340 214" aria-hidden="true">
        <rect x="52" y="64" width="202" height="86" rx="42" fill="#141b22" stroke="#9db4c0" stroke-width="3"/>
        <circle cx="278" cy="88" r="27" fill="#141b22" stroke="#9db4c0" stroke-width="3"/>
        <rect x="86" y="146" width="12" height="42" rx="6" fill="#141b22" stroke="#9db4c0" stroke-width="2.5"/>
        <rect x="216" y="146" width="12" height="42" rx="6" fill="#141b22" stroke="#9db4c0" stroke-width="2.5"/>
        ${head}
        <rect id="strip" x="146" y="146" width="9" height="16" fill="#1e2933" stroke="#c8d6de" stroke-width="2"/>
        <g id="sever-limb" class="sever">
          <rect x="132" y="160" width="38" height="34" rx="10" fill="#1e2933" stroke="#c8d6de" stroke-width="2.5"/>
        </g>
        <line class="cutline" data-marker="m1" x1="132" y1="154" x2="170" y2="154"/>
        <circle class="marker-dot" cx="188" cy="154" r="9"/><text class="marker-num" x="188" y="158">1</text>
        <text x="108" y="206" fill="#7b93a3" font-size="11" text-anchor="middle" font-style="italic">the dangling limb</text>
      </svg>`;
    }

    function sceneReturn() {
      return `<svg viewBox="0 0 340 214" aria-hidden="true">
        <ellipse cx="86" cy="118" rx="76" ry="62" fill="#141b22" stroke="#9db4c0" stroke-width="2.5"/>
        <path d="M 114 104 A 34 34 0 1 0 114 132" fill="#0f151b" stroke="#5f7684" stroke-width="2"/>
        <circle cx="82" cy="118" r="18" fill="#1e2933" stroke="#c8d6de" stroke-width="2"/>
        <g id="ret-limb" class="sever">
          <rect x="98" y="112" width="80" height="12" rx="6" fill="#1e2933" stroke="#c8d6de" stroke-width="2"/>
        </g>
        <path class="cutline" data-marker="m1" d="M 176 106 C 196 62, 126 48, 98 84"/>
        <polygon points="98,84 110,80 106,92" fill="#e0b45c"/>
        <circle class="marker-dot" cx="196" cy="62" r="9"/><text class="marker-num" x="196" y="66">1</text>
        <text x="66" y="202" fill="#7b93a3" font-size="11" text-anchor="middle" class="frank">אֵבֶר דְּעוּבָּר</text>
        <rect x="212" y="78" width="112" height="56" rx="26" fill="#141b22" stroke="#9db4c0" stroke-width="2.5"/>
        <rect x="248" y="132" width="8" height="12" fill="#1e2933" stroke="#c8d6de" stroke-width="2"/>
        <rect x="236" y="142" width="32" height="28" rx="9" fill="#1e2933" stroke="#c8d6de" stroke-width="2"/>
        <path class="cutline" data-marker="m2" d="M 276 152 C 300 148, 302 120, 284 108"/>
        <polygon points="284,108 296,108 290,118" fill="#e0b45c"/>
        <circle class="marker-dot" cx="308" cy="136" r="9"/><text class="marker-num" x="308" y="140">2</text>
        <text x="266" y="202" fill="#7b93a3" font-size="11" text-anchor="middle" class="frank">אֵבֶר דִּבְהֵמָה</text>
      </svg>`;
    }

    const SCENES = {
      mikveh: sceneMikveh,
      fetus: sceneFetus,
      'dangle-death': () => sceneDangle('death'),
      'dangle-shechita': () => sceneDangle('shechita'),
      return: sceneReturn,
    };

    // ---------- Rounds ----------
    const ROUNDS = [
      {
        kicker: 'Scene 1 · Chullin 73a:2 (Mikvaot 10:5)',
        title: "The Vessel's Handle",
        heb: 'כׇּל יְדוֹת הַכֵּלִים',
        sage: 'According to Rabbi Meir —',
        prompt:
          'A vessel is immersed in a mikveh, but its handle is too long and stands to be cut down to size. The extra length still pokes above the water. Where does Rabbi Meir’s phantom knife fall, so that this immersion works?',
        scene: 'mikveh',
        options: [
          {
            key: 'm2',
            t: 'At the future cut point (②) — beyond it, the handle is as already cut off. Immerse only up to the place of its eventual measure, and the whole vessel is pure.',
            ok: true,
          },
          {
            key: 'm1',
            t: 'Where the handle meets the vessel (①) — handles never count for immersion.',
            why: 'Too deep a cut. A handle within its proper measure is part of the vessel and must go under. Only the excess that stands to be cut is disregarded.',
          },
          {
            key: 'sheath',
            t: 'The knife stays sheathed — the whole handle, tip and all, must go under the water.',
            why: 'That is the Rabbis’ blade you are holding (73a:3). Rabbi Meir rules: immerse עַד מָקוֹם מִדָּה — up to the point of its eventual size.',
          },
        ],
        reveal: {
          who: 'Rabbi Meir (Mikvaot 10:5):',
          text: 'Immerse it up to the point of its eventual size. What stands to be cut is already, in law, cut off — so the tip above the water is simply not there.',
          he: 'וְעָתִיד לְקׇצְצָן — מַטְבִּיל עַד מָקוֹם מִדָּה, דִּבְרֵי רַבִּי מֵאִיר',
          ref: 'Chullin 73a:2',
          url: 'Chullin.73a.2',
          anim: { el: 'sever-top', cls: 'drift-up' },
        },
      },
      {
        kicker: 'Scene 2 · Chullin 73a:3–4',
        title: 'The Rabbis Answer',
        heb: 'עַד שֶׁיַּטְבִּיל אֶת כּוּלּוֹ',
        sage: 'Same vessel, same long handle — but now according to the Rabbis —',
        prompt:
          'Rabbi Meir’s colleagues look at the same handle poking above the waterline. Where does their knife fall?',
        scene: 'mikveh',
        options: [
          {
            key: 'sheath',
            t: 'Nowhere — the knife stays sheathed. The vessel is not purified until all of it is immersed. Dunk the whole handle.',
            ok: true,
          },
          {
            key: 'm2',
            t: 'At the future cut point (②), just like Rabbi Meir.',
            why: 'The Rabbis reject exactly this for vessels: attached is attached, until the axe actually falls.',
          },
          {
            key: 'm1',
            t: 'At the handle’s base (①) — the handle is not the vessel.',
            why: 'No one cuts there. A handle in use is part of the vessel according to everyone.',
          },
        ],
        reveal: {
          who: 'The Rabbis:',
          text: 'Not purified until he immerses all of it. Yet even they concede the phantom cut for food — connected foods are as though already separated (73a:4) — which is how Ravina’s principle survives for everyone.',
          he: 'וַחֲכָמִים אוֹמְרִים: עַד שֶׁיַּטְבִּיל אֶת כּוּלּוֹ',
          ref: 'Chullin 73a:3–4',
          url: 'Chullin.73a.3',
          anim: { el: 'vessel', cls: 'plunge' },
        },
      },
      {
        kicker: 'Scene 3 · Chullin 73a:1',
        title: 'The Emerged Foreleg',
        heb: 'כְּחָתוּךְ דָּמֵי',
        sage: 'According to Ravina —',
        prompt:
          'Yesterday’s cliffhanger. A fetus stuck a foreleg out of the womb; the severed limb defiles the fetus. But limb and fetus grew as one flesh — their seam is a hidden place (בֵּית הַסְּתָרִים), and hidden contact should carry no impurity. Ravina answers with a cut. Where?',
        scene: 'fetus',
        options: [
          {
            key: 'm1',
            t: 'At the seam where the foreleg joins the fetus (①) — the limb stands to be cut, so it is as cut: two separate pieces of food, openly touching.',
            ok: true,
          },
          {
            key: 'm2',
            t: 'At the mother’s flank (②), where the limb crossed into the open air.',
            why: 'The mother is not the problem — the seam is. Ravina’s cut severs limb from fetus, so that their point of contact is no longer a hidden place.',
          },
          {
            key: 'sheath',
            t: 'No cut — flesh grown together cannot defile itself.',
            why: 'That is the objection, not the answer. Precisely because the limb is destined for the knife, the halakha sees it as already severed — "and behold, they touch" (Rashi).',
          },
        ],
        reveal: {
          who: 'Ravina:',
          text: 'Whatever stands to be cut is as already cut. Foreleg and fetus are two separate items in contact — the seam is exposed, and impurity crosses it.',
          he: 'כְּחָתוּךְ דָּמֵי — וַהֲרֵי נוֹגְעִין זֶה בָּזֶה (רש״י)',
          ref: 'Chullin 73a:1',
          url: 'Chullin.73a.1',
          anim: { el: 'sever-limb', cls: 'drift-right' },
        },
      },
      {
        kicker: 'Scene 4 · Chullin 73b:5–7',
        title: 'Death Makes It Fall',
        heb: 'מִיתָה עוֹשָׂה נִיפּוּל',
        sage: 'All agree, says Rabbi Yoḥanan (reported by Rav Yitzḥak bar Yosef) —',
        prompt:
          'A limb was half-torn and left dangling from a living animal. Then the animal died — no slaughter, just death. What does the halakha see at the strip of flesh still holding the limb?',
        scene: 'dangle-death',
        options: [
          {
            key: 'm1',
            t: 'A cut (①) — made before the death. The limb is as though it fell off while the animal still lived: it defiles as a limb from the living (אֵבֶר מִן הַחַי), not as a limb of a carcass.',
            ok: true,
          },
          {
            key: 'sheath',
            t: 'No cut — the limb died together with its animal, and is a limb of the carcass.',
            why: 'Death makes it fall. The mishna (Chullin 127b) rules that such a limb defiles as a limb from the living, not from a carcass — retroactively, it was never part of the neveila.',
          },
        ],
        reveal: {
          who: 'Rav Yitzḥak bar Yosef, citing Rabbi Yoḥanan:',
          text: 'Everyone agrees that death causes falling — the dangling limb is regarded as having dropped off before the animal died.',
          he: 'הַכֹּל מוֹדִים שֶׁמִּיתָה עוֹשָׂה נִיפּוּל',
          ref: 'Chullin 73b:5',
          url: 'Chullin.73b.5',
          anim: { el: 'sever-limb', cls: 'drift-down' },
        },
      },
      {
        kicker: 'Scene 5 · Chullin 73b:5–12',
        title: 'Slaughter Does Not',
        heb: 'אֵין שְׁחִיטָה עוֹשָׂה נִיפּוּל',
        sage: 'Same dangling limb — but this time the animal is slaughtered —',
        prompt:
          'The knife at the throat is real. Is there also a phantom one at the dangling limb? If slaughter "makes it fall," the limb fell from a living animal and defiles as אֵבֶר מִן הַחַי. Rule.',
        scene: 'dangle-shechita',
        options: [
          {
            key: 'sheath',
            t: 'The phantom knife stays sheathed. Slaughter does not make it fall — the limb carries no limb-impurity at all, though it remains forbidden to eat.',
            ok: true,
          },
          {
            key: 'm1',
            t: 'Cut (①) before the slaughter, exactly as with death.',
            why: 'Death and slaughter part ways here. Slaughter reaches everything it finds attached to the body — the limb is not a fallen limb. Rav Yosef says of this ruling: take it in your hand.',
          },
        ],
        reveal: {
          who: 'Rav Yosef, confirming Rabbi Yoḥanan:',
          text: 'Take this in your hand: slaughter does not cause falling. The dangling limb is clear of limb-impurity — yet still forbidden to eat, from "and flesh torn in the field you shall not eat" (Exodus 22:30).',
          he: 'נְקוֹט דְּרַב יִצְחָק בַּר יוֹסֵף בִּידָךְ',
          ref: 'Chullin 73b:12',
          url: 'Chullin.73b.12',
          anim: { el: 'strip', cls: 'held' },
        },
      },
      {
        kicker: 'Scene 6 · Chullin 73a:16–17',
        title: 'The Way Back',
        heb: 'תַּקַּנְתָּא בַּחֲזָרָה',
        sage: 'Rabbi Yosei son of Rabbi Ḥanina, explaining Rabbi Yoḥanan (first version) —',
        prompt:
          'Two limbs, two fates. In this version, the Rabbis hold that the mother’s slaughter shields the fetus’s emerged limb from carcass-impurity — yet abandons the animal’s own dangling limb. Why the difference? Choose the path of rescue.',
        scene: 'return',
        options: [
          {
            key: 'm1',
            t: 'Path ① — the fetus’s limb has a way back: draw it into the womb, and (per the view that re-entry helps) the slaughter will reach it.',
            ok: true,
          },
          {
            key: 'm2',
            t: 'Path ② — press the dangling limb back against the body until it heals.',
            why: 'לֵית לֵיהּ תַּקַּנְתָּא — a half-torn limb can never rejoin its body. No return, no rescue.',
          },
          {
            key: 'sheath',
            t: 'No path — both limbs are equally beyond saving.',
            why: 'One of them is not: the fetus’s limb can still return inside, and that live possibility is exactly what keeps the slaughter’s shield over it.',
          },
        ],
        reveal: {
          who: 'Rabbi Yosei, son of Rabbi Ḥanina:',
          text: 'This one has a remedy by returning; that one has no remedy by returning.',
          he: 'הַאי אִית לֵיהּ תַּקַּנְתָּא בַּחֲזָרָה, וְהָא לֵית לֵיהּ תַּקַּנְתָּא בַּחֲזָרָה',
          ref: 'Chullin 73a:17',
          url: 'Chullin.73a.17',
          anim: { el: 'ret-limb', cls: 'slide-home' },
        },
      },
    ];

    const TOTAL = ROUNDS.length;
    let r = 0;
    let score = 0;
    let picksThisRound = 0;
    const roundClean = ROUNDS.map(() => false);
    const $ = (id) => document.getElementById(id);

    function buildBadges() {
      $('scene-badges').innerHTML = ROUNDS.map((_, i) => {
        const state = i < r ? 'done' : i === r ? 'now' : 'wait';
        const cls =
          state === 'done'
            ? 'border-cyan-600/70 bg-cyan-950/40 !text-cyan-300'
            : state === 'now'
              ? 'border-slate-500 bg-[#161e27] !text-slate-200'
              : 'border-slate-800 !text-slate-600';
        const mark = state === 'done' ? (roundClean[i] ? '🔪' : '▭') : `${i + 1}`;
        return `<span class="rounded-full border px-2.5 py-1 text-[11px] font-bold ${cls}">${mark}</span>`;
      }).join('');
      $('tally-label').textContent = `🔪 ${score} clean cut${score === 1 ? '' : 's'}`;
    }

    function shuffled(arr) {
      const a = arr.map((x) => [Math.random(), x]);
      a.sort((p, q) => p[0] - q[0]);
      return a.map(([, x]) => x);
    }

    let currentOrder = [];

    function renderRound() {
      const rd = ROUNDS[r];
      picksThisRound = 0;
      $('reveal').classList.add('hidden');
      $('scene-kicker').textContent = rd.kicker;
      $('scene-heb').textContent = rd.heb;
      $('scene-title').textContent = rd.title;
      $('scene-sage').textContent = rd.sage;
      $('scene-prompt').textContent = rd.prompt;
      $('scene-svg').innerHTML = SCENES[rd.scene]();
      currentOrder = shuffled(rd.options);
      $('choices').innerHTML = currentOrder
        .map((op, i) => {
          const icon = op.key === 'sheath' ? '🗡' : '✂';
          return `
        <button class="choice-card" data-i="${i}" data-key="${op.key}">
          <span class="flex items-start gap-3">
            <kbd class="kbd mt-0.5 shrink-0">${i + 1}</kbd>
            <span class="text-sm leading-relaxed !text-slate-200"><span class="mr-1.5" aria-hidden="true">${icon}</span>${op.t}</span>
          </span>
          <span class="why mt-2 hidden border-t border-[#d05a5a]/30 pt-2 text-xs leading-relaxed !text-[#e09a94]"></span>
        </button>`;
        })
        .join('');
      document.querySelectorAll('#choices .choice-card').forEach((btn) => {
        btn.addEventListener('click', () => pick(Number(btn.dataset.i)));
        const line = markerLine(btn.dataset.key);
        if (line) {
          btn.addEventListener('mouseenter', () => line.classList.add('peek'));
          btn.addEventListener('mouseleave', () => line.classList.remove('peek'));
          btn.addEventListener('focus', () => line.classList.add('peek'));
          btn.addEventListener('blur', () => line.classList.remove('peek'));
        }
      });
    }

    function markerLine(key) {
      if (key === 'sheath') return null;
      return document.querySelector(`#scene-svg .cutline[data-marker="${key}"]`);
    }

    function pick(i) {
      const btn = document.querySelector(`#choices [data-i="${i}"]`);
      if (!btn || btn.disabled || !$('reveal').classList.contains('hidden')) return;
      const choice = currentOrder[i];
      if (!choice.ok) {
        picksThisRound++;
        btn.disabled = true;
        btn.classList.add('botched');
        const why = btn.querySelector('.why');
        why.textContent = '✗ ' + choice.why;
        why.classList.remove('hidden');
        return;
      }
      const clean = picksThisRound === 0;
      if (clean) score++;
      roundClean[r] = clean;
      btn.classList.add('clean-pick');
      document.querySelectorAll('#choices .choice-card').forEach((b) => (b.disabled = true));
      const rd = ROUNDS[r];
      const line = markerLine(choice.key);
      if (line) line.classList.add('active');
      const animEl = document.getElementById(rd.reveal.anim.el);
      if (animEl) animEl.classList.add(rd.reveal.anim.cls);
      $('reveal-who').textContent = rd.reveal.who;
      $('reveal-text').textContent = rd.reveal.text;
      $('reveal-he').textContent = rd.reveal.he;
      const src = $('reveal-src');
      src.textContent = `Read it inside · ${rd.reveal.ref} ↗`;
      src.href = SEFARIA + rd.reveal.url;
      $('btn-next').textContent = r === TOTAL - 1 ? 'The last cut →' : `Next scene: ${ROUNDS[r + 1].title} →`;
      $('reveal').classList.remove('hidden');
      buildBadges();
      $('btn-next').focus();
    }

    function nextRound() {
      if (r === TOTAL - 1) {
        r = TOTAL;
        buildBadges();
        $('game-area').classList.add('hidden');
        $('coda').classList.remove('hidden');
        $('coda').scrollIntoView({ behavior: 'smooth', block: 'center' });
        $('btn-end').focus();
        return;
      }
      r++;
      buildBadges();
      renderRound();
      $('scene-kicker').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function gradeFor(n) {
      if (n === TOTAL) return ['נְקוֹט בִּידָךְ', 'A perfect grip. Every phantom cut fell exactly where the halakha sees it — take this blade in your hand.'];
      if (n >= 5) return ['רָבִינָא', 'You see cuts before they happen. One stroke strayed; the rest rang true.'];
      if (n >= 3) return ['עַד מָקוֹם מִדָּה', 'Immersed to the measure — partway pure. Some seams still read as hidden to you.'];
      if (n >= 1) return ['בֵּית הַסְּתָרִים', 'The seams stayed hidden. Open the daf and trace where the law already sees a knife.'];
      return ['הַסַּכִּין בַּנָּדָן', 'The knife never left the sheath. Learn the daf, then come back and cut.'];
    }

    function endGame() {
      $('coda').classList.add('hidden');
      const [heb, line] = gradeFor(score);
      $('final-score').textContent = `${score}/${TOTAL}`;
      $('final-grade').textContent = heb;
      $('final-line').textContent = line;
      $('review-list').innerHTML = ROUNDS.map(
        (rd, i) => `
        <a href="${SEFARIA + rd.reveal.url}" target="_blank" rel="noopener"
           class="flex items-center justify-between gap-3 rounded-xl border border-slate-800 bg-slate-900/50 px-4 py-2.5 text-sm hover:border-cyan-800">
          <span class="!text-slate-200">${roundClean[i] ? '🔪' : '▭'} ${rd.title}</span>
          <span class="text-xs !text-cyan-300">${rd.reveal.ref}</span>
        </a>`
      ).join('');
      $('end-screen').classList.remove('hidden');
      $('end-screen').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function replay() {
      r = 0;
      score = 0;
      picksThisRound = 0;
      roundClean.fill(false);
      $('end-screen').classList.add('hidden');
      $('coda').classList.add('hidden');
      $('game-area').classList.remove('hidden');
      buildBadges();
      renderRound();
    }

    async function share() {
      const blades = roundClean.map((c) => (c ? '🔪' : '▭')).join('');
      const text = `The Phantom Knife (Daf Yomi · Chullin 73): ${score}/${TOTAL} clean cuts.\n${blades}\nכל העומד לחתוך — כחתוך דמי\n`;
      const url = location.href;
      try {
        if (navigator.share) await navigator.share({ title: 'The Phantom Knife', text, url });
        else {
          await navigator.clipboard.writeText(text + url);
          $('btn-share').textContent = 'Copied!';
          setTimeout(() => ($('btn-share').textContent = 'Share score'), 1500);
        }
      } catch {}
    }

    $('btn-next').addEventListener('click', nextRound);
    $('btn-end').addEventListener('click', endGame);
    $('btn-replay').addEventListener('click', replay);
    $('btn-share').addEventListener('click', share);
    document.addEventListener('keydown', (e) => {
      if (e.target.closest('input,textarea')) return;
      if (['1', '2', '3'].includes(e.key) && !$('game-area').classList.contains('hidden')) {
        pick(Number(e.key) - 1);
      }
    });

    buildBadges();
    renderRound();
  </script>
</Layout>
