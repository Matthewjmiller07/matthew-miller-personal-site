---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="The Herdbook Lens — Daf Yomi Game: Chullin 75"
  description="Chullin 75 breeds a herd out of one womb-born kid — and every posek stamps that herd differently. Swing the lens of Rav Kahana, Shimon Shezuri, R. Yochanan and Rav Mesharshiyya over three generations, seal the fish timeline of Okatzin, and outrun the bear with Rav Ashi's ruling."
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;700;900&display=swap"
  />

  <main class="min-h-screen bg-[#0a100b] !text-[#e8ead9]">
    <!-- ============ Hero ============ -->
    <div class="border-b border-[#2b3a29] bg-gradient-to-b from-[#16220f]/70 to-transparent px-4 pt-10 pb-8 text-center">
      <p class="mb-3 text-xs uppercase tracking-[0.3em] !text-[#9aa845]">
        <a href="/daf" class="hover:!text-[#c9cf6a]">daf yomi arcade</a> · chullin 75 · 2026-07-14
      </p>
      <h1 class="frank text-4xl font-black tracking-tight sm:text-5xl">🔍 The Herdbook Lens</h1>
      <p class="frank mt-1 text-2xl !text-[#c9a84c]" dir="rtl" lang="he">עַד סוֹף כׇּל הַדּוֹרוֹת</p>
      <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed !text-[#a3b096]">
        A kosher mother is slaughtered, and inside her — alive — a fully formed kid: a
        <span class="frank !text-[#cbd3b8]" dir="rtl" lang="he">בֶּן פְּקוּעָה</span>, permitted by his
        mother's knife. But then he stands up. He plows. He breeds.
        <strong class="!text-[#e8ead9]">You keep the herdbook</strong>, and every page must be stamped —
        only the stamp depends on whose lens you read it through. Rav Kahana's first tanna,
        Rabbi Shimon Shezuri, Rabbi Yoḥanan, and Rav Mesharshiyya each redraw the whole flock.
        First, though: the fishmonger has a question.
      </p>
    </div>

    <div class="mx-auto max-w-2xl px-4 pb-16 pt-8">
      <!-- ============ Progress ============ -->
      <div class="mb-6 flex items-center justify-between gap-4">
        <div id="badges" class="flex flex-wrap gap-2" aria-label="Progress: eight stamps"></div>
        <div class="shrink-0 text-right text-xs">
          <span id="tally" class="!text-[#6e7b64]">0 of 8 sealed on the first stamp</span>
        </div>
      </div>

      <!-- ============ Round header ============ -->
      <div class="mb-4 rounded-2xl border border-[#2b3a29] bg-[#131b13] p-5">
        <div class="flex items-center gap-4">
          <div id="lens-medallion" class="lens shrink-0" aria-hidden="true">
            <span id="lens-he" class="frank" dir="rtl" lang="he">אוקצין</span>
          </div>
          <div class="min-w-0">
            <p id="round-kicker" class="font-mono text-[11px] font-bold uppercase tracking-[0.2em] !text-[#9aa845]"></p>
            <h2 id="round-title" class="frank mt-0.5 text-2xl font-bold leading-tight !text-[#e8ead9]"></h2>
            <p id="round-lens-line" class="mt-1 text-xs !text-[#a3b096]"></p>
          </div>
        </div>
        <p id="round-task" class="mt-3 rounded-xl border border-[#3c4d2c] bg-[#16220f]/60 p-3 text-sm leading-relaxed !text-[#cbd3b8]"></p>
      </div>

      <!-- ============ Fish stall (amud alef) ============ -->
      <div id="fish-panel" class="hidden rounded-2xl border border-[#2b3a29] bg-[#131b13] p-5">
        <div class="flex items-baseline justify-between gap-3">
          <span class="font-mono text-[11px] font-bold uppercase tracking-[0.2em] !text-[#6e7b64]">the fish stall</span>
          <span class="frank text-lg !text-[#cbd3b8]" dir="rtl" lang="he">דָּגִים, מֵאֵימָתַי מְקַבְּלִין טוּמְאָה?</span>
        </div>
        <div id="seal-tray" class="mt-4 flex flex-wrap gap-2" aria-label="Seals to place"></div>
        <div id="fish-line" class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-4" aria-label="The fish's timeline"></div>
        <div id="teiku-box" class="mt-4 hidden"></div>
      </div>

      <!-- ============ Herdbook (amud bet) ============ -->
      <div id="herd-panel" class="hidden rounded-2xl border border-[#2b3a29] bg-[#131b13] p-5">
        <div class="flex items-baseline justify-between gap-3">
          <span class="font-mono text-[11px] font-bold uppercase tracking-[0.2em] !text-[#6e7b64]">the herdbook</span>
          <span class="frank text-lg !text-[#cbd3b8]" dir="rtl" lang="he">פִּנְקַס הָעֵדֶר</span>
        </div>
        <div class="mt-3 rounded-xl border border-dashed border-[#3c4d2c] bg-[#0f150f] p-3 text-xs !text-[#a3b096]">
          <span class="mr-2 inline-flex h-6 w-6 items-center justify-center rounded-full border border-[#3c4d2c] font-bold !text-[#6e7b64]"><span class="frank">א</span></span>
          <strong class="!text-[#cbd3b8]">Imma</strong> — the kosher mother, slaughtered properly. Inside her,
          alive: a nine-month kid. Her knife is where every page of this book begins
          <span class="whitespace-nowrap">(Mishna, Chullin 74a)</span>.
        </div>
        <div id="herd" class="mt-3 space-y-4"></div>
      </div>

      <!-- ============ Choice panel (bear / yonatan) ============ -->
      <div id="choice-panel" class="hidden rounded-2xl border border-[#2b3a29] bg-[#131b13] p-5">
        <p id="choice-scene" class="text-sm leading-relaxed !text-[#cbd3b8]"></p>
        <div id="choice-options" class="mt-4 space-y-2"></div>
      </div>

      <!-- ============ Submit ============ -->
      <div class="mt-4">
        <button id="btn-submit" class="w-full rounded-xl bg-[#c9a84c] px-5 py-3 text-sm font-bold !text-[#131b13] transition-colors hover:bg-[#e0c06a] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#e0c06a] disabled:cursor-default disabled:opacity-40">
          Stamp the page
        </button>
      </div>

      <p id="nudge" class="mt-3 hidden rounded-xl border border-[#5c3a2e] bg-[#241512] p-3 text-sm !text-[#d9917f]"></p>

      <!-- ============ Reveal ============ -->
      <div id="reveal" class="mt-4 hidden rounded-2xl border border-[#6b5b26] bg-[#1c2110]/70 p-5">
        <p class="text-[11px] font-bold uppercase tracking-[0.2em] !text-[#c9a84c]">the daf rules</p>
        <p id="reveal-he" class="frank mt-2 text-xl leading-snug !text-[#e8ead9]" dir="rtl" lang="he"></p>
        <div id="reveal-why" class="mt-3 space-y-2 text-sm leading-relaxed !text-[#cbd3b8]"></div>
        <a id="reveal-src" href="#" target="_blank" rel="noopener" class="mt-3 inline-block text-xs !text-[#9aa845] hover:!text-[#c9cf6a] hover:underline"></a>
        <div class="mt-4">
          <button id="btn-next" class="rounded-xl bg-[#c9a84c] px-5 py-2.5 text-sm font-bold !text-[#131b13] transition-colors hover:bg-[#e0c06a] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#e0c06a]"></button>
        </div>
      </div>

      <!-- ============ Finale ============ -->
      <div id="finale" class="mt-6 hidden rounded-2xl border border-[#2b3a29] bg-[#131b13] p-6 text-center">
        <p class="frank text-3xl font-black !text-[#c9a84c]" dir="rtl" lang="he">נִסְתַּיֵּם הַפִּנְקָס</p>
        <p id="final-score" class="mt-3 text-sm !text-[#e8ead9]"></p>
        <p class="mx-auto mt-3 max-w-md text-left text-sm leading-relaxed !text-[#a3b096]">
          The herdbook closes. Adda bar Ḥavu's goat was slaughtered in time; the wonder-hoofed one
          grazes unstamped; Pele stands in his pen, unanswerable; and somewhere off amud alef, a fish
          with a perforated gut is still swimming through an unresolved
          <span class="frank !text-[#cbd3b8]" dir="rtl" lang="he">תֵּיקוּ</span>.
        </p>
        <button id="btn-replay" class="mt-5 rounded-xl border border-[#3c4d2c] px-5 py-2.5 text-sm font-bold !text-[#cbd3b8] transition-colors hover:border-[#c9a84c] hover:!text-[#e0c06a] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#e0c06a]">
          Open the herdbook again
        </button>
      </div>

      <!-- ============ Learn the real daf ============ -->
      <div class="mt-10 rounded-2xl border border-[#2b3a29] bg-[#0f150f] p-6">
        <h2 class="frank text-xl font-bold !text-[#e8ead9]">Learn the real daf</h2>
        <p class="mt-2 text-sm leading-relaxed !text-[#a3b096]">
          Everything in this game is on
          <a href="https://www.sefaria.org/Chullin.75a" target="_blank" rel="noopener" class="!text-[#9aa845] hover:!text-[#c9cf6a] underline decoration-[#3c4d2c]">Chullin 75a</a>
          and
          <a href="https://www.sefaria.org/Chullin.75b" target="_blank" rel="noopener" class="!text-[#9aa845] hover:!text-[#c9cf6a] underline decoration-[#3c4d2c]">75b</a>.
          The game plays the fish of Okatzin and the whole ben pekua herd sugya — but the daf holds more
          that never made it into the ledger:
        </p>
        <ul class="mt-3 space-y-2 text-sm leading-relaxed !text-[#a3b096]">
          <li>· <strong class="!text-[#cbd3b8]">A dry slaughter</strong> — Reish Lakish opens the daf answering that a baraita speaks of a slaughter that drew no blood, so the mother was never made susceptible to impurity (75a:1).</li>
          <li>· <strong class="!text-[#cbd3b8]">Can living flesh be "food"?</strong> — R. Yosei HaGelili (with Beit Shammai, says R. Yoḥanan) holds a live ben pekua can take food-impurity once wetted; the Rabbis refuse impurity to anything alive (75a:2–3).</li>
          <li>· <strong class="!text-[#cbd3b8]">The fat of the fetus</strong> — R. Yoḥanan and Reish Lakish dispute whether a fetus's ḥelev carries karet, in two versions (birth vs. completed months), trading objections from the guilt-offering's "fat and two kidneys" (75a:8–14).</li>
          <li>· <strong class="!text-[#cbd3b8]">Four simanim</strong> — a live nine-month fetus inside a <em>tereifa</em> mother: R. Ami, Rava and Rav Ḥisda debate whether the Torah gave this one animal four pipes fit for the knife — its mother's two and its own (75a:15–75b:5).</li>
          <li>· <strong class="!text-[#cbd3b8]">The silence of Reish Lakish</strong> — R. Zeira asks whether Reish Lakish disputed the four-simanim rule; Rav Asi: I don't know — he was waiting for R. Yoḥanan to retract… or he was drinking (75b:6–7).</li>
        </ul>
        <p class="mt-4 text-xs !text-[#6e7b64]">
          Most-linked commentaries on this daf via Sefaria: Rashi (60) · Steinsaltz (34) · Rabbeinu Gershom (20) ·
          Tosafot (10) · Beit Yosef (10) · Rashba (9).
        </p>
        <p class="mt-2 text-xs !text-[#6e7b64]">
          <a href="/daf" class="hover:!text-[#a3b096] underline decoration-[#3c4d2c]">← Back to the Daf Yomi Arcade</a>
        </p>
      </div>
    </div>
  </main>

  <style>
    .frank { font-family: 'Frank Ruhl Libre', 'Times New Roman', serif; }

    .lens {
      width: 64px;
      height: 64px;
      border-radius: 9999px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      font-size: 13px;
      font-weight: 700;
      color: #e0c06a;
      background: radial-gradient(circle at 35% 30%, #223018, #0f150f 70%);
      border: 3px solid transparent;
      background-clip: padding-box;
      box-shadow: 0 0 0 3px #c9a84c, 0 0 0 4px #6b5b26, 0 4px 14px rgba(0, 0, 0, 0.5);
      transition: transform 0.6s cubic-bezier(0.34, 1.4, 0.64, 1);
      padding: 4px;
      line-height: 1.15;
    }
    .lens.swung { transform: rotate(360deg); }

    .stamp-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      border-radius: 0.5rem;
      padding: 0.15rem 0.5rem;
      font-size: 11px;
      font-weight: 700;
      animation: stampIn 0.35s ease-out;
    }
    @keyframes stampIn {
      0% { transform: scale(1.7) rotate(-8deg); opacity: 0; }
      100% { transform: scale(1) rotate(0deg); opacity: 1; }
    }

    .shake { animation: shake 0.35s ease-out; }
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-5px); }
      55% { transform: translateX(4px); }
      80% { transform: translateX(-2px); }
    }

    @media (prefers-reduced-motion: reduce) {
      .lens { transition: none; }
      .lens.swung { transform: none; }
      .stamp-chip { animation: none; }
      .shake { animation: none; }
    }
  </style>

  <script>
    const SEFARIA = 'https://www.sefaria.org/';
    const $ = (id) => document.getElementById(id);
    const srcLink = (ref) => SEFARIA + encodeURI(ref.replace(/ /g, '.'));

    // ---------- The herd ----------
    // stamps: 'ok' = permitted as it stands · 'knife' = needs shechita · 'dead-end' = no rectification
    const HERD = [
      {
        id: 'peki', seal: 'פ', name: 'Peki', gen: 0,
        bio: 'Found alive in Imma’s womb after the knife. Long since stood on the ground — five years now, and she plows the field.',
      },
      {
        id: 'kalut', seal: 'ק', name: 'Kalut', gen: 0,
        bio: 'Womb-born like Peki, but his hooves are closed like a donkey’s. The whole village stares.',
      },
      {
        id: 'mealyeta', seal: 'מ', name: 'Me’alyeta', gen: 0,
        bio: 'An ordinary doe — בְּהֵמָה מְעַלַּיְיתָא — born in the pen the normal way. Nothing about her is strange.',
      },
      {
        id: 'bno', seal: 'ב', name: 'Bno', gen: 1,
        bio: 'Kid of Kalut and Peki — womb-born stock on both sides.',
      },
      {
        id: 'pele', seal: 'פּל', name: 'Pele', gen: 1,
        bio: 'Kid of Kalut, the womb-born buck, and Me’alyeta, the ordinary doe.',
      },
      {
        id: 'gedi', seal: 'ג', name: 'Gedi', gen: 1,
        bio: 'Me’alyeta’s kid by a buck from the market flock. Ordinary through and through.',
      },
      {
        id: 'benbno', seal: 'בב', name: 'Ben Bno', gen: 2,
        bio: 'Bno’s kid, his dam also of the womb-born line — the third generation.',
      },
    ];
    const GEN_LABELS = ['First generation — out of Imma’s womb', 'Second generation', 'Third generation'];

    // ---------- Rounds ----------
    const ROUNDS = [
      {
        id: 'fish1', kind: 'fish1', badge: '🎣',
        lensHe: 'עוקצין ג:ח', kicker: 'amud alef · warm-up',
        title: 'When is a fish food?',
        lensLine: 'The mishna of Okatzin 3:8, cited on our daf: fish need no shechita — so when do they start counting as “food” that can take impurity?',
        task: 'Three houses, three seals. Tap a seal, then tap the moment on the fish’s timeline when that house says it becomes susceptible. One moment stays bare.',
        submitLabel: 'Set the seals',
        reveal: {
          he: 'בֵּית שַׁמַּאי אוֹמְרִים: מִשֶּׁיִּצּוֹדוּ, וּבֵית הִלֵּל אוֹמְרִים: מִשֶּׁיָּמוּתוּ. רַבִּי עֲקִיבָא אוֹמֵר: מִשָּׁעָה שֶׁאֵין יְכוֹלִין לִחְיוֹת',
          why: [
            '<strong class="!text-[#e8ead9]">Beit Shammai — from the trap:</strong> a fish needs no shechita, so the moment it is caught it is already food.',
            '<strong class="!text-[#e8ead9]">Beit Hillel — from death.</strong> <strong class="!text-[#e8ead9]">R. Akiva — from when it can no longer live.</strong> And what daylight is there between those two? R. Yoḥanan: דָּג מְקַרְטֵעַ — the convulsing fish, as good as dead for R. Akiva, still not food for Beit Hillel (75a:5).',
          ],
          ref: 'Chullin 75a:4',
        },
      },
      {
        id: 'fish2', kind: 'choice', badge: '🐟',
        lensHe: 'רב חסדא', kicker: 'amud alef · the dilemma',
        title: 'The fish that cannot live',
        lensLine: 'Rav Ḥisda’s dilemma on our daf, hanging off R. Akiva’s seal.',
        scene: 'A fish swims in the fishmonger’s barrel — alive, but with the marks of a tereifa on it: a perforated gut that no fish survives. According to R. Akiva, who stamps a fish from the hour it can no longer live — where does this one’s seal fall?',
        options: [
          { key: 'a', text: 'Stamp it now — tereifa marks mean it can no longer live, and for a fish that is death.' },
          { key: 'b', text: 'No stamp until it actually dies — tereifa reasoning belongs to animals, not fish.' },
          { key: 'c', text: 'The question stands. Set no seal: תֵּיקוּ.' },
        ],
        correct: 'c',
        submitLabel: 'Answer Rav Ḥisda',
        reveal: {
          he: 'בָּעֵי רַב חִסְדָּא: נוֹלְדוּ בְּדָגִים סִימָנֵי טְרֵפָה, מַהוּ? … תֵּיקוּ',
          why: [
            'The dilemma cuts both ways. Even the one who says a tereifa animal <em>can</em> live might concede a fish cannot — a fish’s life-force is weak. And even the one who says a tereifa cannot live might limit that to animals, whose kind requires shechita — fish, whose kind never comes to the knife, may be outside tereifa law altogether. The Gemara closes it with one word: <span class="frank" dir="rtl" lang="he">תֵּיקוּ</span> — it stands.',
          ],
          ref: 'Chullin 75a:6',
        },
      },
      {
        id: 'lensA', kind: 'lens', badge: '🔍',
        lensHe: 'תַּנָּא קַמָּא', kicker: 'amud bet · lens one',
        title: 'Rav Kahana’s first tanna',
        lensLine: 'Rav Kahana: the first tanna and Shimon Shezuri split over one who הִפְרִיס עַל גַּבֵּי קַרְקַע — a womb-born that stood on the ground (75b:8). Abaye adds: everyone concedes the wonder-hoofed one is permitted (75b:10).',
        task: 'Read the first generation through this lens. Tap every animal that must go to the knife before it may be eaten.',
        inPlay: ['peki', 'kalut', 'mealyeta'],
        correct: ['peki', 'mealyeta'],
        stamps: { peki: 'knife', kalut: 'ok', mealyeta: 'knife' },
        submitLabel: 'Stamp the page',
        reveal: {
          he: 'הִפְרִיס עַל גַּבֵּי קַרְקַע אִיכָּא בֵּינַיְיהוּ … כֹּל מִלְּתָא דִּתְמִיהָא מִידְכָּר דְּכִירִי לַהּ אִינָשֵׁי',
          why: [
            '<strong class="!text-[#e8ead9]">Peki — needs the knife.</strong> By Torah law her mother’s shechita already permitted her; but once she stood on the ground, the Sages required shechita, lest onlookers see a walking animal eaten unslaughtered and permit ordinary ones too (75b:8).',
            '<strong class="!text-[#e8ead9]">Me’alyeta — needs the knife</strong>, and not by decree: she is an ordinary animal, and her shechita is Torah law.',
            '<strong class="!text-[#e8ead9]">Kalut — permitted as he stands.</strong> Abaye: even the first tanna concedes, for anything bizarre, people remember — no one will generalize from a donkey-hoofed goat. (Some report Abaye required two wonders: a kalut born of a kaluta, 75b:10.)',
          ],
          ref: 'Chullin 75b:8',
        },
      },
      {
        id: 'lensB', kind: 'lens', badge: '🔍',
        lensHe: 'שִׁמְעוֹן שֵׁזוּרִי', kicker: 'amud bet · lens two',
        title: 'Ze’eiri’s ruling: like Shimon Shezuri',
        lensLine: 'Ze’eiri says in the name of R. Ḥanina: the halakha follows R. Shimon Shezuri — and Shezuri permitted the womb-born’s son and his son’s son, to the end of all the generations (75b:11).',
        task: 'The lens swings. Under Shezuri’s reading, tap every animal in the book that needs no knife at all.',
        inPlay: ['peki', 'bno', 'benbno', 'mealyeta'],
        correct: ['peki', 'bno', 'benbno'],
        stamps: { peki: 'ok', bno: 'ok', benbno: 'ok', mealyeta: 'knife' },
        submitLabel: 'Stamp the page',
        reveal: {
          he: 'הֲלָכָה כְּרַבִּי שִׁמְעוֹן שֵׁזוּרִי, וְכֵן הָיָה רַבִּי שִׁמְעוֹן שֵׁזוּרִי מַתִּיר בִּבְנוֹ וּבֶן בְּנוֹ עַד סוֹף כׇּל הַדּוֹרוֹת',
          why: [
            'For Shezuri the mother’s knife echoes down the pedigree: Peki though she plows, Bno, and Ben Bno — <em>to the end of all the generations</em> — need no shechita. Only Me’alyeta’s page keeps its amber stamp: she was never womb-born, and Torah law wants her knife.',
          ],
          ref: 'Chullin 75b:11',
        },
      },
      {
        id: 'lensC', kind: 'lens', badge: '🔍',
        lensHe: 'רַבִּי יוֹחָנָן', kicker: 'amud bet · lens three',
        title: 'R. Yoḥanan draws the line',
        lensLine: 'R. Yoḥanan, on the same page: הוּא מוּתָּר וּבְנוֹ אָסוּר — the womb-born himself is permitted, but his son is forbidden without shechita (75b:11).',
        task: 'Same herd, narrower lens. Tap the animals that still need the knife under R. Yoḥanan.',
        inPlay: ['peki', 'bno', 'benbno'],
        correct: ['bno', 'benbno'],
        stamps: { peki: 'ok', bno: 'knife', benbno: 'knife' },
        submitLabel: 'Stamp the page',
        reveal: {
          he: 'רַבִּי יוֹחָנָן אָמַר: הוּא מוּתָּר, וּבְנוֹ אָסוּר',
          why: [
            'The exemption stops at the animal it happened to. Peki herself rode out of the womb on her mother’s shechita; her descendants did not — Bno is forbidden without his own knife, and Ben Bno all the more so, for even Shezuri had to say <em>his son and his son’s son</em> out loud to reach him.',
            '<em>Hold this stamp loosely</em> — at the end of the daf, Rav Ashi will claim R. Yoḥanan was only spelling out Shezuri’s view, and himself rules like the first tanna. The bear will make this matter.',
          ],
          ref: 'Chullin 75b:11',
        },
      },
      {
        id: 'lensD', kind: 'lens', badge: '🔍',
        lensHe: 'רַב מְשַׁרְשְׁיָא', kicker: 'amud bet · lens four',
        title: 'Rav Mesharshiyya’s dead end',
        lensLine: 'Rav Mesharshiyya — according to the one who says we are concerned for the father’s seed (חוֹשְׁשִׁין לְזֶרַע הָאָב): a ben pekua who mounts an ordinary animal — the offspring has no rectification (75b:9).',
        task: 'Three kids of the second generation. Under this lens, one of them can never be eaten — no knife in the world permits him. Tap that one.',
        inPlay: ['bno', 'pele', 'gedi'],
        correct: ['pele'],
        stamps: { bno: 'ok', pele: 'dead-end', gedi: 'knife' },
        submitLabel: 'Stamp the page',
        reveal: {
          he: 'בֶּן פְּקוּעָה הַבָּא עַל בְּהֵמָה מְעַלַּיְיתָא – הַוָּלָד אֵין לוֹ תַּקָּנָה',
          why: [
            '<strong class="!text-[#e8ead9]">Pele is the dead end.</strong> From his dam’s side he is an ordinary animal who <em>requires</em> shechita; from his sire’s side he is womb-born stock <em>excluded</em> from shechita — his pipes are, as it were, already cut. No act of slaughter can satisfy both halves of him: אֵין לוֹ תַּקָּנָה.',
            '<strong class="!text-[#e8ead9]">Bno</strong> is safe — both his parents are womb-born, so nothing in him demands a knife. <strong class="!text-[#e8ead9]">Gedi</strong> is an ordinary kid: the knife works on him the ordinary way.',
            'And all of this only per the opinion that the father’s seed counts; whoever follows the dam alone would send Pele to an ordinary shechita like his mother’s kind.',
          ],
          ref: 'Chullin 75b:9',
        },
      },
      {
        id: 'bear', kind: 'choice', badge: '🐻',
        lensHe: 'רַב אַשִׁי', kicker: 'amud bet · the story',
        title: 'The bear of Adda bar Ḥavu',
        lensLine: 'A true story from the end of the daf, 75b:12.',
        scene: 'A bear has fallen on Adda bar Ḥavu’s womb-born goat — an animal exactly like Peki: found alive in its slaughtered mother, long since standing on the ground. It is torn, and it is dying. Adda runs to Rav Ashi. What does Rav Ashi rule?',
        options: [
          { key: 'a', text: 'Leave it — Ze’eiri ruled like Shezuri: it needs no knife, and even R. Yoḥanan only forbade its son.' },
          { key: 'b', text: 'זִיל שַׁחְטֵיהּ — run and slaughter it before it dies, so it may be eaten.' },
          { key: 'c', text: 'Check its hooves — if they are closed like a donkey’s, everyone permits it as it lies.' },
        ],
        correct: 'b',
        submitLabel: 'Rule',
        reveal: {
          he: 'אֲמַר לֵיהּ: זִיל שַׁחְטֵיהּ',
          why: [
            '<strong class="!text-[#e8ead9]">Rav Ashi:</strong> Go, slaughter it before it dies — like the first tanna, a womb-born that stood on the ground needs shechita (75b:12).',
            '<strong class="!text-[#e8ead9]">Adda:</strong> But Ze’eiri said in R. Ḥanina’s name the halakha follows Shezuri, to the end of all the generations! Even R. Yoḥanan only forbade the son — never the animal itself!',
            '<strong class="!text-[#e8ead9]">Rav Ashi:</strong> R. Yoḥanan was speaking <em>within</em> Shezuri’s opinion; he himself holds like the first tanna (75b:13).',
            '<strong class="!text-[#e8ead9]">Adda:</strong> But Ravin bar Ḥanina said in Ulla’s name in R. Ḥanina’s name: wherever Shezuri taught in our Mishna, the halakha follows him! (75b:14)',
            '<strong class="!text-[#e8ead9]">Rav Ashi:</strong> I hold like R. Yonatan — and that is the next page of the ledger. (As for the hooves: that was Kalut’s exemption. This goat’s hooves are split like any other’s.)',
          ],
          ref: 'Chullin 75b:12',
        },
      },
      {
        id: 'yonatan', kind: 'choice', badge: '📜', multi: 2,
        lensHe: 'רַבִּי יוֹנָתָן', kicker: 'amud bet · the last word',
        title: 'Where Shezuri wins',
        lensLine: 'Rav Ashi’s tradition, closing the daf: R. Yonatan ruled that the halakha follows R. Shimon Shezuri — but only twice (75b:15).',
        scene: 'Three mishnayot of R. Shimon Shezuri are open on the table. According to R. Yonatan, in exactly two of them the halakha follows him. Tap the two.',
        options: [
          { key: 'a', text: 'The womb-born that stood on the ground — permitted without shechita, even five years plowing (Mishna, Chullin 74a).' },
          { key: 'b', text: 'The dangerously ill man who said only “write a get for my wife” — write it and give it (Mishna, Gittin 65b).' },
          { key: 'c', text: 'Terumat ma’aser of demai that fell back into the pile — ask the am ha’aretz, even on a weekday, and eat on his word (Mishna, Demai 4:1).' },
        ],
        correct: ['b', 'c'],
        submitLabel: 'Seal the two',
        reveal: {
          he: 'הֲלָכָה כְּרַבִּי שִׁמְעוֹן שֵׁזוּרִי בִּמְסוּכָּן, וּבִתְרוּמַת מַעֲשֵׂר שֶׁל דְּמַאי',
          why: [
            '<strong class="!text-[#e8ead9]">The mesukan:</strong> the Sages already inferred “write” means “write and give” for a man led out in the neck-chain, a man setting sail, a man leaving with the caravan; Shezuri added the dangerously ill — and there the halakha is his (75b:16, citing Gittin 65b).',
            '<strong class="!text-[#e8ead9]">Demai:</strong> teruma of the tithe separated from a suspect am ha’aretz’s produce fell back into the pile — Shezuri lets you ask him, even on a weekday, and eat on his say-so; there too the halakha is his (75b:17, citing Demai 4:1).',
            'But the goat in the field? There Rav Ashi’s knife stands: the herd’s exemption did not survive its first step onto the ground.',
          ],
          ref: 'Chullin 75b:15',
        },
      },
    ];

    // ---------- Fish data ----------
    const FISH_SEALS = [
      { id: 'bs', he: 'בֵּית שַׁמַּאי', en: 'Beit Shammai' },
      { id: 'bh', he: 'בֵּית הִלֵּל', en: 'Beit Hillel' },
      { id: 'ra', he: 'רַבִּי עֲקִיבָא', en: 'R. Akiva' },
    ];
    const FISH_STAGES = [
      { id: 'sea', emoji: '🌊', label: 'Swimming free', he: 'בַּיָּם' },
      { id: 'trap', emoji: '🪤', label: 'Caught in the trap', he: 'מִשֶּׁיִּצּוֹדוּ' },
      { id: 'flap', emoji: '🐟', label: 'Convulsing on the deck', he: 'דָּג מְקַרְטֵעַ' },
      { id: 'dead', emoji: '🍽️', label: 'Dead', he: 'מִשֶּׁיָּמוּתוּ' },
    ];
    const FISH_ANSWER = { trap: 'bs', flap: 'ra', dead: 'bh' };

    // ---------- State ----------
    let round = 0;
    let firstTry = 0;
    let erredThisRound = false;
    const badgeState = new Array(ROUNDS.length).fill('pending');
    let selection = new Set();      // lens rounds: animal ids · choice rounds: option keys
    let fishPlacement = {};         // stageId -> sealId
    let pickedSeal = null;
    const stampsSoFar = {};         // animalId -> stamp (persists across lens rounds)

    const STAMP_META = {
      ok: { he: 'מוּתָּר', en: 'permitted as it stands', cls: 'border border-[#3f5c33] bg-[#1a2b15] !text-[#9fce85]' },
      knife: { he: 'טָעוּן שְׁחִיטָה', en: 'needs the knife', cls: 'border border-[#6b5b26] bg-[#2a2410] !text-[#e0c06a]' },
      'dead-end': { he: 'אֵין לוֹ תַּקָּנָה', en: 'no rectification', cls: 'border border-[#6b3226] bg-[#2a1512] !text-[#e08a72]' },
    };

    // ---------- Rendering ----------
    function renderBadges() {
      const wrap = $('badges');
      wrap.innerHTML = '';
      ROUNDS.forEach((r, i) => {
        const b = document.createElement('span');
        const state = badgeState[i];
        let cls = 'inline-flex h-7 w-7 items-center justify-center rounded-full border text-xs ';
        if (state === 'first') cls += 'border-[#c9a84c] bg-[#2a2410] !text-[#e0c06a]';
        else if (state === 'retry') cls += 'border-[#3c4d2c] bg-[#131b13] !text-[#a3b096]';
        else if (i === round) cls += 'border-[#c9a84c] !text-[#c9a84c]';
        else cls += 'border-[#2b3a29] !text-[#4a5a45]';
        b.className = cls;
        b.textContent = r.badge;
        b.title = r.title;
        wrap.appendChild(b);
      });
      $('tally').textContent = `${firstTry} of ${ROUNDS.length} sealed on the first stamp`;
    }

    function renderHerd(r) {
      const herdEl = $('herd');
      herdEl.innerHTML = '';
      const inPlay = r && r.kind === 'lens' ? r.inPlay : [];
      [0, 1, 2].forEach((gen) => {
        const animals = HERD.filter((a) => a.gen === gen);
        const section = document.createElement('div');
        const label = document.createElement('p');
        label.className = 'mb-2 font-mono text-[10px] font-bold uppercase tracking-[0.2em] !text-[#6e7b64]';
        label.textContent = GEN_LABELS[gen];
        section.appendChild(label);
        const row = document.createElement('div');
        row.className = 'grid grid-cols-1 gap-2 sm:grid-cols-3';
        animals.forEach((a) => {
          const active = inPlay.includes(a.id);
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.dataset.animal = a.id;
          btn.disabled = !active;
          btn.setAttribute('aria-pressed', selection.has(a.id) ? 'true' : 'false');
          btn.className =
            'rounded-xl border p-3 text-left transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#e0c06a] ' +
            (active
              ? 'border-[#3c4d2c] bg-[#0f150f] hover:border-[#c9a84c] cursor-pointer'
              : 'border-[#22301f] bg-[#0d130d] opacity-45');
          btn.innerHTML = `
            <span class="flex items-start gap-2.5">
              <span class="seal mt-0.5 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#6b5b26] bg-[#1c2110] font-bold !text-[#e0c06a]"><span class="frank" dir="rtl" lang="he">${a.seal}</span></span>
              <span class="min-w-0">
                <span class="block text-sm font-bold !text-[#e8ead9]">${a.name}</span>
                <span class="block text-xs leading-snug !text-[#a3b096]">${a.bio}</span>
                <span class="stamp-slot mt-1.5 block min-h-[1.4rem]" data-slot="${a.id}"></span>
              </span>
            </span>`;
          if (active) {
            btn.addEventListener('click', () => {
              if (selection.has(a.id)) selection.delete(a.id);
              else selection.add(a.id);
              btn.setAttribute('aria-pressed', selection.has(a.id) ? 'true' : 'false');
              btn.classList.toggle('border-[#c9a84c]', selection.has(a.id));
              btn.classList.toggle('bg-[#1c2110]', selection.has(a.id));
            });
          }
          row.appendChild(btn);
        });
        section.appendChild(row);
        herdEl.appendChild(section);
      });
      // re-paint stamps already earned
      Object.entries(stampsSoFar).forEach(([id, stamp]) => paintStamp(id, stamp, false));
    }

    function paintStamp(animalId, stamp, animate) {
      const slot = document.querySelector(`[data-slot="${animalId}"]`);
      if (!slot) return;
      const m = STAMP_META[stamp];
      slot.innerHTML = `<span class="stamp-chip ${m.cls}" ${animate ? '' : 'style="animation:none"'}><span class="frank" dir="rtl" lang="he">${m.he}</span><span class="!text-inherit">· ${m.en}</span></span>`;
    }

    function renderFish() {
      $('fish-panel').classList.remove('hidden');
      const tray = $('seal-tray');
      tray.innerHTML = '';
      FISH_SEALS.forEach((s) => {
        const placed = Object.values(fishPlacement).includes(s.id);
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.dataset.seal = s.id;
        btn.setAttribute('aria-pressed', pickedSeal === s.id ? 'true' : 'false');
        btn.className =
          'rounded-full border px-3 py-1.5 text-xs font-bold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#e0c06a] ' +
          (pickedSeal === s.id
            ? 'border-[#c9a84c] bg-[#2a2410] !text-[#e0c06a]'
            : placed
              ? 'border-[#22301f] !text-[#4a5a45]'
              : 'border-[#3c4d2c] bg-[#0f150f] !text-[#cbd3b8] hover:border-[#c9a84c]');
        btn.innerHTML = `<span class="frank" dir="rtl" lang="he">${s.he}</span> · ${s.en}`;
        btn.addEventListener('click', () => {
          // picking up a placed seal removes it from its stage
          Object.keys(fishPlacement).forEach((k) => { if (fishPlacement[k] === s.id) delete fishPlacement[k]; });
          pickedSeal = pickedSeal === s.id ? null : s.id;
          renderFish();
        });
        tray.appendChild(btn);
      });

      const line = $('fish-line');
      line.innerHTML = '';
      FISH_STAGES.forEach((st) => {
        const seal = fishPlacement[st.id] ? FISH_SEALS.find((s) => s.id === fishPlacement[st.id]) : null;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className =
          'rounded-xl border p-3 text-center transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#e0c06a] ' +
          (seal ? 'border-[#c9a84c] bg-[#1c2110]' : 'border-[#3c4d2c] bg-[#0f150f] hover:border-[#c9a84c]');
        btn.innerHTML = `
          <span class="block text-xl">${st.emoji}</span>
          <span class="block text-xs font-bold !text-[#e8ead9]">${st.label}</span>
          <span class="frank block text-sm !text-[#a3b096]" dir="rtl" lang="he">${st.he}</span>
          <span class="mt-1 block min-h-[1.3rem] text-[11px] font-bold !text-[#e0c06a]">${seal ? `<span class="frank" dir="rtl" lang="he">${seal.he}</span>` : '—'}</span>`;
        btn.addEventListener('click', () => {
          if (pickedSeal) {
            fishPlacement[st.id] = pickedSeal;
            pickedSeal = null;
          } else if (fishPlacement[st.id]) {
            delete fishPlacement[st.id];
          }
          renderFish();
        });
        line.appendChild(btn);
      });
    }

    function renderChoices(r) {
      $('choice-panel').classList.remove('hidden');
      $('choice-scene').innerHTML = r.scene;
      const wrap = $('choice-options');
      wrap.innerHTML = '';
      r.options.forEach((o) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.dataset.key = o.key;
        btn.setAttribute('aria-pressed', selection.has(o.key) ? 'true' : 'false');
        btn.className =
          'w-full rounded-xl border border-[#3c4d2c] bg-[#0f150f] p-3 text-left text-sm leading-relaxed !text-[#cbd3b8] transition-colors hover:border-[#c9a84c] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#e0c06a]';
        btn.innerHTML = o.text;
        btn.addEventListener('click', () => {
          const multi = r.multi || 1;
          if (selection.has(o.key)) selection.delete(o.key);
          else {
            if (multi === 1) selection.clear();
            if (selection.size < multi) selection.add(o.key);
          }
          [...wrap.children].forEach((c) => {
            const on = selection.has(c.dataset.key);
            c.setAttribute('aria-pressed', on ? 'true' : 'false');
            c.classList.toggle('border-[#c9a84c]', on);
            c.classList.toggle('bg-[#1c2110]', on);
          });
        });
        wrap.appendChild(btn);
      });
    }

    function startRound() {
      const r = ROUNDS[round];
      selection = new Set();
      erredThisRound = false;
      pickedSeal = null;
      if (r.kind === 'fish1') fishPlacement = {};

      $('nudge').classList.add('hidden');
      $('reveal').classList.add('hidden');
      $('btn-submit').parentElement.classList.remove('hidden');
      $('btn-submit').disabled = false;
      $('btn-submit').textContent = r.submitLabel;

      $('round-kicker').textContent = r.kicker;
      $('round-title').textContent = r.title;
      $('round-lens-line').textContent = r.lensLine;
      $('round-task').innerHTML = r.task || r.scene ? (r.task || 'Choose, then stamp.') : '';
      $('round-task').classList.toggle('hidden', !r.task);
      $('lens-he').textContent = r.lensHe;
      const lens = $('lens-medallion');
      lens.classList.remove('swung');
      void lens.offsetWidth;
      lens.classList.add('swung');

      $('fish-panel').classList.toggle('hidden', r.kind !== 'fish1');
      $('choice-panel').classList.add('hidden');
      const herdVisible = r.kind === 'lens';
      $('herd-panel').classList.toggle('hidden', !herdVisible && !(r.id === 'bear' || r.id === 'yonatan'));

      if (r.kind === 'fish1') renderFish();
      else if (r.kind === 'lens') renderHerd(r);
      else if (r.kind === 'choice') {
        if (r.id === 'bear' || r.id === 'yonatan') renderHerd(null);
        renderChoices(r);
      }
      renderBadges();
    }

    function judge() {
      const r = ROUNDS[round];
      if (r.kind === 'fish1') {
        const stages = Object.keys(FISH_ANSWER);
        const allPlaced = FISH_SEALS.every((s) => Object.values(fishPlacement).includes(s.id));
        if (!allPlaced) return { ok: false, msg: 'All three seals must sit somewhere on the timeline first.' };
        const good = stages.every((st) => fishPlacement[st] === FISH_ANSWER[st]) && !fishPlacement.sea;
        return { ok: good, msg: 'The stall keeper shakes his head — at least one house is sealed to the wrong moment. Lift the seals and try again.' };
      }
      if (r.kind === 'lens') {
        if (selection.size === 0) return { ok: false, msg: 'Tap at least one animal before stamping.' };
        const want = new Set(r.correct);
        const good = want.size === selection.size && [...want].every((id) => selection.has(id));
        return { ok: good, msg: 'The lens disagrees — some page in the herdbook is stamped wrong. Adjust your selection.' };
      }
      // choice
      const multi = r.multi || 1;
      if (selection.size < multi) return { ok: false, msg: multi === 1 ? 'Choose an answer first.' : `Choose ${multi} answers first.` };
      const want = Array.isArray(r.correct) ? r.correct : [r.correct];
      const good = want.length === selection.size && want.every((k) => selection.has(k));
      return {
        ok: good,
        msg: r.id === 'bear'
          ? 'That was argued at Rav Ashi’s door too — but it is not what he ruled. Rule again.'
          : 'Not those. Read the lens line again and choose afresh.',
      };
    }

    function submit() {
      const res = judge();
      const nudge = $('nudge');
      if (!res.ok) {
        erredThisRound = true;
        badgeState[round] = 'retry';
        renderBadges();
        nudge.textContent = res.msg;
        nudge.classList.remove('hidden');
        nudge.classList.remove('shake');
        void nudge.offsetWidth;
        nudge.classList.add('shake');
        return;
      }
      const r = ROUNDS[round];
      if (!erredThisRound) { firstTry += 1; badgeState[round] = 'first'; }
      else badgeState[round] = 'retry';
      nudge.classList.add('hidden');
      if (r.kind === 'lens') {
        Object.entries(r.stamps).forEach(([id, stamp]) => {
          stampsSoFar[id] = stamp;
          paintStamp(id, stamp, true);
        });
        document.querySelectorAll('#herd button[data-animal]').forEach((b) => { b.disabled = true; });
      }
      if (r.kind === 'fish1') {
        $('btn-submit').disabled = true;
      }
      renderBadges();
      showReveal(r);
    }

    function showReveal(r) {
      $('reveal-he').textContent = r.reveal.he;
      $('reveal-why').innerHTML = r.reveal.why.map((w) => `<p>${w}</p>`).join('');
      const a = $('reveal-src');
      a.href = srcLink(r.reveal.ref);
      a.textContent = `Source: ${r.reveal.ref} → sefaria.org`;
      $('btn-next').textContent = round === ROUNDS.length - 1 ? 'Close the herdbook' : 'Next page of the ledger';
      $('reveal').classList.remove('hidden');
      $('btn-submit').parentElement.classList.add('hidden');
      $('reveal').scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'nearest' });
    }

    function next() {
      if (round === ROUNDS.length - 1) {
        $('reveal').classList.add('hidden');
        $('fish-panel').classList.add('hidden');
        $('choice-panel').classList.add('hidden');
        $('round-task').classList.add('hidden');
        $('round-kicker').textContent = 'chullin 75 · complete';
        $('round-title').textContent = 'The Herdbook Lens';
        $('round-lens-line').textContent = '';
        $('lens-he').textContent = 'הדרן';
        $('final-score').textContent = `You sealed ${firstTry} of ${ROUNDS.length} pages on the first stamp.`;
        $('finale').classList.remove('hidden');
        renderBadges();
        return;
      }
      round += 1;
      startRound();
    }

    $('btn-submit').addEventListener('click', submit);
    $('btn-next').addEventListener('click', next);
    $('btn-replay').addEventListener('click', () => {
      round = 0; firstTry = 0;
      badgeState.fill('pending');
      Object.keys(stampsSoFar).forEach((k) => delete stampsSoFar[k]);
      $('finale').classList.add('hidden');
      startRound();
      window.scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    });

    startRound();
  </script>
</Layout>
