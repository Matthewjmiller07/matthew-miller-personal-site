    // ---- State ----
    let caseIdx = 0;
    let momentIdx = 0;
    let results = []; // {ok} per finished case
    let over = false;

    const TIMES = { dawn: '🌅 dawn', morning: '☀️ morning', midday: '🌞 midday', afternoon: '🌇 afternoon', dusk: '🌆 dusk' };

    function sunArc(frac) {
      // Signature: "in one day" — the sun crosses its arc as the moments pass.
      const a = Math.PI * (1 - frac);
      const cx = 100 + 82 * Math.cos(a);
      const cy = 88 - 74 * Math.sin(a);
      return `
        <svg viewBox="0 0 200 96" class="mx-auto block w-56" aria-hidden="true">
          <path d="M 18 88 A 82 82 0 0 1 182 88" fill="none" stroke="#2b2438" stroke-width="2" stroke-dasharray="1 5" stroke-linecap="round"/>
          <line x1="8" y1="88" x2="192" y2="88" stroke="#3a2f1e" stroke-width="2"/>
          <circle class="sun-dot" cx="${cx}" cy="${cy}" r="7" fill="#f2c14e"/>
        </svg>
        <p class="frank -mt-1 text-center text-sm !text-[#c08b3f]" dir="rtl" lang="he">בְּיוֹם אֶחָד</p>
        <p class="text-center text-[10px] uppercase tracking-[0.25em] !text-[#6b6478]">one day — lev. 22:28</p>`;
    }

    function progressChips() {
      return CASES.map((c, i) => {
        if (i < results.length) return `<span class="inline-block h-2.5 w-2.5 rounded-full ${results[i].ok ? 'bg-[#9db87a]' : 'bg-[#d24a43]'}"></span>`;
        if (i === caseIdx && !over) return '<span class="inline-block h-2.5 w-2.5 rounded-full bg-[#f2c14e]"></span>';
        return '<span class="inline-block h-2.5 w-2.5 rounded-full bg-[#2b2438]"></span>';
      }).join('');
    }

    function momentCard(m, i, current) {
      return `
        <div class="fade-in rounded-xl border p-3 ${current ? 'border-[#c08b3f]/60 bg-[#1a1510]' : 'border-[#2b2438] bg-[#120f18] opacity-70'}">
          <p class="text-[10px] font-bold uppercase tracking-[0.2em] !text-[#8d8798]">${TIMES[m.t]}</p>
          <p class="mt-1 text-sm leading-relaxed !text-[#d8d1c0]">${m.icon} ${m.text}</p>
        </div>`;
    }

    function render() {
      const c = CASES[caseIdx];
      const frac = Math.min((momentIdx + 0.5) / c.moments.length, 1);
      const m = c.moments[momentIdx];
      const seen = c.moments.slice(0, momentIdx + 1);

      $('game-area').innerHTML = `
        <div class="rounded-2xl border border-[#2b2438] bg-[#16121d] p-5">
          <div class="mb-3 flex items-center justify-between gap-3">
            <p class="text-[11px] font-bold uppercase tracking-[0.2em] !text-[#c08b3f]">case ${caseIdx + 1} of ${CASES.length}</p>
            <div class="flex gap-1.5">${progressChips()}</div>
          </div>
          ${sunArc(frac)}
          <h2 class="frank mt-3 text-2xl font-bold !text-[#eae3d2]">${c.title}</h2>
          <p class="frank text-lg !text-[#dfa14e]" dir="rtl" lang="he">${c.he}</p>
          <p class="mt-2 rounded-lg border border-[#2b2438] bg-[#120f18] px-3 py-2 text-xs !text-[#a19aad]">⚖️ <strong class="!text-[#cfc4a4]">${c.court}</strong> · ${c.cast} · <a href="${c.refUrl}" class="!text-[#dfa14e] underline hover:!text-[#f2c14e]">${c.ref}</a></p>
          <div class="mt-4 grid gap-2">${seen.map((mm, i) => momentCard(mm, i, i === momentIdx)).join('')}</div>
          <div id="controls" class="mt-4 grid gap-2 sm:grid-cols-2"></div>
          <div id="verdict"></div>
        </div>`;

      const controls = $('controls');
      m.cries.forEach((cry, k) => {
        const b = document.createElement('button');
        b.className = 'rounded-xl border border-[#7c2320] bg-[#d24a43]/15 px-4 py-3 text-sm font-bold !text-[#e8837d] hover:bg-[#d24a43]/30 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#f2c14e]';
        b.textContent = cry.label;
        b.addEventListener('click', () => finishCase(cry));
        controls.appendChild(b);
      });
      const hold = document.createElement('button');
      hold.className = 'rounded-xl border border-[#2b2438] bg-[#120f18] px-4 py-3 text-sm font-bold !text-[#a19aad] hover:!text-[#eae3d2] hover:border-[#8d8798] focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#f2c14e]';
      hold.textContent = momentIdx < c.moments.length - 1 ? '🤫 Hold your peace' : '🤫 Hold your peace — let the day end';
      hold.addEventListener('click', () => {
        if (momentIdx < c.moments.length - 1) { momentIdx++; render(); }
        else finishCase(c.hold);
      });
      controls.appendChild(hold);
    }

    function finishCase(outcome) {
      const c = CASES[caseIdx];
      results.push({ ok: outcome.ok });
      $('controls').innerHTML = '';
      const last = caseIdx === CASES.length - 1;
      $('verdict').innerHTML = `
        <div class="fade-in mt-4 rounded-xl border p-4 ${outcome.ok ? 'border-[#9db87a]/50 bg-[#9db87a]/10' : 'border-[#d24a43]/50 bg-[#d24a43]/10'}">
          <p class="frank text-lg font-bold ${outcome.ok ? '!text-[#b9d49a]' : '!text-[#e8837d]'}">${outcome.ok ? '✓' : '✗'} ${outcome.head}</p>
          <p class="mt-2 text-sm leading-relaxed !text-[#d8d1c0]">${outcome.body}</p>
          <p class="mt-2 text-xs !text-[#8d8798]">Source: <a href="${c.refUrl}" class="!text-[#dfa14e] underline hover:!text-[#f2c14e]">${c.ref}</a></p>
          <button id="btn-next" class="mt-3 w-full rounded-xl border border-[#c08b3f]/50 bg-[#c08b3f]/15 px-4 py-3 text-sm font-bold !text-[#dfa14e] hover:bg-[#c08b3f]/25 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#f2c14e]">${last ? '⚖️ Hear your standing before the court' : 'Next case →'}</button>
        </div>`;
      $('btn-next').addEventListener('click', () => {
        if (last) { over = true; renderEnd(); }
        else { caseIdx++; momentIdx = 0; render(); }
        $('game-area').scrollIntoView({ behavior: 'auto', block: 'start' });
      });
      $('btn-next').focus();
    }

    function renderEnd() {
      const score = results.filter((r) => r.ok).length;
      let title, note;
      if (score === 8) { title = 'עֵד נֶאֱמָן — a faithful witness'; note = 'Every cry stuck and every silence was right. The court rises for you.'; }
      else if (score >= 6) { title = 'the eyes of the court'; note = 'The benches trust you — one or two cries got away.'; }
      else if (score >= 4) { title = 'a promising voice'; note = 'You know the knife; now learn the benches that judge it.'; }
      else { title = 'הַתְרָאַת סָפֵק — a doubtful warning'; note = 'The court struck most of your cries. Walk the day again — watch the blood, the altar, and the plaque.'; }
      $('game-area').innerHTML = `
        <div class="rounded-2xl border border-[#2b2438] bg-[#16121d] p-6 text-center">
          ${sunArc(1)}
          <p class="mt-4 text-[11px] font-bold uppercase tracking-[0.2em] !text-[#c08b3f]">the day is over — your standing</p>
          <p class="frank mt-2 text-3xl font-black !text-[#eae3d2]">${score} / ${CASES.length}</p>
          <p class="frank mt-1 text-xl !text-[#dfa14e]">${title}</p>
          <p class="mx-auto mt-2 max-w-md text-sm !text-[#a19aad]">${note}</p>
          <div class="mt-3 flex justify-center gap-1.5">${progressChips()}</div>
          <div class="mt-5 flex flex-wrap justify-center gap-2">
            <button id="btn-replay" class="rounded-xl border border-[#c08b3f]/50 bg-[#c08b3f]/15 px-4 py-2.5 text-sm font-bold !text-[#dfa14e] hover:bg-[#c08b3f]/25 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#f2c14e]">Walk the day again</button>
            <button id="btn-share" class="rounded-xl border border-[#2b2438] px-4 py-2.5 text-sm font-bold !text-[#a19aad] hover:!text-[#eae3d2] focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#f2c14e]">Share score</button>
          </div>
        </div>`;
      $('btn-replay').addEventListener('click', () => { caseIdx = 0; momentIdx = 0; results = []; over = false; render(); });
      $('btn-share').addEventListener('click', async () => {
        const text = `📢 The Warning Cry — Chullin 81\nMy standing as a witness: ${score}/${CASES.length}\nhttps://matthewmiller.dev/daf/chullin-81`;
        try {
          if (navigator.share) await navigator.share({ text });
          else {
            await navigator.clipboard.writeText(text);
            $('btn-share').textContent = 'Copied!';
            setTimeout(() => ($('btn-share').textContent = 'Share score'), 1500);
          }
        } catch (e) { /* user dismissed share sheet */ }
      });
    }

    render();
  </script>
</Layout>
