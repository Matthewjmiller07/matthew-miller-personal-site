            }],
          },
        ],
        hold: {
          ok: false,
          head: 'He walks free — but this bench needed no fit meat',
          body: 'You reasoned like Rabbi Shimon — but the Rabbis preside today, and for them slaughter need not render the animal fit for eating to violate oto v’et beno (81b:4). Your cry would have stuck. Know your bench.',
        },
      },
      {
        title: 'A Knife for the Idol, Before Rabbi Yoḥanan',
        he: 'הַשֵּׁנִי לַעֲבוֹדָה זָרָה',
        court: 'Rabbi Yoḥanan presiding',
        cast: '🐄 the mother — slaughtered for his table · 🐮 her offspring — he means to slaughter it to an idol',
        ref: 'Chullin 81b:7–8',
        refUrl: 'https://www.sefaria.org/Chullin.81b.7',
        moments: [
          {
            t: 'dawn', icon: '🔪',
            text: 'He slaughters the mother for his own table. First of the day.',
