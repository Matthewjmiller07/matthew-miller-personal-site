        },
      },
      {
        title: 'The Stabber',
        he: 'הַנּוֹחֵר וְהַמְעַקֵּר — פָּטוּר',
        court: 'The full court — every sage agrees',
        cast: '🐄 the mother — his, non-sacred · 🐮 her offspring — his, non-sacred',
        ref: 'Chullin 81b:5 (Mishnah)',
        refUrl: 'https://www.sefaria.org/Chullin.81b.5',
        moments: [
          {
            t: 'dawn', icon: '🔪',
            text: 'He slaughters the mother, cleanly. First of the day.',
            cries: [{ label: '📢 Cry the warning!', ...STRIKE_FIRST }],
          },
          {
            t: 'dusk', icon: '⚔️',
            text: 'For the offspring he does not reach for the shechita knife at all — he raises a spike to stab it through the neck (noḥer).',
            cries: [{
              label: '📢 Cry the warning!',
              ok: false,
              head: 'Struck — in every court at once',
