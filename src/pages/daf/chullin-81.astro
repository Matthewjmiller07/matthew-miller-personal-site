          {
            t: 'morning', icon: '🩸',
            text: "A priest catches the calf's blood and dashes it against the altar. The service is complete — the calf's meat is now permitted to be eaten.",
            cries: [{ label: '📢 Cry the warning!', ...STRIKE_ALTAR }],
