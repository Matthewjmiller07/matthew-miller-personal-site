---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="The Angel Who Never Sang — Daf Yomi Game: Chullin 91"
  description="Chullin 91: stage the angel's grip to find out which thigh Yaakov lost, match five Sages to the five verses that keep a Torah scholar indoors after dark, measure Yaakov's ladder at eight thousand parasangs, and rebuild the angels' Kedushah until the Name finally falls in the right place."
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;700;900&display=swap"
  />

  <main class="min-h-screen bg-[#06060f] !text-[#e7e4f6]">
    <!-- ============ Hero ============ -->
    <div class="starfield border-b border-[#242849] px-4 pt-10 pb-8 text-center">
      <p class="mb-3 text-xs uppercase tracking-[0.3em] !text-[#8a7fd0]">
        <a href="/daf" class="hover:!text-[#b79cff]">daf yomi arcade</a> · chullin 91 · 2026-07-30
      </p>
      <h1 class="frank text-4xl font-black tracking-tight sm:text-5xl">🎶 The Angel Who Never Sang</h1>
      <p class="frank mt-2 text-xl !text-[#f0b429]" dir="rtl" lang="he">
        מִיּוֹם שֶׁנִּבְרֵאתִי לֹא הִגִּיעַ זְמַנִּי לוֹמַר שִׁירָה עַד עַכְשָׁיו
      </p>
      <p class="mx-auto mt-1 text-xs italic !text-[#9b96bd]">
        "From the day I was created, my time to sing has not come — until now." — the angel to Yaakov, Chullin 91b:13
      </p>
      <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed !text-[#c9c4e2]">
        A page that starts by arguing over a nerve and ends inside the Kedushah. Stage the wrestling match three
        ways to see which thigh Yaakov actually lost. Find the five verses five Sages read as "don't walk alone at
        night." Measure the ladder from the plural of a single word. Then take three choirs of ministering angels
        and arrange their <span dir="rtl" lang="he" class="he-inline">קָדוֹשׁ</span>s until the Divine Name lands
        exactly where the baraita says it may.
      </p>
    </div>

    <div class="mx-auto max-w-2xl px-4 pb-16 pt-8">
      <!-- ============ Context card ============ -->
      <div class="mb-6 rounded-2xl border border-[#242849] bg-[#101227] p-5">
        <p class="text-[11px] font-bold uppercase tracking-[0.2em] !text-[#8a7fd0]">before you play — the first half of 91a</p>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <div class="rounded-xl border border-[#191c36] bg-[#0a0b18] p-3">
            <p class="text-xs font-bold !text-[#b79cff]">🕯 the fat Israel forbade on its own</p>
            <p class="mt-1 text-xs leading-relaxed !text-[#9b96bd]">
              Rav Ashi: the fat around the sciatic nerve is permitted by Torah law — "but the Jewish people are
              holy and treated it as forbidden." Permitted in principle, it still counts as sacrificial meat, so a
              Paschal offering's is left over and burned rather than eaten (Chullin 91a:1).
            </p>
          </div>
          <div class="rounded-xl border border-[#191c36] bg-[#0a0b18] p-3">
            <p class="text-xs font-bold !text-[#b79cff]">🧵 two nerves, not one</p>
            <p class="mt-1 text-xs leading-relaxed !text-[#9b96bd]">
              Ravina, quoting Rav Yehuda in Shmuel's name: the <em>inner</em> nerve, next to the bone, is forbidden
              by Torah law and carries lashes; the <em>outer</em> nerve, next to the flesh, is rabbinic and carries
              none (Chullin 91a:2).
            </p>
          </div>
          <div class="rounded-xl border border-[#191c36] bg-[#0a0b18] p-3">
            <p class="text-xs font-bold !text-[#b79cff]">⚖️ was Rabbi Yehuda sure?</p>
            <p class="mt-1 text-xs leading-relaxed !text-[#9b96bd]">
              90b left it open: does Rabbi Yehuda <em>know</em> the right thigh is the forbidden one, or only guess?
              91a settles it from a baraita about two nerves from two different animals — obviously both right ones,
              and he still says forty lashes, not eighty (Chullin 91a:9–10).
            </p>
          </div>
          <div class="rounded-xl border border-[#191c36] bg-[#0a0b18] p-3">
            <p class="text-xs font-bold !text-[#b79cff]">🫒 why only forty, then?</p>
            <p class="mt-1 text-xs leading-relaxed !text-[#9b96bd]">
              Because one of the two nerves was smaller than an olive-bulk. The first tanna flogs you for a whole
              nerve of any size — it is a complete creature-unit; Rabbi Yehuda requires a kezayit (Chullin 91a:11).
            </p>
          </div>
        </div>
      </div>

      <!-- ============ Score bar ============ -->
      <div class="sticky top-0 z-10 mb-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-1 rounded-xl border border-[#242849] bg-[#06060f]/95 px-4 py-2.5 text-[11px] font-bold uppercase tracking-[0.15em] backdrop-blur">
        <span class="!text-[#9b96bd]">progress:</span>
        <span id="score-grip" class="!text-[#b79cff]">grip 0/4</span>
        <span id="score-night" class="!text-[#f0b429]">night 0/5</span>
        <span id="score-ladder" class="!text-[#b79cff]">ladder 0/2</span>
        <span id="score-choir" class="!text-[#f0b429]">kedushah ✗</span>
      </div>

      <!-- ============ Act I — The Grip ============ -->
      <section class="mb-8 rounded-2xl border border-[#242849] bg-[#101227] p-5">
        <p class="text-[11px] font-bold uppercase tracking-[0.2em] !text-[#8a7fd0]">act i · chullin 91a:12–17</p>
        <h2 class="frank mt-1 text-2xl font-black">Stage the Grip</h2>
        <p class="mt-2 text-sm leading-relaxed !text-[#c9c4e2]">
          Rabbi Yehuda holds only <em>one</em> thigh's nerve is forbidden by Torah law, and Rava finds it in the
          definite article: <span dir="rtl" lang="he" class="he-inline !text-[#f0b429]">הַיָּרֵךְ</span> — "the
          thigh," meaning <span dir="rtl" lang="he" class="he-inline">הַמְיוּמֶּנֶת</span>, the dominant one. The
          Rabbis read the same word differently and forbid both. So everything turns on choreography: where was
          the angel standing? Four readings, three positions. Block each one.
        </p>

        <div class="mt-4 grid gap-4 sm:grid-cols-[auto_1fr] sm:items-start">
          <!-- top-down staging diagram -->
          <div class="mx-auto">
            <svg id="grip-stage" viewBox="0 0 200 200" class="h-[190px] w-[190px]" role="img" aria-labelledby="grip-stage-title">
              <title id="grip-stage-title">Top-down view of Yaakov with the angel's position</title>
              <circle cx="100" cy="100" r="86" fill="#0a0b18" stroke="#191c36" />
              <text x="100" y="18" text-anchor="middle" class="stage-lbl">ahead</text>
              <text x="100" y="192" text-anchor="middle" class="stage-lbl">behind</text>
              <text x="182" y="104" text-anchor="middle" class="stage-lbl">right</text>
              <text x="18" y="104" text-anchor="middle" class="stage-lbl">left</text>
              <!-- Yaakov, seen from above, facing up -->
              <g>
                <circle cx="100" cy="100" r="17" fill="#1a1c38" stroke="#4a4d80" />
                <path d="M100 79 L95 89 L105 89 Z" fill="#8a7fd0" />
                <circle id="hip-left" cx="82" cy="114" r="7" fill="#161832" stroke="#3a3d66" />
                <circle id="hip-right" cx="118" cy="114" r="7" fill="#161832" stroke="#3a3d66" />
                <text x="100" y="140" text-anchor="middle" class="stage-lbl">Yaakov</text>
              </g>
              <!-- angel token -->
              <g id="angel-token" opacity="0">
                <circle cx="100" cy="40" r="13" fill="#2a220a" stroke="#f0b429" />
                <text x="100" y="45" text-anchor="middle" class="angel-glyph">✦</text>
              </g>
            </svg>
          </div>
          <div id="grip-list" class="space-y-3"></div>
        </div>

        <div id="grip-verdict" class="mt-4 hidden rounded-xl border border-[#3d3568] bg-[#151233] p-4 text-sm leading-relaxed !text-[#c9c4e2]"></div>
      </section>

      <!-- ============ Act II — Night Watch ============ -->
      <section class="mb-8 rounded-2xl border border-[#242849] bg-[#101227] p-5">
        <p class="text-[11px] font-bold uppercase tracking-[0.2em] !text-[#8a7fd0]">act ii · chullin 91a:23–91b:4</p>
        <h2 class="frank mt-1 text-2xl font-black">Night Watch</h2>
        <p class="mt-2 text-sm leading-relaxed !text-[#c9c4e2]">
          "A man wrestled with him until the breaking of the day" — Rabbi Yitzchak reads it as a warning:
          <em>a Torah scholar should not go out alone at night</em>. Four more Sages find the same rule somewhere
          else entirely. Five verses, five Sages, each used exactly once. Assign them.
        </p>
        <div id="night-list" class="mt-4 space-y-3"></div>
        <div id="night-done" class="mt-4 hidden rounded-xl border border-[#4a3a10] bg-[#1a1305] p-4 text-sm leading-relaxed !text-[#e6d3a8]"></div>
      </section>

      <!-- ============ Act III — The Ladder ============ -->
      <section class="mb-8 rounded-2xl border border-[#242849] bg-[#101227] p-5">
        <p class="text-[11px] font-bold uppercase tracking-[0.2em] !text-[#8a7fd0]">act iii · chullin 91b:6–12</p>
        <h2 class="frank mt-1 text-2xl font-black">Measure the Ladder</h2>
        <p class="mt-2 text-sm leading-relaxed !text-[#c9c4e2]">
          The sun set early so Yaakov would have to sleep at the Place; the stones argued over whose turn it was to
          hold his head; and then he dreamed a ladder. A baraita gives its width as a flat number — eight thousand
          parasangs — and derives every digit of it from two verses. Set both dials from the evidence and the
          ladder will size itself.
        </p>

        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          <div class="rounded-xl border border-[#191c36] bg-[#0a0b18] p-4">
            <p class="text-xs font-bold !text-[#b79cff]">dial 1 · how many angels abreast?</p>
            <p class="mt-1 text-xs leading-relaxed !text-[#9b96bd]">
              <span dir="rtl" lang="he" class="he-inline">״וְהִנֵּה מַלְאֲכֵי אֱלֹהִים עֹלִים וְיֹרְדִים בּוֹ״</span><br />
              Rashi: <em>olim</em> is plural — together, not one after the other. So is <em>yordim</em>. Now: what
              happens when the two groups meet in the middle?
            </p>
            <div class="mt-3 flex items-center gap-3">
              <button id="ang-minus" class="dial-btn" aria-label="fewer angels">−</button>
              <span id="ang-val" class="frank w-12 text-center text-2xl font-black !text-[#f0b429]">2</span>
              <button id="ang-plus" class="dial-btn" aria-label="more angels">+</button>
              <span class="text-xs !text-[#9b96bd]">angels</span>
            </div>
          </div>
          <div class="rounded-xl border border-[#191c36] bg-[#0a0b18] p-4">
            <p class="text-xs font-bold !text-[#b79cff]">dial 2 · how wide is one angel?</p>
            <p class="mt-1 text-xs leading-relaxed !text-[#9b96bd]">
              <span dir="rtl" lang="he" class="he-inline">״וּגְוִיָּתוֹ כְּתַרְשִׁישׁ״</span> (Daniel 10:6) — an
              angel's body is like Tarshish. And <span dir="rtl" lang="he" class="he-inline">גְּמִירִי</span>, it is
              learned as a tradition, that Tarshish is…
            </p>
            <div class="mt-3 flex flex-wrap gap-2" id="tarshish-opts"></div>
          </div>
        </div>

        <div class="mt-4 rounded-xl border border-[#191c36] bg-[#0a0b18] p-4">
          <div class="flex items-baseline justify-between">
            <p class="text-xs font-bold uppercase tracking-[0.15em] !text-[#8a7fd0]">width of the ladder</p>
            <p class="frank text-xl font-black !text-[#f0b429]"><span id="ladder-total">2,000</span> <span class="text-xs font-bold !text-[#9b96bd]">parasangs</span></p>
          </div>
          <div class="mt-3 h-[86px] w-full overflow-hidden rounded-lg border border-[#191c36] bg-[#06060f]">
            <div id="ladder-bar" class="ladder-bar" style="width: 25%"></div>
          </div>
          <p id="ladder-hint" class="mt-2 text-xs !text-[#9b96bd]">Two dials, one product. The baraita's number is 8,000.</p>
        </div>

        <div id="ladder-reveal" class="mt-4 hidden space-y-3"></div>
      </section>

      <!-- ============ Act IV — Kedushah Studio ============ -->
      <section class="mb-8 rounded-2xl border border-[#4a3a10] bg-[#141021] p-5">
        <p class="text-[11px] font-bold uppercase tracking-[0.2em] !text-[#f0b429]">act iv · chullin 91b:13–18 · the finale</p>
        <h2 class="frank mt-1 text-2xl font-black">Kedushah Studio</h2>
        <p class="mt-2 text-sm leading-relaxed !text-[#c9c4e2]">
          Yaakov asks his attacker why he is so afraid of daybreak — <em>are you a thief, or a gambler?</em> The
          answer: "I am an angel, and from the day I was created my time to sing has never come — until now."
          That supports Rav Chananel in Rav's name: three companies of ministering angels sing daily, one saying
          <span dir="rtl" lang="he" class="he-inline">קָדוֹשׁ</span>, one saying
          <span dir="rtl" lang="he" class="he-inline">קָדוֹשׁ</span>, and one saying
          <span dir="rtl" lang="he" class="he-inline">קָדוֹשׁ ה׳ צְבָאוֹת</span>.
        </p>
        <p class="mt-2 text-sm leading-relaxed !text-[#c9c4e2]">
          Then a baraita objects, and its rule is unforgiving: <strong class="!text-[#f0b429]">the ministering
          angels may not utter the Name until three words have gone before it.</strong> Rav's line-up breaks that
          rule. Re-cut it — you may only add or remove whole <span dir="rtl" lang="he" class="he-inline">קָדוֹשׁ</span>s.
        </p>

        <div id="choir-rows" class="mt-4 space-y-2"></div>

        <div id="choir-verdict" class="mt-3 rounded-xl border border-[#191c36] bg-[#0a0b18] p-4 text-xs leading-relaxed"></div>

        <div class="mt-3 flex flex-wrap gap-2">
          <button id="choir-sing" class="act-btn">▶ Hear it</button>
          <button id="choir-rav" class="act-btn">↺ Back to Rav Chananel's version</button>
        </div>

        <div class="mt-4 rounded-xl border border-[#191c36] bg-[#0a0b18] p-4">
          <p class="text-xs font-bold !text-[#b79cff]">the same baraita's other boast · how often do they sing?</p>
          <p class="mt-1 text-xs leading-relaxed !text-[#9b96bd]">
            "Israel are more beloved before the Holy One than the ministering angels, for Israel say song at every
            hour, and the ministering angels say song only…" — and then seven Sages disagree about how rarely.
            Drag through them.
          </p>
          <input id="freq-slider" type="range" min="0" max="6" value="0" step="1" class="mt-3 w-full" aria-label="how often the angels sing" />
          <div class="mt-2 flex items-baseline justify-between gap-3">
            <p id="freq-he" class="frank text-lg !text-[#f0b429]" dir="rtl" lang="he">פַּעַם אַחַת בַּיּוֹם</p>
            <p id="freq-en" class="text-xs !text-[#c9c4e2]">once a day</p>
          </div>
          <div class="mt-2 rounded-lg border border-[#191c36] bg-[#06060f] p-2 text-center">
            <p class="text-[11px] !text-[#9b96bd]">Israel, on every reading: <span class="frank text-sm !text-[#b79cff]" dir="rtl" lang="he">בְּכׇל שָׁעָה</span> — at every hour</p>
          </div>
        </div>

        <div id="choir-coda" class="mt-4 hidden rounded-xl border border-[#4a3a10] bg-[#1a1305] p-4 text-sm leading-relaxed !text-[#e6d3a8]"></div>
      </section>

      <!-- ============ Learn the real daf ============ -->
      <div class="mt-10 rounded-2xl border border-[#242849] bg-[#101227] p-5">
        <p class="text-[11px] font-bold uppercase tracking-[0.2em] !text-[#8a7fd0]">learn the real daf</p>
        <p class="mt-2 text-sm leading-relaxed !text-[#c9c4e2]">
          91a finishes the previous daf's business first: Rav Ashi and Ravina explain which part of the sciatic
          nerve a mishna could mean when it says the sinews of a Paschal offering are burned as leftovers, and the
          Gemara closes the long question of whether Rabbi Yehuda was certain that the right thigh is the forbidden
          one — he was, and the reason he still gives only forty lashes for two nerves is that one of them was
          smaller than an olive-bulk
          (<a class="!text-[#b79cff] underline hover:!text-[#d6c9ff]" href="https://www.sefaria.org/Chullin.91a.1" target="_blank" rel="noopener">91a:1–11</a>).
          Then the reasons: Rava reads <span dir="rtl" lang="he" class="he-inline">הַיָּרֵךְ</span> as the dominant
          thigh; the Rabbis read it as the nerve whose prohibition spreads through the whole thigh, excluding the
          outer one; and Rabbi Yehoshua ben Levi, Rabbi Shmuel bar Nachmani and Rava bar Ulla each reconstruct the
          wrestling match to explain how the angel reached Yaakov's right side, while the Rabbis have him come from
          behind and strike both
          (<a class="!text-[#b79cff] underline hover:!text-[#d6c9ff]" href="https://www.sefaria.org/Chullin.91a.12" target="_blank" rel="noopener">91a:12–18</a>).
        </p>
        <p class="mt-2 text-sm leading-relaxed !text-[#c9c4e2]">
          From there the daf turns almost entirely to aggada: the name <em>gid hanasheh</em> from a nerve that
          "slipped" its place; Rabbi Yosei son of Rabbi Chanina on the word God sent to Yaakov that fell upon all
          Israel, and on Yosef instructing his steward to remove the sciatic nerve in the brothers' sight; Rabbi
          Elazar on why Yaakov was left alone — he went back for small jars, because the righteous treasure their
          possessions, having never stretched out a hand for stolen goods; and five Sages on why a Torah scholar
          should not go out alone at night
          (<a class="!text-[#b79cff] underline hover:!text-[#d6c9ff]" href="https://www.sefaria.org/Chullin.91a.19" target="_blank" rel="noopener">91a:19–91b:4</a>).
          Rabbi Akiva's question in the meat market of Emmaus — did the sun really rise for <em>him</em> alone? —
          opens Rabbi Yitzchak's cycle on Beit El: the land contracting, the sun setting early so the righteous man
          would not leave without lodging, the stones competing and merging into one, the ladder eight thousand
          parasangs wide, angels ascending to compare Yaakov's engraved image above with the sleeper below, and all
          of Eretz Yisrael folded up beneath him
          (<a class="!text-[#b79cff] underline hover:!text-[#d6c9ff]" href="https://www.sefaria.org/Chullin.91b.5" target="_blank" rel="noopener">91b:5–12</a>).
        </p>
        <p class="mt-2 text-sm leading-relaxed !text-[#c9c4e2]">
          The daf ends inside the angels' song: the angel begs to be released because his moment to sing has finally
          arrived, Rav Chananel reports three companies dividing the Kedushah between them, and a baraita objects on
          two fronts — Israel sing whenever they like and name God after two words, while angels sing rarely, name
          God only after three, and may not begin above until Israel have begun below. The Gemara re-cuts Rav's
          version to fit, then immediately asks about <span dir="rtl" lang="he" class="he-inline">״בָּרוּךְ״</span>
          — and the argument spills onto 92a
          (<a class="!text-[#b79cff] underline hover:!text-[#d6c9ff]" href="https://www.sefaria.org/Chullin.91b.13" target="_blank" rel="noopener">91b:13–18</a>).
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          <a href="https://www.sefaria.org/Chullin.91a" class="rounded-lg border border-[#b79cff]/40 bg-[#b79cff]/10 px-3 py-1.5 text-xs font-bold !text-[#b79cff] hover:bg-[#b79cff]/20">Chullin 91 on Sefaria →</a>
          <a href="https://www.sefaria.org/Rashi_on_Chullin.91a" class="rounded-lg border border-[#242849] px-3 py-1.5 text-xs !text-[#9b96bd] hover:!text-[#e7e4f6]">Rashi (×65)</a>
          <a href="https://www.sefaria.org/Steinsaltz_on_Chullin.91a" class="rounded-lg border border-[#242849] px-3 py-1.5 text-xs !text-[#9b96bd] hover:!text-[#e7e4f6]">Steinsaltz (×41)</a>
          <a href="https://www.sefaria.org/Rabbeinu_Gershom_on_Chullin.91a" class="rounded-lg border border-[#242849] px-3 py-1.5 text-xs !text-[#9b96bd] hover:!text-[#e7e4f6]">Rabbeinu Gershom (×21)</a>
          <a href="https://www.sefaria.org/Ben_Yehoyada_on_Chullin.91a" class="rounded-lg border border-[#242849] px-3 py-1.5 text-xs !text-[#9b96bd] hover:!text-[#e7e4f6]">Ben Yehoyada (×20)</a>
          <a href="https://www.sefaria.org/Chidushei_Agadot_on_Chullin.91a" class="rounded-lg border border-[#242849] px-3 py-1.5 text-xs !text-[#9b96bd] hover:!text-[#e7e4f6]">Maharsha, Chidushei Agadot (×17)</a>
          <a href="https://www.sefaria.org/Tosafot_on_Chullin.91a" class="rounded-lg border border-[#242849] px-3 py-1.5 text-xs !text-[#9b96bd] hover:!text-[#e7e4f6]">Tosafot (×9)</a>
        </div>
      </div>
    </div>
  </main>

  <style>
    .frank { font-family: 'Frank Ruhl Libre', 'Times New Roman', serif; }
    .he-inline { direction: rtl; font-family: 'Frank Ruhl Libre', serif; }
    .starfield {
      background:
        radial-gradient(1px 1px at 12% 22%, #6b6499 50%, transparent 51%),
        radial-gradient(1px 1px at 78% 16%, #7d76ad 50%, transparent 51%),
        radial-gradient(1px 1px at 34% 68%, #5c568a 50%, transparent 51%),
        radial-gradient(1.5px 1.5px at 62% 44%, #8d85bd 50%, transparent 51%),
        radial-gradient(1px 1px at 88% 72%, #6b6499 50%, transparent 51%),
        radial-gradient(1px 1px at 21% 88%, #5c568a 50%, transparent 51%),
        linear-gradient(to bottom, #0d0b1e 0%, #06060f 100%);
    }
    .stage-lbl { fill: #6f6a93; font-size: 9px; font-family: ui-sans-serif, system-ui, sans-serif; letter-spacing: 0.08em; }
    .angel-glyph { fill: #f0b429; font-size: 13px; }
    #angel-token { transition: opacity 0.25s ease; }
    .hip-hit { fill: #4a2f0a !important; stroke: #f0b429 !important; stroke-width: 2 !important; }

    /* ---- shared buttons ---- */
    .act-btn {
      border: 1px solid #242849;
      background: #0f1128;
      color: #e7e4f6;
      font-size: 11px;
      font-weight: 700;
      border-radius: 8px;
      padding: 7px 12px;
      cursor: pointer;
    }
    .act-btn:hover { border-color: #b79cff; color: #d6c9ff; }
    .dial-btn {
      border: 1px solid #242849;
      background: #0f1128;
      color: #e7e4f6;
      font-size: 16px;
      font-weight: 700;
      line-height: 1;
      border-radius: 8px;
      width: 34px;
      height: 34px;
      cursor: pointer;
    }
    .dial-btn:hover { border-color: #b79cff; color: #d6c9ff; }

    /* ---- act i ---- */
    .grip-card { border: 1px solid #191c36; background: #0a0b18; border-radius: 12px; padding: 12px; }
    .grip-btns { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
    .grip-btn {
      border: 1px solid #242849;
      background: #0f1128;
      color: #e7e4f6;
      font-size: 11px;
      font-weight: 700;
      border-radius: 8px;
      padding: 6px 10px;
      cursor: pointer;
    }
    .grip-btn:hover { border-color: #b79cff; color: #d6c9ff; }
    .grip-btn:disabled { cursor: default; opacity: 0.5; }
    .ok-mark { border-color: #4f8f6b !important; background: #0c1a13 !important; color: #9fd8b6 !important; }
    .no-mark { border-color: #a8624f !important; background: #1e1009 !important; color: #e0a58f !important; }
    .grip-why { margin-top: 8px; font-size: 12px; line-height: 1.55; color: #9b96bd; }

    /* ---- act ii ---- */
    .night-card { border: 1px solid #191c36; background: #0a0b18; border-radius: 12px; padding: 12px; }
    .sage-chip {
      border: 1px solid #242849;
      background: #0f1128;
      color: #e7e4f6;
      font-size: 11px;
      font-weight: 700;
      border-radius: 999px;
      padding: 5px 11px;
      cursor: pointer;
    }
    .sage-chip:hover { border-color: #f0b429; color: #f4cd76; }
    .sage-chip:disabled { cursor: default; opacity: 0.35; }

    /* ---- act iii ---- */
    .ladder-bar {
      height: 100%;
      background:
        repeating-linear-gradient(to bottom, transparent 0 14px, #f0b42933 14px 17px),
        linear-gradient(to right, #2a2247, #3a2f5e);
      border-right: 3px solid #f0b429;
      border-left: 3px solid #f0b429;
      transition: width 0.35s ease;
    }
    @media (prefers-reduced-motion: reduce) {
      .ladder-bar { transition: none; }
      #angel-token { transition: none; }
    }
    .tarsh-btn {
      border: 1px solid #242849;
      background: #0f1128;
      color: #e7e4f6;
      font-size: 11px;
      font-weight: 700;
      border-radius: 8px;
      padding: 6px 10px;
      cursor: pointer;
    }
    .tarsh-btn:hover { border-color: #b79cff; color: #d6c9ff; }
    .tarsh-btn.picked { border-color: #f0b429 !important; background: #221a06 !important; color: #f4cd76 !important; }

    /* ---- act iv ---- */
    .choir-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      border: 1px solid #191c36;
      background: #0a0b18;
      border-radius: 12px;
      padding: 10px 12px;
    }
    .kadosh-token {
      display: inline-block;
      border: 1px solid #3a3468;
      background: #171334;
      color: #cfc4ff;
      border-radius: 7px;
      padding: 2px 9px;
      font-family: 'Frank Ruhl Libre', serif;
      font-size: 17px;
      direction: rtl;
    }
    .name-token {
      display: inline-block;
      border: 1px solid #f0b429;
      background: #2a220a;
      color: #f4cd76;
      border-radius: 7px;
      padding: 2px 9px;
      font-family: 'Frank Ruhl Libre', serif;
      font-size: 17px;
      direction: rtl;
    }
    .kadosh-lit { box-shadow: 0 0 0 2px #f0b42966; }
    #freq-slider { accent-color: #f0b429; }
  </style>

  <script>
    const $ = (id: string) => document.getElementById(id);

    // ==================================================================
    // Act I — Stage the Grip, Chullin 91a:12-17.
    // Four readings of the wrestling match. Three of them put the angel
    // where only the right thigh is reachable (Rabbi Yehuda); the Rabbis
    // bring him up from behind, so both thighs go.
    // ==================================================================
    type Spot = 'front' | 'right' | 'behind';
    type Reading = { sage: string; he: string; claim: string; spot: Spot; why: string; ref: string };

    const READINGS: Reading[] = [
      {
        sage: 'Rabbi Yehoshua ben Levi',
        he: 'כְּאָדָם שֶׁחוֹבֵק אֶת חֲבֵירוֹ',
        claim:
          '"As he wrestled with him" (Genesis 32:26) — <em>be-he\'avko</em>, like a man who hugs another. Rashi: from the front, and his right hand reaches around to the other\'s right hip.',
        spot: 'front',
        why: 'A face-to-face embrace: the arm closes around the back and lands on the right hip-socket — the kaf ha-yarech of the right side.',
        ref: 'Chullin 91a:14',
      },
      {
        sage: 'Rabbi Shmuel bar Nachmani',
        he: 'כְּגוֹי נִדְמָה לוֹ',
        claim:
          'The angel appeared to him as a gentile — and the Master said: a Jew joined on the road by a gentile places him to his right, near his sword hand.',
        spot: 'right',
        why: 'Yaakov walks him on the right for safety, so the right thigh is the one within reach.',
        ref: 'Chullin 91a:15',
      },
      {
        sage: 'Rav Shmuel bar Acha, in the name of Rava bar Ulla',
        he: 'כְּתַלְמִיד חָכָם נִדְמָה לוֹ',
        claim:
          'The angel appeared to him as a Torah scholar — and the Master said: one who walks to the right of his teacher is a boor.',
        spot: 'right',
        why: 'Etiquette this time, not fear: the student keeps to the left, which again puts the stranger at Yaakov\'s right.',
        ref: 'Chullin 91a:16',
      },
      {
        sage: 'The Rabbis',
        he: 'מֵאֲחוֹרֵיהּ אֲתָא, וְנַשְּׁיֵיהּ בְּתַרְוַיְיהוּ',
        claim:
          'He came at him from behind — and dislocated him in both of them.',
        spot: 'behind',
        why: 'From behind, both hips are equally exposed. This is exactly why the Rabbis forbid the sciatic nerve of both thighs, against Rabbi Yehuda.',
        ref: 'Chullin 91a:17',
      },
    ];

    const SPOTS: { id: Spot; label: string; cx: number; cy: number; hips: string[] }[] = [
      { id: 'front', label: '🤝 Face to face', cx: 100, cy: 40, hips: ['hip-right'] },
      { id: 'right', label: '➡️ At his right hand', cx: 160, cy: 100, hips: ['hip-right'] },
      { id: 'behind', label: '⬅️ Up from behind', cx: 100, cy: 160, hips: ['hip-left', 'hip-right'] },
    ];

    let gripSolved = 0;

    function placeAngel(spot: Spot) {
      const s = SPOTS.find((x) => x.id === spot);
      const token = $('angel-token');
      if (!s || !token) return;
      token.setAttribute('transform', `translate(${s.cx - 100}, ${s.cy - 40})`);
      token.setAttribute('opacity', '1');
      ['hip-left', 'hip-right'].forEach((h) => $(h)?.classList.remove('hip-hit'));
      s.hips.forEach((h) => $(h)?.classList.add('hip-hit'));
    }

    const gripList = $('grip-list');
    if (gripList) {
      READINGS.forEach((r) => {
        const card = document.createElement('div');
        card.className = 'grip-card';
        card.innerHTML = `
          <p class="he-inline text-base !text-[#f0b429]" dir="rtl" lang="he">${r.he}</p>
          <p class="mt-1 text-xs font-bold !text-[#b79cff]">${r.sage}</p>
          <p class="mt-1 text-xs leading-relaxed !text-[#c9c4e2]">${r.claim}</p>
          <div class="grip-btns"></div>
          <p class="grip-why hidden"></p>`;
        const btnRow = card.querySelector('.grip-btns') as HTMLElement;
        const why = card.querySelector('.grip-why') as HTMLElement;
        SPOTS.forEach((s) => {
          const b = document.createElement('button');
          b.className = 'grip-btn';
          b.textContent = s.label;
          b.addEventListener('click', () => {
            placeAngel(s.id);
            if (s.id === r.spot) {
              b.classList.add('ok-mark');
              Array.from(btnRow.children).forEach((c) => ((c as HTMLButtonElement).disabled = true));
              const hips = s.hips.length === 2 ? 'both thighs' : 'the right thigh only';
              const rule =
                s.hips.length === 2
                  ? 'both nerves forbidden by Torah law — the Rabbis'
                  : "one nerve, the dominant thigh's — Rabbi Yehuda";
              why.innerHTML = `${r.why} <span class="!text-[#f0b429]">Struck: ${hips} → ${rule}.</span> <span class="!text-[#6f6a93]">(${r.ref})</span>`;
              why.classList.remove('hidden');
              gripSolved += 1;
              const sc = $('score-grip');
              if (sc) sc.textContent = `grip ${gripSolved}/4`;
              if (gripSolved === READINGS.length) {
                const v = $('grip-verdict');
                if (v) {
                  v.classList.remove('hidden');
                  v.innerHTML = `
                    <p class="!text-[#b79cff] text-xs font-bold uppercase tracking-[0.15em]">why it matters</p>
                    <p class="mt-2">Three Sages stage the fight so that only Yaakov's right side is ever in play, which is
                    how Rabbi Yehuda can forbid one nerve and read <span class="he-inline !text-[#f0b429]" dir="rtl" lang="he">הַיָּרֵךְ</span>
                    as <span class="he-inline" dir="rtl" lang="he">הַמְיוּמֶּנֶת שֶׁבַּיָּרֵךְ</span>, the dominant thigh (Rava, Chullin 91a:12).
                    The Rabbis send the angel around the back — and they also take the same definite article to mean
                    <span class="he-inline" dir="rtl" lang="he">הַהוּא דְּפָשֵׁיט אִיסּוּרֵיהּ בְּכוּלֵּיהּ יָרֵךְ</span>, the nerve whose prohibition
                    spreads through the whole thigh, which excludes the outer nerve but keeps both legs (Chullin 91a:13, 17).</p>
                    <p class="mt-2 !text-[#9b96bd] text-xs">Footnote from the same page: the Rabbis, who have no use for
                    <span class="he-inline" dir="rtl" lang="he">״בְּהֵאָבְקוֹ״</span> as a hug, spend it on Rabbi Yehoshua ben Levi's other reading —
                    that the <em>avak</em>, the dust of their feet, rose to the Throne of Glory (Chullin 91a:18).</p>`;
                }
              }
            } else {
              b.classList.add('no-mark');
              b.disabled = true;
            }
          });
          btnRow.appendChild(b);
        });
        gripList.appendChild(card);
      });
    }

    // ==================================================================
    // Act II — Night Watch, Chullin 91a:23-91b:4. Five verses, five Sages,
    // each used exactly once.
    // ==================================================================
    type NightCase = { verse: string; he: string; source: string; sage: string; why: string; ref: string };
    const NIGHT: NightCase[] = [
      {
        verse: '"And a man wrestled with him until the breaking of the day."',
        he: '״וַיֵּאָבֵק אִישׁ עִמּוֹ עַד עֲלוֹת הַשָּׁחַר״',
        source: 'Genesis 32:25',
        sage: 'Rabbi Yitzchak',
        why: 'Yaakov went out alone at night and was injured. The verse doubles as the warning.',
        ref: 'Chullin 91a:23',
      },
      {
        verse: '"Behold, he winnows barley tonight in the threshing floor."',
        he: '״הִנֵּה הוּא זֹרֶה אֶת גֹּרֶן הַשְּׂעֹרִים הַלָּיְלָה״',
        source: 'Ruth 3:2',
        sage: 'Rabbi Abba bar Kahana',
        why: 'Boaz stayed the night at the threshing floor rather than walk home in the dark.',
        ref: 'Chullin 91b:1',
      },
      {
        verse: '"And Avraham rose early in the morning and saddled his donkey."',
        he: '״וַיַּשְׁכֵּם אַבְרָהָם בַּבֹּקֶר וַיַּחֲבֹשׁ אֶת חֲמֹרוֹ״',
        source: 'Genesis 22:3',
        sage: 'Rabbi Abbahu',
        why: 'Even with two young men and Yitzchak beside him, Avraham waited for daylight — so a scholar should not travel at night at all, and certainly not alone.',
        ref: 'Chullin 91b:2',
      },
      {
        verse: '"Go now, see whether it is well with your brothers."',
        he: '״לֶךְ נָא רְאֵה אֶת שְׁלוֹם אַחֶיךָ״',
        source: 'Genesis 37:14',
        sage: 'The Rabbis',
        why: 'Yaakov sent Yosef at an hour when he could actually see his brothers — that is, by day.',
        ref: 'Chullin 91b:3',
      },
      {
        verse: '"And the sun rose for him as he passed over Penuel."',
        he: '״וַיִּזְרַח לוֹ הַשֶּׁמֶשׁ כַּאֲשֶׁר עָבַר אֶת פְּנוּאֵל״',
        source: 'Genesis 32:32',
        sage: 'Rav',
        why: 'Yaakov stayed put all night and only moved at sunrise.',
        ref: 'Chullin 91b:4',
      },
    ];

    const nightList = $('night-list');
    let nightSolved = 0;
    const usedSages = new Set<string>();
    const allChips: HTMLButtonElement[] = [];

    function refreshChips() {
      allChips.forEach((c) => {
        if (c.dataset.locked === '1') return;
        c.disabled = usedSages.has(c.dataset.sage || '');
      });
    }

    if (nightList) {
      NIGHT.forEach((n) => {
        const card = document.createElement('div');
        card.className = 'night-card';
        card.innerHTML = `
          <p class="he-inline text-base !text-[#f0b429]" dir="rtl" lang="he">${n.he}</p>
          <p class="mt-1 text-xs !text-[#c9c4e2]">${n.verse} <span class="!text-[#6f6a93]">${n.source}</span></p>
          <div class="mt-2 flex flex-wrap gap-2"></div>
          <p class="grip-why hidden"></p>`;
        const row = card.querySelector('div') as HTMLElement;
        const why = card.querySelector('.grip-why') as HTMLElement;
        NIGHT.map((x) => x.sage).forEach((sage) => {
          const chip = document.createElement('button');
          chip.className = 'sage-chip';
          chip.textContent = sage;
          chip.dataset.sage = sage;
          chip.addEventListener('click', () => {
            if (sage === n.sage) {
              chip.classList.add('ok-mark');
              usedSages.add(sage);
              Array.from(row.children).forEach((c) => {
                const el = c as HTMLButtonElement;
                el.disabled = true;
                el.dataset.locked = '1';
              });
              why.innerHTML = `${n.why} <span class="!text-[#6f6a93]">(${n.ref})</span>`;
              why.classList.remove('hidden');
              nightSolved += 1;
              const sc = $('score-night');
              if (sc) sc.textContent = `night ${nightSolved}/5`;
              refreshChips();
              if (nightSolved === NIGHT.length) {
                const d = $('night-done');
                if (d) {
                  d.classList.remove('hidden');
                  d.innerHTML = `
                    <p class="text-xs font-bold uppercase tracking-[0.15em] !text-[#f0b429]">watch ended</p>
                    <p class="mt-2 !text-[#e6d3a8]">Five readings of one rule, and the last of them — Rav's
                    <span class="he-inline" dir="rtl" lang="he">״וַיִּזְרַח לוֹ הַשֶּׁמֶשׁ״</span> — is the verse Rabbi Akiva brought to
                    Rabban Gamliel and Rabbi Yehoshua in the meat market of Emmaus, where the two of them had gone to buy an animal for
                    the wedding feast of Rabban Gamliel's son. His question: did the sun shine <em>for him</em> alone? Did it not shine
                    for the whole world? (Chullin 91b:5)</p>`;
                }
              }
            } else {
              chip.classList.add('no-mark');
              chip.disabled = true;
              chip.dataset.locked = '1';
            }
          });
          row.appendChild(chip);
          allChips.push(chip);
        });
        nightList.appendChild(card);
      });
    }

    // ==================================================================
    // Act III — Measure the Ladder, Chullin 91b:9-11.
    // "olim" = two, "yordim" = two, and when they meet, four; each angel
    // is a Tarshish wide, and Tarshish is 2,000 parasangs by tradition.
    // ==================================================================
    const TARSHISH_OPTS = [500, 1000, 2000, 4000];
    let angels = 2;
    let tarshish = 1000;
    let ladderDone = false;

    function ladderScore() {
      const hits = (angels === 4 ? 1 : 0) + (tarshish === 2000 ? 1 : 0);
      const sc = $('score-ladder');
      if (sc) sc.textContent = `ladder ${hits}/2`;
      return hits;
    }

    function renderLadder() {
      const total = angels * tarshish;
      const tot = $('ladder-total');
      if (tot) tot.textContent = total.toLocaleString('en-US');
      const bar = $('ladder-bar');
      if (bar) bar.style.width = `${Math.min(100, (total / 8000) * 100)}%`;
      const av = $('ang-val');
      if (av) av.textContent = String(angels);
      const hint = $('ladder-hint');
      const hits = ladderScore();
      if (hint) {
        if (hits === 2) {
          hint.innerHTML =
            '<span class="!text-[#9fd8b6]">Eight thousand parasangs — the width of Yaakov\'s ladder (Chullin 91b:9–10).</span>';
        } else if (total === 8000) {
          hint.innerHTML =
            '<span class="!text-[#e0a58f]">Right number, wrong derivation. The baraita counts the angels and sizes them separately.</span>';
        } else {
          hint.innerHTML = '<span class="!text-[#9b96bd]">Two dials, one product. The baraita\'s number is 8,000.</span>';
        }
      }
      if (hits === 2 && !ladderDone) {
        ladderDone = true;
        const rev = $('ladder-reveal');
        if (rev) {
          rev.classList.remove('hidden');
          rev.innerHTML = `
            <div class="rounded-xl border border-[#3d3568] bg-[#151233] p-4 text-sm leading-relaxed !text-[#c9c4e2]">
              <p class="text-xs font-bold uppercase tracking-[0.15em] !text-[#b79cff]">what the angels were doing on it</p>
              <p class="mt-2">Ascending and gazing at his likeness above — <span class="he-inline !text-[#f0b429]" dir="rtl" lang="he">בִּדְיוֹקְנוֹ שֶׁל מַעְלָה</span>,
              engraved on the Throne of Glory — then descending and gazing at the sleeper below. They grew jealous and moved to
              endanger him. Immediately: <span class="he-inline !text-[#f0b429]" dir="rtl" lang="he">״וְהִנֵּה ה׳ נִצָּב עָלָיו״</span>.
              Reish Lakish: were it not written in a verse it could not be said — like a man fanning his son (Chullin 91b:11).</p>
            </div>
            <div class="grid gap-3 sm:grid-cols-3">
              <div class="rounded-xl border border-[#191c36] bg-[#0a0b18] p-3">
                <p class="text-xs font-bold !text-[#b79cff]">the land jumped</p>
                <p class="mt-1 text-xs leading-relaxed !text-[#9b96bd]">He reached Charan, realized he had passed his fathers' place of prayer without praying, and the moment he turned back the earth contracted under him — <span class="he-inline" dir="rtl" lang="he">קְפַצָה לֵיהּ אַרְעָא</span> (91b:6).</p>
              </div>
              <div class="rounded-xl border border-[#191c36] bg-[#0a0b18] p-3">
                <p class="text-xs font-bold !text-[#b79cff]">the sun clocked out early</p>
                <p class="mt-1 text-xs leading-relaxed !text-[#9b96bd]">"This righteous man came to my lodging place and shall leave without staying the night?" — so the sun set ahead of schedule, and years later rose ahead of schedule to repay it (91b:6–7).</p>
              </div>
              <div class="rounded-xl border border-[#191c36] bg-[#0a0b18] p-3">
                <p class="text-xs font-bold !text-[#b79cff]">the stones argued</p>
                <p class="mt-1 text-xs leading-relaxed !text-[#9b96bd]">One verse says stones, the next says stone. Each one said "on me let this righteous man rest his head" — and they were all absorbed into one (91b:8).</p>
              </div>
            </div>`;
        }
      }
    }

    $('ang-minus')?.addEventListener('click', () => {
      angels = Math.max(1, angels - 1);
      renderLadder();
    });
    $('ang-plus')?.addEventListener('click', () => {
      angels = Math.min(8, angels + 1);
      renderLadder();
    });

    const tarshOpts = $('tarshish-opts');
    if (tarshOpts) {
      TARSHISH_OPTS.forEach((v) => {
        const b = document.createElement('button');
        b.className = 'tarsh-btn' + (v === tarshish ? ' picked' : '');
        b.textContent = `${v.toLocaleString('en-US')} parasangs`;
        b.addEventListener('click', () => {
          tarshish = v;
          Array.from(tarshOpts.children).forEach((c) => c.classList.remove('picked'));
          b.classList.add('picked');
          renderLadder();
        });
        tarshOpts.appendChild(b);
      });
    }
    renderLadder();

    // ==================================================================
    // Act IV — Kedushah Studio, Chullin 91b:13-18.
    // Rav Chananel in Rav's name: 1 / 1 / 1. The baraita's rule (91b:16):
    // angels do not mention the Name until after three words. The Gemara's
    // emendation: 1 / 2 / 3.
    // ==================================================================
    const FREQS: { he: string; en: string }[] = [
      { he: 'פַּעַם אַחַת בַּיּוֹם', en: 'once a day' },
      { he: 'פַּעַם אַחַת בְּשַׁבָּת', en: 'once a week' },
      { he: 'פַּעַם אַחַת בְּחוֹדֶשׁ', en: 'once a month' },
      { he: 'פַּעַם אַחַת בַּשָּׁנָה', en: 'once a year' },
      { he: 'פַּעַם אַחַת בְּשָׁבוּעַ', en: 'once in seven years' },
      { he: 'פַּעַם אַחַת בְּיוֹבֵל', en: 'once in a Jubilee' },
      { he: 'פַּעַם אַחַת בָּעוֹלָם', en: 'once in the whole history of the world' },
    ];

    let choir = [1, 1, 1];
    let choirDone = false;

    function renderChoir() {
      const rows = $('choir-rows');
      if (!rows) return;
      rows.innerHTML = '';
      const names = ['כַּת א׳', 'כַּת ב׳', 'כַּת ג׳'];
      choir.forEach((n, i) => {
        const row = document.createElement('div');
        row.className = 'choir-row';
        const words: string[] = [];
        for (let k = 0; k < n; k++) words.push('<span class="kadosh-token">קָדוֹשׁ</span>');
        if (i === 2) words.push('<span class="name-token">ה׳ צְבָאוֹת</span>');
        row.innerHTML = `
          <span class="frank w-14 text-sm !text-[#8a7fd0]" dir="rtl" lang="he">${names[i]}</span>
          <button class="dial-btn" data-i="${i}" data-d="-1" aria-label="remove a kadosh from company ${i + 1}">−</button>
          <button class="dial-btn" data-i="${i}" data-d="1" aria-label="add a kadosh to company ${i + 1}">+</button>
          <span class="flex flex-wrap items-center gap-1.5" dir="rtl">${words.join(' ') || '<span class="text-xs !text-[#6f6a93]">— silent —</span>'}</span>`;
        rows.appendChild(row);
      });
      rows.querySelectorAll('button[data-i]').forEach((b) => {
        b.addEventListener('click', () => {
          const el = b as HTMLButtonElement;
          const i = Number(el.dataset.i);
          const d = Number(el.dataset.d);
          choir[i] = Math.max(0, Math.min(4, choir[i] + d));
          renderChoir();
        });
      });
      checkChoir();
    }

    function checkChoir() {
      const v = $('choir-verdict');
      if (!v) return;
      const beforeName = choir[2];
      const ruleName = beforeName === 3;
      const ruleOrder = choir[0] === 1 && choir[1] === 2 && choir[2] === 3;
      const line = (ok: boolean, txt: string) =>
        `<p class="${ok ? '!text-[#9fd8b6]' : '!text-[#e0a58f]'}">${ok ? '✓' : '✗'} ${txt}</p>`;
      let html = line(
        ruleName,
        `The Name falls after <strong>${beforeName}</strong> word${beforeName === 1 ? '' : 's'} in the third company. The baraita allows angels the Name only after three: <span class="he-inline" dir="rtl" lang="he">״קָדוֹשׁ קָדוֹשׁ קָדוֹשׁ ה׳ צְבָאוֹת״</span> (91b:16).`
      );
      html += line(
        ruleOrder,
        `Rav's companies build on each other — one says <span class="he-inline" dir="rtl" lang="he">קָדוֹשׁ</span>, one says <span class="he-inline" dir="rtl" lang="he">קָדוֹשׁ קָדוֹשׁ</span>, one says the whole verse (91b:18).`
      );
      if (ruleName && ruleOrder) {
        html += `<p class="mt-2 !text-[#f4cd76]">That is the Gemara's <span class="he-inline" dir="rtl" lang="he">אֶלָּא</span> — Rav's statement re-cut so the angels never reach the Name too early.</p>`;
      }
      v.innerHTML = html;
      const sc = $('score-choir');
      if (sc) sc.textContent = `kedushah ${ruleName && ruleOrder ? '✓' : '✗'}`;
      if (ruleName && ruleOrder && !choirDone) {
        choirDone = true;
        const coda = $('choir-coda');
        if (coda) {
          coda.classList.remove('hidden');
          coda.innerHTML = `
            <p class="text-xs font-bold uppercase tracking-[0.15em] !text-[#f0b429]">and one more thing about Israel</p>
            <p class="mt-2">Israel name God after <strong>two</strong> words — <span class="he-inline" dir="rtl" lang="he">״שְׁמַע יִשְׂרָאֵל ה׳ אֱלֹהֵינוּ ה׳ אֶחָד״</span> —
            where the angels must wait for three. And the ministering angels do not begin their song above until Israel have begun theirs
            below: <span class="he-inline" dir="rtl" lang="he">״בְּרָן יַחַד כּוֹכְבֵי בֹקֶר״</span>, the morning stars — Israel — and only then
            <span class="he-inline" dir="rtl" lang="he">״וַיָּרִיעוּ כׇּל בְּנֵי אֱלֹהִים״</span> (Job 38:7; Chullin 91b:16–17).</p>
            <p class="mt-2 !text-[#c9c4e2]">Then the daf stops mid-swing. If angels may not say the Name before three words —
            <span class="he-inline !text-[#f0b429]" dir="rtl" lang="he">וְהָאִיכָּא ״בָּרוּךְ״!</span> — what about
            <span class="he-inline" dir="rtl" lang="he">״בָּרוּךְ כְּבוֹד ה׳ מִמְּקוֹמוֹ״</span> (Ezekiel 3:12), where the Name is only the third word?
            That answer waits for 92a.</p>`;
        }
      }
    }

    // A three-tone Kedushah. Audio only on an explicit click.
    let audioCtx: AudioContext | null = null;
    function tone(freq: number, at: number, dur: number) {
      if (!audioCtx) return;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'sine';
      osc.frequency.value = freq;
      gain.gain.setValueAtTime(0.0001, at);
      gain.gain.exponentialRampToValueAtTime(0.16, at + 0.05);
      gain.gain.exponentialRampToValueAtTime(0.0001, at + dur);
      osc.connect(gain).connect(audioCtx.destination);
      osc.start(at);
      osc.stop(at + dur + 0.05);
    }

    $('choir-sing')?.addEventListener('click', () => {
      const AC = window.AudioContext || (window as any).webkitAudioContext;
      if (!audioCtx && AC) audioCtx = new AC();
      const base = [392, 494, 587]; // G4 / B4 / D5 — one chord split three ways
      const rows = Array.from(document.querySelectorAll('.choir-row'));
      let t = audioCtx ? audioCtx.currentTime + 0.05 : 0;
      let delay = 0;
      choir.forEach((n, i) => {
        const tokens = Array.from(rows[i]?.querySelectorAll('.kadosh-token, .name-token') || []);
        tokens.forEach((tok, k) => {
          const when = delay + k * 480;
          window.setTimeout(() => {
            tok.classList.add('kadosh-lit');
            window.setTimeout(() => tok.classList.remove('kadosh-lit'), 420);
          }, when);
          if (audioCtx) tone(base[i], t + when / 1000, 0.4);
        });
        delay += Math.max(1, tokens.length) * 480 + 260;
      });
    });

    $('choir-rav')?.addEventListener('click', () => {
      choir = [1, 1, 1];
      renderChoir();
    });

    const freq = $('freq-slider') as HTMLInputElement | null;
    freq?.addEventListener('input', () => {
      const f = FREQS[Number(freq.value)];
      const he = $('freq-he');
      const en = $('freq-en');
      if (he) he.textContent = f.he;
      if (en) en.textContent = f.en;
    });

    renderChoir();
  </script>
</Layout>
