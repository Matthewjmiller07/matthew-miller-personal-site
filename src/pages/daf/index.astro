---
import Layout from '../../layouts/Layout.astro';
import games from '../../data/daf-yomi/games.json';

const sorted = [...games].sort((a, b) => b.date.localeCompare(a.date));
---

<Layout
  title="Daf Yomi Arcade"
  description="A new tiny game every day, built from the day's Daf Yomi — real cases, real sources, playable in minutes."
>
  <main class="min-h-screen bg-[#0b0e14] !text-slate-100">
    <div class="bg-gradient-to-b from-amber-950/25 to-transparent border-b border-amber-900/20 px-4 py-12 text-center">
      <p class="!text-amber-500/80 text-xs tracking-[0.3em] uppercase mb-3">בס״ד · one daf, one game</p>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight mb-3">🎲 Daf Yomi Arcade</h1>
      <p class="!text-slate-400 max-w-xl mx-auto text-sm leading-relaxed">
        Every day, the Daf Yomi cycle covers one page of Talmud — and every day this page grows
        a new tiny game built from what that daf actually says. Sources via the
        <a href="https://www.sefaria.org" target="_blank" rel="noopener" class="!text-amber-400 hover:underline">Sefaria</a> API.
      </p>
      <p id="todays-daf" class="mt-4 text-xs !text-slate-500"></p>
    </div>

    <div class="max-w-4xl mx-auto px-4 py-10">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {sorted.map((g) => (
          <a
            href={`/daf/${g.slug}`}
            class="group rounded-2xl border border-slate-800 bg-slate-900/50 p-5 hover:border-amber-700/50 hover:bg-slate-900 transition-colors"
          >
            <div class="flex items-start justify-between gap-3">
              <div>
                <div class="text-xs !text-slate-500 mb-1">{g.date} · {g.ref} · <span dir="rtl">{g.heRef}</span></div>
                <div class="text-lg font-bold group-hover:!text-amber-300 transition-colors">{g.emoji} {g.title}</div>
              </div>
            </div>
            <p class="mt-2 text-sm !text-slate-400 leading-snug">{g.tagline}</p>
            <div class="mt-3 text-[11px] uppercase tracking-wider !text-slate-600">{g.mechanic}</div>
          </a>
        ))}
      </div>

      <p class="mt-10 text-center text-xs !text-slate-600">
        New game every daf, God willing. · <a href="/jewish-learning-hub" class="hover:!text-slate-400 underline decoration-slate-700">More Jewish learning projects →</a>
      </p>
    </div>
  </main>

  <script>
    fetch('https://www.sefaria.org/api/calendars')
      .then((r) => r.json())
      .then((d) => {
        const daf = d.calendar_items.find((i) => i.title.en === 'Daf Yomi');
        if (!daf) return;
        const el = document.getElementById('todays-daf');
        el.textContent = `Today's daf: ${daf.displayValue.en} · ${daf.displayValue.he}`;
      })
      .catch(() => {});
  </script>
</Layout>
