---
import Layout from '../layouts/Layout.astro';
const groups = {
  "Bekhorot": [
    {
      "slug": "bekhorot-10",
      "name": "The Donkey Nobody Redeemed",
      "daf": "Bekhorot 10",
      "desc": "Bekhorot 10: a firstborn donkey's whole life, judged by Rabbi Yehuda and two readings of Rabbi Shimon. Sort carcasses between village and market, scrub the donkey's timeline from birth to the cleaver, and balance the scale that decides whether a woman is betrothed with it.",
      "masechet": "Bekhorot"
    },
    {
      "slug": "bekhorot-11",
      "name": "Whose Lamb Is It?",
      "daf": "Bekhorot 11",
      "desc": "Bekhorot 11: count out the coins Rabbi Tarfon asked for, pass lambs, donkeys and grain piles from hand to hand and decide who ends up holding them, then unlock why Rav Naḥman needed both of his inheritance rulings.",
      "masechet": "Bekhorot"
    },
    {
      "slug": "bekhorot-18",
      "name": "The Lambing Pen of Perhaps",
      "daf": "Bekhorot 18",
      "desc": "Bekhorot 18: measure a corpse between two towns, sort lambs into every possible world to find what the kohen is guaranteed, split the fat from the lean with Rabbi Tarfon and Rabbi Akiva, and load the gift tray for Rabbi Meir and Rabbi Yosei.",
      "masechet": "Bekhorot"
    },
    {
      "slug": "bekhorot-19",
      "name": "Two Keys to the Womb",
      "daf": "Bekhorot 19",
      "desc": "Bekhorot 19: drop newborns through three verse-sieves, turn the two keys of a firstborn for Rabbi Tarfon and Rabbi Akiva, fire counterexamples at Ravina, draw Rabbi Yishmael's age lines for an animal bought from a gentile, and find out which majorities the Rabbis follow.",
      "masechet": "Bekhorot"
    },
    {
      "slug": "bekhorot-20",
      "name": "The Goat's First Year",
      "daf": "Bekhorot 20",
      "desc": "Bekhorot 20: find the hidden hinge behind five readings of Rabbi Yishmael and Rabbi Yehoshua, watch a goat's year turn on a ring calendar around Ze'eiri's thirty days, swap the nameplates on the milk dispute, and breed ten kids into the tithe pen within a year.",
      "masechet": "Bekhorot"
    },
    {
      "slug": "bekhorot-21",
      "name": "Under the Rod",
      "daf": "Bekhorot 21",
      "desc": "Bekhorot 21: open the four gates Rabbi Shimon's kid might use to reach the tithe pen, play the Gemara's mnemonic tiles in a tug-of-war between the firstborn and the sacrifices, pick the right expert to read a tinuf, and decode what a silent seller's silence means for Rav, Shmuel and Rabbi Yoḥanan.",
      "masechet": "Bekhorot"
    },
    {
      "slug": "bekhorot-22",
      "name": "When Kind Finds Kind",
      "daf": "Bekhorot 22",
      "desc": "Bekhorot 22: watch a fetus vanish into the majority of a clot, wait for couriers from the Land of Israel to explain three skeins of yarn, test a sealed jar of fish brine in two possible worlds, pour it into a pot and watch nullified impurity wake up, and sort what may be done with a se'a of teruma lost in a hundred.",
      "masechet": "Bekhorot"
    },
    {
      "slug": "bekhorot-23",
      "name": "The Last Eater",
      "daf": "Bekhorot 23",
      "desc": "Bekhorot 23: slide a rotting carcass down a line of eaters to see when it stops being food, rule how nullified impurity does or doesn't wake, find the brine suspicion threshold, and sort which mishna Rav's rule was really about.",
      "masechet": "Bekhorot"
    },
    {
      "slug": "bekhorot-26",
      "name": "Give It to Me",
      "daf": "Bekhorot 26",
      "desc": "Bekhorot 26: run a firstborn nursery while a kohen knocks at the gate asking for the animal too early, rebuild Rava's three disputes over a firstborn's shed wool, find the one tanna who fits the dangling-wool mishna, press a fleece to see which strands stick out, and sort Rabbi Yannai's offerings.",
      "masechet": "Bekhorot"
    },
    {
      "slug": "bekhorot-27",
      "name": "Rav Huna's Cellar",
      "daf": "Bekhorot 27",
      "desc": "Bekhorot 27: sort six real teruma rulings from outside the Land, run Rav Huna's perpetual wine-nullification vat, then decode the firstborn's own-year rule from shana b'shana.",
      "masechet": "Bekhorot"
    },
    {
      "slug": "bekhorot-28",
      "name": "Your Donkey Is Gone, Tarfon",
      "daf": "Bekhorot 28",
      "desc": "Bekhorot 28: test three readings of the firstborn's thirty days against a baraita, rule on blemishes found after slaughter, write the bill, find the judge's hand, and defend Rabbi Tarfon at Yavne.",
      "masechet": "Bekhorot"
    },
    {
      "slug": "bekhorot-29",
      "name": "Buy the Truth, Don't Sell It",
      "daf": "Bekhorot 29",
      "desc": "Bekhorot 29: design Ila's fee so nobody can suspect him, rule on paid judges and paid purification water, pay a carpenter for his idle day, blow your way across a beit haperas, and shop at the suspects' stalls.",
      "masechet": "Bekhorot"
    },
    {
      "slug": "bekhorot-5",
      "name": "Double or Nothing",
      "daf": "Bekhorot 5",
      "desc": "Bekhorot 5: a Roman officer named Kontrokos accuses Moses of cooking the books — a Levite headcount that's short 300 men, a treasury missing half its silver. Audit the census yourself, catch the Sanctuary's secret double-weight coin, then sort mismatched newborn litters and unravel a rabbi's wordplay on Rephidim.",
      "masechet": "Bekhorot"
    },
    {
      "slug": "bekhorot-6",
      "name": "The Et Hunter",
      "daf": "Bekhorot 6",
      "desc": "Bekhorot 6: Shimon HaAmasoni expounded every little 'et' in the Torah — until he reached 'Et the Lord your God you shall fear.' Hunt the particles yourself, build a tower of proofs that milk is kosher and watch which ones crack, then climb a ladder of strange-calf dilemmas the Gemara never quite settles.",
      "masechet": "Bekhorot"
    }
  ],
  "Chullin": [
    {
      "slug": "chullin-105",
      "name": "The Master Said to Me",
      "daf": "Chullin 105",
      "desc": "Chullin 105: survive one Babylonian evening meal. Patrol your fields, wash the right waters the right way, wait out the cheese after meat, guard the crumbs from the angel of poverty, sink the foam, dodge the witchcraft in a tied bundle, and keep your barrel out from under the gutter — while Abaye keeps discovering that every table habit he thought was mere manners is really about demons, blindness, and the evil spirit.",
      "masechet": "Chullin"
    },
    {
      "slug": "chullin-120",
      "name": "The Soul That Drinks",
      "daf": "Chullin 120",
      "desc": "Chullin 120: work the alchemist's bench. Congeal the blood, melt the forbidden fat, dissolve the chametz on Pesach, liquefy a bird carcass over fire and over sun — then stamp the verdict. Three times Reish Lakish reads 'soul' to include the one who drinks, and the Gemara spends the daf blocking every shortcut derivation. Find the stringency that blocks each one, forge the one pair that works, and swing the two exegetical lenses of Rabbi Eliezer and Rabbi Yehoshua.",
      "masechet": "Chullin"
    },
    {
      "slug": "chullin-121",
      "name": "Between Two Gates",
      "daf": "Chullin 121",
      "desc": "Chullin 121: a validly slaughtered animal is still twitching — out of the category of the living, not yet entered the category of the dead. Rule ten real laws at the threshold: food impurity but not carcass impurity, the limb that parts versus the flesh that parts, Abaye's double stringency, and the trap of the invalid slaughter. Probe the bird and the beast for the parts that are 'merely wood,' and judge which gathering of alal carries carcass impurity.",
      "masechet": "Chullin"
    },
    {
      "slug": "chullin-126",
      "name": "A Hair's Breadth",
      "daf": "Chullin 126",
      "desc": "Chullin 126: a dog that ate from a corpse lies dead across the threshold, and four Tannaim rule on whether the house is impure. Slide the dog, widen its neck, flip it around until the judges say what you need. Then fill Rabbi Shimon's two-of-three grid, scratch a thigh bone and a creeping thing's egg until a hair's breadth of opening flips them impure, and go out and see the orifices, sinews, and seams that decide whether a touch can reach the flesh.",
      "masechet": "Chullin"
    },
    {
      "slug": "chullin-131",
      "name": "Called the People?",
      "daf": "Chullin 131",
      "desc": "Chullin 131: a Levite snatches gifts meant for the kohen, and Rav can't decide whether to make him pay — is a Levite called 'the people' who owe the foreleg, jaw, and maw? Work the gift docket on nine real cases, then follow four failed proofs and one conclusive refutation before Mareimar closes the file for good.",
      "masechet": "Chullin"
    },
    {
      "slug": "chullin-71",
      "name": "The Swallowed Ring",
      "daf": "Chullin 71",
      "desc": "You are the posek: rule tamei or tahor on ten real cases of encapsulated impurity from Chullin 71 — the sugya of tumah belu'ah.",
      "masechet": "Chullin"
    },
    {
      "slug": "chullin-72",
      "name": "The Severed Link",
      "daf": "Chullin 72",
      "desc": "Forge four chains of Talmudic reasoning from Chullin 72 — the midwife's decree, the dueling verses, the emerged foreleg, and the hidden place — link by link, in the smithy of Pumbedita.",
      "masechet": "Chullin"
    },
    {
      "slug": "chullin-73",
      "name": "The Phantom Knife",
      "daf": "Chullin 73",
      "desc": "Six scenes from Chullin 73 — the vessel's handle, the emerged foreleg, the dangling limb. Click where the halakhic knife falls: whatever stands to be cut is as though already cut.",
      "masechet": "Chullin"
    },
    {
      "slug": "chullin-74",
      "name": "The Five-Year Lamb",
      "daf": "Chullin 74",
      "desc": "Chullin 74 is the biography of the ben pekuah — the lamb found alive inside its slaughtered mother. Shepherd it from the womb to five years plowing the field: at every waypoint, is it one animal, or part of another?",
      "masechet": "Chullin"
    },
    {
      "slug": "chullin-75",
      "name": "The Herdbook Lens",
      "daf": "Chullin 75",
      "desc": "Chullin 75 breeds a herd out of one womb-born kid — and every posek stamps that herd differently. Swing the lens of Rav Kahana, Shimon Shezuri, R. Yochanan and Rav Mesharshiyya over three generations, seal the fish timeline of Okatzin, and outrun the bear with Rav Ashi's ruling.",
      "masechet": "Chullin"
    },
    {
      "slug": "chullin-76",
      "name": "The Convergence Gauge",
      "daf": "Chullin 76",
      "desc": "Chullin 76: a hind leg cut above the joint is a tereifa — and so is one whose 'convergence of sinews' is removed. But which cords count? Run Abaye's four tests on six specimens, then flip switches on three strands and watch Ameimar and Mar bar Rav Ashi read the same cut two different ways.",
      "masechet": "Chullin"
    },
    {
      "slug": "chullin-77",
      "name": "The Litter Ledger",
      "daf": "Chullin 77",
      "desc": "Chullin 77: a placenta is found after slaughter, or a firstborn drops one before anyone sees the lamb. The mishna rules by rov — the majority. Work Rav Ika's own arithmetic yourself: split a herd into buckets, and watch the halakha follow whichever bucket wins.",
      "masechet": "Chullin"
    },
    {
      "slug": "chullin-78",
      "name": "The Sealed Dockets",
      "daf": "Chullin 78",
      "desc": "Chullin 78 opens perek Oto v'et Beno with a twelve-case verdict table. The verdicts survived; the case files didn't. Read the stamps, hear the witnesses, and set the four dials to reconstruct what happened at the courtyard gate.",
      "masechet": "Chullin"
    },
    {
      "slug": "chullin-79",
      "name": "The Rispak Stables",
      "daf": "Chullin 79",
      "desc": "Chullin 79: is a mule its mother's child, its father's, or both? Rabbi Abba sends you to the stables before dawn — listen to each bray (Abaye's test), read each ear and tail (Rav Pappa's test), and harness only mules that match. Then face the koy at the gate.",
      "masechet": "Chullin"
    },
    {
      "slug": "chullin-80",
      "name": "The Koy Pen",
      "daf": "Chullin 80",
      "desc": "Chullin 80: the koy is a hybrid of a wild deer and a domestic goat — and which parent is which decides everything. Sort six real rulings into the right pen, then meet five sages who can't agree what a koy even is.",
      "masechet": "Chullin"
    },
    {
      "slug": "chullin-81",
      "name": "The Warning Cry",
      "daf": "Chullin 81",
      "desc": "Chullin 81: play the witness. Eight knives, one day — cry the hatra'ah (forewarning) only at the moment, and about the charge, that makes the lashes stick. Hatra'at safek is no warning at all.",
      "masechet": "Chullin"
    },
    {
      "slug": "chullin-84",
      "name": "The Stewpot Ledger",
      "daf": "Chullin 84",
      "desc": "Chullin 84: slide your fortune from a hundred dinars to ten thousand and watch Rabbi Elazar ben Azarya's stewpot fill with vegetables, fish, or meat — then guess the bracket for six purses, diagnose a cup of lukewarm water, and flip five household maxims from Proverbs.",
      "masechet": "Chullin"
    },
    {
      "slug": "chullin-85",
      "name": "The Redacted Rabbis",
      "daf": "Chullin 85",
      "desc": "Chullin 85: the Mishnah says 'the Rabbis' twice — but it's hiding two different sages behind the same word. Read the evidence, unmask the redacted Tanna, catch each one's real exception, and help Rabbi Chiyya outwit the moths in his flax.",
      "masechet": "Chullin"
    },
    {
      "slug": "chullin-86",
      "name": "One Covering for All",
      "daf": "Chullin 86",
      "desc": "Chullin 86: a deaf-mute, an imbecile, or a minor slaughters an animal unsupervised — must someone cover the blood? Fill in Rebbi's real verdict grid, test whether a purity shortcut transfers to forbidden meat, then run a hundred animals through one covering pit and watch Rabbi Yehuda split it in two.",
      "masechet": "Chullin"
    },
    {
      "slug": "chullin-88",
      "name": "Dust and Ashes",
      "daf": "Chullin 88",
      "desc": "Chullin 88: what may you cover slaughtered blood with, and what may you not? Sort sixteen real substances from the mishna and baraita into the right bin, get stranded in the desert and on a ship with no earth in sight, and meet Beit Hillel and Beit Shammai's fight over whether ash even counts as dust.",
      "masechet": "Chullin"
    },
    {
      "slug": "chullin-90",
      "name": "Larger Than Life",
      "daf": "Chullin 90",
      "desc": "Chullin 90: route the sciatic nerve of each offering to the right place on the altar, catch the Sages red-handed exaggerating with the number three hundred across the ash-mound, the golden vine, and the Curtain, then follow the Gemara's own back-and-forth over whether Rabbi Yehuda was certain or just guessing which thigh is forbidden.",
      "masechet": "Chullin"
    },
    {
      "slug": "chullin-91",
      "name": "The Angel Who Never Sang",
      "daf": "Chullin 91",
      "desc": "Chullin 91: stage the angel's grip to find out which thigh Yaakov lost, match five Sages to the five verses that keep a Torah scholar indoors after dark, measure Yaakov's ladder at eight thousand parasangs, and rebuild the angels' Kedushah until the Name finally falls in the right place.",
      "masechet": "Chullin"
    }
  ]
};
---

<Layout title="Daf Yomi Games" description="Playable games for the daily daf — one per masechet and daf.">
  <main class="raw-page">
    <header class="hero">
      <div class="kicker">Daf Yomi</div>
      <h1>Daf Games</h1>
      <p class="sub">A playable game for each daf — scenarios, rulings and dilemmas drawn from the day's sugya.</p>
    </header>
    {Object.entries(groups).map(([mas, items]) => (
      <section>
        <h2>{mas}</h2>
        <div class="grid">
          {items.map((g) => (
            <a class="card" href={`/daf/${g.slug}`}>
              <h3>{g.name}</h3>
              <p class="daf">{g.daf}</p>
              <p class="desc">{g.desc}</p>
            </a>
          ))}
        </div>
      </section>
    ))}
  </main>
  <style>
    .raw-page { max-width: 960px; margin: 0 auto; padding: 2.5rem 1.25rem 4rem; }
    .hero { text-align: center; margin-bottom: 2rem; }
    .kicker { font-size: 1.1rem; color: #d4a017; margin: 0 0 .4rem; font-weight: 700; text-transform: uppercase; letter-spacing: .12em; }
    .hero h1 { font-size: 2.2rem; margin: 0 0 .8rem; }
    .hero .sub { color: #555; line-height: 1.6; max-width: 560px; margin: .5rem auto; }
    section { margin-bottom: 2.2rem; }
    section h2 { font-size: 1.3rem; border-bottom: 2px solid #e8e2d4; padding-bottom: .4rem; margin-bottom: 1rem; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem; }
    .card { background: #fff; border: 1px solid #e8e2d4; border-radius: 12px; padding: 1.1rem 1.2rem; text-decoration: none; transition: border-color .15s; }
    .card:hover { border-color: #d4a017; }
    .card h3 { margin: 0 0 .2rem; font-size: 1.05rem; color: #1d1a14; }
    .card .daf { color: #d4a017; font-weight: 700; font-size: .85rem; margin: 0 0 .5rem; }
    .card .desc { color: #555; font-size: .9rem; line-height: 1.5; margin: 0; }
  </style>
</Layout>