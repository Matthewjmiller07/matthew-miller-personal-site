---
import Layout from '../layouts/Layout.astro';
import FaceTracker from '../components/FaceTracker.tsx';
---

<Layout title="Face Tracking Demo - Matthew Miller" description="Interactive face tracking demo">
    <div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100 dark:from-slate-900 dark:to-slate-800 py-12">
        <div class="container mx-auto px-6">
            <div class="text-center mb-12">
                <h1 class="text-4xl font-bold text-slate-900 dark:text-white mb-4">
                    Face Tracking Demo
                </h1>
                <p class="text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto">
                    Move your cursor around the screen and watch my face follow you! 
                    This uses AI-generated images with different gaze directions.
                </p>
            </div>

            <div class="max-w-4xl mx-auto">
                <!-- Main Demo -->
                <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg p-8 mb-8">
                    <h2 class="text-2xl font-semibold text-slate-900 dark:text-white mb-6 text-center">
                        Interactive Face Tracker
                    </h2>
                    <div class="flex justify-center mb-6">
                        <FaceTracker client:load width={256} height={256} showDebug={true} />
                    </div>
                    <div class="text-center text-sm text-slate-600 dark:text-slate-400">
                        <p>🎯 Move your mouse anywhere on the page</p>
                        <p>📜 Scroll up/down to see eyes follow scroll position</p>
                        <p>📱 Works with touch on mobile devices</p>
                        <p>🔍 Debug info shows current gaze and scroll position</p>
                    </div>
                </div>

                <!-- Technical Details -->
                <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg p-8 mb-8">
                    <h2 class="text-2xl font-semibold text-slate-900 dark:text-white mb-6">
                        How It Works
                    </h2>
                    <div class="grid md:grid-cols-2 gap-6">
                        <div>
                            <h3 class="text-lg font-medium text-slate-900 dark:text-white mb-3">
                                🎨 AI Image Generation
                            </h3>
                            <ul class="space-y-2 text-slate-600 dark:text-slate-400">
                                <li>• Uses Replicate's expression editor model</li>
                                <li>• Generates 9 images with different gaze directions</li>
                                <li>• Pupil X/Y values: -15, 0, 15</li>
                                <li>• Based on my actual profile photo</li>
                            </ul>
                        </div>
                        <div>
                            <h3 class="text-lg font-medium text-slate-900 dark:text-white mb-3">
                                💻 Interactive Tracking
                            </h3>
                            <ul class="space-y-2 text-slate-600 dark:text-slate-400">
                                <li>• React hook tracks cursor position</li>
                                <li>• Maps screen coordinates to gaze angles</li>
                                <li>• <strong>Scroll tracking</strong> - eyes follow page scroll</li>
                                <li>• Smooth transitions between images</li>
                                <li>• Mobile touch support included</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Image Grid -->
                <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg p-8">
                    <h2 class="text-2xl font-semibold text-slate-900 dark:text-white mb-6">
                        Generated Images
                    </h2>
                    <div class="grid grid-cols-3 gap-4">
                        <div class="text-center">
                            <img src="/faces/gaze_px-15_py-15_256.webp" alt="Top Left" class="w-full rounded-lg mb-2" />
                            <p class="text-sm text-slate-600 dark:text-slate-400">Top Left</p>
                        </div>
                        <div class="text-center">
                            <img src="/faces/gaze_px0_py-15_256.webp" alt="Top" class="w-full rounded-lg mb-2" />
                            <p class="text-sm text-slate-600 dark:text-slate-400">Top</p>
                        </div>
                        <div class="text-center">
                            <img src="/faces/gaze_px15_py-15_256.webp" alt="Top Right" class="w-full rounded-lg mb-2" />
                            <p class="text-sm text-slate-600 dark:text-slate-400">Top Right</p>
                        </div>
                        <div class="text-center">
                            <img src="/faces/gaze_px-15_py0_256.webp" alt="Left" class="w-full rounded-lg mb-2" />
                            <p class="text-sm text-slate-600 dark:text-slate-400">Left</p>
                        </div>
                        <div class="text-center">
                            <img src="/faces/gaze_px0_py0_256.webp" alt="Center" class="w-full rounded-lg mb-2" />
                            <p class="text-sm text-slate-600 dark:text-slate-400">Center</p>
                        </div>
                        <div class="text-center">
                            <img src="/faces/gaze_px15_py0_256.webp" alt="Right" class="w-full rounded-lg mb-2" />
                            <p class="text-sm text-slate-600 dark:text-slate-400">Right</p>
                        </div>
                        <div class="text-center">
                            <img src="/faces/gaze_px-15_py15_256.webp" alt="Bottom Left" class="w-full rounded-lg mb-2" />
                            <p class="text-sm text-slate-600 dark:text-slate-400">Bottom Left</p>
                        </div>
                        <div class="text-center">
                            <img src="/faces/gaze_px0_py15_256.webp" alt="Bottom" class="w-full rounded-lg mb-2" />
                            <p class="text-sm text-slate-600 dark:text-slate-400">Bottom</p>
                        </div>
                        <div class="text-center">
                            <img src="/faces/gaze_px15_py15_256.webp" alt="Bottom Right" class="w-full rounded-lg mb-2" />
                            <p class="text-sm text-slate-600 dark:text-slate-400">Bottom Right</p>
                        </div>
                    </div>
                </div>

                <!-- Back to Home -->
                <div class="text-center mt-8">
                    <a href="/" class="inline-flex items-center px-6 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors">
                        ← Back to Homepage
                    </a>
                </div>
            </div>
        </div>
    </div>
</Layout>
