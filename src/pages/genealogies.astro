---
import Layout from '../layouts/Layout.astro';
import people from '../data/genealogies/people.json';

const LINES = [
  { id: 'adam', en: 'Adam & Eve', he: 'אדם וחוה' },
  { id: 'cain', en: 'Line of Cain', he: 'בית קין' },
  { id: 'seth', en: 'Line of Seth', he: 'בית שת' },
  { id: 'japheth', en: 'Sons of Japheth', he: 'בני יפת' },
  { id: 'ham', en: 'Sons of Ham', he: 'בני חם' },
  { id: 'shem', en: 'Sons of Shem', he: 'בני שם' },
];
const SECTORS = [
  { id: 'Jewish', en: 'Jewish' },
  { id: 'Muslim', en: 'Muslim' },
  { id: 'Christian-Arab', en: 'Christian Arab' },
  { id: 'Druze', en: 'Druze' },
];
const nPeople = people.filter((p) => p.kind === 'person').length;
const nPeoples = people.filter((p) => p.kind === 'people').length;
const maxGen = Math.max(...people.map((p) => p.gen));
---

<Layout
  title="The Book of Generations"
  description="Every name in the genealogies of Bereshit and Noach, from Adam to Abram: lifespans, the family tree and the Table of Nations, cross-referenced with 75 years of Israeli baby names and pulled live from Wikipedia."
  image="/images/genealogies/poster.jpg"
  imageAlt="Hebrew names from Genesis glowing over a dark field of stars"
>
<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=Frank+Ruhl+Libre:wght@400;500;700;900&display=swap');
  body:has(.gn) { background: #07070a !important; padding: 0 !important; }
  .gn {
    color-scheme: dark;
    --bg: #07070a; --panel: #111116; --panel2: #18181f; --line: rgba(255,255,255,.09);
    --ink: #f0efec; --muted: #c3c2b7; --faint: #8b8a83; --gold: #f4c46a; --gold-d: rgba(244,196,106,.14);
    /* categorical slots (dark steps), fixed order: lines 1-6, sectors 1-4 */
    --s1: #3987e5; --s2: #d95926; --s3: #199e70; --s4: #c98500; --s5: #d55181; --s6: #008300;
    --display: 'Oswald', 'Arial Narrow', sans-serif; --serif: 'Source Serif 4', Georgia, serif; --heb: 'Frank Ruhl Libre', 'Times New Roman', serif;
    background: var(--bg); color: var(--ink); font-family: var(--serif); min-height: 100vh; overflow-x: clip;
  }
  .gn * { box-sizing: border-box; }
  .gn a { color: inherit; }
  .gn .wrap { max-width: 1240px; margin: 0 auto; padding: 0 16px; }
  .gn h1, .gn h2, .gn h3, .gn .disp { font-family: var(--display); text-transform: uppercase; letter-spacing: .01em; line-height: .98; margin: 0; }
  .gn .he { font-family: var(--heb); direction: rtl; unicode-bidi: isolate; }
  .gn .eyebrow { font-family: var(--display); text-transform: uppercase; letter-spacing: .18em; font-size: .78rem; color: var(--gold); }
  .gn .muted { color: var(--muted); }
  .gn .faint { color: var(--faint); }

  /* hero */
  .gn-hero { position: relative; padding: 72px 0 40px; isolation: isolate; overflow: hidden; }
  .gn-hero::before { content: ''; position: absolute; inset: 0; z-index: -1;
    background: radial-gradient(60% 70% at 70% 30%, rgba(244,196,106,.16), transparent 70%), radial-gradient(50% 60% at 10% 90%, rgba(57,135,229,.12), transparent 70%); }
  .gn-hero .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 40px; align-items: center; }
  .gn-hero h1 { font-size: clamp(2.6rem, 5.4vw, 4.6rem); font-weight: 700; }
  .gn-hero h1 .he { display: block; font-size: .62em; color: var(--gold); text-transform: none; margin-top: 12px; font-weight: 700; }
  .gn-hero p { color: #d8d2c4; font-size: 1.1rem; line-height: 1.6; margin: 20px 0 0; max-width: 34rem; }
  .gn-hero video { width: 100%; aspect-ratio: 16/9; background: #000; border: 1px solid var(--line); display: block; }
  .gn-hero .cap { font-size: .85rem; color: var(--faint); margin-top: 8px; }
  .gn .tiles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); margin-top: 36px; }
  .gn .tile { background: var(--bg); padding: 16px 18px; }
  .gn .tile b { display: block; font-family: var(--display); font-size: clamp(1.6rem, 3.4vw, 2.4rem); font-weight: 600; color: var(--ink); }
  .gn .tile span { font-size: .85rem; color: var(--muted); }

  /* filters */
  .gn .filters { position: sticky; top: var(--navh, 0px); z-index: 20; background: rgba(7,7,10,.94); backdrop-filter: blur(8px); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .gn .filters .wrap { display: flex; flex-wrap: wrap; gap: 10px 18px; align-items: center; padding-top: 10px; padding-bottom: 10px; }
  .gn .fgroup { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .gn .fgroup > label.k { font-family: var(--display); text-transform: uppercase; letter-spacing: .12em; font-size: .7rem; color: var(--faint); margin-right: 2px; }
  .gn .chip { font: 500 .8rem/1 var(--display); letter-spacing: .06em; text-transform: uppercase; padding: 7px 10px; border: 1px solid var(--line); background: var(--panel); color: var(--muted); cursor: pointer; display: inline-flex; gap: 6px; align-items: center; min-height: 32px; }
  .gn .chip[aria-pressed="true"] { border-color: var(--gold); color: var(--ink); background: var(--gold-d); }
  .gn .chip .sw { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
  .gn input[type="search"] { background: var(--panel); border: 1px solid var(--line); color: var(--ink); padding: 7px 10px; font: 400 .95rem var(--serif); width: 190px; min-height: 32px; }
  .gn .range2 { position: relative; width: 190px; height: 32px; }
  .gn .range2 input { position: absolute; inset: 0; width: 100%; pointer-events: none; background: none; -webkit-appearance: none; appearance: none; margin: 0; }
  .gn .range2 input::-webkit-slider-thumb { pointer-events: auto; -webkit-appearance: none; width: 18px; height: 18px; border-radius: 50%; background: var(--gold); border: 2px solid #07070a; cursor: pointer; }
  .gn .range2 input::-moz-range-thumb { pointer-events: auto; width: 16px; height: 16px; border-radius: 50%; background: var(--gold); border: 2px solid #07070a; cursor: pointer; }
  .gn .range2 .track { position: absolute; left: 9px; right: 9px; top: 15px; height: 2px; background: var(--line); }
  .gn .range2 .fill { position: absolute; top: 15px; height: 2px; background: var(--gold); }
  .gn .yrs { font: 500 .85rem var(--display); letter-spacing: .05em; color: var(--ink); min-width: 82px; }
  .gn .reset { background: none; border: none; color: var(--gold); font: 500 .75rem var(--display); text-transform: uppercase; letter-spacing: .12em; cursor: pointer; }

  /* layout */
  .gn section { padding: 56px 0; border-top: 1px solid var(--line); }
  .gn .sec-head { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; margin-bottom: 24px; }
  .gn .sec-head h2 { font-size: clamp(1.9rem, 4.4vw, 3rem); }
  .gn .sec-head p { color: var(--muted); max-width: 36rem; margin: 0; line-height: 1.55; }
  .gn .main { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 28px; align-items: start; }
  .gn .card { background: var(--panel); border: 1px solid var(--line); }
  .gn .legend { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: .85rem; color: var(--muted); margin: 10px 0 0; }
  .gn .legend i { width: 10px; height: 10px; border-radius: 50%; display: inline-block; margin-right: 6px; vertical-align: -1px; }

  /* tree */
  .gn #tree { width: 100%; height: auto; display: block; }
  .gn #tree .lk { fill: none; stroke-width: 1.4; opacity: .55; }
  .gn #tree .lk.sp { stroke-dasharray: 3 4; opacity: .5; }
  .gn #tree .nd { cursor: pointer; }
  .gn #tree .nd circle { stroke: var(--bg); stroke-width: 2; }
  .gn #tree .nd text { font-family: var(--serif); font-size: 17px; fill: var(--muted); }
  .gn #tree .nd text.h { font-family: var(--heb); font-size: 19px; fill: var(--ink); }
  .gn .treebox { overflow-x: auto; }
  @media (max-width: 700px) { .gn #tree { width: 760px; max-width: none; } }
  .gn #tree .nd.dim { opacity: .14; }
  .gn #tree .nd.sel circle { stroke: var(--gold); stroke-width: 3; }
  .gn #tree .nd:hover text, .gn #tree .nd.sel text { fill: var(--gold); }
  .gn #tree .ring { fill: none; stroke: rgba(255,255,255,.05); }
  .gn #tree .ringlbl { font: 500 10px var(--display); fill: var(--faint); letter-spacing: .1em; }

  /* lifespans */
  .gn .amctl { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; margin-bottom: 10px; }
  .gn .amctl input[type="range"] { flex: 1; min-width: 200px; accent-color: var(--gold); }
  .gn .amctl .amv { font: 600 1.4rem var(--display); min-width: 120px; }
  .gn .btn { font: 500 .85rem var(--display); text-transform: uppercase; letter-spacing: .1em; padding: 9px 16px; border: 1px solid var(--gold); background: var(--gold); color: #111; cursor: pointer; min-height: 36px; }
  .gn .btn.ghost { background: transparent; color: var(--gold); }
  .gn #life { width: 100%; height: auto; display: block; }
  .gn #life text { font-family: var(--serif); font-size: 13px; fill: var(--muted); }
  .gn #life .row { cursor: pointer; }
  .gn #life .row:hover text.n { fill: var(--gold); }
  .gn .alive { color: var(--muted); font-size: .95rem; line-height: 1.5; margin-top: 10px; min-height: 3em; }
  .gn .alive b { color: var(--ink); }

  /* leaderboard */
  .gn #board { width: 100%; height: auto; display: block; }
  .gn #board text { font-family: var(--serif); font-size: 14px; fill: var(--muted); }
  .gn #board text.v { fill: var(--ink); font-family: var(--display); font-size: 14px; }
  .gn #board .bar { cursor: pointer; }
  .gn #board .bar:hover rect.hit { fill: rgba(255,255,255,.04); }
  .gn .note { font-size: .85rem; color: var(--faint); line-height: 1.5; margin-top: 10px; }

  /* detail */
  .gn .detail { position: sticky; top: calc(var(--navh, 0px) + var(--fh, 0px) + 12px); max-height: calc(100vh - var(--navh, 0px) - var(--fh, 0px) - 24px); overflow: auto; padding: 22px; }
  .gn .detail.arrive { animation: gnArrive 2.2s ease; }
  @keyframes gnArrive { 0%, 35% { box-shadow: 0 0 0 2px var(--gold), 0 0 40px rgba(244,196,106,.35); } 100% { box-shadow: 0 0 0 0 transparent; } }
  .gn .detail .hname { font-family: var(--heb); font-size: 3.4rem; line-height: 1.1; color: var(--gold); direction: rtl; font-weight: 700; }
  .gn .detail h3 { font-size: 1.8rem; margin-top: 4px; }
  .gn .detail .meta { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0 0; }
  .gn .detail .tag { font: 500 .7rem var(--display); letter-spacing: .12em; text-transform: uppercase; padding: 4px 8px; border: 1px solid var(--line); color: var(--muted); }
  .gn .detail p.nt { line-height: 1.55; margin: 14px 0 0; }
  .gn .detail dl { display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; margin: 16px 0 0; font-size: .92rem; }
  .gn .detail dt { color: var(--faint); font-family: var(--display); text-transform: uppercase; letter-spacing: .08em; font-size: .72rem; padding-top: 3px; }
  .gn .detail dd { margin: 0; }
  .gn .detail .rel a { color: var(--gold); text-decoration: none; cursor: pointer; }
  .gn .detail .rel a:hover { text-decoration: underline; }
  .gn .detail h4 { font: 500 .78rem var(--display); letter-spacing: .16em; text-transform: uppercase; color: var(--gold); margin: 24px 0 8px; padding-top: 16px; border-top: 1px solid var(--line); }
  .gn .verse { font-family: var(--heb); direction: rtl; font-size: 1.15rem; line-height: 1.75; }
  .gn .verse-en { font-size: .92rem; line-height: 1.55; color: var(--muted); margin-top: 8px; }
  .gn .bignum { font: 600 2.4rem var(--display); }
  .gn .caveat { font-size: .85rem; color: #e8c27a; border-left: 2px solid var(--gold); padding-left: 10px; margin-top: 10px; line-height: 1.5; }
  .gn #spark { width: 100%; height: auto; display: block; margin-top: 6px; }
  .gn #spark text { font-family: var(--serif); font-size: 11px; fill: var(--faint); }
  .gn .wiki { display: grid; grid-template-columns: 72px 1fr; gap: 12px; font-size: .9rem; line-height: 1.5; }
  .gn .wiki img { width: 72px; height: 72px; object-fit: cover; border: 1px solid var(--line); }
  .gn .wiki.noimg { grid-template-columns: 1fr; }
  .gn .ppl { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .gn .ppl li { display: grid; grid-template-columns: 40px 1fr; gap: 10px; align-items: center; font-size: .88rem; line-height: 1.35; }
  .gn .ppl img, .gn .ppl .ph { width: 40px; height: 40px; object-fit: cover; border-radius: 50%; background: var(--panel2); }
  .gn .ppl a { text-decoration: none; color: var(--ink); }
  .gn .ppl a:hover { color: var(--gold); }
  .gn .ppl small { color: var(--faint); display: block; }
  .gn .empty { color: var(--faint); font-size: .9rem; }

  /* tooltip */
  .gn .tip { position: fixed; z-index: 50; pointer-events: none; background: #1c1c24; border: 1px solid rgba(255,255,255,.16); padding: 8px 10px; font-size: .85rem; line-height: 1.4; max-width: 260px; opacity: 0; transition: opacity .1s; }
  .gn .tip b { font-family: var(--display); font-weight: 500; letter-spacing: .03em; }

  /* table */
  .gn details.tbl summary { cursor: pointer; font: 500 .8rem var(--display); letter-spacing: .14em; text-transform: uppercase; color: var(--gold); }
  .gn .tblwrap { overflow-x: auto; margin-top: 12px; }
  .gn table { border-collapse: collapse; width: 100%; font-size: .88rem; }
  .gn th, .gn td { text-align: left; padding: 6px 10px; border-bottom: 1px solid var(--line); white-space: nowrap; }
  .gn th { font: 500 .72rem var(--display); letter-spacing: .1em; text-transform: uppercase; color: var(--faint); cursor: pointer; }
  .gn td.num { text-align: right; font-variant-numeric: tabular-nums; }
  .gn tr { cursor: pointer; }
  .gn tbody tr:hover td { background: rgba(255,255,255,.03); }

  .gn .sources { font-size: .9rem; line-height: 1.65; color: var(--muted); }
  .gn .sources a { color: var(--gold); }

  @media (max-width: 980px) {
    .gn-hero .grid, .gn .main { grid-template-columns: minmax(0, 1fr); }
    .gn .detail { position: static; max-height: none; }
    .gn .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .gn .filters { position: static; }
  }
  @media (max-width: 560px) {
    .gn input[type="search"], .gn .range2 { width: 100%; }
    .gn .fgroup { width: 100%; }
  }
</style>

<div class="gn">
  <header class="gn-hero">
    <div class="wrap">
      <div class="grid">
        <div>
          <div class="eyebrow">Bereshit · Noach · Genesis 4–11</div>
          <h1>The Book of Generations<span class="he">זֶה סֵפֶר תּוֹלְדֹת אָדָם</span></h1>
          <p>Every name in the genealogies of the first two parashot, from Adam to Abram: who begot whom, how long they lived, and the seventy nations of Noah’s sons. Then the same names in Israel, where some were given to tens of thousands of babies and some to five.</p>
        </div>
        <div>
          <video src="/videos/genealogies-trailer.mp4" poster="/images/genealogies/poster.jpg" controls playsinline preload="metadata"></video>
          <div class="cap">Trailer, 64 seconds. <a href="/videos/genealogies-trailer-vertical.mp4" download>Vertical version</a> for WhatsApp and Reels.</div>
        </div>
      </div>
      <div class="tiles">
        <div class="tile"><b>{nPeople}</b><span>people named</span></div>
        <div class="tile"><b>{nPeoples}</b><span>peoples and clans</span></div>
        <div class="tile"><b>{maxGen}</b><span>generations, Adam to Lot</span></div>
        <div class="tile"><b id="t-babies">–</b><span>Israeli babies with these names, 1949–2024</span></div>
      </div>
    </div>
  </header>

  <div class="filters" role="region" aria-label="Filters">
    <div class="wrap">
      <div class="fgroup"><input type="search" id="f-q" placeholder="Search a name, נח, Ofir…" aria-label="Search names" /></div>
      <div class="fgroup" id="f-parasha"><label class="k">Parasha</label>
        <button class="chip" data-v="all" aria-pressed="true">Both</button>
        <button class="chip" data-v="bereshit" aria-pressed="false">Bereshit</button>
        <button class="chip" data-v="noach" aria-pressed="false">Noach</button>
      </div>
      <div class="fgroup" id="f-line"><label class="k">Line</label>
        {LINES.map((l, i) => <button class="chip" data-v={l.id} aria-pressed="true"><span class="sw" style={`background:var(--s${i + 1})`}></span>{l.en.replace('Line of ', '').replace('Sons of ', '')}</button>)}
      </div>
      <div class="fgroup" id="f-kind"><label class="k">Show</label>
        <button class="chip" data-v="person" aria-pressed="true">People</button>
        <button class="chip" data-v="people" aria-pressed="true">Nations</button>
        <button class="chip" data-v="israel" aria-pressed="false">Named in Israel only</button>
      </div>
      <div class="fgroup" id="f-sector"><label class="k">Israel</label>
        {SECTORS.map((s, i) => <button class="chip" data-v={s.id} aria-pressed="true"><span class="sw" style={`background:var(--s${i + 1})`}></span>{s.en}</button>)}
      </div>
      <div class="fgroup" id="f-sex"><label class="k">Babies</label>
        <button class="chip" data-v="all" aria-pressed="true">All</button>
        <button class="chip" data-v="M" aria-pressed="false">Boys</button>
        <button class="chip" data-v="F" aria-pressed="false">Girls</button>
      </div>
      <div class="fgroup"><label class="k">Born</label>
        <div class="range2"><div class="track"></div><div class="fill" id="f-fill"></div>
          <input type="range" id="f-y0" min="1949" max="2024" value="1949" aria-label="From year" />
          <input type="range" id="f-y1" min="1949" max="2024" value="2024" aria-label="To year" />
        </div>
        <span class="yrs" id="f-yrs">1949–2024</span>
      </div>
      <button class="reset" id="f-reset">Reset</button>
    </div>
  </div>

  <div class="wrap">
    <div class="main" style="padding-top:40px">
      <div>
        <section style="border-top:0;padding-top:0">
          <div class="sec-head">
            <div><div class="eyebrow">I · The family tree</div><h2>From one name, seventy nations</h2></div>
            <p>Adam at the centre; each ring is a generation. Dot size is how many Israeli babies got the name in the years and groups you’ve filtered. Dashed lines are marriages. Tap a name.</p>
          </div>
          <div class="card treebox" style="padding:8px"><svg id="tree" role="img" aria-label="Radial family tree of Genesis 4 to 11"></svg></div>
          <div class="legend" id="tree-legend">
            {LINES.map((l, i) => <span><i style={`background:var(--s${i + 1})`}></i>{l.en}</span>)}
          </div>
        </section>

        <section>
          <div class="sec-head">
            <div><div class="eyebrow">II · The long lives</div><h2>Who was alive when</h2></div>
            <p>The twenty generations with ages in the text, dated from Creation (Anno Mundi) by adding up the begetting ages. Drag the year, or press play and watch the lifespans shrink after the Flood.</p>
          </div>
          <div class="amctl">
            <button class="btn" id="am-play">Play</button>
            <input type="range" id="am" min="0" max="2200" value="1656" aria-label="Year from Creation" />
            <span class="amv" id="am-v">Year 1656</span>
          </div>
          <div class="card" style="padding:8px"><svg id="life" role="img" aria-label="Lifespans from Adam to Abram"></svg></div>
          <div class="alive" id="alive"></div>
        </section>

        <section>
          <div class="sec-head">
            <div><div class="eyebrow">III · The names came back</div><h2>Genesis in Israel’s birth records</h2></div>
            <p>Babies born in Israel 1949–2024 with each figure’s name, by the filters above. Source: the Central Bureau of Statistics. Names given to fewer than five babies in a year are not counted that year.</p>
          </div>
          <div class="card" style="padding:8px"><svg id="board" role="img" aria-label="Israeli babies per biblical name"></svg></div>
          <div class="note" id="board-note"></div>
          <details class="tbl" style="margin-top:18px">
            <summary>Table of every name</summary>
            <div class="tblwrap"><table id="tbl"><thead></thead><tbody></tbody></table></div>
          </details>
        </section>
      </div>

      <aside class="card detail" id="detail" aria-live="polite"></aside>
    </div>

    <section>
      <div class="sec-head"><div><div class="eyebrow">Sources</div><h2>Where this comes from</h2></div></div>
      <div class="sources">
        <p>Text: Genesis 4–5 and 10–11 from <a href="https://www.sefaria.org/Genesis.5">Sefaria</a> (Miqra according to the Masorah; English from the JPS Tanakh, gender-sensitive edition). Dates from Creation are the plain sum of the begetting ages in the Masoretic text, the reckoning of Seder Olam: the Flood in 1656, Abram born 1948. The Septuagint and Samaritan texts give different ages.</p>
        <p>Israeli names: <a href="https://www.cbs.gov.il/he/mediarelease/DocLib/2025/391/11_25_391t1.xlsx">Central Bureau of Statistics, release 391/2025</a>, names of babies born in Israel 1949–2024 by population group and sex, via the CC0 <a href="https://github.com/aviezerl/babynamesIL">babynamesIL</a> package by Aviezer Lifshitz. Yearly counts only include a name in years when five or more babies got it; all-time totals include every registration. Names are matched by Hebrew spelling, so homographs are flagged where the data is clearly a different name (Saba for Seba, Maddie for Madai).</p>
        <p>Wikipedia summaries, and the people on Hebrew Wikipedia who carry each name, are fetched live from <a href="https://en.wikipedia.org">Wikipedia</a>, <a href="https://he.wikipedia.org">Hebrew Wikipedia</a> and <a href="https://www.wikidata.org">Wikidata</a> when you open a name. Data and build script: <code>scripts/genealogies/build-data.py</code>.</p>
      </div>
    </section>
  </div>
  <div class="tip" id="tip"></div>
</div>

<script type="application/json" id="gn-people" set:html={JSON.stringify(people)}></script>
<script type="application/json" id="gn-meta" set:html={JSON.stringify({ LINES, SECTORS })}></script>

<script>
  // The site uses Astro's client router: this module runs once per full page load, but the page
  // can be swapped in later without a reload (a link from another page, Back). So build the
  // explorer on every astro:page-load that lands here, and drop the old listeners on the way out.
  let teardown: AbortController | null = null;
  function initGenealogies() {
    if (!document.getElementById('gn-people')) return;
    teardown?.abort();
    teardown = new AbortController();
    const { signal } = teardown;
    const PEOPLE = JSON.parse(document.getElementById('gn-people').textContent);
    const { LINES, SECTORS } = JSON.parse(document.getElementById('gn-meta').textContent);
    const byId = Object.fromEntries(PEOPLE.map((p) => [p.id, p]));
    const LINE_IDX = Object.fromEntries(LINES.map((l, i) => [l.id, i + 1]));
    const SEC_IDX = Object.fromEntries(SECTORS.map((s, i) => [s.id, i + 1]));
    const lineColor = (id) => `var(--s${LINE_IDX[id]})`;
    const secColor = (id) => `var(--s${SEC_IDX[id]})`;
    const Y0 = 1949, Y1 = 2024;
    const NS = 'http://www.w3.org/2000/svg';
    const fmt = (n) => n.toLocaleString('en-US');
    const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const strip = (s) => s.replace(/[֑-ׇ]/g, '');
    const kids = {};
    PEOPLE.forEach((p) => { if (p.parent) (kids[p.parent] ||= []).push(p.id); });

    const DEFAULT = () => ({ q: '', parasha: 'all', lines: new Set(LINES.map((l) => l.id)), kinds: new Set(['person', 'people']), israelOnly: false,
      sectors: new Set(SECTORS.map((s) => s.id)), sex: 'all', y0: Y0, y1: Y1 });
    let S = DEFAULT();
    let NAMES = null;
    // a link like /genealogies#abel (from the Mega Bible) opens straight on that person
    const linked = byId[(location.hash || '').slice(1)] ? (location.hash || '').slice(1) : null;
    let selected = linked || 'noah';

    // ---------- data helpers
    const groupOk = (key) => { const [sec, sex] = key.split('|'); return S.sectors.has(sec) && (S.sex === 'all' || S.sex === sex); };
    function countSpelling(s) {
      const d = NAMES?.names[s]; if (!d) return 0;
      let t = 0;
      for (const [key, arr] of Object.entries(d.series)) if (groupOk(key)) for (let y = S.y0; y <= S.y1; y++) t += arr[y - Y0];
      return t;
    }
    const uniq = (a) => [...new Set(a)];
    const countPerson = (p, force) => (p.homograph && !force ? 0 : uniq(p.names).reduce((t, s) => t + countSpelling(s), 0));
    function matches(p) {
      if (S.parasha !== 'all' && p.parasha !== S.parasha) return false;
      if (!S.lines.has(p.line)) return false;
      if (!S.kinds.has(p.kind)) return false;
      if (S.israelOnly && !(NAMES && countPerson(p) > 0)) return false;
      if (S.q) {
        const q = S.q.toLowerCase();
        const hay = [p.en, strip(p.he), ...p.names, p.renamed || ''].join(' ').toLowerCase();
        if (!hay.includes(q) && !hay.includes(strip(q))) return false;
      }
      return true;
    }

    // ---------- tooltip
    const tip = document.getElementById('tip');
    function showTip(e, html) {
      tip.innerHTML = html; tip.style.opacity = 1;
      const x = Math.min(e.clientX + 14, innerWidth - tip.offsetWidth - 8), y = Math.min(e.clientY + 14, innerHeight - tip.offsetHeight - 8);
      tip.style.left = x + 'px'; tip.style.top = y + 'px';
    }
    const hideTip = () => { tip.style.opacity = 0; };
    function el(tag, attrs = {}, parent) {
      const n = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(attrs)) n.setAttribute(k, v);
      if (parent) parent.appendChild(n);
      return n;
    }
    function personTip(p) {
      const c = NAMES ? countPerson(p) : null;
      return `<b>${esc(p.en)}</b> <span class="he">${esc(p.he)}</span><br>${esc(p.ref)}` +
        (p.lived ? `<br>Lived ${p.lived} years` : '') + (c != null ? `<br>${fmt(c)} Israeli babies (${S.y0}–${S.y1})` : '');
    }

    // ---------- I. radial tree
    const tree = document.getElementById('tree');
    const TW = 1560, TC = TW / 2, RING = 32;
    let treeNodes = {};
    function layoutTree() {
      // leaf order by DFS from Adam; spouses without parents sit beside their spouse
      const order = [];
      const spouseOf = {};
      PEOPLE.forEach((p) => { if (!p.parent && p.spouse && p.id !== 'adam') (spouseOf[p.spouse] ||= []).push(p.id); });
      const pos = {};
      let leaf = 0;
      function walk(id) {
        const ch = kids[id] || [];
        const sp = (spouseOf[id] || []).filter((x) => x !== 'eve');
        if (!ch.length) { pos[id] = { a: leaf++ }; sp.forEach((s) => (pos[s] = { a: leaf++ })); return; }
        // spouses first, then children
        sp.forEach((s) => (pos[s] = { a: leaf++ }));
        ch.forEach(walk);
        const as = ch.map((c) => pos[c].a);
        pos[id] = { a: (Math.min(...as) + Math.max(...as)) / 2 };
      }
      walk('adam');
      pos.eve = { a: pos.adam.a };
      const N = leaf;
      for (const p of PEOPLE) {
        const o = pos[p.id];
        const ang = (o.a / N) * Math.PI * 2 - Math.PI / 2;
        let r = (p.gen - 1) * RING + (p.gen > 1 ? 40 : 0);
        if (p.id === 'eve') r = 22;
        if (p.id === 'adam') r = 0;
        treeNodes[p.id] = { x: TC + r * Math.cos(ang), y: TC + r * Math.sin(ang), ang, r };
      }
      treeNodes.eve.x = TC + 24; treeNodes.eve.y = TC + 18; treeNodes.adam.x = TC - 10; treeNodes.adam.y = TC - 6;
    }
    function drawTree() {
      tree.innerHTML = '';
      tree.setAttribute('viewBox', `0 0 ${TW} ${TW}`);
      const maxGen = Math.max(...PEOPLE.map((p) => p.gen));
      for (let g = 2; g <= maxGen; g++) {
        const r = (g - 1) * RING + 40;
        el('circle', { class: 'ring', cx: TC, cy: TC, r }, tree);
        if (g % 5 === 0) { const t = el('text', { class: 'ringlbl', x: TC + 4, y: TC - r - 4 }, tree); t.textContent = `GEN ${g}`; }
      }
      const links = el('g', {}, tree), nodes = el('g', {}, tree);
      const counts = Object.fromEntries(PEOPLE.map((p) => [p.id, NAMES ? countPerson(p) : 0]));
      const maxC = Math.max(1, ...Object.values(counts));
      for (const p of PEOPLE) {
        const n = treeNodes[p.id];
        if (p.parent) {
          const a = treeNodes[p.parent];
          // curve: out along the parent's radius, then across
          const rm = (a.r + n.r) / 2;
          const mx = TC + rm * Math.cos(n.ang), my = TC + rm * Math.sin(n.ang);
          el('path', { class: 'lk', d: `M${a.x},${a.y} Q${TC + rm * Math.cos(a.ang)},${TC + rm * Math.sin(a.ang)} ${mx},${my} L${n.x},${n.y}`, stroke: lineColor(p.line), opacity: matches(p) ? .55 : .08 }, links);
        }
        if (p.spouse && !p.parent && byId[p.spouse]) {
          const a = treeNodes[p.spouse];
          el('path', { class: 'lk sp', d: `M${a.x},${a.y} L${n.x},${n.y}`, stroke: lineColor(p.line) }, links);
        }
      }
      for (const p of PEOPLE) {
        const n = treeNodes[p.id];
        const on = matches(p);
        const g = el('g', { class: `nd${on ? '' : ' dim'}${p.id === selected ? ' sel' : ''}`, tabindex: 0, role: 'button', 'aria-label': p.en, 'data-id': p.id }, nodes);
        const rad = 5 + 26 * Math.sqrt(counts[p.id] / maxC);
        el('circle', { cx: n.x, cy: n.y, r: rad, fill: lineColor(p.line), opacity: p.kind === 'people' ? .75 : 1 }, g);
        if (p.id === 'adam' || p.id === 'eve') {
          const t = el('text', { class: 'h', x: n.x, y: n.y + (p.id === 'adam' ? -rad - 6 : rad + 16), 'text-anchor': 'middle' }, g);
          t.textContent = strip(p.he);
        } else {
          // label along the radius, flipped on the left half so it reads upright
          const deg = (n.ang * 180) / Math.PI;
          const left = Math.cos(n.ang) < 0;
          const off = rad + 5;
          const lx = n.x + off * Math.cos(n.ang), ly = n.y + off * Math.sin(n.ang);
          const t = el('text', { class: 'h', x: lx, y: ly, 'dominant-baseline': 'middle', 'text-anchor': left ? 'end' : 'start',
            transform: `rotate(${left ? deg + 180 : deg} ${lx} ${ly})` }, g);
          t.textContent = strip(p.he).replace(/^ה(?=[א-ת]{3,}י$)/, '');
          if (!kids[p.id]) {
            const t2 = el('tspan', { class: 'en', dx: 6 }, t);
            t2.setAttribute('style', 'font-family:var(--serif);font-size:15px;fill:var(--faint)');
            t2.textContent = p.en.replace(/ \(.*\)/, '');
          }
        }
        g.addEventListener('click', () => select(p.id));
        g.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); select(p.id); } });
        g.addEventListener('mousemove', (e) => showTip(e, personTip(p)));
        g.addEventListener('mouseleave', hideTip);
      }
    }

    // ---------- II. lifespans
    const life = document.getElementById('life');
    const LIFERS = PEOPLE.filter((p) => p.born != null && p.died != null).sort((a, b) => a.born - b.born);
    let LW = 1000, LML = 120;
    const LMR = 34, ROWH = 24, LMT = 30;
    const AMMAX = 2200;
    const ax = (y) => LML + (y / AMMAX) * (LW - LML - LMR);
    let amYear = 1656;
    function drawLife() {
      life.innerHTML = '';
      LW = Math.max(320, life.parentElement.clientWidth - 16); LML = LW < 600 ? 84 : 120;
      const H = LMT + LIFERS.length * ROWH + 26;
      life.setAttribute('viewBox', `0 0 ${LW} ${H}`);
      for (let y = 0; y <= AMMAX; y += 200) {
        el('line', { x1: ax(y), x2: ax(y), y1: LMT - 6, y2: H - 22, stroke: 'rgba(255,255,255,.06)' }, life);
        const t = el('text', { x: ax(y), y: H - 6, 'text-anchor': 'middle' }, life); t.textContent = y;
      }
      for (const [y, label] of [[1656, 'The Flood'], [1996, 'Babel']]) {
        el('line', { x1: ax(y), x2: ax(y), y1: LMT - 14, y2: H - 22, stroke: '#9ec5f4', 'stroke-dasharray': '4 4', opacity: .6 }, life);
        const t = el('text', { x: ax(y) + (y === 1656 ? -4 : 4), y: LMT - 16, 'text-anchor': y === 1656 ? 'end' : 'start' }, life); t.textContent = label; t.setAttribute('style', 'fill:#9ec5f4');
      }
      LIFERS.forEach((p, i) => {
        const y = LMT + i * ROWH;
        const on = matches(p);
        const alive = amYear >= p.born && amYear <= p.died;
        const g = el('g', { class: 'row', opacity: on ? 1 : .2, 'data-id': p.id }, life);
        el('rect', { x: 0, y, width: LW, height: ROWH, fill: p.id === selected ? 'rgba(244,196,106,.08)' : 'transparent' }, g);
        const n = el('text', { class: 'n', x: LML - 8, y: y + ROWH / 2, 'text-anchor': 'end', 'dominant-baseline': 'middle' }, g);
        n.textContent = p.en.replace(/ \(.*\)/, '');
        if (alive) n.setAttribute('style', 'fill:var(--ink)');
        el('rect', { x: ax(p.born), y: y + 5, width: Math.max(2, ax(p.died) - ax(p.born)), height: ROWH - 10, rx: 4, fill: lineColor(p.line), opacity: alive ? 1 : .45 }, g);
        if (p.begat) el('circle', { cx: ax(p.born + p.begat), cy: y + ROWH / 2, r: 3, fill: 'var(--bg)' }, g);
        const v = el('text', { x: ax(p.died) + 5, y: y + ROWH / 2, 'dominant-baseline': 'middle' }, g);
        v.textContent = p.lived;
        g.addEventListener('click', () => select(p.id));
        g.addEventListener('mousemove', (e) => showTip(e, `<b>${esc(p.en)}</b> <span class="he">${esc(p.he)}</span><br>Born ${p.born}, died ${p.died} from Creation<br>Lived ${p.lived} years${p.begat ? `; father at ${p.begat}` : ''}`));
        g.addEventListener('mouseleave', hideTip);
      });
      el('line', { x1: ax(amYear), x2: ax(amYear), y1: LMT - 4, y2: H - 22, stroke: 'var(--gold)', 'stroke-width': 2 }, life);
      const alive = LIFERS.filter((p) => amYear >= p.born && amYear <= p.died);
      const label = amYear === 1656 ? ' — the year of the Flood' : amYear === 1948 ? ' — Abram is born' : '';
      document.getElementById('am-v').textContent = `Year ${amYear}`;
      document.getElementById('alive').innerHTML = alive.length
        ? `<b>${alive.length} alive in year ${amYear}${label}:</b> ${alive.map((p) => `${esc(p.en.replace(/ \(.*\)/, ''))} (${amYear - p.born})`).join(', ')}.`
        : `<b>Year ${amYear}${label}:</b> none of the dated generations is alive.`;
    }
    const am = document.getElementById('am');
    am.addEventListener('input', () => { amYear = +am.value; drawLife(); });
    let playing = null;
    document.getElementById('am-play').addEventListener('click', (e) => {
      if (playing) { clearInterval(playing); playing = null; e.target.textContent = 'Play'; return; }
      if (amYear >= AMMAX) amYear = 0;
      e.target.textContent = 'Pause';
      playing = setInterval(() => {
        amYear = Math.min(AMMAX, amYear + 8); am.value = amYear; drawLife();
        if (amYear >= AMMAX) { clearInterval(playing); playing = null; e.target.textContent = 'Play'; }
      }, 40);
    });

    // ---------- III. leaderboard
    const board = document.getElementById('board');
    function drawBoard() {
      board.innerHTML = '';
      if (!NAMES) return;
      // one bar per spelling-group, so the two Enochs don't double-count
      const seen = new Map();
      for (const p of PEOPLE) {
        if (!matches(p)) continue;
        const key = uniq(p.names).sort().join('+');
        if (!key) continue;
        const c = countPerson(p);
        if (!c) continue;
        if (seen.has(key)) seen.get(key).people.push(p); else seen.set(key, { people: [p], c });
      }
      const rows = [...seen.values()].sort((a, b) => b.c - a.c).slice(0, 30);
      const BW = Math.max(320, board.parentElement.clientWidth - 16), ML = Math.min(250, Math.round(BW * .42)), MR = 64, RH = 28;
      const H = Math.max(60, rows.length * RH + 10);
      board.setAttribute('viewBox', `0 0 ${BW} ${H}`);
      if (!rows.length) { const t = el('text', { x: 16, y: 34 }, board); t.textContent = 'No names match these filters.'; }
      const max = Math.max(1, ...rows.map((r) => r.c));
      rows.forEach((r, i) => {
        const p = r.people[0], y = 5 + i * RH;
        const g = el('g', { class: 'bar', 'data-id': p.id }, board);
        el('rect', { class: 'hit', x: 0, y, width: BW, height: RH, fill: 'transparent' }, g);
        const label = r.people.map((q) => q.en.replace(/ \(.*\)/, '')).filter((v, k, a) => a.indexOf(v) === k).join(' / ');
        const t = el('text', { x: ML - 10, y: y + RH / 2, 'text-anchor': 'end', 'dominant-baseline': 'middle' }, g);
        t.textContent = `${label}  `;
        const th = el('tspan', { style: 'font-family:var(--heb);fill:var(--ink);font-size:14px' }, t); th.textContent = uniq(p.names).join(' / ');
        const w = Math.max(3, ((BW - ML - MR) * r.c) / max);
        el('rect', { x: ML, y: y + 5, width: w, height: RH - 10, rx: 4, fill: lineColor(p.line) }, g);
        const v = el('text', { class: 'v', x: ML + w + 6, y: y + RH / 2, 'dominant-baseline': 'middle' }, g); v.textContent = fmt(r.c);
        g.addEventListener('click', () => select(p.id));
        g.addEventListener('mousemove', (e) => {
          const d = uniq(p.names).map((s) => NAMES.names[s]).filter(Boolean);
          const peak = d.map((x) => x.peak).filter(Boolean).sort((a, b) => b.n - a.n)[0];
          showTip(e, `<b>${esc(label)}</b><br>${fmt(r.c)} babies, ${S.y0}–${S.y1}` + (peak ? `<br>Peak: ${fmt(peak.n)} in ${peak.year} (${peak.group.replace('|', ' ').replace(' M', ' boys').replace(' F', ' girls')})` : ''));
        });
        g.addEventListener('mouseleave', hideTip);
      });
      const total = rows.reduce((t, r) => t + r.c, 0);
      document.getElementById('board-note').textContent = rows.length
        ? `${rows.length} names, ${fmt(total)} babies in ${S.y0}–${S.y1}. Bars are coloured by the figure’s line in Genesis. Shared spellings (the two Enochs, Tubal and Tubal-cain, the two Shebas) are counted once.`
        : '';
      drawTable();
    }

    // ---------- table view
    let sortKey = 'israel', sortDir = -1;
    function drawTable() {
      const t = document.getElementById('tbl');
      const cols = [['en', 'Name'], ['he', 'Hebrew'], ['ref', 'Verse'], ['line', 'Line'], ['gen', 'Gen.'], ['lived', 'Lived'], ['israel', `Israel ${S.y0}–${S.y1}`]];
      t.tHead.innerHTML = '<tr>' + cols.map(([k, l]) => `<th data-k="${k}">${l}${sortKey === k ? (sortDir > 0 ? ' ▲' : ' ▼') : ''}</th>`).join('') + '</tr>';
      const rows = PEOPLE.filter(matches).map((p) => ({ ...p, israel: NAMES ? countPerson(p) : 0 }));
      rows.sort((a, b) => { const x = a[sortKey] ?? -1, y = b[sortKey] ?? -1; return (x > y ? 1 : x < y ? -1 : 0) * sortDir; });
      t.tBodies[0].innerHTML = rows.map((p) => `<tr data-id="${p.id}"><td>${esc(p.en)}</td><td class="he">${esc(p.he)}</td><td>${esc(p.ref)}</td><td>${esc(LINES[LINE_IDX[p.line] - 1].en)}</td><td class="num">${p.gen}</td><td class="num">${p.lived ?? ''}</td><td class="num">${fmt(p.israel)}</td></tr>`).join('');
      t.tHead.querySelectorAll('th').forEach((th) => th.addEventListener('click', () => { const k = th.dataset.k; sortDir = sortKey === k ? -sortDir : -1; sortKey = k; drawTable(); }));
      t.tBodies[0].querySelectorAll('tr').forEach((tr) => tr.addEventListener('click', () => select(tr.dataset.id)));
    }

    // ---------- detail
    const detail = document.getElementById('detail');
    const cache = new Map();
    const getJSON = (url) => {
      if (!cache.has(url)) cache.set(url, fetch(url, { headers: { Accept: 'application/json' } }).then((r) => { if (!r.ok) throw new Error(r.status); return r.json(); }));
      return cache.get(url);
    };
    const link = (id) => `<a data-go="${id}">${esc(byId[id].en)}</a>`;

    function drawSpark(p) {
      const svg = document.getElementById('spark');
      if (!svg || !NAMES) return;
      svg.innerHTML = '';
      const W = 340, H = 150, ML = 34, MB = 18, MT = 8, MR = 6;
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      const spell = uniq(p.names);
      const bySec = {};
      for (const s of spell) {
        const d = NAMES.names[s]; if (!d) continue;
        for (const [key, arr] of Object.entries(d.series)) {
          if (!groupOk(key)) continue;
          const sec = key.split('|')[0];
          bySec[sec] ||= new Array(Y1 - Y0 + 1).fill(0);
          arr.forEach((v, i) => (bySec[sec][i] += v));
        }
      }
      const secs = SECTORS.map((s) => s.id).filter((s) => bySec[s] && bySec[s].some((v) => v));
      const max = Math.max(1, ...secs.flatMap((s) => bySec[s]));
      const x = (y) => ML + ((y - Y0) / (Y1 - Y0)) * (W - ML - MR), y = (v) => H - MB - (v / max) * (H - MB - MT);
      el('rect', { x: x(S.y0), y: MT, width: Math.max(1, x(S.y1) - x(S.y0)), height: H - MB - MT, fill: 'rgba(244,196,106,.06)' }, svg);
      for (const v of [0, max]) { const t = el('text', { x: ML - 4, y: y(v) + 3, 'text-anchor': 'end' }, svg); t.textContent = fmt(v); el('line', { x1: ML, x2: W - MR, y1: y(v), y2: y(v), stroke: 'rgba(255,255,255,.08)' }, svg); }
      for (const yr of [1950, 1970, 1990, 2010]) { const t = el('text', { x: x(yr), y: H - 4, 'text-anchor': 'middle' }, svg); t.textContent = yr; }
      for (const s of secs) {
        const d = bySec[s].map((v, i) => `${i ? 'L' : 'M'}${x(Y0 + i).toFixed(1)},${y(v).toFixed(1)}`).join('');
        el('path', { d, fill: 'none', stroke: secColor(s), 'stroke-width': 2, 'stroke-linejoin': 'round' }, svg);
      }
      if (!secs.length) { const t = el('text', { x: W / 2, y: H / 2, 'text-anchor': 'middle' }, svg); t.textContent = 'No yearly counts for these filters'; }
      // crosshair
      const cross = el('line', { y1: MT, y2: H - MB, stroke: 'rgba(255,255,255,.4)', opacity: 0 }, svg);
      const hit = el('rect', { x: ML, y: MT, width: W - ML - MR, height: H - MB - MT, fill: 'transparent' }, svg);
      hit.addEventListener('mousemove', (e) => {
        const r = svg.getBoundingClientRect();
        const px = ((e.clientX - r.left) / r.width) * W;
        const yr = Math.round(Y0 + ((px - ML) / (W - ML - MR)) * (Y1 - Y0));
        if (yr < Y0 || yr > Y1) return;
        cross.setAttribute('x1', x(yr)); cross.setAttribute('x2', x(yr)); cross.setAttribute('opacity', 1);
        showTip(e, `<b>${yr}</b><br>` + (secs.length ? secs.map((s) => `<i style="display:inline-block;width:8px;height:8px;border-radius:50%;background:${secColor(s)};margin-right:6px"></i>${SECTORS[SEC_IDX[s] - 1].en}: ${fmt(bySec[s][yr - Y0])}`).join('<br>') : 'No data'));
      });
      hit.addEventListener('mouseleave', () => { cross.setAttribute('opacity', 0); hideTip(); });
      const leg = document.getElementById('spark-legend');
      if (leg) leg.innerHTML = secs.map((s) => `<span><i style="background:${secColor(s)}"></i>${SECTORS[SEC_IDX[s] - 1].en}</span>`).join('');
    }

    function renderDetail() {
      const p = byId[selected];
      const parent = p.parent ? byId[p.parent] : null;
      const ch = (kids[p.id] || []).map(link);
      const spouse = p.spouse ? link(p.spouse) : '';
      const mother = p.mother ? link(p.mother) : '';
      const total = NAMES ? countPerson(p, true) : null;
      const allTime = NAMES ? uniq(p.names).reduce((t, s) => t + Object.values(NAMES.names[s]?.totals || {}).reduce((a, b) => a + b, 0), 0) : null;
      // CBS gives a year only where 5+ babies got the name that year; the rest are in the all-time total alone.
      const yearly = NAMES ? uniq(p.names).reduce((t, s) => t + Object.values(NAMES.names[s]?.series || {}).flat().reduce((a, b) => a + b, 0), 0) : null;
      const unplaced = allTime != null ? allTime - yearly : 0;
      const best = NAMES ? uniq(p.names).map((s) => NAMES.names[s]?.bestRank).filter(Boolean).sort((a, b) => a[0] - b[0])[0] : null;
      const sefaria = `https://www.sefaria.org/${encodeURIComponent(p.ref.replace(/ /g, '_'))}`;
      detail.innerHTML = `
        <div class="hname">${esc(p.he)}</div>
        <h3>${esc(p.en)}</h3>
        <div class="meta"><span class="tag" style="border-color:${lineColor(p.line)}">${esc(LINES[LINE_IDX[p.line] - 1].en)}</span><span class="tag">Parashat ${p.parasha === 'noach' ? 'Noach' : 'Bereshit'}</span><span class="tag">Generation ${p.gen}</span>${p.kind === 'people' ? '<span class="tag">Nation / clan</span>' : ''}</div>
        <p class="nt">${esc(p.note)}</p>
        <dl class="rel">
          <dt>Verse</dt><dd><a href="${sefaria}" target="_blank" rel="noopener">${esc(p.ref)}</a></dd>
          ${parent ? `<dt>Father</dt><dd>${link(parent.id)}</dd>` : ''}
          ${mother ? `<dt>Mother</dt><dd>${mother}</dd>` : ''}
          ${spouse ? `<dt>Married</dt><dd>${spouse}</dd>` : ''}
          ${ch.length ? `<dt>Children</dt><dd>${ch.join(', ')}</dd>` : ''}
          ${p.lived ? `<dt>Lived</dt><dd>${p.lived} years${p.born != null ? ` (year ${p.born}–${p.died} from Creation)` : ''}</dd>` : ''}
          ${p.begat ? `<dt>Fatherhood</dt><dd>at ${p.begat}</dd>` : ''}
        </dl>
        <div class="verse" id="d-verse"></div><div class="verse-en" id="d-verse-en"></div>
        <h4>In Israel</h4>
        ${p.names.length ? `
          <div class="bignum">${total != null ? fmt(total) : '…'}</div>
          <div class="muted" style="font-size:.9rem">babies named <span class="he">${uniq(p.names).join(' / ')}</span>, ${S.y0}–${S.y1}, by your filters${allTime != null ? `. All-time total, every group: ${fmt(allTime)}` : ''}${best ? `. Best rank: #${best[0]} (${best[1].split('|')[0]} ${best[1].split('|')[1] === 'M' ? 'boys' : 'girls'}, ${best[1].split('|')[2]})` : ''}.</div>
          ${unplaced > 0 ? `<div class="note">${yearly === 0 ? `All ${fmt(allTime)}` : `${fmt(unplaced)} of the ${fmt(allTime)}`} came in years with fewer than 5 babies given the name. The CBS doesn't say which years those were, so the filters above can't count them.</div>` : ''}
          <svg id="spark" role="img" aria-label="Births per year by population group"></svg>
          <div class="legend" id="spark-legend"></div>
          ${p.caveat ? `<div class="caveat">${esc(p.caveat)}</div>` : ''}
          ${p.renamed && NAMES ? `<div class="note">Renamed later: <span class="he">${p.renamed}</span> was given to ${fmt(Object.values(NAMES.names[p.renamed]?.totals || {}).reduce((a, b) => a + b, 0))} Israeli babies.</div>` : ''}
        ` : '<div class="empty">The text names this group as a people (“the Jebusite”), not a person, so there is no given name to count.</div>'}
        <h4>Wikipedia</h4><div id="d-wiki"><div class="empty">Loading from Wikipedia…</div></div>
        ${p.names.length ? `<h4>People named <span class="he">${esc(uniq(p.names)[0])}</span></h4><div id="d-ppl"><div class="empty">Asking Hebrew Wikipedia…</div></div>` : ''}
      `;
      detail.querySelectorAll('[data-go]').forEach((a) => a.addEventListener('click', () => select(a.dataset.go)));
      drawSpark(p);
      loadVerse(p);
      loadWiki(p);
      if (p.names.length) loadNamesakes(p);
    }

    const clean = (h) => String(h).replace(/<sup[^>]*>.*?<\/sup>\s*<i class="footnote">.*?<\/i>/g, '').replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ').replace(/\{[ספ]\}/g, '').trim();
    async function loadVerse(p) {
      const id = p.id;
      try {
        const d = await getJSON(`https://www.sefaria.org/api/texts/${encodeURIComponent(p.ref)}?context=0&commentary=0&pad=0`);
        if (selected !== id) return;
        const he = [].concat(d.he).map(clean).slice(0, 4), en = [].concat(d.text).map(clean).slice(0, 4);
        document.getElementById('d-verse').textContent = he.join(' ');
        document.getElementById('d-verse-en').textContent = en.join(' ') + (d.he.length > 4 ? ' …' : '');
      } catch { /* the Sefaria link above still works */ }
    }

    async function loadWiki(p) {
      const box = () => document.getElementById('d-wiki');
      const id = p.id;
      if (!p.wiki) { box().innerHTML = ''; return; }
      try {
        const en = await getJSON(`https://en.wikipedia.org/api/rest_v1/page/summary/${encodeURIComponent(p.wiki.replace(/ /g, '_'))}`);
        if (selected !== id) return;
        let heHtml = '';
        if (en.wikibase_item) {
          try {
            const wd = await getJSON(`https://www.wikidata.org/w/api.php?action=wbgetentities&ids=${en.wikibase_item}&props=sitelinks&sitefilter=hewiki&format=json&origin=*`);
            const heTitle = wd.entities?.[en.wikibase_item]?.sitelinks?.hewiki?.title;
            if (heTitle) {
              const he = await getJSON(`https://he.wikipedia.org/api/rest_v1/page/summary/${encodeURIComponent(heTitle.replace(/ /g, '_'))}`);
              if (he.extract) heHtml = `<p class="he" style="margin:10px 0 0;font-size:1rem;line-height:1.6">${esc(he.extract.slice(0, 320))}${he.extract.length > 320 ? '…' : ''} <a href="${esc(he.content_urls?.desktop?.page)}" target="_blank" rel="noopener" style="color:var(--gold)">ויקיפדיה</a></p>`;
            }
          } catch {}
        }
        if (selected !== id) return;
        const img = en.thumbnail?.source;
        box().innerHTML = `<div class="wiki${img ? '' : ' noimg'}">${img ? `<img src="${esc(img)}" alt="" loading="lazy">` : ''}<div>${esc((en.extract || '').slice(0, 420))}${(en.extract || '').length > 420 ? '…' : ''} <a href="${esc(en.content_urls?.desktop?.page)}" target="_blank" rel="noopener" style="color:var(--gold)">Wikipedia</a></div></div>${heHtml}`;
      } catch {
        if (selected === id) box().innerHTML = `<a href="https://en.wikipedia.org/wiki/${encodeURIComponent(p.wiki.replace(/ /g, '_'))}" target="_blank" rel="noopener" style="color:var(--gold)">Read on Wikipedia</a>`;
      }
    }

    // Namesakes: Hebrew Wikipedia articles titled "<name> <surname>" that Wikidata says are people.
    // (Wikidata's given-name property is too sparse for Israelis to rely on: it missed most of them.)
    async function loadNamesakes(p) {
      const id = p.id;
      const box = () => document.getElementById('d-ppl');
      const spell = uniq(p.names);
      try {
        const lists = await Promise.all(spell.map((s) => getJSON(`https://he.wikipedia.org/w/api.php?action=query&list=allpages&apprefix=${encodeURIComponent(s + ' ')}&apnamespace=0&apfilterredir=nonredirects&aplimit=500&format=json&origin=*`)));
        if (selected !== id) return;
        const titles = uniq(lists.flatMap((d) => (d.query?.allpages || []).map((a) => a.title)));
        let rows = [];
        if (titles.length) {
          const q = `SELECT ?p ?pLabel ?pDescription ?img ?sl ?il ?art WHERE {
            VALUES ?t { ${titles.map((t) => `"${t.replace(/["\\]/g, (c) => '\\' + c)}"@he`).join(' ')} }
            ?art schema:about ?p ; schema:isPartOf <https://he.wikipedia.org/> ; schema:name ?t .
            ?p wdt:P31 wd:Q5 ; wikibase:sitelinks ?sl .
            OPTIONAL { ?p wdt:P18 ?img }
            OPTIONAL { ?p wdt:P27 wd:Q801 . BIND(1 AS ?il) }
            SERVICE wikibase:label { bd:serviceParam wikibase:language "en,he". }
          } ORDER BY DESC(BOUND(?il)) DESC(?sl) LIMIT 30`;
          const key = `sparql:${q}`;
          if (!cache.has(key)) cache.set(key, fetch('https://query.wikidata.org/sparql', {
            method: 'POST',
            headers: { Accept: 'application/sparql-results+json', 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ query: q }),
          }).then((r) => { if (!r.ok) throw new Error(r.status); return r.json(); }));
          const d = await cache.get(key);
          if (selected !== id) return;
          const seen = new Set();
          rows = d.results.bindings.filter((b) => !seen.has(b.p.value) && seen.add(b.p.value)).slice(0, 8);
        }
        const more = `https://he.wikipedia.org/w/index.php?title=${encodeURIComponent('מיוחד:כל_הדפים')}&from=${encodeURIComponent(spell[0] + ' ')}`;
        box().innerHTML = rows.length
          ? `<ul class="ppl">${rows.map((b) => {
              const img = b.img ? `${b.img.value.replace('http://', 'https://')}?width=80` : '';
              return `<li>${img ? `<img src="${esc(img)}" alt="" loading="lazy">` : '<span class="ph"></span>'}<a href="${esc(b.art.value)}" target="_blank" rel="noopener">${esc(b.pLabel?.value)}<small>${esc(b.pDescription?.value || '')}</small></a></li>`;
            }).join('')}</ul><div class="note">People with a Hebrew Wikipedia article whose name starts <span class="he">${esc(spell.join(' / '))}</span>, Israelis first, then most-linked. <a href="${more}" target="_blank" rel="noopener" style="color:var(--gold)">All titles</a></div>`
          : `<div class="empty">No one on Hebrew Wikipedia has this first name yet.</div>`;
      } catch {
        if (selected === id) box().innerHTML = `<a href="https://he.wikipedia.org/w/index.php?search=${encodeURIComponent(spell[0])}" target="_blank" rel="noopener" style="color:var(--gold)">Search Hebrew Wikipedia</a>`;
      }
    }

    // ---------- wiring
    function select(id) {
      if (!byId[id]) return;
      selected = id;
      history.replaceState(null, '', `#${id}`);
      tree.querySelectorAll('.nd').forEach((n) => n.classList.toggle('sel', n.dataset.id === id));
      drawLife();
      renderDetail();
      if (innerWidth <= 980) detail.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    let centred = false;
    function renderAll() {
      drawTree(); drawLife(); drawBoard(); renderDetail();
      const box = tree.parentElement;
      if (!centred && box.scrollWidth > box.clientWidth) { box.scrollLeft = (box.scrollWidth - box.clientWidth) / 2; centred = true; }
    }

    function chips(groupId, onClick) {
      document.querySelectorAll(`#${groupId} .chip`).forEach((b) => b.addEventListener('click', () => { onClick(b); syncChips(); renderAll(); }));
    }
    function syncChips() {
      document.querySelectorAll('#f-parasha .chip').forEach((b) => b.setAttribute('aria-pressed', b.dataset.v === S.parasha));
      document.querySelectorAll('#f-line .chip').forEach((b) => b.setAttribute('aria-pressed', S.lines.has(b.dataset.v)));
      document.querySelectorAll('#f-kind .chip').forEach((b) => b.setAttribute('aria-pressed', b.dataset.v === 'israel' ? S.israelOnly : S.kinds.has(b.dataset.v)));
      document.querySelectorAll('#f-sector .chip').forEach((b) => b.setAttribute('aria-pressed', S.sectors.has(b.dataset.v)));
      document.querySelectorAll('#f-sex .chip').forEach((b) => b.setAttribute('aria-pressed', b.dataset.v === S.sex));
      y0i.value = S.y0; y1i.value = S.y1; syncRange();
      document.getElementById('f-q').value = S.q;
    }
    const toggle = (set, v) => { if (set.has(v)) { if (set.size > 1) set.delete(v); } else set.add(v); };
    chips('f-parasha', (b) => (S.parasha = b.dataset.v));
    chips('f-line', (b) => toggle(S.lines, b.dataset.v));
    chips('f-kind', (b) => (b.dataset.v === 'israel' ? (S.israelOnly = !S.israelOnly) : toggle(S.kinds, b.dataset.v)));
    chips('f-sector', (b) => toggle(S.sectors, b.dataset.v));
    chips('f-sex', (b) => (S.sex = b.dataset.v));
    const y0i = document.getElementById('f-y0'), y1i = document.getElementById('f-y1');
    function syncRange() {
      const f = document.getElementById('f-fill');
      const pct = (y) => ((y - Y0) / (Y1 - Y0));
      f.style.left = `calc(9px + (100% - 18px) * ${pct(S.y0)})`; f.style.width = `calc((100% - 18px) * ${pct(S.y1) - pct(S.y0)})`;
      document.getElementById('f-yrs').textContent = S.y0 === S.y1 ? `${S.y0}` : `${S.y0}–${S.y1}`;
    }
    let rangeT;
    for (const inp of [y0i, y1i]) inp.addEventListener('input', () => {
      let a = +y0i.value, b = +y1i.value;
      if (a > b) { if (inp === y0i) a = b; else b = a; y0i.value = a; y1i.value = b; }
      S.y0 = a; S.y1 = b; syncRange();
      clearTimeout(rangeT); rangeT = setTimeout(renderAll, 60);
    });
    let qT;
    document.getElementById('f-q').addEventListener('input', (e) => { S.q = e.target.value.trim(); clearTimeout(qT); qT = setTimeout(renderAll, 120); });
    document.getElementById('f-reset').addEventListener('click', () => { S = DEFAULT(); syncChips(); renderAll(); });

    layoutTree();
    let rzT, lastW = innerWidth;
    addEventListener('resize', () => { if (innerWidth === lastW) return; lastW = innerWidth; clearTimeout(rzT); rzT = setTimeout(() => { drawLife(); drawBoard(); }, 150); }, { signal });
    syncRange();
    renderAll();
    // the site navbar is sticky, and on wide screens so is the filter bar: keep the panel clear of both
    const gn = document.querySelector('.gn'), filtersEl = document.querySelector('.gn .filters');
    function measureBars() {
      const nav = document.querySelector('body > header, header.sticky');
      const navh = nav && /sticky|fixed/.test(getComputedStyle(nav).position) ? nav.offsetHeight : 0;
      const fh = getComputedStyle(filtersEl).position === 'sticky' ? filtersEl.offsetHeight : 0;
      gn.style.setProperty('--navh', navh + 'px'); gn.style.setProperty('--fh', fh + 'px');
      return navh + fh;
    }
    measureBars();
    addEventListener('resize', measureBars, { signal });
    function arrive(flash = true) {
      // jump past the hero to the person: their panel (and their dot in the tree beside it)
      const target = innerWidth <= 980 ? detail : detail.closest('.main');
      const y = target.getBoundingClientRect().top + scrollY - measureBars() - 12;
      scrollTo({ top: Math.max(0, y), behavior: 'auto' });
      if (flash) { detail.classList.remove('arrive'); void detail.offsetWidth; detail.classList.add('arrive'); }
    }
    // the charts above the panel grow when the names data loads; re-aim then, unless the reader has moved
    let reaim = !!linked;
    for (const ev of ['wheel', 'touchmove', 'keydown', 'mousedown']) addEventListener(ev, () => { reaim = false; }, { once: true, passive: true, signal });
    if (linked) requestAnimationFrame(() => arrive());
    addEventListener('hashchange', () => {
      const id = (location.hash || '').slice(1);
      if (byId[id] && id !== selected) { select(id); arrive(); }
    }, { signal });
    fetch('/data/genealogies/names.json').then((r) => r.json()).then((d) => {
      if (signal.aborted) return;  // the reader already left for another page
      NAMES = d;
      const spell = uniq(PEOPLE.filter((p) => !p.homograph).flatMap((p) => p.names));
      const all = spell.reduce((t, s) => t + Object.values(d.names[s]?.totals || {}).reduce((a, b) => a + b, 0), 0);
      document.getElementById('t-babies').textContent = fmt(all);
      renderAll();
      if (reaim) requestAnimationFrame(() => arrive(false));
    });
  }
  document.addEventListener('astro:page-load', initGenealogies);
  document.addEventListener('astro:before-swap', () => teardown?.abort());
</script>
</Layout>
