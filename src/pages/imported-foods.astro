---
import Layout from '../layouts/Layout.astro';
---

<Layout
    title="Israeli Imported Foods Database | Government Food Import Data"
    description="Explore the comprehensive database of imported food products and raw materials in Israel. Search, filter, and analyze import data from the Chief Rabbinate of Israel."
    image="/images/tel-aviv-kosher.png"
    imageAlt="Israeli Imported Foods Database - Government food import data exploration"
>
    <div class="min-h-screen bg-gradient-to-br from-slate-50 to-emerald-50 dark:from-slate-900 dark:to-emerald-900">
        <div class="container mx-auto px-4 py-8">
            {/* Header */}
            <header class="text-center mb-12">
                <h1 class="text-4xl md:text-6xl font-bold text-gray-900 dark:text-white mb-4">
                    Israeli <span class="text-emerald-600 dark:text-emerald-400">Imported Foods</span> Database
                </h1>
                <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
                    Explore the comprehensive database of <strong>imported food products and raw materials</strong> in Israel. 
                    Search, filter, and analyze import data from the Chief Rabbinate of Israel.
                </p>
            </header>

            {/* Dataset Info */}
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 mb-8">
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
                    <div class="text-center">
                        <div class="text-3xl font-bold text-emerald-600 dark:text-emerald-400 mb-2">14.7 MB</div>
                        <div class="text-gray-600 dark:text-gray-300">Dataset Size</div>
                    </div>
                    <div class="text-center">
                        <div class="text-3xl font-bold text-blue-600 dark:text-blue-400 mb-2">CSV</div>
                        <div class="text-gray-600 dark:text-gray-300">Format</div>
                    </div>
                    <div class="text-center">
                        <div class="text-3xl font-bold text-purple-600 dark:text-purple-400 mb-2">Weekly</div>
                        <div class="text-gray-600 dark:text-gray-300">Updates</div>
                    </div>
                    <div class="text-center">
                        <div class="text-3xl font-bold text-orange-600 dark:text-orange-400 mb-2">2020</div>
                        <div class="text-gray-600 dark:text-gray-300">Since</div>
                    </div>
                </div>

                <div class="bg-gray-50 dark:bg-gray-900 rounded-lg p-4">
                    <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Dataset Details</h3>
                    <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">
                        <strong>Source:</strong> Chief Rabbinate of Israel (הרבנות הראשית לישראל)<br>
                        <strong>Description:</strong> List of imported food products and raw materials<br>
                        <strong>Last Updated:</strong> October 30, 2025
                    </p>
                    <div class="flex flex-wrap gap-2">
                        <span class="px-3 py-1 bg-emerald-100 dark:bg-emerald-900 text-emerald-800 dark:text-emerald-200 text-sm rounded">Food Safety</span>
                        <span class="px-3 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 text-sm rounded">Imports</span>
                        <span class="px-3 py-1 bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200 text-sm rounded">Kashrut</span>
                        <span class="px-3 py-1 bg-orange-100 dark:bg-orange-900 text-orange-800 dark:text-orange-200 text-sm rounded">Government Data</span>
                    </div>
                </div>
            </div>

            {/* Search and Filter Section */}
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 mb-8">
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Explore the Data</h2>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Search Products</label>
                        <input type="text" id="search-input" placeholder="Search for food products, ingredients, or companies..." 
                               class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-transparent dark:bg-gray-700 dark:text-white">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Number of Results</label>
                        <select id="limit-select" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-transparent dark:bg-gray-700 dark:text-white">
                            <option value="10">10 results</option>
                            <option value="25">25 results</option>
                            <option value="50">50 results</option>
                            <option value="100">100 results</option>
                        </select>
                    </div>
                </div>

                <div class="flex gap-4">
                    <button id="search-btn" class="px-6 py-2 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 transition-colors">
                        Search Database
                    </button>
                    <button id="reset-btn" class="px-6 py-2 bg-gray-500 text-white rounded-lg hover:bg-gray-600 transition-colors">
                        Reset
                    </button>
                    <button id="export-btn" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                        Export Results
                    </button>
                </div>
            </div>

            {/* Results Section */}
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 mb-8">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Search Results</h2>
                    <div class="text-sm text-gray-600 dark:text-gray-400">
                        <span id="result-count">0</span> products found
                    </div>
                </div>

                {/* Loading State */}
                <div id="loading" class="hidden text-center py-12">
                    <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-emerald-600"></div>
                    <p class="mt-4 text-gray-600 dark:text-gray-400">Loading data from government API...</p>
                </div>

                {/* Error State */}
                <div id="error" class="hidden bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4">
                    <p class="text-red-800 dark:text-red-200">Error loading data. Please try again.</p>
                </div>

                {/* Results Table */}
                <div id="results-container" class="overflow-x-auto">
                    <table id="results-table" class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
                        <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
                            <tr>
                                <th class="px-6 py-3">Product Name</th>
                                <th class="px-6 py-3">Manufacturer</th>
                                <th class="px-6 py-3">Country</th>
                                <th class="px-6 py-3">Kashrut</th>
                                <th class="px-6 py-3">Certificate</th>
                                <th class="px-6 py-3">Importer</th>
                            </tr>
                        </thead>
                        <tbody id="results-tbody">
                            <tr>
                                <td colspan="6" class="px-6 py-8 text-center text-gray-500 dark:text-gray-400">
                                    Enter a search term above to explore the imported foods database
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            {/* Data Visualization Dashboard */}
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 mb-8">
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Data Analytics Dashboard</h2>
                
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
                    {/* Top Countries */}
                    <div>
                        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Top Countries of Origin</h3>
                        <div id="countries-chart" class="bg-gray-50 dark:bg-gray-900 rounded-lg p-4 h-64 flex items-center justify-center">
                            <p class="text-gray-500 dark:text-gray-400">Search data to see country distribution</p>
                        </div>
                    </div>

                    {/* Kashrut Distribution */}
                    <div>
                        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Kashrut Certification Distribution</h3>
                        <div id="kashrut-chart" class="bg-gray-50 dark:bg-gray-900 rounded-lg p-4 h-64 flex items-center justify-center">
                            <p class="text-gray-500 dark:text-gray-400">Search data to see kashrut distribution</p>
                        </div>
                    </div>
                </div>

                {/* Quick Stats */}
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
                    <div class="bg-gray-50 dark:bg-gray-900 rounded-lg p-4 text-center">
                        <div class="text-2xl font-bold text-emerald-600 dark:text-emerald-400" id="unique-countries">0</div>
                        <div class="text-sm text-gray-600 dark:text-gray-400">Unique Countries</div>
                    </div>
                    <div class="bg-gray-50 dark:bg-gray-900 rounded-lg p-4 text-center">
                        <div class="text-2xl font-bold text-blue-600 dark:text-blue-400" id="unique-manufacturers">0</div>
                        <div class="text-sm text-gray-600 dark:text-gray-400">Unique Manufacturers</div>
                    </div>
                    <div class="bg-gray-50 dark:bg-gray-900 rounded-lg p-4 text-center">
                        <div class="text-2xl font-bold text-purple-600 dark:text-purple-400" id="unique-importers">0</div>
                        <div class="text-sm text-gray-600 dark:text-gray-400">Unique Importers</div>
                    </div>
                    <div class="bg-gray-50 dark:bg-gray-900 rounded-lg p-4 text-center">
                        <div class="text-2xl font-bold text-orange-600 dark:text-orange-400" id="avg-expiry">0</div>
                        <div class="text-sm text-gray-600 dark:text-gray-400">Avg. Days to Expiry</div>
                    </div>
                </div>

                {/* Trend Analysis */}
                <div>
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Recent Imports (Last 30 Days)</h3>
                    <div id="recent-imports" class="bg-gray-50 dark:bg-gray-900 rounded-lg p-4">
                        <p class="text-gray-500 dark:text-gray-400">Search data to see recent import trends</p>
                    </div>
                </div>
            </div>

            {/* API Documentation */}
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 mb-8">
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">API Documentation</h2>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <h3 class="font-semibold text-gray-900 dark:text-white mb-3">Base Endpoint</h3>
                        <code class="block bg-gray-100 dark:bg-gray-900 p-3 rounded text-sm">
                            https://data.gov.il/api/3/action/datastore_search
                        </code>
                    </div>
                    
                    <div>
                        <h3 class="font-semibold text-gray-900 dark:text-white mb-3">Resource ID</h3>
                        <code class="block bg-gray-100 dark:bg-gray-900 p-3 rounded text-sm">
                            4cc6c561-5975-4bac-904f-c06489ceeb6d
                        </code>
                    </div>
                </div>

                <div class="mt-6">
                    <h3 class="font-semibold text-gray-900 dark:text-white mb-3">Example Requests</h3>
                    <div class="space-y-3">
                        <div>
                            <p class="text-sm text-gray-600 dark:text-gray-400 mb-1">Get 5 results:</p>
                            <code class="block bg-gray-100 dark:bg-gray-900 p-3 rounded text-xs">
                                https://data.gov.il/api/3/action/datastore_search?resource_id=4cc6c561-5975-4bac-904f-c06489ceeb6d&limit=5
                            </code>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600 dark:text-gray-400 mb-1">Search for 'milk':</p>
                            <code class="block bg-gray-100 dark:bg-gray-900 p-3 rounded text-xs">
                                https://data.gov.il/api/3/action/datastore_search?resource_id=4cc6c561-5975-4bac-904f-c06489ceeb6d&q=milk
                            </code>
                        </div>
                    </div>
                </div>
            </div>

            {/* Information Section */}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
                <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6">
                    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">About This Dataset</h2>
                    <p class="text-gray-600 dark:text-gray-300 mb-4">
                        This dataset contains comprehensive information about imported food products and raw materials 
                        monitored by the Chief Rabbinate of Israel. It includes details about product names, importers, 
                        kashrut certification, and regulatory compliance.
                    </p>
                    <p class="text-gray-600 dark:text-gray-300 mb-4">
                        The data is updated weekly and provides transparency about food imports entering the Israeli market, 
                        helping consumers and businesses make informed decisions about food products.
                    </p>
                    <div class="flex flex-wrap gap-2">
                        <span class="px-3 py-1 bg-emerald-100 dark:bg-emerald-900 text-emerald-800 dark:text-emerald-200 text-sm rounded">Food Safety</span>
                        <span class="px-3 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 text-sm rounded">Regulatory</span>
                        <span class="px-3 py-1 bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200 text-sm rounded">Consumer Protection</span>
                    </div>
                </div>

                <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6">
                    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Data Source</h2>
                    <p class="text-gray-600 dark:text-gray-300 mb-4">
                        <strong>Provider:</strong> Chief Rabbinate of Israel (הרבנות הראשית לישראל)<br>
                        <strong>Portal:</strong> Data.gov.il - Israeli Government Open Data<br>
                        <strong>License:</strong> Open Government License<br>
                        <strong>Format:</strong> CSV (14.7 MB)<br>
                        <strong>Update Frequency:</strong> Weekly (Automatic)
                    </p>
                    <div class="mt-4">
                        <a href="https://data.gov.il/dataset/food_imports" target="_blank" rel="noopener" 
                           class="inline-flex items-center px-4 py-2 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 transition-colors">
                            View Original Dataset
                            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const API_BASE = 'https://data.gov.il/api/3/action/datastore_search';
            const RESOURCE_ID = '4cc6c561-5975-4bac-904f-c06489ceeb6d';
            
            const searchInput = document.getElementById('search-input');
            const limitSelect = document.getElementById('limit-select');
            const searchBtn = document.getElementById('search-btn');
            const resetBtn = document.getElementById('reset-btn');
            const exportBtn = document.getElementById('export-btn');
            const loading = document.getElementById('loading');
            const error = document.getElementById('error');
            const resultsContainer = document.getElementById('results-container');
            const resultsTable = document.getElementById('results-table');
            const resultsTbody = document.getElementById('results-tbody');
            const resultCount = document.getElementById('result-count');

            let currentData = [];

            // Search function
            async function searchData() {
                const query = searchInput.value.trim();
                const limit = limitSelect.value;

                // Show loading
                loading.classList.remove('hidden');
                error.classList.add('hidden');
                resultsTable.classList.add('hidden');

                try {
                    const url = `${API_BASE}?resource_id=${RESOURCE_ID}&limit=${limit}${query ? '&q=' + encodeURIComponent(query) : ''}`;
                    const response = await fetch(url);
                    const data = await response.json();

                    if (data.success && data.result) {
                        currentData = data.result.records;
                        displayResults(currentData);
                        resultCount.textContent = data.result.total;
                    } else {
                        throw new Error('API request failed');
                    }
                } catch (err) {
                    console.error('Error:', err);
                    error.classList.remove('hidden');
                    resultsTable.classList.add('hidden');
                } finally {
                    loading.classList.add('hidden');
                    resultsTable.classList.remove('hidden');
                }
            }

            // Display results
            function displayResults(records) {
                if (records.length === 0) {
                    resultsTbody.innerHTML = `
                        <tr>
                            <td colspan="6" class="px-6 py-8 text-center text-gray-500 dark:text-gray-400">
                                No results found for your search
                            </td>
                        </tr>
                    `;
                    updateVisualizations([]);
                    return;
                }

                resultsTbody.innerHTML = records.map(record => {
                    // Map the actual field names from the API
                    const hebrewName = record.name4 || 'N/A';
                    const englishName = record.name5 || '';
                    const manufacturer = record.name6 || record.name1 || 'N/A';
                    const country = record.name2 || 'N/A';
                    const kashrut = record.name10 || 'N/A';
                    const certificateNum = record.name7 || 'N/A';
                    const importer = record.name1 || 'N/A';
                    const expiryDate = record.name8 || '';
                    const lastUpdated = record.name9 || '';

                    // Display both Hebrew and English names if available
                    const productName = englishName ? `${hebrewName} (${englishName})` : hebrewName;

                    // Color code kashrut status
                    const kashrutClass = kashrut.includes('פרווה') ? 'bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200' : 
                                       kashrut.includes('חלבי') ? 'bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200' :
                                       kashrut.includes('בשרי') ? 'bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200' :
                                       'bg-gray-100 dark:bg-gray-900 text-gray-800 dark:text-gray-200';

                    return `
                        <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600">
                            <td class="px-6 py-4 font-medium text-gray-900 dark:text-white">
                                <div class="max-w-xs">
                                    <div class="font-semibold">${productName}</div>
                                    ${expiryDate ? `<div class="text-xs text-gray-500 dark:text-gray-400 mt-1">Expires: ${expiryDate.split(' ')[0]}</div>` : ''}
                                </div>
                            </td>
                            <td class="px-6 py-4 text-gray-600 dark:text-gray-300">
                                <div class="max-w-xs">${manufacturer}</div>
                            </td>
                            <td class="px-6 py-4">
                                <span class="px-2 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 text-xs rounded">
                                    ${country}
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                <span class="px-2 py-1 ${kashrutClass} text-xs rounded">
                                    ${kashrut}
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                <span class="px-2 py-1 bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200 text-xs rounded font-mono">
                                    ${certificateNum}
                                </span>
                            </td>
                            <td class="px-6 py-4 text-gray-600 dark:text-gray-300">
                                <div class="max-w-xs text-xs">${importer}</div>
                            </td>
                        </tr>
                    `;
                }).join('');

                // Update visualizations
                updateVisualizations(records);
            }

            // Update visualizations
            function updateVisualizations(records) {
                // Calculate statistics
                const countries = {};
                const kashrutTypes = {};
                const manufacturers = new Set();
                const importers = new Set();
                const expiryDates = [];

                records.forEach(record => {
                    // Count countries
                    const country = record.name2 || 'Unknown';
                    countries[country] = (countries[country] || 0) + 1;

                    // Count kashrut types
                    const kashrut = record.name10 || 'Unknown';
                    if (kashrut.includes('פרווה')) {
                        kashrutTypes['Pareve'] = (kashrutTypes['Pareve'] || 0) + 1;
                    } else if (kashrut.includes('חלבי')) {
                        kashrutTypes['Dairy'] = (kashrutTypes['Dairy'] || 0) + 1;
                    } else if (kashrut.includes('בשרי')) {
                        kashrutTypes['Meat'] = (kashrutTypes['Meat'] || 0) + 1;
                    } else {
                        kashrutTypes['Other'] = (kashrutTypes['Other'] || 0) + 1;
                    }

                    // Collect unique values
                    if (record.name6) manufacturers.add(record.name6);
                    if (record.name1) importers.add(record.name1);

                    // Calculate expiry days
                    if (record.name8) {
                        const expiryDate = new Date(record.name8);
                        const today = new Date();
                        const daysToExpiry = Math.ceil((expiryDate - today) / (1000 * 60 * 60 * 24));
                        if (daysToExpiry > 0) {
                            expiryDates.push(daysToExpiry);
                        }
                    }
                });

                // Update stats
                document.getElementById('unique-countries').textContent = Object.keys(countries).length;
                document.getElementById('unique-manufacturers').textContent = manufacturers.size;
                document.getElementById('unique-importers').textContent = importers.size;
                document.getElementById('avg-expiry').textContent = expiryDates.length > 0 ? 
                    Math.round(expiryDates.reduce((a, b) => a + b, 0) / expiryDates.length) : 0;

                // Create country chart
                createBarChart('countries-chart', countries, 'Countries', '#3b82f6');

                // Create kashrut chart
                createPieChart('kashrut-chart', kashrutTypes);

                // Show recent imports
                updateRecentImports(records);
            }

            // Create bar chart
            function createBarChart(elementId, data, title, color) {
                const container = document.getElementById(elementId);
                if (Object.keys(data).length === 0) {
                    container.innerHTML = '<p class="text-gray-500 dark:text-gray-400">No data available</p>';
                    return;
                }

                // Sort and get top 10
                const sortedData = Object.entries(data)
                    .sort(([,a], [,b]) => b - a)
                    .slice(0, 10);

                const maxValue = Math.max(...sortedData.map(([,value]) => value));

                const chartHTML = `
                    <div class="space-y-2">
                        ${sortedData.map(([label, value]) => `
                            <div class="flex items-center">
                                <div class="w-24 text-xs text-gray-600 dark:text-gray-400 truncate">${label}</div>
                                <div class="flex-1 mx-2 bg-gray-200 dark:bg-gray-700 rounded-full h-4">
                                    <div class="h-4 rounded-full" style="width: ${(value / maxValue) * 100}%; background-color: ${color}"></div>
                                </div>
                                <div class="text-xs text-gray-600 dark:text-gray-400 w-8 text-right">${value}</div>
                            </div>
                        `).join('')}
                    </div>
                `;

                container.innerHTML = chartHTML;
            }

            // Create pie chart
            function createPieChart(elementId, data) {
                const container = document.getElementById(elementId);
                if (Object.keys(data).length === 0) {
                    container.innerHTML = '<p class="text-gray-500 dark:text-gray-400">No data available</p>';
                    return;
                }

                const total = Object.values(data).reduce((a, b) => a + b, 0);
                const colors = {
                    'Pareve': '#10b981',
                    'Dairy': '#3b82f6', 
                    'Meat': '#ef4444',
                    'Other': '#6b7280'
                };

                const chartHTML = `
                    <div class="space-y-2">
                        ${Object.entries(data).map(([label, value]) => `
                            <div class="flex items-center">
                                <div class="w-4 h-4 rounded mr-2" style="background-color: ${colors[label] || '#6b7280'}"></div>
                                <div class="flex-1 text-xs text-gray-600 dark:text-gray-400">${label}</div>
                                <div class="text-xs text-gray-600 dark:text-gray-400">${value} (${Math.round((value / total) * 100)}%)</div>
                            </div>
                        `).join('')}
                    </div>
                `;

                container.innerHTML = chartHTML;
            }

            // Update recent imports
            function updateRecentImports(records) {
                const container = document.getElementById('recent-imports');
                if (records.length === 0) {
                    container.innerHTML = '<p class="text-gray-500 dark:text-gray-400">No recent imports</p>';
                    return;
                }

                // Sort by last updated date
                const recentRecords = records
                    .filter(record => record.name9)
                    .sort((a, b) => new Date(b.name9) - new Date(a.name9))
                    .slice(0, 5);

                const recentHTML = `
                    <div class="space-y-2">
                        ${recentRecords.map(record => `
                            <div class="flex justify-between items-center p-2 bg-white dark:bg-gray-800 rounded">
                                <div class="text-sm text-gray-900 dark:text-white">${record.name4 || 'Unknown'}</div>
                                <div class="text-xs text-gray-500 dark:text-gray-400">${record.name9?.split(' ')[0] || 'Unknown'}</div>
                            </div>
                        `).join('')}
                    </div>
                `;

                container.innerHTML = recentHTML;
            }

            // Export function
            function exportData() {
                if (currentData.length === 0) {
                    alert('No data to export');
                    return;
                }

                const csv = [
                    ['Hebrew Name', 'English Name', 'Manufacturer', 'Importer', 'Country', 'Kashrut', 'Certificate', 'Expiry Date', 'Last Updated'],
                    ...currentData.map(record => [
                        record.name4 || '',
                        record.name5 || '',
                        record.name6 || '',
                        record.name1 || '',
                        record.name2 || '',
                        record.name10 || '',
                        record.name7 || '',
                        record.name8 || '',
                        record.name9 || ''
                    ])
                ].map(row => row.map(cell => `"${cell}"`).join(',')).join('\n');

                const blob = new Blob([csv], { type: 'text/csv' });
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = 'imported-foods-export.csv';
                a.click();
                window.URL.revokeObjectURL(url);
            }

            // Event listeners
            searchBtn.addEventListener('click', searchData);
            resetBtn.addEventListener('click', () => {
                searchInput.value = '';
                limitSelect.value = '10';
                resultsTbody.innerHTML = `
                    <tr>
                        <td colspan="4" class="px-6 py-8 text-center text-gray-500 dark:text-gray-400">
                            Enter a search term above to explore the imported foods database
                        </td>
                    </tr>
                `;
                resultCount.textContent = '0';
                currentData = [];
            });
            exportBtn.addEventListener('click', exportData);

            // Enter key search
            searchInput.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                    searchData();
                }
            });
        });
    </script>
</Layout>
