---
import Layout from '../layouts/Layout.astro';
import ClientOnly from '../components/ClientOnly';
import AsciiViewer from '../components/AsciiViewer';
import FaceTracker from '../components/FaceTracker.tsx';
import { raiseAllEyebrows } from '../hooks/useGlobalFaceTracker.ts';
---

<Layout
    title="Matthew Miller | AI, Automation, Analytics & Jewish Studies"
    description="Principal Analyst in AI, Automation & Analytics at G2. Jewish Studies Aficionado. Explore my work in technology, research, and Jewish thought."
>
    <div class="relative isolate overflow-hidden min-h-[calc(100vh-4rem)] flex flex-col items-center justify-center py-8 sm:py-12"> {/* 4rem is approx navbar height */}
        {/* Subtle background gradient or pattern - OPTIONAL */}
        <div class="absolute inset-0 -z-10 bg-gradient-to-br from-bg-light via-slate-100 to-sky-100 dark:from-bg-dark dark:via-slate-800/50 dark:to-cyan-900/30 opacity-50"></div>
        
        <main class="container mx-auto px-6 lg:px-8 text-center">
            <div class="max-w-3xl mx-auto">
                <h1 class="text-6xl font-extrabold tracking-tight text-primary-light dark:text-primary-dark sm:text-8xl lg:text-9xl -mb-4">
                    Matthew <span class="text-accent dark:text-accent-dark flex items-center justify-center">
                        M
                        <span class="relative">
                            ı
                            <a href="/face-demo" class="absolute -top-4 right-0 sm:-top-6 sm:right-0 translate-x-2 sm:translate-x-3 block hover:scale-110 transition-transform duration-200 cursor-pointer">
                                <FaceTracker client:load width={50} height={50} />
                            </a>
                        </span>
                        ller
                    </span>
                </h1>
                <p class="mt-6 text-lg leading-relaxed text-secondary-light dark:text-secondary-dark sm:text-xl max-w-2xl mx-auto">
                    Principal Analyst in AI, Automation & Analytics.
                    <br class="hidden sm:block"/>Jewish Studies Aficionado. Innovator.
                </p>
                
                <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-6">
                    <a href="/about"
                       class="w-full sm:w-auto rounded-md bg-accent px-6 py-3 text-sm font-semibold text-white shadow-md hover:bg-accent-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent transition-all duration-150 ease-in-out transform hover:scale-105">
                        Learn About Me
                    </a>
                    <a href="/projects"
                       class="w-full sm:w-auto group inline-flex items-center justify-center rounded-md px-6 py-3 text-sm font-semibold leading-6 text-primary-light dark:text-primary-dark hover:text-accent dark:hover:text-accent-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent transition-colors duration-150">
                        Explore Projects <span aria-hidden="true" class="ml-1.5 transition-transform group-hover:translate-x-1">→</span>
                    </a>
                </div>

                <div class="mt-10 w-full max-w-3xl mx-auto relative">
                  <style>
                    .tv-frame {
                      position: relative;
                      background: #2a2a2a;
                      border-radius: 10px;
                      padding: 1.5rem;
                      box-shadow: 
                        0 0 0 10px #444,
                        0 30px 30px rgba(0,0,0,0.5),
                        inset 0 0 40px rgba(0,0,0,0.8);
                      transform: perspective(1000px) rotateX(5deg);
                      transition: transform 0.3s ease;
                    }
                    .tv-frame:hover {
                      transform: perspective(1000px) rotateX(0deg);
                    }
                    .tv-screen {
                      position: relative;
                      overflow: hidden;
                      border-radius: 5px;
                      box-shadow: inset 0 0 20px rgba(0,0,0,0.8);
                      border: 1px solid #555;
                    }
                    .tv-stand {
                      position: relative;
                      height: 60px;
                      width: 200px;
                      background: #444;
                      margin: 0 auto;
                      border-radius: 0 0 10px 10px;
                    }
                    .tv-stand:before {
                      content: '';
                      position: absolute;
                      top: 0;
                      left: 50%;
                      transform: translateX(-50%);
                      width: 60px;
                      height: 10px;
                      background: #333;
                      border-radius: 0 0 5px 5px;
                    }
                    .tv-knob {
                      position: absolute;
                      width: 15px;
                      height: 15px;
                      border-radius: 50%;
                      background: #666;
                      bottom: 15px;
                      box-shadow: inset -2px -2px 4px rgba(0,0,0,0.5);
                    }
                    .tv-knob.left { left: 20px; }
                    .tv-knob.right { right: 20px; }
                  </style>
                  <div class="tv-frame">
                    <div class="tv-screen">
                      <iframe
                        src="https://ascii3d.netlify.app/?embed=1&model=https://huggingface.co/matthewjmiller07/my-3d-models/resolve/main/matthew.glb"
                        width="100%"
                        height="500"
                        loading="lazy"
                        class="block w-full h-full border-0"
                        style="background-color: #111827;"
                        allow="fullscreen"
                        title="3D Model Viewer"
                      ></iframe>
                    </div>
                    <div class="tv-knob left"></div>
                    <div class="tv-knob right"></div>
                  </div>
                  <div class="tv-stand"></div>
                </div>

                <div class="mt-10 w-full max-w-3xl mx-auto">
                  <canvas id="kinetic-text" class="w-full block rounded-xl" style="min-height:80px;"></canvas>
                </div>
            </div>
        </main>
    </div>

    <script>
      import { prepareWithSegments, layoutWithLines } from '@chenglou/pretext';

      const canvas = document.getElementById('kinetic-text') as HTMLCanvasElement | null;
      if (canvas) {
        const ctx = canvas.getContext('2d')!;

        // Non-breaking spaces keep multi-word phrases from splitting across lines
        const WORDS = [
          'AI', 'Analytics', 'Jewish Studies', 'Klezmer',
          'TypeScript', 'Torah', 'Automation', 'Innovation',
          'Code', 'Data', 'שלום',
        ];
        const SEP = ' · ';
        const FULL_TEXT = WORDS.join(SEP);
        const FONT_SIZE = 20;
        const LINE_HEIGHT = 52;
        const H_PAD = 28;
        const V_PAD = 22;

        const PALETTE = [
          '#38bdf8', '#818cf8', '#34d399',
          '#fb923c', '#e879f9', '#f472b6', '#fbbf24',
        ];

        interface WordEntry {
          text: string;
          x: number;
          baseY: number;
          phase: number;
          color: string;
        }

        let words: WordEntry[] = [];
        let animId = 0;
        let startTime: number | null = null;
        let mouse = { x: -9999, y: -9999 };
        let dpr = 1;

        function isDark() {
          return document.documentElement.classList.contains('dark');
        }

        function setup() {
          cancelAnimationFrame(animId);
          dpr = window.devicePixelRatio || 1;
          const W = (canvas!.parentElement?.offsetWidth ?? 700);
          const font = `500 ${FONT_SIZE}px Inter, system-ui, sans-serif`;

          // Use pretext to measure exact line layout — no DOM reflow
          const prepared = prepareWithSegments(FULL_TEXT, font);
          const { lines, height } = layoutWithLines(prepared, W - H_PAD * 2, LINE_HEIGHT);

          const canvasH = height + V_PAD * 3;
          canvas!.width = Math.round(W * dpr);
          canvas!.height = Math.round(canvasH * dpr);
          canvas!.style.width = W + 'px';
          canvas!.style.height = canvasH + 'px';
          ctx.scale(dpr, dpr);

          ctx.font = font;
          words = [];
          let colorIdx = 0;

          lines.forEach((line, li) => {
            const baseY = V_PAD * 1.5 + li * LINE_HEIGHT + FONT_SIZE;
            const lineWidth = ctx.measureText(line.text).width;
            let x = (W - lineWidth) / 2;

            // Split on separator to get individual word entries
            const parts = line.text.split(SEP);
            parts.forEach((part, pi) => {
              const token = pi < parts.length - 1 ? part + SEP : part;
              const tokenW = ctx.measureText(token).width;
              words.push({
                text: token,
                x,
                baseY,
                phase: colorIdx * 0.65,
                color: PALETTE[colorIdx % PALETTE.length],
              });
              x += tokenW;
              colorIdx++;
            });
          });

          startTime = null;
          animId = requestAnimationFrame(draw);
        }

        function draw(ts: number) {
          if (!startTime) startTime = ts;
          const t = (ts - startTime) / 1000;
          const W = canvas!.width / dpr;
          const H = canvas!.height / dpr;

          ctx.clearRect(0, 0, W, H);

          // Subtle label
          ctx.save();
          ctx.font = '400 10px "SF Mono", "Fira Code", ui-monospace, monospace';
          ctx.fillStyle = isDark()
            ? 'rgba(148,163,184,0.45)'
            : 'rgba(100,116,139,0.55)';
          ctx.textAlign = 'center';
          ctx.fillText('rendered with @chenglou/pretext · zero dom reflow', W / 2, V_PAD * 0.8);
          ctx.restore();

          // Words with wave + mouse-proximity lift
          ctx.font = `500 ${FONT_SIZE}px Inter, system-ui, sans-serif`;
          ctx.textAlign = 'left';

          words.forEach((w) => {
            const wave = Math.sin(t * 1.4 + w.phase) * 5;
            const cx = w.x + ctx.measureText(w.text).width / 2;
            const dx = cx - mouse.x;
            const dy = w.baseY - mouse.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            const prox = Math.max(0, 1 - dist / 90);
            const y = w.baseY + wave - prox * 10;

            ctx.shadowColor = w.color;
            ctx.shadowBlur = 6 + prox * 14;
            ctx.fillStyle = w.color;

            if (prox > 0.05) {
              ctx.save();
              ctx.translate(cx, y);
              const s = 1 + prox * 0.18;
              ctx.scale(s, s);
              ctx.fillText(w.text, -ctx.measureText(w.text).width / 2, 0);
              ctx.restore();
            } else {
              ctx.fillText(w.text, w.x, y);
            }
            ctx.shadowBlur = 0;
          });

          animId = requestAnimationFrame(draw);
        }

        canvas.addEventListener('mousemove', (e) => {
          const r = canvas!.getBoundingClientRect();
          mouse.x = (e.clientX - r.left);
          mouse.y = (e.clientY - r.top);
        });
        canvas.addEventListener('mouseleave', () => { mouse.x = -9999; mouse.y = -9999; });

        window.addEventListener('resize', setup);
        setup();
      }
    </script>

    <script>
        // Confetti burst on page load
        (function () {
            const canvas = document.createElement('canvas');
            canvas.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:9999;';
            document.body.appendChild(canvas);
            const ctx = canvas.getContext('2d');

            function resize() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }
            resize();
            window.addEventListener('resize', resize);

            const COLORS = ['#38bdf8','#0ea5e9','#6366f1','#a78bfa','#34d399','#fbbf24','#f472b6','#f87171'];
            const PARTICLE_COUNT = 120;
            const particles = [];

            for (let i = 0; i < PARTICLE_COUNT; i++) {
                particles.push({
                    x: Math.random() * canvas.width,
                    y: -10 - Math.random() * 200,
                    w: 8 + Math.random() * 6,
                    h: 4 + Math.random() * 4,
                    color: COLORS[Math.floor(Math.random() * COLORS.length)],
                    angle: Math.random() * Math.PI * 2,
                    spin: (Math.random() - 0.5) * 0.15,
                    vx: (Math.random() - 0.5) * 2.5,
                    vy: 2.5 + Math.random() * 3,
                    alpha: 1,
                });
            }

            let frame;
            let start = null;
            const DURATION = 2800;

            function draw(timestamp) {
                if (!start) start = timestamp;
                const elapsed = timestamp - start;
                ctx.clearRect(0, 0, canvas.width, canvas.height);

                const fadeStart = DURATION * 0.55;
                const fadeProgress = elapsed > fadeStart ? (elapsed - fadeStart) / (DURATION - fadeStart) : 0;
                const globalAlpha = 1 - fadeProgress;

                for (const p of particles) {
                    p.x += p.vx;
                    p.y += p.vy;
                    p.angle += p.spin;
                    p.vy += 0.04;

                    ctx.save();
                    ctx.globalAlpha = globalAlpha;
                    ctx.translate(p.x, p.y);
                    ctx.rotate(p.angle);
                    ctx.fillStyle = p.color;
                    ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
                    ctx.restore();
                }

                if (elapsed < DURATION) {
                    frame = requestAnimationFrame(draw);
                } else {
                    canvas.remove();
                    window.removeEventListener('resize', resize);
                }
            }

            frame = requestAnimationFrame(draw);
        })();

        // Add eyebrow raise to all link hovers
        document.addEventListener('DOMContentLoaded', () => {
            const links = document.querySelectorAll('a[href]');
            
            links.forEach(link => {
                // Skip external links and anchor links
                const href = link.getAttribute('href');
                if (href?.startsWith('http') || href?.startsWith('#')) {
                    return;
                }
                
                link.addEventListener('mouseenter', () => {
                    // Trigger eyebrow raise on face trackers
                    const faceTrackers = document.querySelectorAll('.face-tracker');
                    faceTrackers.forEach(tracker => {
                        // Dispatch custom event to trigger eyebrow raise
                        tracker.dispatchEvent(new CustomEvent('raiseEyebrows'));
                    });
                });
            });
        });
    </script>
</Layout>