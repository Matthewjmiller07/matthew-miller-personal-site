---
import Layout from '../layouts/Layout.astro';
import ClientOnly from '../components/ClientOnly';
import AsciiViewer from '../components/AsciiViewer';
---

<Layout
    title="Matthew Miller | AI, Automation, Analytics & Jewish Studies"
    description="Principal Analyst in AI, Automation & Analytics at G2. Jewish Studies Aficionado. Explore my work in technology, research, and Jewish thought."
>
    <div class="relative isolate overflow-hidden min-h-[calc(100vh-4rem)] flex flex-col items-center justify-center py-8 sm:py-12"> {/* 4rem is approx navbar height */}
        {/* Subtle background gradient or pattern - OPTIONAL */}
        <div class="absolute inset-0 -z-10 bg-gradient-to-br from-bg-light via-slate-100 to-sky-100 dark:from-bg-dark dark:via-slate-800/50 dark:to-cyan-900/30 opacity-50"></div>
        
        <main class="container mx-auto px-6 lg:px-8 text-center">
            <div class="max-w-3xl mx-auto">
                <h1 class="text-4xl font-extrabold tracking-tight text-primary-light dark:text-primary-dark sm:text-6xl lg:text-7xl">
                    Matthew <span class="text-accent dark:text-accent-dark">Miller</span>
                </h1>
                <p class="mt-6 text-lg leading-relaxed text-secondary-light dark:text-secondary-dark sm:text-xl max-w-2xl mx-auto">
                    Principal Analyst in AI, Automation & Analytics.
                    <br class="hidden sm:block"/>Jewish Studies Aficionado. Innovator.
                </p>
                
                <div class="mt-10 w-full max-w-4xl mx-auto">
  <iframe
    src="https://ascii3d.netlify.app/?embed=1&model=https://huggingface.co/matthewjmiller07/my-3d-models/resolve/main/matthew.glb"
    width="100%"
    height="600"
    loading="lazy"
    class="rounded-lg shadow-lg border-0"
  ></iframe>
</div>
                <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-6">
                    <a href="/about"
                       class="w-full sm:w-auto rounded-md bg-accent px-6 py-3 text-sm font-semibold text-white shadow-md hover:bg-accent-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent transition-all duration-150 ease-in-out transform hover:scale-105">
                        Learn About Me
                    </a>
                    <a href="/projects"
                       class="w-full sm:w-auto group inline-flex items-center justify-center rounded-md px-6 py-3 text-sm font-semibold leading-6 text-primary-light dark:text-primary-dark hover:text-accent dark:hover:text-accent-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent transition-colors duration-150">
                        Explore Projects <span aria-hidden="true" class="ml-1.5 transition-transform group-hover:translate-x-1">→</span>
                    </a>
                </div>
            </div>
        </main>
    </div>
</Layout>