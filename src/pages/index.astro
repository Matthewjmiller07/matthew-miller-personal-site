---
import Layout from '../layouts/Layout.astro';
import FaceTracker from '../components/FaceTracker.tsx';
import DioramaHero from '../components/DioramaHero';
import { raiseAllEyebrows } from '../hooks/useGlobalFaceTracker.ts';
---

<Layout
    title="Matthew Miller | AI, Automation, Analytics & Jewish Studies"
    description="Principal Analyst in AI, Automation & Analytics at G2. Jewish Studies Aficionado. Explore my work in technology, research, and Jewish thought."
>
    <div class="relative isolate overflow-hidden min-h-[calc(100vh-4rem)] flex flex-col items-center justify-center max-lg:justify-start py-8 sm:py-12 bg-[#0a0908]"> {/* 4rem is approx navbar height */}
        {/* Cinematic AI diorama hero — bronze scribe's quill, generated via fal.ai */}
        <div class="absolute inset-0 -z-10">
            <DioramaHero client:only="react" />
        </div>
        
        <main class="container mx-auto px-6 lg:px-8 text-center lg:text-left relative max-lg:pt-[13vh]">
            <div class="max-w-3xl mx-auto lg:mx-0">
                <h1 class="text-6xl font-extrabold tracking-tight text-[#f4eee1] sm:text-8xl lg:text-9xl -mb-4">
                    Matthew <span class="text-accent flex items-center justify-center lg:justify-start">
                        M
                        <span class="relative">
                            ı
                            <a href="/face-demo" class="absolute -top-4 right-0 sm:-top-6 sm:right-0 translate-x-2 sm:translate-x-3 block hover:scale-110 transition-transform duration-200 cursor-pointer">
                                <FaceTracker client:load width={50} height={50} />
                            </a>
                        </span>
                        ller
                    </span>
                </h1>
                <p class="mt-6 text-lg leading-relaxed text-[#c9c0ad] sm:text-xl max-w-2xl mx-auto lg:mx-0">
                    Principal Analyst in AI, Automation & Analytics.
                    <br class="hidden sm:block"/>Jewish Studies Aficionado. Innovator.
                </p>
                
                <div class="mt-10 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-6">
                    <a href="/about"
                       class="w-full sm:w-auto rounded-md bg-accent px-6 py-3 text-sm font-semibold text-white shadow-md hover:bg-accent-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent transition-all duration-150 ease-in-out transform hover:scale-105">
                        Learn About Me
                    </a>
                    <a href="/projects"
                       class="w-full sm:w-auto group inline-flex items-center justify-center rounded-md px-6 py-3 text-sm font-semibold leading-6 text-[#f4eee1] hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent transition-colors duration-150">
                        Explore Projects <span aria-hidden="true" class="ml-1.5 transition-transform group-hover:translate-x-1">→</span>
                    </a>
                </div>



                <div class="mt-10 w-full max-w-3xl mx-auto lg:mx-0 overflow-hidden rounded-xl border border-white/10 bg-white/5 backdrop-blur-sm">
                  <div class="ticker-track flex whitespace-nowrap py-3 text-sm font-medium text-[#c9c0ad] select-none">
                    <span class="ticker-content">
                      AI&nbsp;&nbsp;·&nbsp;&nbsp;Analytics&nbsp;&nbsp;·&nbsp;&nbsp;Jewish Studies&nbsp;&nbsp;·&nbsp;&nbsp;Klezmer&nbsp;&nbsp;·&nbsp;&nbsp;TypeScript&nbsp;&nbsp;·&nbsp;&nbsp;Torah&nbsp;&nbsp;·&nbsp;&nbsp;Automation&nbsp;&nbsp;·&nbsp;&nbsp;Innovation&nbsp;&nbsp;·&nbsp;&nbsp;Data&nbsp;&nbsp;·&nbsp;&nbsp;שלום&nbsp;&nbsp;·&nbsp;&nbsp;Code&nbsp;&nbsp;·&nbsp;&nbsp;
                    </span>
                    <span class="ticker-content" aria-hidden="true">
                      AI&nbsp;&nbsp;·&nbsp;&nbsp;Analytics&nbsp;&nbsp;·&nbsp;&nbsp;Jewish Studies&nbsp;&nbsp;·&nbsp;&nbsp;Klezmer&nbsp;&nbsp;·&nbsp;&nbsp;TypeScript&nbsp;&nbsp;·&nbsp;&nbsp;Torah&nbsp;&nbsp;·&nbsp;&nbsp;Automation&nbsp;&nbsp;·&nbsp;&nbsp;Innovation&nbsp;&nbsp;·&nbsp;&nbsp;Data&nbsp;&nbsp;·&nbsp;&nbsp;שלום&nbsp;&nbsp;·&nbsp;&nbsp;Code&nbsp;&nbsp;·&nbsp;&nbsp;
                    </span>
                  </div>
                </div>
                <style>
                  .ticker-track {
                    animation: ticker-scroll 22s linear infinite;
                  }
                  .ticker-track:hover {
                    animation-play-state: paused;
                  }
                  @keyframes ticker-scroll {
                    from { transform: translateX(0); }
                    to { transform: translateX(-50%); }
                  }
                </style>
            </div>
        </main>

        {/* Scroll cue */}
        <div class="absolute bottom-5 left-1/2 z-10 -translate-x-1/2 flex flex-col items-center gap-2 text-[#c9a86a]/70">
            <span class="text-[10px] uppercase tracking-[0.3em]">Scroll</span>
            <span class="block h-8 w-px bg-gradient-to-b from-[#c9a86a]/70 to-transparent animate-pulse"></span>
        </div>
    </div>


    <script>

        // Add eyebrow raise to all link hovers
        document.addEventListener('DOMContentLoaded', () => {
            const links = document.querySelectorAll('a[href]');
            
            links.forEach(link => {
                // Skip external links and anchor links
                const href = link.getAttribute('href');
                if (href?.startsWith('http') || href?.startsWith('#')) {
                    return;
                }
                
                link.addEventListener('mouseenter', () => {
                    // Trigger eyebrow raise on face trackers
                    const faceTrackers = document.querySelectorAll('.face-tracker');
                    faceTrackers.forEach(tracker => {
                        // Dispatch custom event to trigger eyebrow raise
                        tracker.dispatchEvent(new CustomEvent('raiseEyebrows'));
                    });
                });
            });
        });
    </script>
</Layout>