    margin-bottom: 1.5rem;
  }
  .il-tab {
    padding: 0.55rem 0.95rem;
    border: none;
    border-bottom: 2px solid transparent;
    background: none;
    color: #94a3b8;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
  }
  .il-tab:hover {
    color: #e2e8f0;
  }
  .il-tab.is-active {
    color: #38bdf8;
    border-bottom-color: #38bdf8;
  }

  .il-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .il-h2 {
    font-size: 1.15rem;
    font-weight: 700;
    color: #cbd5e1;
  }

  /* ── Supermarket prices ────────────────────────────────────────────────── */
  .il-panel.il-prices {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }
  .sp-h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #cbd5e1;
    margin-top: 0.5rem;
  }
  .sp-totals {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 0.75rem;
  }
  .sp-total {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.85rem 1rem;
    border: 1px solid #1e293b;
    border-radius: 0.75rem;
    background: #0b1220;
  }
  .sp-total strong {
    font-size: 0.92rem;
    color: #e2e8f0;
  }
  .sp-total-price {
    font-size: 1.35rem;
    font-weight: 800;
    color: #e2e8f0;
  }
  .sp-total-note {
    font-size: 0.8rem;
    color: #64748b;
  }
  .sp-total.sp-cheapest-store {
    border-color: #4ade80;
  }
  .sp-total.sp-cheapest-store .sp-total-price {
    color: #4ade80;
  }
  .sp-total.sp-partial .sp-total-price {
    color: #94a3b8;
  }
  .sp-badge {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.75rem;
    font-weight: 700;
    color: #052e16;
    background: #4ade80;
    border-radius: 999px;
    padding: 0.1rem 0.55rem;
  }
  .sp-builder {
    padding: 1.1rem;
    border: 1px solid #1e293b;
    border-radius: 0.9rem;
    background: #0b1220;
  }
  .sp-search-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }
  .sp-search {
    flex: 1 1 16rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid #334155;
    border-radius: 0.6rem;
    background: #0f172a;
    color: #e2e8f0;
    font-size: 1rem;
  }
  .sp-search::placeholder {
    color: #64748b;
  }
  .sp-btn {
    padding: 0.55rem 0.9rem;
    border: 1px solid #38bdf8;
    border-radius: 0.6rem;
    background: #38bdf8;
    color: #082f49;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
  }
  .sp-btn-ghost {
    background: none;
    color: #7dd3fc;
    border-color: #334155;
  }
  .sp-status {
    margin: 0.6rem 0 0;
    font-size: 0.85rem;
    color: #64748b;
  }
  .sp-results,
  .sp-cart {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .sp-results button {
    width: 100%;
    text-align: right;
    padding: 0.5rem 0.7rem;
    border: 1px solid #1e293b;
    border-radius: 0.55rem;
    background: #0f172a;
    color: #e2e8f0;
    font-size: 0.95rem;
    cursor: pointer;
  }
  .sp-results button:hover {
    border-color: #38bdf8;
  }
  .sp-mfr {
    color: #64748b;
    font-size: 0.85rem;
  }
  .sp-from {
    color: #94a3b8;
    font-size: 0.85rem;
  }
  .sp-add {
    color: #4ade80;
    font-weight: 700;
  }
  .sp-cart li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.45rem 0.6rem;
    border: 1px solid #1e293b;
    border-radius: 0.55rem;
    background: #0f172a;
  }
  .sp-cart li > span:first-child {
    flex: 1;
    min-width: 0;
  }
  .sp-qty {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .sp-qty button {
    width: 1.7rem;
    height: 1.7rem;
    border: 1px solid #334155;
    border-radius: 0.45rem;
    background: #0b1220;
    color: #e2e8f0;
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
  }
  .sp-remove {
    border: none;
    background: none;
    color: #f87171;
    font-size: 1.15rem;
    cursor: pointer;
  }
  .sp-empty {
    color: #64748b;
    font-size: 0.9rem;
    border: none !important;
    background: none !important;
    padding-left: 0 !important;
  }
  .sp-table-wrap {
    overflow-x: auto;
  }
  .sp-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }
  .sp-table th,
  .sp-table td {
    padding: 0.45rem 0.55rem;
    border-bottom: 1px solid #1e293b;
    text-align: right;
    white-space: nowrap;
  }
  .sp-table th:first-child,
  .sp-table td:first-child {
    text-align: right;
    white-space: normal;
    min-width: 11rem;
  }
  .sp-table thead th {
    color: #94a3b8;
    font-size: 0.85rem;
  }
  .sp-table tfoot th,
  .sp-table tfoot td {
    font-weight: 800;
    border-bottom: none;
  }
  .sp-cheapest {
    color: #4ade80;
    font-weight: 700;
  }
  .sp-missing {
    color: #475569;
  }
  .sp-note {
    font-size: 0.85rem;
    color: #64748b;
    line-height: 1.6;
  }
  .sp-shuk {
    padding: 1.1rem;
    border: 1px dashed #334155;
    border-radius: 0.9rem;
  }

  /* ── Forms ───────────────────────────────────────────────────────────────── */
  .il-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid #1e293b;
    border-radius: 0.9rem;
    background: #0b1220;
  }
  .il-form-inline {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
  }
  .il-form-inline .il-input {
    flex: 1 1 12rem;
  }

  .il-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 1rem;
  }

  .il-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }
  .il-field > span {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #64748b;
  }
  .il-field-check {
    flex-direction: row;
    align-items: center;
    gap: 0.5rem;
    align-self: end;
    padding-bottom: 0.6rem;
  }
  .il-field-check > span {
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.9rem;
    color: #cbd5e1;
  }

  .il-input {
    width: 100%;
    padding: 0.55rem 0.7rem;
    border: 1px solid #253449;
    border-radius: 0.5rem;
    background: #0f172a;
    color: #e2e8f0;
    font-size: 0.95rem;
  }
  .il-input:focus {
    outline: 2px solid #0ea5e9;
    outline-offset: 1px;
    border-color: transparent;
  }
  .il-input-inline {
    width: 9rem;
    padding: 0.3rem 0.5rem;
    font-size: 0.85rem;
  }

  .il-actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .il-btn {
    padding: 0.5rem 1rem;
    border: 1px solid #334155;
    border-radius: 0.5rem;
    background: #1e293b;
    color: #e2e8f0;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
  }
  .il-btn:hover {
    background: #263449;
  }
  .il-btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
  .il-btn-primary {
    background: #0284c7;
    border-color: #0ea5e9;
    color: #f0f9ff;
  }
  .il-btn-primary:hover {
    background: #0369a1;
  }
  .il-btn-sm {
    padding: 0.25rem 0.6rem;
    font-size: 0.78rem;
  }
  .il-btn.is-active {
    background: #0284c7;
    border-color: #38bdf8;
  }

  .il-link {
    border: none;
    background: none;
    color: #38bdf8;
    font-size: 0.82rem;
    cursor: pointer;
    padding: 0;
  }
  .il-link:hover {
    text-decoration: underline;
  }
  .il-link-danger {
    color: #f87171;
  }

  .il-error {
    color: #fca5a5;
    font-size: 0.88rem;
  }
  .il-saved {
    color: #6ee7b7;
    font-size: 0.88rem;
    font-weight: 600;
  }
  .il-empty {
    color: #64748b;
    font-style: italic;
  }
  .il-hint {
    font-size: 0.82rem;
    color: #64748b;
  }

  /* ── Kosher eats ─────────────────────────────────────────────────────────── */
  .il-eats {
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid #1e293b;
  }
  .il-eats-area {
    font-size: 0.95rem;
    font-weight: 700;
    color: #cbd5e1;
    margin-top: 0.5rem;
  }
  .il-eat-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 0.75rem;
  }
  .il-eat {
    padding: 0.9rem 1rem;
    border: 1px solid #1e293b;
    border-radius: 0.75rem;
    background: #0b1220;
  }
  .il-eat-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.45rem;
  }
  .il-eat-head strong {
    color: #e2e8f0;
    font-size: 1rem;
  }
  .il-eat p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.55;
    color: #94a3b8;
  }

  /* ── Israel in numbers ───────────────────────────────────────────────────── */
  .il-numbers {
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid #1e293b;
  }
  .iln-pane {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .iln-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .iln-chart {
    background: #0b1220;
    border: 1px solid #1e293b;
    border-radius: 0.9rem;
    padding: 1rem 0.75rem 0.5rem;
  }
  .il-footnote {
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid #1e293b;
    font-size: 0.78rem;
    color: #475569;
  }

  /* ── Unlock ──────────────────────────────────────────────────────────────── */
  .il-unlock {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    margin-bottom: 1.5rem;
    border: 1px dashed #334155;
    border-radius: 0.75rem;
    background: #0b1220;
  }
  .il-unlock label {
    font-size: 0.85rem;
    color: #94a3b8;
  }
  .il-unlock .il-input {
    width: 11rem;
  }

  /* ── Combobox ────────────────────────────────────────────────────────────── */
  .il-combo-list {
    position: absolute;
    z-index: 900;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    max-height: 17rem;
    overflow-y: auto;
    margin: 0;
    padding: 0.25rem;
    list-style: none;
    border: 1px solid #253449;
    border-radius: 0.6rem;
    background: #0f172a;
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.5);
  }
  .il-combo-option {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    padding: 0.4rem 0.55rem;
    border: none;
    border-radius: 0.4rem;
    background: none;
    color: #e2e8f0;
    font-size: 0.9rem;
    text-align: left;
    cursor: pointer;
  }
  .il-combo-option.is-active,
  .il-combo-option:hover {
    background: #1e293b;
  }
  .il-combo-hint {
    flex: none;
    color: #64748b;
    font-size: 0.78rem;
  }
  .il-combo-free {
    color: #7dd3fc;
  }

  /* ── Attendees ───────────────────────────────────────────────────────────── */
  .il-attendees {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
  }
  .il-chip {
    padding: 0.3rem 0.7rem;
    border: 1px solid #334155;
    border-radius: 999px;
    background: #0f172a;
    color: #cbd5e1;
    font-size: 0.85rem;
    cursor: pointer;
  }
  .il-chip:hover {
    border-color: #475569;
  }
  .il-chip.is-on {
    border-color: #0ea5e9;
    background: #0c4a6e;
    color: #e0f2fe;
  }
  .il-chip-all.is-on {
    border-color: #34d399;
    background: #064e3b;
    color: #d1fae5;
  }
  .il-chip-ghost {
    border-style: dashed;
    color: #64748b;
  }
  .il-chip-add {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
  }
  .il-attendees.is-compact .il-chip {
    font-size: 0.78rem;
    padding: 0.2rem 0.55rem;
  }

  /* ── Meals ───────────────────────────────────────────────────────────────── */
  .il-meals {
    border: 1px solid #1e293b;
    border-radius: 0.75rem;
    padding: 1rem;
  }
  .il-meals legend {
    padding: 0 0.4rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #64748b;
  }
  .il-meal {
    border-top: 1px solid #172033;
    padding: 0.55rem 0;
  }
  .il-meal:first-of-type {
    border-top: none;
  }
  .il-meal-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
  }
  .il-meal-name {
    font-weight: 600;
    color: #cbd5e1;
  }
  .il-meal-he {
    color: #64748b;
    font-size: 0.88rem;
  }
  .il-meal-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.75rem 0 0.35rem 1.6rem;
  }
  .il-meal-list {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0 0 0 0.9rem;
    border-left: 2px solid #1e293b;
    font-size: 0.86rem;
    color: #94a3b8;
  }
  .il-meal-list li {
    padding: 0.15rem 0;
  }
  .il-meal-list strong {
    color: #cbd5e1;
  }

  /* ── Map ─────────────────────────────────────────────────────────────────── */
  .il-map-wrap {
    position: relative;
  }
  .il-map {
    height: min(70vh, 620px);
    border-radius: 0.9rem;
    border: 1px solid #1e293b;
    background: #0f172a;
  }
  .il-map-wrap.is-pinning .il-map {
    cursor: crosshair;
    border-color: #38bdf8;
  }
  .il-map-hint {
    position: absolute;
    z-index: 800;
    top: 0.75rem;
    left: 50%;
    transform: translateX(-50%);
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    background: #0284c7;
    color: #f0f9ff;
    font-size: 0.82rem;
    font-weight: 600;
  }
  /* Leaflet's popups and tooltips default to a light card that fights the page. */
  .il-map .leaflet-popup-content-wrapper,
  .il-map .leaflet-popup-tip,
  .il-map .leaflet-tooltip {
    background: #0f172a;
    color: #e2e8f0;
    border: 1px solid #334155;
  }
  .il-map .leaflet-tooltip::before {
    display: none;
  }
  .il-map .leaflet-control-attribution {
    background: rgb(15 23 42 / 0.85);
    color: #64748b;
  }
  .il-map .leaflet-control-attribution a {
    color: #94a3b8;
  }

  .il-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    list-style: none;
    padding: 0;
    font-size: 0.8rem;
    color: #94a3b8;
  }
  .il-legend li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .il-key {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 999px;
    display: inline-block;
  }
  .il-key-place {
    background: #fbbf24;
    border: 2px solid #f59e0b;
  }
  .il-key-shul {
    background: #0ea5e9;
    border: 2px solid #38bdf8;
  }
  .il-key-shul-off {
    background: #94a3b8;
    border: 2px solid #64748b;
    opacity: 0.6;
  }
  .il-key-region {
    border-radius: 0.2rem;
    background: #22d3ee;
    opacity: 0.4;
  }

  /* ── Toolbar & toggles ───────────────────────────────────────────────────── */
  .il-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }
  .il-toolbar .il-input {
    flex: 1 1 15rem;
    width: auto;
  }
  .il-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: #94a3b8;
    cursor: pointer;
  }

  /* ── Lists ───────────────────────────────────────────────────────────────── */
  .il-log,
  .il-shul-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .il-log-row {
    padding: 0.75rem 0.9rem;
    border: 1px solid #1e293b;
    border-radius: 0.7rem;
    background: #0b1220;
  }
  .il-log-main {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
  }
  .il-log-date {
    font-variant-numeric: tabular-nums;
    font-size: 0.82rem;
    color: #64748b;
    min-width: 9.5rem;
  }
  .il-log-title {
    font-weight: 650;
    color: #e2e8f0;
  }
  .il-log-tag {
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: #1e293b;
    color: #94a3b8;
    font-size: 0.75rem;
  }
  .il-log-time {
    font-variant-numeric: tabular-nums;
    color: #7dd3fc;
    font-size: 0.85rem;
  }
  .il-log-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin-top: 0.35rem;
    font-size: 0.82rem;
    color: #94a3b8;
  }
  .il-log-notes {
    color: #64748b;
    font-style: italic;
  }
  .il-log-actions {
    display: inline-flex;
    gap: 0.75rem;
    margin-left: auto;
  }

  .il-shul {
    padding: 0.6rem 0.9rem;
    border: 1px solid #1e293b;
    border-radius: 0.7rem;
    background: #0b1220;
  }
  .il-shul-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
  }
  .il-shul-main {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
    min-width: 0;
  }
  .il-shul-name {
    font-weight: 650;
    color: #e2e8f0;
  }
  .il-shul-en {
    color: #64748b;
    font-size: 0.85rem;
  }
  .il-shul-address {
    color: #94a3b8;
    font-size: 0.82rem;
  }
  .il-shul-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .il-badge {
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: #064e3b;
    color: #6ee7b7;
    font-size: 0.72rem;
  }
  .il-badge-muted {
    background: #1e293b;
    color: #64748b;
  }
  .il-count {
    min-width: 1.6rem;
    text-align: center;
    padding: 0.1rem 0.4rem;
    border-radius: 0.4rem;
    background: #0c4a6e;
    color: #e0f2fe;
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
  }

  /* ── Shul address search ─────────────────────────────────────────────────── */
  .il-geocode {
    margin-top: 0.6rem;
    padding-top: 0.6rem;
    border-top: 1px solid #172033;
  }
  .il-geocode-form {
    display: flex;
