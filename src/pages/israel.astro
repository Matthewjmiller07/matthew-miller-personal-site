---
// /israel — a log of our life here: which shul for which minyan, where Shabbat was
// spent and with whom, and everywhere else we get to during the week.
//
// Reads run in the browser against Supabase with the anon key (RLS: select only).
// Writes go through /api/israel behind a passcode. The geography — 1,271 settlements
// and the district polygons — is open government data shipped as static JSON; see
// scripts/build-israel-places.mjs. The "Israel in numbers" section below the tracker
// is built the same way from Bank of Israel, Kinneret, CBS and election data; see
// scripts/fetch-israel-stats.mjs.
import Layout from '../layouts/Layout.astro';
import IsraelTracker from '../components/israel/IsraelTracker.tsx';
import IsraelNumbers from '../components/israel/IsraelNumbers.tsx';
// Place-name facts from the Academy of the Hebrew Language's settlements quiz and official names list.
import placeNames from '../data/israel/place-names.json';
// Supermarket prices: week-1 snapshot (Nov 1, 2026) from the chains'
// price-transparency files under the Food Law, via israeli-prices.
// The same file is fetched client-side by the cart builder.
import snapshot from '../../public/data/supermarket-prices/snapshot.json';
import shukData from '../../public/data/supermarket-prices/shuk.json';

const spCatalog = new Map(snapshot.catalog.map((c) => [c.gtin, c]));
const spStores = snapshot.stores;
// Category lines (eggs): one item per store from that store's own pack,
// rendered as a single row with per-store GTINs.
const spMock = [
  ...snapshot.mock_basket
    .map((m) => ({ ...m, item: spCatalog.get(m.gtin) }))
    .filter((m) => m.item),
  ...(snapshot.mock_categories || []).map((c) => ({
    qty: c.qty,
    qtys: c.qtys || null,
    item: { name: c.label },
    perStore: c.gtins,
    category: c.id,
  })),
];
const spPrice = (gtin, i) => snapshot.prices[gtin]?.[i] ?? null;
const spRowPrice = (m, i) => spPrice(m.perStore ? m.perStore[i] : m.gtin, i);
const spTotals = snapshot.totals;
// Cheapest complete basket: only stores carrying every mock item count.
const spCheapestId = spStores
  .filter((s) => (snapshot.totals[s.id]?.missing?.length ?? 99) === 0)
  .sort((a, b) => snapshot.totals[a.id].total - snapshot.totals[b.id].total)[0]?.id;
// Cheapest cell in a row: compare line totals (price × that store's
// quantity), not unit prices — the tuna line is 2×120g cans everywhere
// but 1×240g at Carrefour.
const spLineTotal = (m, i) => {
  const p = spRowPrice(m, i);
  if (p === null) return null;
  return p * (m.qtys ? m.qtys[i] : m.qty);
};
const spCheapestIdx = (m) => {
  let best = -1;
  spStores.forEach((_, i) => {
    const t = spLineTotal(m, i);
    if (t !== null && (best === -1 || t < spLineTotal(m, best))) best = i;
  });
  return best;
};
const spDate = snapshot.date;

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';

const pageTitle = 'Israel';
const pageDescription =
  'Tracking our life in Israel — minyanim shul by shul, Shabbat meals and hosts, and the towns and moshavim we get to, mapped on Israeli open government data.';
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="il-page">
    <header class="il-hero">
      <p class="il-kicker">רעננה · ארץ ישראל</p>
      <h1>Our Israel, logged</h1>
      <p class="il-lede">
        Fifty-eight shuls within walking distance of home, three meals a Shabbat plus the
        kiddush and the dessert, and a country small enough to drive across on a Tuesday.
        This is where all of it gets written down.
      </p>
    </header>

    <nav class="il-ptabs" role="tablist" aria-label="Israel page sections">
      <button
        class="il-ptab is-active"
        role="tab"
        id="il-ptab-log"
        aria-controls="il-panel-log"
        aria-selected="true"
        data-tab="log"
        type="button">The log</button
      >
      <button
        class="il-ptab"
        role="tab"
        id="il-ptab-kosher-eats"
        aria-controls="il-panel-kosher-eats"
        aria-selected="false"
        data-tab="kosher-eats"
        type="button">Kosher eats</button
      >
      <button
        class="il-ptab"
        role="tab"
        id="il-ptab-numbers"
        aria-controls="il-panel-numbers"
        aria-selected="false"
        data-tab="numbers"
        type="button">Israel in numbers</button
      >
      <button
        class="il-ptab"
        role="tab"
        id="il-ptab-names"
        aria-controls="il-panel-names"
        aria-selected="false"
        data-tab="names"
        type="button">Place names</button
      >
      <button
        class="il-ptab"
        role="tab"
        id="il-ptab-prices"
        aria-controls="il-panel-prices"
        aria-selected="false"
        data-tab="prices"
        type="button">Supermarket prices</button
      >
    </nav>

    <div
      class="il-panel"
      id="il-panel-log"
      role="tabpanel"
      aria-labelledby="il-ptab-log"
      data-panel="log"
    >
      {
        supabaseUrl && supabaseAnonKey ? (
          <IsraelTracker
            client:only="react"
            supabaseUrl={supabaseUrl}
            supabaseAnonKey={supabaseAnonKey}
          />
        ) : (
          <p class="il-error">
            Supabase isn’t configured — set PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_ANON_KEY.
          </p>
        )
      }
    </div>

    <section
      class="il-section il-eats il-panel"
      id="il-panel-kosher-eats"
      role="tabpanel"
      aria-labelledby="il-ptab-kosher-eats"
      data-panel="kosher-eats"
      hidden
    >
      <h2 class="il-h2">Kosher eats — Ra'anana &amp; the Sharon</h2>
      <p class="il-lede">
        The running list from the daily kosher sweep. Kashrut levels are each venue's or
        reviewer's own claim unless noted as confirmed — a listing here is a lead, not a
        psak. Statuses as of 20 Oct 2026.
      </p>

      <h3 class="il-eats-area">Ra'anana</h3>
      <ul class="il-eat-grid">
        <li class="il-eat">
          <div class="il-eat-head">
            <strong>Green Bowl</strong>
            <span class="il-badge">Kosher</span>
            <span class="il-badge il-badge-muted">Rabbanut Ra'anana · not mehadrin</span>
          </div>
          <p>New “NYC” health-bowl spot (<a
              class="il-handle"
              href="https://www.instagram.com/green.bowl.rest/"
              target="_blank"
              rel="noopener">@green.bowl.rest</a
            >). Reviewed by @tamareats_ on
          19 Oct — her caption marks it ✡️ Kosher, and she replied on 20 Oct: kosher under
          the Ra'anana Rabbinate (not mehadrin).</p>
          <div class="il-ig">
            <iframe
              class="il-ig-frame il-ig-reel il-ig-reel-tight"
              data-ig-src="https://www.instagram.com/reel/DetFOc7IRkQ/embed"
              title="Instagram — @tamareats_ reviews Green Bowl, Ra'anana"
              allowfullscreen
              scrolling="no"></iframe>
            <a
              class="il-ig-link"
              href="https://www.instagram.com/reel/DetFOc7IRkQ/"
              target="_blank"
              rel="noopener">Original post — @tamareats_ ↗</a
            >
          </div>
        </li>
        <li class="il-eat">
          <div class="il-eat-head">
            <strong>Pastaria</strong>
            <span class="il-badge">Mehadrin · self-claim</span>
          </div>
          <p>Italian. Claims kosher lemehadrin in its own listings (Sept 2026 find).</p>
        </li>
        <li class="il-eat">
          <div class="il-eat-head">
            <strong>La Toscana</strong>
            <span class="il-badge">Mehadrin · self-claim</span>
          </div>
          <p>Italian. Claims kosher lemehadrin in its own listings (Sept 2026 find).</p>
        </li>
        <li class="il-eat">
          <div class="il-eat-head">
            <strong>Los Tacos</strong>
            <span class="il-badge">Beit Yosef</span>
          </div>
          <p>Mexican (<a
              class="il-handle"
              href="https://www.instagram.com/los_tacos_il/"
              target="_blank"
              rel="noopener">@los_tacos_il</a
            >). Beit Yosef supervision, per @tamareats_'s roundups.</p>
        </li>
        <li class="il-eat">
          <div class="il-eat-head">
            <strong>Poke Bar</strong>
            <span class="il-badge">Kosher</span>
            <span class="il-badge il-badge-muted">plain level</span>
          </div>
          <p>Hanesi'im 47 (<a
              class="il-handle"
              href="https://www.instagram.com/poke_and_cocktail/"
              target="_blank"
              rel="noopener">@poke_and_cocktail</a
            >). Its own bio says כשר, no mehadrin claim.</p>
        </li>
        <li class="il-eat">
          <div class="il-eat-head">
            <strong>Café Neve</strong>
            <span class="il-badge">Kosher</span>
            <span class="il-badge il-badge-muted">plain level</span>
          </div>
          <p>Neighborhood coffee cart, O. Hillel 1. Bio says כשר; featured in @tamareats_'s
          September roundup.</p>
          <div class="il-ig">
            <iframe
              class="il-ig-frame il-ig-post"
              data-ig-src="https://www.instagram.com/p/DeC031eEfCF/embed"
              title="Instagram — @tamareats_'s September roundup, incl. Café Neve"
              allowfullscreen
              scrolling="no"></iframe>
            <span class="il-ig-note"
              >From @tamareats_'s September roundup — Café Neve is one of the spots listed.</span
            >
            <a
              class="il-ig-link"
              href="https://www.instagram.com/p/DeC031eEfCF/"
              target="_blank"
              rel="noopener">Original post — @tamareats_ ↗</a
            >
          </div>
        </li>
      </ul>

      <h3 class="il-eats-area">Tel Mond</h3>
      <ul class="il-eat-grid">
        <li class="il-eat">
          <div class="il-eat-head">
            <strong>Biscotti — Tel Mond branch</strong>
            <span class="il-badge">Mehadrin · Badatz Beit Yosef</span>
          </div>
          <p>The chain's own Instagram announced this branch with “כשרות בד״צ בית יוסף” —
          the one mehadrin find the town's restaurant listings don't show.</p>
          <div class="il-ig">
            <iframe
              class="il-ig-frame il-ig-reel"
              data-ig-src="https://www.instagram.com/reel/DItYZraIoKb/embed"
              title="Instagram — @biscotti_il announces the Tel Mond branch"
              allowfullscreen
              scrolling="no"></iframe>
            <a
              class="il-ig-link"
              href="https://www.instagram.com/reel/DItYZraIoKb/"
              target="_blank"
              rel="noopener">Original post — @biscotti_il ↗</a
            >
          </div>
        </li>
        <li class="il-eat">
          <div class="il-eat-head">
            <strong>HaKuskus Shel Galia</strong>
            <span class="il-badge">Kosher</span>
            <span class="il-badge il-badge-muted">Rabbanut regular · not mehadrin</span>
          </div>
          <p>Kosher home-cooking buffet. @daniel.kosherr's 18 Oct video shows a framed
          certificate dated 2027; he replied on 20 Oct: רבנות רגילה — regular Rabbanut,
          not mehadrin.</p>
          <div class="il-ig">
            <iframe
              class="il-ig-frame il-ig-reel"
              data-ig-src="https://www.instagram.com/reel/DeoUYX-DBpD/embed"
              title="Instagram — @daniel.kosherr at HaKuskus Shel Galia, Tel Mond"
              allowfullscreen
              scrolling="no"></iframe>
            <a
              class="il-ig-link"
              href="https://www.instagram.com/reel/DeoUYX-DBpD/"
              target="_blank"
              rel="noopener">Original post — @daniel.kosherr ↗</a
            >
          </div>
        </li>
      </ul>

      <h3 class="il-eats-area">Herzliya &amp; Tel Aviv</h3>
      <ul class="il-eat-grid">
        <li class="il-eat">
          <div class="il-eat-head">
            <strong>Verde Bake &amp; Wine</strong>
            <span class="il-badge">Kosher</span>
            <span class="il-badge il-badge-muted">not mehadrin</span>
          </div>
          <p>Alterman 44, Herzliya — dairy café by day, wine bar by night. Bio says just
          כשר, plain level.</p>
          <div class="il-ig">
            <iframe
              class="il-ig-frame il-ig-reel il-ig-reel-tight"
              data-ig-src="https://www.instagram.com/reel/Dd0oTJNxBg-/embed"
              title="Instagram — @tamareats_ at Verde Bake & Wine, Herzliya"
              allowfullscreen
              scrolling="no"></iframe>
            <a
              class="il-ig-link"
              href="https://www.instagram.com/reel/Dd0oTJNxBg-/"
              target="_blank"
              rel="noopener">Original post — @tamareats_ ↗</a
            >
          </div>
        </li>
        <li class="il-eat">
          <div class="il-eat-head">
            <strong>Bodega Burger</strong>
            <span class="il-badge">Kosher</span>
            <span class="il-badge il-badge-muted">not mehadrin</span>
          </div>
          <p>Carlebach 14, Tel Aviv (<a
              class="il-handle"
              href="https://www.instagram.com/getbodega/"
              target="_blank"
              rel="noopener">@getbodega</a
            >). Regular Rabbanut Tel Aviv — certified
          kosher, not mehadrin. Closed Friday and Shabbat.</p>
        </li>
        <li class="il-eat">
          <div class="il-eat-head">
            <strong>NYN Pizza — Carmel</strong>
            <span class="il-badge">Kosher</span>
            <span class="il-badge il-badge-muted">mehadrin unverified</span>
          </div>
          <p>HaCarmel 38, Tel Aviv. Kosher per @yallabikes; mehadrin unverified. The
          Jerusalem branch (Machane Yehuda, Hatapuach 12) posts “Kosher Mehadrin
          Rabbanut Yerushalayim” for itself.</p>
        </li>
      </ul>
    </section>

    <section
      class="il-section il-numbers il-panel"
      id="il-panel-numbers"
      role="tabpanel"
      aria-labelledby="il-ptab-numbers"
      data-panel="numbers"
      hidden
    >
      <h2 class="il-h2">Israel in numbers</h2>
      <p class="il-lede">
        The country behind the log above, in open data: the shekel against the
        world’s currencies, the Kinneret’s water level, sixty years of population
        growth and aliyah, how Raanana has voted in every Knesset election since
        2013, and the sky over Raanana right now.
      </p>
      <IsraelNumbers client:only="react" />
    </section>

    <section
      class="il-section il-names il-panel"
      id="il-panel-names"
      role="tabpanel"
      aria-labelledby="il-ptab-names"
      data-panel="names"
      hidden
    >
      <h2 class="il-h2">Place names, by the book</h2>
      <p class="il-lede">
        It's officially Kfar Sa<b>va</b>, the moshav down the road is Botsra, and Ra'anana is spelled
        with a double n. Fun facts about Israel's place names, all from the Academy of the Hebrew
        Language: its settlements quiz and its official list of how every settlement is spelled.
        <a class="il-handle" href="/israel/place-names">Link to share ↗</a>
      </p>
      <div class="il-names-filter" role="group" aria-label="Filter place-name facts">
        <button type="button" class="is-on" data-nf="all">All {placeNames.facts.length}</button>
        {placeNames.groups.map((g) => (
          <button type="button" data-nf={g.id}>{g.label}</button>
        ))}
        <button type="button" data-nf="near">Near Ra'anana</button>
      </div>
      {placeNames.groups.map((g) => (
        <div class="il-names-group" data-ng={g.id}>
          <h3 class="il-names-h3">{g.label}</h3>
          <p class="il-names-blurb">{g.blurb}</p>
          <ul class="il-names-grid">
            {placeNames.facts.filter((f) => f.g === g.id).map((f) => (
              <li class="il-name" data-near={f.near ? '1' : undefined}>
                <div class="il-name-top">
                  <span class="il-name-he" lang="he" dir="rtl">{f.he}</span>
                  <span class="il-name-en">{f.en}</span>
                </div>
                <strong class="il-name-head">{f.head}</strong>
                <p>{f.body}</p>
                <a class="il-name-src" href={placeNames.sources[f.src as 'quiz' | 'list'].url} target="_blank" rel="noopener">
                  {f.src === 'quiz' ? 'Academy settlements quiz ↗' : 'Academy names list, 2022 ↗'}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <p class="il-names-note">
        Sources: <a href={placeNames.sources.quiz.url} target="_blank" rel="noopener">{placeNames.sources.quiz.title}</a>;
        <a href={placeNames.sources.list.url} target="_blank" rel="noopener">{placeNames.sources.list.title}</a>.
        The Academy spells the names; the Government Names Committee chooses them.
      </p>
    </section>

    <section
      class="il-section il-prices il-panel"
      id="il-panel-prices"
      role="tabpanel"
      aria-labelledby="il-ptab-prices"
      data-panel="prices"
      hidden
    >
      <h2 class="il-h2">Supermarket prices — Ra'anana</h2>
      <p class="il-lede">
        The same weekly shop, priced at every supermarket in town. Prices come from the
        chains' own price-transparency files under the Food Law — the files they must
        publish daily — pulled 1 Nov 2026. The series starts today and a new snapshot
        lands every morning, so the totals below will grow into a price history.
      </p>

      <h3 class="sp-h3">The mock basket — one family shop, {spMock.length} items</h3>
      <p class="il-lede">
        A realistic demo shop with real prices from {spDate}. Shelf prices; sale prices
        (promos) are not applied yet. The cheapest complete basket is highlighted.
      </p>
      <p class="il-lede">
        Eggs are in the basket as a category line, not a single barcode: regular eggs are
        price-controlled in Israel, so each chain's standard 12-pack L is compared instead
        of one shared barcode — Osher Ad carries no standard 12-pack L, so it stays
        partial on this line. The legal maximum for 12 L rose to ₪14.54 on 1 Nov 2026;
        the files pulled that morning still showed the pre-increase prices, and the daily
        snapshot picks the new ones up as the chains publish them. A near-zero spread on
        eggs is the control doing its job, not a data error.
      </p>
      <div class="sp-totals" id="sp-totals">
        {spStores.map((s, i) => {
          const t = spTotals[s.id];
          const missing = t?.missing?.length ?? 0;
          return (
            <div class={`sp-total${s.id === spCheapestId ? ' sp-cheapest-store' : ''}${missing ? ' sp-partial' : ''}`}>
              <strong>{s.label}</strong>
              <span class="sp-total-price">₪{t?.total.toFixed(2)}</span>
              {s.note && <span class="sp-total-note">{s.note}</span>}
              {s.id === spCheapestId && <span class="sp-badge">Cheapest</span>}
              {missing > 0 ? (
                <span class="sp-total-note">only {spMock.length - missing} of {spMock.length} items — partial total, not directly comparable</span>
              ) : (
                <span class="sp-total-note">all {spMock.length} items</span>
              )}
            </div>
          );
        })}
      </div>

      <h3 class="sp-h3">Build your own cart</h3>
      <p class="il-lede">
        Type a product — in Hebrew or in English (“eggs”, “milk”, “bread”) — add it with a
        quantity, and see which store's cart is cheaper. Your cart lives in the page
        address, so the link is shareable: send it to someone and they see the same cart.
      </p>
      <div class="sp-builder">
        <div class="sp-search-row">
          <input
            id="sp-search"
            class="sp-search"
            type="search"
            lang="he"
            dir="rtl"
            placeholder="חפשו מוצר… eggs, milk, bread — גם באנגלית"
            autocomplete="off"
            aria-label="Search products"
          />
          <button id="sp-mock" class="sp-btn" type="button">Load the mock basket</button>
          <button id="sp-clear" class="sp-btn sp-btn-ghost" type="button">Clear cart</button>
          <button id="sp-copy" class="sp-btn sp-btn-ghost" type="button">Copy share link</button>
        </div>
        <p class="sp-status" id="sp-status">Loading the price snapshot…</p>
        <ul class="sp-results" id="sp-results"></ul>
        <ul class="sp-cart" id="sp-cart"></ul>
      </div>

      <div class="sp-table-wrap">
        <table class="sp-table" id="sp-table">
          <thead>
            <tr>
              <th scope="col">Item</th>
              <th scope="col">Qty</th>
              {spStores.map((s) => (
                <th scope="col">{s.label}</th>
              ))}
            </tr>
          </thead>
          <tbody id="sp-tbody">
            {spMock.map((m) => (
              <tr>
                <td lang="he" dir="rtl">{m.item.name}</td>
                <td>{m.qtys ? [...new Set(m.qtys)].join(' / ') : m.qty}</td>
                {spStores.map((_, i) => {
                  const p = spRowPrice(m, i);
                  const q = m.qtys ? m.qtys[i] : m.qty;
                  return p === null ? (
                    <td class="sp-missing">—</td>
                  ) : (
                    <td class={i === spCheapestIdx(m) ? 'sp-cheapest' : ''}>
                      ₪{(p * q).toFixed(2)}
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr>
              <th scope="row">Total</th>
              <td></td>
              {spStores.map((s) => (
                <td class={s.id === spCheapestId ? 'sp-cheapest' : ''}>
                  ₪{spTotals[s.id]?.total.toFixed(2)}
                  {spTotals[s.id]?.missing?.length ? ' *' : ''}
                </td>
              ))}
            </tr>
          </tfoot>
        </table>
      </div>
      <p class="sp-note">
        * Osher Ad's Kfar Saba branch — the nearest one; Osher Ad has no Ra'anana branch —
        carries only {spMock.length - (spTotals['osher-031']?.missing?.length ?? 0)} of the
        {spMock.length} mock items, so its total is a partial total. Items a store doesn't
        carry are left out of that store's total, never priced at zero. Four more lines
        work like eggs — grated cheese, sliced bread, a second butter and Starkist tuna
        are each chain's standard pack of the same item, because Carrefour doesn't carry
        the exact barcodes (Noam grated cheese at Carrefour and Osher Ad, Daganit bread
        and Roshen butter at Carrefour; tuna is 2×120g cans everywhere but 1×240g can at
        Carrefour, so the quantity column shows 2 / 1). Carrefour's prices are refreshed
        by hand, since its portal blocks automatic downloads — its column is dated.
        Snapshot date{' '}
        {spDate}. Source: {snapshot.source}
      </p>

      <div class="sp-shuk" id="sp-shuk">
        <h3 class="sp-h3">Shuk Ra'anana — manual prices</h3>
        {shukData.items.length === 0 ? (
          <p class="il-lede">
            The shuk isn't covered by the price-transparency law — that covers chains with
            three or more branches — so there is no automatic feed for it and no shuk prices
            are recorded yet. Prices here are entered by hand after a market visit, produce
            only (fruit and veg — the shuk doesn't sell packaged staples). Once the first
            prices are recorded, a Shuk column appears in the table above for matching
            items, with a produce-only subtotal kept separate from the full-basket totals.
          </p>
        ) : (
          <ul>
            {shukData.items.map((it) => (
              <li lang="he" dir="rtl">
                {it.name} — ₪{it.price} / {it.unit === 'kg' ? 'ק״ג' : 'יחידה'} (recorded{' '}
                {it.recorded})
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  </main>

  <script>
    // Place names: filter by group, or just the places around Ra'anana.
    document.querySelectorAll<HTMLButtonElement>('[data-nf]').forEach((b) => {
      b.addEventListener('click', () => {
        const f = b.dataset.nf;
        document.querySelectorAll('[data-nf]').forEach((x) => x.classList.toggle('is-on', x === b));
        document.querySelectorAll<HTMLElement>('[data-ng]').forEach((g) => {
          const cards = g.querySelectorAll<HTMLElement>('.il-name');
          cards.forEach((c) => (c.hidden = f === 'near' && !c.dataset.near));
          g.hidden = (f !== 'all' && f !== 'near' && g.dataset.ng !== f) || ![...cards].some((c) => !c.hidden);
        });
      });
    });
  </script>

  <script>
    // Page tabs: ?tab=<slug> deep-links a tab; clicking updates the URL in place.
    // A ?cart= parameter opens the prices tab (unless ?tab= says otherwise).
    (function () {
      var SLUGS = ['log', 'kosher-eats', 'numbers', 'names', 'prices'];
      function desired() {
        var params = new URLSearchParams(window.location.search);
        var q = params.get('tab');
        if (q && SLUGS.indexOf(q) !== -1) return q;
        if (params.get('cart')) return 'prices';
        var h = window.location.hash.replace('#', '');
        if (SLUGS.indexOf(h) !== -1) return h;
        return 'log';
      }
      var igLoaded = false;
      function loadEmbeds() {
        if (igLoaded) return;
        igLoaded = true;
        document.querySelectorAll('iframe[data-ig-src]').forEach(function (f) {
          f.setAttribute('src', f.getAttribute('data-ig-src') || '');
        });
      }
      function nudgeResize() {
        // Leaflet (in the tracker) and the numbers charts size themselves from
        // their container; a panel that starts hidden needs a resize kick when
        // it first becomes visible.
        [120, 450].forEach(function (ms) {
          window.setTimeout(function () {
            window.dispatchEvent(new Event('resize'));
          }, ms);
        });
      }
      function activate(slug, push) {
        document.querySelectorAll('[data-tab]').forEach(function (b) {
          var on = b.getAttribute('data-tab') === slug;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        document.querySelectorAll('[data-panel]').forEach(function (p) {
          if (p.getAttribute('data-panel') === slug) p.removeAttribute('hidden');
          else p.setAttribute('hidden', '');
        });
        if (slug === 'kosher-eats') loadEmbeds();
        if (slug === 'log' || slug === 'numbers') nudgeResize();
        if (push) {
          var url = new URL(window.location.href);
          url.searchParams.set('tab', slug);
          url.hash = '';
          window.history.pushState({ tab: slug }, '', url);
        }
      }
      document.querySelectorAll('[data-tab]').forEach(function (b) {
        b.addEventListener('click', function () {
          activate(b.getAttribute('data-tab') || 'log', true);
        });
      });
      window.addEventListener('popstate', function () {
        activate(desired(), false);
      });
      activate(desired(), false);
    })();
  </script>

  <script>
    // Supermarket prices: cart builder. The snapshot (catalog + per-store
    // prices) is fetched lazily the first time the tab opens or a ?cart=
    // parameter is present; the mock basket table is rendered statically
    // at build time, so the page is useful before the fetch lands.
    (function () {
      var DATA_URL = '/data/supermarket-prices/snapshot.json';
      var SHUK_URL = '/data/supermarket-prices/shuk.json';
      var ALIASES = {
        eggs: 'ביצים', egg: 'ביצים', milk: 'חלב', bread: 'לחם', cheese: 'גבינה',
        chicken: 'עוף', beef: 'בשר', rice: 'אורז', pasta: 'פסטה', spaghetti: 'ספגטי',
        flour: 'קמח', sugar: 'סוכר', oil: 'שמן', coffee: 'קפה', chocolate: 'שוקולד',
        'toilet paper': 'נייר טואלט', detergent: 'כביסה', soap: 'סבון',
        shampoo: 'שמפו', diapers: 'חיתולים', butter: 'חמאה', tuna: 'טונה',
        hummus: 'חומוס', tahini: 'טחינה', yogurt: 'יוגורט', water: 'מים',
        juice: 'מיץ', tea: 'תה', cornflakes: 'קורנפלקס', toothpaste: 'משחת שיניים',
        tomato: 'עגבניות', tomatoes: 'עגבניות', cucumber: 'מלפפון', cucumbers: 'מלפפון',
        potato: 'תפוחי אדמה', potatoes: 'תפוחי אדמה', onion: 'בצל', onions: 'בצל',
        banana: 'בננה', bananas: 'בננה', apple: 'תפוח', orange: 'תפוז',
        carrot: 'גזר', lemon: 'לימון', avocado: 'אבוקדו', corn: 'תירס',
        ketchup: 'קטשופ', mayonnaise: 'מיונז', mayo: 'מיונז', cream: 'שמנת',
        cottage: "קוטג'", salt: 'מלח', honey: 'דבש', jam: 'ריבה', cereal: 'דגנים',
        oats: 'שיבולת שועל', oatmeal: 'שיבולת שועל', nuts: 'אגוזים',
        almonds: 'שקדים', dates: 'תמרים', fish: 'דג', salmon: 'סלמון',
      };
      var snap = null;
      var shuk = [];
      var catalog = {};
      var cart = {}; // gtin -> qty
      var loading = null;
      var userTouched = false; // set once the user adds / clears, so the
      // mock preset never refills a cart they emptied on purpose.

      var $ = function (id) { return document.getElementById(id); };
      function money(n) { return '₪' + n.toFixed(2); }
      function esc(s) {
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }

      function parseCartParam() {
        var raw = new URLSearchParams(window.location.search).get('cart');
        var out = {};
        if (!raw) return out;
        raw.split(',').forEach(function (part) {
          var kv = part.split(':');
          if (kv[0] === 'cat' && kv[1]) {
            // Category line (eggs): cat:<id>:<qty>; unknown ids are pruned
            // once the snapshot loads.
            var qc = parseInt(kv[2] || '1', 10);
            if (qc > 0) out['cat:' + kv[1]] = Math.min(qc, 99);
            return;
          }
          var q = parseInt(kv[1] || '1', 10);
          if (/^\d{8,14}$/.test(kv[0] || '') && q > 0) out[kv[0]] = Math.min(q, 99);
        });
        return out;
      }
      function syncUrl() {
        var url = new URL(window.location.href);
        var parts = Object.keys(cart).map(function (g) { return g + ':' + cart[g]; });
        if (parts.length) url.searchParams.set('cart', parts.join(','));
        else url.searchParams.delete('cart');
        url.searchParams.set('tab', 'prices');
        window.history.replaceState({ tab: 'prices' }, '', url);
      }
      function cartItems() {
        return Object.keys(cart).map(function (g) {
          if (g.indexOf('cat:') === 0) {
            var cat = ((snap && snap.mock_categories) || []).filter(function (c) { return c.id === g.slice(4); })[0];
            return { cat: g.slice(4), qty: cart[g], baseQty: cat ? cat.qty : 1, qtys: cat ? (cat.qtys || null) : null, item: cat ? { name: cat.label } : null, perStore: cat ? cat.gtins : null };
          }
          return { gtin: g, qty: cart[g], item: catalog[g] || null };
        });
      }
      function itemPrice(ci, i) {
        // Per-store price for one cart item; a category line resolves
        // through that store's own GTIN, a plain item through its GTIN.
        if (ci.perStore) {
          var g = ci.perStore[i];
          return g ? (snap.prices[g] || [])[i] : null;
        }
        return ci.item ? (snap.prices[ci.gtin] || [])[i] : null;
      }
      function effQty(ci, i) {
        // Per-store quantity for a cart line. Category lines with
        // per-store quantities (tuna: 2×120g cans, 1×240g at Carrefour)
        // scale with the line's quantity, in units of the base amount.
        if (!ci.qtys) return ci.qty;
        return ci.qtys[i] * (ci.qty / (ci.baseQty || 1));
      }
      function storeTotals() {
        // Per-store totals for the current cart; items a store doesn't carry
        // are excluded from that store's total (never priced at zero).
        return snap.stores.map(function (s, i) {
          var total = 0, n = 0, missing = 0;
          cartItems().forEach(function (ci) {
            var p = itemPrice(ci, i);
            if (p === null || p === undefined) missing += 1;
            else { total += p * effQty(ci, i); n += 1; }
          });
          return { total: total, n: n, missing: missing };
        });
      }
      function shukMatch(ci) {
        if (!ci.item) return null;
        for (var k = 0; k < shuk.length; k++) {
          var m = shuk[k].match || shuk[k].name;
          if (m && ci.item.name.indexOf(m) !== -1) return shuk[k];
        }
        return null;
      }

      function render() {
        if (!snap) return;
        var items = cartItems();
        var totals = storeTotals();
        var complete = totals
          .map(function (t, i) { return { i: i, t: t }; })
          .filter(function (x) { return x.t.missing === 0 && x.t.n > 0; })
          .sort(function (a, b) { return a.t.total - b.t.total; });
        var cheapestIdx = complete.length ? complete[0].i : -1;

        // Totals cards.
        var totalsEl = $('sp-totals');
        if (totalsEl) {
          totalsEl.innerHTML = snap.stores.map(function (s, i) {
            var t = totals[i];
            var cls = 'sp-total' + (i === cheapestIdx ? ' sp-cheapest-store' : '') + (t.missing ? ' sp-partial' : '');
            var note = t.missing
              ? 'only ' + t.n + ' of ' + items.length + ' items — partial total, not directly comparable'
              : 'all ' + items.length + ' items';
            if (s.note) note += ' — ' + s.note;
            return '<div class="' + cls + '"><strong>' + esc(s.label) + '</strong>' +
              '<span class="sp-total-price">' + money(t.total) + '</span>' +
              (i === cheapestIdx ? '<span class="sp-badge">Cheapest</span>' : '') +
              '<span class="sp-total-note">' + note + '</span></div>';
          }).join('');
        }

        // Cart list with quantity steppers.
        var cartEl = $('sp-cart');
        if (cartEl) {
          cartEl.innerHTML = items.map(function (ci) {
            var key = ci.cat ? 'cat:' + ci.cat : ci.gtin;
            var name = ci.item ? esc(ci.item.name) : 'Unknown product ' + esc(key) + ' (not in this week’s snapshot)';
            return '<li><span lang="he" dir="rtl">' + name + '</span>' +
              '<span class="sp-qty"><button type="button" data-dec="' + key + '" aria-label="One fewer">−</button>' +
              '<span>' + ci.qty + '</span>' +
              '<button type="button" data-inc="' + key + '" aria-label="One more">+</button></span>' +
              '<button type="button" class="sp-remove" data-del="' + key + '" aria-label="Remove">×</button></li>';
          }).join('') || '<li class="sp-empty">Your cart is empty — search above, or load the mock basket.</li>';
          cartEl.querySelectorAll('[data-inc]').forEach(function (b) {
            b.addEventListener('click', function () { cart[b.dataset.inc] = Math.min(99, (cart[b.dataset.inc] || 0) + 1); syncUrl(); render(); });
          });
          cartEl.querySelectorAll('[data-dec]').forEach(function (b) {
            b.addEventListener('click', function () {
              var g = b.dataset.dec;
              cart[g] = (cart[g] || 1) - 1;
              if (cart[g] <= 0) delete cart[g];
              syncUrl(); render();
            });
          });
          cartEl.querySelectorAll('[data-del]').forEach(function (b) {
            b.addEventListener('click', function () { delete cart[b.dataset.del]; syncUrl(); render(); });
          });
        }

        // Per-item table.
        var tbody = $('sp-tbody');
        var table = $('sp-table');
        if (tbody && table) {
          var hasShuk = shuk.length > 0;
          var headRow = table.querySelector('thead tr');
          if (headRow) {
            var heads = headRow.querySelectorAll('th');
            var hasShukHead = heads.length === snap.stores.length + 3;
            if (hasShuk && !hasShukHead) {
              var th = document.createElement('th');
              th.scope = 'col';
              th.textContent = 'Shuk Ra’anana (manual)';
              headRow.appendChild(th);
            }
          }
          tbody.innerHTML = items.map(function (ci) {
            var key = ci.cat ? 'cat:' + ci.cat : ci.gtin;
            var qtyCell = ci.qty;
            if (ci.qtys) {
              var eff = snap.stores.map(function (s, i) { return effQty(ci, i); });
              var distinct = eff.filter(function (v, idx, a) { return a.indexOf(v) === idx; });
              qtyCell = distinct.join(' / ');
            }
            var row = '<tr><td lang="he" dir="rtl">' +
              (ci.item ? esc(ci.item.name) : 'Unknown product ' + esc(key)) + '</td><td>' + qtyCell + '</td>';
            var best = -1;
            snap.stores.forEach(function (s, i) {
              var p = itemPrice(ci, i);
              if (p !== null && p !== undefined && (best === -1 || p * effQty(ci, i) < itemPrice(ci, best) * effQty(ci, best))) best = i;
            });
            snap.stores.forEach(function (s, i) {
              var p = itemPrice(ci, i);
              row += p === null || p === undefined
                ? '<td class="sp-missing">—</td>'
                : '<td class="' + (i === best ? 'sp-cheapest' : '') + '">' + money(p * effQty(ci, i)) + '</td>';
            });
            if (hasShuk) {
              var sm = shukMatch(ci);
              row += sm ? '<td>' + money(sm.price) + ' / ' + (sm.unit === 'kg' ? 'ק״ג' : 'יחידה') + '</td>' : '<td class="sp-missing">—</td>';
            }
            return row + '</tr>';
          }).join('');
          var foot = table.querySelector('tfoot tr');
          if (foot) {
            var cells = '<th scope="row">Total</th><td></td>' + totals.map(function (t, i) {
              return '<td class="' + (i === cheapestIdx ? 'sp-cheapest' : '') + '">' + money(t.total) + (t.missing ? ' *' : '') + '</td>';
            }).join('');
            if (hasShuk) {
              // Produce-only subtotal: shuk prices are per kg (or per item);
              // only count cart items sold by the kilogram in 1 kg units,
              // so a 500 g pack is never charged a full kilo's shuk price.
              var sub = 0, counted = 0;
              items.forEach(function (ci) {
                var sm = shukMatch(ci);
                if (sm && ci.item && sm.unit === 'kg' && ci.item.unit === 'קילוגרם' && Number(ci.item.quantity) === 1) {
                  sub += sm.price * ci.qty; counted += 1;
                }
              });
              cells += '<td>' + (counted ? money(sub) + ' †' : '—') + '</td>';
            }
            foot.innerHTML = cells;
          }
        }
      }

      function search(q) {
        var resEl = $('sp-results');
        if (!snap || !resEl) return;
        q = (q || '').trim();
        if (q.length < 2) { resEl.innerHTML = ''; return; }
        var he = q;
        if (/[a-z]/i.test(q)) {
          var key = q.toLowerCase();
          he = ALIASES[key] || '';
          if (!he) {
            var prefix = Object.keys(ALIASES).find(function (k) { return key.indexOf(k) === 0; });
            he = prefix ? ALIASES[prefix] : '';
          }
        }
        if (!he) { resEl.innerHTML = '<li class="sp-empty">No match for “' + esc(q) + '” — try the Hebrew name.</li>'; return; }
        var hits = snap.catalog.filter(function (c) { return c.name.indexOf(he) !== -1; }).slice(0, 8);
        if (!hits.length) { resEl.innerHTML = '<li class="sp-empty">Nothing found for “' + esc(q) + '”.</li>'; return; }
        resEl.innerHTML = hits.map(function (c) {
          var prices = snap.prices[c.gtin] || [];
          var min = Math.min.apply(null, prices.filter(function (p) { return p !== null; }));
          return '<li><button type="button" data-add="' + c.gtin + '">' +
            '<span lang="he" dir="rtl">' + esc(c.name) + '</span>' +
            (c.manufacturer ? ' <span class="sp-mfr">' + esc(c.manufacturer) + '</span>' : '') +
            (isFinite(min) ? ' <span class="sp-from">from ' + money(min) + '</span>' : '') +
            ' <span class="sp-add">+ Add</span></button></li>';
        }).join('');
        resEl.querySelectorAll('[data-add]').forEach(function (b) {
          b.addEventListener('click', function () {
            var g = b.dataset.add;
            userTouched = true;
            cart[g] = (cart[g] || 0) + 1;
            syncUrl(); render();
            var input = $('sp-search');
            if (input) { input.value = ''; input.focus(); }
            resEl.innerHTML = '';
          });
        });
      }

      function load() {
        if (loading) return loading;
        var status = $('sp-status');
        loading = Promise.all([
          fetch(DATA_URL).then(function (r) { if (!r.ok) throw new Error('snapshot ' + r.status); return r.json(); }),
          fetch(SHUK_URL).then(function (r) { return r.ok ? r.json() : { items: [] }; }).catch(function () { return { items: [] }; }),
        ]).then(function (res) {
          snap = res[0];
          shuk = (res[1] && res[1].items) || [];
          snap.catalog.forEach(function (c) { catalog[c.gtin] = c; });
          // Drop category keys the snapshot no longer knows (stale URLs).
          Object.keys(cart).forEach(function (k) {
            if (k.indexOf('cat:') === 0 && !(snap.mock_categories || []).some(function (c) { return 'cat:' + c.id === k; })) delete cart[k];
          });
          // Default cart = the mock basket, unless the URL carried a cart
          // or the user already touched the cart.
          if (!Object.keys(cart).length && !userTouched && !Object.keys(parseCartParam()).length) {
            snap.mock_basket.forEach(function (m) { cart[m.gtin] = m.qty; });
            (snap.mock_categories || []).forEach(function (c) { cart['cat:' + c.id] = c.qty; });
          }
          if (status) status.textContent = 'Snapshot ' + snap.date + ' · ' + snap.catalog.length.toLocaleString('en-US') + ' products across ' + snap.stores.length + ' stores. Shelf prices; promos not yet applied.';
          render();
        }).catch(function (e) {
          if (status) status.textContent = 'Could not load the price snapshot (' + e.message + ') — the mock basket above is still there.';
        });
        return loading;
      }

      function init() {
        var input = $('sp-search');
        if (!input) return;
        var initial = parseCartParam();
        if (Object.keys(initial).length) cart = initial;
        else if (snap) cart = {};
        input.addEventListener('input', function () { load().then(function () { search(input.value); }); });
        input.addEventListener('focus', function () { load(); });
        var mockBtn = $('sp-mock');
        if (mockBtn) mockBtn.addEventListener('click', function () {
          userTouched = true;
          load().then(function () {
            cart = {};
            snap.mock_basket.forEach(function (m) { cart[m.gtin] = m.qty; });
            (snap.mock_categories || []).forEach(function (c) { cart['cat:' + c.id] = c.qty; });
            syncUrl(); render();
          });
        });
        var clearBtn = $('sp-clear');
        if (clearBtn) clearBtn.addEventListener('click', function () { userTouched = true; cart = {}; syncUrl(); render(); });
        var copyBtn = $('sp-copy');
        if (copyBtn) copyBtn.addEventListener('click', function () {
          syncUrl();
          var done = function () { copyBtn.textContent = 'Link copied'; setTimeout(function () { copyBtn.textContent = 'Copy share link'; }, 2000); };
          if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(window.location.href).then(done, done);
          else done();
        });
        // If the URL carries a cart, load now so it renders; otherwise
        // load lazily on first activation of the prices tab — the static
        // mock table above is already there until then.
        if (Object.keys(initial).length) { load(); }
        else {
          var tab = document.querySelector('[data-tab="prices"]');
          if (tab) tab.addEventListener('click', function () { load(); }, { once: true });
        }
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
      else init();
    })();
  </script>
</Layout>

<style is:global>
  /* ── Page shell ──────────────────────────────────────────────────────────── */
