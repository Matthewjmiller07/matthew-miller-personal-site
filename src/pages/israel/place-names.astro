---
// Share link for the Place names tab of /israel. Link previews (WhatsApp, iMessage) don't run JS
// and ignore ?tab=, so this page carries the tab's own title, description and image, then sends
// readers on to /israel?tab=names.
import Layout from '../../layouts/Layout.astro';
import placeNames from '../../data/israel/place-names.json';

const target = '/israel?tab=names';
---

<Layout
  title="It's officially Kfar Sava: Israeli place names"
  description={`${placeNames.facts.length} fun facts about Israel's place names from the Academy of the Hebrew Language: Kfar SaVA, Hefa, Natsrat, Botsra, and why Kiryat Mal'akhi is a tribute to Los Angeles.`}
  image="/og/israel-place-names.jpg"
  imageAlt="Israeli place names with their official vowel pointing: Kfar Sava, Haifa, Botsra, Nazareth, Ma'ale Adummim, Ra'anana"
>
  <Fragment slot="head">
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={`https://theothermatthewmiller.com${target}`} />
  </Fragment>
  <p style="padding:3rem 1rem;text-align:center">
    <a href={target}>Israeli place names, by the book →</a>
  </p>
  <script is:inline define:vars={{ target }}>location.replace(target);</script>
</Layout>
