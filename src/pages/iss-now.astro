---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="ISS Now"
  description="Real-time International Space Station tracker. Watch it orbit the Earth and generate a FLUX portrait when it's overhead."
>
  <main class="min-h-screen bg-slate-950 text-white overflow-x-hidden">

    <!-- Header -->
    <div class="bg-gradient-to-b from-purple-950/60 to-transparent px-4 py-10 text-center border-b border-purple-900/30">
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight mb-2">
        🛸 ISS Now
      </h1>
      <p class="text-slate-400 max-w-lg mx-auto text-sm">
        The International Space Station moves at 28,000 km/h and orbits Earth every 90 minutes.
        Here it is, right now — and when it's overhead, we generate your portrait.
      </p>
      <div class="mt-4 flex items-center justify-center gap-6 text-sm flex-wrap">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-purple-400 animate-pulse"></span>
          <span class="text-slate-400">Updates every 5s</span>
        </div>
        <div id="iss-coords" class="text-purple-300 font-mono text-sm">—</div>
      </div>
    </div>

    <!-- Stats strip -->
    <div class="grid grid-cols-2 sm:grid-cols-4 border-b border-white/5">
      <div class="p-4 text-center border-r border-white/5">
        <div class="text-xs text-slate-500 uppercase tracking-wider mb-1">Altitude</div>
        <div class="text-2xl font-black text-purple-400">~408 km</div>
      </div>
      <div class="p-4 text-center border-r border-white/5">
        <div class="text-xs text-slate-500 uppercase tracking-wider mb-1">Speed</div>
        <div class="text-2xl font-black text-cyan-400">7.66 km/s</div>
      </div>
      <div class="p-4 text-center border-r border-white/5">
        <div class="text-xs text-slate-500 uppercase tracking-wider mb-1">Distance from you</div>
        <div id="stat-dist" class="text-2xl font-black text-yellow-400">—</div>
      </div>
      <div class="p-4 text-center">
        <div class="text-xs text-slate-500 uppercase tracking-wider mb-1">Overhead in</div>
        <div id="stat-eta" class="text-2xl font-black text-green-400">calculating…</div>
      </div>
    </div>

    <!-- Main layout -->
    <div class="max-w-6xl mx-auto px-4 py-8 grid grid-cols-1 lg:grid-cols-3 gap-6">

      <!-- Map (spans 2 cols) -->
      <div class="lg:col-span-2">
        <div class="rounded-2xl border border-white/10 bg-slate-900/80 overflow-hidden">
          <div class="p-4 border-b border-white/10 flex items-center justify-between">
            <h2 class="font-bold text-sm text-slate-300">Live Orbital Track</h2>
            <div id="pass-badge" class="hidden text-xs bg-green-500/20 text-green-400 px-2 py-1 rounded-full border border-green-500/30 animate-pulse">
              🌟 OVERHEAD NOW
            </div>
          </div>
          <div class="relative aspect-[2/1] bg-slate-950">
            <svg id="iss-map" viewBox="0 0 720 360" class="w-full h-full">
              <defs>
                <radialGradient id="space-grad" cx="50%" cy="50%">
                  <stop offset="0%" stop-color="#0d1117"/>
                  <stop offset="100%" stop-color="#060a10"/>
                </radialGradient>
                <filter id="glow">
                  <feGaussianBlur stdDeviation="3" result="blur"/>
                  <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
                </filter>
              </defs>
              <rect width="720" height="360" fill="url(#space-grad)"/>

              <!-- Stars -->
              <g id="stars" opacity="0.4">
                <!-- Will be generated by JS -->
              </g>

              <!-- Continents (simplified) -->
              <!-- North America -->
              <path d="M 60 60 L 80 50 L 130 45 L 155 55 L 165 80 L 180 95 L 175 120 L 160 145 L 145 165 L 125 175 L 105 185 L 90 180 L 75 160 L 65 140 L 55 110 L 50 85 Z" fill="#1a2f1a" stroke="#2d5a2d" stroke-width="0.5" opacity="0.8"/>
              <!-- Greenland -->
              <path d="M 175 20 L 200 15 L 215 25 L 210 45 L 195 55 L 180 50 L 170 35 Z" fill="#1a2f1a" stroke="#2d5a2d" stroke-width="0.5" opacity="0.8"/>
              <!-- South America -->
              <path d="M 145 185 L 165 185 L 180 200 L 185 230 L 180 260 L 165 285 L 148 295 L 135 275 L 130 250 L 128 220 L 130 200 Z" fill="#1a2f1a" stroke="#2d5a2d" stroke-width="0.5" opacity="0.8"/>
              <!-- Europe -->
              <path d="M 320 40 L 345 35 L 365 45 L 375 60 L 360 75 L 340 80 L 325 90 L 315 85 L 310 70 L 315 55 Z" fill="#1a2f1a" stroke="#2d5a2d" stroke-width="0.5" opacity="0.8"/>
              <!-- Africa -->
              <path d="M 315 90 L 345 85 L 370 100 L 380 130 L 375 165 L 360 195 L 340 210 L 318 205 L 305 185 L 300 155 L 302 120 L 308 100 Z" fill="#1a2f1a" stroke="#2d5a2d" stroke-width="0.5" opacity="0.8"/>
              <!-- Middle East (special - Israel!) -->
              <path d="M 370 95 L 380 92 L 390 98 L 388 110 L 375 112 L 368 105 Z" fill="#2a3f1a" stroke="#4a7a4a" stroke-width="0.8" opacity="0.9"/>
              <!-- Asia -->
              <path d="M 365 45 L 420 35 L 480 40 L 530 50 L 570 55 L 590 70 L 575 95 L 540 110 L 505 120 L 480 130 L 450 135 L 420 125 L 390 115 L 370 100 L 360 75 Z" fill="#1a2f1a" stroke="#2d5a2d" stroke-width="0.5" opacity="0.8"/>
              <!-- Southeast Asia -->
              <path d="M 505 120 L 540 115 L 565 130 L 570 150 L 550 160 L 525 155 L 510 140 Z" fill="#1a2f1a" stroke="#2d5a2d" stroke-width="0.5" opacity="0.8"/>
              <!-- Australia -->
              <path d="M 530 205 L 570 195 L 610 200 L 630 220 L 625 250 L 600 265 L 565 260 L 540 245 L 525 225 Z" fill="#1a2f1a" stroke="#2d5a2d" stroke-width="0.5" opacity="0.8"/>

              <!-- ISS orbit path (will update) -->
              <path id="orbit-path" d="" fill="none" stroke="#7c3aed" stroke-width="0.5" stroke-dasharray="4,4" opacity="0.4"/>

              <!-- Equator -->
              <line x1="0" y1="180" x2="720" y2="180" stroke="#ffffff08" stroke-width="0.5"/>

              <!-- ISS visibility cone (footprint) -->
              <circle id="iss-footprint" cx="0" cy="0" r="0" fill="#7c3aed" opacity="0.06"/>

              <!-- User location -->
              <circle id="user-dot" cx="-100" cy="-100" r="5" fill="#4ade80"/>
              <circle id="user-pulse" cx="-100" cy="-100" r="10" fill="none" stroke="#4ade80" stroke-width="1" opacity="0.4"/>

              <!-- ISS icon -->
              <g id="iss-icon" transform="translate(-100, -100)">
                <circle r="8" fill="#7c3aed" filter="url(#glow)"/>
                <!-- Solar panel arms -->
                <rect x="-20" y="-2" width="10" height="4" fill="#60a5fa" rx="1"/>
                <rect x="10" y="-2" width="10" height="4" fill="#60a5fa" rx="1"/>
                <rect x="-2" y="-15" width="4" height="10" fill="#60a5fa" rx="1"/>
              </g>

              <!-- Trail dots (last N positions) -->
              <g id="trail-dots"></g>
            </svg>
          </div>
        </div>

        <!-- ISS Facts -->
        <div class="mt-4 grid grid-cols-3 gap-3">
          <div class="rounded-xl bg-white/5 border border-white/10 p-3 text-center">
            <div class="text-2xl mb-1">🌍</div>
            <div class="text-xs text-slate-500">Orbits per day</div>
            <div class="font-bold text-white">15.5</div>
          </div>
          <div class="rounded-xl bg-white/5 border border-white/10 p-3 text-center">
            <div class="text-2xl mb-1">👨‍🚀</div>
            <div class="text-xs text-slate-500">Crew aboard</div>
            <div class="font-bold text-white">7</div>
          </div>
          <div class="rounded-xl bg-white/5 border border-white/10 p-3 text-center">
            <div class="text-2xl mb-1">🔭</div>
            <div class="text-xs text-slate-500">Visible magnitude</div>
            <div class="font-bold text-white">−5.9</div>
          </div>
        </div>
      </div>

      <!-- Right panel -->
      <div class="flex flex-col gap-4">

        <!-- Current location info -->
        <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
          <h3 class="text-xs font-semibold text-purple-400 uppercase tracking-wider mb-3">Currently over</h3>
          <div id="over-location" class="text-white font-bold text-xl mb-2">—</div>
          <div id="over-ocean" class="text-slate-400 text-sm">—</div>
          <div class="mt-4 pt-4 border-t border-white/10">
            <div id="israel-alert" class="hidden rounded-lg bg-blue-500/10 border border-blue-500/30 p-3 text-blue-300 text-xs">
              ✡️ The ISS is currently passing over the Middle East / Israel region
            </div>
            <div class="text-slate-500 text-xs leading-relaxed" id="location-detail">
              Data from <a href="https://wheretheiss.at" target="_blank" class="hover:text-slate-300 underline">Where the ISS At</a> + reverse geocoding
            </div>
          </div>
        </div>

        <!-- FLUX portrait panel -->
        <div class="rounded-2xl border border-white/10 bg-white/5 flex-1 flex flex-col">
          <div class="p-4 border-b border-white/10">
            <h3 class="text-xs font-semibold text-purple-400 uppercase tracking-wider">AI Portrait — When ISS is Overhead</h3>
          </div>
          <div id="flux-panel" class="flex-1 flex flex-col items-center justify-center p-5 text-center gap-4">
            <div class="text-4xl">🛸</div>
            <p class="text-slate-500 text-sm">A portrait will be generated the moment the ISS passes within 2,000 km of your location.</p>
            <div class="flex items-center gap-2">
              <span class="text-xs text-slate-500">Model:</span>
              <div class="flex rounded-lg overflow-hidden border border-white/10 text-xs">
                <button id="model-flux-btn" onclick="setModel('flux')" class="px-3 py-1.5 bg-purple-500/20 text-purple-300 font-semibold">⚡ FLUX</button>
                <button id="model-gpt-btn" onclick="setModel('gpt')" class="px-3 py-1.5 bg-white/5 text-slate-400 hover:bg-white/10 transition-colors">✨ GPT Image 2</button>
              </div>
            </div>
            <div id="gpt-image-row" class="hidden w-full">
              <input id="custom-image-url" type="url" placeholder="Input image URL (blank = use my selfie)"
                class="w-full px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-slate-300 text-xs placeholder-slate-600 focus:outline-none focus:border-white/20"/>
            </div>
            <div id="dist-progress-wrap" class="w-full">
              <div class="flex justify-between text-xs text-slate-600 mb-1">
                <span>Distance</span>
                <span id="dist-label">—</span>
              </div>
              <div class="bg-slate-800 rounded-full h-2">
                <div id="dist-progress" class="h-2 rounded-full transition-all duration-1000 bg-gradient-to-r from-purple-600 to-purple-400" style="width:0%"></div>
              </div>
            </div>
          </div>
          <div id="flux-loading" class="hidden flex-col items-center gap-4 p-6">
            <div class="w-16 h-16 rounded-full border-4 border-purple-500/20 border-t-purple-400 animate-spin"></div>
            <p class="text-purple-300 text-sm">ISS overhead — generating portrait…</p>
          </div>
          <div id="flux-result" class="hidden flex-col">
            <img id="flux-img" src="" alt="ISS overhead portrait" class="rounded-b-2xl w-full object-cover"/>
            <div class="p-3 text-xs text-slate-500 text-center">Generated when ISS was overhead</div>
          </div>
        </div>
      </div>
    </div>

    <p class="text-center text-slate-700 text-xs pb-8">
      ISS position from <a href="https://wheretheiss.at" target="_blank" class="hover:text-slate-500 underline">Where the ISS At</a> ·
      Part of <a href="https://github.com/bytewax/awesome-public-real-time-datasets" target="_blank" class="hover:text-slate-500 underline">awesome-public-real-time-datasets</a>
    </p>
  </main>
</Layout>

<script>
// Generate stars
const starsG = document.getElementById('stars');
for (let i = 0; i < 200; i++) {
  const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
  c.setAttribute('cx', Math.random() * 720);
  c.setAttribute('cy', Math.random() * 360);
  c.setAttribute('r', Math.random() * 1.2);
  c.setAttribute('fill', 'white');
  starsG.appendChild(c);
}

let userLat = 41.8781;
let userLon = -87.6298;
let trail = [];
let hasGenerated = false;
let lastISSPos = null;
const MAX_OVERHEAD_KM = 2000;

function haversine(lat1, lon1, lat2, lon2) {
  const R = 6371;
  const dLat = (lat2 - lat1) * Math.PI / 180;
  const dLon = (lon2 - lon1) * Math.PI / 180;
  const a = Math.sin(dLat/2)**2 + Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLon/2)**2;
  return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
}

function lonLatToSvg(lon, lat) {
  return { x: ((lon + 180) / 360) * 720, y: ((90 - lat) / 180) * 360 };
}

function formatDist(km) {
  return km > 1000 ? `${(km/1000).toFixed(1)}k km` : `${Math.round(km)} km`;
}

async function reverseGeocode(lat, lon) {
  try {
    const r = await fetch(`https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lon}&format=json`);
    const d = await r.json();
    const addr = d.address || {};
    return addr.country || addr.state || addr.ocean || addr.sea || 'Open Ocean';
  } catch {
    return 'Unknown';
  }
}

async function fetchISS() {
  try {
    const r = await fetch('https://api.wheretheiss.at/v1/satellites/25544');
    const d = await r.json();
    const lat = parseFloat(d.latitude);
    const lon = parseFloat(d.longitude);

    // Live altitude and velocity from the new API
    if (d.altitude) {
      document.querySelector('[class*="text-purple-400"]').textContent = `${Math.round(d.altitude)} km`;
    }
    if (d.velocity) {
      document.querySelector('[class*="text-cyan-400"]').textContent = `${(d.velocity / 3600).toFixed(2)} km/s`;
    }

    document.getElementById('iss-coords').textContent = `${lat.toFixed(4)}°, ${lon.toFixed(4)}°`;

    const dist = haversine(userLat, userLon, lat, lon);
    document.getElementById('stat-dist').textContent = formatDist(dist);

    // Progress bar (inverted — closer = more filled)
    const pct = Math.max(0, 100 - (dist / MAX_OVERHEAD_KM) * 100);
    document.getElementById('dist-progress').style.width = `${pct}%`;
    document.getElementById('dist-label').textContent = formatDist(dist);

    // ETA heuristic based on ISS speed (~7.66 km/s = 27576 km/h)
    const etaMin = dist / 27576 * 60;
    if (dist < 500) {
      document.getElementById('stat-eta').textContent = 'OVERHEAD';
      document.getElementById('stat-eta').className = 'text-2xl font-black text-green-400 animate-pulse';
      document.getElementById('pass-badge').classList.remove('hidden');
    } else if (etaMin < 120) {
      document.getElementById('stat-eta').textContent = `~${Math.round(etaMin)}m`;
      document.getElementById('stat-eta').className = 'text-2xl font-black text-yellow-400';
    } else {
      document.getElementById('stat-eta').textContent = `~${Math.round(etaMin/60)}h`;
      document.getElementById('stat-eta').className = 'text-2xl font-black text-green-400';
    }

    // Update map
    updateMap(lat, lon, dist);

    // Reverse geocode periodically (not every 5s to avoid rate limiting)
    if (!lastISSPos || haversine(lastISSPos.lat, lastISSPos.lon, lat, lon) > 200) {
      reverseGeocode(lat, lon).then(loc => {
        document.getElementById('over-location').textContent = loc;
        // Israel alert
        const isMiddleEast = lat > 29 && lat < 35 && lon > 34 && lon < 37;
        document.getElementById('israel-alert').classList.toggle('hidden', !isMiddleEast);
      });
      lastISSPos = { lat, lon };
    }

    // Generate portrait if overhead and not already done
    if (dist < MAX_OVERHEAD_KM && !hasGenerated) {
      hasGenerated = true;
      generateOverheadPortrait(lat, lon, dist);
    }

  } catch (err) {
    console.error('ISS fetch error:', err);
  }
}

function updateMap(lat, lon, dist) {
  const pos = lonLatToSvg(lon, lat);

  // Update ISS icon
  document.getElementById('iss-icon').setAttribute('transform', `translate(${pos.x}, ${pos.y})`);

  // Footprint (visibility cone ~2200km radius → ~8.5° of lat)
  const footprintR = (2200 / 20000) * 720 * 0.5;
  const fp = document.getElementById('iss-footprint');
  fp.setAttribute('cx', pos.x);
  fp.setAttribute('cy', pos.y);
  fp.setAttribute('r', footprintR);

  // Trail
  trail.push({ x: pos.x, y: pos.y });
  if (trail.length > 40) trail.shift();

  const trailG = document.getElementById('trail-dots');
  trailG.innerHTML = trail.map((p, i) => {
    const opacity = (i / trail.length) * 0.5;
    const r = 1 + (i / trail.length) * 1.5;
    return `<circle cx="${p.x}" cy="${p.y}" r="${r}" fill="#7c3aed" opacity="${opacity}"/>`;
  }).join('');
}

let selectedModel = 'flux';
function setModel(m) {
  selectedModel = m;
  document.getElementById('model-flux-btn').className = m === 'flux'
    ? 'px-3 py-1.5 bg-purple-500/20 text-purple-300 font-semibold'
    : 'px-3 py-1.5 bg-white/5 text-slate-400 hover:bg-white/10 transition-colors';
  document.getElementById('model-gpt-btn').className = m === 'gpt'
    ? 'px-3 py-1.5 bg-green-500/20 text-green-300 font-semibold'
    : 'px-3 py-1.5 bg-white/5 text-slate-400 hover:bg-white/10 transition-colors';
  document.getElementById('gpt-image-row').classList.toggle('hidden', m !== 'gpt');
}
window.setModel = setModel;

async function generateOverheadPortrait(issLat, issLon, dist) {
  document.getElementById('flux-panel').classList.add('hidden');
  document.getElementById('flux-loading').classList.remove('hidden');
  document.getElementById('flux-loading').classList.add('flex');

  const issLatText = issLat ? issLat.toFixed(2) : '—';
  const issLonText = issLon ? issLon.toFixed(2) : '—';
  const distText = dist ? Math.round(dist).toLocaleString() : '—';
  const altText = document.getElementById('iss-alt')?.textContent || '—';
  const velText = document.getElementById('iss-vel')?.textContent || '—';

  const fluxPrompt = `Portrait of a man with dark wavy hair, round tortoiseshell glasses, looking upward in wonder at the night sky, the International Space Station visible as a bright streak overhead, dramatic upward angle, city lights below, awe and excitement, cinematic space photography, photorealistic, high detail`;
  const gptPrompt = `The International Space Station orbiting Earth against the blackness of space, glowing against a stunning blue Earth limb.

Include a NASA-style mission data overlay:
"🛸 ISS Live Position"
"Latitude: ${issLatText}°  Longitude: ${issLonText}°"
"Altitude: ${altText}"
"Velocity: ${velText}"
"Distance from you: ${distText} km"

NASA-quality photography, dramatic orbital perspective, photorealistic.`;
  const prompt = selectedModel === 'gpt' ? gptPrompt : fluxPrompt;

  try {
    const customImageUrl = document.getElementById('custom-image-url')?.value.trim() || '';
    const resp = await fetch(selectedModel === 'gpt' ? '/api/gpt-image-2' : '/api/flux-generate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(selectedModel === 'gpt'
        ? { prompt, ...(customImageUrl ? { inputImageUrl: customImageUrl } : {}) }
        : { prompt }),
    });
    const data = await resp.json();

    if (data.status === 'succeeded' && data.output) {
      showFluxResult(data.output);
      return;
    }

    if (data.id) {
      await pollFlux(data.id);
    }
  } catch (err) {
    document.getElementById('flux-loading').classList.add('hidden');
    document.getElementById('flux-panel').classList.remove('hidden');
    console.error('FLUX error:', err);
  }
}

async function pollFlux(id) {
  for (let i = 0; i < 30; i++) {
    await new Promise(r => setTimeout(r, 3000));
    try {
      const r = await fetch(`/api/flux-poll?id=${id}`);
      const d = await r.json();
      if (d.status === 'succeeded' && d.output) { showFluxResult(d.output); return; }
      if (d.status === 'failed') break;
    } catch { break; }
  }
  document.getElementById('flux-loading').classList.add('hidden');
  document.getElementById('flux-panel').classList.remove('hidden');
}

function showFluxResult(output) {
  const url = Array.isArray(output) ? output[0] : output;
  document.getElementById('flux-loading').classList.add('hidden');
  document.getElementById('flux-result').classList.remove('hidden');
  document.getElementById('flux-result').classList.add('flex');
  document.getElementById('flux-img').src = url;
}

// Init geolocation
navigator.geolocation.getCurrentPosition(
  (pos) => {
    userLat = pos.coords.latitude;
    userLon = pos.coords.longitude;
    const up = lonLatToSvg(userLon, userLat);
    document.getElementById('user-dot').setAttribute('cx', up.x);
    document.getElementById('user-dot').setAttribute('cy', up.y);
    document.getElementById('user-pulse').setAttribute('cx', up.x);
    document.getElementById('user-pulse').setAttribute('cy', up.y);
  },
  () => {
    // Chicago default
    const up = lonLatToSvg(-87.6298, 41.8781);
    document.getElementById('user-dot').setAttribute('cx', up.x);
    document.getElementById('user-dot').setAttribute('cy', up.y);
    document.getElementById('user-pulse').setAttribute('cx', up.x);
    document.getElementById('user-pulse').setAttribute('cy', up.y);
  }
);

fetchISS();
setInterval(fetchISS, 5000);
</script>
