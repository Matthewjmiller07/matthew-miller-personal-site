---
import Layout from '../layouts/Layout.astro';
import data from '../data/kashrus-publications.json';

const publications = [
  { key: 'dafHaKashrus',    ...data.dafHaKashrus },
  { key: 'kashrusKurrents', ...data.kashrusKurrents },
  { key: 'kosherConnect',   ...data.kosherConnect },
  { key: 'hashgachaPratit', ...data.hashgachaPratit },
];

const colorMap = {
  blue:   { badge: 'bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200', ring: 'ring-blue-400', tab: 'data-[active]:bg-blue-600 data-[active]:text-white', pill: 'bg-blue-600' },
  green:  { badge: 'bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200', ring: 'ring-green-400', tab: 'data-[active]:bg-green-600 data-[active]:text-white', pill: 'bg-green-600' },
  purple: { badge: 'bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200', ring: 'ring-purple-400', tab: 'data-[active]:bg-purple-600 data-[active]:text-white', pill: 'bg-purple-600' },
  orange: { badge: 'bg-orange-100 dark:bg-orange-900 text-orange-800 dark:text-orange-200', ring: 'ring-orange-400', tab: 'data-[active]:bg-orange-600 data-[active]:text-white', pill: 'bg-orange-600' },
};

const kindLabel: Record<string, string> = {
  regular:  'Issue',
  consumer: 'Consumer Ed.',
  btu:      'Behind the Union',
  special:  'Special',
};
---

<Layout
  title="Kashrus Publications"
  description="Browse issues of Daf Ha-Kashrus (OU Kosher), Kashrus Kurrents (Star-K), and Kosher Connect (OK Kosher) — three major kosher certification newsletters."
>
  <main class="max-w-5xl mx-auto px-4 py-10">

    <header class="text-center mb-10">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
        Kashrus Publications
      </h1>
      <p class="text-lg text-gray-300 max-w-2xl mx-auto">
        Issues from three major kosher certification agencies — OU Kosher, Star-K, and OK Kosher.
      </p>
      <div class="flex justify-center gap-6 mt-6 text-sm text-gray-400 flex-wrap">
        <span><strong class="text-white">{data.dafHaKashrus.issues.length}</strong> Daf Ha-Kashrus issues</span>
        <span><strong class="text-white">{data.kashrusKurrents.issues.length}</strong> Kashrus Kurrents issues</span>
        <span><strong class="text-white">{data.kosherConnect.issues.length}</strong> Kosher Connect volumes</span>
        <span><strong class="text-white">{data.hashgachaPratit.issues.length}</strong> Hashgacha Pratit bulletins</span>
      </div>
    </header>

    <!-- Tab buttons -->
    <div class="flex gap-2 mb-8 flex-wrap justify-center" id="pub-tabs">
      {publications.map((pub, i) => {
        const c = colorMap[pub.color as keyof typeof colorMap];
        return (
          <button
            data-tab={pub.key}
            class={`px-5 py-2 rounded-full font-semibold text-sm transition-colors border border-transparent
              text-gray-400 hover:text-white hover:bg-gray-700
              ${i === 0 ? `${c.pill} text-white` : ''}`}
          >
            {pub.name}
            <span class="ml-2 text-xs opacity-75">({pub.issues.length})</span>
          </button>
        );
      })}
    </div>

    <!-- Publication panels -->
    {publications.map((pub, i) => {
      const c = colorMap[pub.color as keyof typeof colorMap];
      const dafIssues = pub.key === 'dafHaKashrus'
        ? (pub.issues as any[]).filter((x: any) => x.kind === 'regular')
        : null;
      const dafConsumer = pub.key === 'dafHaKashrus'
        ? (pub.issues as any[]).filter((x: any) => x.kind === 'consumer')
        : null;
      const dafBtu = pub.key === 'dafHaKashrus'
        ? (pub.issues as any[]).filter((x: any) => x.kind === 'btu')
        : null;
      const dafSpecial = pub.key === 'dafHaKashrus'
        ? (pub.issues as any[]).filter((x: any) => x.kind === 'special')
        : null;

      return (
        <div
          id={`panel-${pub.key}`}
          class={`publication-panel ${i !== 0 ? 'hidden' : ''}`}
        >
          <!-- Publication header -->
          <div class="bg-gray-800 rounded-xl p-6 mb-6 flex flex-col md:flex-row md:items-center gap-4">
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-2">
                <h2 class="text-2xl font-bold text-white">{pub.name}</h2>
                <span class={`text-xs font-semibold px-2 py-1 rounded-full ${c.badge}`}>
                  {pub.publisher}
                </span>
              </div>
              <p class="text-gray-300 text-sm">{pub.description}</p>
            </div>
            <a
              href={pub.url}
              target="_blank"
              rel="noopener noreferrer"
              class="shrink-0 px-4 py-2 bg-gray-700 hover:bg-gray-600 text-white text-sm rounded-lg transition-colors"
            >
              Visit Site →
            </a>
          </div>

          <!-- Search box -->
          <div class="mb-4">
            <input
              type="text"
              placeholder={`Search ${pub.name} issues…`}
              class="issue-search w-full px-4 py-2 bg-gray-800 text-white rounded-lg border border-gray-700 focus:outline-none focus:border-gray-500 text-sm"
              data-panel={pub.key}
            />
          </div>

          {/* Daf Ha-Kashrus: grouped by kind */}
          {pub.key === 'dafHaKashrus' && (
            <div class="space-y-8">
              {[
                { label: 'Regular Issues', items: dafIssues, kind: 'regular' },
                { label: 'Consumer Editions', items: dafConsumer, kind: 'consumer' },
                { label: 'Behind the Union Symbol', items: dafBtu, kind: 'btu' },
                { label: 'Special Issues', items: dafSpecial, kind: 'special' },
              ].map(group => group.items && group.items.length > 0 && (
                <div class="issue-group" data-kind={group.kind}>
                  <h3 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-3">
                    {group.label} ({group.items.length})
                  </h3>
                  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2">
                    {group.items.map((issue: any) => (
                      <a
                        href={issue.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={`issue-item bg-gray-800 hover:bg-gray-700 rounded-lg px-3 py-2 text-sm text-gray-200 hover:text-white transition-colors flex items-center gap-2 ring-1 ring-gray-700 hover:${c.ring}`}
                        data-label={issue.label.toLowerCase()}
                      >
                        <span class="text-gray-500 shrink-0">↗</span>
                        <span class="truncate">{issue.label}</span>
                      </a>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          )}

          {/* Kashrus Kurrents: simple grid */}
          {pub.key === 'kashrusKurrents' && (
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
              {(pub.issues as any[]).map((issue: any) => (
                <a
                  href={issue.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`issue-item bg-gray-800 hover:bg-gray-700 rounded-lg px-4 py-3 text-sm text-gray-200 hover:text-white transition-colors flex items-center gap-2 ring-1 ring-gray-700 hover:${c.ring}`}
                  data-label={issue.label.toLowerCase()}
                >
                  <span class="text-green-400 shrink-0">PDF</span>
                  <span>{issue.label}</span>
                </a>
              ))}
            </div>
          )}

          {/* OK Kosher Connect: monthly volumes */}
          {pub.key === 'kosherConnect' && (
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
              {(pub.issues as any[]).map((issue: any) => (
                <a
                  href={issue.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`issue-item bg-gray-800 hover:bg-gray-700 rounded-xl px-4 py-3 text-gray-200 hover:text-white transition-colors flex items-center gap-3 ring-1 ring-gray-700 hover:${c.ring}`}
                  data-label={issue.label.toLowerCase()}
                >
                  <span class="text-purple-400 text-xs font-bold shrink-0">READ</span>
                  <span class="text-sm">{issue.label}</span>
                </a>
              ))}
            </div>
          )}

          {/* Hashgacha Pratit: PDF grid */}
          {pub.key === 'hashgachaPratit' && (
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2">
              {(pub.issues as any[]).map((issue: any) => (
                <a
                  href={issue.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`issue-item bg-gray-800 hover:bg-gray-700 rounded-lg px-3 py-2 text-sm text-gray-200 hover:text-white transition-colors flex items-center gap-2 ring-1 ring-gray-700 hover:${c.ring}`}
                  data-label={issue.label.toLowerCase()}
                >
                  <span class="text-orange-400 shrink-0">PDF</span>
                  <span class="truncate">{issue.label}</span>
                </a>
              ))}
            </div>
          )}

          <p class="mt-4 text-xs text-gray-600 text-center">
            {pub.issues.length} issues — links open original source
          </p>
        </div>
      );
    })}
  </main>
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    const tabs = document.querySelectorAll<HTMLButtonElement>('#pub-tabs button');
    const panels = document.querySelectorAll<HTMLElement>('.publication-panel');

    const colorPills: Record<string, string> = {
      'panel-dafHaKashrus':    'bg-blue-600',
      'panel-kashrusKurrents': 'bg-green-600',
      'panel-kosherConnect':   'bg-purple-600',
      'panel-hashgachaPratit': 'bg-orange-600',
    };

    function activateTab(key: string) {
      tabs.forEach(t => {
        const isActive = t.dataset.tab === key;
        t.classList.toggle('text-white', isActive);
        t.classList.toggle('text-gray-400', !isActive);
        // remove all pill colors, add active one
        Object.values(colorPills).forEach(cls => t.classList.remove(cls));
        if (isActive) t.classList.add(colorPills[`panel-${key}`]);
      });
      panels.forEach(p => {
        p.classList.toggle('hidden', p.id !== `panel-${key}`);
      });
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => activateTab(tab.dataset.tab!));
    });

    // Search
    document.querySelectorAll<HTMLInputElement>('.issue-search').forEach(input => {
      input.addEventListener('input', () => {
        const q = input.value.toLowerCase().trim();
        const panel = document.getElementById(`panel-${input.dataset.panel}`);
        if (!panel) return;
        panel.querySelectorAll<HTMLElement>('.issue-item').forEach(item => {
          const match = !q || item.dataset.label?.includes(q);
          item.style.display = match ? '' : 'none';
        });
        // Hide empty groups
        panel.querySelectorAll<HTMLElement>('.issue-group').forEach(group => {
          const visible = Array.from(group.querySelectorAll<HTMLElement>('.issue-item'))
            .some(el => el.style.display !== 'none');
          group.style.display = visible ? '' : 'none';
        });
      });
    });
  });
</script>
