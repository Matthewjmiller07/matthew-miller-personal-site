---
import Layout from '../layouts/Layout.astro';
import KINGS from '../data/genealogies/kings.json';

const nJudah = KINGS.filter((k) => k.kingdom === 'judah').length;
const nIsrael = KINGS.filter((k) => k.kingdom === 'israel').length;
---

<Layout
  title="Kings' Names: Judah vs Israel"
  description="Whose names live on? Every king of Judah and Israel, counted against 75 years of Israeli baby names from the Central Bureau of Statistics."
>
<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=Frank+Ruhl+Libre:wght@400;500;700;900&display=swap');
  body:has(.kn) { background: #07070a !important; padding: 0 !important; }
  .kn {
    color-scheme: dark;
    --bg: #07070a; --panel: #111116; --panel2: #18181f; --line: rgba(255,255,255,.09);
    --ink: #f0efec; --muted: #c3c2b7; --faint: #8b8a83; --gold: #f4c46a; --blue: #3987e5;
    --display: 'Oswald', 'Arial Narrow', sans-serif; --serif: 'Source Serif 4', Georgia, serif; --heb: 'Frank Ruhl Libre', 'Times New Roman', serif;
    background: var(--bg); color: var(--ink); font-family: var(--serif); min-height: 100vh; overflow-x: clip;
  }
  .kn * { box-sizing: border-box; }
  .kn a { color: inherit; }
  .kn .wrap { max-width: 1080px; margin: 0 auto; padding: 0 16px; }
  .kn h1, .kn h2, .kn .disp { font-family: var(--display); text-transform: uppercase; letter-spacing: .01em; line-height: .98; margin: 0; }
  .kn .he { font-family: var(--heb); direction: rtl; unicode-bidi: isolate; }
  .kn .eyebrow { font-family: var(--display); text-transform: uppercase; letter-spacing: .18em; font-size: .78rem; color: var(--gold); }
  .kn .muted { color: var(--muted); }
  .kn .faint { color: var(--faint); }
  .kn-hero { padding: 72px 0 32px; }
  .kn-hero h1 { font-size: clamp(2.6rem, 7vw, 4.6rem); margin: 10px 0 16px; }
  .kn-hero p { font-size: 1.12rem; line-height: 1.6; color: var(--muted); max-width: 720px; margin: 0 0 12px; }
  .kn-hero .back { font-family: var(--display); text-transform: uppercase; letter-spacing: .12em; font-size: .8rem; color: var(--gold); text-decoration: none; }
  .kn .tiles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin: 28px 0 8px; }
  .kn .tile { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 16px; }
  .kn .tile b { display: block; font-family: var(--display); font-size: 1.9rem; line-height: 1; }
  .kn .tile span { color: var(--muted); font-size: .85rem; line-height: 1.4; display: block; margin-top: 6px; }
  .kn .tile.judah b { color: var(--gold); }
  .kn .tile.israel b { color: var(--blue); }
  .kn section { padding: 40px 0 8px; }
  .kn .sec-head { margin-bottom: 16px; }
  .kn .sec-head h2 { font-size: 1.7rem; margin-top: 8px; }
  .kn .sec-head p { color: var(--muted); line-height: 1.6; max-width: 760px; }
  .kn .card { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 16px; }
  .kn .chart-wrap { position: relative; }
  .kn #chart-read { position: absolute; top: 12px; right: 16px; text-align: right; font-size: .85rem; line-height: 1.5; pointer-events: none; }
  .kn #chart-read b { font-family: var(--display); }
  .kn .legend { display: flex; gap: 20px; margin-top: 12px; font-size: .9rem; color: var(--muted); }
  .kn .legend i { display: inline-block; width: 22px; height: 4px; border-radius: 2px; vertical-align: middle; margin-right: 6px; }
  .kn .fgroup { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 0 0 14px; }
  .kn .fgroup .k { font-family: var(--display); text-transform: uppercase; letter-spacing: .12em; font-size: .75rem; color: var(--faint); margin-right: 4px; }
  .kn .chip { font-family: var(--display); text-transform: uppercase; letter-spacing: .06em; font-size: .8rem; background: var(--panel2); color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: 6px 14px; cursor: pointer; }
  .kn .chip[aria-pressed="true"] { background: var(--gold); color: #171207; border-color: var(--gold); }
  .kn .tblwrap { overflow-x: auto; }
  .kn table { width: 100%; border-collapse: collapse; font-size: .95rem; }
  .kn th { font-family: var(--display); text-transform: uppercase; letter-spacing: .08em; font-size: .75rem; text-align: left; color: var(--faint); padding: 10px 10px 10px 0; border-bottom: 1px solid var(--line); cursor: pointer; white-space: nowrap; }
  .kn th.num, .kn td.num { text-align: right; }
  .kn td { padding: 10px 10px 10px 0; border-bottom: 1px solid rgba(255,255,255,.05); vertical-align: top; }
  .kn td .note { display: block; color: var(--faint); font-size: .82rem; line-height: 1.45; margin-top: 3px; max-width: 420px; }
  .kn td .flag { color: var(--gold); }
  .kn tr.judah td:first-child { border-left: 3px solid var(--gold); padding-left: 8px; }
  .kn tr.israel td:first-child { border-left: 3px solid var(--blue); padding-left: 8px; }
  .kn .sources { color: var(--muted); line-height: 1.7; font-size: .95rem; }
  .kn .sources p { margin: 0 0 14px; max-width: 800px; }
  .kn .sources a { color: var(--gold); }
  @media (max-width: 760px) {
    .kn .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .kn #chart-read { position: static; text-align: left; margin-bottom: 8px; }
  }
</style>

<div class="kn">
  <div class="wrap">
    <header class="kn-hero">
      <a class="back" href="/genealogies">← The Book of Generations</a>
      <div style="margin-top:22px"><div class="eyebrow">Kings · Judah vs Israel</div>
      <h1>Whose names live on?</h1></div>
      <p>After the kingdom split, {nJudah} monarchs ruled Judah and {nIsrael} ruled Israel. Counted against 75 years of Israeli baby names, the two kingdoms' names have had very different afterlives: Israel's kings' names win by a wide margin, and some kings' names were never given to a baby at all.</p>
      <p>Same source as <a href="/genealogies" style="color:var(--gold)">the genealogy explorer</a>: the Central Bureau of Statistics, 1949–2024, matched by Hebrew spelling.</p>
    </header>

    <div class="tiles" id="tiles">
      <div class="tile judah"><b>–</b><span>Israeli babies named for a king of Judah, 1949–2024</span></div>
      <div class="tile israel"><b>–</b><span>Israeli babies named for a king of Israel, 1949–2024</span></div>
      <div class="tile"><b>–</b><span id="verdict">The verdict, once the names load</span></div>
      <div class="tile"><b>–</b><span id="extinct">Kings' names not on record</span></div>
    </div>

    <section>
      <div class="sec-head"><div><div class="eyebrow">I · The trend</div><h2>Year by year, 1949–2024</h2></div>
      <p>Every baby given a king's name in each year, summed per kingdom. Israel's line pulls away early and never looks back — its names (Menachem, Nadav, Shalom, Yoram) stayed in everyday use, while Judah's names cluster in a few favourites.</p></div>
      <div class="card chart-wrap">
        <div id="chart-read"></div>
        <svg id="chart" viewBox="0 0 900 360" width="100%" role="img" aria-label="Babies named for kings of Judah vs Israel, per year 1949–2024"></svg>
      </div>
      <div class="legend"><span><i style="background:var(--gold)"></i>Judah</span><span><i style="background:var(--blue)"></i>Israel</span></div>
    </section>

    <section>
      <div class="sec-head"><div><div class="eyebrow">II · Every king</div><h2>The table</h2></div>
      <p>One row per monarch, in succession order within each kingdom. “Babies” is the 1949–2024 yearly count; “All-time” is the totals table (see the method note below). <span class="flag">*</span> means the spelling is mostly a different name today and is left out of the kingdom totals. † means the name appears in both kingdoms. “Not on record” means fewer than five babies of one sex in a population group across the whole period, or none at all.</p></div>
      <div class="fgroup" id="f-kingdom"><span class="k">Kingdom</span>
        <button class="chip" data-v="all" aria-pressed="true">Both</button>
        <button class="chip" data-v="judah" aria-pressed="false">Judah</button>
        <button class="chip" data-v="israel" aria-pressed="false">Israel</button>
      </div>
      <div class="fgroup" id="f-order"><span class="k">Order</span>
        <button class="chip" data-v="babies" aria-pressed="true">Most babies</button>
        <button class="chip" data-v="bible" aria-pressed="false">Bible order</button>
        <button class="chip" data-v="en" aria-pressed="false">A–Z</button>
      </div>
      <div class="card tblwrap"><table id="tbl"><thead><tr>
        <th data-k="en">King</th><th>Hebrew</th><th data-k="kingdom">Kingdom</th><th data-k="order">#</th>
        <th class="num" data-k="babies">Babies 1949–2024</th><th class="num" data-k="all">All-time</th><th data-k="peak">Peak year</th>
      </tr></thead><tbody></tbody></table></div>
    </section>

    <section>
      <div class="sec-head"><div><div class="eyebrow">Sources</div><h2>Where this comes from</h2></div></div>
      <div class="sources">
        <p>Kings: the monarchs of Judah and Israel after the split, in succession order, from the books of Kings and Chronicles. Athaliah counts as Judah's seventh monarch — its only reigning queen. Jeroboam I and Jeroboam II share one name, so the name is counted once.</p>
        <p>Israeli names: <a href="https://www.cbs.gov.il/he/mediarelease/DocLib/2025/391/11_25_391t1.xlsx">Central Bureau of Statistics, release 391/2025</a>, names of babies born in Israel 1949–2024 by population group and sex, via the CC0 <a href="https://github.com/aviezerl/babynamesIL">babynamesIL</a> package by Aviezer Lifshitz — the same source as <a href="/genealogies">the genealogy explorer</a>. Yearly counts only include a name in years when five or more babies got it; all-time totals include every registration, but only for names given to at least five babies of one sex in a population group over the whole period. That is why the two columns differ, and why a name can be “not on record” without literally having zero babies.</p>
        <p>Counting rules: each distinct Hebrew spelling is counted once per kingdom, summed across population groups and sexes. Names shared by both kingdoms (Ahaziah, Jehoahaz, Joash in its two spellings, Jehoram/Joram) are counted in each kingdom under their own spelling — all but Joash are not on record anyway. Elah (אלה) is flagged *: in the data it is overwhelmingly a modern girls' name, so it is shown but left out of Israel's total and the chart. Uzziah's Kings spelling עזיה is left out for the same reason (in the data it is mostly an Arabic girls' name); his counted spellings are עוזיהו and עוזיה.</p>
        <p>Data: <code>src/data/genealogies/kings.json</code> (the kings) and <code>public/data/genealogies/kings-names.json</code> (the counts), built by <code>scripts/genealogies/build-kings-data.py</code>.</p>
      </div>
    </section>
  </div>
</div>

<script type="application/json" id="kn-kings" set:html={JSON.stringify(KINGS)}></script>

<script>
  const KINGS = JSON.parse(document.getElementById('kn-kings').textContent);
  const Y0 = 1949, NY = 76;
  const fmt = (n) => n.toLocaleString('en-US');
  const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;');
  const groupLabel = (g) => {
    const [sec, sex] = g.split('|');
    return `${sec} ${sex === 'M' ? 'boys' : 'girls'}`;
  };
  let NAMES = null;
  let kingdom = 'all', order = 'babies';

  const entry = (sp) => (NAMES ? NAMES.names[sp] : null);
  const seriesSum = (sp) => {
    const e = entry(sp);
    if (!e) return 0;
    return Object.values(e.series).reduce((t, arr) => t + arr.reduce((a, b) => a + b, 0), 0);
  };
  const allSum = (sp) => {
    const e = entry(sp);
    if (!e) return 0;
    return Object.values(e.totals).reduce((a, b) => a + b, 0);
  };
  const kingBabies = (k) => k.names.reduce((t, s) => t + seriesSum(s), 0);
  const kingAll = (k) => k.names.reduce((t, s) => t + allSum(s), 0);
  const kingPeak = (k) => {
    let best = null;
    for (const s of k.names) {
      const e = entry(s);
      if (e && e.peak && (!best || e.peak.n > best.n)) best = e.peak;
    }
    return best;
  };

  function renderTiles() {
    const sums = { judah: 0, israel: 0 };
    for (const k of KINGS) {
      if (!k.homograph) sums[k.kingdom] += kingBabies(k);
    }
    const tiles = document.querySelectorAll('#tiles .tile b');
    tiles[0].textContent = fmt(sums.judah);
    tiles[1].textContent = fmt(sums.israel);
    const ratio = sums.judah ? (sums.israel / sums.judah) : 0;
    tiles[2].textContent = ratio.toFixed(1) + '×';
    document.getElementById('verdict').textContent =
      `Israel's kings' names were given to ${ratio.toFixed(1)} times as many babies as Judah's, 1949–2024`;
    const extinctRows = KINGS.filter((k) => kingAll(k) === 0);
    const extinctNames = new Set(extinctRows.flatMap((k) => k.names)).size;
    tiles[3].textContent = extinctRows.length + ' kings';
    document.getElementById('extinct').textContent =
      `${extinctRows.length} kings' names not on record, across ${extinctNames} distinct names`;
  }

  function yearly(kingdomKey) {
    const seen = new Set();
    const arr = new Array(NY).fill(0);
    for (const k of KINGS) {
      if (k.kingdom !== kingdomKey || k.homograph) continue;
      for (const s of k.names) {
        if (seen.has(s)) continue;
        seen.add(s);
        const e = entry(s);
        if (!e) continue;
        for (const series of Object.values(e.series)) {
          for (let i = 0; i < NY; i++) arr[i] += series[i] || 0;
        }
      }
    }
    return arr;
  }

  function drawChart() {
    const svg = document.getElementById('chart');
    const W = 900, H = 360, ML = 56, MR = 16, MT = 20, MB = 34;
    const j = yearly('judah'), s = yearly('israel');
    const max = Math.max(1, ...j, ...s);
    const x = (i) => ML + (i / (NY - 1)) * (W - ML - MR);
    const y = (v) => MT + (1 - v / max) * (H - MT - MB);
    const path = (arr) => arr.map((v, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(' ');
    let html = '';
    for (let f = 0; f <= 4; f++) {
      const v = Math.round((max * f) / 4);
      const yy = y(v);
      html += `<line x1="${ML}" y1="${yy}" x2="${W - MR}" y2="${yy}" stroke="rgba(255,255,255,.08)"/><text x="${ML - 8}" y="${yy + 4}" text-anchor="end" font-size="11" fill="#8b8a83">${fmt(v)}</text>`;
    }
    for (let yr = 1950; yr <= 2024; yr += 10) {
      const xx = x(yr - Y0);
      html += `<text x="${xx}" y="${H - 10}" text-anchor="middle" font-size="11" fill="#8b8a83">${yr}</text>`;
    }
    html += `<path d="${path(s)}" fill="none" stroke="#3987e5" stroke-width="2.5" stroke-linejoin="round"/>`;
    html += `<path d="${path(j)}" fill="none" stroke="#f4c46a" stroke-width="2.5" stroke-linejoin="round"/>`;
    html += `<rect id="chart-hover" x="0" y="${MT}" width="1" height="${H - MT - MB}" fill="rgba(255,255,255,.25)" opacity="0"/>`;
    html += `<circle id="chart-dot-j" r="4.5" fill="#f4c46a" opacity="0"/><circle id="chart-dot-s" r="4.5" fill="#3987e5" opacity="0"/>`;
    svg.innerHTML = html;
    const read = document.getElementById('chart-read');
    const dotJ = svg.querySelector('#chart-dot-j'), dotS = svg.querySelector('#chart-dot-s'), hov = svg.querySelector('#chart-hover');
    svg.addEventListener('mousemove', (ev) => {
      const r = svg.getBoundingClientRect();
      const px = ((ev.clientX - r.left) / r.width) * W;
      let i = Math.round(((px - ML) / (W - ML - MR)) * (NY - 1));
      i = Math.max(0, Math.min(NY - 1, i));
      hov.setAttribute('x', x(i)); hov.setAttribute('opacity', 1);
      dotJ.setAttribute('cx', x(i)); dotJ.setAttribute('cy', y(j[i])); dotJ.setAttribute('opacity', 1);
      dotS.setAttribute('cx', x(i)); dotS.setAttribute('cy', y(s[i])); dotS.setAttribute('opacity', 1);
      read.innerHTML = `<b>${Y0 + i}</b><br><span style="color:#f4c46a">Judah ${fmt(j[i])}</span> · <span style="color:#3987e5">Israel ${fmt(s[i])}</span>`;
    });
    svg.addEventListener('mouseleave', () => {
      hov.setAttribute('opacity', 0); dotJ.setAttribute('opacity', 0); dotS.setAttribute('opacity', 0);
      read.innerHTML = '';
    });
  }

  function drawTable() {
    let rows = KINGS.filter((k) => kingdom === 'all' || k.kingdom === kingdom);
    const by = {
      babies: (a, b) => kingBabies(b) - kingBabies(a),
      bible: (a, b) => (a.kingdom === b.kingdom ? a.order - b.order : (a.kingdom < b.kingdom ? -1 : 1)),
      en: (a, b) => a.en.localeCompare(b.en),
    }[order];
    rows = [...rows].sort(by);
    const tb = document.querySelector('#tbl tbody');
    tb.innerHTML = rows.map((k) => {
      const b = kingBabies(k), a = kingAll(k), p = kingPeak(k);
      const flag = (k.homograph ? ' *' : '') + (k.shared ? ' †' : '');
      const babiesCell = k.homograph ? '<span class="faint">— *</span>'
        : (b === 0 && a === 0 ? '<span class="faint">Not on record</span>' : fmt(b));
      const allCell = a === 0 ? '<span class="faint">Not on record</span>' : fmt(a) + (k.homograph ? ' *' : '');
      return `<tr class="${k.kingdom}"><td><b>${esc(k.en)}</b><span class="flag">${flag}</span>${k.note ? `<span class="note">${esc(k.note)}</span>` : ''}</td>`
        + `<td class="he">${esc(k.he)}</td><td>${k.kingdom === 'judah' ? 'Judah' : 'Israel'}</td><td class="num">${k.order}</td>`
        + `<td class="num">${babiesCell}</td><td class="num">${allCell}</td>`
        + `<td>${p ? `${fmt(p.n)} in ${p.year} (${groupLabel(p.group)})` : '<span class="faint">—</span>'}</td></tr>`;
    }).join('');
  }

  function renderAll() { renderTiles(); drawChart(); drawTable(); }

  function initKings() {
    document.querySelectorAll('#f-kingdom .chip').forEach((c) => c.addEventListener('click', () => {
      document.querySelectorAll('#f-kingdom .chip').forEach((x) => x.setAttribute('aria-pressed', 'false'));
      c.setAttribute('aria-pressed', 'true');
      kingdom = c.dataset.v; drawTable();
    }));
    document.querySelectorAll('#f-order .chip').forEach((c) => c.addEventListener('click', () => {
      document.querySelectorAll('#f-order .chip').forEach((x) => x.setAttribute('aria-pressed', 'false'));
      c.setAttribute('aria-pressed', 'true');
      order = c.dataset.v; drawTable();
    }));
    fetch('/data/genealogies/kings-names.json').then((r) => r.json()).then((d) => {
      NAMES = d; renderAll();
    });
  }
  document.addEventListener('astro:page-load', initKings);
</script>
</Layout>
