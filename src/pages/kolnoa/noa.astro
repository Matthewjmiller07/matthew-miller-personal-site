---
import Layout from '../../layouts/Layout.astro';
import { POSES, clientData } from '../../lib/kolnoa-noa.js';
import audio from '../../data/kolnoa-audio/noa.json';

// Jev's `when` criteria stay server-side.
const data = clientData(audio.files);
---

<Layout
  title="Talk to Noa — Kolnoa"
  description="Noa is seven, curious, and only wants to talk Hebrew. Answer her questions and Jev works out what you said, so she can react."
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;500;700&family=Fraunces:opsz,wght@9..144,600;9..144,800&display=swap"
  />
  {POSES.map((p) => <link rel="preload" as="image" href={`/images/kolnoa/noa-${p}.webp`} />)}

  <main class="nn">
    <header class="nn-head">
      <p class="nn-kicker"><a href="/kolnoa">קולנוע · kolnoa</a> · talk to Noa</p>
      <h1>נועה <span>Noa</span></h1>
      <p class="nn-sub">She's seven, she loves pink, and she only wants to talk Hebrew. Answer her questions and see how she reacts.</p>
    </header>

    <div class="nn-grid">
      <section class="nn-stage">
        <div class="nn-bubble" id="nn-bubble">
          <p class="nn-bhe" id="nn-bhe" dir="rtl" lang="he"></p>
          <p class="nn-ben" id="nn-ben"></p>
        </div>
        <img id="nn-img" src="/images/kolnoa/noa-wave.webp" alt="Noa, a little girl with curly hair, a pink bow and a flowered dress" width="400" height="600" />
        <div class="nn-badge" id="nn-badge" hidden></div>
        <div class="nn-hearts" id="nn-hearts" aria-label="Hearts"></div>
      </section>

      <section class="nn-chat">
        <div class="nn-start" id="nn-start">
          <p>Noa will talk to you as…</p>
          <div class="nn-pick">
            <button class="nn-btn nn-primary" data-g="m"><b dir="rtl">אתה</b> him</button>
            <button class="nn-btn nn-primary" data-g="f"><b dir="rtl">את</b> her</button>
          </div>
          <p class="nn-small">Hebrew says "you" differently to a man and a woman, so Noa needs to know which to use.</p>
        </div>

        <div id="nn-talk" hidden>
          <div class="nn-steps" id="nn-steps" aria-label="Progress"></div>
          <ol class="nn-log" id="nn-log"></ol>
          <div class="nn-hints" id="nn-hints" hidden></div>
          <form class="nn-row" id="nn-form">
            <input id="nn-answer" dir="rtl" lang="he" autocomplete="off" placeholder="תשובה…" />
            <button class="nn-btn nn-primary" id="nn-send" disabled>Answer</button>
          </form>
          <div class="nn-row nn-tools">
            <button class="nn-btn" id="nn-help" type="button">💡 Help me answer</button>
            <button class="nn-btn" id="nn-again" type="button">↺ Say it again</button>
            <button class="nn-btn" id="nn-mute" type="button">🔊 Sound on</button>
            <button class="nn-btn" id="nn-skip" type="button">Skip ▸</button>
            <label class="nn-small"><input type="checkbox" id="nn-showen" checked /> English under Noa</label>
          </div>
          <p class="nn-small">No Hebrew keyboard? Write it in English letters: <i>ani ohev pizza</i>.</p>
        </div>

        <div class="nn-end" id="nn-end" hidden>
          <p id="nn-sum"></p>
          <div class="nn-row">
            <button class="nn-btn nn-primary" id="nn-restart">Talk again</button>
            <a class="nn-btn" href="/kolnoa">Watch a talk ▸</a>
          </div>
        </div>
      </section>
    </div>

    <section class="nn-ext">
      <img src="/images/kolnoa/noa-cheer.webp" alt="" width="419" height="600" />
      <div>
        <h2>Noa in your browser</h2>
        <p>
          Put Noa in Chrome's toolbar and have a two-minute Hebrew chat whenever you open a new tab's worth of
          procrastination. Same questions, same voice, same hearts.
        </p>
        <div class="nn-row">
          <a class="nn-btn nn-primary" href="/kolnoa/noa-chrome.zip" download>⬇ Download the Chrome extension</a>
          <a class="nn-btn" href="#nn-install" id="nn-howto">How to install</a>
        </div>
        <ol class="nn-install" id="nn-install">
          <li>Unzip <code>noa-chrome.zip</code>.</li>
          <li>Open <code>chrome://extensions</code> and switch on <b>Developer mode</b> (top right).</li>
          <li>Click <b>Load unpacked</b> and choose the unzipped <code>noa</code> folder.</li>
          <li>Pin Noa from the puzzle-piece menu, then click her to talk.</li>
        </ol>
      </div>
    </section>

    <section class="nn-about">
      <h2>How Noa understands you</h2>
      <p>
        Noa doesn't make anything up. Every line she says was written in advance, with a handful of possible replies for
        each question. When you answer, <a href="https://typesafe.ai">Jev</a>, TypeSafe's small judgment model, reads it
        and makes three calls: is it Hebrew (Hebrew letters or transliterated), which of Noa's replies fits what you said,
        and whether your Hebrew sounds natural. Fit her question and she gives you a ♥; natural Hebrew earns a ✦.
      </p>
    </section>
  </main>

  <script type="application/json" id="nn-data" set:html={JSON.stringify(data)} />

  <style is:global>
    /* The site's Tailwind base colours every p/li/span/div (light grey in dark mode, dark grey in
       light mode). Noa's page has its own fixed palette, so text here inherits it instead; the
       rules below are .nn .nn-x so they outrank that base. */
    .nn.nn :where(p, li, span, div, label, b, i, section, ol) { color: inherit; }
    .nn {
      --bg: #0d0b0a; --panel: #17130f; --line: #2c241c; --ink: #f2e8d8; --mute: #a8977f;
      --gold: #e8b04a; --gold-soft: rgba(232, 176, 74, 0.18); --pink: #f2a7c3; --good: #7fcf8f;
      min-height: 100vh; background: radial-gradient(ellipse at top, #2a1a1e 0%, var(--bg) 55%) var(--bg);
      color: var(--ink); padding: 0 16px 64px;
    }
    .nn a { color: var(--gold); }
    .nn [hidden] { display: none !important; }
    .nn .nn-head, .nn .nn-grid, .nn .nn-about { max-width: 1040px; margin: 0 auto; }
    .nn .nn-head { padding: 40px 0 20px; }
    .nn .nn-kicker { font-size: 12px; letter-spacing: 0.25em; text-transform: uppercase; color: var(--mute); }
    .nn .nn-kicker a { text-decoration: none; }
    .nn .nn-head h1 { font-family: 'Frank Ruhl Libre', serif; font-size: clamp(44px, 8vw, 72px); line-height: 1; margin: 10px 0 8px; color: var(--pink); }
    .nn .nn-head h1 span { font-family: Fraunces, Georgia, serif; color: var(--ink); font-size: 0.6em; }
    .nn .nn-sub { color: #d8cbb6; max-width: 560px; line-height: 1.6; }

    .nn .nn-grid { display: grid; grid-template-columns: 360px minmax(0, 1fr); gap: 28px; align-items: start; }
    @media (max-width: 820px) { .nn .nn-grid { grid-template-columns: minmax(0, 1fr); } }
    .nn .nn-stage { position: relative; display: flex; flex-direction: column; align-items: center; padding-top: 8px; }
    .nn .nn-stage::before { content: ''; position: absolute; left: 50%; bottom: 40px; width: 300px; height: 300px; transform: translateX(-50%); background: radial-gradient(circle, rgba(242, 167, 195, 0.28), transparent 65%); pointer-events: none; }
    .nn .nn-stage img { position: relative; height: 380px; width: auto; filter: drop-shadow(0 10px 18px rgba(0, 0, 0, 0.5)); }
    @media (max-width: 820px) { .nn .nn-stage img { height: 260px; } }
    .nn .nn-stage img.pop { animation: pop 0.45s ease-out; }
    @keyframes pop { 0% { transform: translateY(6px) scale(0.97); } 50% { transform: translateY(-8px) scale(1.02); } 100% { transform: none; } }
    @media (prefers-reduced-motion: reduce) { .nn .nn-stage img.pop { animation: none; } }
    .nn .nn-bubble { position: relative; background: #fff6ec; color: #2a1d14; border-radius: 18px; padding: 12px 16px; margin-bottom: 14px; max-width: 340px; min-height: 64px; box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35); }
    .nn .nn-bubble::after { content: ''; position: absolute; left: 50%; bottom: -10px; border: 10px solid transparent; border-top-color: #fff6ec; border-bottom: 0; transform: translateX(-50%); }
    .nn .nn-bhe { color: #2a1d14; font-family: 'Frank Ruhl Libre', serif; font-size: 24px; line-height: 1.35; }
    .nn .nn-ben { font-size: 14px; color: #7a6650; margin-top: 4px; }
    .nn .nn-bubble.talking::before { content: '♪'; position: absolute; right: 12px; top: 8px; color: #d07a9c; animation: bob 0.8s ease-in-out infinite alternate; }
    @keyframes bob { to { transform: translateY(-4px); } }
    .nn .nn-hearts { margin-top: 10px; color: var(--pink); font-size: 20px; letter-spacing: 3px; min-height: 1.4em; }
    .nn .nn-hearts i { color: var(--gold); font-style: normal; }

    .nn .nn-chat { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 18px; }
    .nn .nn-start p { margin-bottom: 10px; }
    .nn .nn-pick { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 10px; }
    .nn .nn-pick b { font-family: 'Frank Ruhl Libre', serif; font-size: 20px; margin-right: 6px; }
    .nn .nn-log { list-style: none; margin: 0; padding: 0; max-height: 360px; overflow-y: auto; display: flex; flex-direction: column; gap: 8px; }
    .nn .nn-log li { max-width: 85%; padding: 8px 12px; border-radius: 12px; line-height: 1.4; }
    .nn .nn-log .noa { align-self: flex-end; background: rgba(242, 167, 195, 0.12); border: 1px solid rgba(242, 167, 195, 0.3); text-align: right; }
    .nn .nn-log .me { align-self: flex-start; background: #0f0c09; border: 1px solid var(--line); }
    .nn .nn-log .he { font-family: 'Frank Ruhl Libre', serif; font-size: 19px; direction: rtl; }
    .nn .nn-log .en { font-size: 13px; color: var(--mute); }
    .nn .nn-log .tag { font-size: 12px; color: var(--good); margin-top: 2px; }
    .nn .nn-log .tag.off { color: var(--mute); }
    .nn .nn-row { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px; align-items: center; }
    .nn .nn-row input[type='text'], .nn .nn-row #nn-answer { flex: 1; min-width: 0; background: #0f0c09; color: var(--ink); border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; font-size: 19px; font-family: 'Frank Ruhl Libre', serif; }
    .nn .nn-row #nn-answer:focus { outline: 2px solid var(--pink); }
    .nn .nn-btn { display: inline-block; background: transparent; color: var(--ink); border: 1px solid var(--line); border-radius: 8px; padding: 9px 14px; font-size: 14px; cursor: pointer; text-decoration: none; }
    .nn .nn-btn:hover { border-color: var(--pink); }
    .nn .nn-primary { background: var(--pink); color: #2a1220; border-color: var(--pink); font-weight: 600; }
    .nn .nn-primary:disabled { opacity: 0.6; cursor: wait; }
    .nn .nn-tools { font-size: 13px; }
    .nn .nn-small { color: var(--mute); font-size: 13px; margin-top: 8px; }
    .nn .nn-tools .nn-small { margin: 0; display: inline-flex; gap: 6px; align-items: center; }
    .nn .nn-hints { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px; }
    .nn .nn-hints button { background: #0f0c09; color: var(--ink); border: 1px dashed var(--line); border-radius: 8px; padding: 6px 10px; cursor: pointer; text-align: right; }
    .nn .nn-hints button:hover { border-color: var(--pink); }
    .nn .nn-hints b { display: block; font-family: 'Frank Ruhl Libre', serif; font-size: 17px; font-weight: 500; }
    .nn .nn-hints span { font-size: 12px; color: var(--mute); }
    .nn .nn-end p { font-size: 17px; }
    .nn .nn-stage .nn-burst { position: absolute; left: 50%; top: 45%; width: 0; height: 0; pointer-events: none; z-index: 3; }
    .nn .nn-stage .nn-burst span { position: absolute; font-size: 26px; color: var(--pink); text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5); animation: fly 1.2s cubic-bezier(0.2, 0.7, 0.3, 1) forwards; opacity: 0; }
    .nn .nn-stage .nn-burst span.gold { color: var(--gold); }
    @keyframes fly { 0% { transform: translate(-50%, -50%) scale(0.4); opacity: 1; } 70% { opacity: 1; } 100% { transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) scale(1.2); opacity: 0; } }
    .nn .nn-badge { position: absolute; top: 46%; left: 50%; z-index: 4; transform: translateX(-50%); white-space: nowrap; padding: 10px 18px; border-radius: 999px; font-weight: 700; font-size: 18px; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45); opacity: 0; pointer-events: none; }
    .nn .nn-badge.yes { background: var(--good); color: #0e2a14; }
    .nn .nn-badge.no { background: #f0c27a; color: #3a2508; font-size: 16px; }
    .nn .nn-badge.show { animation: badge 2.2s ease-out forwards; }
    @keyframes badge { 0% { opacity: 0; transform: translateX(-50%) scale(0.5); } 12% { opacity: 1; transform: translateX(-50%) scale(1.12); } 22% { transform: translateX(-50%) scale(1); } 80% { opacity: 1; } 100% { opacity: 0; transform: translateX(-50%) translateY(-16px); } }
    .nn .nn-hearts.bump { animation: bump 0.5s ease-out; }
    @keyframes bump { 40% { transform: scale(1.35); } }
    .nn .nn-steps { display: flex; gap: 6px; align-items: center; margin-bottom: 12px; }
    .nn .nn-steps span { width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; font-size: 12px; border: 1px solid var(--line); color: var(--mute); transition: all 0.3s; }
    .nn .nn-steps span.now { border-color: var(--pink); color: var(--ink); box-shadow: 0 0 0 3px rgba(242, 167, 195, 0.2); }
    .nn .nn-steps span.yes { background: var(--good); border-color: var(--good); color: #0e2a14; font-size: 14px; }
    .nn .nn-steps span.no { background: #f0c27a; border-color: #f0c27a; color: #3a2508; }
    .nn .nn-steps b { margin-left: auto; font-size: 12px; color: var(--mute); font-weight: 500; }
    .nn .nn-log .me.yes { border-color: var(--good); background: rgba(127, 207, 143, 0.12); }
    .nn .nn-log .me.yes .tag { color: var(--good); font-weight: 600; }
    .nn .nn-log .me.no { border-color: #f0c27a; }
    .nn .nn-log .me.no .tag { color: #f0c27a; }
    .nn .nn-row.shake { animation: shake 0.4s; }
    @keyframes shake { 20%, 60% { transform: translateX(-6px); } 40%, 80% { transform: translateX(6px); } }
    @media (prefers-reduced-motion: reduce) { .nn .nn-stage .nn-burst { display: none; } .nn .nn-row.shake, .nn .nn-hearts.bump { animation: none; } }
    .nn .nn-ext { max-width: 1040px; margin: 48px auto 0; display: flex; gap: 24px; align-items: center; background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 18px 22px; }
    .nn .nn-ext img { height: 150px; width: auto; flex: none; }
    .nn .nn-ext h2 { font-family: Fraunces, Georgia, serif; font-size: 24px; margin-bottom: 6px; }
    .nn .nn-ext p { color: #d8cbb6; line-height: 1.6; max-width: 620px; }
    .nn .nn-install { margin: 14px 0 0 18px; color: #d8cbb6; line-height: 1.8; font-size: 14px; }
    .nn .nn-install code { background: #0f0c09; padding: 1px 6px; border-radius: 4px; }
    @media (max-width: 620px) { .nn .nn-ext { flex-direction: column; align-items: flex-start; } .nn .nn-ext img { height: 110px; } }
    .nn .nn-about { margin-top: 48px; color: #d8cbb6; line-height: 1.65; }
    .nn .nn-about h2 { font-family: Fraunces, Georgia, serif; font-size: 24px; color: var(--ink); margin-bottom: 8px; }
  </style>

  <script>
    import { mountNoa } from '../../lib/kolnoa-noa-chat';

    function init() {
      const dataEl = document.getElementById('nn-data');
      if (!dataEl || (dataEl as any)._nn) return;
      (dataEl as any)._nn = true;
      mountNoa(JSON.parse(dataEl.textContent || '{}'));
    }

    init();
    document.addEventListener('astro:page-load', init);
  </script>
</Layout>
