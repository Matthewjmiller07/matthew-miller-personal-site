---

<Layout
    title="Tel Aviv Kosher Cafes - Interactive Google Maps"
    description="Interactive Google Maps showing all Tel Aviv kosher cafes with pins, labels, and navigation. Filter by kashrut type and explore certified kosher coffee shops."
    image="/images/tel-aviv-kosher.png"
    imageAlt="Tel Aviv Kosher Cafes Interactive Google Maps"
>
    <div class="min-h-screen bg-gradient-to-br from-slate-50 to-blue-50 dark:from-slate-900 dark:to-blue-900">
        <div class="container mx-auto px-4 py-8">
            {/* Header */}
            <header class="text-center mb-12">
                <h1 class="text-4xl md:text-6xl font-bold text-gray-900 dark:text-white mb-4">
                    Tel Aviv Kosher Cafes <span class="text-blue-600 dark:text-blue-400">Interactive Map</span>
                </h1>
                <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
                    Interactive Google Maps with <strong>{kosherCafes.length} kosher cafes pinned</strong>. 
                    Click pins for details, get directions, and explore certified kosher locations.
                </p>
            </header>

            {/* Map Controls */}
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 mb-8">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Filter by Type</label>
                        <select id="type-filter" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent dark:bg-gray-700 dark:text-white">
                            <option value="all">All Cafes ({kosherCafes.length})</option>
                            <option value="mehadrin">Mehadrin Only ({kosherCafes.filter(c => c.type === 'mehadrin').length})</option>
                            <option value="standard">Standard Kosher ({kosherCafes.filter(c => c.type === 'standard').length})</option>
                        </select>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Search</label>
                        <input type="text" id="search-input" placeholder="Search cafes..." 
                               class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent dark:bg-gray-700 dark:text-white">
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Actions</label>
                        <div class="flex gap-2">
                            <button id="reset-btn" class="px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition-colors text-sm">
                                Reset
                            </button>
                            <button id="share-btn" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors text-sm">
                                Share
                            </button>
                        </div>
                    </div>
                </div>

                <div class="flex justify-between items-center">
                    <div class="text-sm text-gray-600 dark:text-gray-400">
                        <span id="visible-count">{kosherCafes.length}</span> cafes visible
                    </div>
                    <div class="text-sm text-gray-600 dark:text-gray-400">
                        Click any pin for details and directions
                    </div>
                </div>
            </div>

            {/* Google Maps Container */}
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 mb-8">
                <div id="map" class="w-full h-96 md:h-[600px] rounded-lg overflow-hidden">
                    <!-- Map will be loaded here -->
                </div>
            </div>

            {/* Cafe List */}
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6">
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Cafe List</h2>
                <div id="cafe-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    <!-- Cafe cards will be populated here -->
                </div>
            </div>
        </div>
    </div>

    <!-- Google Maps JavaScript API -->
    <script async defer
            src="https://maps.googleapis.com/maps/api/js?key=AIzaSyB41DRUbKWJHPxaFjMAwdrzWzbVKartNGg&callback=initMap">
    </script>

    <script>
        // Pass the kosher cafes data to JavaScript
        const kosherCafesData = {kosherCafes};
        
        let map;
        let markers = [];
        let infoWindow;
        let filteredCafes = [...kosherCafesData.kosherCafes];

        function initMap() {
            // Initialize map centered on Tel Aviv
            map = new google.maps.Map(document.getElementById('map'), {
                center: { lat: 32.0853, lng: 34.7818 },
                zoom: 13,
                styles: [
                    {
                        featureType: 'poi',
                        elementType: 'labels',
                        stylers: [{ visibility: 'off' }]
                    }
                ]
            });

            infoWindow = new google.maps.InfoWindow();

            // Add all markers
            addMarkers(filteredCafes);
            
            // Setup event listeners
            setupEventListeners();
            
            // Generate cafe list
            generateCafeList(filteredCafes);
        }

        function addMarkers(cafes) {
            // Clear existing markers
            markers.forEach(marker => marker.setMap(null));
            markers = [];

            cafes.forEach(cafe => {
                const markerColor = cafe.type === 'mehadrin' ? '#9333ea' : '#3b82f6';
                
                const marker = new google.maps.Marker({
                    position: { lat: cafe.lat, lng: cafe.lng },
                    map: map,
                    title: cafe.name,
                    icon: {
                        path: google.maps.SymbolPath.CIRCLE,
                        scale: 8,
                        fillColor: markerColor,
                        fillOpacity: 0.8,
                        strokeColor: '#ffffff',
                        strokeWeight: 2
                    },
                    cafeData: cafe
                });

                // Create info window content
                const contentString = `
                    <div style="direction: ltr; min-width: 250px; font-family: Arial, sans-serif;">
                        <h3 style="margin: 0 0 8px 0; font-size: 16px; font-weight: bold; color: #1f2937;">${cafe.name}</h3>
                        <p style="margin: 4px 0; color: #6b7280; font-size: 14px;">📍 ${cafe.address}</p>
                        ${cafe.phone ? `<p style="margin: 4px 0; color: #6b7280; font-size: 14px;">📞 ${cafe.phone}</p>` : ''}
                        <p style="margin: 8px 0;">
                            <span style="background-color: ${markerColor}; color: white; padding: 2px 8px; border-radius: 12px; font-size: 12px;">
                                ${cafe.type === 'mehadrin' ? 'מהדרין' : 'כשר'}
                            </span>
                        </p>
                        <div style="margin-top: 12px;">
                            <a href="https://www.google.com/maps/dir/?api=1&destination=${cafe.lat},${cafe.lng}" 
                               target="_blank" 
                               style="display: inline-block; padding: 6px 12px; background-color: #3b82f6; color: white; text-decoration: none; border-radius: 4px; font-size: 12px; margin-right: 8px;">
                                🧭 Get Directions
                            </a>
                            <a href="https://www.google.com/maps/search/?api=1&query=${cafe.lat},${cafe.lng}" 
                               target="_blank" 
                               style="display: inline-block; padding: 6px 12px; background-color: #10b981; color: white; text-decoration: none; border-radius: 4px; font-size: 12px;">
                                🗺️ View on Maps
                            </a>
                        </div>
                    </div>
                `;

                marker.addListener('click', () => {
                    infoWindow.setContent(contentString);
                    infoWindow.open(map, marker);
                });

                markers.push(marker);
            });

            // Fit map to show all markers
            if (markers.length > 0) {
                const bounds = new google.maps.LatLngBounds();
                markers.forEach(marker => bounds.extend(marker.getPosition()));
                map.fitBounds(bounds);
            }
        }

        function setupEventListeners() {
            const typeFilter = document.getElementById('type-filter');
            const searchInput = document.getElementById('search-input');
            const resetBtn = document.getElementById('reset-btn');
            const shareBtn = document.getElementById('share-btn');

            function applyFilters() {
                const type = typeFilter.value;
                const searchTerm = searchInput.value.toLowerCase();

                filteredCafes = kosherCafesData.kosherCafes.filter(cafe => {
                    const typeMatch = type === 'all' || cafe.type === type;
                    const searchMatch = !searchTerm || 
                        cafe.name.toLowerCase().includes(searchTerm) ||
                        cafe.address.toLowerCase().includes(searchTerm);
                    
                    return typeMatch && searchMatch;
                });

                document.getElementById('visible-count').textContent = filteredCafes.length;
                addMarkers(filteredCafes);
                generateCafeList(filteredCafes);
            }

            typeFilter.addEventListener('change', applyFilters);
            searchInput.addEventListener('input', applyFilters);
            
            resetBtn.addEventListener('click', () => {
                typeFilter.value = 'all';
                searchInput.value = '';
                applyFilters();
            });

            shareBtn.addEventListener('click', () => {
                const url = window.location.href;
                navigator.clipboard.writeText(url).then(() => {
                    alert('Map URL copied to clipboard!');
                });
            });
        }

        function generateCafeList(cafes) {
            const listContainer = document.getElementById('cafe-list');
            
            if (cafes.length === 0) {
                listContainer.innerHTML = '<div class="col-span-full text-center text-gray-500 dark:text-gray-400 py-8">No cafes found matching your criteria</div>';
                return;
            }

            listContainer.innerHTML = cafes.map(cafe => {
                const typeColor = cafe.type === 'mehadrin' ? 'purple' : 'green';
                const typeText = cafe.type === 'mehadrin' ? 'מהדרין' : 'כשר';
                
                return `
                    <div class="bg-gray-50 dark:bg-gray-900 rounded-lg p-4 hover:shadow-md transition-shadow cursor-pointer" 
                         onclick="focusMarker(${cafe.lat}, ${cafe.lng})">
                        <h3 class="font-semibold text-gray-900 dark:text-white mb-2">${cafe.name}</h3>
                        <p class="text-sm text-gray-600 dark:text-gray-400 mb-2">📍 ${cafe.address}</p>
                        <div class="flex items-center gap-2 mb-2">
                            <span class="px-2 py-1 bg-${typeColor}-100 dark:bg-${typeColor}-900 text-${typeColor}-800 dark:text-${typeColor}-200 text-xs rounded">
                                ${typeText}
                            </span>
                            ${cafe.phone ? `<span class="text-xs text-gray-500 dark:text-gray-400">📞 ${cafe.phone}</span>` : ''}
                        </div>
                        <div class="flex gap-2">
                            <a href="https://www.google.com/maps/dir/?api=1&destination=${cafe.lat},${cafe.lng}" 
                               target="_blank" 
                               class="flex-1 text-center px-2 py-1 bg-blue-600 text-white text-xs rounded hover:bg-blue-700 transition-colors">
                                🧭 Directions
                            </a>
                            <a href="https://www.google.com/maps/search/?api=1&query=${cafe.lat},${cafe.lng}" 
                               target="_blank" 
                               class="flex-1 text-center px-2 py-1 bg-green-600 text-white text-xs rounded hover:bg-green-700 transition-colors">
                                🗺️ Maps
                            </a>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function focusMarker(lat, lng) {
            map.setCenter({ lat, lng });
            map.setZoom(16);
            
            // Find and open the marker info window
            const marker = markers.find(m => 
                m.getPosition().lat() === lat && m.getPosition().lng() === lng
            );
            if (marker) {
                google.maps.event.trigger(marker, 'click');
            }
        }

        // Fallback if Google Maps fails to load
        window.addEventListener('load', () => {
            setTimeout(() => {
                if (!window.google || !window.google.maps) {
                    document.getElementById('map').innerHTML = `
                        <div class="flex items-center justify-center h-full bg-gray-100 dark:bg-gray-900">
                            <div class="text-center">
                                <p class="text-gray-600 dark:text-gray-400 mb-4">Google Maps failed to load</p>
                                <a href="https://www.google.com/maps/search/Tel+Aviv+kosher+cafes" 
                                   target="_blank" 
                                   class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                                    Open in Google Maps
                                </a>
                            </div>
                        </div>
                    `;
                }
            }, 3000);
        });
    </script>
</Layout>
