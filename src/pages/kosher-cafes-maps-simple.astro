// Create Google Maps URL with multiple pins (not directions)
function createGoogleMapsUrl(cafes) {
    // Use the search endpoint with multiple coordinates to show pins
    // This creates a map with pins, not directions
    const limitedCafes = cafes.slice(0, 25);
    
    const destinations = limitedCafes.map(cafe => 
        `${cafe.lat},${cafe.lng}`
    ).join('/');
    
    return `https://www.google.com/maps/search/${destinations}`;
}

// Create alternative using place names
function createNamedSearchMapsUrl(cafes) {
    // Create search query with place names for better labels
    const searchTerms = cafes.slice(0, 15).map(cafe => 
        encodeURIComponent(`${cafe.name} ${cafe.address} Tel Aviv`)
    ).join('/');
    
    return `https://www.google.com/maps/search/${searchTerms}`;
}

const mainMapsUrl = createGoogleMapsUrl(kosherCafes);
const namedSearchUrl = createNamedSearchMapsUrl(kosherCafes);
---

<Layout
    title="Tel Aviv Kosher Cafes - Google Maps with All Pins"
    description="Direct Google Maps link showing all Tel Aviv kosher cafes with pins and labels. One-click navigation to 84+ certified kosher coffee shops."
    image="/images/tel-aviv-kosher.png"
    imageAlt="Tel Aviv Kosher Cafes Google Maps - All locations pinned"
>
    <div class="min-h-screen bg-gradient-to-br from-slate-50 to-blue-50 dark:from-slate-900 dark:to-blue-900">
        <div class="container mx-auto px-4 py-8">
            {/* Header */}
            <header class="text-center mb-12">
                <h1 class="text-4xl md:text-6xl font-bold text-gray-900 dark:text-white mb-4">
                    Tel Aviv Kosher Cafes <span class="text-blue-600 dark:text-blue-400">Google Maps</span>
                </h1>
                <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
                    Direct Google Maps links with <strong>all kosher cafes as pins</strong>. Click below to see all locations on one map with labels - no directions, just pins.
                </p>
            </header>

            {/* Main Maps Link */}
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-8 mb-8">
                <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-6 text-center">
                    🗺️ Complete Kosher Cafes Map
                </h2>
                
                <div class="text-center mb-8">
                    <p class="text-lg text-gray-600 dark:text-gray-300 mb-6">
                        <strong>{kosherCafes.length}</strong> kosher cafes pinned on Google Maps
                    </p>
                    
                    <a href={mainMapsUrl} 
                       target="_blank" 
                       rel="noopener"
                       class="inline-block px-8 py-4 bg-blue-600 text-white text-lg font-semibold rounded-lg hover:bg-blue-700 transition-colors shadow-lg">
                        📍 View All Kosher Cafes as Pins
                    </a>
                </div>

                {/* Alternative Links */}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="text-center">
                        <h3 class="font-semibold text-gray-900 dark:text-white mb-3">Named Locations Map</h3>
                        <a href={namedSearchUrl} 
                           target="_blank" 
                           rel="noopener"
                           class="inline-block px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors">
                            🔍 Search by Names
                        </a>
                        <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">
                            Better labels with cafe names
                        </p>
                    </div>

                    <div class="text-center">
                        <h3 class="font-semibold text-gray-900 dark:text-white mb-3">Mehadrin Only</h3>
                        <a href={createGoogleMapsUrl(kosherCafes.filter(c => c.type === 'mehadrin'))} 
                           target="_blank" 
                           rel="noopener"
                           class="inline-block px-6 py-3 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors">
                            🕍 Mehadrin Cafes Map
                        </a>
                        <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">
                            {kosherCafes.filter(c => c.type === 'mehadrin').length} strict kosher locations
                        </p>
                    </div>
                </div>
            </div>

            {/* URL Information */}
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 mb-8">
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Map Links</h2>
                
                <div class="space-y-4">
                    <div>
                        <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Search Map (25 Locations)</h3>
                        <div class="bg-gray-100 dark:bg-gray-900 p-3 rounded-lg">
                            <code class="text-sm text-gray-700 dark:text-gray-300 break-all">
                                {mainMapsUrl}
                            </code>
                        </div>
                        <button onclick="navigator.clipboard.writeText('{mainMapsUrl}')" 
                                class="mt-2 px-4 py-2 bg-gray-600 text-white text-sm rounded hover:bg-gray-700 transition-colors">
                            📋 Copy URL
                        </button>
                    </div>

                    <div>
                        <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Named Search Map (15 Locations)</h3>
                        <div class="bg-gray-100 dark:bg-gray-900 p-3 rounded-lg">
                            <code class="text-sm text-gray-700 dark:text-gray-300 break-all">
                                {namedSearchUrl}
                            </code>
                        </div>
                        <button onclick="navigator.clipboard.writeText('{namedSearchUrl}')" 
                                class="mt-2 px-4 py-2 bg-gray-600 text-white text-sm rounded hover:bg-gray-700 transition-colors">
                            📋 Copy URL
                        </button>
                    </div>
                </div>
            </div>

            {/* Instructions */}
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6">
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">How to Use</h2>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div>
                        <h3 class="font-semibold text-gray-900 dark:text-white mb-3">🗺️ On Desktop</h3>
                        <ul class="space-y-2 text-gray-600 dark:text-gray-300">
                            <li>• Click the main button to open Google Maps</li>
                            <li>• See all cafe pins (no directions route)</li>
                            <li>• Click any pin for details and manual navigation</li>
                            <li>• Zoom and pan to explore all locations</li>
                            <li>• Save to your Google Maps account</li>
                        </ul>
                    </div>
                    
                    <div>
                        <h3 class="font-semibold text-gray-900 dark:text-white mb-3">📱 On Mobile</h3>
                        <ul class="space-y-2 text-gray-600 dark:text-gray-300">
                            <li>• Links open directly in Google Maps app</li>
                            <li>• All pins visible on the map (no route)</li>
                            <li>• Tap pins for cafe information</li>
                            <li>• Get directions manually from any pin</li>
                            <li>• Share with friends via WhatsApp, etc.</li>
                        </ul>
                    </div>
                </div>

                <div class="mt-8 p-4 bg-blue-50 dark:bg-blue-900/20 rounded-lg">
                    <p class="text-sm text-blue-800 dark:text-blue-200">
                        <strong>💡 Tip:</strong> The main map shows up to 25 locations due to URL length limits. 
                        For the complete experience, use the original interactive map at 
                        <a href="/kosher-cafes/" class="underline hover:text-blue-600">/kosher-cafes/</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</Layout>
