                    address: "הירקון 96",
                    lat: 32.0947,
                    lng: 34.7729,
                    type: "mehadrin",
                    phone: "03-6246300"
                }
            ];

            // Add markers for each cafe
            let markers = [];
            kosherCafes.forEach(cafe => {
                const markerColor = cafe.type === 'mehadrin' ? '#9333ea' : '#3b82f6';
                
                const marker = L.circleMarker([cafe.lat, cafe.lng], {
                    radius: 8,
                    fillColor: markerColor,
                    color: '#fff',
                    weight: 2,
                    opacity: 1,
                    fillOpacity: 0.8
                }).addTo(map);

                // Create popup content
                const popupContent = `
                    <div style="direction: rtl; text-align: right; min-width: 200px;">
                        <h3 style="margin: 0 0 8px 0; font-weight: bold; color: #1f2937;">${cafe.name}</h3>
                        <p style="margin: 4px 0; color: #6b7280; font-size: 14px;">📍 ${cafe.address}</p>
                        ${cafe.phone ? `<p style="margin: 4px 0; color: #6b7280; font-size: 14px;">📞 ${cafe.phone}</p>` : ''}
                        <p style="margin: 8px 0 0 0;">
                            <span style="background-color: ${markerColor}; color: white; padding: 2px 8px; border-radius: 12px; font-size: 12px;">
                                ${cafe.type === 'mehadrin' ? 'מהדרין' : 'כשר'}
                            </span>
                        </p>
                    </div>
                `;

                marker.bindPopup(popupContent);
                marker.cafeData = cafe; // Store cafe data for filtering
                markers.push(marker);
            });

            // Update statistics
            function updateStats() {
                const totalCafes = kosherCafes.length;
                const standardCafes = kosherCafes.filter(c => c.type === 'standard').length;
                const mehadrinCafes = kosherCafes.filter(c => c.type === 'mehadrin').length;
                const visibleCafes = markers.filter(m => map.hasLayer(m)).length;

                document.getElementById('total-cafes').textContent = totalCafes;
                document.getElementById('standard-cafes').textContent = standardCafes;
                document.getElementById('mehadrin-cafes').textContent = mehadrinCafes;
                document.getElementById('visible-cafes').textContent = visibleCafes;
                document.getElementById('cafe-count').textContent = visibleCafes;
            }

            // Initialize stats
            updateStats();

            // Generate cafe list HTML
            function generateCafeList(filteredCafes = kosherCafes) {
                const listContainer = document.getElementById('cafe-list');
                listContainer.innerHTML = '';

                filteredCafes.forEach(cafe => {
                    const markerColor = cafe.type === 'mehadrin' ? '#9333ea' : '#3b82f6';
                    const cafeCard = document.createElement('div');
                    cafeCard.className = 'bg-white dark:bg-gray-800 rounded-lg p-4 shadow hover:shadow-md transition-shadow cursor-pointer';
                    cafeCard.innerHTML = `
                        <h4 class="font-semibold text-gray-900 dark:text-white">${cafe.name}</h4>
                        <p class="text-sm text-gray-600 dark:text-gray-400 mb-1">${cafe.address}</p>
                        <div class="flex items-center gap-2 mb-2">
                            <span class="px-2 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 text-xs rounded">בית קפה</span>
                            <span class="px-2 py-1 ${cafe.type === 'mehadrin' ? 'bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200' : 'bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200'} text-xs rounded">
                                ${cafe.type === 'mehadrin' ? 'מהדרין' : 'כשר'}
                            </span>
                        </div>
                        ${cafe.phone ? `<p class="text-xs text-gray-500 dark:text-gray-400">${cafe.phone}</p>` : ''}
                    `;
                    
                    // Add click event to focus on map marker
                    cafeCard.addEventListener('click', () => {
                        map.setView([cafe.lat, cafe.lng], 16);
                        const marker = markers.find(m => m.cafeData === cafe);
                        if (marker) {
                            marker.openPopup();
                        }
                    });
                    
                    listContainer.appendChild(cafeCard);
                });
            }

            // Filter functionality
            function applyFilters() {
                const kashrutFilter = document.getElementById('kashrut-filter').value;
                const searchTerm = document.getElementById('search-input').value.toLowerCase();
                
                let filteredCafes = kosherCafes;
                
                // Apply kashrut filter
                if (kashrutFilter !== 'all') {
                    filteredCafes = filteredCafes.filter(cafe => cafe.type === kashrutFilter);
                }
                
                // Apply search filter
                if (searchTerm) {
                    filteredCafes = filteredCafes.filter(cafe => 
                        cafe.name.toLowerCase().includes(searchTerm) ||
                        cafe.address.toLowerCase().includes(searchTerm)
                    );
                }
                
                // Update map markers
                markers.forEach(marker => {
                    if (filteredCafes.includes(marker.cafeData)) {
                        if (!map.hasLayer(marker)) {
                            marker.addTo(map);
                        }
                    } else {
                        if (map.hasLayer(marker)) {
                            map.removeLayer(marker);
                        }
                    }
                });
                
                // Update cafe list
                generateCafeList(filteredCafes);
                
                // Update stats
                updateStats();
                
                // Fit map to visible markers
                const visibleMarkers = markers.filter(m => map.hasLayer(m));
                if (visibleMarkers.length > 0) {
                    const group = new L.featureGroup(visibleMarkers);
                    map.fitBounds(group.getBounds().pad(0.1));
                }
            }

            // Event listeners
            document.getElementById('kashrut-filter').addEventListener('change', applyFilters);
            document.getElementById('search-input').addEventListener('input', applyFilters);
            
            document.getElementById('reset-filters').addEventListener('click', () => {
                document.getElementById('kashrut-filter').value = 'all';
                document.getElementById('search-input').value = '';
                applyFilters();
            });
            
            document.getElementById('show-all').addEventListener('click', () => {
                document.getElementById('kashrut-filter').value = 'all';
                document.getElementById('search-input').value = '';
                applyFilters();
            });

            // Initialize cafe list
            generateCafeList();
        });
    </script>

