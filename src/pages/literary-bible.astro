// ─── State ──────────────────────────────────────────────────────────────────
let allRows = [];
let activeDevice = '';
let activeSection = '';
let activeBook    = '';
let activeParsha  = '';
let activeAliya   = '';
let activeSort    = 'biblical';
let chartInstance = null;
const verseTextCache = {};

// ─── URL param sync ──────────────────────────────────────────────────────────
let browseMode = false;

function syncURL() {
  const p = new URLSearchParams();
  if (activeDevice)  p.set('device',  activeDevice);
  if (activeSection) p.set('section', activeSection);
  if (activeBook)    p.set('book',    activeBook);
  if (activeParsha)  p.set('parsha',  activeParsha);
  if (activeAliya)   p.set('aliya',   activeAliya);
  if (activeSort !== 'biblical') p.set('sort', activeSort);
  if (browseMode) {
    p.set('mode', 'browse');
    const bb = document.getElementById('browseBook')?.value;
    const bc = document.getElementById('browseChapter')?.value;
    if (bb) p.set('bbook', bb);
    if (bc) p.set('bchapter', bc);
  }
  const qs = p.toString();
  history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
}

