// ─── Supabase fetch ─────────────────────────────────────────────────────────
async function loadFromSupabase() {
  setStatus('Loading literary devices…');
  try {
    const res = await fetch(
      `${SUPABASE_URL}/rest/v1/${TABLE}?select=book,chapter,verse,device,words,sources,urls,notes,created_at&order=created_at.desc`,
      { headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${SUPABASE_KEY}` } }
    );
    if (!res.ok) throw new Error(`Supabase error ${res.status}`);
    const raw = await res.json();
    allRows = raw.map(r => ({ ...r, book: BOOK_NAME_FIX[r.book] || r.book }));
    buildDevicePills(allRows);
    updateDeviceCounts(allRows);
    clearStatus();
  } catch (e) {
    setStatus(`Error loading data: ${e.message}`);
  }
}

// ─── Build device pills from live data ──────────────────────────────────────
function buildDevicePills(rows) {
  const container = document.getElementById('deviceFilters');
  // Collect unique devices sorted alphabetically
  const devices = [...new Set(rows.map(r => r.device?.toLowerCase()).filter(Boolean))].sort();
  // Remove any previously generated pills (keep the All button)
  container.querySelectorAll('.device-pill:not([data-device=""])').forEach(el => el.remove());
  devices.forEach(device => {
    const color = deviceColor(device);
    const label = device.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
    const btn = document.createElement('button');
    btn.dataset.device = device;
    btn.className = 'device-pill px-4 py-1.5 rounded-full text-sm font-medium border transition-all';
    btn.style.background = color;
    btn.style.color = '#111';
    btn.innerHTML = `${label} <span class="count-badge"></span>`;
    btn.addEventListener('click', () => {
      container.querySelectorAll('.device-pill').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeDevice = device;
      syncURL(); render();
    });
    container.appendChild(btn);
  });
  // Re-attach All button listener (since it's static HTML)
  const allBtn = container.querySelector('[data-device=""]');
  allBtn.onclick = () => {
    container.querySelectorAll('.device-pill').forEach(b => b.classList.remove('active'));
    allBtn.classList.add('active');
    activeDevice = '';
    syncURL(); render();
  };
}

// ─── Sefaria text fetch (per verse, cached) ──────────────────────────────────
async function getVerseText(book, chapter, verse) {
  const key = `${book} ${chapter}:${verse}`;
  if (verseTextCache[key] !== undefined) return verseTextCache[key];
  const sefariaBook = (SEFARIA_BOOK_MAP[book] || book).replace(/ /g, '_');
  const ref = encodeURIComponent(`${sefariaBook}.${chapter}.${verse}`);
  try {
    const res = await fetch(`https://www.sefaria.org/api/v3/texts/${ref}?version=primary&fill_in_missing_segments=0`);
    if (!res.ok) throw new Error('not found');
    const data = await res.json();
    let text = '';
    if (data.versions && data.versions.length) {
      const heb = data.versions.find(v => v.language === 'he') || data.versions[0];
      const raw = heb.text;
      text = Array.isArray(raw) ? raw.join(' ') : (raw || '');
      text = text.replace(/<[^>]+>/g, '');
    }
    verseTextCache[key] = text;
    return text;
  } catch {
    verseTextCache[key] = '';
    return '';
  }
}

// ─── Filtering ───────────────────────────────────────────────────────────────
function getFilteredRows() {
  let rows = allRows;

  if (activeDevice) {
    rows = rows.filter(r => r.device?.toLowerCase() === activeDevice);
  }

  if (activeSection) {
    const books = TANACH_BOOKS[activeSection] || [];
    rows = rows.filter(r => books.includes(r.book));
  }

  if (activeBook) {
    rows = rows.filter(r => r.book === activeBook);
  }

  if (activeParsha && PARSHAS[activeParsha]) {
    const range = activeAliya && PARSHAS[activeParsha][activeAliya]
      ? PARSHAS[activeParsha][activeAliya]
      : PARSHAS[activeParsha]['Whole Parsha'];
    if (range) rows = filterByRange(rows, range);
  }

  return rows;
}

function filterByRange(rows, rangeStr) {
  const [start, end] = rangeStr.split('-');
  const parts = start.trim().split(' ');
  const cv = parts.pop();
  const book = parts.join(' ');
  const [sc, sv] = cv.split(':').map(Number);
  const [ec, ev] = end.trim().split(':').map(Number);
  return rows.filter(r => {
    if (r.book !== book) return false;
    const ch = Number(r.chapter), vs = Number(r.verse);
    return (ch > sc || (ch === sc && vs >= sv)) && (ch < ec || (ch === ec && vs <= ev));
  });
}

// ─── Group rows by verse key, sorted by biblical order ──────────────────────
function groupByVerse(rows) {
  const map = new Map();
  for (const row of rows) {
    const key = `${row.book}|${row.chapter}|${row.verse}`;
    if (!map.has(key)) map.set(key, { book: row.book, chapter: row.chapter, verse: row.verse, devices: [], newestAt: row.created_at });
    const entry = map.get(key);
    entry.devices.push({ device: row.device?.toLowerCase(), words: row.words, sources: row.sources, urls: row.urls, notes: row.notes });
    // track the most recent created_at for the verse
    if (row.created_at && (!entry.newestAt || row.created_at > entry.newestAt)) entry.newestAt = row.created_at;
  }
  const verses = [...map.values()];
  if (activeSort === 'newest') {
    verses.sort((a, b) => (b.newestAt || '').localeCompare(a.newestAt || ''));
  } else {
    verses.sort((a, b) => {
      const ai = BOOK_ORDER.indexOf(a.book), bi = BOOK_ORDER.indexOf(b.book);
      if (ai !== bi) return ai - bi;
      if (a.chapter !== b.chapter) return a.chapter - b.chapter;
      return a.verse - b.verse;
    });
  }
  return verses;
}

// ─── Render ──────────────────────────────────────────────────────────────────
async function render() {
  const filtered = getFilteredRows();
  const grouped  = groupByVerse(filtered);

  if (grouped.length === 0) {
    versesEl.innerHTML = '<p class="text-center text-secondary-light dark:text-secondary-dark">No verses found for the selected filters.</p>';
    updateChart({});
    return;
  }

  setStatus(`Loading ${grouped.length} verse${grouped.length !== 1 ? 's' : ''} from Sefaria…`);

  // Fetch all verse texts in parallel (up to 10 at once to avoid hammering Sefaria)
  const BATCH = 10;
  for (let i = 0; i < grouped.length; i += BATCH) {
    await Promise.all(grouped.slice(i, i + BATCH).map(v => getVerseText(v.book, v.chapter, v.verse)));
  }

  clearStatus();

  // Update pill counts to reflect current filter (not total corpus)
  updateDeviceCounts(filtered);

  const deviceCounts = {};
  const cards = grouped.map(v => {
    const ref = `${v.book} ${v.chapter}:${v.verse}`;
    let hebrewText = verseTextCache[ref] || '';

    // Strip Hebrew cantillation/vowel marks for fuzzy matching
    const CANTILLATION = /[\u0591-\u05C7\uFB1D-\uFB4E]/g;
    function stripMarks(s) { return s ? s.replace(CANTILLATION, '') : ''; }
    function escapeRe(s) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }

    // Build highlighted text and source footnotes
    let noteIdx = v.devices.length;
    const footnotes = [];
    for (const d of v.devices) {
      const color = DEVICE_COLORS[d.device] || '#eee';
      deviceCounts[d.device] = (deviceCounts[d.device] || 0) + 1;
      if (d.words && hebrewText) {
        const strippedTarget = stripMarks(d.words);
        const strippedText   = stripMarks(hebrewText);
        const re = new RegExp(escapeRe(strippedTarget), 'g');
        let match;
        // rebuild by walking original + stripped in parallel
        const origChars  = [...hebrewText];
        const stripChars = [...strippedText];
        // map stripped index → original index
        const stripToOrig = [];
        let si = 0, oi = 0;
        while (oi < origChars.length) {
          if (si < stripChars.length && origChars[oi] === stripChars[si]) {
            stripToOrig[si] = oi; si++;
          }
          oi++;
        }
        // find all match ranges in stripped text
        const ranges = [];
        while ((match = re.exec(strippedText)) !== null) {
          const sStart = match.index;
          const sEnd   = match.index + match[0].length - 1;
          const oStart = stripToOrig[sStart];
          const oEnd   = stripToOrig[sEnd];
          if (oStart !== undefined && oEnd !== undefined) {
            ranges.push([oStart, oEnd]);
          }
        }
        if (ranges.length) {
          let out = '';
          let cursor = 0;
          for (const [oS, oE] of ranges) {
            out += hebrewText.slice(cursor, oS);
            const highlighted = hebrewText.slice(oS, oE + 1);
            out += `<span class="highlight" style="color:${color};border-bottom-color:${color}">${highlighted}<sup class="note">${noteIdx}</sup></span>`;
            cursor = oE + 1;
          }
          out += hebrewText.slice(cursor);
          hebrewText = out;
        }
      }
      const srcParts = d.sources ? d.sources.split(';').map(s => s.trim()) : [];
      const urlParts = d.urls   ? d.urls.split(';').map(u => u.trim())   : [];
      const srcsHtml = srcParts.map((s, i) =>
        urlParts[i] ? `<a href="${urlParts[i]}" target="_blank" rel="noopener">${s}</a>` : s
      ).join(',');
      footnotes.push(`<span style="color:${color};font-weight:600">${noteIdx}. (${d.device})${srcsHtml ? ' ' + srcsHtml : ''}</span>`);
      noteIdx--;
    }
    footnotes.reverse();

    const sefariaRef = encodeURIComponent(`${SEFARIA_BOOK_MAP[v.book] || v.book} ${v.chapter}:${v.verse}`);
    const sefariaUrl = `https://www.sefaria.org/${sefariaRef}`;

    const dateStr = v.newestAt ? new Date(v.newestAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
    return `
      <div class="verse-card bg-card-bg-light dark:bg-card-bg-dark border border-border-light dark:border-border-dark rounded-xl shadow-sm p-5"
           data-ref="${ref}">
        <div class="flex items-start justify-between gap-3 mb-3">
          <div class="flex flex-col gap-0.5">
            <a href="${sefariaUrl}" target="_blank" rel="noopener"
               class="text-sm font-semibold text-accent hover:underline">${ref}</a>
            ${dateStr ? `<span class="text-xs text-secondary-light dark:text-secondary-dark">Added ${dateStr}</span>` : ''}
          </div>
          <div class="flex gap-1 flex-wrap">
            ${v.devices.map(d => {
              const c = deviceColor(d.device||'');
              const badge = `<span class="text-xs px-2 py-0.5 rounded-full font-medium border" style="background:${c};color:#111">${d.device}</span>`;
              if (!d.notes) return badge;
              return `<span class="has-note">${badge}<span class="note-icon" tabindex="0">i</span><span class="note-tooltip" style="position:absolute;z-index:100;bottom:calc(100% + 8px);left:50%;transform:translateX(-50%);white-space:normal;width:220px;background:#1e1b4b;color:#e0e7ff;font-size:0.72rem;line-height:1.5;padding:7px 10px;border-radius:8px;box-shadow:0 4px 16px rgba(0,0,0,0.5);pointer-events:none;transition:opacity 0.15s ease;font-family:sans-serif;text-align:left;direction:ltr">${d.notes.replace(/</g,'&lt;')}<span style="position:absolute;top:100%;left:50%;transform:translateX(-50%);border:5px solid transparent;border-top-color:#1e1b4b"></span></span></span>`;
            }).join('')}
          </div>
        </div>
        ${hebrewText
          ? `<p class="hebrew-text text-primary-light dark:text-primary-dark mb-3">${hebrewText}</p>`
          : `<p class="text-xs text-secondary-light dark:text-secondary-dark italic mb-2">Hebrew text unavailable</p>`
        }
        ${footnotes.length ? `<div class="source-block">${footnotes.join('<br>')}</div>` : ''}
        <div class="flex justify-end mt-3">
          <button class="suggest-btn flex items-center gap-1 text-xs px-3 py-1 rounded-full bg-green-600 text-white hover:bg-green-500 transition-colors" data-ref="${ref}">+ Suggest</button>
        </div>
      </div>`;
  }).join('');

  versesEl.innerHTML = cards;

  // Attach suggest-btn listeners
  versesEl.querySelectorAll('.suggest-btn').forEach(btn => {
    btn.addEventListener('click', e => {
      e.stopPropagation();
      openSuggestForm(btn.dataset.ref);
    });
  });

  updateChart(deviceCounts);
}

// ─── Device count badges — updates based on currently filtered rows ──────────
function updateDeviceCounts(rows) {
  const counts = {};
  for (const r of rows) {
    const d = r.device?.toLowerCase();
    if (d) counts[d] = (counts[d] || 0) + 1;
  }
  document.querySelectorAll('.device-pill[data-device]').forEach(btn => {
    const d = btn.dataset.device;
    if (!d) return;
    const badge = btn.querySelector('.count-badge');
    if (badge) badge.textContent = counts[d] ? ` (${counts[d]})` : ' (0)';
  });
}

// ─── Chart ───────────────────────────────────────────────────────────────────
function updateChart(counts) {
  const ctx = document.getElementById('deviceChart');
  if (!ctx) return;
  if (chartInstance) { chartInstance.destroy(); chartInstance = null; }
  const labels = Object.keys(counts);
  if (!labels.length) return;
  chartInstance = new Chart(ctx, {
    type: 'bar',
    data: {
      labels,
      datasets: [{
        label: 'Occurrences',
        data: labels.map(l => counts[l]),
        backgroundColor: labels.map(l => DEVICE_COLORS[l] || '#ccc'),
        borderColor: 'rgba(0,0,0,0.15)',
        borderWidth: 1,
      }]
    },
    options: {
      responsive: true,
      plugins: { legend: { display: false } },
      scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
    }
  });
}

// ─── Suggest form ────────────────────────────────────────────────────────────
function openSuggestForm(ref) {
  const url = `https://docs.google.com/forms/d/e/1FAIpQLSf0pGZFjskpi5fASZ3aGKk0Ormp2qH1aggCRiu2pq5X9SuCbQ/viewform?usp=pp_url&entry.1645440068=${encodeURIComponent(ref)}`;
  document.getElementById('suggestionForm').src = url;
  formContainer.classList.remove('hidden');
}

closeFormBtn.addEventListener('click', () => {
  formContainer.classList.add('hidden');
  document.getElementById('suggestionForm').src = '';
});

// ─── Status helpers ──────────────────────────────────────────────────────────
function setStatus(msg) { statusMsg.textContent = msg; statusBar.classList.remove('hidden'); }
function clearStatus()  { statusBar.classList.add('hidden'); }

// ─── Selects population ──────────────────────────────────────────────────────
function populateBookSelect(section) {
  bookSel.innerHTML = '<option value="">All Books</option>';
  const books = section ? (TANACH_BOOKS[section] || []) : Object.values(TANACH_BOOKS).flat();
  books.forEach(b => {
    const o = document.createElement('option');
    o.value = b; o.textContent = b;
    bookSel.appendChild(o);
  });
}

function populateParshaSelect(book) {
  parshaSel.innerHTML = '<option value="">All Parshiot</option>';
  const parshas = BOOK_TO_PARSHAS[book] || [];
  parshas.forEach(p => {
    const o = document.createElement('option');
    o.value = p; o.textContent = p;
    parshaSel.appendChild(o);
  });
  parshaWrap.style.display = parshas.length ? 'flex' : 'none';
  aliyaWrap.style.display = 'none';
}

function populateAliyaSelect(parsha) {
  aliyaSel.innerHTML = '<option value="">All Aliyot</option>';
  const ranges = PARSHAS[parsha] || {};
  Object.keys(ranges).filter(k => k !== 'Whole Parsha').forEach(a => {
    const o = document.createElement('option');
    o.value = a; o.textContent = a;
    aliyaSel.appendChild(o);
  });
  aliyaWrap.style.display = Object.keys(ranges).length > 1 ? 'flex' : 'none';
}

// ─── Event listeners ─────────────────────────────────────────────────────────
sectionSel.addEventListener('change', () => {
  activeSection = sectionSel.value;
  activeBook = activeParsha = activeAliya = '';
  populateBookSelect(activeSection);
  parshaWrap.style.display = 'none';
  aliyaWrap.style.display  = 'none';
  bookSel.value = ''; parshaSel.value = ''; aliyaSel.value = '';
  syncURL(); render();
});

bookSel.addEventListener('change', () => {
  activeBook = bookSel.value;
  activeParsha = activeAliya = '';
  parshaSel.value = ''; aliyaSel.value = '';
  populateParshaSelect(activeBook);
  syncURL(); render();
});

parshaSel.addEventListener('change', () => {
  activeParsha = parshaSel.value;
  activeAliya = '';
  aliyaSel.value = '';
  if (activeParsha) populateAliyaSelect(activeParsha);
  else aliyaWrap.style.display = 'none';
  syncURL(); render();
});

aliyaSel.addEventListener('change', () => {
  activeAliya = aliyaSel.value;
  syncURL(); render();
});

// Device pill listeners are attached dynamically in buildDevicePills()

// ─── Sort buttons ───────────────────────────────────────────────────────────
document.getElementById('sortBiblical').addEventListener('click', () => {
  activeSort = 'biblical';
  document.getElementById('sortBiblical').classList.add('bg-indigo-500','text-white','border-indigo-400');
  document.getElementById('sortBiblical').classList.remove('bg-transparent');
  document.getElementById('sortNewest').classList.remove('bg-indigo-500','text-white','border-indigo-400');
  syncURL(); render();
});
document.getElementById('sortNewest').addEventListener('click', () => {
  activeSort = 'newest';
  document.getElementById('sortNewest').classList.add('bg-indigo-500','text-white','border-indigo-400');
  document.getElementById('sortNewest').classList.remove('bg-transparent');
  document.getElementById('sortBiblical').classList.remove('bg-indigo-500','text-white','border-indigo-400');
  syncURL(); render();
});

chartToggle.addEventListener('click', () => {
  const hidden = chartBox.classList.toggle('hidden');
  chartToggle.textContent = hidden ? 'Show Chart' : 'Hide Chart';
});

// ─── Tooltip: click to open, click outside to close ─────────────────────────
let openTip = null;
function closeOpenTip() {
  if (openTip) { openTip.classList.remove('visible'); openTip = null; }
}
versesEl.addEventListener('click', e => {
  const icon = e.target.closest('.note-icon');
  if (!icon) { closeOpenTip(); return; }
  e.stopPropagation();
  const tip = icon.parentElement?.querySelector('.note-tooltip');
  if (!tip) return;
  if (openTip && openTip !== tip) closeOpenTip();
  const isOpen = tip.classList.contains('visible');
  if (isOpen) {
    tip.classList.remove('visible'); openTip = null;
  } else {
    tip.classList.add('visible'); openTip = tip;
  }
});
document.addEventListener('click', () => closeOpenTip());

// ─── Browse mode ─────────────────────────────────────────────────────────────
const modeDevicesBtn  = document.getElementById('modeDevices');
const modeBrowseBtn   = document.getElementById('modeBrowse');
const browseControls  = document.getElementById('browseControls');
const deviceFiltersEl = document.getElementById('deviceFilters');
const browseBookSel   = document.getElementById('browseBook');
const browseChapterSel= document.getElementById('browseChapter');

// Populate browse book select with all books in order
BOOK_ORDER.forEach(b => {
  const o = document.createElement('option');
  o.value = b; o.textContent = b;
  browseBookSel.appendChild(o);
});

// Chapter counts per book (max chapters)
const BOOK_CHAPTERS = {
  Genesis:46,Exodus:40,Leviticus:27,Numbers:36,Deuteronomy:34,
  Joshua:24,Judges:21,'1 Samuel':31,'2 Samuel':24,'1 Kings':22,'2 Kings':25,
  Isaiah:66,Jeremiah:52,Ezekiel:48,Hosea:14,Joel:4,Amos:9,Obadiah:1,
  Jonah:4,Micah:7,Nahum:3,Habakkuk:3,Zephaniah:3,Haggai:2,Zechariah:14,Malachi:3,
  Psalms:150,Proverbs:31,Job:42,'Song of Songs':8,Ruth:4,Lamentations:5,
  Ecclesiastes:12,Esther:10,Daniel:12,Ezra:10,Nehemiah:13,'1 Chronicles':29,'2 Chronicles':36,
};

function setMode(browse) {
  browseMode = browse;
  if (browse) {
    modeDevicesBtn.classList.remove('bg-indigo-500','text-white');
    modeDevicesBtn.classList.add('bg-transparent','text-indigo-400');
    modeBrowseBtn.classList.add('bg-indigo-500','text-white');
    modeBrowseBtn.classList.remove('bg-transparent','text-indigo-400');
    browseControls.classList.remove('hidden');
    deviceFiltersEl.classList.add('hidden');
    chartBox.classList.add('hidden');
    chartToggle.classList.add('hidden');
    versesEl.innerHTML = '<p class="text-center text-secondary-light dark:text-secondary-dark">Select a book and chapter to read.</p>';
  } else {
    modeBrowseBtn.classList.remove('bg-indigo-500','text-white');
    modeBrowseBtn.classList.add('bg-transparent','text-indigo-400');
    modeDevicesBtn.classList.add('bg-indigo-500','text-white');
    modeDevicesBtn.classList.remove('bg-transparent','text-indigo-400');
    browseControls.classList.add('hidden');
    deviceFiltersEl.classList.remove('hidden');
    chartToggle.classList.remove('hidden');
    render();
  }
}

modeDevicesBtn.addEventListener('click', () => { setMode(false); syncURL(); });
modeBrowseBtn.addEventListener('click',  () => { setMode(true);  syncURL(); });

browseBookSel.addEventListener('change', () => {
  const book = browseBookSel.value;
  browseChapterSel.innerHTML = '<option value="">Select a chapter…</option>';
  browseChapterSel.disabled = !book;
  if (!book) return;
  const maxCh = BOOK_CHAPTERS[book] || 50;
  for (let i = 1; i <= maxCh; i++) {
    const o = document.createElement('option');
    o.value = i; o.textContent = `Chapter ${i}`;
    browseChapterSel.appendChild(o);
  }
  syncURL();
});

browseChapterSel.addEventListener('change', () => {
  const book = browseBookSel.value;
  const chapter = parseInt(browseChapterSel.value, 10);
  syncURL();
  if (!book || !chapter) return;
  renderBrowseChapter(book, chapter);
});

async function renderBrowseChapter(book, chapter) {
  setStatus(`Loading ${book} ${chapter} from Sefaria…`);
  const sefariaBook = (SEFARIA_BOOK_MAP[book] || book).replace(/ /g, '_');
  const ref = encodeURIComponent(`${sefariaBook}.${chapter}`);
  let verses = [];
  try {
    const res = await fetch(`https://www.sefaria.org/api/v3/texts/${ref}?version=primary&fill_in_missing_segments=0`);
    const data = await res.json();
    if (data.versions && data.versions.length) {
      const heb = data.versions.find(v => v.language === 'he') || data.versions[0];
      const raw = heb.text;
      verses = (Array.isArray(raw) ? raw : [raw]).map(t =>
        (t || '').replace(/<[^>]+>/g, '')
      );
    }
  } catch { /* leave empty */ }
  clearStatus();

  if (!verses.length) {
    versesEl.innerHTML = '<p class="text-center text-secondary-light dark:text-secondary-dark">Could not load chapter from Sefaria.</p>';
    return;
  }

  // Build a lookup of devices for this book/chapter from allRows
  const CANTILLATION = /[\u0591-\u05C7\uFB1D-\uFB4E]/g;
  function stripMarks(s) { return s ? s.replace(CANTILLATION, '') : ''; }
  function escapeRe(s) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }

  const deviceMap = {};
  allRows.filter(r => r.book === book && Number(r.chapter) === chapter).forEach(r => {
    const v = Number(r.verse);
    if (!deviceMap[v]) deviceMap[v] = [];
    deviceMap[v].push(r);
  });

  const sefariaUrl = `https://www.sefaria.org/${(SEFARIA_BOOK_MAP[book]||book).replace(/ /g,'_')}.${chapter}`;

  const cards = verses.map((rawText, i) => {
    const verseNum = i + 1;
    const ref = `${book} ${chapter}:${verseNum}`;
    let hebrewText = rawText;
    const devices = deviceMap[verseNum] || [];
    const footnotes = [];

    devices.forEach((d, idx) => {
      const color = deviceColor(d.device?.toLowerCase() || '');
      const noteN = idx + 1;
      if (d.words && hebrewText) {
        const strippedTarget = stripMarks(d.words);
        const strippedText   = stripMarks(hebrewText);
        const re = new RegExp(escapeRe(strippedTarget), 'g');
        let match;
        const origChars  = [...hebrewText];
        const stripChars = [...strippedText];
        const stripToOrig = [];
        let si = 0, oi = 0;
        while (oi < origChars.length) {
          if (si < stripChars.length && origChars[oi] === stripChars[si]) { stripToOrig[si] = oi; si++; }
          oi++;
        }
        const ranges = [];
        while ((match = re.exec(strippedText)) !== null) {
          const oS = stripToOrig[match.index];
          const oE = stripToOrig[match.index + match[0].length - 1];
          if (oS !== undefined && oE !== undefined) ranges.push([oS, oE]);
        }
        if (ranges.length) {
          let out = '', cursor = 0;
          for (const [oS, oE] of ranges) {
            out += hebrewText.slice(cursor, oS);
            out += `<span class="highlight" style="color:${color};border-bottom-color:${color}">${hebrewText.slice(oS, oE + 1)}<sup class="note">${noteN}</sup></span>`;
            cursor = oE + 1;
          }
          out += hebrewText.slice(cursor);
          hebrewText = out;
        }
      }
      const srcParts = d.sources ? d.sources.split(';').map(s => s.trim()) : [];
      const urlParts = d.urls    ? d.urls.split(';').map(u => u.trim())   : [];
      const srcsHtml = srcParts.map((s, i) => urlParts[i] ? `<a href="${urlParts[i]}" target="_blank" rel="noopener">${s}</a>` : s).join(', ');
      footnotes.push(`<span style="color:${color};font-weight:600">${noteN}. (${d.device})${srcsHtml ? ' ' + srcsHtml : ''}</span>`);
    });

    const hasBadges = devices.length > 0;
    return `
      <div class="verse-card bg-card-bg-light dark:bg-card-bg-dark border ${hasBadges ? 'border-indigo-400/40' : 'border-border-light dark:border-border-dark'} rounded-xl shadow-sm p-4">
        <div class="flex items-start justify-between gap-3 mb-2">
          <a href="${sefariaUrl}?verse=${verseNum}" target="_blank" rel="noopener" class="text-xs font-semibold text-accent hover:underline">${verseNum}</a>
          <div class="flex gap-1 flex-wrap">
            ${devices.map(d => {
              const c = deviceColor(d.device?.toLowerCase()||'');
              const badge = `<span class="text-xs px-2 py-0.5 rounded-full font-medium border" style="background:${c};color:#111">${d.device}</span>`;
              if (!d.notes) return badge;
              return `<span class="has-note">${badge}<span class="note-icon" tabindex="0">i</span><span class="note-tooltip" style="position:absolute;z-index:100;bottom:calc(100% + 8px);left:50%;transform:translateX(-50%);white-space:normal;width:220px;background:#1e1b4b;color:#e0e7ff;font-size:0.72rem;line-height:1.5;padding:7px 10px;border-radius:8px;box-shadow:0 4px 16px rgba(0,0,0,0.5);pointer-events:none;transition:opacity 0.15s ease;font-family:sans-serif;text-align:left;direction:ltr">${d.notes.replace(/</g,'&lt;')}<span style="position:absolute;top:100%;left:50%;transform:translateX(-50%);border:5px solid transparent;border-top-color:#1e1b4b"></span></span></span>`;
            }).join('')}
          </div>
        </div>
        <p class="hebrew-text text-primary-light dark:text-primary-dark mb-2">${hebrewText}</p>
        ${footnotes.length ? `<div class="source-block">${footnotes.join('<br>')}</div>` : ''}
      </div>`;
  }).join('');

  versesEl.innerHTML = `<h2 class="text-lg font-bold text-primary-light dark:text-primary-dark mb-4">${book} ${chapter}</h2>` + cards;
}

// ─── Restore state from URL params ──────────────────────────────────────────
function restoreFromURL() {
  const p = new URLSearchParams(location.search);
  activeDevice  = p.get('device')  || '';
  activeSection = p.get('section') || '';
  activeBook    = p.get('book')    || '';
  activeParsha  = p.get('parsha')  || '';
  activeAliya   = p.get('aliya')   || '';
  activeSort    = p.get('sort')    || 'biblical';

  // Restore section + book + parsha + aliya selects
  if (activeSection) { sectionSel.value = activeSection; populateBookSelect(activeSection); }
  if (activeBook)    { bookSel.value = activeBook; populateParshaSelect(activeBook); }
  if (activeParsha)  { parshaSel.value = activeParsha; populateAliyaSelect(activeParsha); }
  if (activeAliya)   { aliyaSel.value = activeAliya; }

  // Restore device pill active state
  document.querySelectorAll('.device-pill').forEach(b => {
    b.classList.toggle('active', b.dataset.device === activeDevice);
  });

  // Restore sort buttons
  if (activeSort === 'newest') {
    document.getElementById('sortNewest').classList.add('bg-indigo-500','text-white','border-indigo-400');
    document.getElementById('sortBiblical').classList.remove('bg-indigo-500','text-white','border-indigo-400');
  }

  // Restore browse mode
  const mode = p.get('mode');
  if (mode === 'browse') {
    setMode(true);
    const bb = p.get('bbook');
    const bc = p.get('bchapter');
    if (bb) {
      browseBookSel.value = bb;
      // populate chapter select
      const maxCh = BOOK_CHAPTERS[bb] || 50;
      browseChapterSel.innerHTML = '<option value="">Select a chapter…</option>';
      for (let i = 1; i <= maxCh; i++) {
        const o = document.createElement('option');
        o.value = i; o.textContent = `Chapter ${i}`;
        browseChapterSel.appendChild(o);
      }
      browseChapterSel.disabled = false;
      if (bc) {
        browseChapterSel.value = bc;
        renderBrowseChapter(bb, parseInt(bc, 10));
      }
    }
  }
}

// ─── Init ────────────────────────────────────────────────────────────────────
(async () => {
  // Chart.js must be loaded
  if (typeof Chart === 'undefined') {
    const s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/chart.js';
    s.onload = async () => { await loadFromSupabase(); restoreFromURL(); if (!browseMode) render(); };
    document.head.appendChild(s);
  } else {
    await loadFromSupabase();
    restoreFromURL();
    if (!browseMode) render();
  }
})();
</script>
