---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Literary Bible"
  description="Explore literary devices in the Hebrew Bible — color-coded verses with device annotations pulled from Supabase, and live text from the Sefaria API."
>
  <main class="container mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-8">

    <header class="max-w-3xl mx-auto text-center space-y-3">
      <p class="text-sm uppercase tracking-[0.3em] text-secondary-light dark:text-secondary-dark">Interactive Study Tool</p>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-primary-light dark:text-primary-dark">
        Literary Bible
      </h1>
      <p class="text-base sm:text-lg text-secondary-light dark:text-secondary-dark">
        Color-coded literary devices in Tanakh — annotations from my research database, verse text pulled live from Sefaria.
      </p>
    </header>

    <!-- Controls -->
    <section class="bg-card-bg-light dark:bg-card-bg-dark border border-border-light dark:border-border-dark rounded-xl shadow-md p-5 space-y-4">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">

        <label class="flex flex-col gap-1 text-sm font-medium text-primary-light dark:text-primary-dark">
          Section
          <select id="sectionSelect"
            class="rounded border border-border-light dark:border-border-dark bg-white dark:bg-slate-900 px-3 py-2 text-sm text-primary-light dark:text-primary-dark">
            <option value="">All Sections</option>
            <option value="Torah">Torah</option>
            <option value="Neviim">Neviim</option>
            <option value="Ketuvim">Ketuvim</option>
          </select>
        </label>

        <label class="flex flex-col gap-1 text-sm font-medium text-primary-light dark:text-primary-dark">
          Book
          <select id="bookSelect"
            class="rounded border border-border-light dark:border-border-dark bg-white dark:bg-slate-900 px-3 py-2 text-sm text-primary-light dark:text-primary-dark">
            <option value="">All Books</option>
          </select>
        </label>

        <label class="flex flex-col gap-1 text-sm font-medium text-primary-light dark:text-primary-dark" id="parshaLabelWrap" style="display:none">
          Parsha
          <select id="parshaSelect"
            class="rounded border border-border-light dark:border-border-dark bg-white dark:bg-slate-900 px-3 py-2 text-sm text-primary-light dark:text-primary-dark">
            <option value="">All Parshiot</option>
          </select>
        </label>

        <label class="flex flex-col gap-1 text-sm font-medium text-primary-light dark:text-primary-dark" id="aliyaLabelWrap" style="display:none">
          Aliya
          <select id="aliyaSelect"
            class="rounded border border-border-light dark:border-border-dark bg-white dark:bg-slate-900 px-3 py-2 text-sm text-primary-light dark:text-primary-dark">
            <option value="">All Aliyot</option>
          </select>
        </label>

      </div>
    </section>

    <!-- Mode toggle -->
    <div class="flex justify-center gap-3">
      <button id="modeDevices" class="mode-btn px-5 py-2 rounded-full text-sm font-semibold border-2 border-indigo-500 bg-indigo-500 text-white transition-all">Devices Only</button>
      <button id="modeBrowse"  class="mode-btn px-5 py-2 rounded-full text-sm font-semibold border-2 border-indigo-500 text-indigo-400 bg-transparent transition-all">Browse Full Text</button>
    </div>

    <!-- Browse mode controls (hidden by default) -->
    <div id="browseControls" class="hidden bg-card-bg-light dark:bg-card-bg-dark border border-border-light dark:border-border-dark rounded-xl shadow-md p-5">
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="flex flex-col gap-1 text-sm font-medium text-primary-light dark:text-primary-dark">
          Book
          <select id="browseBook" class="rounded border border-border-light dark:border-border-dark bg-white dark:bg-slate-900 px-3 py-2 text-sm text-primary-light dark:text-primary-dark">
            <option value="">Select a book…</option>
          </select>
        </label>
        <label class="flex flex-col gap-1 text-sm font-medium text-primary-light dark:text-primary-dark">
          Chapter
          <select id="browseChapter" class="rounded border border-border-light dark:border-border-dark bg-white dark:bg-slate-900 px-3 py-2 text-sm text-primary-light dark:text-primary-dark" disabled>
            <option value="">Select a chapter…</option>
          </select>
        </label>
      </div>
    </div>

    <!-- Sort control -->
    <div id="sortControl" class="flex justify-end items-center gap-2 text-sm text-primary-light dark:text-primary-dark">
      <span class="font-medium">Sort:</span>
      <button id="sortBiblical" class="sort-btn px-3 py-1 rounded-full border border-indigo-400 bg-indigo-500 text-white text-xs font-semibold transition-all">Biblical Order</button>
      <button id="sortNewest"   class="sort-btn px-3 py-1 rounded-full border border-border-light dark:border-border-dark text-xs font-semibold transition-all">Recently Added</button>
    </div>

    <!-- Device filter pills — populated dynamically from Supabase -->
    <div id="deviceFilters" class="flex flex-wrap gap-2 justify-center">
      <button data-device="" class="device-pill active px-4 py-1.5 rounded-full text-sm font-medium border transition-all" style="background:#e2e8f0;color:#1a1a1a">All</button>
    </div>

    <!-- Chart toggle -->
    <div class="flex justify-center">
      <button id="toggleChartBtn"
        class="px-4 py-2 rounded-lg border border-border-light dark:border-border-dark text-sm font-medium text-primary-light dark:text-primary-dark hover:bg-hover-light dark:hover:bg-hover-dark transition-colors">
        Show Chart
      </button>
    </div>
    <div id="chartContainer" class="hidden bg-card-bg-light dark:bg-card-bg-dark border border-border-light dark:border-border-dark rounded-xl shadow-md p-5">
      <canvas id="deviceChart"></canvas>
    </div>

    <!-- Status / loading -->
    <div id="statusBar" class="text-center text-sm text-secondary-light dark:text-secondary-dark hidden">
      <span id="statusMsg">Loading…</span>
    </div>

    <!-- Verses output -->
    <div id="versesContainer" class="space-y-4">
      <p class="text-center text-secondary-light dark:text-secondary-dark">Select filters above to explore literary devices.</p>
    </div>

    <!-- Suggestion form (floating) -->
    <div id="formContainer" class="fixed left-4 top-1/3 w-80 max-w-[90vw] z-50 hidden bg-white dark:bg-slate-900 rounded-xl shadow-2xl border border-border-light dark:border-border-dark p-4">
      <button id="closeFormBtn" class="absolute top-2 right-2 text-xs bg-red-500 text-white px-2 py-1 rounded">Close</button>
      <iframe id="suggestionForm" src="" frameborder="0" class="w-full h-72 rounded-lg mt-4"></iframe>
    </div>

  </main>
</Layout>

<style>
  .device-pill.active {
    outline: 2px solid #6366f1;
    outline-offset: 2px;
  }
  .device-pill { color: #1a1a1a; }
  .verse-card { transition: transform 0.15s ease, box-shadow 0.15s ease; }
  .verse-card:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(0,0,0,0.12); }
  .highlight {
    border-bottom: 3px solid currentColor;
    padding-bottom: 1px;
    border-radius: 0;
    background: transparent !important;
    font-weight: 700;
    display: inline;
  }
  sup.note {
    font-size: 0.55em;
    vertical-align: super;
    line-height: 0;
    margin-right: 2px;
    font-weight: 400;
    font-family: sans-serif;
  }
  .source-block { font-size: 0.82rem; margin-top: 0.6rem; line-height: 1.7; border-top: 1px solid rgba(255,255,255,0.08); padding-top: 0.5rem; }
  .source-block a { color: #a78bfa; text-decoration: none; }
  .source-block a:hover { text-decoration: underline; }
  .hebrew-text { font-family: 'Noto Serif Hebrew', 'Frank Ruhl Libre', 'SBL Hebrew', serif; font-size: 1.2rem; direction: rtl; line-height: 2.8; }
  /* Notes tooltip */
  .has-note {
    position: relative;
    display: inline-flex; align-items: center;
    overflow: visible;
  }
  .note-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 18px; height: 18px; border-radius: 50%;
    background: rgba(0,0,0,0.35); color: #fff;
    font-size: 11px; font-weight: 700; font-family: sans-serif;
    cursor: pointer; flex-shrink: 0; line-height: 1;
    user-select: none;
  }
  .note-icon:hover { background: rgba(0,0,0,0.55); }
  .note-tooltip {
    visibility: hidden; opacity: 0;
    position: absolute; z-index: 100;
    bottom: calc(100% + 8px); left: 50%; transform: translateX(-50%);
    white-space: normal; width: 220px;
    background: #1e1b4b; color: #e0e7ff;
    font-size: 0.72rem; line-height: 1.5;
    padding: 7px 10px; border-radius: 8px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.5);
    pointer-events: none;
    transition: opacity 0.15s ease;
    font-family: sans-serif; text-align: left; direction: ltr;
  }
  .note-tooltip::after {
    content: '';
    position: absolute; top: 100%; left: 50%; transform: translateX(-50%);
    border: 5px solid transparent; border-top-color: #1e1b4b;
  }
  .note-tooltip { visibility: hidden; opacity: 0; }
  .has-note:hover .note-tooltip,
  .has-note:focus-within .note-tooltip,
  .note-tooltip.visible { visibility: visible; opacity: 1; }
</style>

<script>
// ─── Config ────────────────────────────────────────────────────────────────
const SUPABASE_URL  = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_KEY  = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
const TABLE         = 'literary_bible';

// ─── Device colours — known devices get fixed colours; unknowns pull from palette
const DEVICE_COLORS = {
  'waw-explicativum': '#90EE90',
  'hendiadys':        '#ADD8E6',
  'synecdoche':       '#FFA07A',
  'hapax':            '#87CEFA',
  'merism':           '#FFB6C1',
  'wordplay':         '#FFFACD',
  'euphemism':        '#E0FFFF',
  'simile':           '#DDA0DD',
  'ambiguity':        '#FA8072',
  'melitza':          '#C8A2C8',
  'metaphor':         '#FFDAB9',
  'sarcasm':          '#FFD700',
};
const COLOR_PALETTE = [
  '#B5EAD7','#FFDAC1','#C7CEEA','#E2F0CB','#FFD700','#D4A5A5',
  '#A8D8EA','#FCE4EC','#F0E6FF','#D5F5E3','#FAD7A0','#AED6F1',
];
function deviceColor(device) {
  if (DEVICE_COLORS[device]) return DEVICE_COLORS[device];
  // Deterministic color from palette based on name hash
  let hash = 0;
  for (const ch of device) hash = (hash * 31 + ch.charCodeAt(0)) & 0xffff;
  const color = COLOR_PALETTE[hash % COLOR_PALETTE.length];
  DEVICE_COLORS[device] = color; // cache it
  return color;
}

// ─── Tanach book lists ──────────────────────────────────────────────────────
const TANACH_BOOKS = {
  Torah:   ['Genesis','Exodus','Leviticus','Numbers','Deuteronomy'],
  Neviim:  ['Joshua','Judges','1 Samuel','2 Samuel','1 Kings','2 Kings',
            'Isaiah','Jeremiah','Ezekiel','Hosea','Joel','Amos','Obadiah',
            'Jonah','Micah','Nahum','Habakkuk','Zephaniah','Haggai','Zechariah','Malachi'],
  Ketuvim: ['Psalms','Proverbs','Job','Song of Songs','Ruth','Lamentations',
            'Ecclesiastes','Esther','Daniel','Ezra','Nehemiah','1 Chronicles','2 Chronicles'],
};

// Normalize book names that may come from Supabase without spaces
const BOOK_NAME_FIX = {
  'SongofSongs':   'Song of Songs',
  'SongOfSongs':   'Song of Songs',
  '1Samuel':       '1 Samuel',
  '2Samuel':       '2 Samuel',
  '1Kings':        '1 Kings',
  '2Kings':        '2 Kings',
  '1Chronicles':   '1 Chronicles',
  '2Chronicles':   '2 Chronicles',
};

// Sefaria uses slightly different names for some books
const SEFARIA_BOOK_MAP = {
  '1 Samuel':    'I_Samuel',    '2 Samuel':    'II_Samuel',
  '1 Kings':     'I_Kings',     '2 Kings':     'II_Kings',
  '1 Chronicles':'I_Chronicles','2 Chronicles':'II_Chronicles',
  'Song of Songs':'Song_of_Songs',
};

// Canonical biblical book order for sorting
const BOOK_ORDER = [
  'Genesis','Exodus','Leviticus','Numbers','Deuteronomy',
  'Joshua','Judges','1 Samuel','2 Samuel','1 Kings','2 Kings',
  'Isaiah','Jeremiah','Ezekiel','Hosea','Joel','Amos','Obadiah',
  'Jonah','Micah','Nahum','Habakkuk','Zephaniah','Haggai','Zechariah','Malachi',
  'Psalms','Proverbs','Job','Song of Songs','Ruth','Lamentations',
  'Ecclesiastes','Esther','Daniel','Ezra','Nehemiah','1 Chronicles','2 Chronicles',
];

const BOOK_TO_SECTION = {};
for (const [section, books] of Object.entries(TANACH_BOOKS)) {
