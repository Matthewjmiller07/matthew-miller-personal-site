// ── Range parsing helpers ──────────────────────────────────────────────────
function parseRange(str: string) {
  // "Genesis 1:1-6:8" or "Genesis 1:1-2:3"
  const dash = str.lastIndexOf('-');
  if (dash < 0) return null;
  const startStr = str.slice(0, dash).trim();
  const endStr   = str.slice(dash + 1).trim();
  const lastSp = startStr.lastIndexOf(' ');
  const book = startStr.slice(0, lastSp);
  const [sc, sv] = startStr.slice(lastSp + 1).split(':').map(Number);
  const [ec, ev] = endStr.split(':').map(Number);
  return { book, sc, sv, ec, ev };
}

function findParshaForChapter(book: string, ch: number): string {
  for (const [parsha, data] of Object.entries(PARSHAS)) {
    const range = data['Whole Parsha'];
    if (!range) continue;
    const parsed = parseRange(range);
    if (!parsed) continue;
    if (parsed.book === book && ch >= parsed.sc && ch <= parsed.ec) return parsha;
  }
  return '';
}

// ── XML helpers ────────────────────────────────────────────────────────────
function getByTag(node: Element|Document, tag: string): Element[] {
  const ns = node.getElementsByTagNameNS('*', tag);
  if (ns && ns.length) return Array.from(ns);
  return Array.from(node.getElementsByTagName(tag));
}

async function fetchXml(book: string): Promise<Document|null> {
  const code = BOOK_XML[book];
  if (!code) return null;
  if (xmlCache.has(code)) return xmlCache.get(code)!;
  try {
    const r = await fetch(`${DATA_PATH}${code}.xml`);
    if (!r.ok) throw new Error('Not found');
    const txt = await r.text();
    const doc = new DOMParser().parseFromString(txt, 'application/xml');
    xmlCache.set(code, doc);
    return doc;
  } catch { return null; }
}

// ── English translation (Sefaria) ─────────────────────────────────────────
function stripSefariaHtml(t: string): string {
  return (t || '')
    .replace(/<[^>]+>/g, '')                 // strip all HTML tags
    .replace(/&thinsp;/g, '')               // thin spaces (used around Hebrew paseq ׀)
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#x[0-9a-fA-F]+;/gi, '')     // hex numeric entities
    .replace(/&#[0-9]+;/g, '')             // decimal numeric entities
    .replace(/\s+/g, ' ')
    .trim();
}

async function fetchEnglishChapter(book: string, chapter: number): Promise<string[]> {
  const key = `${book}:${chapter}`;
  if (englishCache.has(key)) return englishCache.get(key)!;
  try {
    const sefariaBook = (SEFARIA_BOOK_MAP[book] || book).replace(/ /g, '_');
    const ref = encodeURIComponent(`${sefariaBook}.${chapter}`);
    // v1 API: data.text = English, data.he = Hebrew
    const res = await fetch(`https://www.sefaria.org/api/texts/${ref}?context=0&pad=0&commentary=0`);
    const data = await res.json();
    let verses: string[] = [];
    const raw = data.text;
    if (Array.isArray(raw)) {
      verses = raw.map((t: any) => {
        if (Array.isArray(t)) return (t as string[]).map(s => stripSefariaHtml(String(s || ''))).join(' ');
        return stripSefariaHtml(String(t || ''));
      }).filter(Boolean);
    }
    englishCache.set(key, verses);
    return verses;
  } catch {
    englishCache.set(key, []);
    return [];
  }
}

// ── Supabase devices ───────────────────────────────────────────────────────
async function fetchDevices(book: string): Promise<any[]> {
  if (supabaseCache.has(book)) return supabaseCache.get(book)!;
  if (!SUPABASE_URL || !SUPABASE_KEY) return [];
  try {
    const r = await fetch(
      `${SUPABASE_URL}/rest/v1/literary_bible?select=book,chapter,verse,device,words,sources,urls,notes&book=eq.${encodeURIComponent(book)}`,
      { headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${SUPABASE_KEY}` } }
    );
    if (!r.ok) return [];
    const rows = await r.json();
    supabaseCache.set(book, rows);
    return rows;
  } catch { return []; }
}

// ── POS helper ────────────────────────────────────────────────────────────
const CANTILLATION = /[֑-ׇ]/g;
function stripMarks(s: string) { return s ? s.replace(CANTILLATION, '') : ''; }

function getPosClasses(morph: string): string[] {
  if (!morph) return [];
  const cls: string[] = [];
  if (/(^|[^V])N/.test(morph)) cls.push('pos-noun');
  if (/V/.test(morph)) cls.push('pos-verb');
  if (/Np/.test(morph)) cls.push('pos-proper-noun');
  if (/D/.test(morph)) cls.push('pos-adverb');
  return cls;
}

// ── Device pill management ─────────────────────────────────────────────────
let devInstances: Element[] = [];
let devIdx = 0;

function scrollToDevInstance(idx: number) {
  if (!devInstances.length) return;
  devIdx = (idx + devInstances.length) % devInstances.length;
  devPos.textContent = `${devIdx + 1} / ${devInstances.length}`;
  devInstances[devIdx].scrollIntoView({ behavior: 'smooth', block: 'center' });
}

document.getElementById('devPrev')!.addEventListener('click', () => scrollToDevInstance(devIdx - 1));
document.getElementById('devNext')!.addEventListener('click', () => scrollToDevInstance(devIdx + 1));

function updateDevicePills(allDevices: any[]) {
  devicePills.innerHTML = '';
  // Build count map from current passage if available
  const countMap = new Map<string, number>();
  main.querySelectorAll('.w[data-devices]').forEach(w => {
    const ds = (w as HTMLElement).dataset.devices?.split(',') || [];
    ds.forEach(d => countMap.set(d, (countMap.get(d) || 0) + 1));
  });

  const makeBtn = (label: string, val: string, count?: number) => {
    const btn = document.createElement('button');
    btn.className = 'sb-pill' + (val === activeDevice ? ' active' : '');
    btn.dataset.device = val;
    btn.textContent = label;
    if (count) {
      const badge = document.createElement('span');
      badge.className = 'sb-pill-count';
      badge.textContent = String(count);
      btn.appendChild(badge);
    }
    btn.addEventListener('click', () => {
      activeDevice = val;
      devicePills.querySelectorAll('.sb-pill').forEach(b => {
        (b as HTMLElement).classList.toggle('active', (b as HTMLElement).dataset.device === val);
      });
      main.querySelectorAll('.verse-block').forEach(vb => {
        if (!val) { (vb as HTMLElement).style.display = ''; return; }
        const hasDevice = vb.querySelector(`.w[data-devices*="${val}"]`);
        (vb as HTMLElement).style.display = hasDevice ? '' : 'none';
      });
      // Hide haftarah section when filtering by device
      const haftSection = main.querySelector('.haftarah-section') as HTMLElement | null;
      if (haftSection) haftSection.style.display = val ? 'none' : '';
      // Update instance navigator
      if (val) {
        devInstances = Array.from(main.querySelectorAll(`.w[data-devices*="${val}"]`));
        devNav.classList.remove('hidden');
        devIdx = 0;
        scrollToDevInstance(0);
      } else {
        devInstances = [];
        devNav.classList.add('hidden');
      }
    });
    return btn;
  };
  devicePills.appendChild(makeBtn('All', ''));
  const seen = new Set<string>();
  allDevices.forEach(r => {
    const d = r.device?.toLowerCase();
    if (d && !seen.has(d)) {
      seen.add(d);
      devicePills.appendChild(makeBtn(d, d, countMap.get(d)));
    }
  });
}

// ── Main render ────────────────────────────────────────────────────────────
async function renderRange(
  book: string, sc: number, sv: number, ec: number, ev: number,
  parsha?: string, aliyaLabel?: string, skipEnglish = false, appendMode = false
) {
  if (!appendMode) {
    main.innerHTML = '';
    const loaderWrap = document.createElement('div');
    loaderWrap.className = 'mb-loader-wrap';
    loaderWrap.innerHTML = `<div class="mb-loader-label">Loading…</div><div class="mb-loader-bar"></div>`;
    main.appendChild(loaderWrap);
  }
  setStatus('');

  try {
    const [xmlDoc, devices] = await Promise.all([
      fetchXml(book),
      fetchDevices(book),
    ]);

    if (!appendMode) main.innerHTML = '';
    updateDevicePills(devices);

    // Context header
    const ctx = document.createElement('div');
    ctx.className = 'mb-context';
    let ctxText = `<span>${book}</span>`;
    if (parsha) ctxText += ` · <span>${parsha}</span>`;
    if (aliyaLabel) ctxText += ` · <span>${aliyaLabel}</span>`;
    ctxText += ` · Ch ${sc}${sc !== ec ? '–'+ec : ''}`;
    ctx.innerHTML = ctxText;
    main.appendChild(ctx);

    if (!xmlDoc) {
      main.innerHTML += `<div class="mb-placeholder">Could not load text for <em>${book}</em>.</div>`;
      return;
    }

    const bookCode = BOOK_XML[book];
    let verseCount = 0;

    // Collect stats as we render
    interface WordStats { total:number; nouns:Map<string,{text:string,count:number}>; verbs:Map<string,{text:string,count:number}>; properNouns:Map<string,{text:string,count:number}>; adverbs:Map<string,{text:string,count:number}>; lemmaFreq:Map<string,{text:string,count:number}>; }
    const stats: WordStats = { total:0, nouns:new Map(), verbs:new Map(), properNouns:new Map(), adverbs:new Map(), lemmaFreq:new Map() };

    const verseBlocks: Element[] = [];

    for (let ch = sc; ch <= ec; ch++) {
      const chId = `${bookCode}.${ch}`;
      const chapters = getByTag(xmlDoc, 'chapter');
      const chapterNode = chapters.find(c => c.getAttribute('osisID') === chId);
      if (!chapterNode) continue;

      const englishVerses = (skipEnglish || (ec - sc) > 2) ? [] : await fetchEnglishChapter(book, ch);

      const verses = getByTag(chapterNode, 'verse');
      for (const verseNode of verses) {
        const osisId = verseNode.getAttribute('osisID') || '';
        const parts  = osisId.split('.');
        const vNum   = parseInt(parts[2] || '0');
        if (!vNum) continue;
        const minV = ch === sc ? sv : 1;
        const maxV = ch === ec ? ev : Infinity;
        if (vNum < minV || vNum > maxV) continue;

        // Collect stats from words
        getByTag(verseNode, 'w').forEach(wEl => {
          const text  = wEl.textContent || '';
          const morph = wEl.getAttribute('morph') || '';
          const lemma = wEl.getAttribute('lemma') || text;
          if (!text.trim()) return;
          stats.total++;
          const bare = stripMarks(text);
          const existing = stats.lemmaFreq.get(lemma) || {text: bare, count:0};
          stats.lemmaFreq.set(lemma, {text: bare, count: existing.count + 1});
          if (/V/.test(morph)) {
            const e = stats.verbs.get(lemma) || {text: bare, count:0};
            stats.verbs.set(lemma, {text: bare, count: e.count+1});
          } else if (/(^|[^V])N/.test(morph)) {
            if (/Np/.test(morph)) {
              const e = stats.properNouns.get(lemma) || {text: bare, count:0};
              stats.properNouns.set(lemma, {text: bare, count: e.count+1});
            } else {
              const e = stats.nouns.get(lemma) || {text: bare, count:0};
              stats.nouns.set(lemma, {text: bare, count: e.count+1});
            }
          } else if (/D/.test(morph)) {
            const e = stats.adverbs.get(lemma) || {text: bare, count:0};
            stats.adverbs.set(lemma, {text: bare, count: e.count+1});
          }
        });

        const verseDevices = devices.filter(
          d => String(d.chapter) === String(ch) && String(d.verse) === String(vNum)
        );
        const englishText = englishVerses[vNum - 1] || '';
        const block = buildVerseBlock(verseNode, book, ch, vNum, verseDevices, englishText);
        verseBlocks.push(block);
        verseCount++;
      }
    }

    // Build stats panel then append verses (stats only in non-append mode)
    if (!appendMode) main.appendChild(buildStatsPanel(stats, devices.length));
    verseBlocks.forEach(b => main.appendChild(b));

    // Haftarah section for Torah books
    if (TORAH_BOOKS.has(book) && parsha && haftarahData && haftarahData[parsha]) {
      main.appendChild(await buildHaftarahSection(parsha));
    }

    setStatus(`${verseCount} verse${verseCount !== 1 ? 's' : ''}`);
    updateDevicePills(devices);

  } catch (e) {
    main.innerHTML = `<div class="mb-placeholder">Error loading content. Please try again.</div>`;
    setStatus('');
  }
}

// ── Stats panel ────────────────────────────────────────────────────────────
function buildStatsPanel(stats: any, deviceCount: number): HTMLElement {
  const panel = document.createElement('div');
  panel.className = 'mb-stats';

  // Summary chips row
  const chipsRow = document.createElement('div');
  chipsRow.className = 'mb-stats-row';

  const makeStat = (label: string, color: string, map: Map<string,{text:string,count:number}>, cssFilter?: string) => {
    const chip = document.createElement('div');
    chip.className = 'mb-stat-chip';
    const total = Array.from(map.values()).reduce((s,v) => s + v.count, 0);
    chip.innerHTML = `<span class="chip-dot" style="background:${color}"></span>${label}: <span class="chip-count">${total}</span>`;
    // Word list panel
    const wl = document.createElement('div');
    wl.className = 'mb-wordlist-panel';
    const sorted = Array.from(map.values()).sort((a,b) => b.count - a.count);
    wl.innerHTML = `<div class="mb-wordlist-content">${sorted.map(w => `${w.text}${w.count > 1 ? ' ('+w.count+')' : ''}`).join(' · ')}</div>`;
    chip.addEventListener('click', () => {
      wl.classList.toggle('open');
      chip.classList.toggle('active');
      if (cssFilter) {
        // Toggle the corresponding POS sidebar checkbox
        const cbId = cssFilter === 'pos-noun' ? 'posNoun'
                   : cssFilter === 'pos-verb' ? 'posVerb'
                   : cssFilter === 'pos-proper-noun' ? 'posProper' : 'posAdverb';
        const cb = document.getElementById(cbId) as HTMLInputElement | null;
        if (cb) { cb.checked = !cb.checked; cb.dispatchEvent(new Event('change')); }
      }
    });
    const wrap = document.createElement('div');
    wrap.appendChild(chip);
    wrap.appendChild(wl);
    return wrap;
  };

  chipsRow.appendChild(makeStat('Nouns', '#fbbf24', stats.nouns, 'pos-noun'));
  chipsRow.appendChild(makeStat('Verbs', '#60a5fa', stats.verbs, 'pos-verb'));
  chipsRow.appendChild(makeStat('Proper Nouns', 'rgba(167,139,250,.8)', stats.properNouns, 'pos-proper-noun'));
  chipsRow.appendChild(makeStat('Adverbs', '#34d399', stats.adverbs, 'pos-adverb'));
  if (deviceCount > 0) {
    const dchip = document.createElement('div');
    dchip.className = 'mb-stat-chip';
    dchip.innerHTML = `<span class="chip-dot" style="background:var(--gold)"></span>Devices: <span class="chip-count">${deviceCount}</span>`;
    chipsRow.appendChild(dchip);
  }

  // Total words chip (no map)
  const totalChip = document.createElement('div');
  totalChip.className = 'mb-stat-chip';
  totalChip.style.marginRight = 'auto';
  totalChip.innerHTML = `Words: <span class="chip-count">${stats.total}</span>`;
  chipsRow.insertBefore(totalChip, chipsRow.firstChild);

  panel.appendChild(chipsRow);

  // Frequency bar chart with POS tabs
  const chartMaps: Record<string, Map<string,{text:string,count:number}>> = {
    all:    stats.lemmaFreq,
    nouns:  stats.nouns,
    verbs:  stats.verbs,
    proper: stats.properNouns,
    adverbs:stats.adverbs,
  };
  const chartLabels: Record<string, string> = { all:'All', nouns:'Nouns', verbs:'Verbs', proper:'Proper', adverbs:'Adverbs' };

  const allVals = Array.from((stats.lemmaFreq as Map<string,{text:string,count:number}>).values()).filter(v => v.text.length > 0);
  if (allVals.length) {
    const chartDiv = document.createElement('div');
    chartDiv.className = 'mb-freq-chart';

    const title = document.createElement('div');
    title.className = 'mb-freq-title';
    title.textContent = 'Top Word Frequencies';
    chartDiv.appendChild(title);

    // Tab buttons
    const tabsDiv = document.createElement('div');
    tabsDiv.className = 'mb-chart-tabs';

    const barsDiv = document.createElement('div');
    barsDiv.className = 'mb-freq-bars';

    const renderBars = (mapKey: string) => {
      barsDiv.innerHTML = '';
      const vals = Array.from(chartMaps[mapKey].values())
        .filter(v => v.text.length > 0)
        .sort((a,b) => b.count - a.count)
        .slice(0, 15);
      if (!vals.length) { barsDiv.innerHTML = '<div style="font-family:var(--display);font-style:italic;color:var(--muted);font-size:.78rem">No entries</div>'; return; }
      const max = vals[0].count;
      vals.forEach(w => {
        const row = document.createElement('div');
        row.className = 'mb-freq-bar-row';
        row.style.cursor = 'pointer';
        row.title = `Click to highlight "${w.text}"`;
        row.innerHTML = `
          <div class="mb-freq-label">${w.text}</div>
          <div class="mb-freq-bar-wrap"><div class="mb-freq-bar" style="width:${Math.round(w.count/max*100)}%"></div></div>
          <div class="mb-freq-bar-num">${w.count}</div>`;
        row.addEventListener('click', () => {
          const target = w.text;
          const matches = Array.from(main.querySelectorAll('.w')).filter(el => stripMarks((el as HTMLElement).textContent || '') === target);
          if (!matches.length) return;
          matches[0].scrollIntoView({ behavior:'smooth', block:'center' });
          matches.forEach(el => { el.classList.add('flash'); setTimeout(() => el.classList.remove('flash'), 1500); });
        });
        barsDiv.appendChild(row);
      });
    };

    let activeTab = 'all';
    Object.keys(chartLabels).forEach(key => {
      const btn = document.createElement('button');
      btn.className = 'mb-chart-tab' + (key === 'all' ? ' active' : '');
      btn.textContent = chartLabels[key];
      btn.addEventListener('click', () => {
        activeTab = key;
        tabsDiv.querySelectorAll('.mb-chart-tab').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        renderBars(key);
      });
      tabsDiv.appendChild(btn);
    });

    chartDiv.appendChild(tabsDiv);
    renderBars('all');
    chartDiv.appendChild(barsDiv);
    panel.appendChild(chartDiv);
  }

  return panel;
}

// ── Haftarah data viz ─────────────────────────────────────────────────────
function buildHaftarahViz(parsha: string): HTMLElement {
  const panel = document.createElement('div');
  panel.className = 'mb-stats';

  const titleEl = document.createElement('div');
  titleEl.className = 'mb-freq-title';
  titleEl.textContent = `Haftarah Overview — ${parsha}`;
  panel.appendChild(titleEl);

  const parshaData = haftarahData?.[parsha] || {};
  const RITES_ORDER = ['Ashkenazi','Sephardi','Yemenite','Italian','Karaite','Romaniote','Chabad'];

  // Comparison table
  const table = document.createElement('div');
  table.style.cssText = 'display:grid;grid-template-columns:100px 1fr auto;gap:.25rem .6rem;margin-bottom:.75rem;font-size:.78rem;';

  ['Rite','References','Verses'].forEach(h => {
    const hd = document.createElement('div');
    hd.style.cssText = 'font-family:var(--sc);font-size:.5rem;letter-spacing:.15em;color:var(--muted);text-transform:uppercase;border-bottom:1px solid var(--border);padding-bottom:.2rem;';
    hd.textContent = h;
    table.appendChild(hd);
  });

  const riteCounts: {rite:string, count:number}[] = [];

  RITES_ORDER.forEach(rite => {
    const d = parshaData[rite];
    if (!d) return;
    const refs = (d.references || []).join(', ');
    const count = (d.individual_verses || []).length;
    riteCounts.push({rite, count});

    const r1 = document.createElement('div'); r1.style.cssText='font-family:var(--sc);font-size:.7rem;color:var(--gold)'; r1.textContent = rite;
    const r2 = document.createElement('div'); r2.style.cssText='color:var(--text);font-family:var(--display)'; r2.textContent = refs;
    const r3 = document.createElement('div'); r3.style.cssText='font-family:var(--mono);color:var(--muted);font-size:.7rem'; r3.textContent = count ? String(count) : '—';
    [r1,r2,r3].forEach(el => table.appendChild(el));
  });
  panel.appendChild(table);

  // Bar chart of verses by rite
  if (riteCounts.length) {
    const barTitle = document.createElement('div');
    barTitle.className = 'mb-freq-title';
    barTitle.textContent = 'Verses by Rite';
    panel.appendChild(barTitle);

    const barsDiv = document.createElement('div');
    barsDiv.className = 'mb-freq-bars';
    const maxC = Math.max(...riteCounts.map(r => r.count));
    riteCounts.forEach(({rite, count}) => {
      const row = document.createElement('div');
      row.className = 'mb-freq-bar-row';
      row.innerHTML = `
        <div class="mb-freq-label" style="font-family:var(--sc);font-size:.6rem;letter-spacing:.1em;direction:ltr">${rite}</div>
        <div class="mb-freq-bar-wrap"><div class="mb-freq-bar" style="width:${maxC ? Math.round(count/maxC*100) : 0}%"></div></div>
        <div class="mb-freq-bar-num">${count}</div>`;
      barsDiv.appendChild(row);
    });
    panel.appendChild(barsDiv);
  }

  // ── Book Sources ────────────────────────────────────────────────────────
  const RITE_COLORS: Record<string,string> = {
    'Ashkenazi': 'rgba(201,162,87,.85)',
    'Sephardi':  'rgba(96,165,250,.85)',
    'Yemenite':  'rgba(52,211,153,.85)',
    'Italian':   'rgba(244,114,182,.85)',
    'Karaite':   'rgba(167,139,250,.85)',
    'Romaniote': 'rgba(251,146,60,.85)',
    'Chabad':    'rgba(248,113,113,.85)',
  };

  const bookRiteCounts = new Map<string, Map<string,number>>();
  RITES_ORDER.forEach(rite => {
    const verses: string[] = parshaData[rite]?.individual_verses || [];
    verses.forEach(v => {
      const book = v.replace(/\s+\d+:\d+$/, '').trim();
      if (!bookRiteCounts.has(book)) bookRiteCounts.set(book, new Map());
      const rc = bookRiteCounts.get(book)!;
      rc.set(rite, (rc.get(rite) || 0) + 1);
    });
  });

  if (bookRiteCounts.size > 0) {
    const srcTitle = document.createElement('div');
    srcTitle.className = 'mb-freq-title';
    srcTitle.textContent = 'Book Sources';
    panel.appendChild(srcTitle);

    bookRiteCounts.forEach((riteMap, book) => {
      const row = document.createElement('div');
      row.className = 'mb-book-src-row';
      const nameEl = document.createElement('div');
      nameEl.className = 'mb-book-src-name';
      nameEl.textContent = book;
      const ritesEl = document.createElement('div');
      ritesEl.className = 'mb-book-src-rites';
      RITES_ORDER.forEach(rite => {
        const cnt = riteMap.get(rite);
        if (!cnt) return;
        const pip = document.createElement('span');
        pip.className = 'mb-rite-pip';
        pip.style.background = RITE_COLORS[rite] || 'rgba(200,200,200,.6)';
        pip.title = rite;
        pip.textContent = `${rite.slice(0,3)} ${cnt}`;
        ritesEl.appendChild(pip);
      });
      row.appendChild(nameEl);
      row.appendChild(ritesEl);
      panel.appendChild(row);
    });
  }

  // ── Shared vs. Unique ──────────────────────────────────────────────────
  const allRites = RITES_ORDER.filter(r => parshaData[r]?.individual_verses?.length);
  if (allRites.length >= 2) {
    const verseSets = new Map<string, Set<string>>();
    allRites.forEach(r => verseSets.set(r, new Set(parshaData[r].individual_verses)));

    const sharedByAll = [...verseSets.get(allRites[0])!].filter(v =>
      allRites.every(r => verseSets.get(r)!.has(v))
    );

    const uniquePerRite = new Map<string, number>();
    allRites.forEach(r => {
      const others = allRites.filter(o => o !== r);
      uniquePerRite.set(r, [...verseSets.get(r)!].filter(v =>
        others.every(o => !verseSets.get(o)!.has(v))
      ).length);
    });

    const svTitle = document.createElement('div');
    svTitle.className = 'mb-freq-title';
    svTitle.style.marginTop = '.8rem';
    svTitle.textContent = 'Shared vs. Unique';
    panel.appendChild(svTitle);

    const sharedRow = document.createElement('div');
    sharedRow.className = 'mb-shared-row';
    const sharedLbl = document.createElement('span');
    sharedLbl.className = 'mb-shared-label';
    sharedLbl.textContent = `Shared by all ${allRites.length} rites`;
    const sharedNum = document.createElement('span');
    sharedNum.className = 'mb-shared-num';
    sharedNum.textContent = String(sharedByAll.length);
    sharedRow.appendChild(sharedLbl);
    sharedRow.appendChild(sharedNum);
    panel.appendChild(sharedRow);

    allRites.forEach(rite => {
      const uCount = uniquePerRite.get(rite) || 0;
      if (!uCount) return;
      const row = document.createElement('div');
      row.className = 'mb-shared-row';
      const pip = document.createElement('span');
      pip.className = 'mb-rite-pip';
      pip.style.background = RITE_COLORS[rite] || 'rgba(200,200,200,.6)';
      pip.textContent = rite;
      const num = document.createElement('span');
      num.className = 'mb-shared-num';
      num.textContent = `${uCount} unique`;
      row.appendChild(pip);
      row.appendChild(num);
      panel.appendChild(row);
    });
  }

  return panel;
}

// ── Verse block builder ────────────────────────────────────────────────────
function buildVerseBlock(verseNode: Element, book: string, ch: number, v: number, devices: any[], englishText = '') {
  const block = document.createElement('div');
  block.className = 'verse-block';

  // Ref line
  const ref = document.createElement('div');
  ref.className = 'verse-ref';
  const sefariaBook = (SEFARIA_BOOK_MAP[book] || book).replace(/ /g,'_');
  const sefariaRef = encodeURIComponent(`${sefariaBook} ${ch}:${v}`);
  ref.innerHTML = `<a href="https://www.sefaria.org/${sefariaRef}" target="_blank" rel="noopener">${book} ${ch}:${v}</a>`;

  // Literary device badges on verse header
  if (devices.length) {
    const badgesRow = document.createElement('div');
    badgesRow.className = 'verse-device-badges';
    const seen = new Set<string>();
    devices.forEach(d => {
      const name = (d.device || '').toLowerCase();
      if (seen.has(name)) return;
      seen.add(name);
      const color = deviceColor(name);
      const badge = document.createElement('span');
      badge.className = 'vdb-badge';
      badge.style.background = color;
      badge.title = d.notes || '';
      badge.textContent = d.device || name;
      badgesRow.appendChild(badge);
    });
    ref.appendChild(badgesRow);
  }

  // Haftarah badges (Nevi'im)
  const verseKey = `${book} ${ch}:${v}`;
  const hEntries = haftarahIdx.get(verseKey) || [];
  if (hEntries.length) {
    const badgesDiv = document.createElement('div');
    badgesDiv.className = 'haftarah-badges';
    const grouped = groupBy(hEntries, e => e.parsha);
    for (const [pr, entries] of grouped) {
      const badge = document.createElement('span');
      badge.className = 'haftarah-badge';
      badge.title = entries.map(e => e.rite).join(', ');
      badge.textContent = pr;
      badgesDiv.appendChild(badge);
    }
    ref.appendChild(badgesDiv);
  }

  block.appendChild(ref);

  // Hebrew row
  const hebrewRow = document.createElement('div');
  hebrewRow.className = 'hebrew-row';

  const words = getByTag(verseNode, 'w');
  const allDeviceNames = new Set<string>();

  words.forEach(wordEl => {
    const text  = wordEl.textContent || '';
    const lemma = wordEl.getAttribute('lemma') || '';
    const morph = wordEl.getAttribute('morph') || '';
    const span  = document.createElement('span');
    span.className = 'w';
    span.textContent = text;

    // POS
    getPosClasses(morph).forEach(c => span.classList.add(c));

    // Device match
    const matchedDevices = devices.filter(d => {
      if (!d.words) return false;
      return stripMarks(text) && stripMarks(d.words).includes(stripMarks(text));
    });

    if (matchedDevices.length) {
      const primaryDevice = matchedDevices[0];
      const color = deviceColor(primaryDevice.device?.toLowerCase() || '');
      span.classList.add('has-dev');
      span.style.setProperty('--dev-color', color);
      // Semi-transparent background from the device color
      if (color.startsWith('#') && color.length === 7) {
        const r = parseInt(color.slice(1,3),16), g = parseInt(color.slice(3,5),16), b = parseInt(color.slice(5,7),16);
        span.style.setProperty('--dev-bg', `rgba(${r},${g},${b},0.18)`);
      }
      const names = matchedDevices.map(d => d.device?.toLowerCase() || '').filter(Boolean);
      span.dataset.devices = names.join(',');
      names.forEach(n => allDeviceNames.add(n));
    }

    span.addEventListener('click', (e) => {
      e.stopPropagation();
      showDetail(text, lemma, morph, matchedDevices);
    });

    hebrewRow.appendChild(span);
    hebrewRow.appendChild(document.createTextNode('​'));
  });

  block.appendChild(hebrewRow);

  // English translation
  if (englishText) {
    const engRow = document.createElement('div');
    engRow.className = 'english-row';
    engRow.textContent = englishText;
    block.appendChild(engRow);
  }

  // Footnotes for this verse's devices
  if (devices.length) {
    const fn = document.createElement('div');
    fn.className = 'verse-footnotes';
    devices.forEach(d => {
      const color = deviceColor(d.device?.toLowerCase() || '');
      const srcParts = d.sources ? d.sources.split(';').map((s: string) => s.trim()) : [];
      const urlParts = d.urls    ? d.urls.split(';').map((u: string) => u.trim())    : [];
      const srcs = srcParts.map((s: string, i: number) =>
        urlParts[i] ? `<a href="${urlParts[i]}" target="_blank" rel="noopener" style="color:var(--gold-dim)">${s}</a>` : s
      ).join(', ');
      fn.innerHTML += `<span class="fn-device" style="color:${color}">${d.device}</span>${srcs ? '(' + srcs + ')' : ''}${d.notes ? ' — ' + d.notes : ''}<br>`;
    });
    block.appendChild(fn);
  }

  return block;
}

// ── Haftarah section (Torah readings) ─────────────────────────────────────
async function buildHaftarahSection(parsha: string): Promise<HTMLElement> {
  const section = document.createElement('div');
  section.className = 'haftarah-section';

  const banner = document.createElement('div');
  banner.className = 'haftarah-banner';
  banner.textContent = `Haftarah — ${parsha}`;
  section.appendChild(banner);

  const parshaRites = haftarahData[parsha] || {};

  // Group unique reference sets across active rites
  const riteGroups = new Map<string, string[]>(); // refKey → riteList
  for (const rite of RITES) {
    const data = parshaRites[rite];
    if (!data?.references) continue;
    const key = (data.references as string[]).join('|');
    if (!riteGroups.has(key)) riteGroups.set(key, []);
    riteGroups.get(key)!.push(rite);
  }

  for (const [refKey, rites] of riteGroups) {
    const riteLabel = document.createElement('div');
    riteLabel.className = 'haftarah-rite-label';
    // Get one rite's references for display
    const sampleRite = rites[0];
    const refs = (parshaRites[sampleRite]?.references || []).join(' / ');
    const riteStr = rites.join(', ');
    riteLabel.textContent = `${riteStr}: ${refs}`;
    section.appendChild(riteLabel);

    // Render verses
    const verses: string[] = parshaRites[sampleRite]?.individual_verses || [];
    // Group by book
    const byBook = new Map<string, {ch:number,v:number}[]>();
    for (const vStr of verses) {
      const sp = vStr.lastIndexOf(' ');
      const bookRaw = vStr.slice(0, sp);
      const book = normHaftBook(bookRaw);
      const [ch, v] = vStr.slice(sp+1).split(':').map(Number);
      if (!byBook.has(book)) byBook.set(book, []);
      byBook.get(book)!.push({ch, v});
    }

    for (const [book, verseRefs] of byBook) {
      const xmlDoc = await fetchXml(book);
      if (!xmlDoc) continue;
      const bookCode = BOOK_XML[book];
      const bookDevices = await fetchDevices(book);

      for (const {ch, v} of verseRefs) {
        const chId = `${bookCode}.${ch}`;
        const chapters = getByTag(xmlDoc, 'chapter');
        const chapterNode = chapters.find(c => c.getAttribute('osisID') === chId);
        if (!chapterNode) continue;
        const verseNodes = getByTag(chapterNode, 'verse');
        const verseNode = verseNodes.find(vn => {
          const id = vn.getAttribute('osisID') || '';
          return parseInt(id.split('.')[2] || '0') === v;
        });
        if (!verseNode) continue;
        const vDevices = bookDevices.filter(d => String(d.chapter) === String(ch) && String(d.verse) === String(v));
        section.appendChild(buildVerseBlock(verseNode, book, ch, v, vDevices));
      }
    }
  }

  return section;
}

// ── Word detail panel ──────────────────────────────────────────────────────
function showDetail(text: string, lemma: string, morph: string, devices: any[]) {
  detailWord.textContent = text;

  const lemmaId = `H${lemma.replace(/\D/g, '')}`;
  const bdb = lemmaMap[lemmaId];
  const morphDesc = morphMap[morph] || '';

  let html = `
    <div class="mb-detail-row"><strong>Lemma:</strong><span>${lemma || '—'}</span></div>
    <div class="mb-detail-row"><strong>Morphology:</strong><span>${morph || '—'}</span></div>
  `;
  if (bdb?.word) {
    html += `<div class="mb-detail-row"><strong>BDB Word:</strong><span>${bdb.word}</span></div>`;
  }
  if (morphDesc) {
    html += `<div class="mb-detail-row mb-detail-def"><strong>Morphology:</strong> ${morphDesc}</div>`;
  }
  if (bdb?.definition) {
    html += `<div class="mb-detail-def"><strong>Definition:</strong> ${bdb.definition}</div>`;
  }
  if (devices.length) {
    const devHtml = devices.map(d => {
      const color = deviceColor(d.device?.toLowerCase() || '');
      return `<span style="color:${color};font-weight:600">${d.device}</span>`;
    }).join(' · ');
    html += `<div class="mb-detail-devices"><strong style="color:var(--muted)">Device:</strong> ${devHtml}</div>`;
  }

  detailBody.innerHTML = html;
  detailPanel.classList.add('open');
}

function closeDetail() {
  detailPanel.classList.remove('open');
}

document.getElementById('detailClose')!.addEventListener('click', (e) => {
  e.stopPropagation();
  closeDetail();
});

// ── Utility ────────────────────────────────────────────────────────────────
function setStatus(msg: string) { statusMsg.textContent = msg; }

function groupBy<T>(arr: T[], key: (t: T) => string): Map<string, T[]> {
  const m = new Map<string, T[]>();
  for (const item of arr) {
    const k = key(item);
    if (!m.has(k)) m.set(k, []);
    m.get(k)!.push(item);
  }
  return m;
}
