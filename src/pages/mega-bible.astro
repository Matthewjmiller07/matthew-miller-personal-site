// ── Load button ────────────────────────────────────────────────────────────
loadBtn.addEventListener('click', handleLoad);

async function handleLoad() {
  loadBtn.disabled = true;
  closeDetail();

  if (navMode === 'chapter') {
    const book = bookSel.value;
    if (chapterSel.value === 'all') {
      const maxCh = BOOK_CHAPTERS[book] || 1;
      currentParsha = '';
      await renderRange(book, 1, 1, maxCh, Infinity, '', '', true);
    } else {
      const ch = parseInt(chapterSel.value);
      const verseInputEl = document.getElementById('verseInput') as HTMLInputElement;
      const verseNum = verseInputEl.value ? parseInt(verseInputEl.value) : null;
      const sv = verseNum || 1;
      const ev = verseNum || Infinity;
      currentParsha = findParshaForChapter(book, ch);
      await renderRange(book, ch, sv, ch, ev, currentParsha);
    }
  } else if (navMode === 'parsha') {
    const parsha = parshaSel.value;
    currentParsha = parsha;
    const rangeStr = aliyaSel.value;
    const aliyaLabel = aliyaSel.options[aliyaSel.selectedIndex].text;
    const parsed = parseRange(rangeStr);
    if (!parsed) { setStatus('Invalid range'); loadBtn.disabled = false; return; }
    const { book, sc, sv, ec, ev } = parsed;
    await renderRange(book, sc, sv, ec, ev, parsha, aliyaLabel);
  } else if (navMode === 'haftarah') {
    await handleHaftarahLoad();
  } else {
    // All Devices mode
    await handleAllDevicesLoad();
  }

  loadBtn.disabled = false;
}

async function handleHaftarahLoad() {
  const parsha = haftParshasel.value;
  if (!parsha || !haftarahData) { setStatus('Haftarah data not loaded yet'); loadBtn.disabled = false; return; }

  const selectedRites = Array.from(document.querySelectorAll('#haftRiteChecks input:checked')).map(el => (el as HTMLInputElement).value);
  if (!selectedRites.length) { setStatus('Select at least one rite'); loadBtn.disabled = false; return; }

  main.innerHTML = '';
  placeholder.style.display = 'none';

  // Haftarah viz (rite comparison table + bar chart) at the top
  main.appendChild(buildHaftarahViz(parsha));

  interface VRef { book: string; ch: number; v: number; }

  function parseRiteRefs(refs: string[]): Map<string, VRef[]> {
    const byBook = new Map<string, VRef[]>();
    refs.forEach((r: string) => {
      const m = r.match(/^(.+?)\s+(\d+):(\d+)$/);
      if (!m) return;
      const book = normHaftBook(m[1]);
      const ch = parseInt(m[2]); const v = parseInt(m[3]);
      if (!byBook.has(book)) byBook.set(book, []);
      byBook.get(book)!.push({ book, ch, v });
    });
    return byBook;
  }

  // Render each selected rite as its own labeled section
  let isFirst = true;
  for (const rite of selectedRites) {
    const riteData = haftarahData[parsha]?.[rite];
    const refs: string[] = riteData?.individual_verses || [];
    if (!refs.length) continue;

    const refSummary = (riteData?.references || []).join(' / ');

    // Rite section header
    const hdr = document.createElement('div');
    hdr.className = 'rite-section-hdr';
    hdr.innerHTML = `<span>${rite}</span>${refSummary ? `<span class="rite-refs">${refSummary}</span>` : ''}`;
    main.appendChild(hdr);

    const byBook = parseRiteRefs(refs);
    for (const [book, verses] of byBook) {
      const minCh = Math.min(...verses.map(v => v.ch));
      const maxCh = Math.max(...verses.map(v => v.ch));
      const minV  = Math.min(...verses.filter(v => v.ch === minCh).map(v => v.v));
      const maxV  = Math.max(...verses.filter(v => v.ch === maxCh).map(v => v.v));
      await renderRange(book, minCh, minV, maxCh, maxV, parsha, `Haftarah — ${rite}`, false, true);
    }
    isFirst = false;
  }

  if (isFirst) { setStatus(`No haftarah for ${parsha} in selected rites`); }
  loadBtn.disabled = false;
}

