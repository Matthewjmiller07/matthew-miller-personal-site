function updateLoadBtn() {
  if (navMode === 'chapter') {
    loadBtn.disabled = !bookSel.value || !chapterSel.value;
  } else if (navMode === 'parsha') {
    loadBtn.disabled = !parshaSel.value || !aliyaSel.value;
  } else if (navMode === 'haftarah') {
    loadBtn.disabled = !haftParshasel.value;
  } else {
    loadBtn.disabled = false; // alldevices always loadable
  }
}
haftParshasel.addEventListener('change', updateLoadBtn);

