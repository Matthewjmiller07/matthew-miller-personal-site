// ── Book → Chapter cascade ─────────────────────────────────────────────────
bookSel.addEventListener('change', () => {
  const book = bookSel.value;
  chapterSel.innerHTML = '<option value="">Chapter…</option>';
  chapterSel.disabled = !book;
  if (book) {
    const allOpt = document.createElement('option');
    allOpt.value = 'all'; allOpt.textContent = 'All Chapters';
    chapterSel.appendChild(allOpt);
    const n = BOOK_CHAPTERS[book] || 0;
    for (let i = 1; i <= n; i++) {
      const o = document.createElement('option');
      o.value = String(i); o.textContent = String(i);
      chapterSel.appendChild(o);
    }
  }
  updateLoadBtn();
});

function filterBooksBySection(sect: string) {
  const prevBook = bookSel.value;
  bookSel.innerHTML = '<option value="">Select a book…</option>';
  const books = sect === 'torah'   ? TORAH_BOOKS_LIST
              : sect === 'neviim'  ? NEVIIM_BOOKS_LIST
              : sect === 'ketuvim' ? KETUVIM_BOOKS_LIST
              : Object.keys(BOOK_CHAPTERS);
  books.forEach(b => {
    const o = document.createElement('option');
    o.value = b; o.textContent = b;
    bookSel.appendChild(o);
  });
  // Restore selection if still in list
  if (books.includes(prevBook)) bookSel.value = prevBook;
  chapterSel.innerHTML = '<option value="">Chapter…</option>';
  chapterSel.disabled = true;
  updateLoadBtn();
}

