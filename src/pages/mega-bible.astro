}).catch(() => {});

async function loadAllDevices() {
  if (!SUPABASE_URL || !SUPABASE_KEY) return;
  try {
    const r = await fetch(
      `${SUPABASE_URL}/rest/v1/literary_bible?select=book,chapter,verse,device,words,notes&order=book,chapter,verse`,
      { headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${SUPABASE_KEY}` } }
    );
    if (!r.ok) return;
    allDevicesData = await r.json();
    updateDevicePills(allDevicesData);
    // Populate allDevSel with unique devices
    const devicesSeen = new Set<string>();
    allDevicesData.forEach(row => {
      const d = (row.device || '').toLowerCase();
      if (d && !devicesSeen.has(d)) {
        devicesSeen.add(d);
        const o = document.createElement('option');
        o.value = d; o.textContent = d;
        allDevSel.appendChild(o);
      }
    });
  } catch {}
}

async function loadMorphData() {
  try {
    const r = await fetch(`${DATA_PATH}Oshm.xml`);
    const txt = await r.text();
    const doc = new DOMParser().parseFromString(txt, 'application/xml');
    doc.querySelectorAll('entryFree').forEach(e => {
      const n = e.getAttribute('n');
      if (n) morphMap[n.trim()] = e.textContent?.trim() || '';
    });
  } catch {}
}

async function loadLemmaData() {
  try {
    const r = await fetch(`${DATA_PATH}HebrewStrong.xml`);
    const txt = await r.text();
    const doc = new DOMParser().parseFromString(txt, 'application/xml');
    doc.querySelectorAll('entry').forEach(e => {
      const id = e.getAttribute('id');
      if (!id) return;
      const word = e.querySelector('w')?.textContent || '';
      const def  = e.querySelector('meaning def')?.textContent || e.querySelector('meaning')?.textContent || '';
      lemmaMap[id] = { word, definition: def.trim() };
    });
  } catch {}
}

async function loadHaftarah() {
  try {
    const r = await fetch('/data/new_haftarah_with_individual_verses.json');
    haftarahData = await r.json();
    buildHaftarahIdx();
  } catch {}
}

function buildHaftarahIdx() {
  if (!haftarahData) return;
  haftarahIdx.clear();
  for (const [parsha, riteMap] of Object.entries(haftarahData as any)) {
    for (const [rite, data] of Object.entries(riteMap as any)) {
      for (const v of ((data as any).individual_verses || [])) {
        // v like "Isaiah 42:5" or "II Kings 4:1"
        const sp = (v as string).lastIndexOf(' ');
        const bookRaw = (v as string).slice(0, sp);
        const verseRef = (v as string).slice(sp + 1);
        const book = normHaftBook(bookRaw);
        const key = `${book} ${verseRef}`;
        if (!haftarahIdx.has(key)) haftarahIdx.set(key, []);
        haftarahIdx.get(key)!.push({ parsha, rite });
      }
    }
  }
}

