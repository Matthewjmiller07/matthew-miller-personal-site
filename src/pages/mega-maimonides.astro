---
import Layout from '../layouts/Layout.astro';
import toc from '../data/mega-maimonides/toc.json';
import notes from '../data/mega-maimonides/notes.json';

// The whole Mishneh Torah, browsable: 14 books, 84 sections, 1,006 chapters
// (totals from Sefaria's index, verified against its texts API). Text loads
// live from Sefaria; notes live in notes.json, pinned by section + chapter +
// halachah, and render under their halachah whenever that chapter is viewed.
---

<Layout
  title="Mega Maimonides"
  description="The whole Mishneh Torah in one reader — all fourteen books, Hebrew and English from Sefaria, with notes pinned to the halachah they explain."
>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Cormorant+SC:wght@400;500;600&family=Frank+Ruhl+Libre:wght@400;500;700&display=swap');
body:has(.mmd-page) { background:#0c0b09 !important; }
</style>

<style is:global>
.mmd-page {
  --bg:#0c0b09; --surface:#141210; --surface2:#1c1a15;
  --border:rgba(201,162,87,.15); --border-hi:rgba(201,162,87,.4);
  --text:#e8d4aa; --muted:#8a7a5a; --gold:#c9a257;
  --heb:'Frank Ruhl Libre','Noto Serif Hebrew',serif;
  --display:'Cormorant Garamond',Georgia,serif;
  --sc:'Cormorant SC',Georgia,serif;
  background:var(--bg); color:var(--text); min-height:100vh;
  padding:3rem 1rem 5rem;
}
.mmd-page .wrap { max-width:860px; margin:0 auto; }
.mmd-page .kicker { font-family:var(--sc); font-size:.72rem; letter-spacing:.34em; color:var(--gold); text-transform:uppercase; }
.mmd-page h1 { font-family:var(--display); font-weight:300; font-size:clamp(2.4rem, 6vw, 4rem); line-height:1.05; margin:.6rem 0 .5rem; }
.mmd-page h1 .he { font-family:var(--heb); color:var(--gold); font-size:.85em; }
.mmd-page .lede { font-family:var(--display); font-size:1.2rem; line-height:1.55; color:var(--muted); max-width:44rem; margin:0 0 1.4rem; }
.mmd-page .seed { border-left:3px solid var(--gold); background:rgba(201,162,87,.07); padding:.7rem .9rem; font-family:var(--display); font-size:1.02rem; line-height:1.5; color:var(--text); margin:0 0 1.6rem; }
.mmd-page .seed b { font-family:var(--sc); letter-spacing:.08em; }
.mmd-page .books { display:flex; flex-wrap:wrap; gap:.4rem; margin:0 0 1.6rem; padding:0; list-style:none; }
.mmd-page .books li { border:1px solid var(--border-hi); padding:.35rem .7rem; font-family:var(--display); font-size:.95rem; color:var(--muted); }
.mmd-page .books li .he { font-family:var(--heb); color:var(--gold); margin-left:.4rem; }
.mmd-page .books li.live { border-color:var(--gold); color:var(--text); }
.mmd-page .books li a { color:inherit; text-decoration:none; }
.mmd-page .langbar { display:flex; gap:.5rem; align-items:center; flex-wrap:wrap; margin:0 0 1.4rem; }
.mmd-page .langbar button { background:var(--surface); border:1px solid var(--border-hi); color:var(--text); padding:.4rem .9rem; cursor:pointer; font-family:var(--sc); letter-spacing:.14em; font-size:.68rem; text-transform:uppercase; }
.mmd-page .langbar button.on { background:var(--gold); color:var(--bg); border-color:var(--gold); }
.mmd-page .langbar a { color:var(--gold); font-family:var(--display); font-size:.95rem; margin-left:auto; }
.mmd-page[data-lang="he"] .en { display:none; }
.mmd-page[data-lang="en"] .he { display:none; }
.mmd-page .hal { padding:1rem .6rem 1.2rem 2.4rem; border-top:1px solid var(--border); position:relative; scroll-margin-top:5rem; }
.mmd-page .hal:target { background:rgba(201,162,87,.08); }
.mmd-page .hnum { position:absolute; left:.3rem; top:1.2rem; font-family:var(--sc); font-size:.7rem; letter-spacing:.1em; color:var(--gold); }
.mmd-page .he { font-family:var(--heb); font-size:1.45rem; line-height:1.85; direction:rtl; text-align:right; color:var(--text); }
.mmd-page .en { font-family:var(--display); font-size:1.05rem; line-height:1.55; color:var(--muted); margin-top:.4rem; }
.mmd-page .note { border:1px solid var(--border-hi); border-left:4px solid var(--gold); background:var(--surface); padding:1rem 1.2rem; margin:1rem 0 0; }
.mmd-page .note h3 { font-family:var(--sc); font-size:.72rem; letter-spacing:.22em; text-transform:uppercase; color:var(--gold); margin:0 0 .5rem; font-weight:500; }
.mmd-page .note p { font-family:var(--display); font-size:1.05rem; line-height:1.55; color:var(--text); margin:.4rem 0; }
.mmd-page .note .heq { font-family:var(--heb); font-size:1.2rem; line-height:1.8; direction:rtl; text-align:right; color:var(--gold); margin:.5rem 0; }
.mmd-page .note ul { font-family:var(--display); font-size:1.02rem; line-height:1.5; color:var(--text); margin:.4rem 0; padding-left:1.2rem; }
.mmd-page .note a { color:var(--gold); }
.mmd-page .note .src { font-size:.9rem; color:var(--muted); font-style:italic; }
.mmd-page .chapter-foot { margin-top:2rem; border-top:1px solid var(--border-hi); padding-top:1rem; font-family:var(--display); font-size:1rem; color:var(--muted); line-height:1.5; }
.mmd-page .chapter-foot a { color:var(--gold); }
/* ——— Browser controls (modelled on the Mega Talmud pickers) ——— */
.mmd-controls { display:flex; flex-wrap:wrap; gap:.7rem 1rem; align-items:flex-end; margin-bottom:.55rem; }
.mmd-controls label { font-family:var(--sc); font-size:.64rem; letter-spacing:.22em; text-transform:uppercase; color:var(--gold); display:flex; flex-direction:column; gap:.35rem; }
.mmd-controls select { font-family:var(--display); font-size:1.05rem; color:#261f14; background:#faf5ea; border:1px solid rgba(201,162,87,.5); padding:.42rem .6rem; min-width:11rem; max-width:22rem; }
.mmd-nav { display:flex; gap:.5rem; }
.mmd-nav button { font-family:var(--sc); font-size:.68rem; letter-spacing:.16em; text-transform:uppercase; color:var(--gold); background:transparent; border:1px solid var(--border-hi); padding:.5rem .9rem; cursor:pointer; }
.mmd-nav button:hover:not(:disabled) { border-color:var(--gold); color:var(--text); }
.mmd-nav button:disabled { opacity:.35; cursor:default; }
.mmd-status { font-family:var(--display); font-style:italic; font-size:1.1rem; color:var(--muted); padding:.6rem 0; margin:0; }
.mmd-status.err { color:#d98a6a; font-style:normal; }
</style>

<main class="mmd-page" data-lang="both" id="mmd">
  <div class="wrap">
    <div class="kicker">Mega · Maimonides</div>
    <h1>Mega Maimonides <span class="he">משנה תורה</span></h1>
    <p class="lede">The Mishneh Torah, chapter by chapter, in Hebrew and English — with notes pinned to the halachah they explain, the way the other Mega readers pin theirs to the verse, the mishnah, and the daf.</p>

    <p class="seed"><b>The whole Mishneh Torah, browsable.</b> All fourteen books, all {toc.totals.sections} sections, all {toc.totals.chapters} chapters — the text loads live from Sefaria, so every chapter is here, not just the seeded ones. Notes arrive chapter by chapter as the Daily Reader's Rambam Yomi track ships them; the two seeded chapters, Issurei Biah 9 and 12, carry notes already. Kedushah is marked live below because it holds the notes so far.</p>

    <ul class="books">
      {toc.books.map((b) => (
        <li class={b.slug === 'kedushah' ? 'live' : ''}>
          <a href={`?book=${b.slug}&section=${b.sections[0].slug}&chapter=1`}>{b.name}<span class="he">{b.he}</span></a>
        </li>
      ))}
    </ul>

    <div class="langbar">
      <button data-lang-btn="both" class="on">Hebrew + English</button>
      <button data-lang-btn="he">Hebrew only</button>
      <button data-lang-btn="en">English only</button>
      <a id="mmd-sefaria" href="https://www.sefaria.org/Mishneh_Torah%2C_Forbidden_Intercourse.9" target="_blank" rel="noopener">Chapter on Sefaria →</a>
    </div>

    <div class="mmd-controls">
      <label>Book
        <select id="mmd-book" aria-label="Book"></select>
      </label>
      <label>Section
        <select id="mmd-section" aria-label="Section"></select>
      </label>
      <label>Chapter
        <select id="mmd-chapter" aria-label="Chapter"></select>
      </label>
      <div class="mmd-nav">
        <button id="mmd-prev" type="button">← Prev</button>
        <button id="mmd-next" type="button">Next →</button>
      </div>
    </div>
    <p class="mmd-status" id="mmd-status">Loading…</p>

    <section id="mmd-text"></section>

    <p class="chapter-foot">Chapter text: Sefaria, loaded live. Notes arrive chapter by chapter — the two seeded chapters, Issurei Biah 9 and 12, carry notes already. The chapter JSON files under <code>src/data/mega-maimonides/</code> are kept as archives; the page no longer reads its text from them.</p>
  </div>
</main>

<script define:vars={{ TOC: toc, NOTES: notes }}>
  // Divine-name qof swap, exactly as the Mega Talmud page does it: match
  // אלהים (with optional vowel/cantillation marks between its letters) and
  // swap the ה for a ק, so the printed page reads אלקים.
  const DQ = /\u05D0[\u0591-\u05C7]*\u05DC[\u0591-\u05C7]*\u05D4[\u0591-\u05C7]*\u05D9[\u0591-\u05C7]*\u05DD/g;
  const dq = (t) => (typeof t === 'string' ? t.replace(DQ, (m) => m.replace('\u05D4', '\u05E7')) : t);

  // Clean Sefaria English the way the daily reader's sefaria_clean does:
  // drop footnote markers AND footnote bodies (which may nest other tags),
  // then take the plain text. A naive tag-strip leaves footnote text inline.
  function cleanEn(html) {
    if (!html) return '';
    const clean = String(html).replace(/<br\s*\/?>/gi, ' ');
    const doc = new DOMParser().parseFromString(`<div>${clean}</div>`, 'text/html');
    doc.querySelectorAll('[class*="footnote"]').forEach((el) => el.remove());
    let t = doc.body.textContent || '';
    t = t.replace(/&hinsp;/g, '').replace(/&nbsp;/g, ' ');
    t = t.replace(/\s+/g, ' ').trim();
    t = t.replace(/(\d)([A-Z])/g, '$1 $2');
    t = t.replace(/\s+([,.])/g, '$1');
    return t;
  }

  const $ = (id) => document.getElementById(id);
  const els = { book: $('mmd-book'), section: $('mmd-section'), chapter: $('mmd-chapter'),
                prev: $('mmd-prev'), next: $('mmd-next'), status: $('mmd-status'),
                text: $('mmd-text'), sefaria: $('mmd-sefaria'), page: $('mmd') };

  const bookOf = (slug) => TOC.books.find((b) => b.slug === slug);
  const sectionOf = (book, slug) => book.sections.find((s) => s.slug === slug);
  const firstSection = (book) => book.sections[0];

  // Flat chapter order, for prev/next across section and book boundaries.
  const FLAT = [];
  for (const b of TOC.books) for (const s of b.sections) for (let c = 1; c <= s.chapters; c++) {
    FLAT.push({ book: b.slug, section: s.slug, chapter: c });
  }
  const flatIndex = (cur) => FLAT.findIndex((f) => f.book === cur.book && f.section === cur.section && f.chapter === cur.chapter);

  // Default landing: Issurei Biah 9, as before. Old #issurei-biah-9 / #issurei-biah-12
  // anchors still land on those chapters.
  let cur = { book: 'kedushah', section: 'Mishneh_Torah,_Forbidden_Intercourse', chapter: 9 };
  const params = new URLSearchParams(location.search);
  if (params.get('book') && bookOf(params.get('book'))) {
    const b = bookOf(params.get('book'));
    cur.book = b.slug;
    if (params.get('section') && sectionOf(b, params.get('section'))) {
      cur.section = params.get('section');
      const n = parseInt(params.get('chapter'), 10);
      if (n >= 1 && n <= sectionOf(b, cur.section).chapters) cur.chapter = n;
    } else {
      cur.section = firstSection(b).slug;
      cur.chapter = 1;
    }
  } else if (location.hash === '#issurei-biah-12') {
    cur = { book: 'kedushah', section: 'Mishneh_Torah,_Forbidden_Intercourse', chapter: 12 };
  } else if (location.hash === '#issurei-biah-9') {
    cur = { book: 'kedushah', section: 'Mishneh_Torah,_Forbidden_Intercourse', chapter: 9 };
  }

  function buildBooks() {
    els.book.innerHTML = '';
    for (const b of TOC.books) {
      const o = document.createElement('option');
      o.value = b.slug;
      o.textContent = `${b.name} · ${b.he}`;
      els.book.appendChild(o);
    }
    els.book.value = cur.book;
  }

  function buildSections() {
    const b = bookOf(cur.book);
    els.section.innerHTML = '';
    for (const s of b.sections) {
      const o = document.createElement('option');
      o.value = s.slug;
      o.textContent = `${s.title} · ${s.he}`;
      els.section.appendChild(o);
    }
    els.section.value = cur.section;
  }

  function buildChapters() {
    const s = sectionOf(bookOf(cur.book), cur.section);
    els.chapter.innerHTML = '';
    for (let c = 1; c <= s.chapters; c++) {
      const o = document.createElement('option');
      o.value = c;
      o.textContent = String(c);
      els.chapter.appendChild(o);
    }
    els.chapter.value = String(cur.chapter);
    const i = flatIndex(cur);
    els.prev.disabled = i <= 0;
    els.next.disabled = i < 0 || i >= FLAT.length - 1;
  }

  function goTo(next) {
    cur = { book: next.book, section: next.section, chapter: next.chapter };
    buildBooks(); buildSections(); buildChapters();
    load();
  }

  async function load() {
    const b = bookOf(cur.book);
    const s = sectionOf(b, cur.section);
    const refEn = `Mishneh Torah, ${s.title} ${cur.chapter}`;
    els.status.className = 'mmd-status';
    els.status.textContent = `Loading ${refEn}…`;
    els.text.innerHTML = '';
    els.sefaria.href = `https://www.sefaria.org/${encodeURIComponent(s.slug)}.${cur.chapter}`;
    try {
      const res = await fetch(`https://www.sefaria.org/api/texts/${s.slug}.${cur.chapter}?lang=bi&context=0`);
      if (!res.ok) throw new Error(`Sefaria returned ${res.status}`);
      const d = await res.json();
      if (d.error) throw new Error(d.error);
      let he = d.he || [], en = d.text || [];
      if (Array.isArray(he[0])) he = he.flat();
      if (Array.isArray(en[0])) en = en.flat();
      const n = Math.min(he.length, en.length);
      if (!n) throw new Error('empty chapter');
      const head = document.createElement('div');
      head.innerHTML = `<div class="kicker"></div><h1 style="font-size:2.2rem;"></h1><p class="lede" style="font-size:1.05rem;"></p>`;
      head.querySelector('.kicker').textContent = `Sefer ${b.name} · ${s.title}`;
      const h1 = head.querySelector('h1');
      h1.appendChild(document.createTextNode(`${refEn} `));
      const heSpan = document.createElement('span');
      heSpan.className = 'he';
      heSpan.textContent = d.heRef || '';
      h1.appendChild(heSpan);
      head.querySelector('.lede').textContent = `Text: Sefaria · ${n} halachot.`;
      els.text.appendChild(head);
      const frag = document.createDocumentFragment();
      const chapterNotes = (NOTES[s.slug] && NOTES[s.slug][String(cur.chapter)]) || {};
      for (let i = 0; i < n; i++) {
        const art = document.createElement('article');
        art.className = 'hal';
        art.id = `halacha-${i + 1}`;
        art.innerHTML = `<span class="hnum">${i + 1}</span><div class="he"></div><div class="en"></div>`;
        art.querySelector('.he').innerHTML = dq(he[i]);
        art.querySelector('.en').textContent = cleanEn(en[i]);
        const note = chapterNotes[String(i + 1)];
        if (note && note.html) {
          const tmp = document.createElement('div');
          tmp.innerHTML = note.html;
          if (tmp.firstElementChild) art.appendChild(tmp.firstElementChild);
        }
        frag.appendChild(art);
      }
      els.text.appendChild(frag);
      els.status.textContent = '';
    } catch (e) {
      els.status.className = 'mmd-status err';
      els.status.textContent = `Could not load ${refEn} from Sefaria — check your connection and try another chapter.`;
    }
    const p = new URLSearchParams(location.search);
    p.set('book', cur.book); p.set('section', cur.section); p.set('chapter', String(cur.chapter));
    history.replaceState(null, '', `${location.pathname}?${p.toString()}`);
  }

  els.book.addEventListener('change', () => {
    const b = bookOf(els.book.value);
    cur = { book: b.slug, section: firstSection(b).slug, chapter: 1 };
    buildSections(); buildChapters(); load();
  });
  els.section.addEventListener('change', () => {
    cur = { book: cur.book, section: els.section.value, chapter: 1 };
    buildChapters(); load();
  });
  els.chapter.addEventListener('change', () => {
    cur.chapter = parseInt(els.chapter.value, 10);
    buildChapters(); load();
  });
  els.prev.addEventListener('click', () => {
    const i = flatIndex(cur);
    if (i > 0) goTo(FLAT[i - 1]);
  });
  els.next.addEventListener('click', () => {
    const i = flatIndex(cur);
    if (i >= 0 && i < FLAT.length - 1) goTo(FLAT[i + 1]);
  });

  // Language toggle, as before.
  document.querySelectorAll('[data-lang-btn]').forEach((btn) => {
    btn.addEventListener('click', () => {
      els.page.dataset.lang = btn.dataset.langBtn;
      document.querySelectorAll('[data-lang-btn]').forEach((x) => x.classList.toggle('on', x === btn));
    });
  });

  buildBooks(); buildSections(); buildChapters();
  load();
</script>
</Layout>
