function neighbours() {
  const t: Tractate = state.tr;
  const prev = state.ch > 1 ? { t, ch: state.ch - 1 } : t.idx > 0 ? { t: TRACTATES[t.idx - 1], ch: TRACTATES[t.idx - 1].chapters.length } : null;
  const next = state.ch < t.chapters.length ? { t, ch: state.ch + 1 } : t.idx < TRACTATES.length - 1 ? { t: TRACTATES[t.idx + 1], ch: 1 } : null;
  return { prev, next };
}

function renderChapter() {
  const t: Tractate = state.tr;
  const found = new Map<string, number>();
  const td = state.today;
  const blocks = state.paras.map((p: { he: string; en: string }, i: number) => {
    const m = i + 1;
    const he = markSages(sanitize(p.he), found);
    const isToday = td && td.tr === t && td.ch === state.ch && m >= td.from && m <= td.to;
    const cls = ['mm-para', isLearned(t, state.ch, m) ? 'learned' : '', state.selected === m ? 'selected' : '', isToday ? 'today' : ''].join(' ');
    return `<div class="${cls}" data-p="${m}" id="m${m}">
      <div class="mm-num"><span class="he">${gem(m, false)}</span><span class="ar">${m}</span><button class="mm-check" data-check="${m}" title="Mark learned (x)" aria-label="Mark mishnah ${m} learned">✓</button></div>
      ${isToday ? '<div class="mm-today-tag">Today’s Mishnah Yomit</div>' : ''}
      <div class="mm-he" lang="he" dir="rtl">${he}</div>
      ${p.en ? `<div class="mm-en">${sanitize(p.en)}</div>` : ''}
      <div class="mm-badges" data-badges="${m}"></div>
    </div>`;
  }).join('');
  const voices = [...found.entries()].sort((a, b) => b[1] - a[1]);
  const { prev, next } = neighbours();
  const all = state.paras.length;
  const doneHere = learnedIn(t, state.ch).length;
  const inner = $('mm-content');
  inner.removeAttribute('data-solo');
  state.solo = '';
  inner.innerHTML = `
    <div class="mm-crumbs"><span>Seder ${esc(t.seder)}</span><span>${esc(t.name)}</span><span>Perek ${state.ch} of ${t.chapters.length}</span></div>
    <div class="mm-title"><h1>${esc(t.name)} ${state.ch}</h1><span class="he">${esc(t.he)} פרק ${gem(state.ch)}</span></div>
    ${voices.length ? `<div class="mm-voices"><span class="mm-voices-label">Voices</span>${voices.map(([k, n]) =>
      `<button class="mm-voice" data-voice="${esc(k)}" style="--c:${sageColor(k)}"><span class="sw"></span>${esc(sageLabel(k))}<span class="n">${n}</span></button>`).join('')}</div>` : ''}
    ${blocks}
    <div class="mm-perek-actions">
      <button class="mm-btn" id="mm-mark-perek">${doneHere === all ? 'Unmark this perek' : 'Mark whole perek learned'}</button>
      <a class="mm-btn" href="${SEFARIA}/${encodeRef(`${t.book} ${state.ch}`)}" target="_blank" rel="noopener">Open on Sefaria ↗</a>
    </div>
    <div class="mm-hint" style="margin-top:.8rem">${esc(state.heVersion)}${state.enVersion ? ` · ${esc(state.enVersion)}` : ''} — via Sefaria</div>
    <div class="mm-pager">
      <button class="prev" data-t="${prev ? prev.t.idx : ''}" data-ch="${prev ? prev.ch : ''}" ${prev ? '' : 'disabled'}><small>Previous</small>${prev ? `${esc(prev.t.name)} ${prev.ch}` : '—'}</button>
      <button class="next" data-t="${next ? next.t.idx : ''}" data-ch="${next ? next.ch : ''}" ${next ? '' : 'disabled'}><small>Next</small>${next ? `${esc(next.t.name)} ${next.ch}` : '—'}</button>
    </div>`;
  renderBadges();
}

function renderBadges() {
  document.querySelectorAll<HTMLElement>('[data-badges]').forEach((el) => {
    const s = state.linkSummary.get(Number(el.dataset.badges));
    if (!s) { el.innerHTML = ''; return; }
    const out: string[] = [];
    // This tractate's own dapim first (bare "9a"), then other tractates' ("Shabbat 25b").
    const daf = (x: string) => /^\d/.test(x) ? parseInt(x) * 2 + (x.endsWith('b') ? 1 : 0) : 1e6;
    const bavli = ([...s.bavli] as string[]).sort((a, b) => daf(a) - daf(b) || a.localeCompare(b));
    if (bavli.length) out.push(`<span class="mm-badge bavli" data-open-tab="Talmud" title="Bavli">Bavli ${esc(bavli.slice(0, 3).join(', '))}${bavli.length > 3 ? ` +${bavli.length - 3}` : ''}</span>`);
    if (s.yer) out.push(`<span class="mm-badge" data-open-tab="Talmud">Yerushalmi ${s.yer}</span>`);
    if (s.tosefta) out.push(`<span class="mm-badge" data-open-tab="Tosefta">Tosefta ${s.tosefta}</span>`);
    if (s.tanakh) out.push(`<span class="mm-badge" data-open-tab="Tanakh">Tanakh ${s.tanakh}</span>`);
    if (s.comm.size) out.push(`<span class="mm-badge comm" data-open-tab="Commentary"><b>${s.comm.size}</b> commentaries</span>`);
    el.innerHTML = out.join('');
  });
}

function panelGroupsHtml(links: any[]) {
  const inTab = links.filter((l) => tabOf(l) === state.panelTab);
  if (!inTab.length) return '<div class="mm-empty">Nothing in this category for this mishnah.</div>';
  const groups = new Map<string, any[]>();
  for (const l of inTab) {
    const name = linkGroup(l).replace(/ on Mishnah .*$| on Pirkei Avot$/, '');
    if (!groups.has(name)) groups.set(name, []);
    groups.get(name)!.push(l);
  }
  const rank = (name: string) => { const i = COMM_ORDER.findIndex((c) => name.startsWith(c)); return i < 0 ? 99 : i; };
  const sorted = [...groups.entries()].sort((a, b) => rank(a[0]) - rank(b[0]) || a[0].localeCompare(b[0]));
  return `<div class="mm-lib">${sorted.map(([name, items], gi) => `
    <details${gi < 2 ? ' open' : ''}><summary>${esc(name)} <span class="n">${items.length}</span><span class="cat">${esc(items[0].collectiveTitle?.he || '')}</span></summary>
      ${items.slice(0, 20).map((l) => {
        const he = flat(l.he).join(' ');
        const en = flat(l.text).join(' ');
        return `<div class="mm-lib-item">
          <a class="mm-lib-ref" href="${SEFARIA}/${encodeRef(l.ref)}" target="_blank" rel="noopener">${esc(l.ref)}</a>
          ${he ? `<div class="mm-lib-he" lang="he" dir="rtl">${sanitize(he.length > 1400 ? he.slice(0, 1400) + '…' : he)}</div>` : ''}
          ${en ? `<div class="mm-lib-en">${sanitize(en.length > 1000 ? en.slice(0, 1000) + '…' : en)}</div>` : ''}
        </div>`;
      }).join('')}
      ${items.length > 20 ? `<div class="mm-hint">+${items.length - 20} more on Sefaria</div>` : ''}
    </details>`).join('')}</div>`;
}

function renderPanel() {
  const t: Tractate = state.tr;
  const body = $('mm-panel-body');
  if (!t) return;
  if (!state.selected) {
    $('mm-panel-title').textContent = 'Commentary';
    const s = [...state.linkSummary.values()];
    body.innerHTML = `<div class="mm-scope"><b>${esc(t.name)} ${state.ch}</b> · ${state.paras.length} mishnayot</div>
      <div class="mm-intro"><p>Tap any mishnah to open its commentaries, Talmud, Tosefta and verses here.</p>
      ${s.length ? `<p>In this perek: <b>${new Set(s.flatMap((x) => [...x.bavli])).size}</b> Bavli dapim, <b>${s.reduce((a, x) => a + x.yer, 0)}</b> Yerushalmi links, <b>${s.reduce((a, x) => a + x.tosefta, 0)}</b> Tosefta parallels.</p>` : ''}</div>`;
    return;
  }
  const ref = `${t.book} ${state.ch}:${state.selected}`;
  $('mm-panel-title').textContent = `${t.name} ${state.ch}:${state.selected}`;
  if (!state.panelLinks) { body.innerHTML = '<div class="mm-loading">Loading sources…</div>'; return; }
  const links = state.panelLinks as any[];
  const counts = new Map<string, number>();
  links.forEach((l) => counts.set(tabOf(l), (counts.get(tabOf(l)) || 0) + 1));
  if (!counts.get(state.panelTab)) state.panelTab = TAB_ORDER.find((x) => counts.get(x)) || 'Commentary';
  body.innerHTML = `
    <div class="mm-scope"><b>${esc(t.he)} ${gem(state.ch)}:${gem(state.selected)}</b> · <a href="${SEFARIA}/${encodeRef(ref)}?with=all" target="_blank" rel="noopener" style="color:var(--gold)">Sefaria ↗</a></div>
    <div class="mm-tabs">${TAB_ORDER.filter((x) => counts.get(x)).map((x) =>
      `<button class="mm-tab${x === state.panelTab ? ' on' : ''}" data-tab="${x}">${x}<span class="n">${counts.get(x)}</span></button>`).join('')}</div>
    ${links.length ? panelGroupsHtml(links) : '<div class="mm-empty">No linked sources on Sefaria for this mishnah.</div>'}`;
}

async function selectMishnah(m: number | null, scroll = false) {
  state.selected = m;
  document.querySelectorAll('.mm-para').forEach((el) => el.classList.toggle('selected', Number((el as HTMLElement).dataset.p) === m));
  syncUrl();
  if (m && scroll) document.getElementById('m' + m)?.scrollIntoView({ block: 'center', behavior: 'smooth' });
  if (!m) { state.panelLinks = null; renderPanel(); return; }
  const t: Tractate = state.tr;
  const ch = state.ch;
  state.panelLinks = null;
  renderPanel();
  const links = await fetchLinks(`${t.book} ${ch}:${m}`, true);
  if (state.tr !== t || state.ch !== ch || state.selected !== m) return;
  state.panelLinks = links;
  renderPanel();
}

async function openChapter(t: Tractate, ch: number, m: number | null = null) {
  state.tr = t; state.ch = ch; state.selected = m; state.panelLinks = null; state.linkSummary = new Map();
  store.set('last', { t: t.name, ch });
  fillSelects();
  renderToc(($('mm-search') as HTMLInputElement).value);
  $('mm-content').innerHTML = `<div class="mm-loading">Loading ${esc(t.name)} ${ch}…</div>`;
  $('mm-main').scrollTop = 0;
  page.dataset.sidebar = '0';
  syncUrl();
  try {
    const data = await fetchChapter(t, ch);
    if (state.tr !== t || state.ch !== ch) return;
    state.paras = data.paras; state.enVersion = data.enVersion; state.heVersion = data.heVersion;
    renderChapter();
    renderPanel();
    loadLinkSummary(t, ch);
    if (m) selectMishnah(m, true);
  } catch (err: any) {
    $('mm-content').innerHTML = `<div class="mm-error">Couldn't load ${esc(t.name)} ${ch} from Sefaria (${esc(err.message || err)}). Check your connection and try again.</div>`;
  }
}

function syncUrl() {
  const u = new URL(location.href);
  if (state.tr) { u.searchParams.set('t', slug(state.tr.name)); u.searchParams.set('p', String(state.ch)); } else { u.searchParams.delete('t'); u.searchParams.delete('p'); }
  if (state.selected) u.searchParams.set('m', String(state.selected)); else u.searchParams.delete('m');
  history.replaceState(null, '', u);
}

function toggleLearned(m: number) {
  const t: Tractate = state.tr;
  const on = !isLearned(t, state.ch, m);
  setLearned(t, state.ch, [m], on);
  if (on) store.set('lastLearned', { t: t.name, ch: state.ch, m });
  document.getElementById('m' + m)?.classList.toggle('learned', on);
  afterProgress();
}
function afterProgress() {
  const t: Tractate = state.tr;
  const btn = document.getElementById('mm-mark-perek');
  if (btn) btn.textContent = learnedIn(t, state.ch).length === state.paras.length ? 'Unmark this perek' : 'Mark whole perek learned';
  renderToday();
  renderToc(($('mm-search') as HTMLInputElement).value);
}

/* ───────────────────────── preferences & controls ───────────────────────── */
function applyPrefs() {
  const prefs = store.get('prefs', {});
  page.dataset.theme = prefs.theme || 'night';
  page.dataset.lang = prefs.lang || 'both';
  page.dataset.layout = prefs.layout || 'stack';
  page.dataset.focus = prefs.focus ? '1' : '0';
  page.dataset.sages = prefs.sages === false ? '0' : '1';
  page.style.setProperty('--heb-size', `${prefs.heb || 1.5}rem`);
  page.style.setProperty('--en-size', `${(prefs.heb || 1.5) * 0.7}rem`);
  document.querySelectorAll('.mm-bar [data-lang]').forEach((b) => b.classList.toggle('on', (b as HTMLElement).dataset.lang === page.dataset.lang));
  $('mm-layout').textContent = page.dataset.layout === 'side' ? 'Side by side' : 'Stacked';
  $('mm-focus').classList.toggle('on', !!prefs.focus);
  $('mm-sages').classList.toggle('on', page.dataset.sages === '1');
}
function setPref(k: string, val: any) { const p = store.get('prefs', {}); p[k] = val; store.set('prefs', p); applyPrefs(); }

document.querySelectorAll('.mm-bar [data-lang]').forEach((b) => b.addEventListener('click', () => setPref('lang', (b as HTMLElement).dataset.lang)));
$('mm-layout').addEventListener('click', () => setPref('layout', page.dataset.layout === 'side' ? 'stack' : 'side'));
$('mm-theme').addEventListener('click', () => setPref('theme', page.dataset.theme === 'night' ? 'parchment' : 'night'));
$('mm-focus').addEventListener('click', () => setPref('focus', page.dataset.focus !== '1'));
$('mm-sages').addEventListener('click', () => setPref('sages', page.dataset.sages !== '1'));
$('mm-smaller').addEventListener('click', () => setPref('heb', Math.max(1.05, +(store.get('prefs', {}).heb || 1.5) - 0.15)));
$('mm-bigger').addEventListener('click', () => setPref('heb', Math.min(3.2, +(store.get('prefs', {}).heb || 1.5) + 0.15)));
$('mm-today-btn').addEventListener('click', goToday);
$('mm-toc-toggle').addEventListener('click', () => { page.dataset.sidebar = page.dataset.sidebar === '1' ? '0' : '1'; page.dataset.panel = '0'; });
$('mm-panel-toggle').addEventListener('click', () => { page.dataset.panel = page.dataset.panel === '1' ? '0' : '1'; page.dataset.sidebar = '0'; });
$('mm-panel-close').addEventListener('click', () => { page.dataset.panel = '0'; });
$('mm-scrim').addEventListener('click', () => { page.dataset.panel = '0'; page.dataset.sidebar = '0'; });
$('mm-search').addEventListener('input', (e) => renderToc((e.target as HTMLInputElement).value));
$('mm-tractate').addEventListener('change', (e) => { const v = (e.target as HTMLSelectElement).value; if (v) openChapter(TRACTATES[Number(v)], 1); });
$('mm-chapter').addEventListener('change', (e) => { if (state.tr) openChapter(state.tr, Number((e.target as HTMLSelectElement).value)); });

function goToday() {
  const td = state.today;
  if (td) openChapter(td.tr, td.ch, td.from);
}

// Any [data-t][data-ch] button (contents grid, welcome lists, pager) opens that perek.
document.addEventListener('click', (e) => {
  const el = (e.target as HTMLElement).closest('[data-t][data-ch]') as HTMLElement | null;
  if (el && el.dataset.t !== '' && !(el as HTMLButtonElement).disabled) { openChapter(TRACTATES[Number(el.dataset.t)], Number(el.dataset.ch)); return; }
  const go = (e.target as HTMLElement).closest('[data-go]') as HTMLElement | null;
  if (go?.dataset.go === 'today') goToday();
  if (go?.dataset.go === 'next') { const n = nextUnlearned(); if (n) openChapter(n.t, n.ch, n.m); }
});

$('mm-panel-body').addEventListener('click', (e) => {
  const tab = (e.target as HTMLElement).closest('[data-tab]') as HTMLElement | null;
  if (tab) { state.panelTab = tab.dataset.tab; renderPanel(); }
});

$('mm-content').addEventListener('click', (e) => {
  const t = e.target as HTMLElement;
  if (t.classList.contains('footnote-marker')) {
    t.nextElementSibling?.classList.toggle('open');
    e.stopPropagation();
    return;
  }
  const check = t.closest('[data-check]') as HTMLElement | null;
  if (check) { toggleLearned(Number(check.dataset.check)); return; }
  if (t.id === 'mm-mark-perek') {
    const all = state.paras.map((_p: any, i: number) => i + 1);
    const on = learnedIn(state.tr, state.ch).length !== all.length;
    setLearned(state.tr, state.ch, all, on);
    if (on) store.set('lastLearned', { t: state.tr.name, ch: state.ch, m: all.length });
    document.querySelectorAll('.mm-para').forEach((el) => el.classList.toggle('learned', on));
    afterProgress();
    return;
  }
  const voice = (t.closest('[data-voice]') || (page.dataset.sages === '1' ? t.closest('[data-sage]') : null)) as HTMLElement | null;
  if (voice) {
    const key = voice.dataset.voice || voice.dataset.sage || '';
    soloVoice(state.solo === key ? '' : key);
    if (voice.dataset.voice) return;
  }
  const para = t.closest('.mm-para') as HTMLElement | null;
  if (!para || window.getSelection()?.toString().trim()) return;
  const m = Number(para.dataset.p);
  const badge = t.closest('[data-open-tab]') as HTMLElement | null;
  if (badge) { state.panelTab = badge.dataset.openTab; selectMishnah(m); }
  else selectMishnah(state.selected === m ? null : m);
  if (state.selected && window.matchMedia('(max-width: 900px)').matches) page.dataset.panel = '1';
});

function soloVoice(key: string) {
  state.solo = key;
  const inner = $('mm-content');
  if (key) inner.setAttribute('data-solo', key); else inner.removeAttribute('data-solo');
  inner.querySelectorAll<HTMLElement>('.mm-sage').forEach((s) => s.classList.toggle('solo', s.dataset.sage === key));
  inner.querySelectorAll<HTMLElement>('.mm-voice').forEach((b) => b.classList.toggle('on', b.dataset.voice === key));
  inner.querySelectorAll<HTMLElement>('.mm-para').forEach((p) => p.classList.toggle('has-solo', !!key && !!p.querySelector(`.mm-sage.solo`)));
}

document.addEventListener('keydown', (e) => {
  const tag = (e.target as HTMLElement).tagName;
  if (/INPUT|TEXTAREA|SELECT/.test(tag) || e.metaKey || e.ctrlKey || e.altKey || !state.tr) return;
  const n = state.paras.length;
  if (e.key === 'j') selectMishnah(Math.min(n, (state.selected || 0) + 1), true);
  else if (e.key === 'k') selectMishnah(Math.max(1, (state.selected || 2) - 1), true);
  else if (e.key === 'x' && state.selected) toggleLearned(state.selected);
  else if (e.key === ']' || e.key === '[') {
    const { prev, next } = neighbours();
    const go = e.key === ']' ? next : prev;
    if (go) openChapter(go.t, go.ch);
  } else if (e.key === 'Escape') { selectMishnah(null); soloVoice(''); }
});

/* ───────────────────────── boot ───────────────────────── */
(function boot() {
  applyPrefs();
  fillSelects();
  renderToc();
  renderToday();
  const u = new URL(location.href);
  const t = bySlug(u.searchParams.get('t') || '');
  if (t) {
    const ch = Math.min(Math.max(1, Number(u.searchParams.get('p')) || 1), t.chapters.length);
    openChapter(t, ch, Number(u.searchParams.get('m')) || null);
  } else {
    renderWelcome();
  }
  loadToday();
})();
</script>
</Layout>
