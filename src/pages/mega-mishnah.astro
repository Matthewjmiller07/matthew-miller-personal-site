/* Welcome */
.mm-sedarim { display:grid; grid-template-columns:repeat(auto-fill,minmax(230px,1fr)); gap:.7rem; margin-top:1.4rem; }
.mm-sedarim > div { background:var(--surface); border:1px solid var(--border-hi); padding:.8rem .9rem; }
