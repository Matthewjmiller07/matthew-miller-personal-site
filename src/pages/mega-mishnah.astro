.mm-perek-actions { display:flex; gap:.5rem; flex-wrap:wrap; margin:1.6rem 0 0; }

/* Panel */
.mm-tabs { display:flex; flex-wrap:wrap; gap:.25rem; margin:.2rem 0 .7rem; }
