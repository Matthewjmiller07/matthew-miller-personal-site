<script>
import tocData from '../data/mega-mishnah/toc.json';

const SEFARIA = 'https://www.sefaria.org';

type Tractate = { name: string; he: string; book: string; chapters: number[]; seder: string; sederHe: string; idx: number };
const SEDARIM = tocData.sedarim;
const TRACTATES: Tractate[] = SEDARIM.flatMap((s) => s.tractates.map((t) => ({ ...t, seder: s.name, sederHe: s.he, idx: 0 })));
TRACTATES.forEach((t, i) => { t.idx = i; });
const TOTAL_MISHNAYOT = TRACTATES.reduce((a, t) => a + t.chapters.reduce((x, y) => x + y, 0), 0);
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const bySlug = (s: string) => TRACTATES.find((t) => slug(t.name) === slug(s) || slug(t.book) === slug(s));

// Commentaries shown first, in this order; anything else Sefaria links follows alphabetically.
const COMM_ORDER = [
  'Bartenura', 'Rambam', 'English Explanation of Mishnah', 'Tosafot Yom Tov', 'Ikar Tosafot Yom Tov',
  'Yachin', 'Boaz', 'Melekhet Shelomoh', 'Tosafot Rabbi Akiva Eiger', 'Mishnat Eretz Yisrael', 'Lechem Shamayim',
];
const TAB_ORDER = ['Commentary', 'Talmud', 'Tosefta', 'Tanakh', 'Halakhah', 'Midrash', 'Other'];

/* ───────────────────────── storage ───────────────────────── */
const store = {
  get(k: string, d: any = null) { try { const v = localStorage.getItem('mm:' + k); return v === null ? d : JSON.parse(v); } catch { return d; } },
  set(k: string, v: any) { try { localStorage.setItem('mm:' + k, JSON.stringify(v)); } catch {} },
};

/* ───────────────────────── state ───────────────────────── */
const state: any = {
  tr: null as Tractate | null,
  ch: 0,
  paras: [] as { he: string; en: string }[],
  enVersion: '',
  heVersion: '',
  linkSummary: new Map<number, any>(),
  selected: null as number | null,
  panelLinks: null as any[] | null,
  panelTab: 'Commentary',
  solo: '',
  today: null as null | { tr: Tractate; ch: number; from: number; to: number; ref: string },
  // learned: { "Berakhot.1": [1,2,3] }
  learned: store.get('learned', {}) as Record<string, number[]>,
};

const $ = (id: string) => document.getElementById(id)!;
const page = $('mm-page');
const esc = (s: any) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
const encodeRef = (ref: string) => encodeURIComponent(ref.replace(/ /g, '_')).replace(/%3A/gi, '.').replace(/%2C/gi, ',');

/* ───────────────────────── gematria ───────────────────────── */
function gem(n: number, marks = true) {
  const ones = ['', 'א', 'ב', 'ג', 'ד', 'ה', 'ו', 'ז', 'ח', 'ט'];
  const tens = ['', 'י', 'כ', 'ל', 'מ', 'נ', 'ס', 'ע', 'פ', 'צ'];
  const hundreds = ['', 'ק', 'ר', 'ש'];
  let s = '';
  n %= 1000;
  while (n >= 400) { s += 'ת'; n -= 400; }
  if (n >= 100) { s += hundreds[Math.floor(n / 100)]; n %= 100; }
  if (n === 15) s += 'טו'; else if (n === 16) s += 'טז'; else s += tens[Math.floor(n / 10)] + ones[n % 10];
  if (!marks) return s;
  return s.length > 1 ? `${s.slice(0, -1)}״${s.slice(-1)}` : `${s}׳`;
}

/* ───────────────────────── learned progress ───────────────────────── */
const lkey = (t: Tractate, ch: number) => `${t.name}.${ch}`;
const learnedIn = (t: Tractate, ch: number) => state.learned[lkey(t, ch)] || [];
const isLearned = (t: Tractate, ch: number, m: number) => learnedIn(t, ch).includes(m);
function setLearned(t: Tractate, ch: number, ms: number[], on: boolean) {
  const cur = new Set(learnedIn(t, ch));
  ms.forEach((m) => (on ? cur.add(m) : cur.delete(m)));
  if (cur.size) state.learned[lkey(t, ch)] = [...cur].sort((a, b) => a - b);
  else delete state.learned[lkey(t, ch)];
  store.set('learned', state.learned);
}
const tractateLearned = (t: Tractate) => t.chapters.reduce((a, _n, i) => a + learnedIn(t, i + 1).length, 0);
const tractateSize = (t: Tractate) => t.chapters.reduce((a, b) => a + b, 0);
const totalLearned = () => TRACTATES.reduce((a, t) => a + tractateLearned(t), 0);

/* ───────────────────────── sages (the "Voices" layer) ───────────────────────── */
// Mishnah text is fully vocalised, so every pattern allows nikkud/te'amim after each letter.
const NIK = '[\\u0591-\\u05C7]*';
const LET = '[\\u05D0-\\u05EA]';
const WORD = `(?:${LET}${NIK})+`;
const v = (s: string) => [...s].map((c) => (c === ' ' ? '\\s+' : c + NIK)).join('');
const strip = (s: string) => s.replace(/[֑-ׇ]/g, '');
const NOT_HEB_BEFORE = '(?<![\\u05D0-\\u05EA\\u0591-\\u05C7])';
const NOT_HEB_AFTER = '(?![\\u05D0-\\u05EA\\u0591-\\u05C7])';
const PFX = `(?:[ושהלכדמ]${NIK}){0,2}`;
const SAGE_RE = new RegExp(
  `${NOT_HEB_BEFORE}(${PFX})(?:(${v('רבי')}|${v('רבן')})${NOT_HEB_AFTER}((?:\\s+${WORD}){0,3})|(${v('בית שמאי')}|${v('בית הלל')}|${v('חכמים')})${NOT_HEB_AFTER})`,
  'g',
);
const NOT_NAMES = new Set(['אומר', 'אומרים', 'אמר', 'אמרו', 'מתיר', 'אוסר', 'מטמא', 'מטהר', 'פוטר', 'מחייב', 'מכשיר', 'פוסל', 'מודה', 'שואל', 'היה', 'הוא', 'עד', 'אף', 'אלא', 'את', 'על']);
const SUFFIXES = new Set(['הגלילי', 'הכהן', 'הסנדלר', 'הסגן', 'הבבלי', 'הקטן', 'הזקן', 'הנשיא', 'איש', 'הלוי']);
const SAGE_EN: Record<string, string> = {
  'רבי': 'Rebbe', 'חכמים': 'Chakhamim', 'בית שמאי': 'Beit Shammai', 'בית הלל': 'Beit Hillel',
  'מאיר': 'R. Meir', 'יהודה': 'R. Yehudah', 'יוסי': 'R. Yose', 'שמעון': 'R. Shimon', 'אליעזר': 'R. Eliezer',
  'יהושע': 'R. Yehoshua', 'עקיבא': 'R. Akiva', 'טרפון': 'R. Tarfon', 'ישמעאל': 'R. Yishmael', 'אלעזר': 'R. Elazar',
  'נחמיה': 'R. Nechemiah', 'יעקב': 'R. Yaakov', 'נתן': 'R. Natan', 'חנינא': 'R. Chanina', 'דוסא': 'R. Dosa',
  'צדוק': 'R. Tzadok', 'יונתן': 'R. Yonatan', 'חלפתא': 'R. Chalafta', 'ישבב': 'R. Yeshevav', 'אלעאי': 'R. Ilai',
  'אלעזר בן עזריה': 'R. Elazar b. Azariah', 'יוחנן בן נורי': 'R. Yochanan b. Nuri', 'יהודה בן בתירא': 'R. Yehudah b. Beteira',
  'אלעזר בר צדוק': 'R. Elazar b. Tzadok', 'יוסי בן יהודה': 'R. Yose b. Yehudah', 'שמעון בן אלעזר': 'R. Shimon b. Elazar',
  'חנינא בן דוסא': 'R. Chanina b. Dosa', 'יוסי הגלילי': 'R. Yose HaGelili', 'חנינא סגן הכהנים': 'R. Chanina Segan HaKohanim',
  'רבן גמליאל': 'Rabban Gamliel', 'רבן שמעון בן גמליאל': 'Rabban Shimon b. Gamliel', 'רבן יוחנן בן זכאי': 'Rabban Yochanan b. Zakkai',
  'שמעון בן ננס': 'R. Shimon b. Nanas', 'ישמעאל בנו של רבי יוחנן בן ברוקה': 'R. Yishmael b. R. Yochanan b. Beroka', 'יוחנן בן ברוקה': 'R. Yochanan b. Beroka',
};
const SAGE_COLOR: Record<string, string> = {
  'חכמים': '#a39a86', 'בית שמאי': '#d98c4a', 'בית הלל': '#6fa8dc', 'מאיר': '#e07a5f', 'יהודה': '#9fc56b',
  'יוסי': '#c38fd8', 'שמעון': '#5fc4c4', 'אליעזר': '#e6b450', 'יהושע': '#8f9ee8', 'עקיבא': '#e88fb0', 'רבי': '#c9b37a',
  'רבן גמליאל': '#7fc98f', 'ישמעאל': '#c9776e', 'טרפון': '#b98fe0',
};
const PALETTE = ['#e07a5f', '#6fa8dc', '#9fc56b', '#c38fd8', '#e6b450', '#5fc4c4', '#e88fb0', '#8f9ee8', '#d98c4a', '#7fc98f', '#c9776e', '#b98fe0'];
function sageColor(key: string) {
  if (SAGE_COLOR[key]) return SAGE_COLOR[key];
  let h = 0;
  for (const c of key) h = (h * 31 + c.charCodeAt(0)) >>> 0;
  return PALETTE[h % PALETTE.length];
}
const sageLabel = (key: string) => SAGE_EN[key] || (key.startsWith('רבן ') ? key : `ר׳ ${key}`);

/** Decide which of the (up to three) words after רבי/רבן belong to the name. */
function parseName(title: string, rest: string): { key: string; used: string } {
  const parts = rest.match(/\s+\S+/g) || [];
  const words = parts.map((p) => strip(p.trim()).replace(/[^א-ת]/g, ''));
  const isRabban = strip(title) === 'רבן';
  if (!words.length || NOT_NAMES.has(words[0])) return { key: isRabban ? 'רבן' : 'רבי', used: '' };
  let n = 1;
  let name = words[0];
  if ((words[1] === 'בן' || words[1] === 'בר') && words[2]) { name += ` ${words[1]} ${words[2]}`; n = 3; }
  else if (words[1] && SUFFIXES.has(words[1])) { name += ` ${words[1]}`; n = 2; }
  return { key: isRabban ? `רבן ${name}` : name, used: parts.slice(0, n).join('') };
}

/** Wrap each sage's name in a coloured span; returns the html and the keys found. */
function markSages(html: string, found: Map<string, number>) {
  return html.split(/(<[^>]+>)/).map((chunk) => {
    if (chunk.startsWith('<')) return chunk;
    const marked = chunk.replace(SAGE_RE, (all, pfx, title, rest, group) => {
      if (group) {
        const key = strip(group).replace(/\s+/g, ' ');
        found.set(key, (found.get(key) || 0) + 1);
        return `${pfx}<span class="mm-sage" data-sage="${esc(key)}" style="--c:${sageColor(key)}">${group}</span>`;
      }
      const { key, used } = parseName(title, rest || '');
      found.set(key, (found.get(key) || 0) + 1);
      const after = (rest || '').slice(used.length);
      return `${pfx}<span class="mm-sage" data-sage="${esc(key)}" style="--c:${sageColor(key)}">${title}${used}</span>${after}`;
    });
    // Scripture citations the printers added in parentheses, e.g. (דברים ו).
    return marked.replace(/\(([א-ת\s'"״׳]{2,24})\)/g, '<span class="mm-cite">($1)</span>');
  }).join('');
}

/* ───────────────────────── Sefaria ───────────────────────── */
const ALLOWED = new Set(['B', 'STRONG', 'I', 'EM', 'SMALL', 'BIG', 'BR', 'SUP', 'SPAN', 'U']);
const DROP = new Set(['SCRIPT', 'STYLE', 'IFRAME', 'OBJECT', 'EMBED', 'TEMPLATE', 'NOSCRIPT', 'SVG', 'MATH']);
function sanitize(html: string) {
  const doc = new DOMParser().parseFromString(`<div>${html}</div>`, 'text/html');
  const walk = (node: Node): string => {
    let out = '';
    node.childNodes.forEach((c) => {
      if (c.nodeType === 3) { out += esc(c.textContent); return; }
      if (c.nodeType !== 1) return;
      const el = c as Element;
      if (DROP.has(el.tagName.toUpperCase())) return;
      const inner = walk(el);
      if (!ALLOWED.has(el.tagName)) { out += inner; return; }
      const tag = el.tagName.toLowerCase();
      if (tag === 'br') { out += '<br>'; return; }
      const cls = el.getAttribute('class') || '';
      const keep = /footnote-marker|footnote/.test(cls) ? ` class="${cls.includes('marker') ? 'footnote-marker' : 'footnote'}"` : '';
      out += `<${tag}${keep}>${inner}</${tag}>`;
    });
    return out;
  };
  return walk(doc.body.firstChild!);
}
const flat = (x: any): string[] => Array.isArray(x) ? x.flatMap(flat) : (x == null ? [] : [String(x)]);
const textCache = new Map<string, any>();

async function fetchChapter(t: Tractate, ch: number) {
  const ref = `${t.book} ${ch}`;
  if (textCache.has(ref)) return textCache.get(ref);
  const cached = store.get('t:' + ref);
  if (cached) { textCache.set(ref, cached); return cached; }
  const r = await fetch(`${SEFARIA}/api/texts/${encodeRef(ref)}?context=0&commentary=0&pad=0`);
  if (!r.ok) throw new Error(`Sefaria ${r.status}`);
  const j = await r.json();
  if (j.error) throw new Error(j.error);
  const he = flat(j.he);
  const en = flat(j.text);
  const n = Math.max(he.length, en.length);
  const data = {
    paras: Array.from({ length: n }, (_, i) => ({ he: he[i] || '', en: en[i] || '' })),
    enVersion: en.length ? j.versionTitle || '' : '',
    heVersion: j.heVersionTitle || '',
  };
  textCache.set(ref, data);
  // Keep a copy so chapters already opened still read offline.
  try { localStorage.setItem('mm:t:' + ref, JSON.stringify(data)); } catch { /* quota — fine */ }
  return data;
}

const linkCache = new Map<string, any[]>();
async function fetchLinks(ref: string, withText: boolean) {
  const k = `${withText ? 1 : 0}:${ref}`;
  if (linkCache.has(k)) return linkCache.get(k)!;
  try {
    const r = await fetch(`${SEFARIA}/api/links/${encodeRef(ref)}?with_text=${withText ? 1 : 0}`);
    const j = r.ok ? await r.json() : [];
    const out = Array.isArray(j) ? j : [];
    linkCache.set(k, out);
    return out;
  } catch { return []; }
}

/** Which mishnah of the open chapter a link hangs on (0 if none). */
function linkMishnah(l: any, t: Tractate, ch: number) {
  const prefix = `${t.book} ${ch}:`;
  const anchors = [l.anchorRef, ...(l.anchorRefExpanded || [])].map(String);
  for (const a of anchors) if (a.startsWith(prefix)) { const m = a.slice(prefix.length).match(/^(\d+)/); if (m) return Number(m[1]); }
  return 0;
}
const linkGroup = (l: any) => l.collectiveTitle?.en || l.index_title || l.category || 'Other';
const isBavli = (l: any) => l.category === 'Talmud' && !/^Jerusalem/.test(String(l.index_title || l.ref)) && /\d+[ab]/.test(String(l.ref));
const isYerushalmi = (l: any) => l.category === 'Talmud' && /^Jerusalem Talmud/.test(String(l.ref));
const tabOf = (l: any) => {
  const c = l.category === 'Quoting Commentary' ? 'Commentary' : l.category;
  return TAB_ORDER.includes(c) ? c : 'Other';
};

/** Per-mishnah counts for the badges under each mishnah, from one chapter-level links call. */
async function loadLinkSummary(t: Tractate, ch: number) {
  const links = await fetchLinks(`${t.book} ${ch}`, false);
  if (state.tr !== t || state.ch !== ch) return;
  const sum = new Map<number, any>();
  // Sefaria spells a few tractates differently in the Talmud than in the Mishnah.
  const tname = ({ "Ta'anit": 'Taanit', Avot: 'Pirkei Avot' } as Record<string, string>)[t.name] || t.name;
  for (const l of links) {
    const m = linkMishnah(l, t, ch);
    if (!m) continue;
    if (!sum.has(m)) sum.set(m, { bavli: new Set<string>(), yer: 0, tosefta: 0, tanakh: 0, comm: new Set<string>() });
    const s = sum.get(m);
    if (isBavli(l)) s.bavli.add(String(l.ref).replace(/(\d+[ab]).*/, '$1').replace(`${tname} `, ''));
    else if (isYerushalmi(l)) { if (String(l.ref).startsWith(`Jerusalem Talmud ${tname} `)) s.yer++; }
    else if (l.category === 'Tosefta') s.tosefta++;
    else if (l.category === 'Tanakh') s.tanakh++;
    else if (l.category === 'Commentary') s.comm.add(linkGroup(l).replace(/ on .*$/, ''));
  }
  state.linkSummary = sum;
  renderBadges();
  if (!state.selected) renderPanel();
}

/* ───────────────────────── Mishnah Yomit ───────────────────────── */
async function loadToday() {
  const cached = store.get('today');
  const todayKey = new Date().toDateString();
  let ref = cached?.day === todayKey ? cached.ref : '';
  if (!ref) {
    try {
      const r = await fetch(`${SEFARIA}/api/calendars?diaspora=1`);
      const j = await r.json();
      ref = (j.calendar_items || []).find((i: any) => i.title?.en === 'Daily Mishnah')?.ref || '';
      if (ref) store.set('today', { day: todayKey, ref });
    } catch { /* offline */ }
  }
  const m = ref.match(/^(.*) (\d+):(\d+)(?:-(?:(\d+):)?(\d+))?$/);
  if (m) {
    const t = TRACTATES.find((x) => x.book === m[1]);
    if (t) {
      const ch = Number(m[2]);
      const from = Number(m[3]);
      // A range that crosses into the next perek ends with that perek's chapter count.
      const to = m[4] && Number(m[4]) !== ch ? t.chapters[ch - 1] : Number(m[5] || m[3]);
      state.today = { tr: t, ch, from, to, ref };
    }
  }
  renderToday();
  renderToc(($('mm-search') as HTMLInputElement).value);
}

/* ───────────────────────── rendering ───────────────────────── */
const HE_MONTH: Record<string, string> = {
  Tishri: 'תשרי', Heshvan: 'חשון', Kislev: 'כסלו', Tevet: 'טבת', Shevat: 'שבט', 'Adar I': 'אדר א׳', Adar: 'אדר',
  'Adar II': 'אדר ב׳', Nisan: 'ניסן', Iyar: 'אייר', Sivan: 'סיון', Tamuz: 'תמוז', Av: 'אב', Elul: 'אלול',
};
/** Today's Hebrew date as כ״ה תשרי תשפ״ז. */
function hebDate() {
  try {
    const parts = new Intl.DateTimeFormat('en-u-ca-hebrew', { day: 'numeric', month: 'long', year: 'numeric' }).formatToParts(new Date());
    const get = (k: string) => parts.find((p) => p.type === k)?.value ?? '';
    return `${gem(Number(get('day')))} ${HE_MONTH[get('month')] || get('month')} ${gem(Number(get('year')))}`;
  } catch { return ''; }
}

function renderToday() {
  const done = totalLearned();
  const pct = (done / TOTAL_MISHNAYOT) * 100;
  const siyumim = TRACTATES.filter((t) => tractateLearned(t) === tractateSize(t)).length;
  const td = state.today;
  const next = nextUnlearned();
  $('mm-today').innerHTML = `
    <span class="mm-today-date">${new Date().toLocaleDateString(undefined, { weekday: 'long', month: 'long', day: 'numeric' })}<span class="he">${esc(hebDate())}</span></span>
    ${td ? `<button class="mm-chip mm-chip-btn say" data-go="today">Mishnah Yomit · ${esc(td.tr.name)} ${td.ch}:${td.from}${td.to !== td.from ? '–' + td.to : ''}</button>` : ''}
    ${next && done ? `<button class="mm-chip mm-chip-btn" data-go="next">Continue · ${esc(next.t.name)} ${next.ch}:${next.m}</button>` : ''}
    <span class="mm-loc mm-prog" title="Mishnayot you have marked learned">
      <span class="mm-prog-bar"><i style="width:${pct.toFixed(2)}%"></i></span>
      <span>${done.toLocaleString()} / ${TOTAL_MISHNAYOT.toLocaleString()}${siyumim ? ` · ${siyumim} siyum${siyumim > 1 ? 'im' : ''}` : ''}</span>
    </span>`;
}

/** First unlearned mishnah after the last one you marked, in Mishnah order. */
function nextUnlearned() {
  const last = store.get('lastLearned', null) as null | { t: string; ch: number; m: number };
  let ti = last ? Math.max(0, TRACTATES.findIndex((t) => t.name === last.t)) : 0;
  let ch = last?.ch || 1;
  let m = last ? last.m + 1 : 1;
  for (let guard = 0; guard < 6000; guard++) {
    const t = TRACTATES[ti];
    if (m > t.chapters[ch - 1]) { m = 1; ch++; }
    if (ch > t.chapters.length) { ch = 1; ti = (ti + 1) % TRACTATES.length; continue; }
    if (!isLearned(TRACTATES[ti], ch, m)) return { t: TRACTATES[ti], ch, m };
    m++;
  }
  return null;
}

function renderToc(filter = '') {
  const q = filter.trim().toLowerCase();
  const strippedQ = strip(q);
  const td = state.today;
  const html = SEDARIM.map((s) => {
    const trs = s.tractates
      .map((x) => TRACTATES.find((t) => t.book === x.book)!)
      .filter((t) => !q || t.name.toLowerCase().includes(q) || t.he.includes(strippedQ) || s.name.toLowerCase().includes(q) || s.he.includes(strippedQ));
    if (!trs.length) return '';
    const items = trs.map((t) => {
      const size = tractateSize(t);
      const done = tractateLearned(t);
      const cur = state.tr === t;
      const cells = t.chapters.map((n, i) => {
        const l = learnedIn(t, i + 1).length;
        const cls = [cur && state.ch === i + 1 ? 'current' : '', l === n ? 'full' : '', td && td.tr === t && td.ch === i + 1 ? 'today' : ''].join(' ');
        return `<button class="mm-cell ${cls}" data-t="${t.idx}" data-ch="${i + 1}" title="Perek ${i + 1} · ${l}/${n} learned">${gem(i + 1, false)}${l && l < n ? `<i style="height:${(l / n) * 100}%"></i>` : ''}</button>`;
      }).join('');
      return `<details class="mm-tr${cur ? ' current' : ''}"${cur || q ? ' open' : ''}>
        <summary>${esc(t.name)}<span class="he">${esc(t.he)}</span><span class="pct${done === size ? ' done' : ''}">${done ? (done === size ? '✓' : Math.floor((done / size) * 100) + '%') : ''}</span></summary>
        <div class="mm-grid">${cells}</div>
      </details>`;
    }).join('');
    const open = q || (state.tr ? state.tr.seder === s.name : s.name === 'Zeraim');
    return `<details class="mm-seder"${open ? ' open' : ''}><summary>Seder ${esc(s.name)}<span class="gloss">${esc(s.gloss)}</span><span class="he">${esc(s.he)}</span></summary><div class="kids">${items}</div></details>`;
  }).join('');
  $('mm-toc').innerHTML = html || '<div class="mm-toc-empty">No tractate matches.</div>';
}

function fillSelects() {
  const trSel = $('mm-tractate') as HTMLSelectElement;
  if (!trSel.options.length) {
    trSel.innerHTML = '<option value="">Tractate…</option>' + SEDARIM.map((s) => `<optgroup label="${esc(s.name)} · ${esc(s.he)}">${
      s.tractates.map((x) => { const t = TRACTATES.find((y) => y.book === x.book)!; return `<option value="${t.idx}">${esc(t.name)} · ${esc(t.he)}</option>`; }).join('')
    }</optgroup>`).join('');
  }
  trSel.value = state.tr ? String(state.tr.idx) : '';
  const chSel = $('mm-chapter') as HTMLSelectElement;
  chSel.innerHTML = state.tr ? state.tr.chapters.map((_n: number, i: number) => `<option value="${i + 1}">פרק ${gem(i + 1)}</option>`).join('') : '<option>—</option>';
  chSel.disabled = !state.tr;
  if (state.tr) chSel.value = String(state.ch);
}

