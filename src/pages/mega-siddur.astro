---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Mega Siddur"
  description="A working siddur — Ashkenaz, Sefard and Edot HaMizrach — with today's insertions, Sefaria's linked sources, and a personal layer of rich commentary."
>

<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Cormorant+SC:wght@400;500;600&family=Frank+Ruhl+Libre:wght@400;500;700&display=swap');

body:has(.ms-page) { background:#0c0b09!important; padding:0!important; overflow:hidden!important; }
body:has(.ms-page) > footer { display:none!important; }

.ms-page {
  --bg:#0c0b09; --surface:#141210; --surface2:#1c1a15;
  --border:rgba(201,162,87,.15); --border-hi:rgba(201,162,87,.4);
  --text:#e8d4aa; --muted:#8a7a5a; --faint:#3a3020;
  --gold:#c9a257; --gold-dim:rgba(201,162,87,.6);
  --accent:#79b8a4; --warn:#e0a35c; --skip:#a87a7a;
  --heb:'Frank Ruhl Libre','Noto Serif Hebrew',serif;
  --display:'Cormorant Garamond',Georgia,serif;
  --sc:'Cormorant SC',Georgia,serif;
  --mono:'JetBrains Mono',ui-monospace,monospace;
  --heb-size:1.55rem; --en-size:1.05rem;
  --sidebar:260px; --panel:380px;
  position:fixed; top:4rem; left:0; right:0; bottom:0; display:flex; flex-direction:column;
  background:var(--bg); color:var(--text); overflow:hidden;
}
.ms-page[data-theme="parchment"] {
  --bg:#f5efe0; --surface:#ece4d0; --surface2:#e4dac2;
  --border:rgba(110,80,30,.18); --border-hi:rgba(110,80,30,.42);
  --text:#2b2216; --muted:#7a6a4e; --faint:#cfc2a2;
  --gold:#8a5a12; --gold-dim:rgba(138,90,18,.6);
  --accent:#2f7a63; --warn:#a4600f; --skip:#8a4a4a;
}
body:has(.ms-page[data-theme="parchment"]) { background:#f5efe0!important; }

/* ── TOP BAR ── */
.ms-bar {
  flex-shrink:0; display:flex; align-items:center; gap:.5rem; flex-wrap:wrap;
  background:var(--surface); border-bottom:1px solid var(--border-hi); padding:.4rem .8rem; min-height:2.8rem;
}
.ms-logo { font-family:var(--sc); font-size:.72rem; letter-spacing:.32em; color:var(--gold); white-space:nowrap; padding-right:.6rem; border-right:1px solid var(--border); }
.ms-sel, .ms-btn {
  background:var(--surface2); border:1px solid var(--border-hi); color:var(--text);
  font-family:var(--display); font-size:.9rem; padding:.28rem .7rem; cursor:pointer; outline:none;
}
.ms-sel:focus, .ms-btn:focus-visible { border-color:var(--gold); }
.ms-btn:hover { border-color:var(--gold); color:var(--gold); }
.ms-btn.primary { background:var(--gold); color:var(--bg); border-color:var(--gold); font-family:var(--sc); letter-spacing:.16em; font-size:.66rem; font-weight:600; text-transform:uppercase; }
.ms-btn.primary:hover { filter:brightness(1.1); color:var(--bg); }
.ms-btn.on { color:var(--gold); border-color:var(--gold); background:rgba(201,162,87,.1); }
.ms-seg { display:flex; }
.ms-seg .ms-btn + .ms-btn { border-left:none; }
.ms-spacer { flex:1; }
.ms-icon-btn { min-width:2rem; text-align:center; padding:.28rem .5rem; }
.ms-only-mobile { display:none; }

/* ── TODAY STRIP ── */
.ms-today {
  flex-shrink:0; display:flex; align-items:center; gap:.45rem; flex-wrap:wrap;
  padding:.35rem .9rem; border-bottom:1px solid var(--border); background:var(--bg);
  font-family:var(--display); font-size:.86rem; color:var(--muted);
}
.ms-today-date { color:var(--text); }
.ms-today-date .he { font-family:var(--heb); color:var(--gold); margin-left:.35rem; }
.ms-chip {
  font-family:var(--sc); font-size:.6rem; letter-spacing:.1em; text-transform:uppercase;
  padding:.12rem .5rem; border:1px solid var(--border-hi); color:var(--text); white-space:nowrap;
}
.ms-chip.say { border-color:var(--accent); color:var(--accent); }
.ms-chip.skip { border-color:var(--skip); color:var(--skip); }
.ms-chip.note { border-color:var(--warn); color:var(--warn); }
.ms-loc { margin-left:auto; display:flex; gap:.35rem; align-items:center; font-size:.78rem; }
.ms-loc button { background:none; border:none; color:var(--gold-dim); cursor:pointer; font-family:var(--display); font-size:.8rem; text-decoration:underline dotted; padding:0; }

/* ── BODY ── */
.ms-body { display:flex; flex:1; min-height:0; overflow:hidden; }

/* SIDEBAR / TOC */
.ms-sidebar {
  width:var(--sidebar); flex-shrink:0; background:var(--surface); border-right:1px solid var(--border);
  display:flex; flex-direction:column; min-height:0;
}
.ms-search { margin:.6rem; padding:.35rem .6rem; background:var(--surface2); border:1px solid var(--border-hi); color:var(--text); font-family:var(--display); font-size:.9rem; outline:none; }
.ms-search:focus { border-color:var(--gold); }
.ms-toc { overflow-y:auto; padding:0 .5rem 4rem; flex:1; scrollbar-width:thin; scrollbar-color:var(--faint) transparent; }
.ms-toc details { margin-left:.15rem; }
.ms-toc details > summary {
  cursor:pointer; list-style:none; font-family:var(--sc); font-size:.62rem; letter-spacing:.16em; text-transform:uppercase;
  color:var(--muted); padding:.3rem .2rem; border-bottom:1px solid var(--border);
}
.ms-toc details > summary::before { content:'▸'; display:inline-block; width:.9rem; color:var(--gold-dim); transition:transform .12s; }
.ms-toc details[open] > summary::before { transform:rotate(90deg); }
.ms-toc details details > summary { font-size:.58rem; border-bottom:none; }
.ms-toc .kids { padding-left:.55rem; border-left:1px solid var(--border); margin-left:.35rem; }
.ms-leaf {
  display:flex; align-items:baseline; gap:.35rem; width:100%; text-align:left; background:none; border:none;
  color:var(--text); font-family:var(--display); font-size:.86rem; padding:.16rem .3rem; cursor:pointer; line-height:1.25;
}
.ms-leaf:hover { color:var(--gold); }
.ms-leaf.current { color:var(--gold); background:rgba(201,162,87,.1); }
.ms-leaf .he { font-family:var(--heb); font-size:.8rem; color:var(--muted); margin-left:auto; direction:rtl; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:45%; }
.ms-dot { width:6px; height:6px; border-radius:50%; background:var(--gold); flex-shrink:0; align-self:center; }
.ms-toc-empty { font-family:var(--display); color:var(--muted); padding:1rem .5rem; font-size:.9rem; }

/* MAIN */
.ms-main { flex:1; overflow-y:auto; min-width:0; scrollbar-width:thin; scrollbar-color:var(--faint) transparent; }
.ms-main-inner { max-width:860px; margin:0 auto; padding:1.4rem 1.6rem 8rem; }
.ms-crumbs { font-family:var(--sc); font-size:.62rem; letter-spacing:.2em; text-transform:uppercase; color:var(--muted); }
.ms-crumbs span + span::before { content:' · '; color:var(--faint); }
.ms-title { display:flex; justify-content:space-between; align-items:baseline; gap:1rem; margin:.3rem 0 1rem; border-bottom:1px solid var(--border-hi); padding-bottom:.6rem; }
.ms-title h1 { font-family:var(--display); font-weight:400; font-size:2rem; margin:0; color:var(--text); }
.ms-title .he { font-family:var(--heb); font-size:1.9rem; color:var(--gold); direction:rtl; }
.ms-banner { border-left:3px solid var(--warn); background:rgba(224,163,92,.07); padding:.5rem .8rem; margin:0 0 1rem; font-family:var(--display); font-size:.98rem; }
.ms-banner.say { border-color:var(--accent); background:rgba(121,184,164,.07); }
.ms-banner.skip { border-color:var(--skip); background:rgba(168,122,122,.08); }
.ms-banner b { font-family:var(--sc); letter-spacing:.08em; font-weight:600; }

.ms-para { position:relative; padding:.55rem .6rem .55rem 2.2rem; border-radius:2px; cursor:pointer; transition:background .12s; }
.ms-para:hover { background:rgba(201,162,87,.04); }
.ms-para.selected { background:rgba(201,162,87,.09); box-shadow:inset 2px 0 0 var(--gold); }
.ms-pnum { position:absolute; left:.3rem; top:.75rem; font-family:var(--mono); font-size:.6rem; color:var(--faint); }
.ms-marks { position:absolute; left:.25rem; top:1.6rem; display:flex; flex-direction:column; gap:.2rem; align-items:center; }
.ms-mark { font-family:var(--mono); font-size:.55rem; line-height:1; padding:.1rem .2rem; border-radius:2px; }
.ms-mark.mine { background:var(--gold); color:var(--bg); }
.ms-mark.lib { border:1px solid var(--border-hi); color:var(--muted); }
.ms-he { font-family:var(--heb); font-size:var(--heb-size); line-height:1.85; direction:rtl; text-align:right; color:var(--text); }
.ms-he small, .ms-en small { font-size:.72em; color:var(--muted); }
.ms-he b { font-weight:700; }
.ms-en { font-family:var(--display); font-size:var(--en-size); line-height:1.55; color:var(--muted); margin-top:.3rem; }
.ms-en i { color:var(--muted); }
.ms-page[data-layout="side"] .ms-para { display:grid; grid-template-columns:1fr 1fr; gap:1.4rem; align-items:start; }
.ms-page[data-layout="side"] .ms-en { order:-1; margin-top:.35rem; }
.ms-page[data-lang="he"] .ms-en { display:none; }
.ms-page[data-lang="en"] .ms-he { display:none; }
.footnote-marker { color:var(--gold); cursor:pointer; font-size:.7em; padding:0 .1em; }
.ms-en .footnote { display:none; font-style:normal; }
.ms-en .footnote.open { display:block; margin:.3rem 0 .4rem 1rem; padding-left:.6rem; border-left:2px solid var(--border-hi); font-size:.92em; }
.ms-loading, .ms-error { font-family:var(--display); color:var(--muted); padding:2rem 0; font-size:1.05rem; }
.ms-error { color:var(--skip); }

.ms-pager { display:flex; justify-content:space-between; gap:1rem; margin-top:2.2rem; border-top:1px solid var(--border); padding-top:1rem; }
.ms-pager button { flex:1; background:var(--surface); border:1px solid var(--border-hi); color:var(--text); padding:.7rem .9rem; cursor:pointer; text-align:left; font-family:var(--display); font-size:1rem; }
.ms-pager button:hover { border-color:var(--gold); }
.ms-pager button.next { text-align:right; }
.ms-pager small { display:block; font-family:var(--sc); font-size:.58rem; letter-spacing:.2em; text-transform:uppercase; color:var(--muted); }
.ms-pager button:disabled { opacity:.3; cursor:default; }

/* WELCOME */
.ms-welcome h1 { font-family:var(--display); font-weight:300; font-size:2.6rem; margin:.5rem 0; }
.ms-welcome p { font-family:var(--display); font-size:1.1rem; color:var(--muted); line-height:1.6; max-width:40rem; }
.ms-quick { display:grid; grid-template-columns:repeat(auto-fill,minmax(180px,1fr)); gap:.6rem; margin-top:1.4rem; }
.ms-quick button { background:var(--surface); border:1px solid var(--border-hi); color:var(--text); padding:.8rem; cursor:pointer; text-align:left; font-family:var(--display); font-size:1.05rem; }
.ms-quick button:hover { border-color:var(--gold); color:var(--gold); }
.ms-quick .he { display:block; font-family:var(--heb); color:var(--gold); font-size:1.1rem; direction:rtl; text-align:right; }

/* COMMENTARY PANEL */
.ms-panel {
  width:var(--panel); flex-shrink:0; background:var(--surface); border-left:1px solid var(--border);
  display:flex; flex-direction:column; min-height:0;
}
.ms-page[data-daven="1"] .ms-panel, .ms-page[data-daven="1"] .ms-marks { display:none; }
.ms-page[data-daven="1"] .ms-para { cursor:default; }
.ms-panel-head { display:flex; align-items:center; gap:.4rem; padding:.55rem .8rem; border-bottom:1px solid var(--border); }
.ms-panel-head h2 { font-family:var(--sc); font-size:.66rem; letter-spacing:.22em; text-transform:uppercase; color:var(--gold); margin:0; flex:1; font-weight:500; }
.ms-panel-body { overflow-y:auto; padding:.7rem .9rem 5rem; flex:1; scrollbar-width:thin; scrollbar-color:var(--faint) transparent; }
.ms-scope { font-family:var(--display); font-size:.9rem; color:var(--muted); margin-bottom:.6rem; }
.ms-scope b { color:var(--text); font-weight:600; }
.ms-h3 { font-family:var(--sc); font-size:.6rem; letter-spacing:.22em; text-transform:uppercase; color:var(--muted); border-bottom:1px solid var(--border); padding-bottom:.25rem; margin:1rem 0 .5rem; display:flex; justify-content:space-between; align-items:baseline; }
.ms-note { border:1px solid var(--border); border-left:3px solid var(--gold); padding:.55rem .7rem; margin-bottom:.6rem; background:var(--bg); }
.ms-note.draft { border-left-style:dashed; opacity:.85; }
.ms-note-meta { display:flex; gap:.4rem; align-items:center; flex-wrap:wrap; font-family:var(--sc); font-size:.55rem; letter-spacing:.12em; text-transform:uppercase; color:var(--muted); }
.ms-kind { padding:.05rem .35rem; border:1px solid var(--border-hi); color:var(--gold); }
.ms-note h4 { font-family:var(--display); font-size:1.08rem; margin:.25rem 0; font-weight:600; color:var(--text); }
.ms-anchor { font-family:var(--heb); direction:rtl; color:var(--gold); font-size:1rem; }
.ms-note-body { font-family:var(--display); font-size:.98rem; line-height:1.5; color:var(--text); }
.ms-note-body p { margin:.35rem 0; }
.ms-note-body a, .ms-note-src a, .ms-lib a { color:var(--gold); }
.ms-note-src { font-family:var(--display); font-size:.85rem; color:var(--muted); margin-top:.35rem; font-style:italic; }
.ms-note-tags { display:flex; gap:.25rem; flex-wrap:wrap; margin-top:.35rem; }
.ms-note-tags span { font-family:var(--mono); font-size:.58rem; color:var(--muted); border:1px solid var(--border); padding:0 .3rem; }
.ms-note-actions { display:flex; gap:.6rem; margin-top:.4rem; }
.ms-note-actions button { background:none; border:none; padding:0; font-family:var(--sc); font-size:.58rem; letter-spacing:.14em; text-transform:uppercase; color:var(--gold-dim); cursor:pointer; }
.ms-note-actions button:hover { color:var(--gold); }
.ms-empty { font-family:var(--display); color:var(--muted); font-size:.92rem; font-style:italic; }

.ms-lib details { border-bottom:1px solid var(--border); }
.ms-lib summary { cursor:pointer; padding:.35rem 0; font-family:var(--display); font-size:.98rem; color:var(--text); display:flex; gap:.4rem; align-items:baseline; }
.ms-lib summary .cat { font-family:var(--sc); font-size:.52rem; letter-spacing:.12em; text-transform:uppercase; color:var(--muted); margin-left:auto; }
.ms-lib summary .n { font-family:var(--mono); font-size:.6rem; color:var(--gold-dim); }
.ms-lib-item { padding:.35rem 0 .6rem .5rem; border-left:1px solid var(--border-hi); margin:0 0 .4rem .2rem; }
.ms-lib-ref { font-family:var(--sc); font-size:.6rem; letter-spacing:.1em; }
.ms-lib-he { font-family:var(--heb); direction:rtl; font-size:1.02rem; line-height:1.7; color:var(--text); margin-top:.2rem; }
.ms-lib-en { font-family:var(--display); font-size:.92rem; line-height:1.45; color:var(--muted); margin-top:.2rem; }
.ms-lib-more { background:none; border:none; color:var(--gold-dim); cursor:pointer; font-family:var(--sc); font-size:.56rem; letter-spacing:.14em; text-transform:uppercase; padding:.2rem 0; }

/* EDITOR */
.ms-form { display:flex; flex-direction:column; gap:.45rem; border:1px solid var(--border-hi); padding:.7rem; background:var(--bg); margin-bottom:.8rem; }
.ms-form label { font-family:var(--sc); font-size:.55rem; letter-spacing:.16em; text-transform:uppercase; color:var(--muted); display:flex; flex-direction:column; gap:.2rem; }
.ms-form input[type=text], .ms-form input[type=url], .ms-form input[type=number], .ms-form textarea, .ms-form select {
  background:var(--surface2); border:1px solid var(--border-hi); color:var(--text); font-family:var(--display); font-size:.95rem; padding:.3rem .45rem; outline:none; text-transform:none; letter-spacing:normal;
}
.ms-form textarea { min-height:9rem; resize:vertical; line-height:1.45; }
.ms-form input:focus, .ms-form textarea:focus, .ms-form select:focus { border-color:var(--gold); }
.ms-form .row { display:flex; gap:.5rem; }
.ms-form .row > * { flex:1; }
.ms-form .radios { display:flex; flex-direction:column; gap:.2rem; font-family:var(--display); font-size:.9rem; color:var(--text); text-transform:none; letter-spacing:normal; }
.ms-form .radios label, .ms-form .check { flex-direction:row; align-items:center; gap:.4rem; font-family:var(--display); font-size:.9rem; color:var(--text); text-transform:none; letter-spacing:normal; }
.ms-form-actions { display:flex; gap:.5rem; align-items:center; }
.ms-form-msg { font-family:var(--display); font-size:.85rem; color:var(--skip); }
.ms-hint { font-family:var(--display); font-size:.8rem; color:var(--muted); font-style:italic; text-transform:none; letter-spacing:normal; }

.ms-scrim { display:none; }

/* ── MOBILE ── */
@media (max-width: 1100px) {
  .ms-page { --panel:340px; --sidebar:230px; }
}
@media (max-width: 900px) {
  .ms-only-mobile { display:inline-block; }
  .ms-sidebar, .ms-panel {
    position:absolute; top:0; bottom:0; z-index:30; box-shadow:0 0 30px rgba(0,0,0,.45);
    transition:transform .2s ease;
  }
  .ms-sidebar { left:0; width:min(84vw,320px); transform:translateX(-105%); }
  .ms-panel { right:0; width:min(92vw,420px); transform:translateX(105%); }
  .ms-page[data-sidebar="1"] .ms-sidebar { transform:none; }
  .ms-page[data-panel="1"] .ms-panel { transform:none; }
  .ms-page[data-sidebar="1"] .ms-scrim, .ms-page[data-panel="1"] .ms-scrim { display:block; position:absolute; inset:0; z-index:25; background:rgba(0,0,0,.35); }
  .ms-body { position:relative; }
  .ms-main-inner { padding:1rem 1rem 7rem; }
  .ms-page[data-layout="side"] .ms-para { display:block; }
  .ms-title h1 { font-size:1.5rem; }
  .ms-title .he { font-size:1.5rem; }
  .ms-para { padding-left:1.9rem; }
  .ms-hide-mobile { display:none; }
  .ms-loc { margin-left:0; }
  .ms-logo { display:none; }
  .ms-today { flex-wrap:nowrap; overflow-x:auto; scrollbar-width:none; }
  .ms-today > * { flex-shrink:0; }
}
</style>

<div class="ms-page" id="ms-page" data-theme="night" data-lang="both" data-layout="stack" data-daven="0">
  <div class="ms-bar">
    <button class="ms-btn ms-icon-btn ms-only-mobile" id="ms-toc-toggle" aria-label="Contents">☰</button>
    <span class="ms-logo">MEGA SIDDUR</span>
    <select class="ms-sel" id="ms-nusach" aria-label="Nusach">
      <option value="Ashkenaz">Ashkenaz</option>
      <option value="Sefard">Sefard</option>
      <option value="Edot HaMizrach">Edot HaMizrach</option>
    </select>
    <button class="ms-btn primary" id="ms-now" title="Jump to the service for right now">Now</button>
    <div class="ms-seg ms-hide-mobile" role="group" aria-label="Language">
      <button class="ms-btn" data-lang="he">עב</button>
      <button class="ms-btn on" data-lang="both">עב + En</button>
      <button class="ms-btn" data-lang="en">En</button>
    </div>
    <button class="ms-btn ms-hide-mobile" id="ms-layout" title="Hebrew and English stacked or side by side">Stacked</button>
    <div class="ms-seg" role="group" aria-label="Text size">
      <button class="ms-btn ms-icon-btn" id="ms-smaller" aria-label="Smaller text">A−</button>
      <button class="ms-btn ms-icon-btn" id="ms-bigger" aria-label="Larger text">A+</button>
    </div>
    <span class="ms-spacer"></span>
    <button class="ms-btn" id="ms-daven" title="Hide commentary for davening">Davening mode</button>
    <button class="ms-btn ms-icon-btn" id="ms-theme" title="Night / parchment">◐</button>
    <button class="ms-btn ms-icon-btn" id="ms-lock" title="Unlock to add commentary">🔒</button>
    <button class="ms-btn ms-icon-btn ms-only-mobile" id="ms-panel-toggle" aria-label="Commentary">✎</button>
  </div>

  <div class="ms-today" id="ms-today"></div>

  <div class="ms-body">
    <aside class="ms-sidebar" id="ms-sidebar">
      <input class="ms-search" id="ms-search" type="search" placeholder="Find a prayer… / חיפוש" autocomplete="off" />
      <nav class="ms-toc" id="ms-toc" aria-label="Contents"></nav>
    </aside>

    <main class="ms-main" id="ms-main">
      <div class="ms-main-inner" id="ms-content"></div>
    </main>

    <aside class="ms-panel" id="ms-panel">
      <div class="ms-panel-head">
        <h2 id="ms-panel-title">Commentary</h2>
        <button class="ms-btn ms-icon-btn ms-only-mobile" id="ms-panel-close" aria-label="Close">✕</button>
      </div>
      <div class="ms-panel-body" id="ms-panel-body"></div>
    </aside>
    <div class="ms-scrim" id="ms-scrim"></div>
  </div>
</div>

<script>
import tocData from '../data/mega-siddur/toc.json';

const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
const TABLE = 'siddur_commentary';
const API = '/api/mega-siddur-commentary';
const SEFARIA = 'https://www.sefaria.org';

const BOOKS: Record<string, string> = {
  'Ashkenaz': 'Siddur Ashkenaz',
  'Sefard': 'Siddur Sefard',
  'Edot HaMizrach': 'Siddur Edot HaMizrach',
};
const KINDS = ['commentary', 'halacha', 'history', 'kavanah', 'source', 'language', 'personal', 'music'];

// Where "Now" lands for each service, per nusach (first section whose path starts with a prefix).
const SERVICE_PREFIXES: Record<string, Record<string, string[]>> = {
  'Ashkenaz': {
    shacharit: ['Weekday > Shacharit'], minchah: ['Weekday > Minchah'], maariv: ['Weekday > Maariv'],
