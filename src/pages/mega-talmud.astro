---
import Layout from '../layouts/Layout.astro';
import structure from '../data/talmud-structure.json';
import insights from '../data/talmud-insights.json';
import { PALETTES, MOVE_ORDER, MOVE_LABELS, COLOR_KEY, MIN_SURE, NEW_SUGYA } from '../lib/sugya.js';
const SUGYA = { PALETTES, MOVE_ORDER, MOVE_LABELS, COLOR_KEY, MIN_SURE, NEW_SUGYA };

const lafMods = import.meta.glob('../data/laf-yomi/*.json', { eager: true });
const lafByDaf = {};
for (const mod of Object.values(lafMods)) {
  const issue = mod.default ?? mod;
  lafByDaf[issue.daf] = {
    date: issue.date, pdf: issue.pdf,
    daf_summary: issue.daf_summary, jokes: issue.jokes,
  };
}
const ATTACH = { laf: lafByDaf, insights };
---

<Layout
  title="Mega Talmud"
  description="The daily daf, mined from every maggid shiur — insights, highlights, and the daily Laf Yomi laugh sheet."
>

<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Cormorant+SC:wght@400;500;600&family=Frank+Ruhl+Libre:wght@400;500;700&display=swap');
body:has(.mega-talmud) { background:#0c0b09 !important; }
</style>

<style is:global>
/* ——— Mega Talmud browser (client-rendered: global styles, mtb- prefix) ——— */
.mtb-intro { font-family:'Cormorant Garamond',Georgia,serif; font-size:1.08rem; line-height:1.55; color:#8a7a5a; max-width:44rem; margin:0 0 1.2rem; }
.mtb-controls { display:flex; flex-wrap:wrap; gap:.7rem 1rem; align-items:flex-end; margin-bottom:.55rem; }
.mtb-controls label { font-family:'Cormorant SC',Georgia,serif; font-size:.64rem; letter-spacing:.22em; text-transform:uppercase; color:#c9a257; display:flex; flex-direction:column; gap:.35rem; }
.mtb-controls select { font-family:'Cormorant Garamond',Georgia,serif; font-size:1.05rem; color:#261f14; background:#faf5ea; border:1px solid rgba(201,162,87,.5); padding:.42rem .6rem; min-width:11rem; }
.mtb-nav { display:flex; gap:.5rem; }
.mtb-nav button, .mtb-amud button { font-family:'Cormorant SC',Georgia,serif; font-size:.68rem; letter-spacing:.16em; text-transform:uppercase; color:#c9a257; background:transparent; border:1px solid rgba(201,162,87,.4); padding:.5rem .9rem; cursor:pointer; }
.mtb-nav button:hover:not(:disabled), .mtb-amud button:hover { border-color:#c9a257; color:#e8d4aa; }
.mtb-nav button:disabled { opacity:.35; cursor:default; }
.mtb-amud { display:flex; gap:.5rem; margin-left:auto; }
.mtb-legend { font-family:'Cormorant Garamond',Georgia,serif; font-size:.95rem; color:#8a7a5a; margin:0 0 1.1rem; }
.mtb-panel { background:#faf5ea; color:#261f14; border:1px solid rgba(201,162,87,.45); padding:1.6rem 1.5rem 2rem; }
.mtb-panel .mtb-status { font-family:'Cormorant Garamond',Georgia,serif; font-style:italic; font-size:1.1rem; color:#5d5142; padding:.6rem 0; }
.mtb-panel .mtb-status.err { color:#9c3d1e; font-style:normal; }
.mtb-badges { display:flex; flex-wrap:wrap; gap:.5rem; margin-bottom:1.1rem; }
.mtb-badge { font-family:'Cormorant SC',Georgia,serif; font-size:.64rem; letter-spacing:.16em; text-transform:uppercase; background:#8c6b2e; color:#fffdf6; padding:.34rem .75rem; text-decoration:none; }
.mtb-badge.alt { background:transparent; color:#8c6b2e; border:1px solid rgba(140,107,46,.55); }
a.mtb-badge:hover { filter:brightness(1.12); }
.mtb-panel .mtb-summary { background:#f3ecd9; border:1px solid rgba(140,107,46,.25); padding:1rem 1.2rem; font-family:'Cormorant Garamond',Georgia,serif; font-size:1.1rem; line-height:1.6; margin-bottom:1.4rem; color:#33291a; }
.mtb-panel .mtb-summary > span { color:#33291a; }
.mtb-panel .mtb-summary .lbl { font-family:'Cormorant SC',Georgia,serif; font-size:.62rem; letter-spacing:.26em; color:#7c5f24; text-transform:uppercase; display:block; margin-bottom:.45rem; }
.mtb-insight { background:#fffdf6; border:1px solid rgba(140,107,46,.4); border-left:4px solid #8c6b2e; padding:1.15rem 1.3rem; margin-bottom:1.4rem; }
.mtb-insight-head { display:flex; flex-wrap:wrap; gap:.5rem .9rem; align-items:baseline; margin-bottom:.55rem; }
.mtb-panel .mtb-insight-title { font-family:'Cormorant SC',Georgia,serif; font-size:.72rem; letter-spacing:.22em; text-transform:uppercase; color:#7c5f24; }
.mtb-panel .mtb-insight-date { font-family:'Cormorant Garamond',Georgia,serif; font-size:1.02rem; color:#5d5142; }
.mtb-insight-list { list-style:none; margin:.4rem 0 .8rem; padding:0; }
.mtb-panel .mtb-insight-list li { padding:.42rem 0; border-bottom:1px dashed rgba(140,107,46,.25); font-family:'Cormorant Garamond',Georgia,serif; font-size:1.08rem; line-height:1.45; color:#33291a; }
.mtb-insight-list li:last-child { border-bottom:none; }
.mtb-panel .mtb-insight-list .k { font-family:'Cormorant SC',Georgia,serif; font-size:.62rem; letter-spacing:.18em; text-transform:uppercase; color:#7a6435; display:block; }
.mtb-panel .mtb-insight-list .h { color:#33291a; }
.mtb-panel .mtb-jev { display:inline-block; font-family:'Cormorant SC',Georgia,serif; font-size:.62rem; letter-spacing:.12em; background:#8c6b2e; color:#fffdf6; border-radius:999px; padding:.14rem .55rem; margin-left:.5rem; vertical-align:.18em; }
.mtb-pdfbtn { display:inline-block; font-family:'Cormorant SC',Georgia,serif; font-size:.68rem; letter-spacing:.18em; text-transform:uppercase; color:#fffdf6; background:#8c6b2e; padding:.55rem 1.05rem; text-decoration:none; font-weight:600; }
.mtb-pdfbtn:hover { filter:brightness(1.12); }
.mtb-joke { background:#fffdf6; border:1px solid rgba(140,107,46,.3); padding:1.25rem 1.35rem; margin-bottom:1.05rem; scroll-margin-top:1.5rem; }
.mtb-joke:target { border-color:#8c6b2e; box-shadow:0 0 0 3px rgba(194,165,88,.35); }
.mtb-joke .ctx { font-family:'Cormorant SC',Georgia,serif; font-size:.66rem; letter-spacing:.18em; text-transform:uppercase; color:#7c5f24; margin-bottom:.65rem; }
.mtb-joke img { display:block; max-height:180px; max-width:min(320px,100%); margin:0 auto .9rem; }
.mtb-joke .setup { font-family:'Cormorant Garamond',Georgia,serif; font-style:italic; font-size:1.06rem; line-height:1.55; color:#5d5142; margin:0 0 .55rem; }
.mtb-joke .punch { font-family:'Cormorant Garamond',Georgia,serif; font-weight:600; font-size:1.28rem; line-height:1.45; margin:0 0 .65rem; color:#2b2415; }
.mtb-joke .speaker { font-family:'Cormorant SC',Georgia,serif; font-size:.68rem; letter-spacing:.2em; text-transform:uppercase; color:#7c5f24; }
.mtb-joke .links { margin-top:.85rem; padding-top:.75rem; border-top:1px dashed rgba(140,107,46,.3); display:flex; flex-wrap:wrap; gap:.45rem 1.3rem; font-size:.92rem; font-family:'Cormorant Garamond',Georgia,serif; }
.mtb-joke .links a { color:#7c5f24; text-decoration:none; border-bottom:1px solid rgba(140,107,46,.5); }
.mtb-joke .links a:hover { color:#261f14; }
.mtb-joke .seg-label { color:#5d5142; font-size:.88rem; width:100%; }
.mtb-panel .mtb-dafhead { font-family:'Cormorant Garamond',Georgia,serif; font-weight:400; font-size:1.7rem; margin:1.8rem 0 .6rem; color:#261f14; }
.mtb-seg { padding:.95rem 1.1rem; border-left:3px solid transparent; border-bottom:1px solid rgba(140,107,46,.22); scroll-margin-top:1.5rem; }
.mtb-seg:target { animation:mtbSegFlash 1.8s ease; border-left-color:#8c6b2e; background:#fdf3d7; }
@keyframes mtbSegFlash { 0% { background:#f3d98b; } 100% { background:#fdf3d7; } }
.mtb-seg .ref { font-family:'Cormorant SC',Georgia,serif; font-size:.62rem; letter-spacing:.22em; text-transform:uppercase; color:#7a6435; margin-bottom:.4rem; }
.mtb-seg .he { font-family:'Frank Ruhl Libre','Noto Serif Hebrew',serif; direction:rtl; text-align:right; font-size:1.2rem; line-height:1.9; margin:0 0 .45rem; color:#2b2415; }
.mtb-seg .en { font-family:'Cormorant Garamond',Georgia,serif; font-size:1.04rem; line-height:1.55; color:#3d3423; margin:0; }
.mtb-seg .chips { margin-bottom:.55rem; display:flex; flex-wrap:wrap; gap:.4rem; }
.mtb-chip { font-family:'Cormorant SC',Georgia,serif; font-size:.62rem; letter-spacing:.14em; text-transform:uppercase; background:#8c6b2e; color:#fffdf6; padding:.3rem .65rem; text-decoration:none; }
.mtb-chip:hover { filter:brightness(1.12); }
/* ——— Sugya map (Jev) ——— */
.mtb-map { margin:0 0 1.2rem; }
.mtb-map-go { font-family:'Cormorant SC',Georgia,serif; font-size:.7rem; letter-spacing:.16em; text-transform:uppercase; color:#fffdf6; background:#8c6b2e; border:0; padding:.6rem 1.1rem; cursor:pointer; }
.mtb-map-go:disabled { opacity:.6; cursor:progress; }
.mtb-panel .mtb-map-note { font-family:'Cormorant Garamond',Georgia,serif; font-style:italic; font-size:1rem; color:#5d5142; margin:.5rem 0 0; }
.mtb-strip { display:flex; flex-wrap:wrap; gap:3px; margin:.2rem 0 .8rem; }
.mtb-strip a { display:block; width:18px; height:26px; border-radius:2px; }
.mtb-strip a.new { margin-left:10px; box-shadow:-5px 0 0 -3px #8c6b2e; }
.mtb-strip a.unsure { opacity:.45; }
.mtb-moves { display:flex; flex-wrap:wrap; gap:.4rem; margin-bottom:.9rem; }
.mtb-move { font-family:'Cormorant SC',Georgia,serif; font-size:.64rem; letter-spacing:.12em; text-transform:uppercase; background:#fffdf6; color:#33291a; border:1px solid rgba(140,107,46,.35); padding:.28rem .6rem; cursor:pointer; display:inline-flex; gap:.4rem; align-items:center; }
.mtb-move i { width:10px; height:10px; border-radius:2px; display:inline-block; }
.mtb-move.on { border-color:#261f14; box-shadow:0 0 0 1px #261f14; }
.mtb-outline { background:#f3ecd9; border:1px solid rgba(140,107,46,.25); padding:.8rem 1.1rem; margin:0; list-style:none; }
.mtb-panel .mtb-outline li { font-family:'Cormorant Garamond',Georgia,serif; font-size:1.02rem; line-height:1.45; color:#33291a; padding:.35rem 0; border-bottom:1px dashed rgba(140,107,46,.25); }
.mtb-outline li:last-child { border-bottom:none; }
.mtb-outline a { color:#7c5f24; text-decoration:none; font-family:'Cormorant SC',Georgia,serif; font-size:.68rem; letter-spacing:.14em; text-transform:uppercase; margin-right:.5rem; }
.mtb-panel .mtb-outline .flow { display:block; font-size:.9rem; color:#7a6435; }
.mtb-seg[data-move] { border-left-color:var(--mv); }
.mtb-panel .mtb-seg .mv { color:#fffdf6; background:var(--mv); padding:.1rem .45rem; margin-left:.5rem; letter-spacing:.12em; }
.mtb-segs-filtered .mtb-seg:not(.hit) { opacity:.28; }
.mtb-colors { background:#fffdf6; border:1px solid rgba(140,107,46,.35); padding:.8rem 1rem; margin:-.4rem 0 1rem; }
.mtb-colors label { font-family:'Cormorant Garamond',Georgia,serif; font-size:.98rem; color:#33291a; display:inline-flex; gap:.4rem; align-items:center; }
.mtb-colors .pal select { font-family:'Cormorant Garamond',Georgia,serif; font-size:1rem; background:#faf5ea; color:#261f14; border:1px solid rgba(140,107,46,.4); padding:.2rem .4rem; }
.mtb-colors .picks { display:flex; flex-wrap:wrap; gap:.5rem 1rem; margin:.7rem 0; }
.mtb-colors input[type=color] { width:28px; height:22px; padding:0; border:1px solid rgba(140,107,46,.4); background:none; cursor:pointer; }
.mtb-colors .reset { cursor:pointer; }
/* ——— Flow of the argument (masechet / seder / Shas) ——— */
.mtf-scope { display:flex; border:1px solid rgba(201,162,87,.4); }
.mtf-scope button { font-family:'Cormorant SC',Georgia,serif; font-size:.68rem; letter-spacing:.16em; text-transform:uppercase; color:#c9a257; background:transparent; border:0; padding:.55rem .9rem; cursor:pointer; }
.mtf-scope button.on { background:#c9a257; color:#0c0b09; }
.mtf-frame { position:relative; border:1px solid rgba(201,162,87,.45); background:#faf5ea; }
.mtf-frame canvas { display:block; width:100%; cursor:pointer; }
.mtf-tip { position:absolute; pointer-events:none; background:#261f14; color:#faf5ea; font-family:'Cormorant Garamond',Georgia,serif; font-size:.95rem; padding:.3rem .6rem; white-space:nowrap; transform:translate(-50%, -130%); }
.mtf-stats { display:flex; flex-wrap:wrap; gap:.4rem .9rem; margin-top:.8rem; font-family:'Cormorant Garamond',Georgia,serif; font-size:1rem; color:#8a7a5a; }
.mtf-stats i { display:inline-block; width:10px; height:10px; border-radius:2px; margin-right:.35rem; }
.mtb-panel .mtb-sugya { font-family:'Cormorant SC',Georgia,serif; font-size:.7rem; letter-spacing:.24em; text-transform:uppercase; color:#7c5f24; margin:1.4rem 0 .2rem; padding-top:.6rem; border-top:2px solid rgba(140,107,46,.45); }
.mtb-panel .mtb-foot { margin-top:1.6rem; font-family:'Cormorant Garamond',Georgia,serif; font-style:italic; color:#5d5142; font-size:.98rem; }
</style>

<style>
.mega-talmud {
  --bg:#0c0b09; --surface:#141210; --surface2:#1c1a15;
  --border:rgba(201,162,87,.15); --border-hi:rgba(201,162,87,.4);
  --text:#e8d4aa; --muted:#8a7a5a; --faint:#3a3020;
  --gold:#c9a257; --accent:#79b8a4;
  --heb:'Frank Ruhl Libre','Noto Serif Hebrew',serif;
  --display:'Cormorant Garamond',Georgia,serif;
  --sc:'Cormorant SC',Georgia,serif;
  background:var(--bg); color:var(--text); min-height:100vh;
  padding:3.5rem 1rem 5rem;
}
.wrap { max-width:900px; margin:0 auto; }
.kicker { font-family:var(--sc); font-size:.72rem; letter-spacing:.34em; color:var(--gold); text-transform:uppercase; }
h1 { font-family:var(--display); font-weight:300; font-size:clamp(2.6rem, 7vw, 4.2rem); line-height:1; margin:.6rem 0 1rem; color:var(--text); }
h1 em { font-style:italic; color:var(--gold); }
.lede { font-family:var(--display); font-size:clamp(1.1rem, 2.2vw, 1.3rem); color:var(--muted); line-height:1.55; max-width:42rem; margin:0 0 2.5rem; }
.section { margin-bottom:2.5rem; }
.section h2 { font-family:var(--sc); font-size:.8rem; letter-spacing:.26em; text-transform:uppercase; color:var(--gold); margin:0 0 1rem; font-weight:500; border-bottom:1px solid var(--border-hi); padding-bottom:.5rem; }
.card {
  background:var(--surface); border:1px solid var(--border-hi);
  padding:1.4rem; margin-bottom:1rem; color:inherit; text-decoration:none; display:block;
  transition:border-color .15s, transform .15s;
}
a.card:hover { border-color:var(--gold); transform:translateY(-2px); }
.card h3 { font-family:var(--display); font-weight:400; font-size:1.5rem; margin:0 0 .4rem; color:var(--text); }
.card p { font-family:var(--display); font-size:1.05rem; line-height:1.5; color:var(--muted); margin:0 0 .6rem; }
.card .meta { font-family:var(--sc); font-size:.65rem; letter-spacing:.2em; text-transform:uppercase; color:var(--faint); }
.card .he { font-family:var(--heb); direction:rtl; text-align:right; font-size:1.15rem; color:var(--text); margin:.6rem 0; line-height:1.8; }
.dl { display:inline-block; font-family:var(--sc); font-size:.7rem; letter-spacing:.2em; text-transform:uppercase; color:var(--bg); background:var(--gold); padding:.55rem 1.1rem; text-decoration:none; font-weight:600; margin-top:.4rem; }
.dl:hover { filter:brightness(1.1); }
.coming { font-family:var(--display); font-style:italic; color:var(--faint); font-size:1.1rem; }
</style>

<main class="mega-talmud">
  <div class="wrap">
    <div class="kicker">The Mega readers</div>
    <h1>Mega <em>Talmud</em></h1>
    <p class="lede">The daily daf, mined from every maggid shiur — the insights worth keeping, the highlights worth sharing, and one laugh a day.</p>

    <div class="section" id="browser">
      <h2>The Talmud browser</h2>
      <p class="mtb-intro">Every daf in Shas, pulled live from Sefaria. Where a day's learning left something behind — a Daily Reader insight, a Laf Yomi laugh sheet — it hangs on the daf itself, anchored to the sugya it belongs to.</p>
      <div class="mtb-controls">
        <label>Masechet
          <select id="mtb-tractate" aria-label="Tractate"></select>
        </label>
        <label>Daf
          <select id="mtb-daf" aria-label="Daf"></select>
        </label>
        <div class="mtb-nav">
          <button id="mtb-prev" type="button">← Prev</button>
          <button id="mtb-next" type="button">Next →</button>
        </div>
        <div class="mtb-amud" id="mtb-amud"></div>
      </div>
      <p class="mtb-legend">In the daf picker: 😂 marks a daf with a Laf Yomi sheet attached · 💡 marks one with a Daily Reader insight.</p>
      <div class="mtb-panel">
        <div class="mtb-status" id="mtb-status">Loading the daf…</div>
        <div id="mtb-attach"></div>
        <div id="mtb-jokes"></div>
        <h3 class="mtb-dafhead" id="mtb-dafhead"></h3>
        <div id="mtb-map" class="mtb-map"></div>
        <div id="mtb-segs"></div>
        <p class="mtb-foot">Talmud text: Sefaria (Steinsaltz), loaded live. Insights are the day's Daily Reader daf sections with their Jev scores; Laf Yomi jokes are mined verbatim from the day's shiur transcripts on alldaf.org, and their 🎧 links open the shiur audio at the moment the joke begins.</p>
      </div>
    </div>

    <div class="section" id="flow">
      <h2>The flow of the argument</h2>
      <p class="mtb-intro">Every segment of the Gemara, coloured by the move it makes: question, answer, verse, baraita, dispute, ruling, story. Each column is one daf, read top to bottom, and the gaps are where a new sugya begins. Jev mapped each segment once, ahead of time. Masechtot that haven't been mapped yet show as blank parchment. Tap any column to open that daf above.</p>
      <div class="mtb-controls mtf-controls">
        <div class="mtf-scope" role="tablist">
          <button type="button" data-scope="masechet" class="on">Masechet</button>
          <button type="button" data-scope="seder">Seder</button>
          <button type="button" data-scope="shas">Shas</button>
        </div>
        <label>Showing
          <select id="mtf-pick" aria-label="Masechet or seder"></select>
        </label>
        <div class="mtb-nav">
          <button type="button" id="mtf-png">Download PNG ↓</button>
        </div>
      </div>
      <div class="mtf-frame">
        <canvas id="mtf-canvas"></canvas>
        <div class="mtf-tip" id="mtf-tip" hidden></div>
      </div>
      <div class="mtf-stats" id="mtf-stats"></div>
    </div>

    <div class="section">
      <h2>Laf Yomi — the daily laugh sheet</h2>
      <div class="card">
        <h3>Laf Yomi · Bekhorot 34</h3>
        <p>The funniest moments from today's daf shiurim, collected and illustrated — a two-page PDF, fresh every morning. Or read it against the daf itself: every joke anchored to the sugya it riffs on, with a link to the moment in the shiur where it was told.</p>
        <a class="dl" href="/laf-yomi/laf-yomi-2026-10-22.pdf">Download today's PDF</a>
        <a class="dl" href="/laf-yomi/2026-10-22/" style="background:transparent; color:var(--gold); border:1px solid var(--border-hi); margin-left:.5rem">Read with the daf →</a>
        <div class="meta" style="margin-top:.6rem">October 22, 2026 · 2 pages</div>
      </div>
      <p class="coming">Yesterday's sheets archive here as the days pile up — and every sheet is in the browser above, on its daf.</p>
    </div>

    <div class="section">
      <h2>Insights &amp; highlights</h2>
      <div class="card">
        <h3>From today's shiurim</h3>
        <p>Key insights from Bornstein, Elefant, Rothstein and more — matched to source sheets, with new sheets proposed where the daf demands one.</p>
      </div>
      <p class="coming">The Daily Reader's per-daf insights live in the browser above — look for the 💡 on a daf.</p>
    </div>
  </div>
</main>

<script define:vars={{ ATTACH, STRUCTURE: structure, SUGYA }}>
  const DQ = /\u05D0[\u0591-\u05C7]*\u05DC[\u0591-\u05C7]*\u05D4[\u0591-\u05C7]*\u05D9[\u0591-\u05C7]*\u05DD/g;
  const dq = (t) => (typeof t === 'string' ? t.replace(DQ, (m) => m.replace('\u05D4', '\u05E7')) : t);
  const $ = (id) => document.getElementById(id);
  const els = { tr: $('mtb-tractate'), daf: $('mtb-daf'), prev: $('mtb-prev'), next: $('mtb-next'),
                amud: $('mtb-amud'), status: $('mtb-status'), attach: $('mtb-attach'),
                jokes: $('mtb-jokes'), head: $('mtb-dafhead'), segs: $('mtb-segs'), map: $('mtb-map') };
  const tract = (title) => STRUCTURE.find((t) => t.title === title);
  const refOf = (title, daf) => `${title} ${daf}`;
  const attachOf = (title, daf) => {
    const r = refOf(title, daf);
    return { laf: ATTACH.laf[r] || null, ins: ATTACH.insights[r] || null };
  };

  const params = new URLSearchParams(location.search);
  let cur = { title: 'Bekhorot', daf: 32 };
  if (params.get('tractate') && tract(params.get('tractate'))) {
    cur.title = params.get('tractate');
    const d = parseInt(params.get('daf'), 10);
    if (d >= 2 && d <= tract(cur.title).lastDaf) cur.daf = d;
  }

  function buildTractates() {
    const groups = new Map();
    for (const t of STRUCTURE) {
      if (!groups.has(t.seder)) groups.set(t.seder, []);
      groups.get(t.seder).push(t);
    }
    els.tr.innerHTML = '';
    for (const [seder, ts] of groups) {
      const og = document.createElement('optgroup');
      og.label = seder.replace('Seder ', '');
      for (const t of ts) {
        const o = document.createElement('option');
        o.value = t.title;
        o.textContent = t.heTitle ? `${t.title} · ${t.heTitle}` : t.title;
        og.appendChild(o);
      }
      els.tr.appendChild(og);
    }
    els.tr.value = cur.title;
  }

  function buildDafim() {
    const t = tract(cur.title);
    els.daf.innerHTML = '';
    for (let d = 2; d <= t.lastDaf; d++) {
      const { laf, ins } = attachOf(cur.title, d);
      const o = document.createElement('option');
      o.value = d;
      o.textContent = `${d}${d === t.lastDaf && t.lastAmud === 'a' ? ' (a only)' : ''}${laf ? ' 😂' : ''}${ins ? ' 💡' : ''}`;
      els.daf.appendChild(o);
    }
    els.daf.value = cur.daf;
    els.prev.disabled = cur.daf <= 2;
    els.next.disabled = cur.daf >= t.lastDaf;
  }

  function segJokesMap(laf) {
    const m = {};
    (laf ? laf.jokes : []).forEach((j, i) => {
      (j.seg_refs || []).forEach((n) => { (m[n] = m[n] || []).push(i); });
    });
    return m;
  }

  function renderInsight(ins) {
    if (!ins) return '';
    const items = ins.sections.map((s) => {
      const pill = typeof s.score === 'number'
        ? `<span class="mtb-jev" title="${(s.score_note || '').replace(/"/g, '&quot;')}">Jev ${s.score.toFixed(2)}</span>` : '';
      return `<li><span class="k"></span><span class="h"></span>${pill}</li>`;
    });
    const wrap = document.createElement('aside');
    wrap.className = 'mtb-insight';
    wrap.innerHTML = `
      <div class="mtb-insight-head">
        <span class="mtb-insight-title">💡 Daf insight</span>
        <span class="mtb-insight-date">From the Daily Reader · ${ins.date_str}${ins.parsha ? ` · Parshat ${ins.parsha}` : ''}</span>
      </div>
      <ul class="mtb-insight-list">${items.join('')}</ul>
      ${ins.pdf ? `<a class="mtb-pdfbtn" href="${ins.pdf}">Open that day's Daily Reader (PDF) ↓</a>` : ''}`;
    wrap.querySelectorAll('.mtb-insight-list li').forEach((li, i) => {
      li.querySelector('.k').textContent = ins.sections[i].kicker || '';
      li.querySelector('.h').textContent = ins.sections[i].heading || '';
    });
    return wrap;
  }

  function renderJokes(laf, ref) {
    els.jokes.innerHTML = '';
    if (!laf) return;
    if (laf.daf_summary) {
      const sum = document.createElement('div');
      sum.className = 'mtb-summary';
      sum.innerHTML = '<span class="lbl">On this daf — Laf Yomi</span>';
      const body = document.createElement('span');
      body.textContent = laf.daf_summary;
      sum.appendChild(body);
      els.jokes.appendChild(sum);
    }
    const h = document.createElement('h3');
    h.className = 'mtb-dafhead';
    h.style.marginTop = '0.4rem';
    h.textContent = `The jokes — Laf Yomi · ${ref}`;
    els.jokes.appendChild(h);
    laf.jokes.forEach((j, i) => {
      const art = document.createElement('article');
      art.className = 'mtb-joke';
      art.id = `mtb-joke-${i + 1}`;
      art.innerHTML = `
        ${j.context ? `<div class="ctx"></div>` : ''}
        ${j.img ? `<img src="${j.img}" alt="" loading="lazy" />` : ''}
        <p class="setup"><span style="font-style:normal; color:#8c6b2e">${i + 1}.</span> <span class="setup-t"></span></p>
        <p class="punch"></p>
        <div class="speaker"></div>
        <div class="links">
          ${j.seg_refs && j.seg_refs.length ? `<a href="#mtb-seg-${j.seg_refs[0]}">📖 In the daf — ${ref} ${j.seg_amud || ''}</a>` : ''}
          ${j.shiur_audio_ts ? `<a href="${j.shiur_audio_ts}" target="_blank" rel="noopener">🎧 Hear it in the shiur — ${j.shiur_speaker || ''} · ${j.ts || ''}</a>` : ''}
          ${j.shiur_page ? `<a href="${j.shiur_page}" target="_blank" rel="noopener">Shiur page ↗</a>` : ''}
          ${j.seg_label ? `<span class="seg-label"></span>` : ''}
        </div>`;
      if (j.context) art.querySelector('.ctx').textContent = j.context;
      art.querySelector('.setup-t').textContent = j.setup || '';
      art.querySelector('.punch').textContent = j.punchline || '';
      art.querySelector('.speaker').textContent = j.speaker ? `— ${j.speaker}` : '';
      const lbl = art.querySelector('.seg-label');
      if (lbl) lbl.textContent = j.seg_label;
      els.jokes.appendChild(art);
    });
  }

  // ——— Sugya map: Jev labels each segment's move and where a new sugya opens ———
  // Questions, labels and palettes live in src/lib/sugya.js. Colours: a palette plus per-move
  // overrides, saved in localStorage and shared with /mega-talmud/flow.
  const { PALETTES, MOVE_ORDER, MOVE_LABELS, COLOR_KEY, MIN_SURE, NEW_SUGYA } = SUGYA;
  const MOVES = {};
  let colorPrefs = { palette: 'classic', custom: {} };
  try { colorPrefs = { ...colorPrefs, ...JSON.parse(localStorage.getItem(COLOR_KEY) || '{}') }; } catch {}
  function setColors() {
    const pal = (PALETTES[colorPrefs.palette] || PALETTES.classic).colors;
    MOVE_ORDER.forEach((k, i) => { MOVES[k] = [MOVE_LABELS[k], colorPrefs.custom[k] || pal[i]]; });
  }
  setColors();
  const MAP_API = '/api/mega-talmud-jev';
  const MAP_BATCH = 12;
  const mapKey = (ref) => `mtb-map:v1:${ref}`;
  const plain = (el) => (el ? el.textContent.replace(/\s+/g, ' ').trim() : '');
  const escH = (s) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const tslug = (t) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-');

  // Masechtot mapped ahead of time by scripts/talmud/sugya-map.mjs.
  let mappedIndex = null;
  const masechetMaps = {};
  async function premapped(title, daf) {
    try {
      mappedIndex = mappedIndex || await fetch('/data/sugya-maps/index.json').then((r) => (r.ok ? r.json() : []));
      if (!mappedIndex.some((m) => m.tractate === title)) return null;
      const slug = tslug(title);
      masechetMaps[slug] = masechetMaps[slug] || fetch(`/data/sugya-maps/${slug}.json`).then((r) => r.json());
      const d = (await masechetMaps[slug]).dafim[daf];
      return d ? d.s.map(([move, conf, newSugya]) => ({ move, conf, newSugya })) : null;
    } catch { return null; }
  }

  let currentMap = null;
  async function renderMapButton(ref) {
    let saved = null;
    try { saved = JSON.parse(localStorage.getItem(mapKey(ref)) || 'null'); } catch {}
    saved = (await premapped(cur.title, cur.daf)) || saved;
    if (refOf(cur.title, cur.daf) !== ref) return;
    if (saved) { applyMap(saved); return; }
    els.map.innerHTML = `<button type="button" class="mtb-map-go">🧭 Map the argument with Jev</button>
      <p class="mtb-map-note">Labels every segment (question, answer, verse, baraita, dispute, ruling, story…) and marks where each sugya begins.</p>`;
    const btn = els.map.querySelector('button');
    btn.addEventListener('click', () => mapDaf(ref, btn));
  }

  async function mapDaf(ref, btn) {
    const segs = [...els.segs.querySelectorAll('.mtb-seg')];
    const payload = segs.map((s, i) => ({
      previous: i ? plain(segs[i - 1].querySelector('.en')) : '',
      hebrew: plain(s.querySelector('.he')), english: plain(s.querySelector('.en')),
    }));
    const results = new Array(payload.length);
    let done = 0;
    btn.disabled = true;
    btn.textContent = `Mapping… 0/${payload.length}`;
    const batches = [];
    for (let i = 0; i < payload.length; i += MAP_BATCH) batches.push(i);
    try {
      let next = 0;
      await Promise.all([0, 1, 2].map(async () => {
        while (next < batches.length) {
          const start = batches[next++];
          const res = await fetch(MAP_API, { method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ daf: ref, segments: payload.slice(start, start + MAP_BATCH) }) });
          if (!res.ok) throw new Error(`Jev returned ${res.status}`);
          const { results: r } = await res.json();
          r.forEach((x, k) => { results[start + k] = x; });
          done += r.length;
          btn.textContent = `Mapping… ${done}/${payload.length}`;
        }
      }));
    } catch (e) {
      btn.disabled = false;
      btn.textContent = '🧭 Try mapping again';
      return;
    }
    if (refOf(cur.title, cur.daf) !== ref) return;   // the reader moved on while Jev worked
    const map = results.map((r) => (r && !r.error ? { move: r.move, conf: r.confidence, newSugya: r.newSugya } : null));
    try { localStorage.setItem(mapKey(ref), JSON.stringify(map)); } catch {}
    applyMap(map);
  }

  function applyMap(map) {
    const segs = [...els.segs.querySelectorAll('.mtb-seg')];
    if (map.length !== segs.length) {
      // Sefaria re-segmented this daf since it was mapped: fall back to mapping it live.
      localStorage.removeItem(mapKey(refOf(cur.title, cur.daf)));
      els.map.innerHTML = `<button type="button" class="mtb-map-go">🧭 Map the argument with Jev</button>`;
      const btn = els.map.querySelector('button');
      btn.addEventListener('click', () => mapDaf(refOf(cur.title, cur.daf), btn));
      return;
    }
    currentMap = map;
    els.segs.querySelectorAll('.mtb-sugya').forEach((h) => h.remove());
    const sugyot = [];
    segs.forEach((s, i) => {
      const m = map[i];
      if (!m || !MOVES[m.move]) return;
      const [label, color] = MOVES[m.move];
      s.dataset.move = m.move;
      s.style.setProperty('--mv', color);
      const refEl = s.querySelector('.ref');
      refEl.querySelector('.mv')?.remove();
      refEl.insertAdjacentHTML('beforeend', `<span class="mv" title="Jev confidence ${m.conf.toFixed(2)}">${label}${m.conf < MIN_SURE ? '?' : ''}</span>`);
      if (i === 0 || m.newSugya >= NEW_SUGYA) {
        sugyot.push({ start: i, moves: [] });
        s.insertAdjacentHTML('beforebegin', `<div class="mtb-sugya">Sugya ${sugyot.length}</div>`);
      }
      sugyot[sugyot.length - 1]?.moves.push(m.move);
    });

    const counts = {};
    map.forEach((m) => { if (m && MOVES[m.move]) counts[m.move] = (counts[m.move] || 0) + 1; });
    const strip = map.map((m, i) => {
      if (!m || !MOVES[m.move]) return `<a href="#mtb-seg-${i}" style="background:#ddd"></a>`;
      const [label, color] = MOVES[m.move];
      const cls = [i > 0 && m.newSugya >= NEW_SUGYA ? 'new' : '', m.conf < MIN_SURE ? 'unsure' : ''].join(' ');
      return `<a href="#mtb-seg-${i}" class="${cls}" style="background:${color}" title="Segment ${i + 1}: ${label}"></a>`;
    }).join('');
    const legend = Object.entries(MOVES).filter(([k]) => counts[k]).map(([k, [label, color]]) =>
      `<button type="button" class="mtb-move" data-move="${k}"><i style="background:${color}"></i>${label} · ${counts[k]}</button>`).join('');
    // Collapse runs ("question, question, answer" → "Question ×2 → Answer") for the outline.
    const flow = (moves) => {
      const runs = [];
      for (const mv of moves) { const last = runs[runs.length - 1]; if (last && last[0] === mv) last[1]++; else runs.push([mv, 1]); }
      return runs.map(([mv, n]) => MOVES[mv][0] + (n > 1 ? ` ×${n}` : '')).join(' → ');
    };
    const outline = sugyot.map((g, k) => {
      const opener = plain(segs[g.start].querySelector('.en'));
      return `<li><a href="#mtb-seg-${g.start}">Sugya ${k + 1}</a>${escH(opener.length > 140 ? opener.slice(0, 140).replace(/\s+\S*$/, '') + ' …' : opener)}
        <span class="flow">${escH(flow(g.moves))}</span></li>`;
    }).join('');

    const flowLink = mappedIndex?.some((m) => m.tractate === cur.title)
      ? `<a class="mtb-badge" href="#flow">🎨 The flow of all of ${escH(cur.title)}</a>` : '';
    const palOpts = Object.entries(PALETTES).map(([k, p]) =>
      `<option value="${k}"${k === colorPrefs.palette ? ' selected' : ''}>${escH(p.name)}</option>`).join('');
    const pickers = MOVE_ORDER.map((k) =>
      `<label><input type="color" data-move="${k}" value="${MOVES[k][1]}">${MOVE_LABELS[k]}</label>`).join('');
    els.map.innerHTML = `<div class="mtb-strip">${strip}</div><div class="mtb-moves">${legend}</div>
      <div class="mtb-badges">${flowLink}<button type="button" class="mtb-badge alt mtb-colors-toggle">🎨 Colours</button></div>
      <div class="mtb-colors" hidden>
        <label class="pal">Palette <select>${palOpts}</select></label>
        <div class="picks">${pickers}</div>
        <button type="button" class="mtb-badge alt reset">Reset to palette</button>
      </div>
      <ol class="mtb-outline">${outline}</ol>
      <p class="mtb-map-note">Mapped by Jev, one segment at a time. A “?” or faded block means Jev was unsure. Tap a move to pick out every segment that makes it.</p>`;
    const panel = els.map.querySelector('.mtb-colors');
    const saveColors = () => {
      try { localStorage.setItem(COLOR_KEY, JSON.stringify(colorPrefs)); } catch {}
      setColors(); applyMap(currentMap); drawFlow();
      els.map.querySelector('.mtb-colors').hidden = false;
    };
    els.map.querySelector('.mtb-colors-toggle').addEventListener('click', () => { panel.hidden = !panel.hidden; });
    panel.querySelector('select').addEventListener('change', (e) => { colorPrefs = { palette: e.target.value, custom: {} }; saveColors(); });
    panel.querySelectorAll('input[type=color]').forEach((inp) => inp.addEventListener('change', () => {
      colorPrefs.custom[inp.dataset.move] = inp.value; saveColors();
    }));
    panel.querySelector('.reset').addEventListener('click', () => { colorPrefs.custom = {}; saveColors(); });
    els.map.querySelectorAll('.mtb-move').forEach((b) => b.addEventListener('click', () => {
      const on = !b.classList.contains('on');
      els.map.querySelectorAll('.mtb-move').forEach((x) => x.classList.remove('on'));
      els.segs.classList.toggle('mtb-segs-filtered', on);
      segs.forEach((s) => s.classList.toggle('hit', on && s.dataset.move === b.dataset.move));
      if (on) { b.classList.add('on'); els.segs.querySelector('.hit')?.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
    }));
  }

  async function load() {
    const { laf, ins } = attachOf(cur.title, cur.daf);
    const ref = refOf(cur.title, cur.daf);
    els.status.className = 'mtb-status';
    els.status.textContent = `Loading ${ref}…`;
    els.attach.innerHTML = ''; els.jokes.innerHTML = ''; els.segs.innerHTML = ''; els.map.innerHTML = '';
    els.segs.classList.remove('mtb-segs-filtered');
    els.head.textContent = ''; els.amud.innerHTML = '';
    const badges = [];
    if (ins) badges.push('<a class="mtb-badge" href="#mtb-insight-panel">💡 Daily Reader insight</a>');
    if (laf) badges.push(`<a class="mtb-badge" href="#mtb-joke-1">😂 Laf Yomi — ${laf.jokes.length} jokes</a>`);
    if (laf && laf.pdf) badges.push(`<a class="mtb-badge alt" href="${laf.pdf}">Laf Yomi PDF ↓</a>`);
    els.attach.innerHTML = badges.length ? `<div class="mtb-badges">${badges.join('')}</div>` : '';
    if (ins) {
      const panel = renderInsight(ins);
      panel.id = 'mtb-insight-panel';
      els.attach.appendChild(panel);
    }
    renderJokes(laf, ref);
    try {
      const url = `https://www.sefaria.org/api/texts/${cur.title.replace(/ /g, '_')}.${cur.daf}?lang=bi&context=0`;
      const res = await fetch(url);
      if (!res.ok) throw new Error(`Sefaria returned ${res.status}`);
      const d = await res.json();
      // A daf that is only amud a (the last daf of some masechtot) comes back flat, not per amud.
      const flat = typeof (d.he || [])[0] === 'string';
      const heParts = flat ? [d.he] : d.he || [], enParts = flat ? [d.text || []] : d.text || [];
      const bySeg = segJokesMap(laf);
      const frag = document.createDocumentFragment();
      const amudim = new Set();
      let n = 0;
      heParts.forEach((hePart, pi) => {
        const enPart = enParts[pi] || [];
        const amud = `${cur.daf}${pi === 0 ? 'a' : pi === 1 ? 'b' : pi}`;
        const count = Math.min((hePart || []).length, enPart.length);
        for (let i = 0; i < count; i++) {
          amudim.add(amud);
          const sec = document.createElement('section');
          sec.className = 'mtb-seg';
          sec.id = `mtb-seg-${n}`;
          sec.dataset.amud = amud;
          const chips = (bySeg[n] || []).map((ji) =>
            `<a class="mtb-chip" href="#mtb-joke-${ji + 1}">😂 Joke ${ji + 1} is on this</a>`).join('');
          sec.innerHTML = `
            <div class="ref">${ref} ${amud} · segment ${n + 1}</div>
            ${chips ? `<div class="chips">${chips}</div>` : ''}
            <p class="he"></p>
            <p class="en"></p>`;
          sec.querySelector('.he').innerHTML = dq(hePart[i]);
          sec.querySelector('.en').innerHTML = enParts[pi][i];
          frag.appendChild(sec);
          n++;
        }
      });
      els.segs.appendChild(frag);
      els.head.textContent = `The daf — ${ref} (Sefaria)`;
      els.status.textContent = n ? '' : 'No text came back from Sefaria for this daf.';
      if (n) renderMapButton(ref);
      for (const a of amudim) {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = a;
        b.addEventListener('click', () => {
          const target = els.segs.querySelector(`[data-amud="${a}"]`);
          if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
        els.amud.appendChild(b);
      }
    } catch (e) {
      els.status.className = 'mtb-status err';
      els.status.textContent = `Could not load ${ref} from Sefaria — check your connection and try another daf.`;
    }
    const p = new URLSearchParams(location.search);
    p.set('tractate', cur.title); p.set('daf', cur.daf);
    history.replaceState(null, '', `${location.pathname}?${p.toString()}`);
  }

  // ——— The flow of the argument: masechet / seder / Shas, drawn from the premapped data ———
  const fl = { canvas: $('mtf-canvas'), tip: $('mtf-tip'), pick: $('mtf-pick'), stats: $('mtf-stats'),
               scope: 'masechet', masechet: null, seder: null, hits: [] };
  const SEDARIM = [...new Set(STRUCTURE.map((t) => t.seder))];
  const PARCH = '#faf5ea', INK = '#261f14', GOLD = '#8c6b2e';

  async function loadMasechet(title) {
    mappedIndex = mappedIndex || await fetch('/data/sugya-maps/index.json').then((r) => (r.ok ? r.json() : [])).catch(() => []);
    if (!mappedIndex.some((m) => m.tractate === title)) return null;
    const slug = tslug(title);
    masechetMaps[slug] = masechetMaps[slug] || fetch(`/data/sugya-maps/${slug}.json`).then((r) => r.json());
    return masechetMaps[slug];
  }

  function buildFlowPicker() {
    const mapped = new Set((mappedIndex || []).map((m) => m.tractate));
    if (fl.scope === 'masechet') {
      fl.pick.innerHTML = STRUCTURE.map((t) => `<option value="${escH(t.title)}">${escH(t.title)}${mapped.has(t.title) ? ' ✓' : ''}</option>`).join('');
      fl.pick.value = fl.masechet;
    } else if (fl.scope === 'seder') {
      fl.pick.innerHTML = SEDARIM.map((s) => `<option value="${escH(s)}">${escH(s)}</option>`).join('');
      fl.pick.value = fl.seder;
    }
    fl.pick.parentElement.style.display = fl.scope === 'shas' ? 'none' : '';
  }

  let flowToken = 0;
  async function drawFlow() {
    if (!fl.canvas) return;
    const token = ++flowToken;
    const tractates = fl.scope === 'masechet' ? [tract(fl.masechet)]
      : fl.scope === 'seder' ? STRUCTURE.filter((t) => t.seder === fl.seder) : STRUCTURE;
    const maps = await Promise.all(tractates.map((t) => loadMasechet(t.title)));
    if (token !== flowToken) return;
    buildFlowPicker();

    const W = fl.canvas.parentElement.clientWidth;
    const big = fl.scope === 'masechet';
    const labelW = big ? 0 : Math.min(150, W * 0.22);
    const pad = 18, headH = 64, footH = 64;
    const rowH = big ? 420 : fl.scope === 'seder' ? Math.max(48, Math.min(140, 760 / tractates.length)) : 26;
    const rowGap = big ? 0 : fl.scope === 'seder' ? 10 : 4;
    const sederGap = fl.scope === 'shas' ? 18 : 0;
    const dafLabelH = big ? 22 : 0;
    let H = headH + footH + dafLabelH;
    tractates.forEach((t, i) => { H += rowH + rowGap + (i && t.seder !== tractates[i - 1].seder ? sederGap : 0); });

    const scale = Math.max(2, window.devicePixelRatio || 1);
    const c = fl.canvas;
    c.width = Math.round(W * scale); c.height = Math.round(H * scale);
    c.style.height = `${H}px`;
    const g = c.getContext('2d');
    g.setTransform(scale, 0, 0, scale, 0, 0);
    g.fillStyle = PARCH; g.fillRect(0, 0, W, H);

    // Title
    const title = big ? `${tractates[0].title}` : fl.scope === 'seder' ? fl.seder : 'Talmud Bavli';
    const heTitle = big ? tractates[0].heTitle : fl.scope === 'seder' ? '' : 'תלמוד בבלי';
    g.fillStyle = INK; g.textBaseline = 'alphabetic';
    g.font = '400 26px "Cormorant Garamond", Georgia, serif';
    g.fillText(title, pad, 36);
    if (heTitle) { g.font = '500 24px "Frank Ruhl Libre", serif'; g.textAlign = 'right'; g.fillText(heTitle, W - pad, 36); g.textAlign = 'left'; }
    g.font = '600 10px "Cormorant SC", Georgia, serif'; g.fillStyle = GOLD;
    g.fillText('THE FLOW OF THE ARGUMENT · MAPPED BY JEV', pad, 54);

    const counts = {};
    let segTotal = 0, dafMapped = 0, dafTotal = 0, sugyot = 0;
    fl.hits = [];
    let y = headH;
    tractates.forEach((t, ti) => {
      if (ti && t.seder !== tractates[ti - 1].seder) y += sederGap;
      const data = maps[ti];
      const x0 = pad + labelW, x1 = W - pad;
      const dafim = t.lastDaf - 1;
      const step = (x1 - x0) / dafim;
      const colGap = step >= 4 ? 1 : 0;
      if (labelW) {
        g.fillStyle = data ? INK : 'rgba(38,31,20,.4)';
        g.font = `${fl.scope === 'shas' ? 13 : 15}px "Cormorant Garamond", Georgia, serif`;
        g.fillText(t.title, pad, y + Math.min(rowH / 2 + 5, 20));
        if (fl.scope === 'seder' && rowH >= 40) { g.font = '15px "Frank Ruhl Libre", serif'; g.fillText(t.heTitle || '', pad, y + 38); }
      }
      for (let d = 2; d <= t.lastDaf; d++) {
        dafTotal++;
        const x = x0 + (d - 2) * step, w = Math.max(0.6, step - colGap);
        const entry = data && data.dafim[d];
        if (!entry) { g.fillStyle = 'rgba(140,107,46,.09)'; g.fillRect(x, y, w, rowH); continue; }
        dafMapped++;
        const n = entry.s.length, sh = rowH / n;
        entry.s.forEach(([move, conf, ns], k) => {
          const mv = MOVES[move];
          counts[move] = (counts[move] || 0) + 1; segTotal++;
          g.globalAlpha = conf < MIN_SURE ? 0.45 : 1;
          g.fillStyle = mv ? mv[1] : '#ccc';
          g.fillRect(x, y + k * sh, w, sh + 0.3);
          g.globalAlpha = 1;
          if (ns >= NEW_SUGYA) {
            sugyot++;
            if (k && sh >= 2) { g.fillStyle = PARCH; g.fillRect(x, y + k * sh, w, Math.min(3, Math.max(1, sh * 0.3))); }
          }
        });
        if (big && entry.a && entry.a < n) {   // amud break: a small gold tick on the left edge
          g.fillStyle = GOLD; g.fillRect(x - 1, y + entry.a * sh - 0.5, 3, 1.5);
        }
      }
      if (big) {
        g.fillStyle = 'rgba(38,31,20,.6)'; g.font = '11px "Cormorant Garamond", Georgia, serif'; g.textAlign = 'center';
        for (let d = 2; d <= t.lastDaf; d++) if (d === 2 || d % 5 === 0 || d === t.lastDaf) g.fillText(String(d), x0 + (d - 1.5) * step, y + rowH + 15);
        g.textAlign = 'left';
      }
      fl.hits.push({ t, data, x0, step, y, h: rowH });
      y += rowH + rowGap;
    });

    // Legend
    y += dafLabelH + 18;
    g.font = '13px "Cormorant Garamond", Georgia, serif';
    let lx = pad;
    MOVE_ORDER.forEach((k) => {
      const label = `${MOVES[k][0]}`;
      const wTxt = g.measureText(label).width;
      if (lx + 16 + wTxt > W - pad) { lx = pad; y += 18; }
      g.fillStyle = MOVES[k][1]; g.fillRect(lx, y - 9, 10, 10);
      g.fillStyle = INK; g.fillText(label, lx + 14, y);
      lx += 14 + wTxt + 16;
    });

    const pct = (k) => (segTotal ? Math.round((100 * (counts[k] || 0)) / segTotal) : 0);
    fl.stats.innerHTML = `<span>${dafMapped} of ${dafTotal} dafim mapped · ${segTotal.toLocaleString()} segments · ${sugyot.toLocaleString()} sugyot</span>`
      + (segTotal ? MOVE_ORDER.filter((k) => counts[k]).map((k) => `<span><i style="background:${MOVES[k][1]}"></i>${MOVE_LABELS[k]} ${pct(k)}%</span>`).join('') : '');
  }

  function flowHit(ev) {
    const r = fl.canvas.getBoundingClientRect();
    const x = ev.clientX - r.left, y = ev.clientY - r.top;
    const row = fl.hits.find((h) => y >= h.y && y < h.y + h.h && x >= h.x0);
    if (!row) return null;
    const daf = 2 + Math.floor((x - row.x0) / row.step);
    if (daf > row.t.lastDaf) return null;
    const entry = row.data && row.data.dafim[daf];
    const seg = entry ? Math.min(entry.s.length - 1, Math.floor(((y - row.y) / row.h) * entry.s.length)) : null;
    return { t: row.t, daf, entry, seg, x, y };
  }
  if (fl.canvas) {
    fl.canvas.addEventListener('mousemove', (ev) => {
      const h = flowHit(ev);
      if (!h) { fl.tip.hidden = true; return; }
      const what = h.entry ? `segment ${h.seg + 1} · ${MOVES[h.entry.s[h.seg][0]]?.[0] || ''}` : 'not mapped yet';
      fl.tip.textContent = `${h.t.title} ${h.daf} · ${what}`;
      fl.tip.style.left = `${h.x}px`; fl.tip.style.top = `${h.y}px`; fl.tip.hidden = false;
    });
    fl.canvas.addEventListener('mouseleave', () => { fl.tip.hidden = true; });
    fl.canvas.addEventListener('click', async (ev) => {
      const h = flowHit(ev);
      if (!h) return;
      cur.title = h.t.title; cur.daf = h.daf; els.tr.value = cur.title;
      buildDafim();
      $('browser').scrollIntoView({ behavior: 'smooth', block: 'start' });
      await load();
      if (h.seg != null) setTimeout(() => $(`mtb-seg-${h.seg}`)?.scrollIntoView({ behavior: 'smooth', block: 'center' }), 300);
    });
    document.querySelectorAll('.mtf-scope button').forEach((b) => b.addEventListener('click', () => {
      fl.scope = b.dataset.scope;
      document.querySelectorAll('.mtf-scope button').forEach((x) => x.classList.toggle('on', x === b));
      drawFlow();
    }));
    fl.pick.addEventListener('change', () => {
      if (fl.scope === 'masechet') fl.masechet = fl.pick.value; else fl.seder = fl.pick.value;
      drawFlow();
    });
    $('mtf-png').addEventListener('click', () => {
      const a = document.createElement('a');
      const name = fl.scope === 'masechet' ? fl.masechet : fl.scope === 'seder' ? fl.seder : 'Shas';
      a.download = `sugya-flow-${tslug(name)}.png`;
      a.href = fl.canvas.toDataURL('image/png');
      a.click();
    });
    let rz;
    window.addEventListener('resize', () => { clearTimeout(rz); rz = setTimeout(drawFlow, 200); });
  }

  els.tr.addEventListener('change', () => {
    cur.title = els.tr.value; cur.daf = 2; buildDafim(); load();
    if (fl.scope === 'masechet') { fl.masechet = cur.title; drawFlow(); }
  });
  els.daf.addEventListener('change', () => { cur.daf = parseInt(els.daf.value, 10); buildDafim(); load(); });
  els.prev.addEventListener('click', () => { if (cur.daf > 2) { cur.daf--; buildDafim(); load(); } });
  els.next.addEventListener('click', () => { if (cur.daf < tract(cur.title).lastDaf) { cur.daf++; buildDafim(); load(); } });

  buildTractates();
  buildDafim();
  load();
  fl.masechet = cur.title; fl.seder = tract(cur.title).seder;
  (document.fonts ? document.fonts.ready : Promise.resolve()).then(drawFlow);
</script>
</Layout>
