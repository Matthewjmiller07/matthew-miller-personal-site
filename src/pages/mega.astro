---
import Layout from '../layouts/Layout.astro';
import mishnahToc from '../data/mega-mishnah/toc.json';

const mishnayot = mishnahToc.sedarim.reduce((a, s) => a + s.tractates.reduce((b, t) => b + t.chapters.reduce((x, y) => x + y, 0), 0), 0);

// The Mega readers: one per shelf of the Jewish library, each a single page
// that pulls Sefaria's text and layers everything else on top.
const megas = [
  {
    slug: 'mega-bible',
    name: 'Mega Bible',
    he: 'תנ״ך',
    shelf: 'Written Torah',
    tagline: 'The whole Hebrew Bible in one reader — every word parsed, every literary device marked.',
    features: [
      'Word-by-word morphology and lemmas from the OSHB, coloured by part of speech',
      'Literary devices highlighted and navigable, verse by verse',
      'Biblical → Modern Hebrew: where a verse lives on in Israeli usage, with National Library evidence',
      'Haftarot by rite, parasha mode, any Sefaria translation side by side',
      '929 chapter audio where it exists',
      'Parasha sheets: two-page study sheets with counts, once-in-Tanakh words and Modern Hebrew notes, opened from the passage they cover',
    ],
    stats: [['24', 'books'], ['929', 'chapters'], ['54', 'parashot']],
  },
  {
    slug: 'mega-mishnah',
    name: 'Mega Mishnah',
    he: 'משנה',
    shelf: 'Oral Torah',
    tagline: 'All six orders in one place, with every Tanna colour-coded so you can see who is arguing with whom.',
    features: [
      'Vocalised Hebrew and English for all 63 tractates',
      'Voices layer: each sage underlined in their own colour, with a per-perek tally you can filter by',
      'Bavli, Yerushalmi and Tosefta badges on every mishnah',
      'Bartenura, Rambam, Tosafot Yom Tov, Tiferet Yisrael and more in the side panel',
      'Mishnah Yomit, plus progress toward a siyum, kept in your browser',
    ],
    stats: [['6', 'sedarim'], ['63', 'masechtot'], [mishnayot.toLocaleString('en-US'), 'mishnayot']],
  },
  {
    slug: 'mega-siddur',
    name: 'Mega Siddur',
    he: 'סדור',
    shelf: 'Prayer',
    tagline: 'A working siddur that knows what day it is, and a commentary layer that keeps growing.',
    features: [
      'Ashkenaz, Sefard and Edot HaMizrach in full',
      'Today strip: rain and dew, Ya’aleh VeYavo, Al HaNisim, Hallel, Tachanun, Omer, fasts',
      'A Now button that opens the right service for local sunrise and sunset',
      'Sefaria’s linked sources on every paragraph, plus a personal commentary layer',
      'Davening mode, night and parchment themes, works offline once opened',
    ],
    stats: [['3', 'nusachim'], ['7', 'services']],
  },
];
---

<Layout
  title="Mega — Bible, Mishnah, Siddur"
  description="The Mega readers: Mega Bible, Mega Mishnah and Mega Siddur — single-page readers for Tanakh, Mishnah and the siddur, built on Sefaria and layered with morphology, sages, commentary and daily learning."
>

<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Cormorant+SC:wght@400;500;600&family=Frank+Ruhl+Libre:wght@400;500;700&display=swap');
body:has(.mega-hub) { background:#0c0b09 !important; }
</style>

<style>
.mega-hub {
  --bg:#0c0b09; --surface:#141210; --surface2:#1c1a15;
  --border:rgba(201,162,87,.15); --border-hi:rgba(201,162,87,.4);
  --text:#e8d4aa; --muted:#8a7a5a; --faint:#3a3020;
  --gold:#c9a257; --accent:#79b8a4;
  --heb:'Frank Ruhl Libre','Noto Serif Hebrew',serif;
  --display:'Cormorant Garamond',Georgia,serif;
  --sc:'Cormorant SC',Georgia,serif;
  background:var(--bg); color:var(--text); min-height:100vh;
  padding:3.5rem 1rem 5rem;
}
.wrap { max-width:1180px; margin:0 auto; }
.kicker { font-family:var(--sc); font-size:.72rem; letter-spacing:.34em; color:var(--gold); text-transform:uppercase; }
h1 { font-family:var(--display); font-weight:300; font-size:clamp(2.6rem, 7vw, 4.6rem); line-height:1; margin:.6rem 0 1rem; color:var(--text); }
h1 em { font-style:italic; color:var(--gold); }
.lede { font-family:var(--display); font-size:clamp(1.1rem, 2.2vw, 1.35rem); color:var(--muted); line-height:1.55; max-width:44rem; margin:0; }
.shelf { display:flex; gap:0; margin:2.4rem 0 2rem; border-top:1px solid var(--border-hi); border-bottom:1px solid var(--border-hi); }
.shelf span { flex:1; text-align:center; padding:.7rem .4rem; font-family:var(--heb); font-size:clamp(1.4rem, 4vw, 2.2rem); color:var(--gold); }
.shelf span + span { border-left:1px solid var(--border); }
.shelf small { display:block; font-family:var(--sc); font-size:.6rem; letter-spacing:.22em; color:var(--muted); text-transform:uppercase; margin-top:.2rem; }

.grid { display:grid; grid-template-columns:repeat(3, minmax(0, 1fr)); gap:1rem; }
.card {
  display:flex; flex-direction:column; background:var(--surface); border:1px solid var(--border-hi);
  padding:1.4rem 1.4rem 1.2rem; color:inherit; text-decoration:none; position:relative; overflow:hidden;
  transition:border-color .15s, transform .15s;
}
.card:hover { border-color:var(--gold); transform:translateY(-2px); }
.card-he {
  position:absolute; top:-.4rem; right:.6rem; font-family:var(--heb); font-size:6.5rem; line-height:1;
  color:rgba(201,162,87,.07); pointer-events:none; direction:rtl;
}
.card-shelf { font-family:var(--sc); font-size:.62rem; letter-spacing:.24em; text-transform:uppercase; color:var(--muted); }
.card h2 { font-family:var(--display); font-weight:400; font-size:2.1rem; margin:.25rem 0 .5rem; color:var(--text); }
.card-tag { font-family:var(--display); font-size:1.12rem; line-height:1.45; color:var(--text); margin:0 0 1rem; }
.stats { display:flex; gap:1.3rem; padding:.8rem 0; border-top:1px solid var(--border); border-bottom:1px solid var(--border); margin-bottom:1rem; }
.stats b { display:block; font-family:var(--display); font-weight:300; font-size:1.7rem; color:var(--gold); line-height:1; }
.stats span { font-family:var(--sc); font-size:.56rem; letter-spacing:.18em; text-transform:uppercase; color:var(--muted); }
.card ul { list-style:none; padding:0; margin:0 0 1.2rem; flex:1; }
.card li { font-family:var(--display); font-size:1rem; line-height:1.4; color:var(--muted); padding:.28rem 0 .28rem 1rem; position:relative; }
.card li::before { content:'◆'; position:absolute; left:0; top:.45rem; font-size:.5rem; color:var(--gold); }
.open { font-family:var(--sc); font-size:.7rem; letter-spacing:.22em; text-transform:uppercase; color:var(--bg); background:var(--gold); padding:.6rem 1rem; text-align:center; font-weight:600; }
.card:hover .open { filter:brightness(1.1); }

.shared { margin-top:2.8rem; display:grid; grid-template-columns:1fr 2fr; gap:2rem; border-top:1px solid var(--border-hi); padding-top:1.6rem; }
.shared h3 { font-family:var(--sc); font-size:.75rem; letter-spacing:.26em; text-transform:uppercase; color:var(--gold); margin:0; font-weight:500; }
.shared p { font-family:var(--display); font-size:1.08rem; line-height:1.6; color:var(--muted); margin:0 0 .6rem; }
.shared a { color:var(--gold); }

@media (max-width: 960px) {
  .grid { grid-template-columns:1fr; }
  .shared { grid-template-columns:1fr; gap:.6rem; }
}
</style>

<main class="mega-hub">
  <div class="wrap">
    <div class="kicker">The Mega readers</div>
    <h1>One page per <em>shelf</em>.</h1>
    <p class="lede">Each Mega reader takes one shelf of the Jewish library — Tanakh, Mishnah, the siddur — puts the entire text on a single page, and then piles on everything I wanted while learning it: grammar, sages, commentaries, the day's calendar, and a record of how far I've got.</p>

    <div class="shelf" aria-hidden="true">
      <span>תורה שבכתב<small>Written</small></span>
      <span>תורה שבעל פה<small>Oral</small></span>
      <span>תפילה<small>Prayer</small></span>
    </div>

    <div class="grid">
      {megas.map((m) => (
        <a class="card" href={`/${m.slug}`}>
          <span class="card-he" aria-hidden="true">{m.he}</span>
          <span class="card-shelf">{m.shelf}</span>
          <h2>{m.name}</h2>
          <p class="card-tag">{m.tagline}</p>
          <div class="stats">
            {m.stats.map(([n, l]) => <div><b>{n}</b><span>{l}</span></div>)}
          </div>
          <ul>{m.features.map((f) => <li>{f}</li>)}</ul>
          <span class="open">Open {m.name} →</span>
        </a>
      ))}
    </div>

    <section class="shared">
      <h3>What they share</h3>
      <div>
        <p>All three read their texts live from <a href="https://www.sefaria.org" target="_blank" rel="noopener">Sefaria</a>'s open API, so nothing is copied or frozen. They share one look — dark ink-and-gold by default, parchment if you prefer — and the same habits: Hebrew, English or both, stacked or side by side; a contents sidebar; a panel of linked sources for whatever you tap; links you can share to the exact verse, mishnah or paragraph.</p>
        <p>Each one also knows what today is: the Mega Bible has the week's parasha and haftarah, the Mega Mishnah opens to the day's Mishnah Yomit, and the Mega Siddur adjusts the service to the date and the hour.</p>
      </div>
    </section>
  </div>
</main>
</Layout>
