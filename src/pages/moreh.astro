---
import Layout from '../layouts/Layout.astro';

const evidence = {
  nevokhim: [
    { name: "Yehoyada Amir", type: "video", videoId: "_VRGmohdUIQ", timestamp: 1431, title: "Rabbi Prof. Yehoyada Amir", affiliation: "Hebrew Union College–Jerusalem" },
    { name: "R. Zamir Cohen", type: "video", videoId: "ZU6xfAaXurs", timestamp: 2706, title: "Rabbi Zamir Cohen", affiliation: "Hidabroot Outreach" },
    { name: "Elkhanan Yakira", type: "video", videoId: "SrLY9fJKu74", timestamp: 1432, title: "Prof. Elkhanan Yakira", affiliation: "Hebrew University of Jerusalem" },
    { name: "Eran Viezel", type: "video", videoId: "C3OLkbr3yms", timestamp: 403, title: "Prof. Eran Viezel", affiliation: "Ben-Gurion University" },
    { name: "Asa Keisar", type: "video", videoId: "BMJs3pZIK9o", timestamp: 975, title: "Rabbi Asa Keisar", affiliation: "Israeli Rabbi & Educator" },
    { name: "Gitit Holtzman", type: "video", videoId: "Ru4Cq8NynAc", timestamp: 664, title: "Dr. Gitit Holtzman", affiliation: "Israeli Scholar of Philosophy" },
    { name: "Nechama Verbin", type: "video", videoId: "74ka4czG7ts", timestamp: 1130, title: "Prof. Nechama Verbin", affiliation: "Philosopher of Religion" }
  ],
  nevukhim: [
    { name: "Halbertal", type: "video", videoId: "os_2sIOqCXU", timestamp: 1819, title: "Prof. Moshe Halbertal", affiliation: "Hebrew University & NYU" },
    { name: "Hillel Ben-Sasson", type: "video", videoId: "zMrDper9pNc", timestamp: 2327, title: "Prof. Haim Hillel Ben-Sasson", affiliation: "Hebrew University of Jerusalem" },
    { name: "Moshe Idel", type: "video", videoId: "W4LSqu3lr_8", timestamp: 94, title: "Prof. Moshe Idel", affiliation: "Hebrew University of Jerusalem" },
    { name: "Sarah Stroumsa", type: "video", videoId: "h0BSWrSd2xo", timestamp: 866, title: "Prof. Sarah Stroumsa", affiliation: "Hebrew University of Jerusalem" },
    { name: "Chana Kasher", type: "video", videoId: "FVwsa2K3KbQ", timestamp: 1411, title: "Prof. Chana Kasher", affiliation: "Bar-Ilan University" },
    { name: "Yosef Schwartz", type: "video", videoId: "4BrEi8M-Rgc", timestamp: 1010, title: "Prof. Yosef Schwartz", affiliation: "Tel Aviv University" },
    { name: "Yonatan Meir", type: "video", videoId: "jBQLDpIizo4", timestamp: 436, title: "Prof. Yonatan Meir", affiliation: "Hasidism & Jewish Mysticism" },
    { name: "Hillel Gershuni", type: "video", videoId: "xN1nMCrjRqo", timestamp: 0, title: "Dr. Hillel Gershuni", affiliation: "Scholar of Talmud" },
    { name: "R. Cherki", type: "video", videoId: "CH403nQ2XN4", timestamp: 250, title: "Rabbi Oury Amos Cherki", affiliation: "Brit Olam & Machon Meir" },
    { name: "Miron Izakson", type: "video", videoId: "8sizq9pJ9vk", timestamp: 1455, title: "Prof. Miron Izakson", affiliation: "Bar-Ilan University" },
    { name: "Gideon Freudenthal", type: "video", videoId: "NgYb9EVIDdc", timestamp: 1497, title: "Prof. Gideon Freudenthal", affiliation: "Historian of Science" },
    { name: "R. Eliyahu Amar", type: "video", videoId: "xUDwWfPOjho", timestamp: 336, title: "Rabbi Eliyahu Amar", affiliation: "Jewish Thought & Halakha" },
    { name: "Dr. Shalom Sadik", type: "video", videoId: "YrtnkNPsWQo", timestamp: 589, title: "Prof. Shalom Sadik", affiliation: "Ben-Gurion University" },
    { name: "Moshe Yagur", type: "video", videoId: "shg88a_ZMmk", timestamp: 568, title: "Dr. Moshe Yagur", affiliation: "Maimonides & Medieval Philosophy" },
    { name: "Zohar Amar", type: "video", videoId: "bwRu0uGIH-Q", timestamp: 962, title: "Prof. Zohar Amar", affiliation: "Bar-Ilan University" },
    { name: "R. Makbili", type: "video", videoId: "Nu0jah9P2Sg", timestamp: 1336, title: "Rabbi Makbili", affiliation: "Jewish Philosophy & Halakha" },
    { name: "Gili Zivian", type: "video", videoId: "cZ3YVK5w8vE", timestamp: 1901, title: "Gili Zivian", affiliation: "Maimonidean Philosophy" },
    { name: "R. Ben Tzion Uriel", type: "video", videoId: "RgVOnSnTCes", timestamp: 1, title: "Rabbi Ben Tzion Uriel", affiliation: "Tanakh & Jewish Philosophy" },
    { name: "Lewis Glinert", type: "correspondence", quote: "Only ever heard Nevukhim, but that doesn't prove much", title: "Prof. Lewis Glinert", affiliation: "Dartmouth College" },
    { name: "Yehudah Liebes", type: "correspondence", quote: "Nevukhim, as in Exodus 14, 3", title: "Prof. Yehudah Liebes", affiliation: "Hebrew University of Jerusalem" },
    { name: "Kenneth Seeskin", type: "correspondence", quote: "I've only heard Nevukhim", title: "Prof. Kenneth Seeskin", affiliation: "Northwestern University" }
  ]
};

const nevukhimCorrespondence = [
  { name: "Mordechai Friedman", quote: "Shemot 14:3 nevukhim. Whoever wrote nevokhim seems to have been navokh." },
  { name: "Avishai Bar-Asher", quote: "The traditional vocalization uses a shuruk, so it's properly pronounced Moreh Nevukhim, not Nevokhim. By the way it might be better to add the definite form \"הנבוכים,\" parallel to the Arabic al-ḥāʾirīn." },
  { name: "Josef Stern", quote: "...your friend is navokh (singular) in thinking that the Guide is called in the plural Moreh Nevokhim. The plural is nevukhim and I have never heard any one call it Moreh Nevokhim—although it is easy to imagine that in some European Hebrew dialect it was pronounced that way." },
  { name: "Menachem Lorberbaum", quote: "וְאָמַ֤ר פַּרְעֹה֙ לִבְנֵ֣י יִשְׂרָאֵ֔ל נְבֻכִ֥ים הֵ֖ם בָּאָ֑רֶץ סָגַ֥ר עֲלֵיהֶ֖ם הַמִּדְבָּֽר" },
  { name: "Zeev Harvey", quote: "Dear Matthew, The root of the word is בו\"כ Esther 3:15 reads: nabokhah. Joel 1:18 reads: nabokhu, Exodus 14:3 reads: nebukhim. Thus, the title is: Moreh ha-Nebukhim. Professor Steiner would be able to explain the reasons behind these forms. zh" }
];
---

<Layout title="Moreh Nevokhim - Evidence Explorer" description="Interactive exploration of pronunciation evidence for Maimonides' Guide">
  <div class="min-h-screen bg-gradient-to-b from-slate-900 via-slate-800 to-slate-900">
    {/* Hero Section */}
    <div class="pt-12 pb-16 px-4">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12">
          <h1 class="text-5xl md:text-6xl font-bold mb-6">
            <span class="text-cyan-400">Moreh Nevokhim</span>
          </h1>
          <p class="text-xl md:text-2xl text-slate-300 mb-4">
            Pronunciation Evidence Explorer
          </p>
          <p class="text-lg text-slate-400 max-w-3xl mx-auto">
            How do scholars pronounce Maimonides' Guide? Explore evidence from videos and correspondence.
          </p>
        </div>

        {/* Filter Buttons - Pronunciation */}
        <div class="mb-6">
          <p class="text-slate-400 text-sm mb-3 text-center">Filter by Pronunciation:</p>
          <div class="flex flex-col sm:flex-row flex-wrap justify-center gap-3 mb-6">
            <button 
              id="filter-all-pronunciation"
              class="pronunciation-btn px-6 py-2 rounded-full bg-cyan-600 text-white font-semibold hover:bg-cyan-500 transition active"
              data-pronunciation="all"
            >
              All Pronunciations
            </button>
            <button 
              id="filter-nevokhim"
              class="pronunciation-btn px-6 py-2 rounded-full bg-slate-700 text-slate-300 font-semibold hover:bg-slate-600 transition"
              data-pronunciation="nevokhim"
            >
              🔤 Nevokhim Only
            </button>
            <button 
              id="filter-nevukhim"
              class="pronunciation-btn px-6 py-2 rounded-full bg-slate-700 text-slate-300 font-semibold hover:bg-slate-600 transition"
              data-pronunciation="nevukhim"
            >
              🔤 Nevukhim Only
            </button>
          </div>
        </div>

        {/* Filter Buttons - Evidence Type */}
        <div>
          <p class="text-slate-400 text-sm mb-3 text-center">Filter by Evidence Type:</p>
          <div class="flex flex-col sm:flex-row flex-wrap justify-center gap-3">
            <button 
              id="filter-all-type"
              class="type-btn px-6 py-2 rounded-full bg-cyan-600 text-white font-semibold hover:bg-cyan-500 transition active"
              data-type="all"
            >
              All Evidence
            </button>
            <button 
              id="filter-video"
              class="type-btn px-6 py-2 rounded-full bg-slate-700 text-slate-300 font-semibold hover:bg-slate-600 transition"
              data-type="video"
            >
              📹 Videos Only
            </button>
            <button 
              id="filter-correspondence"
              class="type-btn px-6 py-2 rounded-full bg-slate-700 text-slate-300 font-semibold hover:bg-slate-600 transition"
              data-type="correspondence"
            >
              ✉️ Correspondence Only
            </button>
          </div>
        </div>
      </div>
    </div>

    {/* Evidence Sections */}
    <div class="px-4 py-12">
      <div class="max-w-7xl mx-auto space-y-20">
        
        {/* NEVOKHIM SECTION */}
        <section class="pronunciation-section" data-pronunciation="nevokhim">
          <div class="mb-10">
            <div class="inline-flex items-center gap-4 mb-3">
              <h2 class="text-4xl md:text-5xl font-bold text-amber-300">Nevokhim</h2>
              <span class="text-2xl text-amber-400/70 font-light">נבוכים</span>
            </div>
            <p class="text-slate-300 text-lg">
              <span class="inline-block px-4 py-2 bg-amber-900/30 border border-amber-600/50 rounded-full text-amber-300 font-semibold">
                {evidence.nevokhim.filter(e => e.type === 'video').length} video sources
              </span>
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {evidence.nevokhim.filter(e => e.type === 'video').map((item) => (
              <div 
                class="evidence-card video group bg-slate-800/60 backdrop-blur border border-amber-600/30 hover:border-amber-400/60 rounded-xl overflow-hidden transition-all duration-300 hover:shadow-lg hover:shadow-amber-400/10"
                data-type="video"
                data-pronunciation="nevokhim"
              >
                <div class="relative aspect-video bg-black">
                  <iframe
                    width="100%"
                    height="100%"
                    src={`https://www.youtube.com/embed/${item.videoId}${item.timestamp ? `?start=${item.timestamp}` : ''}`}
                    title={`${item.name} on Moreh Nevokhim`}
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowFullScreen
                    class="absolute inset-0 w-full h-full z-0"
                  ></iframe>
                </div>
                <div class="p-5">
                  <h3 class="text-lg font-bold text-amber-300 mb-1 group-hover:text-amber-200 transition">
                    {item.title}
                  </h3>
                  <p class="text-xs text-amber-400/70 italic">{item.affiliation}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        {/* NEVUKHIM SECTION - Videos */}
        <section class="pronunciation-section" data-pronunciation="nevukhim">
          <div class="mb-10">
            <div class="inline-flex items-center gap-4 mb-3">
              <h2 class="text-4xl md:text-5xl font-bold text-cyan-400">Nevukhim</h2>
              <span class="text-2xl text-cyan-400/70 font-light">נבוכים</span>
            </div>
            <p class="text-slate-300 text-lg">
              <span class="inline-block px-4 py-2 bg-cyan-900/30 border border-cyan-600/50 rounded-full text-cyan-300 font-semibold">
                {evidence.nevukhim.filter(e => e.type === 'video').length} video sources + {evidence.nevukhim.filter(e => e.type === 'correspondence').length + nevukhimCorrespondence.length} correspondence
              </span>
            </p>
          </div>

          <div class="mb-12">
            <h3 class="text-2xl font-bold text-cyan-300 mb-6">Video Evidence</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {evidence.nevukhim.filter(e => e.type === 'video').map((item) => (
                <div 
                  class="evidence-card video group bg-slate-800/60 backdrop-blur border border-cyan-600/30 hover:border-cyan-400/60 rounded-xl overflow-hidden transition-all duration-300 hover:shadow-lg hover:shadow-cyan-400/10"
                  data-type="video"
                  data-pronunciation="nevukhim"
                >
                  <div class="relative aspect-video bg-black">
                    <iframe
                      width="100%"
                      height="100%"
                      src={`https://www.youtube.com/embed/${item.videoId}${item.timestamp ? `?start=${item.timestamp}` : ''}`}
                      title={`${item.name} on Moreh Nevokhim`}
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                      allowFullScreen
                      class="absolute inset-0 w-full h-full z-0"
                    ></iframe>
                  </div>
                  <div class="p-5">
                    <h3 class="text-lg font-bold text-cyan-300 mb-1 group-hover:text-cyan-200 transition">
                      {item.title}
                    </h3>
                    <p class="text-xs text-cyan-400/70 italic">{item.affiliation}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          {/* Nevukhim Correspondence */}
          <div>
            <h3 class="text-2xl font-bold text-cyan-300 mb-6">Scholarly Correspondence</h3>
            <div class="space-y-4">
              {evidence.nevukhim.filter(e => e.type === 'correspondence').map((item) => (
                <div 
                  class="evidence-card correspondence group bg-slate-800/60 backdrop-blur border border-cyan-600/30 hover:border-cyan-400/60 rounded-xl p-6 transition-all duration-300 hover:shadow-lg hover:shadow-cyan-400/10"
                  data-type="correspondence"
                  data-pronunciation="nevukhim"
                >
                  <h4 class="text-lg font-bold text-cyan-300 mb-2">{item.title}</h4>
                  <p class="text-xs text-cyan-400/70 italic mb-3">{item.affiliation}</p>
                  <p class="text-sm text-slate-300 italic leading-relaxed">"{item.quote}"</p>
                </div>
              ))}

              {nevukhimCorrespondence.map((item) => (
                <div 
                  class="evidence-card correspondence group bg-slate-800/60 backdrop-blur border border-cyan-600/30 hover:border-cyan-400/60 rounded-xl p-6 transition-all duration-300 hover:shadow-lg hover:shadow-cyan-400/10"
                  data-type="correspondence"
                  data-pronunciation="nevukhim"
                >
                  <h4 class="text-lg font-bold text-cyan-300 mb-3">{item.name}</h4>
                  <p class="text-sm text-slate-300 italic leading-relaxed">"{item.quote}"</p>
                </div>
              ))}
            </div>
          </div>
        </section>

        {/* Resources */}
        <section class="pronunciation-section" data-pronunciation="all">
          <div class="max-w-4xl mx-auto bg-slate-800/60 backdrop-blur border border-cyan-600/30 rounded-xl p-8 md:p-12">
            <h2 class="text-3xl font-bold text-cyan-400 mb-6">Archival Resources</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <a 
                href="https://www.nli.org.il/en/books/NNL_ALEPH990038796700205171/NLI" 
                target="_blank"
                rel="noopener noreferrer"
                class="p-4 bg-slate-900/40 rounded-lg border border-cyan-400/30 hover:border-cyan-400 hover:bg-cyan-400/5 transition group"
              >
                <p class="text-cyan-300 font-semibold group-hover:text-cyan-200">National Library of Israel</p>
                <p class="text-sm text-slate-400 mt-1">Moreh Nevokhim Collection</p>
              </a>
              <a 
                href="https://www.loc.gov/item/2021667530/" 
                target="_blank"
                rel="noopener noreferrer"
                class="p-4 bg-slate-900/40 rounded-lg border border-cyan-400/30 hover:border-cyan-400 hover:bg-cyan-400/5 transition group"
              >
                <p class="text-cyan-300 font-semibold group-hover:text-cyan-200">Library of Congress</p>
                <p class="text-sm text-slate-400 mt-1">Maimonides' Guide Records</p>
              </a>
            </div>
          </div>
        </section>

      </div>
    </div>

    {/* Footer */}
    <div class="border-t border-slate-700/50 mt-20 py-8 px-4">
      <div class="max-w-6xl mx-auto text-center text-slate-400 text-sm">
        <p>Evidence compiled from scholarly videos and personal correspondence</p>
      </div>
    </div>
  </div>
</Layout>

<script>
  let currentPronunciation = 'all';
  let currentType = 'all';

  function updateFilters() {
    document.querySelectorAll('.evidence-card').forEach(card => {
      const cardPronunciation = (card as HTMLElement).dataset.pronunciation;
      const cardType = (card as HTMLElement).dataset.type;

      const pronunciationMatch = currentPronunciation === 'all' || cardPronunciation === currentPronunciation;
      const typeMatch = currentType === 'all' || cardType === currentType;

      if (pronunciationMatch && typeMatch) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });

    document.querySelectorAll('.pronunciation-section').forEach(section => {
      const sectionPronunciation = (section as HTMLElement).dataset.pronunciation;
      if (currentPronunciation === 'all' || sectionPronunciation === 'all' || sectionPronunciation === currentPronunciation) {
        section.classList.remove('hidden');
      } else {
        section.classList.add('hidden');
      }
    });
  }

  document.querySelectorAll('.pronunciation-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      currentPronunciation = (btn as HTMLElement).dataset.pronunciation || 'all';
      
      document.querySelectorAll('.pronunciation-btn').forEach(b => {
        b.classList.remove('active', 'bg-cyan-600', 'text-white');
        b.classList.add('bg-slate-700', 'text-slate-300');
      });
      btn.classList.add('active', 'bg-cyan-600', 'text-white');
      btn.classList.remove('bg-slate-700', 'text-slate-300');

      updateFilters();
    });
  });

  document.querySelectorAll('.type-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      currentType = (btn as HTMLElement).dataset.type || 'all';
      
      document.querySelectorAll('.type-btn').forEach(b => {
        b.classList.remove('active', 'bg-cyan-600', 'text-white');
        b.classList.add('bg-slate-700', 'text-slate-300');
      });
      btn.classList.add('active', 'bg-cyan-600', 'text-white');
      btn.classList.remove('bg-slate-700', 'text-slate-300');

      updateFilters();
    });
  });
</script>
