  declare global {
    interface Window { __userLat: number | null; __userLng: number | null; }
  }
  window.__userLat = null;
  window.__userLng = null;

  async function fetchSunset(lat: number, lng: number, date: Date): Promise<Date | null> {
    const y = date.getFullYear();
    const m = String(date.getMonth() + 1).padStart(2, '0');
    const d = String(date.getDate()).padStart(2, '0');
    try {
      const res = await fetch(`https://www.hebcal.com/zmanim?cfg=json&latitude=${lat}&longitude=${lng}&date=${y}-${m}-${d}`);
      if (!res.ok) return null;
      const data = await res.json();
      return data.times?.sunset ? new Date(data.times.sunset) : null;
    } catch { return null; }
  }

  async function fetchHebrewDate(date: Date): Promise<string> {
    try {
      const res = await fetch(`https://www.hebcal.com/converter?cfg=json&gy=${date.getFullYear()}&gm=${date.getMonth()+1}&gd=${date.getDate()}&g2h=1`);
      if (!res.ok) return '';
      const data = await res.json();
      return `${data.hebrew} · ${data.hd} ${data.hm} ${data.hy}`;
    } catch { return ''; }
  }

  async function updateOutput(pickerDateInput: Date) {
    const now = new Date();
    const pickerDate = new Date(pickerDateInput.getFullYear(), pickerDateInput.getMonth(), pickerDateInput.getDate());

    const noteEl = document.getElementById('omerInstructionNote')!;
    const outputEl = document.getElementById('omerOutput')!;
    const actionsEl = document.getElementById('actions')!;
    const hebrewDateEl = document.getElementById('hebrewDate')!;

    noteEl.textContent = 'Calculating…';
    outputEl.innerHTML = '';
    actionsEl.innerHTML = '';
    hebrewDateEl.textContent = '';

    const FALLBACK_HOUR = 20;
    let isAfterSunset = false;
    let usedFallback = false;

    const lat = window.__userLat;
    const lng = window.__userLng;

    if (lat !== null && lng !== null) {
      const sunset = await fetchSunset(lat, lng, pickerDate);
      if (sunset) {
        isAfterSunset = now >= sunset;
      } else {
        usedFallback = true;
        const fallback = new Date(pickerDate); fallback.setHours(FALLBACK_HOUR, 0, 0, 0);
        isAfterSunset = now >= fallback;
      }
    } else {
      usedFallback = true;
      const fallback = new Date(pickerDate); fallback.setHours(FALLBACK_HOUR, 0, 0, 0);
      isAfterSunset = now >= fallback;
    }

    const effectiveDate = new Date(pickerDate);
    if (!isAfterSunset) effectiveDate.setDate(effectiveDate.getDate() - 1);

    const year = effectiveDate.getFullYear();
    const startStr = startDates[year];

    if (!startStr) {
      outputEl.innerHTML = `<p class="text-gray-500 dark:text-gray-400">Omer dates not available for ${year}.</p>`;
      return;
    }

    const [sy, sm, sd] = startStr.split('-').map(Number);
    const startDate = new Date(sy, sm - 1, sd);
    const effNorm = new Date(effectiveDate.getFullYear(), effectiveDate.getMonth(), effectiveDate.getDate());
    const dayOfOmer = Math.floor((effNorm.getTime() - startDate.getTime()) / 86400000) + 1;

    if (dayOfOmer < 1 || dayOfOmer > 49) {
      outputEl.innerHTML = `<p class="text-gray-500 dark:text-gray-400 text-center py-4">Not within the Omer period.</p>`;
      const fallbackNote = usedFallback ? ` (using ${FALLBACK_HOUR}:00 fallback)` : '';
      noteEl.textContent = `${pickerDate.toLocaleDateString()} is not during the Omer.${fallbackNote}`;
      return;
    }

    // Status note
    const fallbackNote = usedFallback ? ` (sunset estimated at ${FALLBACK_HOUR}:00)` : '';
    if (isAfterSunset) {
      noteEl.textContent = `After sunset on ${pickerDate.toLocaleDateString()} — tonight's count:${fallbackNote}`;
    } else {
      noteEl.textContent = `Before sunset on ${pickerDate.toLocaleDateString()} — last night's count:${fallbackNote}`;
    }

    // Progress bar
    const pct = Math.round((dayOfOmer / 49) * 100);

    const countText = omerCounts[dayOfOmer - 1];

    const brachaBlock = isAfterSunset ? `
      <div class="bg-slate-50 dark:bg-slate-700/50 rounded-xl p-4 mb-5 border border-slate-200 dark:border-slate-600">
        <p class="text-xs text-gray-400 dark:text-gray-500 uppercase tracking-widest mb-3 text-center">ברכה</p>
        <div class="font-hebrew text-lg sm:text-xl leading-loose text-gray-900 dark:text-white text-center" dir="rtl" lang="he">
          בָּרוּךְ אַתָּה יְהֹוָה אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם אֲשֶׁר קִדְּשָׁנוּ בְּמִצְוֹתָיו וְצִוָּנוּ עַל סְפִירַת הָעֹמֶר
        </div>
      </div>` : '';

    outputEl.innerHTML = `
      <div class="mb-5">
        <div class="text-6xl font-bold text-cyan-600 dark:text-cyan-400 mb-1">${dayOfOmer}</div>
        <div class="text-sm text-gray-400 dark:text-gray-500 uppercase tracking-widest">of 49 days</div>
      </div>
      <div class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-2 mb-6 overflow-hidden">
        <div class="bg-cyan-500 h-2 rounded-full transition-all duration-500" style="width:${pct}%"></div>
      </div>
      ${brachaBlock}
      <div class="font-hebrew text-2xl sm:text-3xl leading-relaxed text-gray-900 dark:text-white mb-2 px-2" dir="rtl" lang="he">
        ${countText}
      </div>
      <div class="font-hebrew text-sm text-gray-500 dark:text-gray-400 italic mt-1" dir="rtl" lang="he">
        הָרַחֲמָן הוּא יַחֲזִיר לָנוּ עֲבוֹדַת בֵּית הַמִּקְדָּשׁ לִמְקוֹמָהּ בִּמְהֵרָה בְיָמֵינוּ אָמֵן
      </div>
    `;

    const hebrewStr = await fetchHebrewDate(effectiveDate);
    if (hebrewStr) hebrewDateEl.textContent = hebrewStr;

    // Share text
    const brachaText = `בָּרוּךְ אַתָּה יְהֹוָה אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם אֲשֶׁר קִדְּשָׁנוּ בְּמִצְוֹתָיו וְצִוָּנוּ עַל סְפִירַת הָעֹמֶר`;
    let shareText: string;
    if (isAfterSunset) {
      shareText = `Day ${dayOfOmer} of the Omer — time to count!\n\n${brachaText}\n\n${countText}\n\nהָרַחֲמָן הוּא יַחֲזִיר לָנוּ עֲבוֹדַת בֵּית הַמִּקְדָּשׁ לִמְקוֹמָהּ בִּמְהֵרָה בְיָמֵינוּ אָמֵן`;
    } else {
