      await navigator.clipboard.writeText(shareText);
      const btn = document.getElementById('copyBtn');
      if (btn) { btn.textContent = '✓ Copied!'; setTimeout(() => { btn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg> Copy Text`; }, 2000); }
    });
  }

  function getLocalDate(pickerVal: Date): Date {
    return new Date(pickerVal.getUTCFullYear(), pickerVal.getUTCMonth(), pickerVal.getUTCDate());
  }

  function initializePage() {
    const today = new Date();
    const todayLocal = new Date(today.getFullYear(), today.getMonth(), today.getDate());
    const picker = document.getElementById('datePicker') as HTMLInputElement;
    picker.valueAsDate = new Date(Date.UTC(today.getFullYear(), today.getMonth(), today.getDate()));

    navigator.geolocation.getCurrentPosition(
      pos => {
        window.__userLat = pos.coords.latitude;
        window.__userLng = pos.coords.longitude;
        updateOutput(todayLocal);
      },
      () => { updateOutput(todayLocal); },
      { timeout: 8000 }
    );
  }

  document.addEventListener('astro:page-load', () => {
    initializePage();

    const picker = document.getElementById('datePicker') as HTMLInputElement;
    picker.addEventListener('change', e => {
      const val = (e.target as HTMLInputElement).valueAsDate;
      if (val) updateOutput(getLocalDate(val));
    });

    document.getElementById('prevDay')?.addEventListener('click', () => {
      const current = getLocalDate(picker.valueAsDate!);
      current.setDate(current.getDate() - 1);
      picker.valueAsDate = new Date(Date.UTC(current.getFullYear(), current.getMonth(), current.getDate()));
      updateOutput(current);
    });

    document.getElementById('nextDay')?.addEventListener('click', () => {
      const current = getLocalDate(picker.valueAsDate!);
      current.setDate(current.getDate() + 1);
      picker.valueAsDate = new Date(Date.UTC(current.getFullYear(), current.getMonth(), current.getDate()));
      updateOutput(current);
    });

    document.getElementById('toggleExplanation')?.addEventListener('click', () => {
      const content = document.getElementById('explanationContent')!;
      const icon = document.getElementById('toggleIcon')!;
      const hidden = content.classList.toggle('hidden');
      icon.textContent = hidden ? '﹢' : '﹣';
    });

    document.getElementById('toggleFrank')?.addEventListener('click', () => {
      const content = document.getElementById('frankContent')!;
      const icon = document.getElementById('frankIcon')!;
      const hidden = content.classList.toggle('hidden');
      icon.textContent = hidden ? '﹢' : '﹣';
    });
  });
</script>
