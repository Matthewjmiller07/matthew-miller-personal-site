---
import Layout from '../../layouts/Layout.astro';
import { books, castStory } from '../../data/parasha-books/books.mjs';
import { defaultCast, castNames } from '../../data/parasha-books/cast.mjs';
import { listNames } from '../../data/parasha-books/render.mjs';
import verses from '../../data/parasha-books/verses.json';

export function getStaticPaths() {
  return books.map((book) => ({ params: { slug: book.slug }, props: { book } }));
}

const { book } = Astro.props;
const base = `/parasha-books/${book.slug}`;
const names = listNames(castNames(defaultCast));
const idx = books.findIndex((b) => b.slug === book.slug);
const prev = books[idx - 1];
const next = books[idx + 1];
const pages = book.pages.map((p, i) => ({
  ...p,
  n: i + 1,
  img: `${base}/page-${String(i + 1).padStart(2, '0')}.jpg`,
  text: castStory(p.story, defaultCast),
  verses: verses[p.ref] || [],
}));
---

<Layout
  title={`Parashat ${book.parasha}: ${book.title}`}
  description={`${book.tagline} A peshat-based picture book starring ${names}.`}
  image={`${base}/cover.jpg`}
>
  <meta name="robots" content="noindex" slot="head" />
  <main class="pb" style={`--accent:${book.color}`}>
    <nav class="crumbs"><a href="/parasha-books">← All Parasha Books</a></nav>

    <header class="hero">
      <img src={`${base}/cover.jpg`} alt="" class="hero-img" />
      <div class="hero-text">
        <div class="kicker">A Parasha Book · {book.range}</div>
        <div class="he" dir="rtl" lang="he">{book.hebrew}</div>
        <h1>{book.title}</h1>
        <p class="starring">starring {names}</p>
        <div class="actions">
          <a class="btn primary" href="#trailer">▶ Watch the trailer</a>
          <a class="btn" href={`${base}/book.pdf`} download>Download PDF</a>
          <a class="btn" href={`${base}/book.html`} target="_blank" rel="noopener">Printable book</a>
          <button class="btn" id="jev-run" type="button">Check peshat with Jev</button>
        </div>
        <p class="jev-summary" id="jev-summary" hidden></p>
      </div>
    </header>

    <section id="trailer" class="trailer">
      <video controls preload="metadata" playsinline poster={`${base}/trailer-poster.jpg`} src={`${base}/trailer.mp4`}></video>
    </section>

    <section class="spreads">
      {pages.map((p) => (
        <article class="spread" id={`page-${p.n}`} data-page={p.n - 1}>
          <figure>
            <img src={p.img} alt={p.title} loading="lazy" />
          </figure>
          <div class="words">
            <div class="ref">{p.ref.replace(/Genesis /g, 'Bereshit ')}<span class="jev" hidden></span></div>
            <h2><span class="num">{p.n}</span>{p.title}</h2>
            <p class="story">{p.text}</p>
            <details class="look">
              <summary><b>Look closely:</b> {p.question}</summary>
              <p>{p.answer}</p>
            </details>
            <div class="torah">
              <div class="label">From the Torah</div>
              {p.verses.map((v) => (
                <div class="v">
                  <p class="he" dir="rtl" lang="he"><sup>{v.v.split(':')[1]}</sup> {v.he}</p>
                  <p class="en"><sup>{v.v}</sup> {v.en}</p>
                </div>
              ))}
            </div>
          </div>
        </article>
      ))}
    </section>

    <footer class="book-foot">
      <div class="pager">
        {prev ? <a href={`/parasha-books/${prev.slug}`}>← {prev.parasha}</a> : <span />}
        {next ? <a href={`/parasha-books/${next.slug}`}>{next.parasha} →</a> : <span />}
      </div>
      <p class="credits">
        Pesukim from <a href="https://www.sefaria.org">Sefaria</a> (Tanach with Nikkud · The Koren Jerusalem Bible).
        Illustrations: FLUX.2 [klein] on Replicate. Voice: MiniMax Speech. Music: MiniMax Music.
        Peshat checks: Jev by TypeSafe.
      </p>
    </footer>
  </main>
</Layout>

<script define:vars={{ slug: book.slug, count: book.pages.length }}>
  const btn = document.getElementById('jev-run');
  const summary = document.getElementById('jev-summary');
  const LABELS = ['contradicts', 'embellished', 'mostly faithful', 'faithful'];
  btn?.addEventListener('click', async () => {
    btn.disabled = true;
    summary.hidden = false;
    summary.textContent = 'Jev is reading the pesukim next to each page…';
    let faithful = 0, done = 0, failed = 0;
    const one = async (i) => {
      const badge = document.querySelector(`.spread[data-page="${i}"] .jev`);
      try {
        const res = await fetch('/api/parasha-books/peshat-check', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug, page: i }),
        });
        const r = await res.json();
        if (!res.ok) throw new Error(r.error);
        const ok = r.faithful >= 2 && !r.midrash && r.answerCorrect && r.gentle;
        if (ok) faithful++;
        badge.hidden = false;
        badge.className = `jev ${ok ? 'ok' : 'warn'}`;
        const notes = [LABELS[r.faithful] || '?', r.midrash ? 'midrash flagged' : 'no midrash', r.answerCorrect ? 'answer ✓' : 'answer ✗', r.gentle ? 'gentle' : 'not gentle'];
        badge.textContent = `Jev: ${notes.join(' · ')}`;
      } catch (e) {
        failed++;
        badge.hidden = false;
        badge.className = 'jev warn';
        badge.textContent = `Jev unavailable (${e.message})`;
      }
      done++;
      summary.textContent = `Jev checked ${done}/${count} pages — ${faithful} passed every test${failed ? `, ${failed} couldn't be checked` : ''}.`;
    };
    // Four at a time.
    const queue = [...Array(count).keys()];
    await Promise.all([0, 1, 2, 3].map(async () => { while (queue.length) await one(queue.shift()); }));
    btn.disabled = false;
  });
</script>

<style>
  @font-face { font-family: 'PBShoulders'; font-weight: 700; src: url('/parasha-books/fonts/BigShoulders-Bold.ttf'); }
  @font-face { font-family: 'PBCrimson'; src: url('/parasha-books/fonts/CrimsonPro-Regular.ttf'); }
  @font-face { font-family: 'PBCrimson'; font-style: italic; src: url('/parasha-books/fonts/CrimsonPro-Italic.ttf'); }
  @font-face { font-family: 'PBHeb'; src: url('/fonts/NotoSerifHebrew-Regular.ttf'); }
  @font-face { font-family: 'PBHeb'; font-weight: 700; src: url('/fonts/NotoSerifHebrew-Bold.ttf'); }

  .pb { --paper: #fbf5ea; --ink: #2b2118; --muted: #7a6a58; max-width: 1180px; margin: 0 auto; padding: 16px 16px 64px; font-family: 'PBCrimson', Georgia, serif; }
  .crumbs a { color: #d9c7ab; font-size: 15px; text-decoration: none; }
  .hero { position: relative; border-radius: 22px; overflow: hidden; margin-top: 12px; background: #1b130b; }
  .hero-img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; display: block; max-height: 78vh; }
  .hero-text { position: absolute; inset: auto 0 0 0; padding: 120px 40px 32px; color: #fff8ec;
    background: linear-gradient(to top, rgba(18,11,4,.92), rgba(18,11,4,.55) 60%, transparent); }
  .kicker { font-family: 'PBShoulders', sans-serif; letter-spacing: .14em; text-transform: uppercase; font-size: 14px; opacity: .85; }
  .he { font-family: 'PBHeb', serif; font-weight: 700; color: var(--accent); font-size: clamp(28px, 5vw, 48px); line-height: 1.1; }
  .hero h1 { font-family: 'PBShoulders', sans-serif; font-size: clamp(36px, 7vw, 78px); line-height: .95; margin: 4px 0 6px; }
  .starring { font-style: italic; font-size: 22px; margin: 0 0 16px; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .btn { font: 600 15px system-ui, sans-serif; padding: 10px 16px; border-radius: 999px; border: 1px solid rgba(255,248,236,.55);
    color: #fff8ec; background: rgba(255,255,255,.08); text-decoration: none; cursor: pointer; }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: #1b130b; }
  .btn:disabled { opacity: .6; cursor: progress; }
  .jev-summary { margin: 12px 0 0; font: 14px system-ui, sans-serif; color: #f3e6d2; }

  .trailer { margin: 28px 0; }
  .trailer video { width: 100%; border-radius: 18px; background: #000; aspect-ratio: 16 / 9; }

  .spreads { display: grid; gap: 28px; }
  .spread { display: grid; grid-template-columns: 1.15fr 1fr; background: var(--paper); color: var(--ink); border-radius: 20px; overflow: hidden;
    box-shadow: 0 10px 40px rgba(0,0,0,.25); }
  .spread:nth-child(even) figure { order: 2; }
  .spread figure { margin: 0; background: #e9dcc6; }
  .spread figure img { width: 100%; height: 100%; object-fit: cover; display: block; aspect-ratio: 3 / 2; }
  .words { padding: 28px 30px; display: flex; flex-direction: column; gap: 14px; }
  .ref { font-family: 'PBShoulders', sans-serif; color: var(--accent); letter-spacing: .08em; text-transform: uppercase; font-size: 14px;
    display: flex; flex-wrap: wrap; gap: 8px; align-items: center; filter: brightness(.8); }
  .jev { font: 600 12px system-ui, sans-serif; letter-spacing: 0; text-transform: none; padding: 3px 9px; border-radius: 999px; }
  .jev.ok { background: #dff0d8; color: #2c5a1f; }
  .jev.warn { background: #fbe3cf; color: #7a3a0e; }
  .words h2 { font-family: 'PBShoulders', sans-serif; font-size: 34px; line-height: 1; margin: 0; display: flex; gap: 12px; align-items: center; }
  .num { background: var(--accent); color: #fff; border-radius: 50%; width: 38px; height: 38px; display: inline-grid; place-items: center; font-size: 20px; flex: none; }
  .story { font-size: 20px; line-height: 1.5; margin: 0; }
  .look { border-left: 4px solid var(--accent); background: rgba(0,0,0,.035); padding: 8px 14px; font-size: 17px; border-radius: 0 10px 10px 0; }
  .look summary { cursor: pointer; }
  .look p { margin: 6px 0 2px; font-style: italic; color: var(--muted); }
  .torah { border-top: 1px solid rgba(0,0,0,.14); padding-top: 10px; margin-top: auto; }
  .label { font-family: 'PBShoulders', sans-serif; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); margin-bottom: 4px; }
  .v { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .v p { margin: 0 0 6px; }
  .v .he { font-family: 'PBHeb', serif; font-size: 18px; line-height: 1.7; text-align: right; }
  .v .en { font-size: 15px; line-height: 1.4; color: #4a3d30; }
  .v sup { color: var(--accent); font-size: 10px; filter: brightness(.8); }

  .book-foot { margin-top: 36px; color: #d9c7ab; }
  .pager { display: flex; justify-content: space-between; font: 600 17px system-ui, sans-serif; }
  .pager a, .credits a { color: #f3d9a8; }
  .credits { font-size: 14px; opacity: .8; margin-top: 14px; }

  @media (max-width: 820px) {
    .spread { grid-template-columns: 1fr; }
    .spread:nth-child(even) figure { order: 0; }
    .v { grid-template-columns: 1fr; gap: 0; }
    .hero-text { position: static; padding: 20px; background: #1b130b; }
    .words { padding: 20px 18px; }
    .story { font-size: 18px; }
  }
</style>
