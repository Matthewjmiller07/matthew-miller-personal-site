---
import Layout from '../../layouts/Layout.astro';
import { books, castStory } from '../../data/parasha-books/books.mjs';
import { defaultCast, castNames } from '../../data/parasha-books/cast.mjs';
import { listNames } from '../../data/parasha-books/render.mjs';

const names = listNames(castNames(defaultCast));
---

<Layout
  title="Parasha Books"
  description={`Peshat-based picture books where ${names} explore the weekly parasha — with printable PDFs and trailers. Make one with your own kids.`}
  image="/parasha-books/bereshit/cover.jpg"
>
  <meta name="robots" content="noindex" slot="head" />
  <main class="pbi">
    <header class="intro">
      <p class="kicker">Parasha Books</p>
      <h1>Your kids, inside the parasha.</h1>
      <p class="lede">
        {names} open the Chumash and walk right into the story — watching the light switch on, riding the ark,
        following Avram to Canaan. Every page follows the <em>peshat</em>: pesukim from Sefaria sit under each picture,
        a “Look closely” question sends kids back to the text, and Jev checks each page against the verses.
      </p>
    </header>

    <section class="shelf">
      {books.map((b) => (
        <article class="card" style={`--accent:${b.color}`}>
          <a href={`/parasha-books/${b.slug}`} class="cover">
            <img src={`/parasha-books/${b.slug}/cover.jpg`} alt="" loading="lazy" />
            <span class="he" dir="rtl" lang="he">{b.hebrew}</span>
          </a>
          <div class="meta">
            <div class="parasha">Parashat {b.parasha} · {b.range}</div>
            <h2><a href={`/parasha-books/${b.slug}`}>{b.title}</a></h2>
            <p>{castStory(b.tagline, defaultCast)}</p>
            <div class="links">
              <a href={`/parasha-books/${b.slug}`}>Read</a>
              <a href={`/parasha-books/${b.slug}#trailer`}>Trailer</a>
              <a href={`/parasha-books/${b.slug}/book.pdf`} download>PDF</a>
            </div>
          </div>
        </article>
      ))}
    </section>

    <section class="maker" id="make">
      <h2>Make one with your own kids</h2>
      <p class="sub">
        Upload a clear photo of each child and tap their face. FLUX.2 [klein] draws a character sheet — keep fixing it until
        it looks like them — then illustrates every page from it. Photos go to Replicate for the illustrations and aren't stored here.
      </p>
      <form id="maker-form">
        <label class="row">Parasha
          <select name="slug">
            {books.map((b) => <option value={b.slug}>{b.parasha} — {b.title}</option>)}
          </select>
        </label>
        <div class="people">
          {[
            ['big', 'Big kid', 'Reads the pesukim and asks questions', true],
            ['mid', 'Little kid', 'Points, counts, loves the animals', false],
            ['baby', 'Baby', 'Coos, grabs, rides along', false],
          ].map(([role, label, hint, req]) => (
            <fieldset class="person" data-role={role}>
              <legend>{label}{req ? '' : ' (optional)'}</legend>
              <p class="hint">{hint}</p>
              <div class="two">
                <input type="text" name={`${role}-name`} placeholder="Name" maxlength="40" required={req} />
                <input type="number" name={`${role}-age`} placeholder="Age" min="0" max="17" />
              </div>
              <div class="photo">
                <img alt="" hidden />
                <i class="dot" hidden></i>
                <label class="pick"><input type="file" name={`${role}-photo`} accept="image/*" /><span>Choose photo</span></label>
              </div>
              <p class="hint tap" hidden>Tap the face — the likeness is built from that close-up.</p>
              <input type="text" name={`${role}-look`} maxlength="200" placeholder="What stands out? e.g. dark hair in a bow headband, gold earrings" />
            </fieldset>
          ))}
        </div>
        <label class="check"><input type="checkbox" name="sisters" checked /> They're sisters (keep “sister” in the story)</label>
        <label class="row code">Access code <input type="password" name="code" autocomplete="off" placeholder="if the site asks for one" /></label>
        <button type="submit" class="go">Draw the character sheet</button>
        <p class="status" id="maker-status" role="status"></p>
      </form>

      <div id="sheet-step" class="pbm sheet-step" hidden>
        <h3>Does this look like them?</h3>
        <img id="sheet-view" alt="Character sheet" />
        <div class="takes" id="sheet-takes"></div>
        <label class="row notes">What should change?
          <input type="text" id="sheet-notes" maxlength="300" placeholder="e.g. her face is thinner, hair darker and straighter, she looks older" />
        </label>
        <div class="actions">
          <button type="button" id="sheet-ok">Looks right — illustrate the book</button>
          <button type="button" id="sheet-fix">Fix this one</button>
          <button type="button" id="sheet-new">Try a new one</button>
        </div>
        <p class="status" id="sheet-status" role="status"></p>
      </div>

      <div id="maker-out" class="pbm" hidden>
        <div class="out-head">
          <img id="sheet-img" alt="Character sheet" />
          <div>
            <h3 id="out-title"></h3>
            <div class="actions">
              <button type="button" id="play-trailer" disabled>▶ Play trailer</button>
              <button type="button" id="rec-trailer" disabled>Record trailer (WebM)</button>
              <button type="button" id="dl-html" disabled>Download book</button>
              <button type="button" id="print-pdf" disabled>Print / save PDF</button>
            </div>
            <p class="status" id="out-status"></p>
          </div>
        </div>
        <canvas id="trailer-canvas" width="1280" height="720" hidden></canvas>
        <div id="out-spreads" class="spreads"></div>
      </div>
    </section>

    <p class="credits">
      Pesukim from <a href="https://www.sefaria.org">Sefaria</a>. Illustrations: FLUX.2 [klein] on Replicate.
      Trailer voice: MiniMax Speech; backtrack: MiniMax Music, ducked under the narrator. Peshat checks: Jev by TypeSafe.
    </p>
  </main>
</Layout>

<script>
  import { books, bookBySlug, tell } from '../../data/parasha-books/books.mjs';
  import { adaptStory } from '../../data/parasha-books/prompts.mjs';
  import { bookHtml } from '../../data/parasha-books/render.mjs';
  import verses from '../../data/parasha-books/verses.json';

  const API = '/api/parasha-books/illustrate';
  const $ = (id) => document.getElementById(id);
  const form = $('maker-form');
  const status = $('maker-status');
  const out = $('maker-out');
  let current = null; // { book, cast, sisters, people, images: {cover, pages[], sheet}, blobs }

  // Photo previews; tapping marks the face we crop to.
  const focus = {};
  form.querySelectorAll('.person').forEach((fs) => {
    const role = fs.dataset.role;
    const input = fs.querySelector('input[type=file]');
    const img = fs.querySelector('.photo img');
    const dot = fs.querySelector('.dot');
    input.addEventListener('change', () => {
      const f = input.files?.[0];
      if (!f) return;
      img.src = URL.createObjectURL(f);
      img.hidden = false;
      dot.hidden = true;
      delete focus[role];
      fs.querySelector('.pick span').textContent = 'Change photo';
      fs.querySelector('.tap').hidden = false;
    });
    img.addEventListener('click', (e) => {
      const r = img.getBoundingClientRect();
      // object-fit: contain — map the click back onto the picture itself.
      const s = Math.min(r.width / img.naturalWidth, r.height / img.naturalHeight);
      const w = img.naturalWidth * s, h = img.naturalHeight * s;
      const x = (e.clientX - r.left - (r.width - w) / 2) / w;
      const y = (e.clientY - r.top - (r.height - h) / 2) / h;
      if (x < 0 || x > 1 || y < 0 || y > 1) return;
      focus[role] = { x, y };
      dot.style.left = `${e.clientX - r.left}px`;
      dot.style.top = `${e.clientY - r.top}px`;
      dot.hidden = false;
    });
  });

  // JPEG data URL under the API's limit. With a focus point, crop a square around the face first:
  // FLUX keeps a likeness far better from a close-up than from a small face in a full photo.
  async function prepare(file, f) {
    const bmp = await createImageBitmap(file);
    let sx = 0, sy = 0, sw = bmp.width, sh = bmp.height;
    if (f) {
      const side = Math.min(bmp.width, bmp.height) * 0.55;
      sx = Math.min(Math.max(f.x * bmp.width - side / 2, 0), bmp.width - side);
      sy = Math.min(Math.max(f.y * bmp.height - side * 0.45, 0), bmp.height - side);
      sw = sh = side;
    }
    const scale = Math.min(1, 768 / Math.max(sw, sh));
    const c = document.createElement('canvas');
    c.width = Math.round(sw * scale);
    c.height = Math.round(sh * scale);
    c.getContext('2d').drawImage(bmp, sx, sy, sw, sh, 0, 0, c.width, c.height);
    for (const q of [0.88, 0.8, 0.7, 0.55, 0.4]) {
      const url = c.toDataURL('image/jpeg', q);
      if (url.length < 380_000) return url;
    }
    throw new Error('Photo is too large even after resizing');
  }

  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
  async function call(body) {
    const res = await fetch(API, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);
    return data.id;
  }
  async function wait(id) {
    for (;;) {
      await sleep(2000);
      const r = await (await fetch(`${API}?id=${id}`)).json();
      if (r.status === 'succeeded') return r.output;
      if (r.status === 'failed' || r.status === 'canceled') throw new Error(r.error || r.status);
    }
  }
  const proxied = (url) => `${API}?fetch=${encodeURIComponent(url)}`;

  function renderSpreads(book, cast, sisters) {
    const wrap = $('out-spreads');
    wrap.innerHTML = '';
    book.pages.forEach((p, i) => {
      const el = document.createElement('article');
      el.className = 'spread';
      el.style.setProperty('--accent', book.color);
      const vs = verses[p.ref] || [];
      el.innerHTML = `
        <figure>
          <div class="pic"><div class="ph">Illustrating…</div></div>
          <form class="redo" hidden>
            <input type="text" maxlength="200" placeholder="What's wrong? (optional) e.g. only one child, no headband on the dog" />
            <button type="submit">↻ Redraw</button>
          </form>
        </figure>
        <div class="words">
          <div class="ref"></div><h2><span class="num">${i + 1}</span><span class="t"></span></h2>
          <p class="story"></p>
          <details class="look"><summary><b>Look closely:</b> <span class="q"></span></summary><p class="a"></p></details>
          <div class="torah"><div class="label">From the Torah</div>${vs.map(() => '<div class="v"><p class="he" dir="rtl" lang="he"></p><p class="en"></p></div>').join('')}</div>
        </div>`;
      el.querySelector('.ref').textContent = p.ref.replace(/Genesis /g, 'Bereshit ');
      el.querySelector('.t').textContent = p.title;
      el.querySelector('.story').textContent = adaptStory(p.story, cast, sisters);
      el.querySelector('.q').textContent = p.question;
      el.querySelector('.a').textContent = p.answer;
      el.querySelectorAll('.v').forEach((v, k) => {
        v.querySelector('.he').textContent = `${vs[k].v.split(':')[1]} ${vs[k].he}`;
        v.querySelector('.en').textContent = `${vs[k].v} ${vs[k].en}`;
      });
      wrap.appendChild(el);
    });
  }

  function setPageImage(i, url) {
    const fig = $('out-spreads').children[i]?.querySelector('figure');
    if (!fig) return;
    fig.querySelector('.pic').innerHTML = `<img src="${url}" alt="">`;
    fig.querySelector('.redo').hidden = false;
  }

  // Per-page redo: a fresh seed, plus the reader's note about what went wrong.
  $('out-spreads').addEventListener('submit', async (e) => {
    const f = e.target.closest('form.redo');
    if (!f || !current) return;
    e.preventDefault();
    const i = [...$('out-spreads').children].indexOf(f.closest('.spread'));
    const { book, sisters, code, lite, photos, images } = current;
    const btn = f.querySelector('button');
    const note = f.querySelector('input');
    btn.disabled = true;
    btn.textContent = 'Redrawing…';
    f.closest('figure').querySelector('.pic').classList.add('busy');
    try {
      const url = await wait(await call({
        action: 'page', slug: book.slug, page: i, sheet: images.sheet, people: lite, photos, sisters, code,
        notes: note.value.trim(), seed: Math.floor(Math.random() * 1e9),
      }));
      images.pages[i] = url;
      setPageImage(i, url);
      note.value = '';
    } catch (err) {
      $('out-status').textContent = `Redraw failed: ${err.message}`;
    } finally {
      btn.disabled = false;
      btn.textContent = '↻ Redraw';
      f.closest('figure').querySelector('.pic').classList.remove('busy');
    }
  });

  // --- Step 1: the character sheet, iterated until it looks right -------------------------
  let draft = null; // { book, cast, sisters, code, people (with photos), lite, takes: [url], chosen }
  const sheetStatus = $('sheet-status');
  const sheetButtons = ['sheet-ok', 'sheet-fix', 'sheet-new'].map($);

  function showTakes() {
    $('sheet-view').src = draft.takes[draft.chosen];
    const strip = $('sheet-takes');
    strip.innerHTML = '';
    if (draft.takes.length < 2) return;
    draft.takes.forEach((url, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = i === draft.chosen ? 'on' : '';
      b.innerHTML = `<img src="${url}" alt="Take ${i + 1}">`;
      b.addEventListener('click', () => { draft.chosen = i; showTakes(); });
      strip.appendChild(b);
    });
  }

  async function drawSheet(extra, label) {
    sheetButtons.forEach((b) => (b.disabled = true));
    sheetStatus.textContent = label;
    try {
      const url = await wait(await call({ action: 'cast', people: draft.people, code: draft.code, ...extra }));
      draft.takes.push(url);
      draft.chosen = draft.takes.length - 1;
      showTakes();
      sheetStatus.textContent = 'Not quite? Say what to change and fix it, or try a new one.';
    } catch (err) {
      sheetStatus.textContent = `Something went wrong: ${err.message}`;
    } finally {
      sheetButtons.forEach((b) => (b.disabled = false));
      form.querySelector('.go').disabled = false;
    }
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const people = [];
    const cast = {};
    try {
      for (const role of ['big', 'mid', 'baby']) {
        const name = String(fd.get(`${role}-name`) || '').trim();
        const file = fd.get(`${role}-photo`);
        if (!name && !(file && file.size)) continue;
        if (!name || !(file && file.size)) throw new Error(`Give the ${role === 'big' ? 'big kid' : role === 'mid' ? 'little kid' : 'baby'} both a name and a photo`);
        const age = Number(fd.get(`${role}-age`)) || undefined;
        const look = String(fd.get(`${role}-look`) || '').trim();
        people.push({ role, name, age, look, image: await prepare(file, focus[role]) });
        cast[role] = { name };
      }
      if (!cast.big) throw new Error('The big kid is required — they read the pesukim.');
    } catch (err) {
      status.textContent = err.message;
      return;
    }
    status.textContent = '';
    form.querySelector('.go').disabled = true;
    draft = {
      book: bookBySlug[fd.get('slug')],
      cast,
      sisters: !!fd.get('sisters'),
      code: fd.get('code') || undefined,
      people,
      lite: people.map(({ role, name, age, look }) => ({ role, name, age, look })),
      takes: [],
      chosen: 0,
    };
    $('sheet-step').hidden = false;
    $('sheet-view').removeAttribute('src');
    $('sheet-takes').innerHTML = '';
    $('sheet-step').scrollIntoView({ behavior: 'smooth', block: 'start' });
    drawSheet({}, 'Drawing the character sheet…');
  });

  $('sheet-fix').addEventListener('click', () => {
    const notes = $('sheet-notes').value.trim();
    if (!notes) { sheetStatus.textContent = 'Say what should change first.'; return; }
    drawSheet({ base: draft.takes[draft.chosen], notes }, 'Fixing the sheet…');
  });
  $('sheet-new').addEventListener('click', () => {
    drawSheet({ notes: $('sheet-notes').value.trim(), seed: Math.floor(Math.random() * 1e9) }, 'Drawing a new take…');
  });

  // --- Step 2: illustrate the book from the approved sheet ---------------------------------
  $('sheet-ok').addEventListener('click', async () => {
    if (!draft?.takes.length) return;
    const { book, cast, sisters, code, people, lite } = draft;
    const photos = people.map((p) => p.image);
    sheetButtons.forEach((b) => (b.disabled = true));
    out.hidden = false;
    $('out-title').textContent = `Parashat ${book.parasha}: ${book.title}`;
    renderSpreads(book, cast, sisters);
    for (const b of out.querySelectorAll('.actions button')) b.disabled = true;
    const images = { cover: null, pages: [], sheet: draft.takes[draft.chosen] };
    current = { book, cast, sisters, people, images, code, lite, photos };
    $('sheet-img').src = images.sheet;
    out.scrollIntoView({ behavior: 'smooth', block: 'start' });

    try {
      // The stock narration says "three sisters"; anyone else gets their own read, made alongside the pictures.
      const voiceJob = people.length === 3 && sisters
        ? null
        : call({ action: 'voice', slug: book.slug, people: lite, sisters, code }).then(wait).catch(() => null);

      status.textContent = 'Illustrating the book (13 pictures)…';
      $('out-status').textContent = 'Illustrating the book (13 pictures)…';
      const jobs = ['cover', ...book.pages.map((_, i) => i)];
      let done = 0;
      const queue = [...jobs];
      await Promise.all([0, 1, 2, 3].map(async () => {
        while (queue.length) {
          const page = queue.shift();
          const url = await wait(await call({ action: 'page', slug: book.slug, page, sheet: images.sheet, people: lite, photos, sisters, code }));
          if (page === 'cover') images.cover = url;
          else { images.pages[page] = url; setPageImage(page, url); }
          $('out-status').textContent = `Illustrating the book… ${++done}/${jobs.length}`;
        }
      }));
      if (voiceJob) {
        $('out-status').textContent = 'Recording the trailer narration…';
        images.voice = await voiceJob;
      }
      status.textContent = 'Done! Scroll down to read it.';
      $('out-status').textContent = 'Done! Replicate links expire after an hour — download the book to keep it.';
      for (const b of out.querySelectorAll('.actions button')) b.disabled = false;
    } catch (err) {
      $('out-status').textContent = `Something went wrong: ${err.message}`;
    } finally {
      sheetButtons.forEach((b) => (b.disabled = false));
    }
  });

  // --- Download / print -------------------------------------------------------------------
  async function asDataUrl(url) {
    const blob = await (await fetch(proxied(url))).blob();
    return await new Promise((res) => { const r = new FileReader(); r.onload = () => res(r.result); r.readAsDataURL(blob); });
  }

  async function standaloneHtml() {
    const { book, cast, sisters, images } = current;
    $('out-status').textContent = 'Packing the pictures into one file…';
    const embedded = {
      cover: await asDataUrl(images.cover),
      sheet: await asDataUrl(images.sheet),
      pages: await Promise.all(images.pages.map(asDataUrl)),
    };
    $('out-status').textContent = '';
    return bookHtml(book, cast, verses, {
      images: embedded,
      fontBase: location.origin,
      story: (t) => adaptStory(t, cast, sisters),
    });
  }

  $('dl-html').addEventListener('click', async () => {
    const html = await standaloneHtml();
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([html], { type: 'text/html' }));
    a.download = `${current.book.slug}-${current.cast.big.name.toLowerCase().replace(/\W+/g, '-')}.html`;
    a.click();
  });

  $('print-pdf').addEventListener('click', async () => {
    const w = window.open('', '_blank');
    if (!w) return;
    w.document.write(await standaloneHtml());
    w.document.close();
    w.addEventListener('load', () => setTimeout(() => w.print(), 400));
  });

  // --- In-browser trailer: the parasha's voice + music, your pictures -----------------------
  const W = 1280, H = 720;
  async function loadImage(url) {
    const img = new Image();
    img.src = URL.createObjectURL(await (await fetch(proxied(url))).blob());
    await img.decode();
    return img;
  }

  // A custom narration has its own timing: find its line breaks (the longest pauses) like make-trailer.py does.
  function retime(t, voiceBuf, lines) {
    const data = voiceBuf.getChannelData(0), rate = voiceBuf.sampleRate, win = Math.round(rate * 0.02);
    const quiet = [];
    let runStart = null;
    for (let i = 0; i + win <= data.length; i += win) {
      let sum = 0;
      for (let k = i; k < i + win; k++) sum += data[k] * data[k];
      const silent = Math.sqrt(sum / win) < 0.0126; // -38 dB
      const at = i / rate;
      if (silent && runStart === null) runStart = at;
      if (!silent && runStart !== null) {
        if (at - runStart >= 0.35 && runStart > 0.2) quiet.push([runStart, at]);
        runStart = null;
      }
    }
    const breaks = quiet.sort((a, b) => (b[1] - b[0]) - (a[1] - a[0])).slice(0, lines.length - 1).sort((a, b) => a[0] - b[0]);
    const total = t.leadIn + voiceBuf.duration + 3.5;
    const bounds = [0, ...breaks.map(([, end]) => t.leadIn + end - 0.15), total];
    while (bounds.length < lines.length + 1) bounds.splice(-1, 0, bounds.at(-2) + 1); // too few pauses: pad
    return { ...t, lines, voice: voiceBuf.duration, total, bounds };
  }

  function segments(t, n) {
    // Mirrors scripts/parasha-books/make-trailer.py: images split each line's span; last line ends on the title card.
    const segs = [];
    t.lines.forEach((line, li) => {
      const a = t.bounds[li], b = t.bounds[li + 1];
      let shots = t.shots[li];
      const pieces = [];
      if (li === t.lines.length - 1 && shots.includes('title')) {
        const imgs = shots.filter((s) => s !== 'title');
        const speakEnd = t.leadIn + t.voice + 0.3;
        if (imgs.length) pieces.push([a, speakEnd, imgs]);
        pieces.push([imgs.length ? speakEnd : a, b, ['title']]);
      } else pieces.push([a, b, shots]);
      for (const [sa, sb, imgs] of pieces) {
        const each = (sb - sa) / imgs.length;
        imgs.forEach((s, k) => segs.push({ start: sa + k * each, end: sa + (k + 1) * each, shot: s, caption: k === 0 && s !== 'title' ? line : null, dir: segs.length % 2 }));
      }
    });
    return segs;
  }

  function wrapText(ctx, text, maxW) {
    const words = text.split(' '), lines = [];
    let cur = '';
    for (const w of words) {
      const t = (cur + ' ' + w).trim();
      if (ctx.measureText(t).width <= maxW) cur = t; else { lines.push(cur); cur = w; }
    }
    return [...lines, cur];
  }

  function drawCover(ctx, img, p, dir) {
    const z = 1 + 0.14 * (dir ? 1 - p : p);
    const s = Math.max(W / img.width, H / img.height) * z;
    const w = img.width * s, h = img.height * s;
    const dx = (dir ? -1 : 1) * 30 * p;
    ctx.drawImage(img, (W - w) / 2 + dx, (H - h) / 2, w, h);
  }

  function drawTitle(ctx, cover, book, cast) {
    ctx.save();
    ctx.filter = 'blur(6px) brightness(0.38)';
    drawCover(ctx, cover, 0, 0);
    ctx.restore();
    ctx.textAlign = 'center';
    ctx.fillStyle = '#fff0d7';
    ctx.font = 'italic 30px PBCrimson, Georgia, serif';
    ctx.fillText('A Parasha Book', W / 2, 130);
    ctx.fillStyle = '#f2c878';
    ctx.font = '700 80px PBHeb, serif';
    ctx.direction = 'rtl';
    ctx.fillText(book.hebrew, W / 2, 240);
    ctx.direction = 'ltr';
    ctx.fillStyle = '#fffaee';
    ctx.font = '700 120px PBShoulders, Impact, sans-serif';
    ctx.fillText(`PARASHAT ${book.parasha.toUpperCase()}`, W / 2, 390);
    ctx.font = '38px PBCrimson, Georgia, serif';
    ctx.fillText(book.title, W / 2, 455);
    const names = ['big', 'mid', 'baby'].map((r) => cast[r]?.name).filter(Boolean).join(' · ');
    ctx.fillStyle = '#f2c878';
    ctx.font = 'italic 32px PBCrimson, Georgia, serif';
    ctx.fillText(`starring ${names}`, W / 2, 540);
    ctx.fillStyle = '#fffaee';
    ctx.font = '700 40px PBShoulders, Impact, sans-serif';
    ctx.fillText('THIS SHABBAT', W / 2, 630);
  }

  function drawCaption(ctx, text) {
    ctx.font = '700 48px PBShoulders, Impact, sans-serif';
    ctx.textAlign = 'center';
    const lines = wrapText(ctx, text.toUpperCase(), W - 240);
    const top = H - 70 - lines.length * 54;
    const g = ctx.createLinearGradient(0, top - 50, 0, H);
    g.addColorStop(0, 'rgba(10,6,2,0)');
    g.addColorStop(0.45, 'rgba(10,6,2,.6)');
    ctx.fillStyle = g;
    ctx.fillRect(0, top - 50, W, H - top + 50);
    ctx.shadowColor = 'rgba(0,0,0,.8)';
    ctx.shadowBlur = 12;
    ctx.fillStyle = '#fff6e1';
    lines.forEach((l, i) => ctx.fillText(l, W / 2, top + 40 + i * 54));
    ctx.shadowBlur = 0;
  }

  async function playTrailer(record) {
    const { book, cast, sisters, images } = current;
    const btns = [$('play-trailer'), $('rec-trailer')];
    btns.forEach((b) => (b.disabled = true));
    $('out-status').textContent = 'Loading the trailer…';
    try {
      await Promise.all(['700 40px PBShoulders', '30px PBCrimson', 'italic 30px PBCrimson', '700 40px PBHeb'].map((f) => document.fonts.load(f)));
      const base = `/parasha-books/${book.slug}`;
      let t = await (await fetch(`${base}/trailer.json`)).json();
      const pics = { 0: await loadImage(images.cover) };
      for (const s of new Set(t.shots.flat().filter((s) => typeof s === 'number' && s > 0))) pics[s] = await loadImage(images.pages[s - 1]);

      const ac = new AudioContext();
      const buf = async (u) => ac.decodeAudioData(await (await fetch(u)).arrayBuffer());
      const [voiceBuf, musicBuf] = await Promise.all([
        buf(images.voice ? proxied(images.voice) : `${base}/voice.mp3`),
        buf(`${base}/music.mp3`),
      ]);
      if (images.voice) t = retime(t, voiceBuf, book.trailer.map((l) => tell(l, cast, sisters)));
      const segs = segments(t);
      const outNode = ac.createGain();
      outNode.connect(ac.destination);
      const recDest = ac.createMediaStreamDestination();
      outNode.connect(recDest);

      const music = ac.createBufferSource();
      music.buffer = musicBuf;
      const duck = ac.createGain();
      const fade = ac.createGain();
      music.connect(duck).connect(fade).connect(outNode);
      const voice = ac.createBufferSource();
      voice.buffer = voiceBuf;
      const vGain = ac.createGain();
      vGain.gain.value = 1.4;
      const analyser = ac.createAnalyser();
      analyser.fftSize = 1024;
      voice.connect(vGain).connect(outNode);
      voice.connect(analyser);

      const t0 = ac.currentTime + 0.15;
      fade.gain.setValueAtTime(0, t0);
      fade.gain.linearRampToValueAtTime(0.8, t0 + 1.2);
      fade.gain.setValueAtTime(0.8, t0 + t.total - 3);
      fade.gain.linearRampToValueAtTime(0, t0 + t.total);
      music.start(t0);
      music.stop(t0 + t.total + 0.1);
      voice.start(t0 + t.leadIn);

      const canvas = $('trailer-canvas');
      canvas.hidden = false;
      canvas.scrollIntoView({ behavior: 'smooth', block: 'center' });
      const ctx = canvas.getContext('2d');
      let recorder, chunks = [];
      if (record) {
        const stream = new MediaStream([...canvas.captureStream(30).getVideoTracks(), ...recDest.stream.getAudioTracks()]);
        recorder = new MediaRecorder(stream, { mimeType: MediaRecorder.isTypeSupported('video/webm;codecs=vp9,opus') ? 'video/webm;codecs=vp9,opus' : 'video/webm' });
        recorder.ondataavailable = (e) => e.data.size && chunks.push(e.data);
        recorder.start();
      }
      $('out-status').textContent = record ? 'Recording… keep this tab open.' : '';

      const data = new Float32Array(analyser.fftSize);
      await new Promise((resolve) => {
        const frame = () => {
          const now = ac.currentTime - t0;
          // Sidechain-style ducking: follow the narrator's level and pull the music down under it.
          analyser.getFloatTimeDomainData(data);
          let rms = 0;
          for (const x of data) rms += x * x;
          rms = Math.sqrt(rms / data.length);
          duck.gain.setTargetAtTime(rms > 0.015 ? 0.28 : 1, ac.currentTime, rms > 0.015 ? 0.03 : 0.35);

          const seg = segs.find((s) => now >= s.start && now < s.end) || segs[segs.length - 1];
          const p = Math.min(1, Math.max(0, (now - seg.start) / (seg.end - seg.start)));
          ctx.fillStyle = '#000';
          ctx.fillRect(0, 0, W, H);
          if (seg.shot === 'title') drawTitle(ctx, pics[0], book, cast);
          else {
            drawCover(ctx, pics[seg.shot], p, seg.dir);
            if (seg.caption) drawCaption(ctx, seg.caption);
          }
          const edge = Math.min(now - seg.start, seg.end - now);
          if (edge < 0.25 && seg.shot !== 'title') { ctx.fillStyle = `rgba(0,0,0,${1 - edge / 0.25})`; ctx.fillRect(0, 0, W, H); }
          if (now < t.total) requestAnimationFrame(frame); else resolve();
        };
        requestAnimationFrame(frame);
      });

      if (recorder) {
        await new Promise((r) => { recorder.onstop = r; recorder.stop(); });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(new Blob(chunks, { type: 'video/webm' }));
        a.download = `${book.slug}-trailer.webm`;
        a.click();
        $('out-status').textContent = 'Trailer saved.';
      }
      await ac.close();
    } catch (err) {
      $('out-status').textContent = `Trailer failed: ${err.message}`;
    } finally {
      btns.forEach((b) => (b.disabled = false));
    }
  }
  $('play-trailer').addEventListener('click', () => playTrailer(false));
  $('rec-trailer').addEventListener('click', () => playTrailer(true));
</script>

