---
// /parasha — the hub for everything on the site that follows the weekly Torah reading.
// Data: src/data/parasha-hub.ts (joins the 5787 calendar to sheets, readers, books and tools).
import Layout from '../layouts/Layout.astro';
import { weeks, BOOKS, series, tools, dweckShow, dweckEpisodes, levyTheses, levyThesesIntro, bibleCoins, bibleCoinsCanon, coinsIntro, coinsCatalogUrl, type Link } from '../data/parasha-hub';

const fmt = (iso: string) =>
  new Date(`${iso}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });

// Build-time guess at "this week"; the script below re-picks it from the reader's own clock.
const today = new Date().toISOString().slice(0, 10);
const nextDate = weeks.find((w) => w.date >= today)?.date ?? weeks[0].date;
const thisWeek = weeks.filter((w) => w.date === nextDate);

const byBook = BOOKS.map((b) => ({ ...b, weeks: weeks.filter((w) => w.book === b.en) }));
const isExternal = (href: string) => href.startsWith('http');

// The This-week card groups its scholarly links so the two series never blur
// into one stack: PhDs on the Parsha (a guest scholar per week) on one side,
// the Levy theses (The History of a Verse) on the other; everything else is
// the plain resource list.
const groupLinks = (links: Link[]) => ({
  resources: links.filter((l) => l.kind !== 'phd' && l.kind !== 'thesis' && l.kind !== 'coin'),
  phd: links.filter((l) => l.kind === 'phd'),
  theses: links.filter((l) => l.kind === 'thesis'),
  coins: links.filter((l) => l.kind === 'coin'),
});
const thisWeekGrouped = thisWeek.map((w) => ({ w, ...groupLinks(w.links) }));

// Index of the Levy theses by parasha, in Torah order (weeks run in calendar
// order), for the "By parasha" line at the top of the theses section.
const parshaKey = (s: string) => {
  const k = s.toLowerCase().replace(/[^a-z]/g, '');
  return k === 'breishit' ? 'bereshit' : k; // the season data spells it Breishit
};
const weekOrder = new Map(weeks.map((w, i) => [parshaKey(w.parsha), i]));
const thesesByParasha = [...levyTheses].sort(
  (a, b) =>
    (weekOrder.get(parshaKey(a.parsha.replace(/\(.*\)/, ''))) ?? 999) -
    (weekOrder.get(parshaKey(b.parsha.replace(/\(.*\)/, ''))) ?? 999),
);
const surname = (author: string) => author.split(' ').pop() ?? author;

// Index of the parsha-attached coins, in Torah order, for the "By parasha"
// line at the top of the coins section.
const coinsByParasha = bibleCoins
  .filter((c) => c.attach)
  .sort((a, b) => (weekOrder.get(parshaKey(a.parsha ?? '')) ?? 999) - (weekOrder.get(parshaKey(b.parsha ?? '')) ?? 999));
const coinChip = (c: (typeof bibleCoins)[number]) =>
  c.attach === 'haftarah' ? `Haftara · ${c.parsha}` : c.attach === 'torah' ? `Parshat ${c.parsha}` : (c.association ?? '');
---

<Layout
  title="Parasha Hub"
  description="Everything on the site for the weekly Torah reading in one place: this week's parasha, the Uriel Simon Reader, parasha sheets, picture books, PhDs on the Parsha, and tools for every parasha."
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,600;1,400&family=Frank+Ruhl+Libre:wght@400;700&display=swap"
  />

  <main class="ph">
    <header class="ph-head">
      <div class="ph-kicker">The weekly Torah reading</div>
      <h1>Parasha Hub</h1>
      <p class="ph-lede">
        Every reader, sheet, book, episode and tool on this site that follows the parasha, in one place.
        Start with this week, or find any parasha in the year below.
      </p>
      <nav class="ph-jump" aria-label="On this page">
        <a href="#now">This week</a>
        <a href="#series">Readers &amp; series</a>
        <a href="#dweck">Rabbi Dweck on the haftara</a>
        <a href="#levy-theses">The Levy theses</a>
        <a href="#bible-coins">Bible coins</a>
        <a href="#tools">Tools</a>
        <a href="#year">Every parasha</a>
      </nav>
    </header>

    <section class="ph-now" id="now" aria-labelledby="ph-now-h">
      <h2 id="ph-now-h" class="ph-h2">This week</h2>
      <div id="ph-now">
        {thisWeekGrouped.map(({ w, resources, phd, theses, coins }) => (
          <article class="ph-week ph-week-big" data-date={w.date}>
            <div class="ph-week-top">
              <span class="he ph-he">{w.hebrew}</span>
              <span class="ph-name">{w.parsha}</span>
              <span class="ph-meta">{w.ref} · Shabbat {fmt(w.date)}</span>
            </div>
            <ul class="ph-links">
              {resources.map((l) => (
                <li>
                  <a class="ph-chip" href={l.href} {...(isExternal(l.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                    {l.label}
                    {isExternal(l.href) && <span class="ph-ext" aria-hidden="true">↗</span>}
                  </a>
                  {l.note && (l.noteHref ? (
                    <a class="ph-note ph-note-link" href={l.noteHref} target="_blank" rel="noopener noreferrer">
                      {l.note}
                      <span class="ph-ext" aria-hidden="true">↗</span>
                    </a>
                  ) : (
                    <span class="ph-note">{l.note}</span>
                  ))}
                </li>
              ))}
            </ul>
            {phd.length > 0 && (
              <div class="ph-group">
                <div class="ph-group-label">PhDs on the Parsha</div>
                <ul class="ph-links">
                  {phd.map((l) => (
                    <li>
                      <a class="ph-chip" href={l.href} {...(isExternal(l.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                        {l.label}
                        {isExternal(l.href) && <span class="ph-ext" aria-hidden="true">↗</span>}
                      </a>
                      {l.note && (l.noteHref ? (
                        <a class="ph-note ph-note-link" href={l.noteHref} target="_blank" rel="noopener noreferrer">
                          {l.note}
                          <span class="ph-ext" aria-hidden="true">↗</span>
                        </a>
                      ) : (
                        <span class="ph-note">{l.note}</span>
                      ))}
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {theses.length > 0 && (
              <div class="ph-group">
                <div class="ph-group-label">The History of a Verse · Levy theses</div>
                <ul class="ph-links">
                  {theses.map((l) => (
                    <li>
                      <a class="ph-chip" href={l.href} {...(isExternal(l.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                        {l.label}
                        {isExternal(l.href) && <span class="ph-ext" aria-hidden="true">↗</span>}
                      </a>
                      {l.note && (l.noteHref ? (
                        <a class="ph-note ph-note-link" href={l.noteHref} target="_blank" rel="noopener noreferrer">
                          {l.note}
                          <span class="ph-ext" aria-hidden="true">↗</span>
                        </a>
                      ) : (
                        <span class="ph-note">{l.note}</span>
                      ))}
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {coins.length > 0 && (
              <div class="ph-group">
                <div class="ph-group-label">Pictures from the Bible · Bank of Israel coins</div>
                <ul class="ph-links">
                  {coins.map((l) => (
                    <li>
                      <a class="ph-chip ph-chip-coin" href={l.href}>
                        {l.img && <img class="ph-coin-thumb" src={l.img} alt="" loading="lazy" />}
                        {l.label}
                      </a>
                      {l.note && (l.noteHref ? (
                        <a class="ph-note ph-note-link" href={l.noteHref} target="_blank" rel="noopener noreferrer">
                          {l.note}
                          <span class="ph-ext" aria-hidden="true">↗</span>
                        </a>
                      ) : (
                        <span class="ph-note">{l.note}</span>
                      ))}
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </article>
        ))}
      </div>
      <p class="ph-small">Dates follow the Israel reading schedule for 5787.</p>
    </section>

    <section id="series" aria-labelledby="ph-series-h">
      <h2 id="ph-series-h" class="ph-h2">Readers and series</h2>
      <div class="ph-grid">
        {series.map((s) => (
          <a class="ph-card" href={s.href}>
            <div class="ph-card-kind">{s.kind}</div>
            <div class="ph-card-name">{s.name}</div>
            <p>{s.text}</p>
          </a>
        ))}
      </div>
    </section>

    <section id="dweck" aria-labelledby="ph-dweck-h">
      <h2 id="ph-dweck-h" class="ph-h2">The Parasha with Rabbi Dweck: the haftara</h2>
      <p class="ph-dweck-lede">
        This year Rabbi Joseph Dweck is teaching the haftara, the prophetic reading that follows the parasha.
        Each verse he discusses is marked in the <a href="/mega-bible?mode=haftarah&parsha=Bereshit&rites=Sephardi">Mega Bible</a>,
        with a button that plays the episode from that moment.
      </p>
      {dweckEpisodes.map((ep) => (
        <article class="ph-dweck" id={`dweck-${ep.slug}`}>
          <div class="ph-week-top">
            <span class="ph-name">“{ep.title}”</span>
            <span class="ph-meta">Haftarat {ep.parsha} · {ep.haftara} · {ep.duration}</span>
          </div>
          <p class="ph-dweck-sum">{ep.summary}</p>
          <iframe
            src={ep.embed}
            title={`${dweckShow.name}: ${ep.title}`}
            height="102"
            loading="lazy"
            frameborder="0"
            scrolling="no"
          ></iframe>
          <ul class="ph-links">
            <li><a class="ph-chip ph-chip-primary" href={`/mega-bible?mode=haftarah&parsha=${encodeURIComponent(ep.parsha)}&rites=Sephardi`}>Read it in the Mega Bible</a></li>
            <li><a class="ph-chip" href={ep.spotify} target="_blank" rel="noopener noreferrer">Spotify<span class="ph-ext" aria-hidden="true">↗</span></a></li>
            <li><a class="ph-chip" href={ep.apple} target="_blank" rel="noopener noreferrer">Apple Podcasts<span class="ph-ext" aria-hidden="true">↗</span></a></li>
          </ul>
        </article>
      ))}
      <p class="ph-small">
        All episodes: <a href={dweckShow.spotify} target="_blank" rel="noopener noreferrer">Spotify</a> ·
        <a href={dweckShow.apple} target="_blank" rel="noopener noreferrer">Apple Podcasts</a>
      </p>
    </section>

    <section id="levy-theses" class="ph-levy" aria-labelledby="ph-levy-h">
      <h2 id="ph-levy-h" class="ph-h2">The History of a Verse: the Levy theses</h2>
      <p class="ph-dweck-lede">{levyThesesIntro}</p>
      <p class="ph-byparasha">
        <span class="ph-byparasha-label">By parasha:</span>
        {thesesByParasha.map((t, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> · </span>}
            <a href={`#${t.anchor}`}>{t.parsha} — {surname(t.author)} ({t.ref})</a>
          </>
        ))}
      </p>
      <div class="ph-thesis-grid">
        {levyTheses.map((t) => (
          <article class="ph-thesis-card" id={t.anchor}>
            <div class="ph-thesis-top">
              <span class="ph-thesis-author">{t.author}</span>
              <span class="ph-year">McGill M.A. {t.year}</span>
            </div>
            <p class="ph-thesis-title">
              <a href={t.url} target="_blank" rel="noopener noreferrer">“{t.title}”<span class="ph-ext" aria-hidden="true">↗</span></a>
            </p>
            <p class="ph-thesis-meta">
              <a class="ph-ref-link" href={`/mega-bible?book=${t.book}&chapter=${t.chapter}`}>{t.ref}</a>
              <span class="ph-parsha-chip">Parshat {t.parsha}</span>
            </p>
            <p class="ph-thesis-blurb">{t.blurb}</p>
            <ul class="ph-links">
              <li><a class="ph-chip ph-chip-primary" href={`/mega-bible?book=${t.book}&chapter=${t.chapter}`}>Read the passage in the Mega Bible</a></li>
              <li><a class="ph-chip" href={t.url} target="_blank" rel="noopener noreferrer">{t.urlLabel}<span class="ph-ext" aria-hidden="true">↗</span></a></li>
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section id="bible-coins" class="ph-coins" aria-labelledby="ph-coins-h">
      <h2 id="ph-coins-h" class="ph-h2">Pictures from the Bible: the Bank of Israel coins</h2>
      <p class="ph-dweck-lede">{coinsIntro}</p>
      <p class="ph-byparasha">
        <span class="ph-byparasha-label">By parasha:</span>
        {coinsByParasha.map((c, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> · </span>}
            <a href={`#${c.anchor}`}>{c.parsha} — {c.year} ({c.ref})</a>
          </>
        ))}
      </p>
      <div class="ph-coin-grid">
        {bibleCoinsCanon.map((c) => (
          <article class="ph-coin-card" id={c.anchor}>
            <img class="ph-coin-img" src={`/images/coins/${c.image}`} alt={`Bank of Israel coin, ${c.year}: ${c.name_en}`} loading="lazy" />
            <div class="ph-coin-body">
              <div class="ph-thesis-top">
                <span class="ph-thesis-author">{c.name_en}</span>
                <span class="ph-year">BOI {c.year}</span>
              </div>
              <p class="ph-coin-he"><span class="he">{c.name_he}</span></p>
              <p class="ph-thesis-meta">
                <a class="ph-ref-link" href={`/mega-bible?book=${c.book}&chapter=${c.chapter}`}>{c.ref}</a>
                {coinChip(c) && <span class="ph-parsha-chip">{coinChip(c)}</span>}
              </p>
              <p class="ph-thesis-blurb">{c.note}</p>
              <p class="ph-coin-inferred">Verse mapping inferred — the Bank's catalog names the scene, not the passage.</p>
              <ul class="ph-links">
                <li><a class="ph-chip ph-chip-primary" href={`/mega-bible?book=${c.book}&chapter=${c.chapter}`}>Read the passage in the Mega Bible</a></li>
                <li><a class="ph-chip" href={c.boi_url} target="_blank" rel="noopener noreferrer">Bank of Israel catalog<span class="ph-ext" aria-hidden="true">↗</span></a></li>
              </ul>
            </div>
          </article>
        ))}
      </div>
      <p class="ph-coins-more">
        <a class="ph-chip ph-chip-primary" href="/bible-coins">See all 29 coins and their connections →</a>
        <a class="ph-chip" href={coinsCatalogUrl} target="_blank" rel="noopener noreferrer">The full series at the Bank of Israel<span class="ph-ext" aria-hidden="true">↗</span></a>
      </p>
    </section>

    <section id="tools" aria-labelledby="ph-tools-h">
      <h2 id="ph-tools-h" class="ph-h2">Tools for any parasha</h2>
      <div class="ph-grid ph-grid-tools">
        {tools.map((t) => (
          <a class="ph-card ph-card-tool" href={t.href}>
            <div class="ph-card-name">{t.name}</div>
            <p>{t.text}</p>
          </a>
        ))}
      </div>
    </section>

    <section id="year" aria-labelledby="ph-year-h">
      <h2 id="ph-year-h" class="ph-h2">Every parasha, 5787</h2>
      {byBook.map((b) => (
        <div class="ph-book">
          <h3><span class="he">{b.he}</span> {b.name} <span class="ph-book-en">{b.en}</span></h3>
          {b.weeks.map((w) => (
            <article class="ph-week" id={`p-${w.n}`} data-date={w.date}>
              <div class="ph-week-top">
                <span class="he ph-he">{w.hebrew}</span>
                <span class="ph-name">{w.parsha}</span>
                <span class="ph-meta">{w.ref} · {fmt(w.date)}</span>
              </div>
              <ul class="ph-links">
                {w.links.filter((l) => l.kind !== 'thesis' && l.kind !== 'coin').map((l) => (
                  <li>
                    <a class="ph-chip" href={l.href} title={l.note} {...(isExternal(l.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                      {l.label}
                      {isExternal(l.href) && <span class="ph-ext" aria-hidden="true">↗</span>}
                    </a>
                    {l.note && l.noteHref && (
                      <a class="ph-note ph-note-link" href={l.noteHref} target="_blank" rel="noopener noreferrer">
                        {l.note}
                        <span class="ph-ext" aria-hidden="true">↗</span>
                      </a>
                    )}
                  </li>
                ))}
              </ul>
              {w.links.some((l) => l.kind === 'thesis') && (
                <div class="ph-thesis-group">
                  <div class="ph-group-label">The History of a Verse · Levy theses</div>
                  <ul class="ph-thesis-lines">
                    {w.links.filter((l) => l.kind === 'thesis').map((l) => (
                      <li><a href={l.href}>{l.note}</a></li>
                    ))}
                  </ul>
                </div>
              )}
              {w.links.some((l) => l.kind === 'coin') && (
                <div class="ph-thesis-group">
                  <div class="ph-group-label">Pictures from the Bible · Bank of Israel coins</div>
                  <ul class="ph-thesis-lines">
                    {w.links.filter((l) => l.kind === 'coin').map((l) => (
                      <li class="ph-coin-line">
                        {l.img && <img class="ph-coin-thumb" src={l.img} alt="" loading="lazy" />}
                        <a href={l.href}>{l.note}</a>
                        {l.noteHref && (
                          <a class="ph-coin-boi" href={l.noteHref} target="_blank" rel="noopener noreferrer">Bank of Israel<span class="ph-ext" aria-hidden="true">↗</span></a>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </article>
          ))}
        </div>
      ))}
    </section>
  </main>
</Layout>

<script>
  // Re-pick "this week" from the reader's clock (the page is built once a night at most):
  // the first Shabbat on or after today, which may cover two parshiyot read together.
  const today = new Date();
  const iso = new Date(today.getTime() - today.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.ph-book .ph-week'));
  const next = rows.find((r) => (r.dataset.date ?? '') >= iso)?.dataset.date;
  const now = document.getElementById('ph-now');
  const shown = now?.querySelector<HTMLElement>('.ph-week')?.dataset.date;
  if (now && next && next !== shown) {
    now.replaceChildren(
      ...rows.filter((r) => r.dataset.date === next).map((r) => {
        const c = r.cloneNode(true) as HTMLElement;
        c.removeAttribute('id');
        c.classList.add('ph-week-big');
        return c;
      }),
    );
  }
  rows.filter((r) => r.dataset.date === next).forEach((r) => r.classList.add('ph-current'));

  // --- Reliable anchor landings --------------------------------------------
  // Two failure modes seen live: the ViewTransitions router turns a same-page
  // absolute link (/parasha#levy-brodt) into a navigation that strips the
  // fragment, and on a fresh load the browser's first jump can be undone by
  // layout shift when the webfonts swap in. So: re-scroll to the hash target
  // once layout settles (rAF + fonts.ready + window load), follow hashchange,
  // and intercept clicks on same-page anchor links — fragment or absolute
  // form — with a smooth scrollIntoView (which honours the targets'
  // scroll-margin-top) instead of letting the router navigate.
  const scrollToHash = (smooth = false) => {
    if (!location.hash) return;
    let id = location.hash.slice(1);
    try { id = decodeURIComponent(id); } catch { /* keep the raw id */ }
    document.getElementById(id)?.scrollIntoView({ block: 'start', behavior: smooth ? 'smooth' : 'auto' });
  };
  if (location.hash) {
    requestAnimationFrame(() => setTimeout(() => scrollToHash(), 50));
    if (document.fonts?.ready) document.fonts.ready.then(() => scrollToHash());
    window.addEventListener('load', () => scrollToHash());
  }
  const phWin = window as unknown as { __phAnchorInit?: boolean };
  if (!phWin.__phAnchorInit) {
    phWin.__phAnchorInit = true;
    window.addEventListener('hashchange', () => scrollToHash(true));
    document.addEventListener('click', (e) => {
      const a = (e.target as Element | null)?.closest<HTMLAnchorElement>('a[href]');
      if (!a) return;
      const url = new URL(a.href, location.href);
      if (url.origin === location.origin && url.pathname === location.pathname && url.hash) {
        e.preventDefault();
        e.stopPropagation();
        if (location.hash !== url.hash) history.pushState(null, '', url.hash);
        scrollToHash(true);
      }
    }, true);
  }
</script>

<style>
  .ph {
    max-width: 62rem; margin: 0 auto; padding: 3rem 1rem 4.5rem;
    font-family: 'EB Garamond', Georgia, serif; color: #e7e3da;
  }
  :global(.dark) .ph :global(*) { color: inherit; }
  .ph :global(.he) { font-family: 'Frank Ruhl Libre', serif; direction: rtl; unicode-bidi: isolate; }
  .ph section { scroll-margin-top: 6.5rem; }
  .ph a:focus-visible { outline: 2px solid #d8b06a; outline-offset: 2px; border-radius: 4px; }

  /* ---- Header ---- */
  .ph-head { padding-bottom: 1.5rem; border-bottom: 1px solid #2c3036; position: relative; }
  .ph-head::after {
    content: ''; position: absolute; left: 0; bottom: -1px; height: 2px; width: min(16rem, 60%);
    background: linear-gradient(90deg, #d8b06a, rgba(216, 176, 106, 0));
  }
  .ph-kicker { font-size: .75rem; letter-spacing: .18em; text-transform: uppercase; color: #d8b06a !important; }
  h1 { font-size: 2.9rem; font-weight: 600; line-height: 1.08; margin: .35rem 0 .75rem; color: #f2ecdf !important; }
  .ph-lede { font-size: 1.22rem; line-height: 1.55; max-width: 44rem; color: #d4cfc5 !important; margin: 0; }
  .ph-jump { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: 1.35rem; }
  .ph-jump a {
    font-size: .86rem; padding: .32rem .85rem; border-radius: 999px; text-decoration: none; line-height: 1.35;
    border: 1px solid #54492c; color: #ece5d3 !important; background: #1b1f23;
    transition: border-color .15s, color .15s, transform .15s;
  }
  .ph-jump a:hover { border-color: #d8b06a; color: #f0dc9c !important; transform: translateY(-1px); }

  /* ---- Section headings ---- */
  .ph-h2 {
    display: flex; align-items: center; gap: .9rem;
    font-size: 1.6rem; font-weight: 600; line-height: 1.2; letter-spacing: 0; text-transform: none;
    color: #f0e9db !important; margin: 3.4rem 0 1.15rem; padding: 0; border: 0;
  }
  .ph-h2::before { content: ''; flex: none; width: 2.1rem; height: 2px; background: #d8b06a; }
  .ph-h2::after {
    content: ''; flex: 1; height: 1px; min-width: 2rem;
