---
// /parasha — the hub for everything on the site that follows the weekly Torah reading.
// Data: src/data/parasha-hub.ts (joins the 5787 calendar to sheets, readers, books and tools).
import Layout from '../layouts/Layout.astro';
import { weeks, BOOKS, series, tools, dweckShow, dweckEpisodes, levyTheses, levyThesesIntro } from '../data/parasha-hub';

const fmt = (iso: string) =>
  new Date(`${iso}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });

// Build-time guess at "this week"; the script below re-picks it from the reader's own clock.
const today = new Date().toISOString().slice(0, 10);
const nextDate = weeks.find((w) => w.date >= today)?.date ?? weeks[0].date;
const thisWeek = weeks.filter((w) => w.date === nextDate);

const byBook = BOOKS.map((b) => ({ ...b, weeks: weeks.filter((w) => w.book === b.en) }));
const isExternal = (href: string) => href.startsWith('http');
---

<Layout
  title="Parasha Hub"
  description="Everything on the site for the weekly Torah reading in one place: this week's parasha, the Uriel Simon Reader, parasha sheets, picture books, PhDs on the Parsha, and tools for every parasha."
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,600;1,400&family=Frank+Ruhl+Libre:wght@400;700&display=swap"
  />

  <main class="ph">
    <header class="ph-head">
      <div class="ph-kicker">The weekly Torah reading</div>
      <h1>Parasha Hub</h1>
      <p class="ph-lede">
        Every reader, sheet, book, episode and tool on this site that follows the parasha, in one place.
        Start with this week, or find any parasha in the year below.
      </p>
      <nav class="ph-jump" aria-label="On this page">
        <a href="#now">This week</a>
        <a href="#series">Readers &amp; series</a>
        <a href="#dweck">Rabbi Dweck on the haftara</a>
        <a href="#levy-theses">The Levy theses</a>
        <a href="#tools">Tools</a>
        <a href="#year">Every parasha</a>
      </nav>
    </header>

    <section class="ph-now" id="now" aria-labelledby="ph-now-h">
      <h2 id="ph-now-h" class="ph-h2">This week</h2>
      <div id="ph-now">
        {thisWeek.map((w) => (
          <article class="ph-week ph-week-big" data-date={w.date}>
            <div class="ph-week-top">
              <span class="he ph-he">{w.hebrew}</span>
              <span class="ph-name">{w.parsha}</span>
              <span class="ph-meta">{w.ref} · Shabbat {fmt(w.date)}</span>
            </div>
            <ul class="ph-links">
              {w.links.map((l) => (
                <li>
                  <a class="ph-chip" href={l.href} {...(isExternal(l.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                    {l.label}
                    {isExternal(l.href) && <span class="ph-ext" aria-hidden="true">↗</span>}
                  </a>
                  {l.note && (l.noteHref ? (
                    <a class="ph-note ph-note-link" href={l.noteHref} target="_blank" rel="noopener noreferrer">
                      {l.note}
                      <span class="ph-ext" aria-hidden="true">↗</span>
                    </a>
                  ) : (
                    <span class="ph-note">{l.note}</span>
                  ))}
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
      <p class="ph-small">Dates follow the Israel reading schedule for 5787.</p>
    </section>

    <section id="series" aria-labelledby="ph-series-h">
      <h2 id="ph-series-h" class="ph-h2">Readers and series</h2>
      <div class="ph-grid">
        {series.map((s) => (
          <a class="ph-card" href={s.href}>
            <div class="ph-card-kind">{s.kind}</div>
            <div class="ph-card-name">{s.name}</div>
            <p>{s.text}</p>
          </a>
        ))}
      </div>
    </section>

    <section id="dweck" aria-labelledby="ph-dweck-h">
      <h2 id="ph-dweck-h" class="ph-h2">The Parasha with Rabbi Dweck: the haftara</h2>
      <p class="ph-dweck-lede">
        This year Rabbi Joseph Dweck is teaching the haftara, the prophetic reading that follows the parasha.
        Each verse he discusses is marked in the <a href="/mega-bible?mode=haftarah&parsha=Bereshit&rites=Sephardi">Mega Bible</a>,
        with a button that plays the episode from that moment.
      </p>
      {dweckEpisodes.map((ep) => (
        <article class="ph-dweck" id={`dweck-${ep.slug}`}>
          <div class="ph-week-top">
            <span class="ph-name">“{ep.title}”</span>
            <span class="ph-meta">Haftarat {ep.parsha} · {ep.haftara} · {ep.duration}</span>
          </div>
          <p class="ph-dweck-sum">{ep.summary}</p>
          <iframe
            src={ep.embed}
            title={`${dweckShow.name}: ${ep.title}`}
            height="102"
            loading="lazy"
            frameborder="0"
            scrolling="no"
          ></iframe>
          <ul class="ph-links">
            <li><a class="ph-chip ph-chip-primary" href={`/mega-bible?mode=haftarah&parsha=${encodeURIComponent(ep.parsha)}&rites=Sephardi`}>Read it in the Mega Bible</a></li>
            <li><a class="ph-chip" href={ep.spotify} target="_blank" rel="noopener noreferrer">Spotify<span class="ph-ext" aria-hidden="true">↗</span></a></li>
            <li><a class="ph-chip" href={ep.apple} target="_blank" rel="noopener noreferrer">Apple Podcasts<span class="ph-ext" aria-hidden="true">↗</span></a></li>
          </ul>
        </article>
      ))}
      <p class="ph-small">
        All episodes: <a href={dweckShow.spotify} target="_blank" rel="noopener noreferrer">Spotify</a> ·
        <a href={dweckShow.apple} target="_blank" rel="noopener noreferrer">Apple Podcasts</a>
      </p>
    </section>

    <section id="levy-theses" class="ph-levy" aria-labelledby="ph-levy-h">
      <h2 id="ph-levy-h" class="ph-h2">The History of a Verse: the Levy theses</h2>
      <p class="ph-dweck-lede">{levyThesesIntro}</p>
      <div class="ph-thesis-grid">
        {levyTheses.map((t) => (
          <article class="ph-thesis-card" id={t.anchor}>
            <div class="ph-thesis-top">
              <span class="ph-thesis-author">{t.author}</span>
              <span class="ph-year">McGill M.A. {t.year}</span>
            </div>
            <p class="ph-thesis-title">
              <a href={t.url} target="_blank" rel="noopener noreferrer">“{t.title}”<span class="ph-ext" aria-hidden="true">↗</span></a>
            </p>
            <p class="ph-thesis-meta">
              <a class="ph-ref-link" href={`/mega-bible?book=${t.book}&chapter=${t.chapter}`}>{t.ref}</a>
              <span aria-hidden="true">·</span> {t.parsha}
            </p>
            <p class="ph-thesis-blurb">{t.blurb}</p>
            <ul class="ph-links">
              <li><a class="ph-chip ph-chip-primary" href={`/mega-bible?book=${t.book}&chapter=${t.chapter}`}>Read the passage in the Mega Bible</a></li>
              <li><a class="ph-chip" href={t.url} target="_blank" rel="noopener noreferrer">{t.urlLabel}<span class="ph-ext" aria-hidden="true">↗</span></a></li>
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section id="tools" aria-labelledby="ph-tools-h">
      <h2 id="ph-tools-h" class="ph-h2">Tools for any parasha</h2>
      <div class="ph-grid ph-grid-tools">
        {tools.map((t) => (
          <a class="ph-card ph-card-tool" href={t.href}>
            <div class="ph-card-name">{t.name}</div>
            <p>{t.text}</p>
          </a>
        ))}
      </div>
    </section>

    <section id="year" aria-labelledby="ph-year-h">
      <h2 id="ph-year-h" class="ph-h2">Every parasha, 5787</h2>
      {byBook.map((b) => (
        <div class="ph-book">
          <h3><span class="he">{b.he}</span> {b.name} <span class="ph-book-en">{b.en}</span></h3>
          {b.weeks.map((w) => (
            <article class="ph-week" id={`p-${w.n}`} data-date={w.date}>
              <div class="ph-week-top">
                <span class="he ph-he">{w.hebrew}</span>
                <span class="ph-name">{w.parsha}</span>
                <span class="ph-meta">{w.ref} · {fmt(w.date)}</span>
              </div>
              <ul class="ph-links">
                {w.links.map((l) => (
                  <li>
                    <a class="ph-chip" href={l.href} title={l.note} {...(isExternal(l.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                      {l.label}
                      {isExternal(l.href) && <span class="ph-ext" aria-hidden="true">↗</span>}
                    </a>
                    {l.note && l.noteHref && (
                      <a class="ph-note ph-note-link" href={l.noteHref} target="_blank" rel="noopener noreferrer">
                        {l.note}
                        <span class="ph-ext" aria-hidden="true">↗</span>
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      ))}
    </section>
  </main>
</Layout>

<script>
  // Re-pick "this week" from the reader's clock (the page is built once a night at most):
  // the first Shabbat on or after today, which may cover two parshiyot read together.
  const today = new Date();
  const iso = new Date(today.getTime() - today.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.ph-book .ph-week'));
  const next = rows.find((r) => (r.dataset.date ?? '') >= iso)?.dataset.date;
  const now = document.getElementById('ph-now');
  const shown = now?.querySelector<HTMLElement>('.ph-week')?.dataset.date;
  if (now && next && next !== shown) {
    now.replaceChildren(
      ...rows.filter((r) => r.dataset.date === next).map((r) => {
        const c = r.cloneNode(true) as HTMLElement;
        c.removeAttribute('id');
        c.classList.add('ph-week-big');
        return c;
      }),
    );
  }
  rows.filter((r) => r.dataset.date === next).forEach((r) => r.classList.add('ph-current'));
</script>

<style>
  .ph {
    max-width: 62rem; margin: 0 auto; padding: 3rem 1rem 4.5rem;
    font-family: 'EB Garamond', Georgia, serif; color: #e7e3da;
  }
  :global(.dark) .ph :global(*) { color: inherit; }
  .ph :global(.he) { font-family: 'Frank Ruhl Libre', serif; direction: rtl; unicode-bidi: isolate; }
  .ph section { scroll-margin-top: 4.5rem; }
  .ph a:focus-visible { outline: 2px solid #d8b06a; outline-offset: 2px; border-radius: 4px; }

  /* ---- Header ---- */
  .ph-head { padding-bottom: 1.5rem; border-bottom: 1px solid #2c3036; position: relative; }
  .ph-head::after {
    content: ''; position: absolute; left: 0; bottom: -1px; height: 2px; width: min(16rem, 60%);
    background: linear-gradient(90deg, #d8b06a, rgba(216, 176, 106, 0));
  }
  .ph-kicker { font-size: .75rem; letter-spacing: .18em; text-transform: uppercase; color: #d8b06a !important; }
  h1 { font-size: 2.9rem; font-weight: 600; line-height: 1.08; margin: .35rem 0 .75rem; color: #f2ecdf !important; }
  .ph-lede { font-size: 1.22rem; line-height: 1.55; max-width: 44rem; color: #d4cfc5 !important; margin: 0; }
  .ph-jump { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: 1.35rem; }
  .ph-jump a {
    font-size: .86rem; padding: .32rem .85rem; border-radius: 999px; text-decoration: none; line-height: 1.35;
    border: 1px solid #54492c; color: #ece5d3 !important; background: #1b1f23;
    transition: border-color .15s, color .15s, transform .15s;
  }
  .ph-jump a:hover { border-color: #d8b06a; color: #f0dc9c !important; transform: translateY(-1px); }

  /* ---- Section headings ---- */
  .ph-h2 {
    display: flex; align-items: center; gap: .9rem;
    font-size: 1.6rem; font-weight: 600; line-height: 1.2; letter-spacing: 0; text-transform: none;
    color: #f0e9db !important; margin: 3.4rem 0 1.15rem; padding: 0; border: 0;
  }
  .ph-h2::before { content: ''; flex: none; width: 2.1rem; height: 2px; background: #d8b06a; }
  .ph-h2::after {
    content: ''; flex: 1; height: 1px; min-width: 2rem;
    background: linear-gradient(90deg, rgba(216, 176, 106, .45), rgba(216, 176, 106, 0));
  }
  .ph-small { font-size: .9rem; color: #9aa0a7 !important; margin-top: .6rem; }
  .ph-small a, .ph-dweck-lede a { color: #d8b06a !important; text-underline-offset: 3px; }
  .ph-small a:hover, .ph-dweck-lede a:hover { color: #f0dc9c !important; }

  /* ---- Week rows ---- */
  .ph-week { padding: .85rem .6rem; border-bottom: 1px solid #2c3036; border-radius: 8px; scroll-margin-top: 5rem; transition: background .15s; }
  .ph-week:hover { background: rgba(231, 227, 218, .025); }
  .ph-week-top { display: flex; flex-wrap: wrap; align-items: baseline; gap: .3rem .8rem; }
  .ph-he { font-size: 1.35rem; font-weight: 700; }
  .ph-name { font-size: 1.12rem; font-weight: 600; }
  .ph-meta { font-size: .88rem; color: #9aa0a7 !important; }
  .ph-current { background: linear-gradient(90deg, rgba(216, 176, 106, .1), transparent 70%); }
  .ph-current .ph-name::after { content: ' · this week'; font-size: .78rem; color: #d8b06a !important; font-weight: 400; }

  #ph-now .ph-week {
    padding: 1.15rem 1.3rem; border: 1px solid #4a4130; border-radius: 10px; margin-bottom: .75rem;
    background: linear-gradient(180deg, #201d17, #1a1813); box-shadow: 0 6px 24px rgba(0, 0, 0, .28);
  }
  #ph-now .ph-week:hover { background: linear-gradient(180deg, #201d17, #1a1813); }
  #ph-now .ph-he { font-size: 2rem; }
  #ph-now .ph-name { font-size: 1.5rem; }
  #ph-now .ph-current .ph-name::after, #ph-now .ph-name::after { content: none; }

  /* ---- Link chips: ONE system, two variants ----
     Secondary (default .ph-chip): gold-outline on dark, shared by every link
     chip on the page and by the jump-nav pills (.ph-jump a uses the same box).
     Primary (.ph-chip-primary): filled gold — only the "read it here" action
     in the feature cards (Rabbi Dweck episodes, Levy theses).
     No per-kind colours anywhere. */
  .ph-links { list-style: none; padding: 0; margin: .55rem 0 0; display: flex; flex-wrap: wrap; gap: .4rem .5rem; }
  .ph-chip {
    display: inline-block; padding: .32rem .85rem; border-radius: 999px; font-size: .86rem; line-height: 1.35;
    text-decoration: none; border: 1px solid #54492c; color: #ece5d3 !important; background: #1b1f23;
    white-space: nowrap; transition: border-color .15s, color .15s, background .15s, transform .15s, box-shadow .15s;
  }
  a.ph-chip:hover { border-color: #d8b06a; color: #f0dc9c !important; transform: translateY(-1px); box-shadow: 0 3px 10px rgba(0, 0, 0, .3); }
  .ph-chip-primary { background: linear-gradient(180deg, #e3bd77, #d3a95e); border-color: #d8b06a; color: #241a05 !important; font-weight: 600; }
  a.ph-chip-primary:hover { background: linear-gradient(180deg, #eecf92, #dbb46c); border-color: #eecf92; color: #241a05 !important; }
  .ph-chip .ph-ext { margin-left: .3rem; }

  /* ---- Notes: each resource in the This-week card is its own row — chip on
     its own line, its description beneath it in muted italic. In the year list
     only notes that are links render (plain notes stay off, as before). ---- */
  #ph-now .ph-links { flex-direction: column; gap: 1rem; margin-top: .9rem; }
  #ph-now .ph-links li { display: flex; flex-direction: column; align-items: flex-start; gap: .3rem; }
  .ph-note { font-size: .97rem; font-style: italic; line-height: 1.45; color: #b9b4aa !important; }
  .ph-book a.ph-note-link { margin-left: .3rem; }
  a.ph-note-link {
    text-decoration: underline; text-decoration-color: rgba(216, 176, 106, .45); text-underline-offset: 3px;
    transition: color .15s, text-decoration-color .15s;
  }
  a.ph-note-link:hover { color: #f0dc9c !important; text-decoration-color: #d8b06a; }

  /* ---- Series & tool cards ---- */
  .ph-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: .9rem; }
  .ph-card {
    display: block; padding: 1.05rem 1.15rem; border: 1px solid #3a3f45; border-radius: 10px;
    background: linear-gradient(180deg, #1c1f24, #17191d); text-decoration: none;
    transition: border-color .15s, transform .15s, box-shadow .15s;
  }
  .ph-card:hover { border-color: #d8b06a; transform: translateY(-2px); box-shadow: 0 8px 22px rgba(0, 0, 0, .32); }
  .ph-card-kind { font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; color: #d8b06a !important; }
  .ph-card-name { font-size: 1.25rem; font-weight: 600; margin: .15rem 0 .3rem; color: #f0e9db !important; }
  .ph-card p { font-size: .97rem; line-height: 1.45; color: #b9b4aa !important; margin: 0; }
  .ph-card-tool .ph-card-name { font-size: 1.1rem; }

  /* ---- Dweck ---- */
  .ph-dweck-lede { font-size: 1.08rem; line-height: 1.55; max-width: 46rem; color: #d4cfc5 !important; margin: 0 0 1.1rem; }
  .ph-dweck {
    padding: 1.05rem 1.3rem; border: 1px solid #3a3f45; border-radius: 10px; margin-bottom: .9rem;
    background: linear-gradient(180deg, #1c1f24, #17191d); scroll-margin-top: 5rem;
  }
  .ph-dweck:target { border-color: #d8b06a; box-shadow: 0 0 0 1px #d8b06a; }
  .ph-dweck-sum { font-size: 1rem; line-height: 1.5; color: #b9b4aa !important; margin: .4rem 0 .7rem; }
  .ph-dweck iframe { display: block; width: 100%; max-width: 40rem; border: 0; border-radius: 8px; }

  /* ---- The Levy theses ---- */
  .ph-thesis-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 27rem), 1fr)); gap: .9rem; }
  .ph-thesis-card {
    display: flex; flex-direction: column; padding: 1.1rem 1.25rem 1.2rem;
    border: 1px solid #3a3f45; border-left: 3px solid #b28c46; border-radius: 10px;
    background: linear-gradient(180deg, #1b2026, #16181c); scroll-margin-top: 5rem;
    transition: border-color .15s, box-shadow .15s;
  }
  .ph-thesis-card:target { border-color: #d8b06a; box-shadow: 0 0 0 1px #d8b06a; }
  .ph-thesis-top { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .3rem .8rem; }
  .ph-thesis-author { font-size: 1.18rem; font-weight: 600; color: #f0e9db !important; }
  .ph-year {
    font-size: .74rem; letter-spacing: .1em; text-transform: uppercase; white-space: nowrap;
    padding: .14rem .55rem; border-radius: 999px; border: 1px solid #54492c; color: #ece5d3 !important; background: #1b1f23;
  }
  .ph-thesis-title { font-size: 1.06rem; font-style: italic; line-height: 1.45; margin: .5rem 0 .15rem; }
  .ph-thesis-title a { color: #e7e3da !important; text-decoration: underline; text-decoration-color: rgba(216, 176, 106, .5); text-underline-offset: 3px; transition: color .15s, text-decoration-color .15s; }
  .ph-thesis-title a:hover { color: #f0dc9c !important; text-decoration-color: #d8b06a; }
  .ph-ext { font-style: normal; font-size: .78em; color: #d8b06a !important; margin-left: .25rem; }
  .ph-thesis-meta { font-size: .92rem; color: #9aa0a7 !important; margin: .1rem 0 0; }
  .ph-ref-link { color: #e3c98f !important; text-decoration: underline; text-decoration-color: rgba(216, 176, 106, .45); text-underline-offset: 3px; }
  .ph-ref-link:hover { color: #d8b06a !important; text-decoration-color: #d8b06a; }
  .ph-thesis-blurb { font-size: 1rem; line-height: 1.5; color: #b9b4aa !important; margin: .45rem 0 .8rem; flex: 1; }
  .ph-thesis-card .ph-links { margin-top: auto; }

  /* ---- Year ---- */
  .ph-book h3 { font-size: 1.4rem; font-weight: 600; margin: 1.9rem 0 .35rem; color: #f0e9db !important; }
  .ph-book-en { font-size: .92rem; color: #8f949b !important; font-weight: 400; }

  @media (max-width: 640px) {
    .ph { padding: 2.25rem .9rem 3.5rem; }
    h1 { font-size: 2.15rem; }
    .ph-lede { font-size: 1.1rem; }
    .ph-h2 { font-size: 1.32rem; margin: 2.6rem 0 1rem; gap: .65rem; }
    .ph-h2::before { width: 1.4rem; }
    .ph-jump a { font-size: .82rem; padding: .3rem .75rem; }
    .ph-chip { font-size: .82rem; padding: .3rem .75rem; }
    #ph-now .ph-week { padding: 1rem 1.05rem; }
    #ph-now .ph-he { font-size: 1.6rem; }
    #ph-now .ph-name { font-size: 1.3rem; }
    #ph-now .ph-meta { flex-basis: 100%; }
    #ph-now .ph-note { font-size: .94rem; }
    .ph-dweck { padding: .95rem 1.05rem; }
    .ph-thesis-card { padding: .95rem 1.05rem 1.05rem; }
    .ph-thesis-author { font-size: 1.1rem; }
    .ph-week { padding: .8rem .35rem; }
  }
</style>
