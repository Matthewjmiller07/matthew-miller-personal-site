---
// src/pages/pistachios-debug.astro
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

console.log('=== PISTACHIOS DEBUG INFO ===');
console.log('Supabase URL:', import.meta.env.PUBLIC_SUPABASE_URL);
console.log('Supabase Key exists:', !!import.meta.env.PUBLIC_SUPABASE_ANON_KEY);

// Test basic connection first
const { data: testData, error: testError } = await supabase
  .from('Pistachios')
  .select('count')
  .single();

console.log('Table connection test:');
console.log('- Test Error:', testError);
console.log('- Test Data:', testData);

// Get table schema/info
const { data: schemaData, error: schemaError } = await supabase
  .from('Pistachios')
  .select('*')
  .limit(1);

console.log('Schema test:');
console.log('- Schema Error:', schemaError);
console.log('- Sample data exists:', schemaData && schemaData.length > 0);
if (schemaData && schemaData.length > 0) {
  console.log('- Available columns:', Object.keys(schemaData[0]));
}

// Then try the actual query
let { data: pistachios, error } = await supabase
  .from('Pistachios')
  .select('*')
  .order('source_id', { ascending: true })
  .limit(5);

console.log('Main query results:');
console.log('- Error:', error);
console.log('- Data length:', pistachios ? pistachios.length : 0);
if (pistachios && pistachios.length > 0) {
  console.log('- First record:', pistachios[0]);
}

if (error) {
  console.error('Error fetching pistachios:', error);
  pistachios = [];
}

const pageTitle = 'Pistachios Debug';
---

<Layout title={pageTitle}>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-6">{pageTitle}</h1>
    
    <div class="bg-yellow-100 dark:bg-yellow-900/20 border border-yellow-300 dark:border-yellow-700 rounded-lg p-4 mb-6">
      <h2 class="font-semibold text-yellow-800 dark:text-yellow-200 mb-3">Connection Status</h2>
      <div class="space-y-2 text-sm">
        <p><strong>Supabase URL:</strong> {import.meta.env.PUBLIC_SUPABASE_URL || 'Not set'}</p>
        <p><strong>API Key configured:</strong> {import.meta.env.PUBLIC_SUPABASE_ANON_KEY ? '✅ Yes' : '❌ No'}</p>
        <p><strong>Table "Pistachios" accessible:</strong> {testError ? '❌ No' : '✅ Yes'}</p>
        <p><strong>Record count:</strong> {testData ? testData.count : 'Unknown'}</p>
        <p><strong>Schema check:</strong> {schemaError ? '❌ Error' : '✅ OK'}</p>
        {schemaData && schemaData.length > 0 && (
          <p><strong>Available columns:</strong> {Object.keys(schemaData[0]).join(', ')}</p>
        )}
      </div>
    </div>
    
    <div class="bg-blue-100 dark:bg-blue-900/20 border border-blue-300 dark:border-blue-700 rounded-lg p-4 mb-6">
      <h2 class="font-semibold text-blue-800 dark:text-blue-200 mb-3">Query Results</h2>
      <div class="space-y-2 text-sm">
        <p><strong>Main query error:</strong> {error ? error.message : 'None'}</p>
        <p><strong>Records fetched:</strong> {pistachios ? pistachios.length : 0}</p>
        <p><strong>Status:</strong> {
          pistachios && pistachios.length > 0 ? '✅ Working with data' :
          testData && testData.count === 0 ? '⚠️ Table exists but empty' :
          '❌ No data accessible'
        }</p>
      </div>
    </div>
    
    {pistachios && pistachios.length > 0 ? (
      <div class="space-y-4">
        <h2 class="text-2xl font-semibold">Sample Records</h2>
        {pistachios.map((pistachio) => (
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-4">
            <pre class="text-xs overflow-auto">{JSON.stringify(pistachio, null, 2)}</pre>
          </div>
        ))}
      </div>
    ) : (
      <div class="bg-red-100 dark:bg-red-900/20 border border-red-300 dark:border-red-700 rounded-lg p-4">
        <p class="text-red-800 dark:text-red-200">
          No records found or error occurred.
        </p>
      </div>
    )}
  </div>
</Layout>
