---
// src/pages/pistachios.astro
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';
import { formatPistachioData, getReligionBadgeColor, getLanguageBadgeColor } from '../utils/pistachioUtils';

// Fetch all pistachios from Supabase
let { data: pistachios, error } = await supabase
  .from('Pistachios')
  .select('*')
  .order('source_id', { ascending: true });

if (error) {
  console.error('Error fetching pistachios:', error);
  pistachios = [];
}

const pageTitle = 'Pistachios';
const pageDescription = 'Explore translations, meanings, and biblical verses with interactive visualizations';

// Extract unique values for filters
const religions = [...new Set(pistachios?.map(p => p.Religion).filter(Boolean) || [])];
const languages = [...new Set(pistachios?.map(p => p.Language).filter(Boolean) || [])];
const dates = [...new Set(pistachios?.map(p => p.Date).filter(Boolean) || [])].sort();
const minDate = dates.length > 0 ? Math.min(...dates.map(d => parseInt(d))) : null;
const maxDate = dates.length > 0 ? Math.max(...dates.map(d => parseInt(d))) : null;

// Statistics for visualizations
const religionStats = religions.reduce((acc, religion) => {
  acc[religion] = pistachios?.filter(p => p.Religion === religion).length || 0;
  return acc;
}, {} as Record<string, number>);

const languageStats = languages.reduce((acc, language) => {
  acc[language] = pistachios?.filter(p => p.Language === language).length || 0;
  return acc;
}, {} as Record<string, number>);

const decadeStats = dates.reduce((acc, date) => {
  const year = parseInt(date);
  const decade = Math.floor(year / 10) * 10;
  const decadeLabel = `${decade}s`;
  acc[decadeLabel] = (acc[decadeLabel] || 0) + 1;
  return acc;
}, {} as Record<string, number>);
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <header class="mb-12">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
        <div>
          <h1 class="text-4xl font-bold text-gray-900 dark:text-white">{pageTitle}</h1>
          <p class="text-lg text-gray-500 dark:text-gray-400 mt-1">
            {pistachios.length} entries and counting
          </p>
        </div>
        <a 
          href="mailto:matthewjmiller07@gmail.com?subject=New%20Pistachio%20Entry%20Suggestion&body=Source%20ID%3A%20%5BEnter%20Source%20ID%5D%0D%0A%0D%0ATranslation%3A%20%5BEnter%20Translation%5D%0D%0A%0D%0ADate%3A%20%5BEnter%20Date%5D%0D%0A%0D%0ATranslation%20Source%3A%20%5BEnter%20Translation%20Source%5D%0D%0A%0D%0AReligion%3A%20%5BEnter%20Religion%5D%0D%0A%0D%0ALanguage%3A%20%5BEnter%20Language%5D%0D%0A%0D%0AURL%3A%20%5BEnter%20URL%5D%0D%0A%0D%0AMeaning%3A%20%5BEnter%20Meaning%5D%0D%0A%0D%0ABiblical%20Verse%3A%20%5BEnter%20Biblical%20Verse%5D"
          class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 dark:bg-green-700 dark:hover:bg-green-600 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
            <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
            <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
          </svg>
          Suggest an Entry
        </a>
      </div>
      <p class="text-gray-500 dark:text-gray-400 text-sm mt-2">
        A collection of translations, meanings, and biblical verses from various religious and linguistic traditions.
      </p>
    </header>

    {pistachios && pistachios.length > 0 ? (
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {pistachios.map((pistachio) => {
          if (!pistachio) return null;
          const formatted = formatPistachioData(pistachio);
          return (
          <article class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-300 border border-gray-100 dark:border-gray-700">
            <div class="p-6">
              <div class="flex flex-col h-full">
                <div class="flex items-start justify-between mb-3">
                  <h2 class="text-xl font-semibold text-gray-900 dark:text-white">
                    {pistachio.Translation}
                  </h2>
                  <span class="text-xs font-medium text-gray-500 dark:text-gray-400">
                    #{pistachio.source_id}
                  </span>
                </div>
                
                <div class="space-y-3 mb-4">
                  {pistachio.Date && (
                    <div class="flex items-center text-sm text-gray-600 dark:text-gray-300">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                      {pistachio.Date}
                    </div>
                  )}
                  
                  {pistachio['Translation Source'] && (
                    <div class="flex items-center text-sm text-gray-600 dark:text-gray-300">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                      </svg>
                      Source: {pistachio['Translation Source']}
                    </div>
                  )}
                  
                  <div class="flex flex-wrap gap-2">
                    {pistachio.Religion && (
                      <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${getReligionBadgeColor(pistachio.Religion)}`}>
                        {pistachio.Religion}
                      </span>
                    )}
                    {pistachio.Language && (
                      <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${getLanguageBadgeColor(pistachio.Language)}`}>
                        {pistachio.Language}
                      </span>
                    )}
                  </div>
                </div>
                
                {pistachio.Meaning && (
                  <div class="mb-4">
                    <h3 class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Meaning</h3>
                    <div class="p-3 bg-gray-50 dark:bg-gray-700/50 rounded-md">
                      <p class="text-sm text-gray-600 dark:text-gray-300">
                        {pistachio.Meaning}
                      </p>
                    </div>
                  </div>
                )}
                
                {formatted.hasBiblicalVerse && (
                  <div class="mb-4">
                    <h3 class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Biblical Verse</h3>
                    <div class="p-3 bg-blue-50 dark:bg-blue-900/20 rounded-md">
                      <p class="text-sm text-gray-600 dark:text-gray-300 italic">
                        {pistachio['Biblical Verse']}
                      </p>
                    </div>
                  </div>
                )}
                
                {formatted.hasUrl && (
                  <div class="mt-auto">
                    <a 
                      href={pistachio.URL} 
                      target="_blank" 
                      rel="noopener noreferrer"
                      class="inline-flex items-center text-sm font-medium text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300 transition-colors"
                    >
                      Read more
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                  </div>
                )}
              </div>
            </div>
          </article>
        )})}
      </div>
    ) : (
      <div class="text-center py-12">
        <p class="text-gray-600 dark:text-gray-400">
          {error ? 'Failed to load pistachios entries. Please try again later.' : 'No pistachios entries found.'}
        </p>
      </div>
    )}
  </div>
</Layout>

<style>
  /* Smooth scrolling for anchor links */
  html {
    scroll-behavior: smooth;
  }
  
  /* Better focus styles */
  a:focus, button:focus {
    @apply outline-none ring-2 ring-green-500 ring-offset-2 ring-offset-white dark:ring-offset-gray-900 rounded;
  }
  
  /* Dark mode transitions */
  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
    
    * {
      transition: background-color 0.2s ease, border-color 0.2s ease;
    }
  }
</style>
