---
import Layout from '../layouts/Layout.astro';
import LinkIcon from '../components/icons/LinkIcon.astro'; // Assuming you have this from media-appearances
import WritingOutputCard from '../components/WritingOutputCard.astro';
import phdsSeason from '../data/phds-on-the-parsha/season-5787.json';

// Define your projects
// You can add a brief description for each later if you like
const githubUsername = "matthewjmiller07"; // ** VERIFY YOUR GITHUB USERNAME **

const projects = [
    { name: "bibleMap", description: "Interactive map of biblical locations." },
    { name: "Colors", description: "A color utility or exploration tool." },
    { name: "CompaniesHouseMap", description: "Mapping data from Companies House." },
    { name: "Crypto", description: "A cryptocurrency related project." },
    { name: "G2researchmethodology", description: "Showcasing G2's research methodology." },
    { name: "github-slideshow", description: "A slideshow tool for GitHub content." },
    { name: "HaftaraStats", description: "Statistics and visualizations for Haftara readings." },
    { name: "Jewish-JS", description: "JavaScript utilities for Jewish texts or calculations." },
    { name: "leviticus-quiz", description: "A quiz on the Book of Leviticus." },
    { name: "LiteraryBible", description: "Exploring literary devices in the Bible (Color-Coded Bible)." },
    { name: "micrography", description: "Generates micrography from images and text." },
    { name: "neigh2", description: "A neighborhood or social data project." },
    { name: "Omer", description: "Count the Omer in Rav Schachter's format.", local: true },
    { name: "Parsha-Explorer", description: "In-depth exploration of biblical parshas." },
    { name: "Particles", description: "A particle animation or simulation." },
    { name: "pinmap", description: "Track and share visited locations on a map." },
    { name: "rebbe", description: "A project related to a Rebbe or Chassidic thought." },
    { name: "Rav Asher Weiss", description: "כמדומני — AI portrait quote cards from his shiurim. Tap any card to hear the moment in his own voice.", local: true },
    { name: "SefariaMemory", description: "Memory quiz for Hebrew texts from Sefaria (Memory Quiz)." },
    { name: "Shnayim Mikra", description: "Torah reading with Targum Onkelos, one aliyah at a time.", local: true },
    { name: "Tesla-Cost-Calculator", description: "Calculates Tesla ownership costs." },
    { name: "TorahScheduler", description: "Create custom Torah and Mishnah study schedules." },
    { name: "uscities", description: "Interactive map of US and UK cities with shared names." },
    { name: "whenarethejewishholidays", description: "Jewish holiday calendar with workday-off planner and free REST API.", fullUrl: "https://whenarethejewishholidays.com" },
    { name: "xaastracker", description: "Tracking examples of XaaS (Everything as a Service)." },
    { name: "Zmanim", description: "An earlier Zmanim lookup." }
].map(project => {
    if (project.fullUrl) {
        return { ...project, url: project.fullUrl };
    }
    if (project.local) {
        return { ...project, url: `/${project.name.toLowerCase().replace(/\s+/g, '-')}` };
    }
    return { ...project, url: `https://${githubUsername}.github.io/${project.name}/` };
});

// Separate list for your "Jewish Projects" and "Data Projects" from Squarespace content
// This is for the projects that WILL BE subdomains later.
// For now, these also link to GH Pages if they are the same. Adjust if they are different.
// Writing & outputs — things I've written or produced, as opposed to tools you use.
// `pageUrl` renders a "Read online" button, `downloadUrl` a "Download PDF" one; an
// entry can have either or both.
const writingOutputs = [
    {
        name: "Bereshit Parasha Sheet",
        kind: "Parasha sheet",
        description: "A two-page study sheet for Bereshit (Genesis 1:1–6:8). Word, verse and root counts computed from the OSHB/WLC morphology across the whole Tanakh — including the five words that occur nowhere else in the Bible — what the parasha calls God, how its word-count divides across the seven days of creation, and Biblical→Modern Hebrew notes including a real Kibbutz-movement dance-festival score literally titled \"יהי אור!\" from the National Library of Israel.",
        pageUrl: "/parasha-sheet/bereshit",
        downloadUrl: "/parasha-sheets/bereshit.pdf",
        previewImage: "/images/previews/bereshit-parasha-sheet.png",
        category: "Jewish Studies"
    },
    {
        name: "Noach Parasha Sheet",
        kind: "Parasha sheet",
        description: "A two-page study sheet for Noach (Genesis 6:9–11:32). Word, verse and root counts computed from the OSHB/WLC morphology across the whole Tanakh — including the thirteen words that occur nowhere else in the Bible — what the parasha calls God, how its word-count divides across the flood's eight narrative units, and Biblical→Modern Hebrew notes including a real 1993 dance-festival flyer titled \"מבול\" from the National Library of Israel.",
        pageUrl: "/parasha-sheet/noach",
        downloadUrl: "/parasha-sheets/noach.pdf",
        previewImage: "/images/previews/noach-parasha-sheet.png",
        category: "Jewish Studies"
    },
    {
        name: "Ha'azinu Parasha Sheet",
        kind: "Parasha sheet",
        description: "A two-page study sheet for Ha'azinu (Deuteronomy 32). Word, verse and root counts computed from the OSHB/WLC morphology across the whole Tanakh — including the eleven words that occur nowhere else in the Bible — the six designations the song uses for God, the six Levitical sections of Rosh Hashanah 31a, and Biblical→Modern Hebrew notes evidenced by posters from the National Library of Israel.",
        pageUrl: "/parasha-sheet/haazinu",
        downloadUrl: "/parasha-sheets/haazinu.pdf",
        previewImage: "/images/previews/haazinu-parasha-sheet.png",
        category: "Jewish Studies"
    },
    {
        name: "V'Zot HaBerachah Parasha Sheet",
        kind: "Parasha sheet",
        description: "A two-page study sheet for V'Zot HaBerachah (Deuteronomy 33–34). Word, verse and root counts computed from the OSHB/WLC morphology across the whole Tanakh — including thirteen words that occur nowhere else in the Bible — how Moses divided his blessing among the tribes (and the one, Simeon, he skipped, per Ibn Ezra), and Biblical→Modern Hebrew notes evidenced by street posters from the National Library of Israel.",
        pageUrl: "/parasha-sheet/vzot-haberachah",
        downloadUrl: "/parasha-sheets/vzot-haberachah.pdf",
        previewImage: "/images/previews/vzot-haberachah-parasha-sheet.png",
        category: "Jewish Studies"
    },
    {
        name: "PhDs on the Parsha",
        kind: "Podcast",
        description: "A weekly podcast: one parsha, one guest who wrote a doctorate on it. The season page has the trailer and the full 5787 schedule, from Parshat Breishit to V'Zot HaBerachah, with the dissertation featured each week.",
        pageUrl: "/phds-on-the-parsha",
        previewImage: phdsSeason.thumbnail,
        category: "Jewish Studies"
    },
    {
        name: "Interlinear Bible",
        kind: "Book",
        description: "Beautiful PDF of Tanach chapters in bilingual format.",
        downloadUrl: "/books/Interlinear-Bible-Book.pdf",
        previewImage: "/images/Interlinear Bible.gif",
        category: "Jewish Studies"
    },
    {
        name: "Mevakshim",
        kind: "Book",
        description: "The Mevakshim Book is a compilation of insights, summaries, and reflections drawn from the shiurim delivered during the Boca Raton Synagogue (BRS) Mevakshim Fly-In on May 23, 2025. It captures the powerful teachings and inspirational messages of some of today’s leading Torah giants, offering a window into their unique hashkafot and spiritual guidance.",
        rabbanim: [
          "Rav Betzalel Rudinsky",
          "Rav Chaim Aryeh Zev Ginzberg",
          "Rav Daniel Kalish",
          "Rav Ephraim Wachsman",
          "Rav Mordechai Finkelman",
          "Rav Moshe Don Kestenbaum",
          "Rav Ron Yitzchok Eisenman",
          "Reb Ralph Rieder",
          "Rav Yisroel Dovid Schlesinger",
          "Rav Moshe Leib Rabinovich",
          "Rav Yisroel Reisman",
          "Rav Yitzchok Lichtenstein",
          "Rav Avrohom Schorr"
        ],
        descriptionAfter: "The book serves as a meaningful record of the event, preserving the depth and emotion of the experience while inspiring continued growth for those who learn from it.",
        downloadUrl: "/books/Mevakshim Book.pdf",
        previewImage: "/images/Mevakshim Book.gif",
        category: "Jewish Studies"
    },
    {
        name: "Likutei Moharan — Annotated",
        kind: "Annotated study",
        description: "Bilingual annotated study of Rebbe Nachman's Likutei Moharan examining 256 passages on intellect, external wisdom, and faith — with embedded PDF and an interactive stance filter.",
        pageUrl: "/rav-nachman",
        category: "Jewish Studies"
    }
];

// The parasha sheets get their own labeled row within Writing & Outputs,
// grouped together instead of interspersed with the books below them.
const parashaSheets = writingOutputs.filter(p => p.kind === "Parasha sheet");
const otherWritingOutputs = writingOutputs.filter(p => p.kind !== "Parasha sheet");

const featuredProjectsInfo = [
    // Jewish Projects
    { name: "Memory Quiz (SefariaMemory)", repoName: "SefariaMemory", description: "Memorize Hebrew texts from Sefaria.", category: "Jewish Studies", isSubdomain: true, previewImage: "/images/previews/MemoryQuiz.png" },
    { name: "Haftara Stats", repoName: "HaftaraStats", description: "Visualize Haftarah readings across rites.", category: "Jewish Studies", isSubdomain: true, previewImage: "/images/previews/HaftaraStats.png" },
    { name: "Biblical & US/UK City Names Map", repoName: "MegaMap", description: "Interactive map of Biblical locations and US/UK cities.", category: "Jewish Studies", isSubdomain: true, previewImage: "/images/previews/MegaMap.png" }, // Assuming bibleMap is this
    { name: "Biblical Character Timelines", repoName: "biblical-timelines", description: "Explore the ages and timelines of biblical characters at key events based on different commentaries.", category: "Jewish Studies", isSubdomain: true, previewImage: "/images/bible-characters-timeline.png" },
    { name: "Micrography", repoName: "micrography", description: "Recreate images using chosen text.", category: "Jewish Studies", isSubdomain: true, previewImage: "/images/previews/micrographymatthew.jpeg" },
    { name: "Zmanim Tracker (New-Zmanim)", repoName: "New-Zmanim", description: "Advanced Zmanim lookup and comparison.", category: "Jewish Studies", isSubdomain: true, previewImage: "/images/previews/zmanim.gif" },
    { name: "Parsha Explorer", repoName: "Parsha-Explorer", description: "In-depth exploration of biblical texts.", category: "Jewish Studies", isSubdomain: true, previewImage: "/images/previews/parshaexplorer.gif" },
    { name: "Torah Schedule Creator", repoName: "TorahScheduler", description: "Customized Torah and Mishnah study schedules.", category: "Jewish Studies", isSubdomain: true, previewImage: "/images/previews/torahscheduler.gif" },
    { name: "When are the Jewish Holidays", repoName: "whenarethejewishholidays", description: "Holiday almanac for the working week — calendar, days-off planner, year comparisons, plus a free REST API and ICS feeds. Live at whenarethejewishholidays.com.", category: "Jewish Studies", isSubdomain: true, previewImage: "/images/previews/whenarethejewishholidays.png", externalUrl: "https://whenarethejewishholidays.com" },
    { name: "Kohelet Reader", repoName: "kohelet", description: "Ecclesiastes in Hebrew and English with 50 verse and word notes, six essays, and a trailer, all drawn from J.J. Kimche's six-part lecture series.", category: "Jewish Studies", isSubdomain: true, previewImage: "/images/kohelet/hero.jpg", localUrl: "/kohelet" },
    { name: "Source Sheet Creator", repoName: "source-sheet-creator", description: "Type a topic or question and get a printable Hebrew–English source sheet. Candidates come from Sefaria's topic pages and full-text search; TypeSafe's Jev model judges each for relevance and substance, and code picks, dedupes and orders the best.", category: "Jewish Studies", isSubdomain: true, previewImage: "/images/previews/source-sheet-creator.jpg", localUrl: "/source-sheet-creator" },
    { name: "Parasha Books", repoName: "parasha-books", description: "Peshat-based picture books where Aviya, Tzofia and Lielle explore Bereshit, Noach and Lech Lecha — pesukim from Sefaria on every page, FLUX.2 [klein] illustrations drawn from the girls' photos, Jev peshat checks, printable PDFs and voiced trailers. Upload your own kids to make one.", category: "Jewish Studies", isSubdomain: true, previewImage: "/parasha-books/bereshit/cover.jpg", localUrl: "/parasha-books" },
    { name: "Literary Bible (Color-Coded Bible)", repoName: "LiteraryBible", description: "Explore the Hebrew Bible with highlighted literary devices.", category: "Jewish Studies", isSubdomain: true, previewImage: "/images/previews/colorcodedbible.gif", localUrl: "/literary-bible" },
    { name: "Israeli Imported Foods Database", repoName: "imported-foods", description: "Search and explore Israeli government data on imported food products and kashrut certifications.", category: "Data Viz", isSubdomain: true, previewImage: "/images/tel-aviv-kosher.png" },
    { name: "Trader Joe's Spice Matrix", repoName: "tjs", description: "Interactive crossover visualizer mapping ingredient frequencies and sharing ratios across 25 popular Trader Joe's seasonings.", category: "Data Viz", isSubdomain: true, previewImage: "/images/tjs-spice-hero.png", localUrl: "/tjs" },
    // Data Projects
    // Micrography is already listed above
    { name: "Pinmap (Travel Tracker)", repoName: "pinmap", description: "Track and share cities, states, and countries visited.", category: "Data Viz", isSubdomain: true, previewImage: "/images/previews/pinmap.gif" },
    { name: "2026 Business Card Calendar", repoName: "business-card-calendar", description: "A full year on a 3.5×2\" card — clever row alignment means every month shares the same date grid. Download as PDF, LaTeX source, or 3D-printable STL.", category: "Design", isSubdomain: true, previewImage: "/calendar/preview.png", localUrl: "/business-card-calendar" },
    // Likutei Moharan lives in the Writing & Outputs section above.
    { name: "3D Print Tools", repoName: "3d-print-tools", description: "Browser toolbox for 3D printing — STL viewer & stats, scaling, cost estimator, bed-fit checker, a sand-castle mold generator that turns any model into a printable beach mold, plus lithophane, QR plaque, and name-tag generators.", category: "Design", isSubdomain: true, localUrl: "/3d-print-tools" },
    { name: "ZmanimFace — Garmin Watchface", repoName: "zmanim-watchface", description: "Halachic watchface for the Garmin Instinct 2 showing all 11 zmanim, Hebrew date, shaah zmanit, next-zman countdown, period progress bar, and an innovative day-arc timeline — built in Monkey C using the NOAA solar algorithm. Accuracy within ±0.8 min of Hebcal API.", category: "Jewish Studies", isSubdomain: true, previewImage: "/images/zmanim-watchface-analysis.png", localUrl: "/zmanim-watchface" },
    { name: "QidQuotes", repoName: "qidquotes", description: "Telegram bot that turns my kids' quotes into AI-illustrated watercolor storybook cards — with their real faces and exact age. One free Cloudflare Worker, Google Sheets as the database, Replicate for the art. Read how it works.", category: "AI / Live Data", isSubdomain: true, localUrl: "/qidquotes" },
    { name: "Weather Avatar", repoName: "weather-avatar", description: "Real-time weather meets FLUX AI portrait generation. Fetches live conditions from Open-Meteo, builds a weather-shaped prompt, then generates a portrait via FLUX 2 Klein 4B image-to-image — sunny vibes, rainy streets, or full blizzard depending on what's actually outside.", category: "AI / Live Data", isSubdomain: true, localUrl: "/weather-avatar" },
    { name: "Quake Watch", repoName: "quake-watch", description: "Live global seismic activity powered by the USGS real-time GeoJSON feed. SVG world map with magnitude-colored dots, hover tooltips, magnitude histogram, and a live scrolling feed — refreshes every 60 seconds.", category: "AI / Live Data", isSubdomain: true, localUrl: "/quake-watch" },
    { name: "Sky Above", repoName: "sky-above", description: "Real-time aircraft overhead using the OpenSky Network API. Radar-style canvas view, flight list sorted by altitude, and live stats — detects your location and shows every tracked plane within 280km.", category: "AI / Live Data", isSubdomain: true, localUrl: "/sky-above" },
    { name: "ISS Now", repoName: "iss-now", description: "Real-time ISS position from Open Notify, updating every 5 seconds. SVG world map with orbital trail, distance and ETA from your location — and a FLUX portrait generated the moment the station passes within 2,000 km overhead.", category: "AI / Live Data", isSubdomain: true, localUrl: "/iss-now" },
    { name: "Crypto Vibes", repoName: "crypto-vibes", description: "Live BTC/ETH/SOL/DOGE prices from CoinGecko, with a market-mood system (Euphoria → REKT) that drives a FLUX AI portrait — bull Matthew, bear Matthew, zen Matthew. Includes a Torah perspective on each market condition.", category: "AI / Live Data", isSubdomain: true, localUrl: "/crypto-vibes" },
    { name: "Parsha Art", repoName: "parsha-art", description: "This week's Torah portion from Sefaria's live calendar API — aliyot, description, and a FLUX biblical scene illustration with scene-variant regeneration. Coverage for all 54 parshot mapped to their iconic moments.", category: "AI / Live Data", isSubdomain: true, localUrl: "/parsha-art" },
    { name: "Wiki Pulse", repoName: "wiki-pulse", description: "Yesterday's most-read Wikipedia articles via the Wikimedia REST API, with category filters (All / Jewish+Israel / Sports / Science / Culture), proportional view bars, and a 'Jewish interest' spotlight for the day's top related article.", category: "AI / Live Data", isSubdomain: true, localUrl: "/wiki-pulse" },
    { name: "World Pulse", repoName: "world-pulse", description: "Planet vitals dashboard: weather, ISS position, seismic activity, BTC price, Parsha HaShavua, and Wikipedia #1 — all live. Synthesizes all conditions into a single FLUX 'World Moment' portrait.", category: "AI / Live Data", isSubdomain: true, localUrl: "/world-pulse" },
    { name: "arXiv Feed", repoName: "arxiv-feed", description: "Live AI, ML, NLP, and Vision research papers direct from the arXiv API. Category tabs, full-text search, conference venue detection, and load-more pagination.", category: "AI / Live Data", isSubdomain: true, localUrl: "/arxiv-feed" },
    { name: "Solar Watch", repoName: "solar-watch", description: "Real-time space weather from NOAA SWPC: solar wind speed and density, Kp geomagnetic index (7-day chart), X-ray flare class, aurora latitude bands, and storm alerts. Generates a FLUX aurora portrait styled by current Kp intensity.", category: "AI / Live Data", isSubdomain: true, localUrl: "/solar-watch" },
    { name: "Jewish Learning Hub", repoName: "jewish-learning-hub", description: "Today's complete Jewish learning calendar live from Sefaria — Daf Yomi (with text preview), Parasha, Mishnah Yomit, 929, Rambam, Halakhah Yomit, Tanya, Yerushalmi Yomi, Daf a Week, and Hebrew date — all in one place. Generates a FLUX Talmudic scene illustration for each day's tractate.", category: "AI / Live Data", isSubdomain: true, localUrl: "/jewish-learning-hub" },
    { name: "HN Live", repoName: "hn-live", description: "Real-time Hacker News top 150 stories via the Firebase API, refreshed every 90 seconds. Smart filters for AI/ML, Data, Jewish/Israel, Ask HN, Show HN — plus full-text search and live score, comment, and domain stats.", category: "AI / Live Data", isSubdomain: true, localUrl: "/hn-live" },
    { name: "Air Quality", repoName: "air-quality", description: "Real-time EPA AQI and pollutant breakdown (PM2.5, PM10, ozone, NO₂) for your location via Open-Meteo. 24-hour AQI chart, health guidance by level, and a FLUX portrait styled by current air quality from clear-day jogger to gas-mask dystopia.", category: "AI / Live Data", isSubdomain: true, localUrl: "/air-quality" },
    { name: "On This Day", repoName: "on-this-day", description: "Historical events, births, and deaths for today's date from Wikipedia's REST API. Jewish and Israeli history highlighted, era filters (Ancient/Medieval/Modern/Contemporary), full-text search, and click any event to generate a FLUX scene with Matthew as a historical witness.", category: "AI / Live Data", isSubdomain: true, localUrl: "/on-this-day" },
    { name: "Radio World", repoName: "radio-world", description: "Live streaming global radio from the Radio Browser community API. Curated tabs for Jewish music, Israeli stations, jazz, classical, Chicago, and lo-fi — click any station to stream instantly in-browser.", category: "AI / Live Data", isSubdomain: true, localUrl: "/radio-world" },
    { name: "GitHub Trending", repoName: "github-trending", description: "Live trending GitHub repositories via the GitHub search API. Smart topic filters (AI/LLMs, Data Tools, Web Dev, DevTools, Hebrew/Jewish tech) with time-range selector, star proportional background bars, and matthewjmiller07 profile view.", category: "AI / Live Data", isSubdomain: true, localUrl: "/github-trending" },
    { name: "Kosher Scanner", repoName: "kosher-scanner", description: "Search Open Food Facts' 3M+ product database for kosher-certified foods. Displays certification agencies (OU, OK, Kof-K, cRc, Star-K), nutrition facts, and generates a FLUX portrait of Matthew enjoying the dish — Shabbat-table setting for kosher items.", category: "AI / Live Data", isSubdomain: true, localUrl: "/kosher-scanner" },
    { name: "Chicago Pulse", repoName: "chicago-pulse", description: "Recent crime incidents from Chicago's open data portal (Socrata API) — type breakdown with proportional bars, hourly time-of-day chart, 25-district heatmap grid, and community area leaderboard. Filter by crime type or district. Refreshes every 5 minutes.", category: "AI / Live Data", isSubdomain: true, localUrl: "/chicago-pulse" },
    { name: "Live Sports", repoName: "live-sports", description: "Real-time MLB, NBA, NFL, and NHL scores via the ESPN public API, refreshing every 30 seconds. Live game status, score cards with team logos and colors, venue info, and Chicago team highlighting.", category: "AI / Live Data", isSubdomain: true, localUrl: "/live-sports" },
    { name: "Chess Puzzle of the Day", repoName: "chess-puzzle", description: "Lichess daily puzzle via their free API — embedded Lichess board, puzzle themes (mateIn2, fork, pin, endgame, etc.), player info from the source game, hidden solution reveal, and a FLUX portrait of Matthew deep in thought at a chess board.", category: "AI / Live Data", isSubdomain: true, localUrl: "/chess-puzzle" },
].map(p => ({
    ...p,
    // For certain projects, use local URLs since they are first-class pages on this site
    url:
      p.externalUrl
        ? p.externalUrl
        : p.localUrl
        ? p.localUrl
        : p.repoName === 'imported-foods'
          ? '/imported-foods'
          : p.repoName === 'HaftaraStats'
            ? '/haftarah-explorer'
            : p.repoName === 'biblical-timelines'
              ? '/biblical-timelines'
              : `https://${githubUsername}.github.io/${p.repoName}/`,
    // When subdomains are ready:
    // url: p.isSubdomain ? `https://${p.repoName.toLowerCase()}.yourcustomdomain.com` : `https://${githubUsername}.github.io/${p.repoName}/`
}));

const allDisplayProjects = [...new Map([...featuredProjectsInfo, ...projects].map(item => [item.name, item])).values()];
// This de-duplicates by name, giving preference to featuredProjectsInfo if names overlap.

// ---- Presentation ----------------------------------------------------------
// Everything below only arranges the lists above; no entry is dropped.

// Interactive tools, grouped by category in a fixed reading order.
const toolGroups = [
    { key: "Jewish Studies", id: "jewish-studies", title: "Jewish Studies", blurb: "Tools for reading, memorizing, scheduling and seeing Torah — most of them built on Sefaria's open APIs." },
    { key: "Data Viz", id: "data-viz", title: "Data Viz", blurb: "Maps, matrices and databases that make a pile of numbers legible." },
    { key: "Design", id: "design", title: "Design & Making", blurb: "Things that end up printed, cut or 3D-printed." },
    { key: "AI / Live Data", id: "live", title: "AI & Live Data", blurb: "Small dashboards wired to live public feeds — many of them paint a FLUX portrait of whatever is happening right now." },
].map(g => ({ ...g, items: featuredProjectsInfo.filter(p => p.isSubdomain && p.category === g.key) }));

// Repos already shown as a featured tool (often under a friendlier name) are
// left out of the repo index so nothing appears twice.
const norm = (s = "") => s.toLowerCase().replace(/[^a-z0-9]/g, "");
const featuredKeys = new Set(featuredProjectsInfo.flatMap(p => [norm(p.repoName), norm(p.name), p.url]));
const moreRepos = projects.filter(p => !featuredKeys.has(norm(p.name)) && !featuredKeys.has(p.url));

const isExternal = (url = "") => /^https?:\/\//.test(url);
const linkAttrs = (url) => isExternal(url) ? { target: "_blank", rel: "noopener noreferrer" } : {};

const catSlug = {
    "Jewish Studies": "jewish",
    "Data Viz": "data",
    "Design": "design",
    "AI / Live Data": "live",
};

// Featured strip at the top: the newest and best-looking work.
const featuredPicks = ["Kohelet Reader", "Source Sheet Creator", "When are the Jewish Holidays"]
    .map(n => featuredProjectsInfo.find(p => p.name === n))
    .filter(Boolean);
const podcast = writingOutputs.find(p => p.name === "PhDs on the Parsha");

const toolCount = featuredProjectsInfo.filter(p => p.isSubdomain).length;
const totalCount = toolCount + writingOutputs.length + moreRepos.length;
const stats = [
    { n: toolCount, label: "interactive tools" },
    { n: writingOutputs.length, label: "books, sheets & shows" },
    { n: toolGroups.find(g => g.key === "AI / Live Data")?.items.length ?? 0, label: "live-data dashboards" },
    { n: moreRepos.length, label: "more repos" },
];

const filters = [
    { id: "all", label: "Everything", count: totalCount },
    { id: "writing", label: "Writing", count: writingOutputs.length },
    ...toolGroups.map(g => ({ id: catSlug[g.key], label: g.title, count: g.items.length })),
    { id: "repo", label: "Repos", count: moreRepos.length },
];

const marquee = featuredProjectsInfo.map(p => p.name.replace(/\s*\(.*\)\s*/, ""));
const initials = (name) => name.replace(/\(.*\)/, "").split(/[\s—-]+/).filter(w => /^[A-Z0-9]/.test(w)).slice(0, 2).map(w => w[0]).join("").toUpperCase();
---

<Layout
    title="Projects"
    description="The Workshop: interactive Torah tools, data visualizations, live-data dashboards, books and study sheets built by Matthew Miller. Watch the teaser and get new builds first."
    image="/images/projects/trailer-poster.jpg"
    imageAlt="The Workshop — projects by Matthew Miller"
>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />

    <main class="ws">
        {/* ---------- Hero ---------- */}
        <header class="hero">
            <div class="hero-grid" aria-hidden="true"></div>
            <div class="wrap">
                <p class="eyebrow"><span class="dot"></span> Matthew Miller · The Workshop</p>
                <h1>
                    Things I've built for <em>learning Torah</em>, <em class="c">seeing data</em>, and having fun with <em class="g">AI</em>.
                </h1>
                <p class="lede">
                    Writing and study sheets, tools for Jewish studies, data visualizations, and various tech experiments —
                    {totalCount} of them, and a new one most weeks.
                </p>
                <div class="cta-row">
                    <a href="#trailer" class="btn primary">
                        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
                        Watch the teaser
                    </a>
                    <a href="#subscribe" class="btn ghost">Get new builds first →</a>
                </div>
                <dl class="stats">
                    {stats.map(s => (
                        <div><dt>{s.label}</dt><dd>{s.n}</dd></div>
                    ))}
                </dl>
            </div>
            <div class="marquee" aria-hidden="true">
                <div class="marquee-track">
                    {[...marquee, ...marquee].map(n => <span>{n}<i>✦</i></span>)}
                </div>
            </div>
        </header>

        {/* ---------- Trailer + signup ---------- */}
        <section id="trailer" class="wrap trailer-sec">
            <div class="trailer-card">
                <div class="video-frame">
                    <video
                        src="/videos/projects-trailer.mp4"
                        poster="/images/projects/trailer-poster.jpg"
                        controls
                        playsinline
                        preload="metadata"
                    ></video>
                </div>
                <p class="cap mono">Teaser · 34 sec · every shot is a real project</p>
            </div>
            <aside id="subscribe" class="signup">
                <p class="eyebrow small"><span class="dot"></span> The Workshop list</p>
                <h2>Get new builds before anyone else.</h2>
                <p>
                    One short email when something new ships — a daf game, a parasha sheet, a tool. No spam, unsubscribe anytime.
                </p>
                <form class="sub-form" data-source="projects-trailer" novalidate>
                    <label class="sr-only" for="sub-email-1">Email address</label>
                    <input id="sub-email-1" type="email" name="email" placeholder="you@example.com" autocomplete="email" required />
                    <input type="text" name="website" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
                    <button type="submit" class="btn primary">Notify me</button>
                    <p class="sub-msg" role="status" aria-live="polite"></p>
                </form>
            </aside>
        </section>

        {/* ---------- Featured ---------- */}
        <section class="wrap" aria-labelledby="featured-h">
            <div class="sec-head">
                <p class="kicker mono">01 — Fresh off the bench</p>
                <h2 id="featured-h">Featured</h2>
            </div>
            <div class="bento">
                {featuredPicks.map((p, i) => (
                    <a href={p.url} {...linkAttrs(p.url)} class={`bento-card ${i === 0 ? "big" : ""}`} data-cat={catSlug[p.category]}>
                        {p.previewImage && <img src={p.previewImage} alt="" loading={i === 0 ? "eager" : "lazy"} />}
                        <div class="bento-body">
                            <span class="pill">{p.category}</span>
                            <h3>{p.name}</h3>
                            <p>{p.description}</p>
                        </div>
                    </a>
                ))}
                {podcast && (
                    <a href={podcast.pageUrl} class="bento-card podcast" data-cat="writing">
                        <div class="wave" aria-hidden="true">{Array.from({ length: 28 }).map((_, i) => <span style={`--i:${i}`}></span>)}</div>
                        <div class="bento-body">
                            <span class="pill">{podcast.kind}</span>
                            <h3>{podcast.name}</h3>
                            <p>{podcast.description}</p>
                        </div>
                    </a>
                )}
            </div>
        </section>

        {/* ---------- Filter bar ---------- */}
        <nav class="filterbar" aria-label="Filter projects">
            <div class="wrap filter-inner">
                <div class="chips" role="tablist">
                    {filters.map((f, i) => (
                        <button type="button" class="chip" data-filter={f.id} aria-pressed={i === 0 ? "true" : "false"}>
                            {f.label} <span class="n">{f.count}</span>
                        </button>
                    ))}
                </div>
                <label class="search">
                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="m21 21-4.3-4.3M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15z"/></svg>
                    <span class="sr-only">Search projects</span>
                    <input type="search" id="proj-search" placeholder="Search projects…" autocomplete="off" />
                </label>
            </div>
        </nav>

        {/* ---------- Writing & Outputs ---------- */}
        <section class="wrap group" data-group="writing" id="writing">
            <div class="sec-head">
                <p class="kicker mono">02 — Writing &amp; Outputs</p>
                <h2>Writing &amp; Outputs</h2>
                <p class="blurb">
                    Things I've written or produced — books, study sheets and annotated texts — as
                    opposed to the interactive tools further down.
                </p>
            </div>
            {parashaSheets.length > 0 && (
                <div class="subgroup">
                    <h3 class="sub-h mono">Parasha Sheets</h3>
                    <div class="grid g3">
                        {parashaSheets.map(project => <WritingOutputCard project={project} />)}
                    </div>
                </div>
            )}
            <div class="grid g3">
                {otherWritingOutputs.map(project => <WritingOutputCard project={project} />)}
            </div>
        </section>

        {/* ---------- Interactive Tools & Apps, by category ---------- */}
        {toolGroups.map((g, gi) => (
            <section class="wrap group" data-group={catSlug[g.key]} id={g.id}>
                <div class="sec-head">
                    <p class="kicker mono">{String(gi + 3).padStart(2, "0")} — Interactive Tools &amp; Apps</p>
                    <h2>{g.title} <span class="count">{g.items.length}</span></h2>
                    <p class="blurb">{g.blurb}</p>
                </div>
                {g.key === "AI / Live Data" ? (
                    <div class="grid g3 live-grid">
                        {g.items.map(project => (
                            <a href={project.url} {...linkAttrs(project.url)} class="card live" data-cat="live" data-text={`${project.name} ${project.description}`.toLowerCase()}>
                                <div class="live-top">
                                    <span class="pulse" aria-hidden="true"></span>
                                    <span class="mono tiny">LIVE</span>
                                    <span class="arrow" aria-hidden="true">↗</span>
                                </div>
                                <h3>{project.name}</h3>
                                <p class="clamp3">{project.description}</p>
                            </a>
                        ))}
                    </div>
                ) : (
                    <div class="grid g3">
                        {g.items.map(project => (
                            <a href={project.url} {...linkAttrs(project.url)} class="card tool" data-cat={catSlug[g.key]} data-text={`${project.name} ${project.description}`.toLowerCase()}>
                                <div class="thumb">
                                    {project.previewImage ? (
                                        <img src={project.previewImage} alt={`Preview of ${project.name}`} loading="lazy" />
                                    ) : (
                                        <div class="mono-tile" aria-hidden="true"><span>{initials(project.name)}</span></div>
                                    )}
                                </div>
                                <div class="card-body">
                                    <span class="pill">{project.category}</span>
                                    <h3>{project.name}</h3>
                                    <p class="clamp3">{project.description}</p>
                                    <span class="go">View Project <LinkIcon class="w-3.5 h-3.5" /></span>
                                </div>
                            </a>
                        ))}
                    </div>
                )}
            </section>
        ))}

        {/* ---------- More GitHub repositories ---------- */}
        <section class="wrap group" data-group="repo" id="repos">
            <div class="sec-head">
                <p class="kicker mono">07 — The archive</p>
                <h2>More GitHub Repositories <span class="count">{moreRepos.length}</span></h2>
                <p class="blurb">Earlier experiments and side quests, mostly on GitHub Pages.</p>
            </div>
            <ul class="repo-list">
                {moreRepos.map(project => (
                    <li>
                        <a href={project.url} {...linkAttrs(project.url)} class="repo" data-cat="repo" data-text={`${project.name} ${project.description}`.toLowerCase()}>
                            <span class="repo-name mono">{project.name}</span>
                            <span class="repo-desc">{project.description}</span>
                            <span class="repo-where mono">{isExternal(project.url) ? (project.url.includes("github.io") ? "GitHub ↗" : "Live ↗") : "On this site →"}</span>
                        </a>
                    </li>
                ))}
            </ul>
            <p class="footnote">
                These applications are currently hosted on GitHub Pages and will be moved to subdomains of my custom domain soon.
            </p>
        </section>

        <p class="wrap empty" id="no-results" hidden>Nothing matches that — try another word.</p>

        {/* ---------- Closing signup ---------- */}
        <section class="wrap closer">
            <div class="closer-card">
                <div>
                    <p class="kicker mono">What's next</p>
                    <h2>There's always something on the bench.</h2>
                    <p>Be the first to try the next one.</p>
                </div>
                <form class="sub-form" data-source="projects-footer" novalidate>
                    <label class="sr-only" for="sub-email-2">Email address</label>
                    <input id="sub-email-2" type="email" name="email" placeholder="you@example.com" autocomplete="email" required />
                    <input type="text" name="website" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
                    <button type="submit" class="btn primary">Notify me</button>
                    <p class="sub-msg" role="status" aria-live="polite"></p>
                </form>
            </div>
        </section>
    </main>
</Layout>

<style is:global>
