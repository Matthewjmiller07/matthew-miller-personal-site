.ws .btn.ghost:hover { border-color: var(--paper); }
.ws .stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 16px; overflow: hidden; margin: 3rem 0 3.5rem; max-width: 760px; }
