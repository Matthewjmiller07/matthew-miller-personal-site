                        <h3 class="text-md font-semibold mb-1 text-primary-light dark:text-primary-dark group-hover:text-accent dark:group-hover:text-accent-dark leading-snug">
                            {project.name}
                        </h3>
                        {project.description && project.description.length > 50 ? ( // Show shorter desc for these smaller cards
                             <p class="text-xs text-secondary-light dark:text-secondary-dark mb-2 leading-snug truncate-2-lines">{project.description}</p>
                        ) : project.description ? (
                             <p class="text-xs text-secondary-light dark:text-secondary-dark mb-2 leading-snug">{project.description}</p>
                        ): null}
                        <div class="flex items-center text-xs text-accent dark:text-accent-dark font-medium">
                            View on GitHub
                            <LinkIcon class="w-3 h-3 ml-1 group-hover:translate-x-0.5 transition-transform" />
                        </div>
                    </a>
                ))}
            </div>
        </section>
    </main>
</Layout>

<style>
/* Helper for truncating text to a specific number of lines */
.truncate-2-lines {
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2; /* number of lines to show */
    -webkit-box-orient: vertical;
}

/* Expandable content transitions */
.description-content {
    transition: max-height 0.3s ease-out, opacity 0.2s ease-out;
    opacity: 0;
}

.description-content.expanded {
    opacity: 1;
    max-height: 500px !important; /* Large enough to fit content */
    margin-bottom: 1rem;
}
</style>

<script>
  // Handle expand/collapse functionality
  document.addEventListener('astro:page-load', () => {
    const expandButtons = document.querySelectorAll('.expand-btn');
    
    expandButtons.forEach(button => {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        
        // Get the current state
        const isExpanded = button.getAttribute('data-expanded') === 'true';
        
        // Find the content container (sibling of parent div) with null check
        const contentContainer = button.closest('div')?.nextElementSibling;
        
        if (!contentContainer) {
          console.warn('Content container not found');
          return;
        }
        
        // Toggle the expanded state
        if (isExpanded) {
          // Collapse
          contentContainer.classList.remove('expanded');
          contentContainer.classList.add('hidden');
          button.setAttribute('data-expanded', 'false');
          
          // Toggle button text with null checks
          const showText = button.querySelector('.show-text');
          const hideText = button.querySelector('.hide-text');
          if (showText) showText.classList.remove('hidden');
          if (hideText) hideText.classList.add('hidden');
        } else {
          // Expand
          contentContainer.classList.add('expanded');
          contentContainer.classList.remove('hidden');
          button.setAttribute('data-expanded', 'true');
          
          // Toggle button text with null checks
          const showText = button.querySelector('.show-text');
          const hideText = button.querySelector('.hide-text');
          if (showText) showText.classList.add('hidden');
          if (hideText) hideText.classList.remove('hidden');
        }
      });
    });
  });
</script>