.ws .chips::-webkit-scrollbar { display: none; }
.ws .chip { flex: none; font-size: 0.85rem; font-weight: 500; color: var(--muted); border: 1px solid var(--line-2); border-radius: 999px; padding: 0.4rem 0.85rem; transition: all 0.15s; }
.ws .chip .n { font-family: var(--mono); font-size: 0.72rem; opacity: 0.7; margin-left: 0.2rem; }
.ws .chip:hover { color: var(--paper); border-color: var(--paper); }
.ws .chip[aria-pressed="true"] { background: var(--paper); color: var(--ink); border-color: var(--paper); }
.ws .search { display: flex; align-items: center; gap: 0.5rem; background: var(--panel); border: 1px solid var(--line-2); border-radius: 999px; padding: 0.4rem 0.9rem; color: var(--muted); flex: 1 1 200px; max-width: 280px; }
.ws .search input { background: transparent; border: 0; outline: none; color: var(--paper); font-size: 0.9rem; width: 100%; }
.ws .search:focus-within { border-color: var(--amber); }

/* grids & cards */
.ws .grid { display: grid; gap: 1.1rem; grid-template-columns: minmax(0, 1fr); }
@media (min-width: 680px) { .ws .g3 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (min-width: 1024px) { .ws .g3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
.ws .card { display: flex; flex-direction: column; background: var(--panel); border: 1px solid var(--line); border-radius: 16px; overflow: hidden; transition: border-color 0.2s, transform 0.2s, background 0.2s; }
.ws .card:hover { border-color: color-mix(in srgb, var(--c) 60%, transparent); transform: translateY(-3px); background: var(--panel-2); }
.ws .thumb { aspect-ratio: 16 / 10; overflow: hidden; background: #0e1118; border-bottom: 1px solid var(--line); }
.ws .thumb img { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform 0.5s ease; }
.ws .card:hover .thumb img { transform: scale(1.04); }
.ws .mono-tile { width: 100%; height: 100%; display: grid; place-items: center; background: radial-gradient(80% 80% at 20% 10%, color-mix(in srgb, var(--c) 30%, transparent), transparent 70%), repeating-linear-gradient(135deg, rgba(255,255,255,0.03) 0 2px, transparent 2px 12px); }
.ws .mono-tile span { font-family: var(--display); font-size: 4rem; font-weight: 700; letter-spacing: -0.05em; color: var(--c); opacity: 0.9; }
.ws .card-body { padding: 1.15rem 1.25rem 1.3rem; display: flex; flex-direction: column; gap: 0.5rem; flex: 1; }
.ws .card h3 { font-family: var(--display); font-weight: 600; font-size: 1.2rem; letter-spacing: -0.015em; line-height: 1.2; }
.ws .card p { color: var(--muted); font-size: 0.9rem; line-height: 1.55; }
.ws .clamp3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
.ws .card:hover .clamp3 { -webkit-line-clamp: unset; }
.ws .go { margin-top: auto; padding-top: 0.4rem; display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.8rem; font-weight: 600; color: var(--c); }

/* live cards */
.ws .card.live { padding: 1.15rem 1.25rem 1.3rem; gap: 0.55rem; }
.ws .live-top { display: flex; align-items: center; gap: 0.5rem; color: var(--green); }
.ws .tiny { font-size: 0.68rem; letter-spacing: 0.12em; }
.ws .pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.6); animation: ws-pulse 2s infinite; }
@keyframes ws-pulse { 70% { box-shadow: 0 0 0 8px rgba(74, 222, 128, 0); } 100% { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0); } }
.ws .arrow { margin-left: auto; color: var(--muted); transition: transform 0.2s, color 0.2s; }
.ws .card.live:hover .arrow { transform: translate(2px, -2px); color: var(--green); }

/* writing cards (WritingOutputCard) */
.ws .wcard .thumb img { object-position: center top; }
.ws .wcard details { margin-top: 0.25rem; }
.ws .wcard summary { cursor: pointer; font-size: 0.8rem; font-weight: 600; color: var(--c); list-style: none; display: inline-flex; align-items: center; gap: 0.35rem; }
.ws .wcard summary::-webkit-details-marker { display: none; }
.ws .wcard summary::before { content: "+"; font-family: var(--mono); }
.ws .wcard details[open] summary::before { content: "–"; }
.ws .wcard .details p, .ws .wcard .details li { color: var(--muted); font-size: 0.85rem; line-height: 1.55; }
.ws .wcard .details { margin-top: 0.6rem; display: grid; gap: 0.5rem; }
.ws .wcard .details ul { list-style: disc; padding-left: 1.1rem; columns: 2; column-gap: 1rem; }
.ws .wcard .details .lbl { font-size: 0.75rem; font-weight: 600; color: var(--paper); }
.ws .wactions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: auto; padding-top: 0.6rem; }
.ws .wbtn { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.8rem; font-weight: 600; padding: 0.45rem 0.85rem; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--c) 45%, transparent); color: var(--c); transition: background 0.15s, color 0.15s; }
.ws .wbtn.solid { background: var(--c); color: var(--ink); border-color: var(--c); }
.ws .wbtn:hover { background: color-mix(in srgb, var(--c) 18%, transparent); }
.ws .wbtn.solid:hover { background: color-mix(in srgb, var(--c) 85%, white); }

/* repos */
.ws .repo-list { border-top: 1px solid var(--line); }
.ws .repo { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.25rem 1.5rem; padding: 1rem 0.25rem; border-bottom: 1px solid var(--line); transition: background 0.15s, padding 0.2s; }
@media (min-width: 760px) { .ws .repo { grid-template-columns: 240px minmax(0, 1fr) auto; align-items: baseline; } }
.ws .repo:hover { background: rgba(255, 255, 255, 0.025); padding-left: 0.75rem; }
.ws .repo-name { font-size: 0.92rem; color: var(--paper); }
.ws .repo-desc { color: var(--muted); font-size: 0.9rem; grid-column: 1 / -1; }
@media (min-width: 760px) { .ws .repo-desc { grid-column: auto; } }
.ws .repo-where { font-size: 0.75rem; color: var(--muted); grid-row: 1; grid-column: 2; }
@media (min-width: 760px) { .ws .repo-where { grid-row: auto; grid-column: auto; } }
.ws .repo:hover .repo-where { color: var(--paper); }
.ws .footnote { margin-top: 1.25rem; font-size: 0.8rem; color: var(--muted); }

.ws .empty { padding-top: 4rem; text-align: center; color: var(--muted); }

/* closer */
.ws .closer { padding-top: 5rem; }
.ws .closer-card { display: grid; gap: 1.5rem; align-items: center; padding: 2rem; border-radius: 24px; border: 1px solid var(--line-2); background: radial-gradient(100% 140% at 0% 0%, rgba(255, 184, 76, 0.16), transparent 55%), radial-gradient(90% 120% at 100% 100%, rgba(34, 211, 238, 0.12), transparent 55%), var(--panel); }
@media (min-width: 860px) { .ws .closer-card { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); padding: 3rem; } }
.ws .closer .kicker { color: var(--amber); margin-bottom: 0.5rem; }

.ws .is-hidden { display: none !important; }

@media (prefers-reduced-motion: reduce) {
    .ws .marquee-track, .ws .wave span, .ws .pulse { animation: none; }
    .ws .card, .ws .bento-card, .ws img { transition: none; }
}
</style>

<script>
  function initWorkshop() {
    const root = document.querySelector('.ws');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';

    // ---- filters + search ----
    const chips = [...root.querySelectorAll<HTMLButtonElement>('.chip')];
    const groups = [...root.querySelectorAll<HTMLElement>('.group')];
    const search = root.querySelector<HTMLInputElement>('#proj-search');
    const empty = root.querySelector<HTMLElement>('#no-results');
    let active = 'all';

    const apply = () => {
      const q = (search?.value || '').trim().toLowerCase();
      let shown = 0;
      for (const g of groups) {
        const inFilter = active === 'all' || g.dataset.group === active;
        const items = [...g.querySelectorAll<HTMLElement>('[data-text]')];
        let visible = 0;
        for (const el of items) {
          const hit = inFilter && (!q || (el.dataset.text || '').includes(q));
          (el.closest('li') || el).classList.toggle('is-hidden', !hit);
          if (hit) visible++;
        }
        // hide parasha-sheet subrow etc. when none of their cards match
        g.querySelectorAll<HTMLElement>('.subgroup').forEach(sg => {
          sg.classList.toggle('is-hidden', !sg.querySelector('[data-text]:not(.is-hidden)'));
        });
        g.classList.toggle('is-hidden', visible === 0);
        shown += visible;
      }
      if (empty) empty.hidden = shown > 0;
    };

    chips.forEach(chip => chip.addEventListener('click', () => {
      active = chip.dataset.filter || 'all';
      chips.forEach(c => c.setAttribute('aria-pressed', String(c === chip)));
      apply();
      const bar = root.querySelector('.filterbar') as HTMLElement | null;
      if (bar && bar.getBoundingClientRect().top > 1) bar.scrollIntoView({ behavior: 'smooth' });
    }));
    search?.addEventListener('input', apply);

    // ---- email signup ----
    root.querySelectorAll<HTMLFormElement>('.sub-form').forEach(form => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const msg = form.querySelector<HTMLElement>('.sub-msg')!;
        const btn = form.querySelector<HTMLButtonElement>('button')!;
        const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
        const website = (form.elements.namedItem('website') as HTMLInputElement).value;
        msg.className = 'sub-msg';
        if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
          msg.textContent = 'That email address doesn’t look right.';
          msg.classList.add('err');
          return;
        }
        btn.disabled = true;
        btn.textContent = 'Saving…';
        try {
          const res = await fetch('/api/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, website, source: form.dataset.source }),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || 'Something went wrong.');
          form.classList.add('done');
          msg.textContent = '✓ You’re on the list. See you at the next build.';
          msg.classList.add('ok');
        } catch (err) {
          msg.textContent = (err as Error).message;
          msg.classList.add('err');
          btn.disabled = false;
          btn.textContent = 'Notify me';
        }
      });
    });
  }

  initWorkshop();
  document.addEventListener('astro:page-load', initWorkshop);
</script>
