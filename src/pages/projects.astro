.ws .sec-head h2 { font-family: var(--display); font-size: clamp(1.9rem, 4vw, 2.8rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1.05; margin-top: 0.4rem; display: flex; align-items: baseline; gap: 0.75rem; }
.ws .sec-head .count { font-family: var(--mono); font-size: 0.9rem; font-weight: 500; color: var(--muted); border: 1px solid var(--line-2); border-radius: 999px; padding: 0.1rem 0.6rem; }
.ws .blurb { color: var(--muted); margin-top: 0.75rem; line-height: 1.6; }
.ws .sub-h { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); margin-bottom: 1rem; }
.ws .subgroup { margin-bottom: 2rem; }

/* bento */
.ws .bento { display: grid; gap: 1rem; grid-template-columns: minmax(0, 1fr); }
@media (min-width: 800px) { .ws .bento { grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-rows: 260px; } .ws .bento-card.big { grid-column: span 2; grid-row: span 2; } }
.ws .bento-card { position: relative; overflow: hidden; border-radius: 20px; border: 1px solid var(--line); background: var(--panel); min-height: 260px; display: flex; align-items: flex-end; isolation: isolate; transition: border-color 0.2s, transform 0.2s; }
.ws .bento-card:hover { border-color: var(--c); transform: translateY(-2px); }
.ws .bento-card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: transform 0.6s ease; }
.ws .bento-card:hover img { transform: scale(1.04); }
.ws .bento-card::after { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(11, 13, 18, 0) 10%, rgba(11, 13, 18, 0.55) 45%, rgba(11, 13, 18, 0.96) 75%); }
.ws .bento-body { padding: 1.4rem; }
.ws .bento-card h3 { font-family: var(--display); font-weight: 700; font-size: 1.4rem; letter-spacing: -0.02em; margin-top: 0.5rem; }
.ws .bento-card.big h3 { font-size: clamp(1.6rem, 3vw, 2.4rem); }
.ws .bento-card p { color: #c9ced8; font-size: 0.9rem; line-height: 1.5; margin-top: 0.4rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.ws .bento-card.big p { -webkit-line-clamp: 3; max-width: 60ch; }
@media (min-width: 800px) { .ws .bento-card.podcast { grid-column: 1 / -1; grid-row: span 1; } .ws .podcast .wave { left: auto; width: 42%; top: 50%; transform: translateY(-50%); height: 120px; } .ws .podcast .bento-body { max-width: 52%; } .ws .podcast p { -webkit-line-clamp: 3; } }
.ws .podcast { background: radial-gradient(120% 90% at 100% 0%, rgba(167, 139, 250, 0.25), transparent 60%), var(--panel); }
.ws .podcast::after { display: none; }
.ws .wave { position: absolute; top: 1.4rem; left: 1.4rem; right: 1.4rem; height: 70px; display: flex; align-items: center; gap: 4px; }
.ws .wave span { flex: 1; background: var(--violet); border-radius: 2px; opacity: 0.75; height: 20%; animation: ws-wave 1.2s ease-in-out infinite alternate; animation-delay: calc(var(--i) * -0.09s); }
