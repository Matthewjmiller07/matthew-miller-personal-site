.ws .pill { display: inline-block; align-self: flex-start; font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--c, var(--amber)); background: color-mix(in srgb, var(--c, var(--amber)) 14%, transparent); border: 1px solid color-mix(in srgb, var(--c, var(--amber)) 30%, transparent); padding: 0.18rem 0.55rem; border-radius: 999px; }

/* filter bar */
.ws .filterbar { position: sticky; top: 0; z-index: 30; margin-top: 4rem; background: rgba(11, 13, 18, 0.82); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-block: 1px solid var(--line); }
.ws .filter-inner { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; padding-top: 0.75rem; padding-bottom: 0.75rem; }
