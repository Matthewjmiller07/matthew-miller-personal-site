---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Website Proposal — Hazon Properties | Matthew Miller"
  description="A proposal to redesign and rebuild the Hazon Properties website — modern, fast, and built to convert."
>
  <main class="min-h-screen bg-white dark:bg-gray-950">

    <!-- Hero -->
    <section class="relative bg-gradient-to-br from-[#0f1c2e] to-[#1a3050] text-white overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: url('/proposals/hazon/prop2.jpg'); background-size: cover; background-position: center;"></div>
      <div class="relative container mx-auto px-6 py-20 max-w-5xl">
        <div class="flex items-center gap-3 mb-8">
          <img src="/proposals/hazon/hazon-logo.png" alt="Hazon Properties" class="h-10 bg-white/10 rounded px-2 py-1" />
          <span class="text-white/40 text-2xl">×</span>
          <span class="text-white font-semibold">Matthew Miller</span>
        </div>
        <p class="text-blue-300 uppercase tracking-widest text-sm font-medium mb-4">Website Redesign Proposal</p>
        <h1 class="text-4xl md:text-6xl font-bold mb-6 leading-tight">
          A Website as Premium<br />as Your Properties
        </h1>
        <p class="text-xl text-white/70 max-w-2xl mb-10">
          A proposal to rebuild hazonproperties.com from the ground up — faster, more beautiful, and built to turn visitors into clients for Yafit Gould and the Hazon team.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="#mockup" class="px-8 py-4 bg-amber-500 hover:bg-amber-400 text-white font-semibold rounded-lg transition-colors shadow-lg">
            See the Mockup
          </a>
          <a href="#investment" class="px-8 py-4 bg-white/10 hover:bg-white/20 border border-white/20 text-white font-semibold rounded-lg transition-colors">
            View Investment
          </a>
        </div>
      </div>
    </section>

    <!-- Current Site Analysis -->
    <section class="py-20 bg-gray-50 dark:bg-gray-900">
      <div class="container mx-auto px-6 max-w-5xl">
        <div class="text-center mb-14">
          <p class="text-red-500 uppercase tracking-widest text-sm font-medium mb-3">Current State</p>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white">What's Holding the Site Back</h2>
          <p class="text-gray-500 dark:text-gray-400 mt-4 max-w-2xl mx-auto">The current hazonproperties.com has real strengths — strong inventory, a compelling agent, and multilingual reach — but the presentation is costing leads.</p>
        </div>

        <!-- Screenshot-style frame of current site -->
        <div class="relative rounded-2xl overflow-hidden shadow-2xl border border-gray-200 dark:border-gray-700 mb-12">
          <!-- Browser chrome -->
          <div class="bg-gray-100 dark:bg-gray-800 px-4 py-3 flex items-center gap-3 border-b border-gray-200 dark:border-gray-700">
            <div class="flex gap-2">
              <div class="w-3 h-3 rounded-full bg-red-400"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
              <div class="w-3 h-3 rounded-full bg-green-400"></div>
            </div>
            <div class="flex-1 bg-white dark:bg-gray-700 rounded px-3 py-1 text-xs text-gray-500 dark:text-gray-400 font-mono">
              hazonproperties.com/en/agent/יפית-גולד/
            </div>
          </div>
          <!-- Simulated current site -->
          <div class="bg-white p-6 font-sans">
            <div class="flex items-center justify-between border-b pb-3 mb-4">
              <img src="/proposals/hazon/hazon-logo.png" alt="Hazon" class="h-8" />
              <div class="text-xs text-gray-500 space-x-3 hidden sm:flex">
                <span>Home</span><span>Properties</span><span>Our Team</span><span>Contact</span>
              </div>
              <div class="text-xs text-gray-400">EN | HE | FR</div>
            </div>
            <div class="flex flex-col md:flex-row gap-6">
              <div class="md:w-1/3">
                <img src="/proposals/hazon/agent-yafit.jpg" alt="Yafit Gould" class="w-36 h-36 object-cover rounded mb-3" />
                <p class="font-bold text-sm text-gray-800">Yafit Gould</p>
                <p class="text-xs text-gray-500 mb-2">Owner, Hazon Ra'anana</p>
                <p class="text-xs text-gray-400 leading-relaxed">052-2247867<br/>hazonproperties@gmail.com</p>
              </div>
              <div class="md:w-2/3">
                <p class="text-xs text-gray-600 leading-relaxed mb-4 border-b pb-4">20 years in England with real estate experience, professionalism, ethics, personal responsibility and uncompromising service...</p>
                <div class="grid grid-cols-2 gap-3">
                  {[1,2,3,4].map(i => (
                    <div class="border border-gray-200 rounded p-2">
                      <img src={`/proposals/hazon/prop${Math.min(i,3)}.jpg`} alt="" class="w-full h-20 object-cover rounded mb-2" />
                      <p class="text-xs text-gray-700 font-medium">Property Listing #{i}</p>
                      <p class="text-xs text-gray-400">For Sale · Ra'anana</p>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
          <!-- Critique overlays -->
          <div class="absolute top-16 right-4 bg-red-500 text-white text-xs px-2 py-1 rounded shadow-lg max-w-[160px] leading-tight">
            ⚠️ Photo too small — no presence
          </div>
          <div class="absolute bottom-36 left-4 bg-red-500 text-white text-xs px-2 py-1 rounded shadow-lg max-w-[160px] leading-tight">
            ⚠️ Cards feel cramped, no hover state
          </div>
        </div>

        <!-- Problem cards -->
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {[
            { icon: "📱", title: "Not Mobile-First", desc: "The layout breaks on smartphones — where most property searches start." },
            { icon: "🖼️", title: "Agent Undersold", desc: "A 210×210px headshot for a 20-year veteran with a law degree and interior design background. Yafit deserves a hero moment." },
            { icon: "🔎", title: "Weak Search UX", desc: "The filter panel is dense and dated. Buyers can't quickly discover the right property." },
            { icon: "🌐", title: "Language Fragmentation", desc: "Hebrew, English, and French content isn't cleanly separated — URLs include raw Unicode characters." },
            { icon: "⚡", title: "Slow Load Speed", desc: "WordPress with unoptimized images. Modern buyers won't wait. Every second costs conversions." },
            { icon: "✍️", title: "No Brand Story", desc: "No trust-building — no video, no timeline, no credentials. The brand is commoditized in a premium market." },
          ].map(p => (
            <div class="bg-white dark:bg-gray-800 rounded-xl p-5 border border-gray-100 dark:border-gray-700 shadow-sm">
              <div class="text-2xl mb-3">{p.icon}</div>
              <h3 class="font-bold text-gray-900 dark:text-white mb-1">{p.title}</h3>
              <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">{p.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Mockup Section -->
    <section id="mockup" class="py-20 bg-white dark:bg-gray-950">
      <div class="container mx-auto px-6 max-w-5xl">
        <div class="text-center mb-14">
          <p class="text-amber-500 uppercase tracking-widest text-sm font-medium mb-3">The Vision</p>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white">What We'd Build</h2>
          <p class="text-gray-500 dark:text-gray-400 mt-4 max-w-2xl mx-auto">Partial mockups of the rebuilt experience — fast, premium, and built around Yafit's story and inventory.</p>
        </div>

        <!-- MOCKUP 1: Agent Hero -->
        <div class="mb-10">
          <div class="flex items-center gap-3 mb-4">
            <span class="bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wide">Mockup 1</span>
            <h3 class="font-bold text-gray-800 dark:text-white">Agent Profile Hero</h3>
          </div>
          <!-- Browser frame -->
          <div class="rounded-2xl overflow-hidden shadow-2xl border border-gray-200 dark:border-gray-700">
            <div class="bg-gray-100 dark:bg-gray-800 px-4 py-3 flex items-center gap-3 border-b border-gray-200 dark:border-gray-700">
              <div class="flex gap-2">
                <div class="w-3 h-3 rounded-full bg-red-400"></div>
                <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
                <div class="w-3 h-3 rounded-full bg-green-400"></div>
              </div>
              <div class="flex-1 bg-white dark:bg-gray-700 rounded px-3 py-1 text-xs text-gray-500 font-mono">hazonproperties.com/agents/yafit-gould</div>
            </div>
            <!-- Mockup nav -->
            <div class="bg-[#0f1c2e] px-8 py-4 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <img src="/proposals/hazon/hazon-logo.png" alt="Hazon" class="h-7 brightness-0 invert" />
              </div>
              <div class="hidden md:flex items-center gap-8 text-white/70 text-sm">
                <span>Properties</span>
                <span>Our Team</span>
                <span>About</span>
                <span>Contact</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="text-white/50 text-xs">EN · HE · FR</span>
                <button class="bg-amber-500 text-white text-xs px-4 py-2 rounded-lg font-medium">Book a Call</button>
              </div>
            </div>
            <!-- Hero area -->
            <div class="relative bg-[#0f1c2e] overflow-hidden">
              <div class="absolute inset-0 opacity-20" style="background-image: url('/proposals/hazon/prop2.jpg'); background-size: cover; background-position: center;"></div>
              <div class="relative flex flex-col md:flex-row items-end max-w-5xl mx-auto px-8 pt-12">
                <!-- Agent photo large -->
                <div class="md:w-2/5 flex justify-center md:justify-start">
                  <img
                    src="/proposals/hazon/agent-yafit.jpg"
                    alt="Yafit Gould"
                    class="w-56 md:w-72 h-auto object-cover object-top rounded-t-2xl shadow-2xl"
                    style="filter: brightness(1.05) contrast(1.02);"
                  />
                </div>
                <!-- Agent intro -->
                <div class="md:w-3/5 px-0 md:px-10 py-8 text-white">
                  <p class="text-amber-400 text-sm font-semibold uppercase tracking-widest mb-2">Hazon Properties · Ra'anana</p>
                  <h1 class="text-4xl font-bold mb-2">Yafit Gould</h1>
                  <p class="text-white/60 text-sm mb-5">Attorney · Interior Designer · 20+ Years in Real Estate</p>
                  <p class="text-white/80 leading-relaxed text-sm max-w-sm mb-6">Bringing two decades of English and Israeli property expertise, legal precision, and an eye for design to every transaction.</p>
                  <div class="flex flex-wrap gap-3 mb-6">
                    <a href="#" class="bg-amber-500 hover:bg-amber-400 text-white text-sm px-5 py-2.5 rounded-lg font-semibold transition-colors">View My Listings</a>
                    <a href="#" class="bg-white/10 hover:bg-white/20 border border-white/20 text-white text-sm px-5 py-2.5 rounded-lg font-semibold transition-colors">052-224-7867</a>
                  </div>
                  <div class="flex gap-6 text-center">
                    {[["50+","Active Listings"],["20","Years Experience"],["3","Languages"]].map(([n,l]) => (
                      <div>
                        <p class="text-2xl font-bold text-amber-400">{n}</p>
                        <p class="text-white/50 text-xs">{l}</p>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- MOCKUP 2: Property Cards -->
        <div class="mb-10">
          <div class="flex items-center gap-3 mb-4">
            <span class="bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wide">Mockup 2</span>
            <h3 class="font-bold text-gray-800 dark:text-white">Property Listing Cards</h3>
          </div>
          <div class="rounded-2xl overflow-hidden shadow-2xl border border-gray-200 dark:border-gray-700">
            <div class="bg-gray-100 dark:bg-gray-800 px-4 py-3 flex items-center gap-3 border-b border-gray-200 dark:border-gray-700">
              <div class="flex gap-2">
                <div class="w-3 h-3 rounded-full bg-red-400"></div>
                <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
                <div class="w-3 h-3 rounded-full bg-green-400"></div>
              </div>
              <div class="flex-1 bg-white dark:bg-gray-700 rounded px-3 py-1 text-xs text-gray-500 font-mono">hazonproperties.com/properties</div>
            </div>
            <div class="bg-gray-50 dark:bg-gray-900 p-6 md:p-10">
              <div class="flex items-center justify-between mb-8">
                <div>
                  <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Featured Properties</h2>
                  <p class="text-gray-500 text-sm mt-1">Curated by Yafit Gould · Ra'anana & Tel Aviv</p>
                </div>
                <div class="flex gap-2">
                  <button class="text-xs px-4 py-2 bg-[#0f1c2e] text-white rounded-lg">For Sale</button>
                  <button class="text-xs px-4 py-2 border border-gray-300 dark:border-gray-600 text-gray-600 dark:text-gray-300 rounded-lg">For Rent</button>
                </div>
              </div>
              <div class="grid md:grid-cols-3 gap-5">
                {[
                  { img: "/proposals/hazon/prop1.jpg", type: "For Sale", price: "₪4,800,000", beds: 5, baths: 3, sqm: 180, loc: "Ra'anana Center", tag: "Luxury Villa" },
                  { img: "/proposals/hazon/prop2.jpg", type: "For Sale", price: "₪25,000,000", beds: 5, baths: 4, sqm: 320, loc: "Tel Aviv", tag: "Penthouse" },
                  { img: "/proposals/hazon/prop3.jpg", type: "For Rent", price: "₪18,000/mo", beds: 4, baths: 3, sqm: 200, loc: "Ra'anana South", tag: "Garden Villa" },
                ].map(p => (
                  <div class="bg-white dark:bg-gray-800 rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 group cursor-pointer">
                    <div class="relative overflow-hidden h-44">
                      <img src={p.img} alt={p.tag} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                      <div class="absolute top-3 left-3">
                        <span class={`text-xs font-bold px-2.5 py-1 rounded-full ${p.type === 'For Sale' ? 'bg-[#0f1c2e] text-white' : 'bg-amber-500 text-white'}`}>{p.type}</span>
                      </div>
                      <div class="absolute top-3 right-3">
                        <span class="bg-white/90 backdrop-blur text-gray-800 text-xs font-semibold px-2.5 py-1 rounded-full">{p.tag}</span>
                      </div>
                    </div>
                    <div class="p-4">
                      <p class="font-bold text-xl text-gray-900 dark:text-white mb-1">{p.price}</p>
                      <p class="text-gray-500 dark:text-gray-400 text-sm mb-3 flex items-center gap-1">
                        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/></svg>
                        {p.loc}
                      </p>
                      <div class="flex items-center gap-4 text-xs text-gray-500 dark:text-gray-400 border-t border-gray-100 dark:border-gray-700 pt-3">
                        <span>🛏 {p.beds} bed</span>
                        <span>🚿 {p.baths} bath</span>
                        <span>📐 {p.sqm}m²</span>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- MOCKUP 3: Mobile Nav -->
        <div class="mb-4">
          <div class="flex items-center gap-3 mb-4">
            <span class="bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wide">Mockup 3</span>
            <h3 class="font-bold text-gray-800 dark:text-white">Mobile Experience</h3>
          </div>
          <div class="flex justify-center">
            <div class="w-72 rounded-[2rem] overflow-hidden shadow-2xl border-4 border-gray-800 dark:border-gray-600 bg-white">
              <!-- Status bar -->
              <div class="bg-[#0f1c2e] px-5 pt-3 pb-2 flex justify-between items-center">
                <span class="text-white text-xs">9:41</span>
                <div class="flex gap-1">
                  <div class="w-4 h-2 bg-white/60 rounded-sm"></div>
                  <div class="w-1.5 h-1.5 bg-white/60 rounded-full mt-0.5"></div>
                </div>
              </div>
              <!-- Mobile nav -->
              <div class="bg-[#0f1c2e] px-5 pb-4 flex items-center justify-between">
                <img src="/proposals/hazon/hazon-logo.png" alt="Hazon" class="h-6 brightness-0 invert" />
                <div class="flex flex-col gap-1">
                  <div class="w-5 h-0.5 bg-white"></div>
                  <div class="w-5 h-0.5 bg-white"></div>
                  <div class="w-3 h-0.5 bg-white"></div>
                </div>
              </div>
              <!-- Agent card mobile -->
              <div class="relative bg-[#0f1c2e] pb-8">
                <div class="absolute inset-0 opacity-20" style="background-image: url('/proposals/hazon/prop2.jpg'); background-size: cover;"></div>
                <div class="relative flex flex-col items-center pt-6 px-5 text-white text-center">
                  <img src="/proposals/hazon/agent-yafit.jpg" alt="Yafit Gould" class="w-24 h-24 object-cover rounded-full border-4 border-amber-400 shadow-xl mb-3" />
                  <h2 class="font-bold text-lg">Yafit Gould</h2>
                  <p class="text-amber-400 text-xs mb-2">Owner · Attorney · Designer</p>
                  <div class="flex gap-3 mt-2">
                    <a href="#" class="bg-amber-500 text-white text-xs px-4 py-2 rounded-lg font-semibold">Listings</a>
                    <a href="#" class="bg-white/10 border border-white/30 text-white text-xs px-4 py-2 rounded-lg font-semibold">Call</a>
                  </div>
                </div>
              </div>
              <!-- Mobile cards -->
              <div class="bg-gray-50 p-4 space-y-3">
                {[
                  { img: "/proposals/hazon/prop1.jpg", price: "₪4,800,000", loc: "Ra'anana", type: "For Sale" },
                  { img: "/proposals/hazon/prop3.jpg", price: "₪18,000/mo", loc: "Ra'anana South", type: "For Rent" },
                ].map(p => (
                  <div class="bg-white rounded-xl overflow-hidden shadow-sm flex">
                    <img src={p.img} alt="" class="w-24 h-20 object-cover flex-shrink-0" />
                    <div class="p-3">
                      <span class={`text-xs font-bold px-2 py-0.5 rounded-full ${p.type === 'For Sale' ? 'bg-[#0f1c2e] text-white' : 'bg-amber-500 text-white'}`}>{p.type}</span>
                      <p class="font-bold text-sm text-gray-900 mt-1">{p.price}</p>
                      <p class="text-xs text-gray-500">{p.loc}</p>
                    </div>
                  </div>
                ))}
                <div class="text-center py-2">
                  <p class="text-xs text-gray-400">Scrollable · Touch-optimized · RTL support</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- What's Included -->
    <section class="py-20 bg-[#0f1c2e] text-white">
      <div class="container mx-auto px-6 max-w-5xl">
        <div class="text-center mb-14">
          <p class="text-amber-400 uppercase tracking-widest text-sm font-medium mb-3">Deliverables</p>
          <h2 class="text-3xl md:text-4xl font-bold">Everything Included</h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {[
            { icon: "🏗️", title: "Custom Build", desc: "Built on Astro + Tailwind — not a WordPress theme. Fast by default, easy to update." },
            { icon: "📱", title: "Mobile-First", desc: "Designed for phones first. Every layout, card, and form works beautifully on all screen sizes." },
            { icon: "🌐", title: "Trilingual", desc: "Proper Hebrew (RTL), English, and French support with clean URL structure." },
            { icon: "🔍", title: "Smart Property Search", desc: "Filter by price, rooms, location, and type. Instant results, no page reload." },
            { icon: "👤", title: "Agent Profile Pages", desc: "Each agent gets a full-featured hero page with bio, credentials, stats, and listings." },
            { icon: "⚡", title: "Performance Optimized", desc: "Images served in WebP, lazy-loaded. Lighthouse score 95+. Fast on any connection." },
            { icon: "🎨", title: "Brand Design System", desc: "Full color palette, typography, and component library consistent across every page." },
            { icon: "📧", title: "Lead Capture Forms", desc: "Property inquiry, callback request, and WhatsApp integration built in." },
            { icon: "🚀", title: "Netlify Deploy", desc: "Deployed to Netlify CDN with CI/CD. Updates go live in seconds, no FTP needed." },
          ].map(item => (
            <div class="bg-white/5 hover:bg-white/10 transition-colors rounded-xl p-5 border border-white/10">
              <div class="text-2xl mb-3">{item.icon}</div>
              <h3 class="font-bold text-white mb-1">{item.title}</h3>
              <p class="text-white/60 text-sm leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Investment -->
    <section id="investment" class="py-20 bg-white dark:bg-gray-950">
      <div class="container mx-auto px-6 max-w-3xl">
        <div class="text-center mb-14">
          <p class="text-amber-500 uppercase tracking-widest text-sm font-medium mb-3">Investment</p>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white">Pricing</h2>
          <p class="text-gray-500 dark:text-gray-400 mt-4">One-time build fee. No recurring platform costs. You own everything.</p>
        </div>

        <div class="bg-gradient-to-br from-[#0f1c2e] to-[#1a3050] rounded-2xl p-8 md:p-10 text-white shadow-2xl mb-8">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6 mb-8">
            <div>
              <h3 class="text-2xl font-bold mb-1">Hazon Properties Rebuild</h3>
              <p class="text-white/60 text-sm">Full custom site · Trilingual · Agent profiles · Property listings</p>
            </div>
            <div class="text-right">
              <p class="text-4xl font-bold text-amber-400">$4,800</p>
              <p class="text-white/50 text-sm">one-time · USD</p>
            </div>
          </div>
          <div class="grid sm:grid-cols-2 gap-3 mb-8">
            {[
              "Custom design tailored to Hazon brand",
              "Up to 10 agent profile pages",
              "Property listing system (unlimited)",
              "Hebrew, English & French support",
              "Mobile-first, RTL-ready layout",
              "WhatsApp & inquiry form integration",
              "Netlify deployment & domain setup",
              "2 rounds of design revisions",
              "30 days post-launch support",
              "Training for content updates",
            ].map(item => (
              <div class="flex items-start gap-2 text-sm text-white/80">
                <svg class="w-4 h-4 text-amber-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                {item}
              </div>
            ))}
          </div>
          <div class="border-t border-white/10 pt-6 flex flex-col sm:flex-row gap-3">
