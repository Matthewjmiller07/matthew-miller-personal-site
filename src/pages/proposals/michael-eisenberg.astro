---
import Layout from '../../layouts/Layout.astro';

const base = '/proposals/michael-eisenberg';

const reels = [
  { id: 'reel-vayishlach', parsha: 'Vayishlach', date: '28 Nov', hook: 'Jacob gave away his fortune at the border.', chapter: 'Ch. 8 · From Love to Fear' },
  { id: 'reel-vayeshev', parsha: 'Vayeshev', date: '5 Dec', hook: 'Joseph’s dreams were a pitch deck.', chapter: 'Ch. 9 · Land Reserve' },
  { id: 'reel-miketz', parsha: 'Miketz', date: '12 Dec', hook: 'iPhones are built in China. The profits land in California.', chapter: 'Ch. 10 · City Mouse' },
];

const cards = [
  { id: 'card-yesh-li-kol', ref: 'Genesis 33:11', he: 'וְכִי יֶשׁ לִי כֹל' },
  { id: 'card-shalem', ref: 'Genesis 33:18', he: 'וַיָּבֹא יַעֲקֹב שָׁלֵם' },
  { id: 'card-alumot', ref: 'Genesis 37:7', he: 'קָמָה אֲלֻמָּתִי' },
  { id: 'card-pikadon', ref: 'Genesis 41:36', he: 'לְפִקָּדוֹן לָאָרֶץ' },
];

const readers = [
  { id: 'vayishlach-reader', parsha: 'Vayishlach', title: 'Clean Money First', sub: 'Why Jacob gave his fortune away at the border' },
  { id: 'vayeshev-reader', parsha: 'Vayeshev', title: 'The Sheaves Bow', sub: 'Joseph’s dreams as a plan for a family business in trouble' },
  { id: 'miketz-reader', parsha: 'Miketz', title: 'Food in the Cities', sub: 'Joseph turned a famine into the world’s first trading hub' },
];

// The book's twelve chapters against this year's Shabbatot (Israel reading).
const calendar = [
  ['Bereishit', 'Mission (Im)Possible', '10 Oct'],
  ['Noach', 'The Frustrated Inventor', '17 Oct'],
  ['Lekh Lekha', 'Wealth: Trial and Error', '24 Oct'],
  ['Vayera', 'An Ember Saved from Fire', '31 Oct'],
  ['Chayei Sarah', 'Game Theory at the Cave of Machpelah', '7 Nov'],
  ['Toldot', 'The Birthright and the Blessing', '14 Nov'],
  ['Vayetzei', 'Quid Pro Quo', '21 Nov'],
  ['Vayishlach', 'From Love to Fear', '28 Nov', 'built'],
  ['Vayeshev', 'Land Reserve', '5 Dec', 'built'],
  ['Miketz', 'City Mouse', '12 Dec', 'built'],
  ['Vayigash', 'A Warning Sign', '19 Dec'],
  ['Vayechi', 'The Land and the Sea', '26 Dec'],
];

const inventory = [
  ['The book', 'The Tree of Life and Prosperity (2021). Twelve chapters, one per parsha of Genesis, plus a long preface on what you learned investing.'],
  ['The audiobook', 'About nine hours, narrated by Tristan Morris.'],
  ['The Hebrew shelf', 'The Hebrew original of this book and, per your author bio, four more books in Hebrew.'],
  ['The podcast', 'Invested by Aleph: hour-long conversations with founders and investors, still publishing in 2026.'],
  ['The writing', '“Six Kids and a Full Time Job,” running since 2006, and pieces for TheMarker.'],
  ['The appearances', 'Aish’s Good with Money, the Daily Signal, Rabbi Buxbaum’s and Rabbi Wildes’s podcasts, and others.'],
];

const gaps = [
  ['The book doesn’t have your voice.', 'The audiobook is someone else reading your stories: the PictureVision attic, the board you resigned from, the Lemonade coffee. You tell those stories on podcasts all the time. Those recordings are the material for clips.'],
  ['The book already follows a calendar, and nothing publishes on it.', 'Twelve chapters line up with twelve Shabbatot, every year. People go looking for Torah to share each week, and I couldn’t find any weekly series from the book that meets them there.'],
  ['The podcast stops at the full episode.', 'Invested runs about an hour per episode. I couldn’t find vertical clips, quote cards or written versions for people who won’t start a 60-minute episode.'],
  ['The Torah-and-business work is spread across other people’s platforms.', 'Your Genesis lessons appear on Aish, on other people’s podcasts and in interviews. There is no single place where someone who loved one clip can find the rest.'],
  ['The volumes stop at Genesis in English.', 'The preface promises a five-volume series. Only Genesis is in English. Weekly readers are a low-cost way to test Exodus with English readers before a publisher is involved.'],
];

const weekly = [
  ['Sunday', 'Pick the chapter', 'The week’s chapter, plus any Invested moment where you made the same point out loud.'],
  ['Tuesday', 'Cut and set', 'One or two vertical reels, two quote cards and a two-page reader. Hebrew from Sefaria, your words verbatim.'],
  ['Wednesday', 'Your review', 'Ten minutes on your phone. Nothing goes out that you haven’t approved.'],
  ['Thursday', 'It goes out', 'Reels to Instagram, LinkedIn, X and Shorts. The reader to WhatsApp and email, before people print for Shabbat.'],
];
---

<Layout
  title="Genesis, Weekly — A Proposal for Michael Eisenberg | Matthew Miller"
  description="A content proposal for Michael Eisenberg: reels, quote cards and Shabbat readers built from The Tree of Life and Prosperity, timed to the weekly parsha."
>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400;1,6..72,500&family=Frank+Ruhl+Libre:wght@500&family=IBM+Plex+Mono:wght@400;500&display=swap');

  .me-page {
    --paper: #f3eee3;
    --paper-2: #ebe4d4;
    --ink: #18160f;
    --ink-2: #3a362c;
    --mute: #6f675a;
    --green: #1f4a37;
    --rust: #a4432a;
    --rule: rgba(24,22,15,0.16);
    --serif: 'Newsreader', Georgia, serif;
    --mono: 'IBM Plex Mono', ui-monospace, monospace;
    --hebrew: 'Frank Ruhl Libre', 'Arial Hebrew', serif;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--serif);
    overflow-x: hidden;
  }
  .me-page * { box-sizing: border-box; }
  .me-page :is(h1, h2, h3, p, li, span, div, figcaption, td, th, a) { color: inherit; }
  .me-wrap { max-width: 1120px; margin: 0 auto; padding: 0 40px; }
  .me-mono { font-family: var(--mono); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--mute); }
  .me-page .me-green { color: var(--green); }
  .me-page .me-rust { color: var(--rust); }
  .me-he { font-family: var(--hebrew); direction: rtl; }
  .me-page em { font-style: italic; color: var(--green); }

  /* masthead */
  .me-mast { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding: 28px 0 14px; border-bottom: 1.5px solid var(--ink); }

  /* hero */
  .me-hero { display: grid; grid-template-columns: 1.25fr 0.75fr; gap: 64px; align-items: center; padding: 72px 0 88px; }
  .me-hero h1 { font-size: clamp(3rem, 7vw, 6rem); font-weight: 500; line-height: 0.98; letter-spacing: -0.03em; margin: 18px 0 28px; }
  .me-lede { font-size: 1.3rem; line-height: 1.6; color: var(--ink-2); max-width: 560px; }
  .me-lede + .me-lede { margin-top: 16px; }
  .me-links { display: flex; gap: 24px; flex-wrap: wrap; margin-top: 36px; }
  .me-page .me-link { font-family: var(--mono); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; border-bottom: 1.5px solid var(--ink); padding-bottom: 3px; }
  .me-page .me-link:hover { color: var(--green); border-color: var(--green); }
  .me-phone { width: 100%; max-width: 320px; margin: 0 auto; aspect-ratio: 9/16; background: var(--ink); border-radius: 28px; padding: 8px; box-shadow: 0 30px 60px -30px rgba(24,22,15,0.5); }
  .me-phone video { width: 100%; height: 100%; object-fit: cover; border-radius: 21px; display: block; background: var(--paper); }

  /* sections */
  .me-sec { padding: 96px 0; border-top: 1px solid var(--rule); }
  .me-sec-head { display: grid; grid-template-columns: 220px 1fr; gap: 40px; margin-bottom: 56px; }
  .me-sec-head h2 { font-size: clamp(2.1rem, 4.2vw, 3.4rem); font-weight: 500; line-height: 1.05; letter-spacing: -0.02em; margin: 0 0 16px; }
  .me-sec-head p { font-size: 1.15rem; line-height: 1.65; color: var(--ink-2); max-width: 640px; margin: 0; }

  /* inventory */
  .me-inv { border-top: 1.5px solid var(--ink); }
  .me-inv-row { display: grid; grid-template-columns: 220px 1fr; gap: 40px; padding: 18px 0; border-bottom: 1px solid var(--rule); }
  .me-inv-row p { margin: 0; font-size: 1.1rem; line-height: 1.55; }

  /* gaps */
  .me-gaps { counter-reset: gap; }
  .me-gap { display: grid; grid-template-columns: 220px 1fr; gap: 40px; padding: 30px 0; border-bottom: 1px solid var(--rule); }
  .me-gap:first-child { border-top: 1.5px solid var(--ink); }
  .me-gap-n { font-family: var(--mono); font-size: 13px; color: var(--rust); letter-spacing: 0.1em; }
  .me-gap h3 { font-size: 1.65rem; font-weight: 500; line-height: 1.2; letter-spacing: -0.01em; margin: 0 0 10px; }
  .me-gap p { margin: 0; font-size: 1.1rem; line-height: 1.65; color: var(--ink-2); max-width: 680px; }
  .me-note { margin-top: 22px; font-size: 0.95rem; font-style: italic; color: var(--mute); }

  /* reels */
  .me-reels { display: grid; grid-template-columns: repeat(3, 1fr); gap: 36px; }
  .me-reel .me-phone { max-width: none; }
  .me-reel-meta { display: flex; justify-content: space-between; margin: 20px 0 8px; }
  .me-reel h3 { font-size: 1.45rem; font-weight: 500; line-height: 1.2; margin: 0 0 6px; letter-spacing: -0.01em; }
  .me-reel p { margin: 0; font-size: 0.98rem; color: var(--mute); font-style: italic; }
  .me-aside { margin-top: 48px; display: grid; grid-template-columns: 220px 1fr; gap: 40px; padding: 26px 0; border-top: 1.5px solid var(--ink); border-bottom: 1px solid var(--rule); }
  .me-aside p { margin: 0; font-size: 1.1rem; line-height: 1.65; max-width: 700px; }

  /* cards */
  .me-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .me-card { margin: 0; }
  .me-card video { width: 100%; aspect-ratio: 4/5; display: block; object-fit: cover; border: 1px solid var(--rule); background: var(--paper-2); }
  .me-card figcaption { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; padding-top: 10px; }
  .me-card .me-he { font-size: 1.15rem; }

  /* readers */
  .me-readers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .me-page .me-reader { display: block; text-decoration: none; }
  .me-reader-img { aspect-ratio: 8.5/11; overflow: hidden; border: 1px solid var(--rule); background: #f6f2e9; box-shadow: 0 18px 40px -28px rgba(24,22,15,0.55); transition: transform .3s ease; }
  .me-reader-img img { width: 100%; display: block; }
  .me-reader:hover .me-reader-img { transform: translateY(-4px); }
  .me-reader h3 { font-size: 1.45rem; font-weight: 500; margin: 18px 0 4px; letter-spacing: -0.01em; }
  .me-reader p { margin: 0 0 10px; color: var(--mute); font-style: italic; }

  /* calendar */
  .me-cal { width: 100%; border-collapse: collapse; border-top: 1.5px solid var(--ink); }
  .me-cal td { padding: 13px 10px 13px 0; border-bottom: 1px solid var(--rule); font-size: 1.08rem; vertical-align: baseline; }
  .me-cal td:first-child { width: 48px; font-family: var(--mono); font-size: 12px; color: var(--mute); }
  .me-cal td.p { width: 190px; font-weight: 500; }
  .me-cal td.d { width: 90px; text-align: right; font-family: var(--mono); font-size: 13px; color: var(--mute); padding-right: 0; }
  .me-cal tr.built td { background: rgba(31,74,55,0.07); }
  .me-cal tr.built td.d { color: var(--green); }
  .me-cal tr.past td { color: var(--mute); }
  .me-tag { font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--green); margin-left: 10px; white-space: nowrap; }

  /* weekly */
  .me-week { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1.5px solid var(--ink); }
  .me-week > div { padding: 22px 22px 6px 0; border-right: 1px solid var(--rule); margin-right: 22px; }
  .me-week > div:last-child { border-right: 0; margin-right: 0; }
  .me-week h3 { font-size: 1.35rem; font-weight: 500; margin: 10px 0 8px; }
  .me-week p { margin: 0; font-size: 1rem; line-height: 1.6; color: var(--ink-2); }

  /* close */
  .me-close { padding: 110px 0 100px; border-top: 1.5px solid var(--ink); }
  .me-close h2 { font-size: clamp(2.4rem, 5.5vw, 4.4rem); font-weight: 500; line-height: 1.02; letter-spacing: -0.025em; margin: 18px 0 26px; max-width: 900px; }
  .me-close p { font-size: 1.2rem; line-height: 1.65; color: var(--ink-2); max-width: 640px; margin: 0 0 14px; }

  @media (max-width: 960px) {
    .me-hero { grid-template-columns: 1fr; gap: 48px; padding-top: 48px; }
    .me-sec-head, .me-inv-row, .me-gap, .me-aside { grid-template-columns: 1fr; gap: 12px; }
    .me-reels { grid-template-columns: 1fr 1fr 1fr; gap: 16px; }
    .me-cards { grid-template-columns: 1fr 1fr; }
    .me-week { grid-template-columns: 1fr 1fr; }
    .me-week > div:nth-child(2) { border-right: 0; margin-right: 0; }
  }
  @media (max-width: 640px) {
    .me-wrap { padding: 0 16px; }
    .me-sec { padding: 72px 0; }
    .me-reels { grid-template-columns: 1fr; max-width: 340px; margin: 0 auto; gap: 44px; }
    .me-readers { grid-template-columns: 1fr; max-width: 380px; }
    .me-week { grid-template-columns: 1fr; }
    .me-week > div { border-right: 0; margin-right: 0; border-bottom: 1px solid var(--rule); padding-right: 0; }
    .me-cal td.p { width: auto; }
    .me-cal td.c { display: none; }
    .me-phone { max-width: 260px; }
  }
</style>

<main class="me-page">
  <div class="me-wrap">

    <div class="me-mast">
      <span class="me-mono">A proposal for Michael Eisenberg</span>
      <span class="me-mono">From Matthew Miller · November 2026</span>
    </div>

    <!-- HERO -->
    <section class="me-hero">
      <div>
        <p class="me-mono me-green">The Tree of Life and Prosperity, weekly</p>
        <h1>Genesis, read like a <em>board memo.</em> Every Shabbat.</h1>
        <p class="me-lede">
          Your book has twelve chapters, and each one lines up with a parsha. That makes it a weekly series that has been sitting on the shelf since 2021.
        </p>
        <p class="me-lede">
          I built the next three weeks from it: Vayishlach, Vayeshev and Miketz, as reels, quote cards and readers for the Shabbat table. They're all below.
        </p>
        <div class="me-links">
          <a class="me-link" href="#gaps">What's missing</a>
          <a class="me-link" href="#reels">The reels</a>
          <a class="me-link" href="#readers">The readers</a>
        </div>
      </div>
      <div class="me-phone" aria-hidden="true">
        <video src={`${base}/reel-vayishlach.mp4`} poster={`${base}/reel-vayishlach.jpg`} muted loop playsinline autoplay preload="metadata"></video>
      </div>
    </section>
  </div>

  <!-- INVENTORY -->
  <section class="me-sec">
    <div class="me-wrap">
      <div class="me-sec-head">
        <p class="me-mono">01 · What exists</p>
        <div>
          <h2>You've already made the hard part.</h2>
          <p>Before building anything I went through what's out there under your name. It's a lot of good material, in many separate places.</p>
        </div>
      </div>
      <div class="me-inv">
        {inventory.map(([k, v]) => (
          <div class="me-inv-row"><span class="me-mono">{k}</span><p>{v}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- GAPS -->
  <section class="me-sec" id="gaps">
    <div class="me-wrap">
      <div class="me-sec-head">
        <p class="me-mono me-rust">02 · What's missing</p>
        <div>
          <h2>Five gaps between the work and the people it could reach.</h2>
          <p>None of these are about the ideas. They're about packaging, timing and where the work lives.</p>
        </div>
      </div>
      <div class="me-gaps">
        {gaps.map(([h, p], i) => (
          <div class="me-gap">
            <span class="me-gap-n">Gap {String(i + 1).padStart(2, '0')}</span>
            <div><h3>{h}</h3><p>{p}</p></div>
          </div>
        ))}
      </div>
      <p class="me-note">From public sources only. If I've missed a channel you run, tell me and I'll take it off the list.</p>
    </div>
  </section>

  <!-- REELS -->
  <section class="me-sec" id="reels">
    <div class="me-wrap">
      <div class="me-sec-head">
        <p class="me-mono">03 · Reels</p>
        <div>
          <h2>One chapter, thirty seconds.</h2>
          <p>Each reel opens on a hook that makes sense with the sound off, walks through your argument in four beats, shows the pasuk in Hebrew, and lands on a line from the book, quoted word for word.</p>
        </div>
      </div>
      <div class="me-reels">
        {reels.map((r) => (
          <article class="me-reel">
            <div class="me-phone">
              <video src={`${base}/${r.id}.mp4`} poster={`${base}/${r.id}.jpg`} muted loop playsinline preload="none" data-autoplay></video>
            </div>
            <div class="me-reel-meta">
              <span class="me-mono me-green">Parashat {r.parsha}</span>
              <span class="me-mono">Shabbat {r.date}</span>
            </div>
            <h3>{r.hook}</h3>
            <p>{r.chapter}</p>
          </article>
        ))}
      </div>
      <div class="me-aside">
        <span class="me-mono me-rust">The next version</span>
        <p>These are built from the text alone. The stronger version uses your voice. On Invested you tell the same stories the book does, so each week's reel can be cut from a podcast moment where you make that chapter's point in your own words, with the pasuk and the book line on screen.</p>
      </div>
    </div>
  </section>

  <!-- CARDS -->
  <section class="me-sec" style="background: var(--paper-2);">
    <div class="me-wrap">
      <div class="me-sec-head">
        <p class="me-mono">04 · Quote cards</p>
        <div>
          <h2>The pasuk, then your line.</h2>
          <p>4:5 loops for Instagram, LinkedIn and WhatsApp status. The Hebrew builds word by word, then the translation, then the sentence from the book.</p>
        </div>
      </div>
      <div class="me-cards">
        {cards.map((c) => (
          <figure class="me-card">
            <video src={`${base}/${c.id}.mp4`} poster={`${base}/${c.id}.jpg`} muted loop playsinline preload="none" data-autoplay></video>
            <figcaption><span class="me-mono">{c.ref}</span><span class="me-he">{c.he}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- READERS -->
  <section class="me-sec" id="readers">
    <div class="me-wrap">
      <div class="me-sec-head">
        <p class="me-mono">05 · Shabbat readers</p>
        <div>
          <h2>Two pages for the Shabbat table.</h2>
          <p>The source in Hebrew and English, your argument in five steps, the boardroom version, and three questions to ask at the table. Your words are in quotation marks; everything else is clearly marked as summary.</p>
        </div>
      </div>
      <div class="me-readers">
        {readers.map((r) => (
          <a class="me-reader" href={`${base}/${r.id}.pdf`} target="_blank" rel="noopener">
            <div class="me-reader-img"><img src={`${base}/${r.id}.png`} alt={`First page of the ${r.parsha} reader`} loading="lazy" /></div>
            <h3>{r.title}</h3>
            <p>{r.sub}</p>
            <span class="me-mono me-green">Parashat {r.parsha} · Open PDF →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CALENDAR -->
  <section class="me-sec">
    <div class="me-wrap">
      <div class="me-sec-head">
        <p class="me-mono">06 · The calendar</p>
        <div>
          <h2>The book already has a calendar.</h2>
          <p>Twelve chapters, twelve Shabbatot, every year. Two weeks remain in this year's Genesis cycle after the three I built. Next October it starts again.</p>
        </div>
      </div>
      <table class="me-cal">
        <tbody>
          {calendar.map(([p, c, d, s], i) => (
            <tr class={s === 'built' ? 'built' : i < 7 ? 'past' : ''}>
              <td>{String(i + 1).padStart(2, '0')}</td>
              <td class="p">{p}</td>
              <td class="c">{c}{s === 'built' && <span class="me-tag">Built</span>}</td>
              <td class="d">{d}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- WEEKLY -->
  <section class="me-sec">
    <div class="me-wrap">
      <div class="me-sec-head">
        <p class="me-mono">07 · How it runs</p>
        <div>
          <h2>Ten minutes of your week.</h2>
          <p>You approve it, and I do everything else.</p>
        </div>
      </div>
      <div class="me-week">
        {weekly.map(([d, h, p]) => (
          <div><span class="me-mono me-green">{d}</span><h3>{h}</h3><p>{p}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- CLOSE -->
  <section class="me-close">
    <div class="me-wrap">
      <p class="me-he" style="font-size: 1.6rem; color: var(--green); text-align: left; direction: rtl; unicode-bidi: plaintext;">וְהָיָה הָאֹכֶל לְפִקָּדוֹן לָאָרֶץ</p>
      <h2>The book is the reserve. Let's start drawing on it.</h2>
      <p>I'm Matthew Miller. I build Torah learning tools and content systems, and I spent years as a principal analyst at G2. I made everything on this page from your book in a few days.</p>
      <p>Vayigash is on 19 December. If you'd like it, it'll be ready a week early.</p>
      <div class="me-links">
        <a class="me-link" href="mailto:matthewjmiller07@gmail.com?subject=Genesis, weekly">matthewjmiller07@gmail.com</a>
        <a class="me-link" href="/services">Other work</a>
      </div>
    </div>
  </section>

  <footer class="me-wrap" style="padding-top: 20px; padding-bottom: 28px; border-top: 1px solid var(--rule); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
    <span class="me-mono">TheOtherMatthewMiller.com</span>
    <span class="me-mono">Book quotes © Michael A. Eisenberg, 2021 · Hebrew from Sefaria</span>
  </footer>
</main>

<script>
  // Play muted loops only while on screen.
  const vids = document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]');
  const obs = new IntersectionObserver(
    (entries) => entries.forEach((e) => {
      const v = e.target as HTMLVideoElement;
      if (e.isIntersecting) v.play().catch(() => {});
      else v.pause();
    }),
    { threshold: 0.4 }
  );
  vids.forEach((v) => obs.observe(v));
</script>

</Layout>
