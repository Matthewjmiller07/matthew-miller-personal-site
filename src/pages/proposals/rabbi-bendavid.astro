<script>
  const reveals = document.querySelectorAll('.rb-reveal');
  const revealObs = new IntersectionObserver(
    (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('visible'); revealObs.unobserve(e.target); } }),
    { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
  );
  reveals.forEach((el) => revealObs.observe(el));

  // Play muted loops only while on screen.
  const vids = document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]');
  const playObs = new IntersectionObserver(
    (entries) => entries.forEach((e) => {
      const v = e.target as HTMLVideoElement;
      if (e.isIntersecting) v.play().catch(() => {});
      else v.pause();
    }),
    { threshold: 0.4 }
  );
  vids.forEach((v) => playObs.observe(v));

  // One clip with sound at a time.
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-sound]');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const v = btn.parentElement!.querySelector('video')!;
      const turningOn = v.muted;
      buttons.forEach((b) => {
        const other = b.parentElement!.querySelector('video')!;
        other.muted = true; b.classList.remove('on'); b.textContent = '🔇 Tap for sound';
      });
      if (turningOn) {
        v.muted = false; v.currentTime = 0; v.play().catch(() => {});
        btn.classList.add('on'); btn.textContent = '🔊 Sound on';
      }
    });
  });
</script>

</Layout>
