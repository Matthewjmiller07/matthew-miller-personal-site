---
import Layout from '../../layouts/Layout.astro';

const base = '/proposals/rabbi-bendavid';

const clips = [
  {
    id: 'closed-the-yeshiva',
    parsha: 'Lech Lecha',
    hook: 'Avraham closed the yeshiva and went to war',
    source: 'Rosh Yeshiva and Army General',
    youtube: 'https://youtu.be/PBK_fh3aats',
    span: '2:09 – 3:01',
    length: '0:55',
    beats: ['Hook slams in over the seforim', 'Radak: his talmidim were his army', '“He locks the doors” — punch-in zoom', 'Ahavat Yisrael, applied to today'],
  },
  {
    id: 'shacharit-club',
    parsha: 'Vayera',
    hook: 'Forget the 5AM Club. Join the Shacharit Club.',
    source: 'The Power of Visualization',
    youtube: 'https://youtu.be/Hfacsdar99k',
    span: '0:01 – 0:16 + 1:10 – 2:10',
    length: '1:17',
    beats: ['Opens on the best-seller everyone knows', 'Jump cut: “Avraham got there first”', 'Berakhot 26b: ein amidah ela tefillah', 'Rav Kook: Shacharit means standing firm'],
  },
  {
    id: 'rivkah-three',
    parsha: 'Chayei Sarah',
    hook: 'Was Rivkah really three years old?',
    source: 'Was Rivkah Really Three?',
    youtube: 'https://youtu.be/1S6S7gLk1Vw',
    span: '0:07 – 0:24 + 4:03 – 5:12',
    length: '1:29',
    beats: ['Asks the question everyone is afraid to ask', '“Here’s the twist” cut straight to the answer', 'Nedarim 32a: Avraham at three', 'Avraham at 40, Yitzchak at 40: the parallel'],
  },
];

const quotes = [
  { id: 'quote-chut-serokh-naal', parsha: 'Lech Lecha', he: 'אִם מִחוּט וְעַד שְׂרוֹךְ נַעַל', ref: 'Bereishit 14:23' },
  { id: 'quote-ein-amidah', parsha: 'Vayera', he: 'וְאֵין עֲמִידָה אֶלָּא תְּפִלָּה', ref: 'Berakhot 26b' },
  { id: 'quote-vatomer-elech', parsha: 'Chayei Sarah', he: 'וַתֹּאמֶר אֵלֵךְ', ref: 'Bereishit 24:58' },
  { id: 'quote-ben-shalosh', parsha: 'Chayei Sarah', he: 'בֶּן שָׁלֹשׁ שָׁנִים הִכִּיר אַבְרָהָם', ref: 'Nedarim 32a' },
];

const readers = [
  { pdf: 'lech-lecha-reader.pdf', parsha: 'Lech Lecha', title: 'Rosh Yeshiva and Army General', he: 'רֹאשׁ יְשִׁיבָה וְשַׂר צָבָא', sources: ['Bereishit 14:14, 22–23', 'Radak', 'Abarbanel', 'Rav Lichtenstein & Rav Amital'] },
  { pdf: 'vayera-reader.pdf', parsha: 'Vayera', title: 'The Shacharit Club', he: 'וַיַּשְׁכֵּם אַבְרָהָם בַּבֹּקֶר', sources: ['Bereishit 19:27', 'Berakhot 26b', 'Rav Kook', 'Birkot HaShachar'] },
  { pdf: 'chayei-sarah-reader.pdf', parsha: 'Chayei Sarah', title: 'Was Rivkah Really Three?', he: 'בַּת שָׁלֹשׁ שָׁנִים', sources: ['Bereishit 24:58, 25:20', 'Rashi', 'Nedarim 32a', 'Rambam, Avodah Zarah 1:3'] },
];

const ticker = ['Avraham closed the yeshiva', 'Forget the 5AM Club', 'Was Rivkah really three?', 'Not a thread, not a sandal strap', 'Ein amidah ela tefillah', 'Here’s the twist', 'Join the Shacharit Club', 'He locks the doors'];

const pipeline = [
  { day: 'Thursday', title: 'You record', desc: 'Same as now: your weekly parsha video, 3–6 minutes, phone on the shtender. Nothing changes on your end.' },
  { day: 'Thursday night', title: 'Transcribe + mine', desc: 'Word-level transcript tuned for Torah vocabulary. Every quotable moment, source, and twist gets flagged.' },
  { day: 'Friday morning', title: 'The kit lands', desc: '2–3 vertical clips, 2 quote cards, and a one-page reader, ready for WhatsApp, Instagram, TikTok, and YouTube Shorts.' },
  { day: 'Erev Shabbat', title: 'It travels', desc: 'The reader goes on the Shabbat table. The clips go to the kehilla groups. The best line is the one people quote at kiddush.' },
];

const deliverables = [
  { n: '01', title: 'Vertical clips', desc: 'Full-bleed 9:16, a hook headline, word-by-word captions with key words punched in, jump-cut twists, and an end card that sends viewers to the full shiur.' },
  { n: '02', title: 'Animated quote cards', desc: 'The pasuk or Gemara builds in Hebrew word by word, then the English, then your line. 4:5 loops made for the feed and for WhatsApp status.' },
  { n: '03', title: 'Shiur readers', desc: 'Typeset one-to-two page PDFs: Hebrew sources from Sefaria, your argument step by step, pull-quotes, and Shabbat-table questions.' },
  { n: '04', title: 'Weekly cadence', desc: 'Built around the parsha calendar, so each kit lands before Shabbat, when people are actually looking for Torah to share.' },
  { n: '05', title: 'Back-catalog revival', desc: '294 videos are already recorded. The best of them come back each year when their parsha does, with no new filming.' },
  { n: '06', title: 'Shivtei website hub', desc: 'Optional: a searchable home for every shiur, by parsha and by topic, with clips, readers, and the full videos.' },
];
---

<Layout
  title="Torah That Stops the Scroll — Rav Eitan Bendavid | Matthew Miller"
  description="A content proposal for Rav Eitan Bendavid of Kehillat Shivtei Yisrael: vertical clips, animated quote cards, and shiur readers built from his weekly parsha videos."
>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Anton&family=Frank+Ruhl+Libre:wght@500;700&family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@1,500&display=swap');

  .rb-page {
    --gold: #f5c542;
    --hot: #ff4d3d;
    --ink: #0b0a10;
    --ink-2: #13111b;
    --ink-3: #1c1927;
    --text: #f5efe2;
    --muted: #8f8a9c;
    --rule: rgba(245,197,66,0.16);
    --display: 'Anton', Impact, sans-serif;
    --body: 'Inter', system-ui, sans-serif;
    --hebrew: 'Frank Ruhl Libre', 'Arial Hebrew', serif;
    background: var(--ink);
    color: var(--text);
    font-family: var(--body);
    overflow-x: hidden;
  }
  .rb-page * { box-sizing: border-box; }
  /* global.css colors every p/li/span/div; let this page's own colors cascade instead */
  .rb-page :is(h1, h2, h3, p, li, span, div, figcaption) { color: inherit; }
  .rb-inner { max-width: 1180px; margin: 0 auto; padding: 0 40px; }
  .rb-display { font-family: var(--display); font-weight: 400; text-transform: uppercase; letter-spacing: 0.005em; line-height: 0.95; }
  .rb-he { font-family: var(--hebrew); direction: rtl; }
  .rb-page .rb-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 4px; text-transform: uppercase; color: var(--gold); }
  .rb-page .rb-hl { background: var(--gold); color: var(--ink); padding: 0 0.12em; border-radius: 0.08em; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
  .rb-page .rb-hl-hot { background: var(--hot); color: #fff; }

  /* hero */
  .rb-hero { position: relative; min-height: min(100vh, 900px); display: grid; grid-template-columns: 1.05fr 1fr; align-items: center; gap: 40px; padding: 72px 0 120px; }
  .rb-hero-bg { position: absolute; inset: 0; background:
      radial-gradient(60% 50% at 75% 45%, rgba(245,197,66,0.13), transparent 70%),
      radial-gradient(40% 40% at 10% 90%, rgba(255,77,61,0.10), transparent 70%); pointer-events: none; }
  .rb-hero > * { min-width: 0; }
  .rb-hero h1 { font-size: clamp(3.6rem, 8.2vw, 7.6rem); margin: 22px 0 26px; }
  .rb-page .rb-lede { font-size: 1.15rem; line-height: 1.7; color: rgba(245,239,226,0.75); max-width: 520px; margin-bottom: 36px; }
  .rb-stats { display: flex; gap: 34px; flex-wrap: wrap; margin-bottom: 40px; }
  .rb-stats .n { font-family: var(--display); font-size: 3rem; color: var(--gold); line-height: 1; }
  .rb-stats .l { font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: var(--muted); margin-top: 6px; }
  .rb-btn { display: inline-block; padding: 15px 30px; border-radius: 999px; font-weight: 700; font-size: 0.95rem; text-decoration: none; transition: transform .2s ease, background .2s ease; }
  .rb-btn:hover { transform: translateY(-2px); }
  .rb-btn-gold { background: var(--gold); color: var(--ink); }
  .rb-btn-ghost { border: 1px solid rgba(245,239,226,0.25); color: var(--text); }

  .rb-fan { position: relative; height: 640px; }
  .rb-phone { position: absolute; width: 260px; aspect-ratio: 9/16; border-radius: 34px; overflow: hidden; background: #000;
    border: 3px solid rgba(255,255,255,0.12); box-shadow: 0 40px 90px rgba(0,0,0,0.7); }
  .rb-phone video, .rb-phone img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .rb-fan .rb-phone:nth-child(1) { left: 0; top: 80px; transform: rotate(-8deg); z-index: 1; }
  .rb-fan .rb-phone:nth-child(2) { left: 50%; top: 10px; transform: translateX(-50%); z-index: 3; width: 290px; }
  .rb-fan .rb-phone:nth-child(3) { right: 0; top: 80px; transform: rotate(8deg); z-index: 2; }

  .rb-ticker { position: absolute; left: 0; right: 0; bottom: 0; overflow: hidden; background: var(--gold); color: var(--ink); transform: rotate(-1.2deg); transform-origin: left; padding: 14px 0; }
  .rb-ticker-track { display: flex; gap: 48px; width: max-content; animation: rb-marquee 38s linear infinite; }
  .rb-ticker span { font-family: var(--display); font-size: 1.6rem; text-transform: uppercase; white-space: nowrap; }
  .rb-ticker span::after { content: '✦'; margin-left: 48px; font-size: 1rem; vertical-align: middle; }
  @keyframes rb-marquee { to { transform: translateX(-50%); } }

  /* gap */
  .rb-gap { padding: 140px 0 110px; }
  .rb-gap-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: center; }
  .rb-page .rb-bignum { font-family: var(--display); font-size: clamp(7rem, 16vw, 13rem); line-height: 0.85; color: var(--text); }
  .rb-bignum small { display: block; font-family: var(--body); font-size: 13px; letter-spacing: 3px; color: var(--muted); text-transform: uppercase; margin-top: 18px; }
  .rb-gap h2 { font-size: clamp(2.4rem, 4.6vw, 3.8rem); margin: 16px 0 22px; }
  .rb-gap p { color: rgba(245,239,226,0.72); line-height: 1.8; font-size: 1.02rem; }

  /* section heads */
  .rb-section { padding: 110px 0; border-top: 1px solid var(--rule); }
  .rb-head { text-align: center; max-width: 760px; margin: 0 auto 64px; }
  .rb-head h2 { font-size: clamp(2.6rem, 5.4vw, 4.6rem); margin: 16px 0 18px; }
  .rb-head p { color: var(--muted); line-height: 1.75; font-size: 1.02rem; }

  /* clips */
  .rb-clips { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .rb-clip { background: var(--ink-2); border: 1px solid var(--rule); border-radius: 26px; padding: 18px 18px 24px; transition: transform .35s cubic-bezier(.22,.68,0,1.2), border-color .3s; }
  .rb-clip:hover { transform: translateY(-6px); border-color: rgba(245,197,66,0.45); }
  .rb-clip .rb-phone { position: relative; width: 100%; border-radius: 20px; }
  .rb-sound { position: absolute; right: 12px; bottom: 12px; z-index: 2; background: rgba(0,0,0,0.65); backdrop-filter: blur(6px); color: #fff; border: 1px solid rgba(255,255,255,0.25); border-radius: 999px; padding: 8px 14px; font: 600 12px var(--body); cursor: pointer; }
  .rb-sound.on { background: var(--gold); color: var(--ink); border-color: var(--gold); }
  .rb-clip-meta { display: flex; justify-content: space-between; align-items: center; margin: 20px 0 10px; }
  .rb-page .rb-chip { font-size: 10.5px; font-weight: 700; letter-spacing: 1.8px; text-transform: uppercase; color: var(--gold); border: 1px solid rgba(245,197,66,0.35); border-radius: 999px; padding: 4px 10px; }
  .rb-clip h3 { font-family: var(--display); font-weight: 400; text-transform: uppercase; font-size: 1.7rem; line-height: 1.02; margin: 0 0 14px; }
  .rb-beats { list-style: none; padding: 0; margin: 0 0 16px; }
  .rb-beats li { display: flex; gap: 10px; font-size: 0.86rem; color: rgba(245,239,226,0.7); line-height: 1.5; padding: 6px 0; border-top: 1px dashed rgba(245,239,226,0.08); }
  .rb-beats li b { color: var(--gold); font-family: var(--display); font-weight: 400; font-size: 1rem; min-width: 20px; }
  .rb-src { font-size: 12px; color: var(--muted); text-decoration: none; }
  .rb-src:hover { color: var(--gold); }

  .rb-anatomy { margin-top: 72px; background: var(--ink-2); border: 1px solid var(--rule); border-radius: 22px; padding: 30px 32px; }
  .rb-anatomy-bar { display: grid; grid-template-columns: 0.6fr 5fr 1fr 4fr 1fr; gap: 4px; margin: 18px 0 14px; height: 14px; }
  .rb-anatomy-bar div { border-radius: 4px; }
  .rb-anatomy-legend { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .rb-anatomy-legend p { margin: 0; font-size: 0.85rem; color: rgba(245,239,226,0.7); line-height: 1.55; }
  .rb-anatomy-legend b { display: block; font-family: var(--display); font-weight: 400; font-size: 1.15rem; text-transform: uppercase; margin-bottom: 4px; }
  .rb-dot { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 8px; vertical-align: 1px; }

  /* quotes */
  .rb-quotes { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .rb-quote { border-radius: 18px; overflow: hidden; border: 1px solid var(--rule); background: var(--ink-2); transition: transform .3s ease; }
  .rb-quote:hover { transform: translateY(-5px) rotate(-0.6deg); }
  .rb-quote video { width: 100%; aspect-ratio: 4/5; display: block; object-fit: cover; }
  .rb-quote-cap { padding: 14px 16px 16px; }
  .rb-quote-cap .rb-he { font-size: 1.2rem; color: var(--text); text-align: right; margin-bottom: 4px; }
  .rb-quote-cap span { font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--muted); }

  /* readers */
  .rb-readers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .rb-reader { position: relative; display: block; text-decoration: none; color: inherit; background: #f7f2e8; border-radius: 6px 18px 18px 6px; overflow: hidden; box-shadow: 0 30px 60px rgba(0,0,0,0.55); transition: transform .35s cubic-bezier(.22,.68,0,1.2); }
  .rb-reader:hover { transform: translateY(-8px) rotate(-1deg); }
  .rb-reader-top { background: var(--ink); padding: 26px 24px 22px; border-bottom: 4px solid var(--gold); }
  .rb-reader-top .rb-he { color: var(--gold); font-size: 1.35rem; text-align: right; }
  .rb-reader-top h3 { font-family: var(--display); font-weight: 400; text-transform: uppercase; font-size: 2rem; line-height: 1; margin: 8px 0 0; color: var(--text); }
  .rb-page .rb-reader-body { padding: 20px 24px 22px; color: #1d1a16; }
  .rb-reader-body ul { list-style: none; padding: 0; margin: 0 0 18px; }
  .rb-page .rb-reader-body li { font-size: 0.9rem; font-weight: 500; color: #1d1a16; padding: 7px 0; border-bottom: 1px solid #e3d7bd; }
  .rb-reader-body .open { font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #8a5a00; }

  /* pipeline */
  .rb-pipe { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; position: relative; }
  .rb-pipe::before { content: ''; position: absolute; top: 22px; left: 6%; right: 6%; height: 2px; background: linear-gradient(90deg, var(--gold), var(--hot)); opacity: .6; }
  .rb-step { padding: 0 18px; position: relative; }
  .rb-step .dot { width: 46px; height: 46px; border-radius: 50%; background: var(--ink); border: 2px solid var(--gold); display: grid; place-items: center; font-family: var(--display); color: var(--gold); font-size: 1.2rem; margin-bottom: 20px; position: relative; }
  .rb-step .day { font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: var(--gold); font-weight: 700; }
  .rb-step h3 { font-family: var(--display); font-weight: 400; text-transform: uppercase; font-size: 1.6rem; margin: 6px 0 8px; }
  .rb-step p { font-size: 0.9rem; color: rgba(245,239,226,0.68); line-height: 1.65; margin: 0; }

  /* deliverables */
  .rb-deliv { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--rule); border: 1px solid var(--rule); border-radius: 22px; overflow: hidden; }
  .rb-deliv > div { background: var(--ink); padding: 34px 30px; transition: background .3s; }
  .rb-deliv > div:hover { background: var(--ink-2); }
  .rb-deliv .n { font-family: var(--display); font-size: 2.6rem; color: transparent; -webkit-text-stroke: 1px var(--gold); line-height: 1; }
  .rb-deliv h3 { font-family: var(--display); font-weight: 400; text-transform: uppercase; font-size: 1.5rem; margin: 14px 0 8px; }
  .rb-deliv p { font-size: 0.9rem; color: rgba(245,239,226,0.66); line-height: 1.7; margin: 0; }

  .rb-cta { padding: 130px 0 120px; text-align: center; border-top: 1px solid var(--rule); background: radial-gradient(50% 60% at 50% 100%, rgba(245,197,66,0.12), transparent 70%); }
  .rb-cta h2 { font-size: clamp(3rem, 7vw, 6.2rem); margin: 18px 0 26px; }

  .rb-reveal { opacity: 0; transform: translateY(28px); transition: opacity .8s ease, transform .8s ease; }
  .rb-reveal.visible { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .rb-ticker-track { animation: none; }
    .rb-reveal { opacity: 1; transform: none; transition: none; }
  }
  @media (max-width: 1024px) {
    .rb-hero { grid-template-columns: 1fr; padding-top: 56px; }
    .rb-fan { height: 560px; max-width: 560px; width: 100%; margin: 0 auto; }
    .rb-gap-grid { grid-template-columns: 1fr; gap: 40px; }
    .rb-clips { grid-template-columns: 1fr 1fr; }
    .rb-quotes { grid-template-columns: 1fr 1fr; }
    .rb-readers { grid-template-columns: 1fr 1fr; }
    .rb-pipe { grid-template-columns: 1fr 1fr; row-gap: 40px; }
    .rb-pipe::before { display: none; }
    .rb-deliv { grid-template-columns: 1fr 1fr; }
    .rb-anatomy-legend { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 680px) {
    .rb-inner { padding: 0 16px; }
    .rb-hero { padding-bottom: 110px; }
    .rb-fan { height: 440px; }
    .rb-fan .rb-phone { width: 170px; }
    .rb-fan .rb-phone:nth-child(2) { width: 200px; }
    .rb-clips, .rb-quotes, .rb-readers, .rb-pipe, .rb-deliv { grid-template-columns: 1fr; }
    .rb-clips { max-width: 380px; margin: 0 auto; }
    .rb-anatomy { padding: 24px 18px; }
    .rb-anatomy-legend { grid-template-columns: 1fr; }
    .rb-section { padding: 80px 0; }
    .rb-stats { gap: 22px; }
    .rb-ticker span { font-size: 1.2rem; }
  }
</style>

<main class="rb-page">

  <!-- HERO -->
  <section style="position: relative;">
    <div class="rb-hero-bg"></div>
    <div class="rb-inner rb-hero">
      <div style="position: relative; z-index: 2;">
        <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
          <img src="/images/logo.png" alt="Matthew Miller" style="width: 40px; height: 40px; border-radius: 50%;" />
          <span class="rb-eyebrow" style="color: var(--muted);">Proposal</span>
          <span style="color: var(--muted);">×</span>
          <span class="rb-eyebrow">Rav Eitan Bendavid · Shivtei Yisrael</span>
        </div>

        <h1 class="rb-display">Torah that <span class="rb-hl">stops</span> the scroll.</h1>

        <p class="rb-lede">
          I took three of your weekly parsha videos and turned them into what the feed rewards:
          vertical clips with captions that hit, animated quote cards, and typeset readers for the Shabbat table.
          Same Torah, same five minutes on your end, many more people reached.
        </p>

        <div class="rb-stats">
          {[['3', 'Vertical clips'], ['4', 'Quote cards'], ['3', 'Shiur readers'], ['0', 'Extra filming']].map(([n, l]) => (
            <div><div class="n">{n}</div><div class="l">{l}</div></div>
          ))}
        </div>

        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
          <a href="#clips" class="rb-btn rb-btn-gold">Watch the clips ↓</a>
          <a href="mailto:matthewjmiller07@gmail.com?subject=Rav Bendavid — Content Proposal" class="rb-btn rb-btn-ghost">Let's talk</a>
        </div>
      </div>

      <div class="rb-fan" aria-hidden="true">
        {[clips[0], clips[2], clips[1]].map((c) => (
          <div class="rb-phone">
            <video src={`${base}/${c.id}.mp4`} poster={`${base}/${c.id}.jpg`} muted loop playsinline autoplay preload="metadata"></video>
          </div>
        ))}
      </div>
    </div>

    <div class="rb-ticker" aria-hidden="true">
      <div class="rb-ticker-track">
        {[...ticker, ...ticker].map((t) => <span>{t}</span>)}
      </div>
    </div>
  </section>

  <!-- THE GAP -->
  <section class="rb-gap">
    <div class="rb-inner rb-gap-grid">
      <div class="rb-reveal">
        <div class="rb-bignum">294<small>Videos already on your channel</small></div>
      </div>
      <div class="rb-reveal">
        <p class="rb-eyebrow">The opportunity</p>
        <h2 class="rb-display">The Torah is already <span class="rb-hl">short-form</span>. It isn't packaged for the feed yet.</h2>
        <p>
          273 of your videos run under eight minutes, which is exactly the length people will watch. But the typical
          one reaches about 60 viewers. That isn't about the content. Square video, no captions and no hook in the first
          second means the algorithm never gives it a chance. Most people watch with the sound off and decide in under two
          seconds. Below, each clip is built for those two seconds.
        </p>
      </div>
    </div>
  </section>

  <!-- CLIPS -->
  <section id="clips" class="rb-section">
    <div class="rb-inner">
      <div class="rb-head rb-reveal">
        <p class="rb-eyebrow">Asset 01 · Vertical clips</p>
        <h2 class="rb-display">Three parshiyot. <span class="rb-hl rb-hl-hot">Three hooks.</span></h2>
