---
import Layout from '../../layouts/Layout.astro';

const shiurim = [
  {
    slug: 'l-omer-or-b-omer',
    title: "L'Omer or B'Omer?",
    hebrew: 'לָעוֹמֶר אוֹ בָּעוֹמֶר?',
    verse: 'וּסְפַרְתֶּם לָכֶם מִמָּחֳרַת הַשַּׁבָּת',
    desc: 'The one-letter difference that opens a debate about the nature of sefirat haOmer, whether it is Biblical or Rabbinic, and what the Brisker Rav did about it.',
    duration: '13:12',
    pages: '9 pages',
    themes: ['The Question Nobody Asked', "BaOmer Is Present Tense", "D'Oraisa or D'Rabbanan?", 'One Mitzvah or Forty-Nine?', 'Two Types of Zecher', 'Zecher LeMikdash or LeChurban?', 'The Brisker Solution: Say Both'],
    pdf: 'l-omer-or-b-omer.pdf',
    color: '#6d4bb5',
  },
  {
    slug: 'five-reasons-for-eating-dairy-on-shavuos',
    title: 'Five Reasons for Eating Dairy on Shavuos',
    hebrew: 'חֲמִשָּׁה טְעָמִים לַאֲכִילַת מַאֲכְלֵי חָלָב',
    verse: 'נוֹהֲגִין בְּכָל מָקוֹם לֶאֱכֹל מַאֲכְלֵי חָלָב',
    desc: 'The Rema records the minhag and five poskim explain it — each one a window into what Shavuos means.',
    duration: '10:56',
    pages: '7 pages',
    themes: ['Zecher to the Shtei HaLechem', 'Blood Becomes Milk (Magen Avraham)', 'The Morning After Matan Torah', 'Blood Transformed to Kedushah', 'Physical Mitzvos Are Our Advantage (Beis HaLevi)'],
    pdf: 'five-reasons-for-eating-dairy-on-shavuos.pdf',
    color: '#6d4bb5',
  },
];

const clips = [
  { hook: "Wait — The Mechaber Says LaOmer?", timestamp: '0:12', shiur: "L'Omer or B'Omer?", id: 'nobody-calls-it-laomer' },
  { hook: 'First Night Problem: You Can\'t Look Back', timestamp: '1:45', shiur: "L'Omer or B'Omer?", id: 'first-night-logic' },
  { hook: 'Rav Soloveitchik Said It Twice', timestamp: '11:27', shiur: "L'Omer or B'Omer?", id: 'zeicher-or-zecher' },
  { hook: "Why You Can't Make French Toast on Shavuos", timestamp: '0:47', shiur: 'Five Reasons for Eating Dairy', id: 'french-toast' },
  { hook: 'After Matan Torah — They Were Starving', timestamp: '3:32', shiur: 'Five Reasons for Eating Dairy', id: 'matan-torah-hungry' },
  { hook: "Rav Yosef's Most Humble Brag", timestamp: '5:25', shiur: 'Five Reasons for Eating Dairy', id: 'rav-yosef-humble' },
];

const quotes = [
  { id: 'mechaber-laomer', hebrew: 'נוֹהֲגִים שֶׁלֹּא לְהִסְתַּפֵּר עַד לַ\"ג לָעוֹמֶר', label: 'Mechaber — LaOmer', shiur: "L'Omer or B'Omer?" },
  { id: 'two-types-zecher', hebrew: 'זֵכֶר לַמִּקְדָּשׁ — זֵכֶר לַחֻרְבָּן', label: 'Two Types of Zecher', shiur: "L'Omer or B'Omer?" },
  { id: 'zeicher-zecher', hebrew: 'זֵיכֶר רַב טוּבְךָ — זֶכֶר רַב טוּבְךָ', label: 'The Brisker Double', shiur: "L'Omer or B'Omer?" },
  { id: 'nohegin-chalav', hebrew: 'נוֹהֲגִין בְּכָל מָקוֹם לֶאֱכֹל מַאֲכְלֵי חָלָב', label: 'Rema on Dairy', shiur: 'Five Reasons for Eating Dairy' },
  { id: 'dam-nehpach-chalav', hebrew: 'דָּם נֶהְפַּךְ וְנַעֲשָׂה חָלָב', label: 'Blood Becomes Milk', shiur: 'Five Reasons for Eating Dairy' },
];

const deliverables = [
  { icon: '🎬', title: 'Short-Form Video Clips', desc: '9:16 social shorts — opening hook card, lecture audio with live captions, branded closing card. Ready for Instagram Reels, TikTok, and YouTube Shorts.' },
  { icon: '✨', title: 'Animated Quote Cards', desc: 'Looping GIF and MP4 quote cards for each shiur — Hebrew and English, branded for sharing on WhatsApp and social.' },
  { icon: '📄', title: 'Branded Shiur Notes', desc: 'Beautifully typeset PDF study guides — Hebrew sources, substantive commentary, and clean branding. The kind talmidim print and keep.' },
  { icon: '🌐', title: 'Shiur Website', desc: 'A dedicated site for Ten Minute Halacha — searchable by topic, browsable by date, with audio player and PDF downloads built in.' },
  { icon: '📬', title: 'Weekly Email Digest', desc: 'Automated weekly email with highlights, study questions, and direct links to the audio — sent to your list with no manual work.' },
  { icon: '⚡', title: 'Ongoing Content System', desc: 'Once set up, each new shiur flows automatically into study notes, social clips, and the weekly email. Less work, more reach.' },
];
---

<Layout
  title="Content & Website Proposal — Rav Aryeh Lebowitz | Matthew Miller"
  description="A proposal to build Rav Aryeh Lebowitz's digital presence — social content, study materials, and a dedicated Ten Minute Halacha website."
>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,600&family=Outfit:wght@300;400;500;600;700&display=swap');

  .rl-page {
    --violet:      #6d4bb5;
    --violet-dim:  #3d2a72;
    --violet-light:#9b78d4;
    --gold:        #c9a84b;
    --gold-light:  #e8d07a;
    --gold-dim:    #4a3c10;
    --bg:          #07060f;
    --bg-card:     #0d0b1a;
    --bg-lift:     #13102a;
    --text:        #f0ece4;
    --muted:       #6a6a8a;
    --rule:        rgba(109,75,181,0.18);
    --font-display:'Cormorant Garamond', 'Times New Roman', serif;
    --font-body:   'Outfit', sans-serif;
  }

  .rl-page * { box-sizing: border-box; }
  .rl-display { font-family: var(--font-display); }
  .rl-body    { font-family: var(--font-body); }

  @keyframes rl-ticker {
    from { transform: translateY(0); }
    to   { transform: translateY(-50%); }
  }
  .rl-ticker-inner { animation: rl-ticker 30s linear infinite; }

  .rl-card {
    transition: transform 0.35s cubic-bezier(.22,.68,0,1.2), box-shadow 0.35s ease;
  }
  .rl-card:hover {
    transform: translateY(-5px) scale(1.01);
    box-shadow: 0 20px 50px rgba(109,75,181,0.2), 0 4px 16px rgba(0,0,0,0.6);
  }

  .rl-clip-card {
    transition: transform 0.3s ease, background 0.3s ease;
  }
  .rl-clip-card:hover {
    transform: translateY(-3px);
    background: #13102a;
  }

  @keyframes rl-shimmer {
    0%   { background-position: -200% center; }
    100% { background-position:  200% center; }
  }
  .rl-shimmer {
    background: linear-gradient(90deg, var(--gold-dim), var(--gold), var(--gold-light), var(--gold), var(--gold-dim));
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: rl-shimmer 4s linear infinite;
  }

  .rl-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .rl-reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .rl-phone {
    border-radius: 2.4rem;
    border: 3px solid rgba(255,255,255,0.12);
    overflow: hidden;
    box-shadow: 0 40px 80px rgba(0,0,0,0.7), inset 0 0 0 1px rgba(255,255,255,0.04);
  }

  .rl-section-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .rl-hero-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 80px 64px;
    position: relative;
    z-index: 2;
  }

  .rl-hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100vh;
    position: relative;
    overflow: hidden;
  }

  .rl-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .rl-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .rl-grid-pdf {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    max-width: 860px;
    margin: 0 auto;
  }

  .rl-clips-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .rl-stats-row {
    display: flex;
    gap: 36px;
    margin-bottom: 48px;
    flex-wrap: wrap;
  }

  .rl-cta-row {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  @media (max-width: 1024px) {
    .rl-hero-grid { grid-template-columns: 1fr; }
    .rl-hero-left { padding: 60px 40px; }
    .rl-clips-grid { grid-template-columns: 1fr; gap: 48px; }
  }

  @media (max-width: 768px) {
    .rl-section-inner { padding: 0 20px; }
    .rl-hero-left { padding: 48px 20px; }
    .rl-grid-2 { grid-template-columns: 1fr; }
    .rl-grid-3 { grid-template-columns: repeat(2, 1fr); }
    .rl-grid-pdf { grid-template-columns: 1fr; max-width: 480px; }
    .rl-clips-grid { grid-template-columns: 1fr; gap: 32px; }
  }

  @media (max-width: 480px) {
    .rl-hero-left { padding: 36px 16px; }
    .rl-section-inner { padding: 0 16px; }
    .rl-stats-row { gap: 24px; }
    .rl-cta-row a { width: 100%; text-align: center; }
    .rl-grid-3 { grid-template-columns: 1fr 1fr; }
  }
</style>

<main class="rl-page rl-body min-h-screen" style="background: #07060f; color: #f0ece4;">

  <!-- ═══════════════════════════════════════════════════════════
       HERO
  ════════════════════════════════════════════════════════════ -->
  <section class="rl-hero-grid">

    <div class="rl-hero-left">
      <!-- Badge -->
      <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 48px;">
        <img src="/images/logo.png" alt="Matthew Miller" style="width: 44px; height: 44px; border-radius: 50%;" />
        <span style="color: var(--muted); font-size: 13px; letter-spacing: 3px; text-transform: uppercase; font-family: var(--font-body);">Content Proposal</span>
        <span style="color: var(--rule); font-size: 20px;">×</span>
        <span style="color: var(--gold); font-size: 13px; letter-spacing: 2px; font-family: var(--font-body);">Rav Aryeh Lebowitz</span>
      </div>

      <!-- Hebrew eyebrow -->
      <p style="font-family: 'Arial Hebrew', serif; direction: rtl; color: var(--gold); font-size: 22px; margin-bottom: 16px; opacity: 0.9;">
        עֶשֶׂר דַּקּוֹת הֲלָכָה
      </p>

      <h1 class="rl-display" style="font-size: clamp(3.2rem, 5.5vw, 5.5rem); font-weight: 600; line-height: 1.05; margin-bottom: 28px; letter-spacing: -0.02em;">
        Ten Minutes.<br/>
        <span class="rl-shimmer">Infinite Reach.</span>
      </h1>

      <p style="font-size: 1.15rem; line-height: 1.75; color: rgba(240,236,228,0.72); max-width: 440px; margin-bottom: 44px;">
        I've taken two of Rav Lebowitz's Ten Minute Halacha shiurim and turned them into
        animated quote cards, short-form video clips, and branded study guides —
        entirely from the audio and transcript.
      </p>

      <div class="rl-stats-row">
        {[['5', 'Animated Quote Cards'], ['6', 'Short Clips Built'], ['2', 'Shiur Study Guides'], ['2', 'Shiurim Processed']].map(([n, l]) => (
          <div>
            <p class="rl-display" style="font-size: 2.4rem; font-weight: 600; color: var(--gold); line-height: 1;">{n}</p>
            <p style="font-size: 11px; color: var(--muted); letter-spacing: 2px; text-transform: uppercase; margin-top: 3px;">{l}</p>
          </div>
        ))}
      </div>

      <div class="rl-cta-row">
        <a href="#assets" style="padding: 14px 32px; background: var(--violet); color: #f0ece4; border-radius: 8px; font-weight: 600; font-size: 0.9rem; text-decoration: none; letter-spacing: 0.5px; transition: background 0.2s ease;"
           onmouseover="this.style.background='#9b78d4'" onmouseout="this.style.background='#6d4bb5'">
          See the Work ↓
        </a>
        <a href="mailto:matthewjmiller07@gmail.com?subject=Rav Lebowitz — Content Proposal" style="padding: 14px 32px; border: 1px solid rgba(109,75,181,0.4); color: var(--violet-light); border-radius: 8px; font-weight: 500; font-size: 0.9rem; text-decoration: none; transition: background 0.2s ease;"
           onmouseover="this.style.background='rgba(109,75,181,0.1)'" onmouseout="this.style.background='transparent'">
          Let's Talk
        </a>
      </div>
    </div>

    <!-- Right: ticker -->
    <div style="position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center;" class="max-lg:hidden">
      <div style="position: absolute; inset: 0; background: radial-gradient(ellipse 80% 80% at 60% 40%, rgba(109,75,181,0.08), transparent 70%);"></div>

      <!-- Hebrew ticker -->
      <div style="position: absolute; left: 0; top: 0; bottom: 0; width: 48px; overflow: hidden; display: flex; flex-direction: column; align-items: center; padding: 16px 0;">
        <div class="rl-ticker-inner" style="display: flex; flex-direction: column; align-items: center; gap: 24px;">
          {['הֲלָכָה', 'עֶשֶׂר', 'דַּקּוֹת', 'לָעוֹמֶר', 'בָּעוֹמֶר', 'שָׁבוּעוֹת', 'חָלָב', 'מַתַּן', 'תּוֹרָה', 'בְּרִיסְק', 'הֲלָכָה', 'עֶשֶׂר', 'דַּקּוֹת', 'לָעוֹמֶר', 'בָּעוֹמֶר', 'שָׁבוּעוֹת', 'חָלָב', 'מַתַּן', 'תּוֹרָה', 'בְּרִיסְק'].map(w => (
            <span style="font-family: 'Arial Hebrew', serif; font-size: 10px; color: rgba(109,75,181,0.3); writing-mode: vertical-rl; letter-spacing: 2px;">{w}</span>
          ))}
        </div>
      </div>

      <!-- Quote card previews — text only since GIFs render at runtime -->
      <div style="display: flex; flex-direction: column; gap: 16px; padding: 48px 48px 48px 64px; width: 100%; max-width: 560px;">
        {quotes.slice(0, 2).map((q, i) => (
          <div class="rl-card" style={`background: var(--bg-card); border-radius: 16px; padding: 32px; border: 1px solid rgba(109,75,181,0.25); ${i === 1 ? 'margin-left: 32px;' : 'margin-right: 32px;'}`}>
            <p style="font-family: 'Arial Hebrew', serif; direction: rtl; font-size: 28px; color: var(--text); margin-bottom: 12px; line-height: 1.4;">{q.hebrew}</p>
            <div style="width: 40px; height: 1px; background: var(--gold); margin-bottom: 12px; opacity: 0.6;"></div>
            <p style="font-size: 13px; color: var(--violet-light); letter-spacing: 1px; text-transform: uppercase; font-family: var(--font-body);">{q.label}</p>
            <p style="font-size: 11px; color: var(--muted); margin-top: 4px; font-family: var(--font-body);">{q.shiur}</p>
          </div>
        ))}
      </div>
    </div>

    <div style="position: absolute; bottom: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, var(--gold), transparent); opacity: 0.3;"></div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       QUOTE CARDS
  ════════════════════════════════════════════════════════════ -->
  <section id="assets" style="padding: 100px 0; background: var(--bg);">
    <div class="rl-section-inner">

      <div class="rl-reveal" style="text-align: center; margin-bottom: 64px;">
        <p style="color: var(--gold); font-size: 11px; letter-spacing: 5px; text-transform: uppercase; font-family: var(--font-body); margin-bottom: 16px;">Asset 01 · Animated Quote Cards</p>
        <h2 class="rl-display" style="font-size: clamp(2.2rem, 4vw, 3.6rem); font-weight: 500; line-height: 1.15; margin-bottom: 20px;">
          Five quotes. <em>Five GIFs.</em><br/>Ready to post.
        </h2>
        <p style="color: var(--muted); font-size: 1rem; max-width: 560px; margin: 0 auto; line-height: 1.7;">
          Each one is a short looping animation — Hebrew text, English translation, attribution.
          Ready to share on WhatsApp, Instagram, or anywhere else.
        </p>
      </div>

      <div style="display: flex; flex-direction: column; gap: 32px;" class="rl-reveal">
        {quotes.map((q) => (
          <div class="rl-card" style="background: var(--bg-card); border-radius: 16px; overflow: hidden; border: 1px solid rgba(109,75,181,0.22);">
            <div style="position: relative; width: 100%;">
              <img
                src={`/proposals/rabbi-lebowitz/${q.id}.gif`}
                alt={q.label}
                style="width: 100%; height: auto; display: block;"
                loading="lazy"
              />
              <div style="position: absolute; top: 10px; left: 10px; background: rgba(5,5,15,0.75); backdrop-filter: blur(8px); border-radius: 20px; padding: 3px 10px; border: 1px solid rgba(109,75,181,0.35);">
                <span style="font-size: 10px; font-family: var(--font-body); color: var(--violet-light); letter-spacing: 1px; text-transform: uppercase; font-weight: 600;">{q.shiur}</span>
              </div>
            </div>
            <div style="padding: 14px 20px; display: flex; align-items: center; gap: 16px; border-top: 1px solid rgba(109,75,181,0.15);">
              <p style="font-family: 'Arial Hebrew', serif; direction: rtl; font-size: 22px; color: var(--text); opacity: 0.9; margin: 0; flex-shrink: 0;">{q.hebrew}</p>
              <div style="width: 1px; height: 22px; background: rgba(109,75,181,0.3); flex-shrink: 0;"></div>
              <p style="font-size: 14px; color: var(--violet-light); font-family: var(--font-body); margin: 0;">{q.label}</p>
            </div>
          </div>
        ))}
      </div>

      <p class="rl-reveal" style="text-align: center; margin-top: 36px; color: var(--muted); font-size: 13px;">
        Five GIFs from two shiurim. The same can be done for any shiur.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       SHORT CLIPS
  ════════════════════════════════════════════════════════════ -->
  <section style="padding: 100px 0; background: linear-gradient(180deg, var(--bg) 0%, #0a0816 100%); border-top: 1px solid var(--rule);">
    <div class="rl-section-inner">

      <div class="rl-clips-grid">

        <!-- Left: clip list -->
        <div class="rl-reveal">
          <p style="color: var(--gold); font-size: 11px; letter-spacing: 5px; text-transform: uppercase; font-family: var(--font-body); margin-bottom: 20px;">Asset 02 · Social Shorts</p>
          <h2 class="rl-display" style="font-size: clamp(2rem, 3.5vw, 3.2rem); font-weight: 500; line-height: 1.2; margin-bottom: 24px;">
            6 short clips,<br/>cut and packaged<br/><em>from your shiurim.</em>
          </h2>
          <p style="color: rgba(240,236,228,0.7); line-height: 1.8; margin-bottom: 28px; font-size: 0.95rem;">
            Each 9:16 clip has an opening hook card, lecture audio with live word-by-word captions,
            and a branded closing card — ready for Reels, Shorts, and TikTok.
          </p>
          <div style="display: flex; flex-direction: column; gap: 10px;">
            {clips.map(c => (
              <div class="rl-clip-card" style="background: var(--bg-card); border-radius: 10px; padding: 12px 16px; border-left: 3px solid var(--violet); display: flex; justify-content: space-between; align-items: center; gap: 12px;">
                <div>
                  <p style="font-size: 0.88rem; color: var(--text); line-height: 1.5; margin: 0; font-style: italic;">"{c.hook}"</p>
                  <p style="font-size: 10px; color: var(--muted); margin-top: 3px; font-family: var(--font-body);">{c.shiur}</p>
                </div>
                <p style="font-size: 10px; font-family: monospace; color: var(--muted); flex-shrink: 0;">{c.timestamp}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: real video in phone frame -->
        <div class="rl-reveal" style="display: flex; justify-content: center; align-items: center;">
          <div style="position: relative; width: 280px;">
            <div class="rl-phone" style="width: 280px; background: #050510; overflow: hidden;">
              <div style="background: #030308; padding: 10px 0 6px; display: flex; justify-content: center;">
                <div style="width: 60px; height: 5px; background: rgba(255,255,255,0.12); border-radius: 3px;"></div>
              </div>
              <video
                src="/proposals/rabbi-lebowitz/nobody-calls-it-laomer.mp4"
                style="display: block; width: 100%; aspect-ratio: 9/16; object-fit: cover;"
                controls
                preload="metadata"
                playsinline
              ></video>
            </div>
            <div style="text-align: center; margin-top: 16px;">
              <p style="font-size: 11px; color: var(--violet-light); letter-spacing: 2px; text-transform: uppercase; font-family: var(--font-body);">L'Omer or B'Omer · Live Sample</p>
              <p style="font-size: 12px; color: var(--muted); font-family: var(--font-body); margin-top: 4px; font-style: italic;">Wait — The Mechaber Says LaOmer?</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       STUDY MATERIALS / PDFs
  ════════════════════════════════════════════════════════════ -->
  <section style="padding: 100px 0; background: #0a0816; border-top: 1px solid var(--rule);">
    <div class="rl-section-inner">

      <div class="rl-reveal" style="text-align: center; margin-bottom: 64px;">
        <p style="color: var(--gold); font-size: 11px; letter-spacing: 5px; text-transform: uppercase; font-family: var(--font-body); margin-bottom: 16px;">Asset 03 · Study Materials</p>
