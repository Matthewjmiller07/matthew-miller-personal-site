---
import Layout from '../layouts/Layout.astro';

// Password protection
const password = "RJD2026";
const urlPassword = Astro.url.searchParams.get('pw');

if (urlPassword !== password) {
  return Astro.redirect('/?error=access_denied&return=' + encodeURIComponent(Astro.url.pathname));
}
---

<Layout
  title="Rabbi Dweck – Media Analytics Dashboard"
  description="Comprehensive cross-platform analytics dashboard for Rabbi Joseph Dweck's media presence across YouTube, Spotify/Podcasts, and Facebook/Instagram."
  scripts={[
    { src: 'https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js' },
    { src: 'https://cdn.jsdelivr.net/npm/chartjs-plugin-annotation@3.0.1/dist/chartjs-plugin-annotation.min.js' }
  ]}
>
<main class="min-h-screen bg-gray-950 text-gray-100 px-4 py-10 max-w-7xl mx-auto space-y-10">

  <!-- Header -->
  <header class="text-center space-y-3">
    <p class="text-xs uppercase tracking-widest text-amber-400 font-semibold">Cross-Platform Media Analytics</p>
    <h1 class="text-4xl font-extrabold text-white">Rabbi Joseph Dweck</h1>
    <p class="text-gray-400 text-lg max-w-2xl mx-auto">
      Media presence dashboard across YouTube, Spotify Podcast, and Facebook/Instagram.
