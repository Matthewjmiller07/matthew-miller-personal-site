    </div>
  </section>

  <!-- Top Podcast Episodes Table -->
  <section class="bg-gray-900 border border-gray-800 rounded-2xl p-6 space-y-4">
    <h2 class="text-xl font-bold text-white">Top 20 Podcast Episodes (All-Time)</h2>
    <p class="text-sm text-gray-400">Ranked by total streams & downloads</p>
    <div class="overflow-x-auto">
      <table class="w-full text-sm text-left">
