            <th class="py-2 pr-4 w-8">#</th>
            <th class="py-2 pr-4">Episode Title</th>
            <th class="py-2 pr-4 text-right">Streams</th>
            <th class="py-2 pr-4 text-right">Published</th>
          </tr>
        </thead>
        <tbody id="topEpisodesTable" class="divide-y divide-gray-800">
          <!-- Populated by JS -->
