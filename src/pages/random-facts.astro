---
// A cabinet of curiosities: random facts learned or researched along the way,
// rendered live from Supabase (random_facts table).
import Layout from '../layouts/Layout.astro';
import { listFacts, factSlug } from '../lib/randomfacts';

export const prerender = false;

const facts = await listFacts();

// Deep links: ?fact=<slug> shows that one fact on its own; ?id=<uuid> (the
// earlier form) still resolves but redirects to the readable slug URL.
// An unknown or missing parameter just shows the normal newest-first list.
const focusSlug = Astro.url.searchParams.get('fact');
const focusId = Astro.url.searchParams.get('id');
const focus = focusSlug ? facts.find((f) => factSlug(f) === focusSlug) : undefined;
if (!focus && focusId) {
  const byId = facts.find((f) => f.id === focusId);
  if (byId) return Astro.redirect(`/random-facts?fact=${factSlug(byId)}`);
}
const shown = focus ? [focus] : facts;
---

<Layout
  title="Random Facts | Matthew Miller"
  description="A running collection of random facts — things learned and researched along the way."
>
  <main class="bg-[#0a0908] min-h-screen px-4 py-16 sm:py-20">
    <div class="mx-auto max-w-4xl">
      <p class="text-sm uppercase tracking-[0.3em] text-[#c9a86a]">Cabinet of curiosities</p>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-[#f4eee1] sm:text-5xl">Random Facts</h1>
      <p class="mt-4 text-lg text-[#c9c0ad] max-w-2xl">
        Things I've learned or had researched — one running collection, newest first.
      </p>
      {focus && (
        <p class="mt-4 text-sm text-[#c9a86a]">
          Showing one linked fact — <a href="/random-facts" class="underline hover:text-[#f4eee1]">see all facts</a>
        </p>
      )}

      {!focus && facts.length > 0 && (
        <div class="mt-10 overflow-hidden rounded-xl border border-white/10 bg-white/5">
          <div class="rf-track flex whitespace-nowrap py-3 text-sm font-medium text-[#c9c0ad] select-none">
            {[0, 1].map((n) => (
              <span class="rf-chunk" aria-hidden={n === 1 ? 'true' : undefined}>
                {facts.map((f) => (
                  <span class="mx-6 inline-flex items-center gap-6">
                    <a href={`/random-facts?fact=${factSlug(f)}`} class="hover:text-[#f4eee1] hover:underline">{f.fact}</a><span class="text-[#c9a86a]">✦</span>
                  </span>
                ))}
              </span>
            ))}
          </div>
        </div>
        <style>
          .rf-track { animation: rf-scroll 60s linear infinite; }
          .rf-track:hover { animation-play-state: paused; }
          @keyframes rf-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
        </style>
      )}

      <div class="mt-12 grid gap-6">
        {shown.map((f) => (
          <article
            id={`fact-${f.id}`}
            class={focus?.id === f.id
              ? 'scroll-mt-24 rounded-xl border border-[#c9a86a] bg-[#c9a86a]/10 p-6 ring-1 ring-[#c9a86a]/60'
              : 'scroll-mt-24 rounded-xl border border-white/10 bg-white/5 p-6'}
          >
            <p class="text-xl font-semibold leading-relaxed text-[#f4eee1]"><a href={`/random-facts?fact=${factSlug(f)}`} class="hover:text-accent hover:underline">{f.fact}</a></p>
            {f.details && <p class="mt-3 leading-relaxed text-[#c9c0ad]">{f.details}</p>}
            <div class="mt-4 flex flex-wrap items-center gap-2">
              {f.tags.map((t) => (
                <span class="rounded-full border border-white/15 px-3 py-0.5 text-xs text-[#c9c0ad]">{t}</span>
              ))}
              {f.researched_by && (
                <span class="rounded-full bg-accent/15 px-3 py-0.5 text-xs text-accent">
                  Researched by {f.researched_by}
                </span>
              )}
              <a href={`/random-facts?fact=${factSlug(f)}`} class="rounded-full border border-white/15 px-3 py-0.5 text-xs text-[#8a8474] hover:text-accent">
                Permalink
              </a>
            </div>
            {f.sources.length > 0 && (
              <p class="mt-3 text-sm text-[#8a8474]">
                Sources:{' '}
                {f.sources.map((s, i) => (
                  <span>
                    <a href={s} target="_blank" rel="noopener" class="text-accent hover:underline">
                      {new URL(s).hostname.replace(/^www\./, '')}
                    </a>
                    {i < f.sources.length - 1 && <span> · </span>}
                  </span>
                ))}
              </p>
            )}
          </article>
        ))}
        {facts.length === 0 && (
          <p class="text-[#c9c0ad]">No facts yet — the collection is just getting started.</p>
        )}
      </div>
    </div>
  </main>
</Layout>
