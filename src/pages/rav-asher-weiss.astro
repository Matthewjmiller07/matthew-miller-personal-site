    lectureTitle: 'ערב פסח שחל בשבת: סעודה שניה',
    ts: '00:06:38', secs: 398,
    audio: 'https://ta-lectures.s3.us-east-005.backblazeb2.com/mp3/362222/362222-suewxj.mp3',
