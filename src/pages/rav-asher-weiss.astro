---
// /rav-asher-weiss — "כמדומני" quote cards: AI portraits + listenable moments
// from Rav Asher Weiss's TorahAnytime shiurim.
import Layout from '../layouts/Layout.astro';

const pageTitle = 'Rav Asher Weiss — כמדומני';

// Quote cards, newest first: each nightly run PREPENDS its new qN objects here.
const quotes = [
  {
    id: 'q29',
    img: '/images/rav-asher-weiss/quote29.jpg',
    quoteHe: 'ביארצייט, כמדומני — חסידים מביאים בקבוק וודקה וחבילת עוגיות לבית הכנסת. כולם אוכלים ושותים ואומרים לחיים, במקום לצום.',
    lectureId: '315498',
    lectureTitle: 'תשעה באב: בגדרי הצומות בישראל',
    ts: '00:39:19', secs: 2359,
    audio: 'https://dl.torahanytime.com/mp3/315498--____07_04_2024__ecc9463c-4b8b-495c-8290-c757d8243db5.mp4.mp3',
  },
  {
    id: 'q26',
    img: '/images/rav-asher-weiss/quote26.jpg',
    quoteHe: 'כמדומני — חודש ניסן הוא החודש שבו הישועות מקיפות אותנו מכל עבר; ובלשון הקודש "הקפה" פירושה גם לקבל בלי לשלם. בניסן נותן לנו הקדוש ברוך הוא ישועות בהקפה.',
    lectureId: '295924',
    lectureTitle: 'דברי חיזוק לימי הפסח',
    ts: '00:12:27', secs: 747,
    audio: 'https://dl.torahanytime.com/mp3/295924--____03_00_2024__d3291d96-865b-4863-a4dc-cb0c23cf26fd.mp4.mp3',
  },
  {
    id: 'q27',
    img: '/images/rav-asher-weiss/quote27.jpg',
    quoteHe: 'כמדומני — "ואהבת לרעך כמוך" כוללת את כל המצוות שבין אדם לחברו: לבקר את החולים ולחוש את כאבם, את צערם, את יסוריהם.',
    lectureId: '301406',
    lectureTitle: 'פרשת בחוקותי: חיוב החולה להתעסק ברפואה',
    ts: '00:32:59', secs: 1979,
    audio: 'https://dl.torahanytime.com/mp3/301406--____04_03_2024__a44c65a7-e948-42f0-9676-bbd77b5058b8.mp4.mp3',
  },
  {
    id: 'q28',
    img: '/images/rav-asher-weiss/quote28.jpg',
    quoteHe: 'כמדומני — יש מקורות שכאילו הקדוש ברוך הוא אומר לנו: אני ואתם ניתן תורה לישראל — אני אתן את הכלל, ואתם תתנו את הפרטים.',
    lectureId: '329403',
    lectureTitle: 'פרשת נח: זמן מצוות פריה ורביה',
    ts: '00:39:08', secs: 2348,
    audio: 'https://dl.torahanytime.com/mp3/329403--____09_04_2024__16bcb239-d901-4a11-81b0-e2fecae49733.mp4.mp3',
  },
  {
    id: 'q23',
    img: '/images/rav-asher-weiss/quote23.jpg',
    quoteHe: 'כמדומני — שלא תסיג גבול רעך אשר גבלו ראשונים: זה המקור שלא ישנה אדם ממנהג אבותיו.',
    lectureId: '295879',
    lectureTitle: 'תורת המנהגים',
    ts: '00:10:52', secs: 652,
    audio: 'https://dl.torahanytime.com/mp3/295879--____03_00_2024__abb8fe29-0e62-4509-8e2f-410018f7956b.mp4.mp3',
  },
  {
    id: 'q24',
    img: '/images/rav-asher-weiss/quote24.jpg',
    quoteHe: 'כמדומני — לצומות יש גדר שני: ריצוי. התענית באה לרצות פני עליון, כדי שיקבל את תפילותינו.',
    lectureId: '315498',
    lectureTitle: 'תשעה באב: בגדרי הצומות בישראל',
    ts: '00:26:47', secs: 1607,
    audio: 'https://dl.torahanytime.com/mp3/315498--____07_04_2024__ecc9463c-4b8b-495c-8290-c757d8243db5.mp4.mp3',
  },
  {
    id: 'q25',
    img: '/images/rav-asher-weiss/quote25.jpg',
    quoteHe: 'כמדומני — אילו היה תלוי בי, היה לנו חודש דלול, על שם \'דודי לי ואני לו\'. אבל הקדוש ברוך הוא עומד בשלו: שובו אלי.',
    lectureId: '320325',
    lectureTitle: 'פתיחה לזמן אלול',
    ts: '00:07:51', secs: 471,
    audio: 'https://dl.torahanytime.com/mp3/320325--____08_05_2024__5b2675f2-0bc7-4e9d-977a-9976830cece4.mp4.mp3',
  },
  {
    id: 'q20',
    img: '/images/rav-asher-weiss/quote20.jpg',
    quoteHe: 'כמדומני — אחרי כעשרים מקורות: אין לדמות מילתא למילתא — גם חז״ל לא תמיד דימו מילתא למילתא.',
    lectureId: '363215',
    lectureTitle: 'חזקת ג\' פעמים - בקהילת בני תורה הר נוף',
    ts: '00:43:28', secs: 2608,
    audio: 'https://ta-lectures.s3.us-east-005.backblazeb2.com/mp3/363215/363215-suqzap.mp3',
  },
  {
    id: 'q21',
    img: '/images/rav-asher-weiss/quote21.jpg',
    quoteHe: 'כמדומני — כשם שהזב עולה מטומאתו בשבעה נקיים, כך שבעת השבועות עולים מטומאת מצרים לטהרת התורה.',
    lectureId: '366289',
    lectureTitle: 'מסר קצר לימי ספירת העומר',
    ts: '00:05:13', secs: 313,
    audio: 'https://ta-lectures.s3.us-east-005.backblazeb2.com/mp3/366289/366289-svlllw.mp3',
