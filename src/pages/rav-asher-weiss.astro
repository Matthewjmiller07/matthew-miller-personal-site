---
// /rav-asher-weiss — "כמדומני" quote cards: AI portraits + listenable moments
// from Rav Asher Weiss's TorahAnytime shiurim.
import Layout from '../layouts/Layout.astro';

const pageTitle = 'Rav Asher Weiss — כמדומני';
const pageDescription = 'Fourteen moments where Rav Asher Weiss says "it seems to me" — and a chiddush follows. Listen to each in his own voice.';

const quotes = [
  {
    id: 'q16',
    img: '/images/rav-asher-weiss/quote16.jpg',
    quoteHe: 'כמדומני — לא ממתינים למצוה גדולה: צא הביתה מחר בבוקר, התפלל בציבור, שמע קריאת התורה.',
    lectureId: '289657',
    lectureTitle: 'מקרא מגילה בשבת ליחידים ומקרא מגילה בלילה וביום',
    ts: '00:20:10', secs: 1210,
    audio: 'https://dl.torahanytime.com/mp3/289657--____02_04_2024__f9de244b-9257-4f00-bb2b-39172f7b6ec3.mp4.mp3',
  },
  {
    id: 'q15',
    img: '/images/rav-asher-weiss/quote15.jpg',
    quoteHe: 'כמדומני — קשה לומר שכך היה המנהג: שני גדולים חיו באותה תקופה בירושלים, וכל אחד פסק אחרת.',
    lectureId: '356603',
    lectureTitle: 'מקרא מגילה בפורים משולש',
    ts: '00:10:19', secs: 619,
    audio: 'https://ta-lectures.s3.us-east-005.backblazeb2.com/mp3/356603/356603-sszdl2.mp3',
  },
  {
    id: 'q13',
    img: '/images/rav-asher-weiss/quote13.jpg',
    quoteHe: 'לולא דמסתפינא — האיסור לצום הוא בתקופה הראשונה בלבד; אחר כך הכל תלוי במצבו של החולה כעת.',
    lectureId: '478517',
    lectureTitle: 'הכנס השנתי לרבנים בענייני צום יום הכיפורים: דיני הצום לקשישים ומטופלי גריאטריה',
    ts: '01:06:31', secs: 3991,
    audio: 'https://ta-lectures.s3.us-east-005.backblazeb2.com/mp3/478517/478517-tlff1f.mp3',
  },
  {
    id: 'q14',
    img: '/images/rav-asher-weiss/quote14.jpg',
    quoteHe: 'כמדומני — כוונת הרמב״ן: ואהבת לרעך כמוך הוא דרך הפלגה — לא כמה תאהב, אלא איך תאהב.',
    lectureId: '367321',
    lectureTitle: 'פרשת אחרי מות קדושים: ואהבת לרעך כמוך',
    ts: '00:01:01', secs: 61,
    audio: 'https://ta-lectures.s3.us-east-005.backblazeb2.com/mp3/367321/367321-svubla.mp3',
  },
  {
    id: 'q12',
    img: '/images/rav-asher-weiss/quote12.jpg',
    quoteHe: 'כמדומני — כל עוד הבית הוא מגורי הקבע שלך, הוא חייב במזוזה גם כשאתה לא יושב בו — וכשאתה חוזר, לא מקיים מצווה חדשה.',
    lectureId: '378071',
    lectureTitle: 'ברכת המצוה: על קיום המצוה או על מעשה המצוה',
    ts: '00:06:13', secs: 373,
    audio: 'https://ta-lectures.s3.us-east-005.backblazeb2.com/mp3/378071/378071-syigtr.mp3',
  },
  {
    id: 'q11',
    img: '/images/rav-asher-weiss/quote11.jpg',
    quoteHe: 'כמדומני — ברכת הלבנה לא מתחייבת על ידי הראייה — היא מתאפשרת על ידי הראייה. אין שום קפידה לברך בראייה הראשונה.',
    lectureId: '347229',
    lectureTitle: 'פרשת בא: מצוות קידוש לבנה',
    ts: '00:25:52', secs: 1552,
    audio: 'https://dl.torahanytime.com/mp3/347229--____00_03_2025__62d03cad-3dfe-43b9-b651-1d416ce9c771.mp4.mp3',
  },
  {
    id: 'q10',
    img: '/images/rav-asher-weiss/quote10.jpg',
    quoteHe: 'כמדומני — בפורים זה צריך לבוא מן הלב, ולא מן השכל — ממקום הנסתר ביותר בנפש האדם. זה הרעיון של "חייב איניש לבסומי עד דלא ידע".',
    lectureId: '356724',
    lectureTitle: 'מסר קצר לפורים: עד דלא ידע',
    ts: '00:06:10', secs: 370,
    audio: 'https://ta-lectures.s3.us-east-005.backblazeb2.com/mp3/356724/356724-st0j8e.mp3',
  },
  {
    id: 'q9',
    img: '/images/rav-asher-weiss/quote9.jpg',
    quoteHe: 'כמדומני — ברכות הנישואין אינן של החתן והכלה; הן מוטלות על הציבור.',
    lectureId: '266948',
    lectureTitle: 'פרשת ויצא: ברכות נישואין',
    ts: '00:31:09', secs: 1869,
    audio: 'https://dl.torahanytime.com/mp3/266948--____10_04_2023__6b6aa9ac-db04-4e9b-a823-9e0a1f3c7971.mp4.mp3',
  },
  {
    id: 'q8',
    img: '/images/rav-asher-weiss/quote8.jpg',
    quoteHe: 'כמדומני — גם בעזרת נשים יש קדושה, אבל עיקר הקדושה הוא מקום שבו הגברים מתפללים.',
    lectureId: '281517',
    lectureTitle: 'קדושת עזרת נשים',
    ts: '00:14:37', secs: 877,
    audio: 'https://dl.torahanytime.com/mp3/281517--____01_00_2024__28db900d-ab77-4fc4-a14d-327c87621e6c.mp4.mp3',
  },
  {
    id: 'q7',
    img: '/images/rav-asher-weiss/quote7.jpg',
    quoteHe: 'כמדומני — הראיה של החיי־אדם שאין חיוב לעזוב את ביתו לקיים מצות עשה היא אחת הראיות הכי קלושות ששמעתי בחיים שלי. זה לא ראיה.',
    lectureId: '330201',
    lectureTitle: 'פרשת לך לך: חובת היחיד במצוות הציבור',
    ts: '00:16:58', secs: 1018,
    audio: 'https://dl.torahanytime.com/mp3/330201--____10_02_2024__5760673b-ef7a-4aed-a02c-69985aa78ce2.mp4.mp3',
  },
  {
    id: 'q6',
    img: '/images/rav-asher-weiss/quote6.jpg',
    quoteHe: 'כמדומני — האיסור לאכול לפני קידוש אינו מדין קידוש; הרי יוצאים ידי חובתו בתפילה. האיסור הוא מדין \'קידוש במקום סעודה\'.',
    lectureId: '343098',
    lectureTitle: 'עשרה בטבת שחל בערב שבת',
    ts: '00:39:27', secs: 2367,
    audio: 'https://dl.torahanytime.com/mp3/343098--____00_03_2025__88b1902a-d984-4298-a35e-786ee8e8bac1.mp4.mp3',
  },
  {
    id: 'q1',
    img: '/images/rav-asher-weiss/quote1.jpg',
    quoteHe: 'טבעו של אדם לא להתחייב בלי לדעת למה הוא מתחייב — ורק פעם אחת בהיסטוריה עשה כן עם שלם',
    lectureId: '370352',
    lectureTitle: 'איסור חדש בזמן הזה',
    ts: '00:41:38', secs: 2498,
    audio: 'https://ta-lectures.s3.us-east-005.backblazeb2.com/mp3/370352/370352-swk326.mp3',
  },
  {
    id: 'q2',
    img: '/images/rav-asher-weiss/quote2.jpg',
    quoteHe: 'חייב להיות גבול — כמה טורח אדם צריך לטרוח כדי לקיים מצוה',
    lectureId: '479745',
    lectureTitle: 'שיעור בישיבת אור אלחנן בעניין הידור וטרחה במצוות',
    ts: '00:31:00', secs: 1860,
    audio: 'https://ta-lectures.s3.us-east-005.backblazeb2.com/mp3/479745/479745-tlqji7.mp3',
  },
  {
    id: 'q3',
    img: '/images/rav-asher-weiss/quote3.jpg',
    quoteHe: '״שלא להתחיל לאכול״ — הכוונה שלא להתחיל את הסעודה; ובתחילת הסעודה, זה קידוש',
    lectureId: '449098',
    lectureTitle: 'בעניין ערבית וקידוש מוקדמת בליל שבועות',
    ts: '00:35:36', secs: 2136,
    audio: 'https://ta-lectures.s3.us-east-005.backblazeb2.com/mp3/449098/449098-tf2jlh.mp3',
  },
  {
    id: 'q4',
    img: '/images/rav-asher-weiss/quote4.jpg',
    quoteHe: 'בר מצוה באמצע הספירה — כמדומני שכך פסק הרב עובדיה: ממשיך לספור בברכה',
    lectureId: '448235',
    lectureTitle: 'בעניין תמימות בספירת העומר',
    ts: '00:30:17', secs: 1817,
    audio: 'https://ta-lectures.s3.us-east-005.backblazeb2.com/mp3/448235/448235-tewp3h.mp3',
  },
  {
    id: 'q5',
    img: '/images/rav-asher-weiss/quote5.jpg',
    quoteHe: 'כמדומני — זה המשנה למלך הארוך ביותר שיש',
    lectureId: '440777',
    lectureTitle: 'אפשר לברורי ברוב ובחזקה',
    ts: '00:23:26', secs: 1406,
    audio: 'https://ta-lectures.s3.us-east-005.backblazeb2.com/mp3/440777/440777-td1e0m.mp3',
  },
];

const deepLink = (q) => `https://yutorah-rss.netlify.app/transcripts/#${q.lectureId}@${q.ts}`;
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="raw-page">
    <header class="hero">
      <p class="kicker" dir="rtl" lang="he">כמדומני</p>
      <h1>Rav Asher Weiss</h1>
      <p class="sub">
        Fourteen moments where he says <em>“it seems to me”</em> — and a chiddush follows.
        Portraits generated with Flux&nbsp;Klein. Quotes lightly cleaned from
        auto-generated transcripts: treat as close paraphrase, not exact wording.
      </p>
      <p class="sub">
        Tap <strong>play</strong> on any card to hear the moment in his own voice,
        or open the full transcript at that timestamp.
      </p>
    </header>

    <section class="grid">
      {quotes.map((q) => (
        <article class="card" id={q.id}>
          <a class="art" href={deepLink(q)} target="_blank" rel="noopener" title="Open transcript at this moment">
            <img src={q.img} alt="" loading="lazy" />
          </a>
          <div class="body">
            <p class="quote" dir="rtl" lang="he">{q.quoteHe}</p>
            <p class="src" dir="rtl" lang="he">{q.lectureTitle} · {q.ts}</p>
            <div class="actions">
              <button class="play" data-play={q.id} data-secs={q.secs} data-label="▶ Play from here">
                ▶ Play from here
              </button>
              <a class="read" href={deepLink(q)} target="_blank" rel="noopener">Read in transcript ↗</a>
            </div>
            <audio id={`audio-${q.id}`} src={q.audio} preload="none"></audio>
          </div>
        </article>
      ))}
    </section>

    <footer class="foot">
      <p>
        More <span dir="rtl" lang="he">כמדומני</span> moments are collected as the
        full transcription of Rav Asher Weiss's TorahAnytime archive progresses —
        <a href="https://yutorah-rss.netlify.app/transcripts/" target="_blank" rel="noopener">browse all transcripts</a>.
      </p>
    </footer>
  </main>

  <script>
    document.querySelectorAll('[data-play]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-play');
        const secs = parseFloat(btn.getAttribute('data-secs'));
        const audio = document.getElementById('audio-' + id);
        const label = btn.getAttribute('data-label');
        const playing = !audio.paused && !audio.ended;
        document.querySelectorAll('audio').forEach((a) => a.pause());
        document.querySelectorAll('[data-play]').forEach((b) => {
          b.textContent = b.getAttribute('data-label');
          b.classList.remove('on');
        });
        if (playing) return;
        try { audio.currentTime = secs; } catch (e) {}
        audio.play().catch(() => {});
        btn.textContent = '⏸ Playing…';
        btn.classList.add('on');
        audio.onended = () => {
          btn.textContent = label;
          btn.classList.remove('on');
        };
      });
    });
  </script>

  <style>
    .raw-page { max-width: 1180px; margin: 0 auto; padding: 2.5rem 1.25rem 4rem; }
    .hero { text-align: center; margin-bottom: 2.5rem; }
    .kicker { font-size: 2.2rem; color: #d4a017; margin: 0 0 .4rem; font-weight: 700; }
    .hero h1 { font-size: 2.4rem; margin: 0 0 .8rem; letter-spacing: -.01em; }
    .hero .sub { max-width: 640px; margin: .5rem auto; color: #555; line-height: 1.6; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.6rem; }
    .card { background: #fff; border: 1px solid #e8e2d4; border-radius: 14px; overflow: hidden;
            box-shadow: 0 6px 24px rgba(60,45,20,.08); display: flex; flex-direction: column; }
    .art { display: block; aspect-ratio: 4 / 5; overflow: hidden; background: #111; }
    .art img { width: 100%; height: 100%; object-fit: cover; display: block;
               transition: transform .5s ease; }
    .card:hover .art img { transform: scale(1.025); }
    .body { padding: 1.1rem 1.2rem 1.3rem; display: flex; flex-direction: column; gap: .55rem; flex: 1; }
    .quote { font-size: 1.12rem; line-height: 1.65; margin: 0; color: #1d1a14; }
    .src { font-size: .85rem; color: #8a7c5f; margin: 0; }
    .actions { display: flex; align-items: center; gap: .9rem; margin-top: auto; padding-top: .4rem; }
    .play { background: #1d1a14; color: #f5ead0; border: none; border-radius: 999px;
            padding: .55rem 1.15rem; font-size: .92rem; cursor: pointer; transition: background .2s; }
    .play:hover { background: #3a3226; }
    .play.on { background: #8a6d1f; }
    .read { font-size: .88rem; color: #8a6d1f; text-decoration: none; }
    .read:hover { text-decoration: underline; }
    .foot { text-align: center; margin-top: 3rem; color: #777; font-size: .95rem; }
    .foot a { color: #8a6d1f; }
    audio { display: none; }
  </style>
</Layout>
