---
import Layout from '../layouts/Layout.astro';
import annotationsMeta from '../data/rav_nachman_annotations.json';

const thesis = (annotationsMeta as any).thesis_assessment ?? {};
const stats = (annotationsMeta as any).stats ?? {};
const totalAnnotations: number = stats.annotations_total ?? 0;
const byStance = stats.annotations_by_stance ?? {};
const supportsCount: number = byStance['supports qualified anti-intellectual reading'] ?? 0;
const countersCount: number = byStance['counterevidence to broad anti-intellectual reading'] ?? 0;
const mixedCount: number = byStance['complicates / mixed'] ?? 0;
const segmentsScanned: number = stats.hebrew_segments_scanned ?? 0;
---

<Layout
  title="Rav Nachman — Likutei Moharan | The Other Matthew Miller"
  description="Full annotated text of Likutei Moharan — Rebbe Nachman of Breslov — with 256 inline annotations examining his stance on intellect, external wisdom, and faith."
>
  <main class="min-h-screen bg-gray-50 dark:bg-gray-900">

    <!-- Hero -->
    <div class="bg-gradient-to-br from-cyan-900 via-cyan-800 to-teal-900 text-white py-14 px-4">
      <div class="max-w-5xl mx-auto text-center">
        <p class="text-cyan-300 text-xs font-medium tracking-widest uppercase mb-3">Source Sheet</p>
        <h1 class="text-5xl font-bold mb-1 font-hebrew" dir="rtl">ליקוטי מוהר״ן</h1>
        <p class="text-xl text-cyan-200 italic mb-1">Likutei Moharan</p>
        <p class="text-cyan-300 mb-6">Rebbe Nachman of Breslov</p>
        <div class="inline-flex flex-wrap justify-center gap-4 text-xs text-cyan-300">
          <span>{totalAnnotations} annotated passages</span>
          <span>·</span>
          <span>{segmentsScanned.toLocaleString()} segments</span>
          <span>·</span>
          <span>286 lessons · Part I + Part II</span>
        </div>
      </div>
    </div>

    <!-- Page nav -->
    <div class="sticky top-0 z-30 bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 shadow-sm">
      <div class="max-w-5xl mx-auto px-4 flex gap-1 overflow-x-auto py-2 text-sm font-medium">
        <a href="#thesis" class="px-3 py-1.5 rounded-md whitespace-nowrap text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">Thesis</a>
        <a href="#pdf" class="px-3 py-1.5 rounded-md whitespace-nowrap text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">PDF</a>
        <a href="#reader" class="px-3 py-1.5 rounded-md whitespace-nowrap text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">Full Text ↓</a>
        <div class="ml-auto flex items-center gap-2">
          <a
            href="/Rav%20Nachman/likutei_moharan_annotated.pdf"
            download
            class="px-3 py-1.5 bg-cyan-600 hover:bg-cyan-700 text-white rounded-md whitespace-nowrap transition-colors text-xs"
          >Download PDF</a>
        </div>
      </div>
    </div>

    <div class="max-w-5xl mx-auto px-4 py-10 space-y-14">

      <!-- Thesis -->
      <section id="thesis">
        <h2 class="text-2xl font-bold text-gray-800 dark:text-gray-200 mb-5 pb-2 border-b-2 border-cyan-500">Thesis Assessment</h2>
        <div class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow border border-gray-200 dark:border-gray-700 space-y-4">
          <div class="flex flex-wrap gap-3">
            <span class="px-3 py-1.5 bg-red-50 dark:bg-red-900/40 text-red-500 dark:text-red-400 rounded-full text-sm line-through opacity-60">"{thesis.too_blunt_label}"</span>
            <span class="px-3 py-1.5 bg-cyan-50 dark:bg-cyan-900/40 text-cyan-700 dark:text-cyan-300 rounded-full text-sm font-semibold">"{thesis.best_short_label}"</span>
          </div>
          <p class="text-gray-700 dark:text-gray-300 leading-relaxed text-sm">{thesis.why}</p>
          {thesis.recommended_claim_text && (
            <blockquote class="border-l-4 border-cyan-500 pl-5 italic text-gray-600 dark:text-gray-400 text-sm leading-relaxed">{thesis.recommended_claim_text}</blockquote>
          )}
        </div>
        <!-- Stats row -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-5">
          {([
            { v: totalAnnotations, label: 'Annotations', cls: 'text-cyan-600 dark:text-cyan-400', b: 'border-cyan-200 dark:border-cyan-800' },
            { v: supportsCount,    label: 'Support thesis',   cls: 'text-red-600 dark:text-red-400',   b: 'border-red-200 dark:border-red-800' },
            { v: countersCount,    label: 'Counter thesis',   cls: 'text-green-600 dark:text-green-400', b: 'border-green-200 dark:border-green-800' },
            { v: mixedCount,       label: 'Mixed',            cls: 'text-amber-600 dark:text-amber-400', b: 'border-amber-200 dark:border-amber-800' },
          ] as const).map(s => (
            <div class={`bg-white dark:bg-gray-800 rounded-xl p-4 text-center border shadow-sm ${s.b}`}>
              <p class={`text-2xl font-bold ${s.cls}`}>{s.v}</p>
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">{s.label}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- PDF viewer -->
      <section id="pdf">
        <h2 class="text-2xl font-bold text-gray-800 dark:text-gray-200 mb-5 pb-2 border-b-2 border-cyan-500">Annotated PDF</h2>
        <div class="rounded-xl overflow-hidden shadow-xl border border-gray-200 dark:border-gray-700" style="height:680px">
          <iframe src="/Rav%20Nachman/likutei_moharan_annotated.pdf" class="w-full h-full border-0" title="Likutei Moharan Annotated PDF" loading="lazy"></iframe>
        </div>
        <p class="text-xs text-gray-400 mt-2 text-center">
          Can't see it? <a href="/Rav%20Nachman/likutei_moharan_annotated.pdf" class="underline text-cyan-600 dark:text-cyan-400">Open PDF directly</a>.
        </p>
      </section>

      <!-- Full Text Reader -->
      <section id="reader">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5 pb-2 border-b-2 border-cyan-500">
          <h2 class="text-2xl font-bold text-gray-800 dark:text-gray-200">Full Text</h2>
          <!-- Filter + controls (populated by JS) -->
          <div class="flex flex-wrap gap-2 items-center" id="reader-controls">
            <span class="text-xs text-gray-400 dark:text-gray-500" id="reader-status">Loading…</span>
          </div>
        </div>

        <!-- Chapter tabs -->
        <div class="flex gap-1 overflow-x-auto pb-1 mb-4" id="chapter-tabs"></div>

        <!-- Lesson list -->
        <div id="reader-content" class="space-y-2">
          <div class="flex items-center justify-center py-20 text-gray-400 dark:text-gray-500">
            <svg class="animate-spin w-6 h-6 mr-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 22 6.477 22 12h-4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            Loading full text…
          </div>
        </div>
      </section>

    </div>
  </main>
</Layout>

<script>
// ── Types ──────────────────────────────────────────────────────────────────────
interface Annotation {
  id: string;
  ref: string;
  labels: string[];
  stance: string;
  relevance_score: number;
  en_text: string;
  he_text: string;
  annotation_note: string;
}
interface Segment { text: string; he: string; annotation: Annotation | null; }
interface Section { section_num: number | null; segments: Segment[]; }
interface Lesson { lesson_num: number | null; title: string; sections: Section[]; }
interface Chapter { chapter: string; lessons: Lesson[]; }
interface ReaderData {
  thesis: Record<string, string>;
  stats: Record<string, any>;
  schema: Record<string, any>;
  chapters: Chapter[];
}

// ── Config ─────────────────────────────────────────────────────────────────────
const STANCE: Record<string, { border: string; bg: string; badge: string; label: string }> = {
  'supports qualified anti-intellectual reading': {
    border: 'border-l-4 border-red-400 dark:border-red-600',
    bg:     'bg-red-50 dark:bg-red-950/60',
    badge:  'bg-red-100 dark:bg-red-900 text-red-700 dark:text-red-300',
    label:  'Supports thesis',
  },
  'counterevidence to broad anti-intellectual reading': {
    border: 'border-l-4 border-green-400 dark:border-green-600',
    bg:     'bg-green-50 dark:bg-green-950/60',
    badge:  'bg-green-100 dark:bg-green-900 text-green-700 dark:text-green-300',
    label:  'Counters thesis',
  },
  'complicates / mixed': {
    border: 'border-l-4 border-amber-400 dark:border-amber-600',
    bg:     'bg-amber-50 dark:bg-amber-950/60',
    badge:  'bg-amber-100 dark:bg-amber-900 text-amber-700 dark:text-amber-300',
    label:  'Mixed',
  },
};
const DEFAULT_STANCE = STANCE['complicates / mixed'];

function stripHtml(s: string): string {
  return (s ?? '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
}

function stars(n: number): string {
  return '★'.repeat(n) + '☆'.repeat(Math.max(0, 5 - n));
}

// ── Render helpers ─────────────────────────────────────────────────────────────

function renderAnnotationBadge(ann: Annotation): string {
  const cfg = STANCE[ann.stance] ?? DEFAULT_STANCE;
  const lbls = (ann.labels ?? []).map(l =>
    `<span class="inline-block text-xs font-mono px-1.5 py-0.5 rounded bg-white/50 dark:bg-black/20 border border-current opacity-80">${l}</span>`
  ).join(' ');
  const note = ann.annotation_note
    ? `<p class="text-xs italic text-gray-500 dark:text-gray-400 mt-1">${stripHtml(ann.annotation_note).slice(0, 200)}</p>`
    : '';
  return `
    <details class="ann-detail mt-2 rounded-lg overflow-hidden border ${cfg.border.replace('border-l-4 ', '')} text-sm">
      <summary class="flex items-center gap-2 px-3 py-2 cursor-pointer list-none ${cfg.bg} select-none">
        <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold ${cfg.badge}">${cfg.label}</span>
        <span class="text-gray-500 dark:text-gray-400 text-xs truncate flex-1">${ann.ref}</span>
        <span class="text-xs opacity-60 shrink-0">${stars(ann.relevance_score)}</span>
        <svg class="w-3.5 h-3.5 shrink-0 opacity-50 transition-transform ann-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
      </summary>
      <div class="${cfg.bg} px-3 pb-3 pt-2 space-y-2">
        <div class="grid md:grid-cols-2 gap-3">
          <div dir="rtl" lang="he" class="text-right">
            <p class="font-hebrew text-sm leading-relaxed text-gray-800 dark:text-gray-200">${(ann.he_text ?? '').slice(0, 300)}</p>
          </div>
          <div>
            <p class="text-xs text-gray-700 dark:text-gray-300 leading-relaxed">${stripHtml(ann.en_text ?? '').slice(0, 400)}</p>
          </div>
        </div>
        <div class="flex flex-wrap gap-1">${lbls}</div>
        ${note}
      </div>
    </details>`;
}

function renderSegment(seg: Segment, filter: string): string {
  const ann = seg.annotation;
  const show = filter === 'all' || (ann && ann.stance === filter) || (!ann && filter === 'all');
  if (!show && filter !== 'all' && !ann) return '';

  const cfg = ann ? (STANCE[ann.stance] ?? DEFAULT_STANCE) : null;
  const wrapClass = cfg
    ? `pl-3 ${cfg.border} ${cfg.bg} rounded-r-lg`
    : 'pl-3 border-l-4 border-transparent';

  const heShort = (seg.he || '').slice(0, ann ? 300 : 100);
  const enText = stripHtml(seg.text || '');

  return `
    <div class="segment ${wrapClass} py-2 mb-1" data-stance="${ann?.stance ?? ''}">
      <div class="grid md:grid-cols-2 gap-3">
        <div dir="rtl" lang="he" class="text-right">
          <p class="font-hebrew text-sm leading-loose text-gray-700 dark:text-gray-300">${heShort}</p>
        </div>
        <div>
          <p class="text-sm text-gray-800 dark:text-gray-200 leading-relaxed">${enText}</p>
        </div>
      </div>
      ${ann ? renderAnnotationBadge(ann) : ''}
    </div>`;
}

function renderLesson(lesson: Lesson, filter: string, openByDefault: boolean): string {
  const annCount = lesson.sections.flatMap(s => s.segments).filter(s => s.annotation).length;
  const annBadge = annCount > 0
    ? `<span class="ml-2 inline-block px-1.5 py-0.5 text-xs rounded-full bg-cyan-100 dark:bg-cyan-900 text-cyan-700 dark:text-cyan-300 font-medium">${annCount} ann.</span>`
    : '';

  const segsHtml = lesson.sections.map(sec => {
    const secLabel = sec.section_num != null && lesson.sections.length > 1
      ? `<p class="text-xs text-gray-400 dark:text-gray-600 font-mono mb-1 mt-3">§${sec.section_num}</p>` : '';
    const segs = sec.segments.map(s => renderSegment(s, filter)).join('');
    return segs ? secLabel + segs : '';
  }).join('');

  if (!segsHtml.trim() && filter !== 'all') return '';

  const id = `lesson-${lesson.lesson_num ?? lesson.title.replace(/\s+/g, '-')}`;
  const open = openByDefault ? 'open' : '';

  return `
    <details class="lesson-item bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden shadow-sm" id="${id}" ${open}>
      <summary class="flex items-center gap-2 px-5 py-3.5 cursor-pointer list-none select-none hover:bg-gray-50 dark:hover:bg-gray-750 transition-colors">
        <svg class="w-4 h-4 shrink-0 text-cyan-500 transition-transform lesson-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        <span class="font-semibold text-gray-800 dark:text-gray-200 text-sm">${lesson.title}</span>
        ${annBadge}
      </summary>
      <div class="px-5 pb-5 pt-2 space-y-0.5 lesson-body">${segsHtml || '<p class="text-xs text-gray-400 italic">No passages match this filter.</p>'}</div>
    </details>`;
}

// ── Main ───────────────────────────────────────────────────────────────────────

let readerData: ReaderData | null = null;
let activeChapter = 0;
let activeFilter = 'all';

async function loadReader() {
  const res = await fetch('/Rav%20Nachman/reader.json');
  readerData = await res.json() as ReaderData;
  initReader();
}

function initReader() {
  if (!readerData) return;
  buildChapterTabs();
  buildControls();
  renderChapter(0);
}

function buildChapterTabs() {
  const tabs = document.getElementById('chapter-tabs')!;
  tabs.innerHTML = readerData!.chapters.map((ch, i) => {
    const lessonCount = ch.lessons.length;
    const annCount = ch.lessons.flatMap(l => l.sections).flatMap(s => s.segments).filter(s => s.annotation).length;
    const active = i === activeChapter;
    return `<button
      class="chapter-tab px-3 py-1.5 rounded-lg text-sm font-medium whitespace-nowrap transition-colors border
        ${active ? 'bg-cyan-600 text-white border-cyan-600' : 'bg-white dark:bg-gray-800 text-gray-600 dark:text-gray-300 border-gray-200 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700'}"
      data-chapter="${i}">
      ${ch.chapter} <span class="opacity-60 text-xs">(${lessonCount}${annCount ? ` · ${annCount} ann.` : ''})</span>
    </button>`;
  }).join('');

  tabs.querySelectorAll('.chapter-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      activeChapter = parseInt((btn as HTMLElement).dataset.chapter!);
      buildChapterTabs();
      renderChapter(activeChapter);
    });
  });
}

function buildControls() {
  const ctrl = document.getElementById('reader-controls')!;
  const total = readerData!.chapters.reduce((n, ch) =>
    n + ch.lessons.flatMap(l => l.sections).flatMap(s => s.segments).length, 0);
  const annTotal = readerData!.chapters.reduce((n, ch) =>
    n + ch.lessons.flatMap(l => l.sections).flatMap(s => s.segments).filter(s => s.annotation).length, 0);

  ctrl.innerHTML = `
    <span class="text-xs text-gray-400">${total.toLocaleString()} segments · ${annTotal} annotated</span>
    <div class="flex gap-1.5 flex-wrap">
      ${[
        ['all', 'All', 'border-gray-400 dark:border-gray-500'],
        ['supports qualified anti-intellectual reading', 'Supports', 'border-red-400 dark:border-red-600 text-red-700 dark:text-red-300'],
        ['counterevidence to broad anti-intellectual reading', 'Counters', 'border-green-400 dark:border-green-600 text-green-700 dark:text-green-300'],
        ['complicates / mixed', 'Mixed', 'border-amber-400 dark:border-amber-600 text-amber-700 dark:text-amber-300'],
      ].map(([val, label, cls]) => `
        <button class="filter-btn text-xs px-2.5 py-1 rounded-full border ${cls} transition-colors
          ${activeFilter === val ? 'bg-gray-800 text-white dark:bg-gray-200 dark:text-gray-900 font-semibold' : ''}"
          data-filter="${val}">${label}</button>`).join('')}
    </div>`;

  ctrl.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      activeFilter = (btn as HTMLElement).dataset.filter!;
      buildControls();
      renderChapter(activeChapter);
    });
  });
}

function renderChapter(idx: number) {
  const content = document.getElementById('reader-content')!;
  if (!readerData) return;
  const ch = readerData.chapters[idx];
  if (!ch) return;

  // Open first lesson by default; open all annotated if filter active
  const html = ch.lessons.map((les, i) => {
    const hasAnnotations = les.sections.flatMap(s => s.segments).some(s => s.annotation);
    const openDefault = i === 0 || (activeFilter !== 'all' && hasAnnotations);
    return renderLesson(les, activeFilter, openDefault);
  }).join('');

  content.innerHTML = html || '<p class="text-sm text-gray-400 italic p-4">No passages match this filter in this chapter.</p>';

  // Rotate chevrons on open/close
  content.querySelectorAll('details.lesson-item').forEach(det => {
    const chev = det.querySelector<HTMLElement>('.lesson-chevron');
    if (!chev) return;
    if ((det as HTMLDetailsElement).open) chev.style.transform = 'rotate(90deg)';
    det.addEventListener('toggle', () => {
      chev.style.transform = (det as HTMLDetailsElement).open ? 'rotate(90deg)' : '';
    });
  });
  content.querySelectorAll('details.ann-detail').forEach(det => {
    const chev = det.querySelector<HTMLElement>('.ann-chevron');
    if (!chev) return;
    det.addEventListener('toggle', () => {
      chev.style.transform = (det as HTMLDetailsElement).open ? 'rotate(180deg)' : '';
    });
  });
}

// kick off
document.addEventListener('DOMContentLoaded', loadReader);
</script>

<style>
  .font-hebrew {
    font-family: 'SBL Hebrew', 'Ezra SIL', 'Arial Hebrew', 'David', serif;
  }
  details > summary::-webkit-details-marker { display: none; }
  details > summary::marker { display: none; }
</style>
