---
import Layout from '../../layouts/Layout.astro';
import scpData from '../../data/scp.json';
import shiur1Transcript from '../../data/scp-shiur-1-transcript.json';
import shiur2Transcript from '../../data/scp-shiur-2-transcript.json';

const { series, shiurim } = scpData;

const transcriptMap: Record<string, typeof shiur1Transcript> = {
  'shiur-1': shiur1Transcript,
  'shiur-2': shiur2Transcript,
};

const totalJokes = shiurim.reduce((sum, s) => sum + (s.jokes?.length ?? 0), 0);
const allFoods = shiurim.flatMap(s =>
  (s.disgracefulFoods ?? []).map(f => ({ ...f, shiurNumber: s.number }))
);

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

function youtubeEmbedUrl(videoUrl: string | null) {
  if (!videoUrl) return null;
  // Accept either a full YouTube URL or just a video ID
  const match = videoUrl.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([A-Za-z0-9_-]{11})/);
  const id = match ? match[1] : videoUrl;
  return `https://www.youtube.com/embed/${id}?rel=0&modestbranding=1`;
}
---

<Layout
  title="SCP — Semichas Chaver Program"
  description="Shiurim, transcripts, and notes from the Semichas Chaver Program with Rabbi Leibtag, covering Yoreh Deah."
>
  <main class="container mx-auto px-4 sm:px-6 py-10 max-w-4xl">

    <!-- Password Form -->
    <section class="mb-10" id="password-section">
      <div class="bg-gradient-to-r from-slate-800 to-slate-900 dark:from-slate-700 dark:to-slate-800 border border-slate-300 dark:border-slate-600 rounded-xl p-8 max-w-md mx-auto">
        <div class="text-center">
          <img
            src={series.imageUrl}
            alt="SCP Podcast Cover"
            class="w-24 h-24 rounded-xl shadow-lg object-cover mx-auto mb-4"
          />
          <h1 class="text-2xl font-bold text-white mb-1">{series.title}</h1>
          <p class="text-sm text-gray-400 mb-6">{series.subtitle}</p>
          <form id="password-form" class="space-y-4">
            <input
              type="password"
              id="password-input"
              placeholder="Enter password to access..."
              class="w-full px-4 py-3 rounded-lg border border-gray-600 bg-slate-700 text-white placeholder-gray-400 focus:ring-2 focus:ring-cyan-500 focus:border-transparent"
            />
            <button
              type="submit"
              class="w-full px-6 py-3 rounded-lg bg-cyan-600 hover:bg-cyan-700 text-white font-semibold transition-colors"
            >
              Access Shiurim
            </button>
          </form>
          <p id="password-error" class="text-sm text-red-400 mt-4 hidden">Incorrect password</p>
        </div>
      </div>
    </section>

    <!-- Main Content -->
    <div id="main-content" class="hidden">
      <!-- Header -->
      <header class="mb-10">
        <div class="flex flex-wrap items-center gap-6 mb-6">
          <img
            src={series.imageUrl}
            alt="SCP Podcast Cover"
            class="w-32 h-32 rounded-xl shadow-lg object-cover"
          />
          <div class="flex-1">
            <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 dark:text-white mb-1">
              {series.title}
            </h1>
            <p class="text-lg text-gray-600 dark:text-gray-400">{series.subtitle}</p>
          </div>
          <a
            href="/scp/feed.xml"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-orange-500 hover:bg-orange-600 text-white text-sm font-semibold transition-colors"
            title="Subscribe in your podcast app"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
            </svg>
            Subscribe (RSS)
          </a>
        </div>
        <p class="text-gray-700 dark:text-gray-300 leading-relaxed max-w-2xl">
          {series.description}
        </p>

        <!-- Subscribe Instructions -->
        <div class="mt-6 bg-gray-50 dark:bg-gray-800/50 rounded-xl p-5 border border-gray-200 dark:border-gray-700">
          <h3 class="text-sm font-semibold text-gray-900 dark:text-white uppercase tracking-wide mb-3">Subscribe in Podcast Apps</h3>
          <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">
            RSS Feed: <code class="bg-gray-200 dark:bg-gray-700 px-2 py-1 rounded text-xs">{series.feedUrl}</code>
          </p>
          <div class="space-y-2 text-sm text-gray-700 dark:text-gray-300">
            <p><strong>Apple Podcasts (Mac/iTunes):</strong> File → Add Show by URL → paste feed → Subscribe</p>
            <p><strong>Apple Podcasts (iOS):</strong> Library → ⋯ → Follow a Show by URL → paste feed → Follow</p>
            <p><strong>Pocket Casts:</strong> Discover → paste feed in Search → click artwork → Subscribe</p>
            <p><strong>Overcast:</strong> + → Add URL → paste feed → Done</p>
            <p><strong>Castbox/Podcast Addict:</strong> Discover → paste feed in Search → Subscribe</p>
          </div>
        </div>
      </header>

      <!-- Easter Egg Trigger -->
      <div class="mb-10 text-center">
        <button id="easter-egg-trigger" class="text-xs text-gray-300 dark:text-gray-600 hover:text-gray-400 dark:hover:text-gray-500 transition-colors">
          &nbsp;
        </button>
      </div>

      <!-- Running Tallies (easter egg) -->
      <section class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10 hidden" id="running-tallies">
        <div class="bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-700 rounded-xl p-5">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-3xl" aria-hidden="true">😄</span>
            <div>
              <div class="text-2xl font-bold text-yellow-700 dark:text-yellow-400">{totalJokes}</div>
              <div class="text-sm font-semibold text-yellow-700 dark:text-yellow-400 uppercase tracking-wide">Jokes Cracked</div>
            </div>
          </div>
          <ul class="space-y-2 mt-2" id="jokes-list">
            {shiurim.flatMap(s =>
              (s.jokes ?? []).map(j => (
                <li class="text-sm text-gray-700 dark:text-gray-300 border-l-2 border-yellow-400 pl-3">
                  <span class="font-mono text-xs text-gray-500 dark:text-gray-500 mr-1">#{s.number} @{j.timestamp}</span>
                  {j.text}
                </li>
              ))
            )}
          </ul>
        </div>
        <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-700 rounded-xl p-5">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-3xl" aria-hidden="true">🍽️</span>
            <div>
              <div class="text-2xl font-bold text-red-700 dark:text-red-400">{allFoods.length}</div>
              <div class="text-sm font-semibold text-red-700 dark:text-red-400 uppercase tracking-wide">Disgraced Foods</div>
            </div>
          </div>
          <ul class="space-y-2 mt-2">
            {allFoods.map(f => (
              <li class="text-sm text-gray-700 dark:text-gray-300 border-l-2 border-red-400 pl-3">
                <span class="font-semibold text-gray-900 dark:text-white">{f.food}</span>
                <span class="font-mono text-xs text-gray-500 dark:text-gray-500 ml-1">(#{f.shiurNumber})</span>
                <span class="text-gray-500 dark:text-gray-400"> — {f.context}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Shiurim -->
      {shiurim.map(shiur => {
        const transcript = transcriptMap[shiur.id] ?? [];
        const embedUrl = youtubeEmbedUrl(shiur.videoUrl ?? null);
        return (
          <article class="mb-12 bg-white dark:bg-slate-800 rounded-2xl shadow-lg border border-slate-200 dark:border-slate-700 overflow-hidden">

            <!-- Shiur header -->
            <div class="bg-slate-50 dark:bg-slate-900/50 px-6 py-5 border-b border-slate-200 dark:border-slate-700">
              <div class="flex flex-wrap items-start justify-between gap-2">
                <div>
                  <div class="flex items-center gap-2 mb-1">
                    <span class="inline-block bg-cyan-100 dark:bg-cyan-900/40 text-cyan-700 dark:text-cyan-300 text-xs font-bold px-2 py-0.5 rounded">
                      Shiur {shiur.number}
                    </span>
                    <span class="text-xs text-gray-500 dark:text-gray-400">{formatDate(shiur.date)}</span>
                  </div>
                  <h2 class="text-xl font-bold text-gray-900 dark:text-white">{shiur.title}</h2>
                  <p class="text-sm font-hebrew text-gray-500 dark:text-gray-400 mt-0.5" dir="rtl">{shiur.hebrewTitle}</p>
                </div>
                {shiur.duration && (
                  <div class="text-sm text-gray-500 dark:text-gray-400 font-mono">{shiur.duration}</div>
                )}
              </div>
              <p class="mt-3 text-sm text-gray-600 dark:text-gray-300 leading-relaxed">{shiur.description}</p>
              {shiur.topics && (
                <div class="flex flex-wrap gap-1 mt-3">
                  {shiur.topics.map(t => (
                    <span class="text-xs bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300 px-2 py-0.5 rounded-full">{t}</span>
                  ))}
                </div>
              )}
            </div>

            <!-- Audio player -->
            {shiur.audioFile ? (
              <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800">
                <div class="flex items-center justify-between mb-2">
                  <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Audio</p>
                  <a
                    href={shiur.audioFile}
                    download
                    class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-500 dark:text-slate-400 hover:text-cyan-600 dark:hover:text-cyan-400 border border-slate-200 dark:border-slate-600 rounded-lg px-3 py-1.5 hover:border-cyan-300 dark:hover:border-cyan-600 transition-all"
                    title="Download audio file"
                  >
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                    </svg>
                    Download
                  </a>
                </div>
                <div class="flex items-center gap-2">
                  <button
                    type="button"
                    class="audio-seek-btn p-2 rounded-lg bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-600 dark:text-slate-300 transition-colors"
                    data-audio={`audio-${shiur.id}`}
                    data-seek="-30"
                    title="Rewind 30s"
                  >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12.066 11.2a1 1 0 000 1.6l5.334 4A1 1 0 0019 16V8a1 1 0 00-1.6-.8l-5.334 4zM4.066 11.2a1 1 0 000 1.6l5.334 4A1 1 0 0011 16V8a1 1 0 00-1.6-.8l-5.334 4z"/>
                    </svg>
                    <span class="text-[10px] font-semibold">30</span>
                  </button>
                  <button
                    type="button"
                    class="audio-seek-btn p-2 rounded-lg bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-600 dark:text-slate-300 transition-colors"
                    data-audio={`audio-${shiur.id}`}
                    data-seek="-15"
                    title="Rewind 15s"
                  >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12.066 11.2a1 1 0 000 1.6l5.334 4A1 1 0 0019 16V8a1 1 0 00-1.6-.8l-5.334 4zM4.066 11.2a1 1 0 000 1.6l5.334 4A1 1 0 0011 16V8a1 1 0 00-1.6-.8l-5.334 4z"/>
                    </svg>
                    <span class="text-[10px] font-semibold">15</span>
                  </button>
                  <audio
                    id={`audio-${shiur.id}`}
                    controls
                    class="flex-1"
                    preload="metadata"
                    src={shiur.audioFile}
                  >
                    <p class="text-sm text-gray-500">Your browser does not support the audio element.
                      <a href={shiur.audioFile} download class="text-cyan-600 underline">Download audio</a>
                    </p>
                  </audio>
                  <button
                    type="button"
                    class="audio-seek-btn p-2 rounded-lg bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-600 dark:text-slate-300 transition-colors"
                    data-audio={`audio-${shiur.id}`}
                    data-seek="15"
                    title="Forward 15s"
                  >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.933 12.8a1 1 0 000-1.6l-5.334-4A1 1 0 005 8v8a1 1 0 001.6.8l5.334-4zM19.933 12.8a1 1 0 000-1.6l-5.334-4A1 1 0 0013 8v8a1 1 0 001.6.8l5.334-4z"/>
                    </svg>
                    <span class="text-[10px] font-semibold">15</span>
                  </button>
                  <button
                    type="button"
                    class="audio-seek-btn p-2 rounded-lg bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-600 dark:text-slate-300 transition-colors"
                    data-audio={`audio-${shiur.id}`}
                    data-seek="30"
                    title="Forward 30s"
                  >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.933 12.8a1 1 0 000-1.6l-5.334-4A1 1 0 005 8v8a1 1 0 001.6.8l5.334-4zM19.933 12.8a1 1 0 000-1.6l-5.334-4A1 1 0 0013 8v8a1 1 0 001.6.8l5.334-4z"/>
                    </svg>
                    <span class="text-[10px] font-semibold">30</span>
                  </button>
                </div>
              </div>
            ) : (
              <div class="px-6 py-3 border-b border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-900/20">
                <div class="flex items-center gap-2 text-sm text-amber-600 dark:text-amber-500">
                  <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                  </svg>
                  <span class="italic">Recording unavailable — notes are the primary resource for this shiur.</span>
                </div>
              </div>
            )}

            <!-- Video embed (if available) -->
            {embedUrl && (
              <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-700">
                <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-3">Video</p>
                <div class="relative w-full aspect-video rounded-xl overflow-hidden bg-slate-900 shadow-md">
                  <iframe
                    src={embedUrl}
                    class="absolute inset-0 w-full h-full"
                    allowfullscreen
                    title={`Video: ${shiur.title}`}
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  />
                </div>
              </div>
            )}

            <!-- Notes section -->
            {shiur.notesFile && (
              <div class="border-b border-slate-200 dark:border-slate-700">
                <!-- Notes header bar -->
                <div class="flex items-center gap-3 px-6 py-4">
                  <svg class="w-4 h-4 text-cyan-500 dark:text-cyan-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                  </svg>
                  <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide flex-1">Notes</p>
                  <div class="flex items-center gap-2">
                    <a
                      href={shiur.notesFile}
                      download
                      class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-500 dark:text-slate-400 hover:text-cyan-600 dark:hover:text-cyan-400 border border-slate-200 dark:border-slate-600 rounded-lg px-3 py-1.5 hover:border-cyan-300 dark:hover:border-cyan-600 transition-all"
                    >
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                      </svg>
                      Download PDF
                    </a>
                    <button
                      id={`notes-toggle-${shiur.id}`}
                      class="inline-flex items-center gap-1.5 text-xs font-medium text-cyan-600 dark:text-cyan-400 border border-cyan-300 dark:border-cyan-600 rounded-lg px-3 py-1.5 hover:bg-cyan-50 dark:hover:bg-cyan-900/20 transition-all"
                      aria-expanded="true"
                      type="button"
                    >
                      <svg id={`notes-chevron-${shiur.id}`} class="w-3.5 h-3.5 transition-transform rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                      </svg>
                      View Inline
                    </button>
                  </div>
                </div>

                <!-- Key takeaways (summary bullets) -->
                {shiur.notesSummary && shiur.notesSummary.length > 0 && (
                  <div class="px-6 pb-4">
                    <div class="bg-slate-50 dark:bg-slate-900/40 rounded-xl border border-slate-200 dark:border-slate-700 p-4">
                      <p class="text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wide mb-3">Key Takeaways</p>
                      <ul class="space-y-2">
                        {shiur.notesSummary.map(point => (
                          <li class="flex gap-2.5 text-sm text-gray-700 dark:text-gray-300 leading-snug">
                            <span class="text-cyan-500 dark:text-cyan-400 mt-0.5 shrink-0">▸</span>
                            <span>{point}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                )}

                <!-- Links extracted from notes PDF -->
                {(shiur as any).notesLinks && (shiur as any).notesLinks.length > 0 && (
                  <div class="px-6 pb-4">
                    <p class="text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wide mb-3">Links from Notes</p>
                    <div class="space-y-3">
                      {(shiur as any).notesLinks.map((link: any) => {
                        const href = link.resolvedUrl ?? link.url;
                        if (link.type === 'youtube' && link.videoId) {
                          return (
                            <div class="rounded-xl overflow-hidden border border-slate-200 dark:border-slate-700 shadow-sm">
                              <div class="relative w-full aspect-video bg-slate-900">
                                <iframe
                                  src={`https://www.youtube.com/embed/${link.videoId}?rel=0&modestbranding=1`}
                                  class="absolute inset-0 w-full h-full"
                                  allowfullscreen
                                  loading="lazy"
                                  title={link.title}
                                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                />
                              </div>
                              <div class="px-4 py-3 bg-slate-50 dark:bg-slate-900/50 flex items-start justify-between gap-3">
                                <div class="min-w-0">
                                  <p class="text-sm font-medium text-gray-800 dark:text-gray-100 leading-snug">{link.title}</p>
                                  {link.channelName && (
                                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">{link.channelName}</p>
                                  )}
                                  {link.description && (
                                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1 line-clamp-2">{link.description}</p>
                                  )}
                                </div>
                                <a
                                  href={href}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  class="shrink-0 text-xs text-red-600 dark:text-red-400 hover:underline flex items-center gap-1"
                                >
                                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                                  </svg>
                                  YouTube
                                </a>
                              </div>
                            </div>
                          );
                        }

                        // Generic link card
                        const typeLabel = link.type === 'sefaria' ? 'Sefaria'
                          : link.type === 'hebrewbooks' ? 'HebrewBooks'
                          : 'Link';
                        const typeDot = link.type === 'sefaria' ? 'bg-teal-500'
                          : link.type === 'hebrewbooks' ? 'bg-amber-500'
                          : 'bg-sky-500';
                        return (
                          <a
                            href={href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="flex items-start gap-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/40 px-4 py-3 hover:border-cyan-300 dark:hover:border-cyan-700 hover:bg-white dark:hover:bg-slate-800/60 transition-all group"
                          >
                            <span class={`mt-1.5 w-2 h-2 rounded-full shrink-0 ${typeDot}`} />
                            <div class="min-w-0 flex-1">
                              <p class="text-sm font-medium text-gray-800 dark:text-gray-100 group-hover:text-cyan-700 dark:group-hover:text-cyan-300 leading-snug">
                                {link.title || href}
                              </p>
                              {link.description && (
                                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1 line-clamp-2">{link.description}</p>
                              )}
                              <p class="text-xs text-gray-400 dark:text-gray-500 mt-1 truncate">{href}</p>
                            </div>
                            <span class="shrink-0 text-xs font-medium text-gray-400 dark:text-gray-500 mt-0.5">{typeLabel} ↗</span>
                          </a>
                        );
                      })}
                    </div>
                  </div>
                )}

                <!-- Inline PDF viewer (open by default) -->
                <div id={`notes-pdf-${shiur.id}`} class="px-6 pb-5">
                  <div class="rounded-xl overflow-hidden border border-slate-200 dark:border-slate-700 shadow-sm">
                    <div class="flex items-center justify-between bg-slate-100 dark:bg-slate-700 px-4 py-2 border-b border-slate-200 dark:border-slate-600">
                      <span class="text-xs font-medium text-gray-500 dark:text-gray-400">Shiur {shiur.number} Notes</span>
                      <a
                        href={shiur.notesFile}
                        target="_blank"
                        rel="noopener"
                        class="text-xs text-cyan-600 dark:text-cyan-400 hover:underline"
                      >
                        Open in new tab ↗
                      </a>
                    </div>
                    <iframe
                      src={shiur.notesFile}
                      class="w-full h-[750px] bg-white"
                      title={`Shiur ${shiur.number} Notes`}
                    >
                      <div class="p-6 text-center text-sm text-gray-500">
                        Your browser cannot display this PDF.
                        <a href={shiur.notesFile} class="text-cyan-600 underline ml-1" target="_blank">Open in new tab</a>
                      </div>
                    </iframe>
                  </div>
                </div>
              </div>
            )}

            <!-- Easter egg: per-shiur jokes / foods (hidden by default) -->
            {((shiur.jokes?.length ?? 0) > 0 || (shiur.disgracefulFoods?.length ?? 0) > 0) && (
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-0 divide-y sm:divide-y-0 sm:divide-x divide-slate-200 dark:divide-slate-700 border-b border-slate-200 dark:border-slate-700 shiur-easter-egg hidden">
                <div class="px-5 py-4 shiur-jokes">
                  <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-2">
                    😄 Jokes ({shiur.jokes?.length ?? 0})
                  </p>
                  {(shiur.jokes?.length ?? 0) > 0 ? (
                    <ul class="space-y-1.5">
                      {shiur.jokes!.map(j => (
                        <li class="text-xs text-gray-600 dark:text-gray-400">
                          <button
                            class="font-mono text-cyan-600 dark:text-cyan-400 hover:underline mr-1 timestamp-btn"
                            data-audio={`audio-${shiur.id}`}
                            data-seconds={j.timestampSeconds}
                            type="button"
                          >{j.timestamp}</button>
                          {j.text}
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="text-xs text-gray-400 italic">None yet</p>
                  )}
                </div>
                <div class="px-5 py-4 shiur-foods">
                  <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-2">
                    🍽️ Disgraced Foods ({shiur.disgracefulFoods?.length ?? 0})
                  </p>
                  {(shiur.disgracefulFoods?.length ?? 0) > 0 ? (
                    <ul class="space-y-1.5">
                      {shiur.disgracefulFoods!.map(f => (
                        <li class="text-xs text-gray-600 dark:text-gray-400">
                          <button
                            class="font-mono text-cyan-600 dark:text-cyan-400 hover:underline mr-1 timestamp-btn"
                            data-audio={`audio-${shiur.id}`}
                            data-seconds={f.timestampSeconds}
                            type="button"
                          >{f.timestamp}</button>
                          <strong class="text-gray-800 dark:text-gray-200">{f.food}</strong> — {f.context}
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="text-xs text-gray-400 italic">None yet</p>
                  )}
                </div>
              </div>
            )}

            <!-- Transcript -->
            {transcript.length > 0 && (
              <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-700">
                <button
                  id={`toggle-${shiur.id}`}
                  class="flex items-center gap-2 text-sm font-semibold text-gray-700 dark:text-gray-300 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors mb-3"
                  aria-expanded="false"
                  aria-controls={`transcript-${shiur.id}`}
                  type="button"
                >
                  <svg id={`chevron-${shiur.id}`} class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                  Transcript ({transcript.length} paragraphs)
                  {shiur.transcriptFile && (
                    <a
                      href={shiur.transcriptFile}
                      download
                      class="ml-2 text-xs text-cyan-600 dark:text-cyan-400 underline font-normal"
                      onclick="event.stopPropagation()"
                    >↓ .srt</a>
                  )}
                </button>
                <div id={`transcript-${shiur.id}`} class="hidden">
                  <div class="mb-3">
                    <input
                      type="search"
                      id={`search-${shiur.id}`}
                      placeholder="Search transcript…"
                      class="w-full sm:w-64 px-3 py-1.5 text-sm border border-slate-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-cyan-500"
                      data-target={`transcript-body-${shiur.id}`}
                    />
                  </div>
                  <div
                    id={`transcript-body-${shiur.id}`}
                    class="h-96 overflow-y-auto rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 p-4 space-y-3 text-sm leading-relaxed"
                  >
                    {transcript.map(para => (
                      <div class="transcript-para group flex gap-3" data-text={para.text.toLowerCase()}>
                        <button
                          class="timestamp-btn shrink-0 font-mono text-xs text-cyan-600 dark:text-cyan-400 hover:underline pt-0.5"
                          data-audio={`audio-${shiur.id}`}
                          data-seconds={para.startSeconds}
                          type="button"
                        >{para.start}</button>
                        <p class="text-gray-700 dark:text-gray-300">{para.text}</p>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            )}

            <!-- Quiz section -->
            {(shiur as any).quiz && (shiur as any).quiz.length > 0 && (
              <div class="px-6 py-4">
                <button
                  id={`quiz-toggle-${shiur.id}`}
                  class="w-full flex items-center gap-2 text-sm font-semibold text-gray-700 dark:text-gray-300 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors"
                  aria-expanded="false"
                  type="button"
                >
                  <svg id={`quiz-chevron-${shiur.id}`} class="w-4 h-4 transition-transform shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                  <span>Quiz Yourself</span>
                  <span class="text-xs font-normal text-gray-400 dark:text-gray-500 ml-1">({(shiur as any).quiz.length} questions, AI-generated)</span>
                  <span id={`quiz-score-${shiur.id}`} class="ml-auto text-xs font-semibold text-cyan-600 dark:text-cyan-400"></span>
                </button>

                <div id={`quiz-body-${shiur.id}`} class="hidden mt-5 space-y-5">
                  {(shiur as any).quiz.map((q: any, qi: number) => (
                    <div
                      class="quiz-question rounded-xl border border-slate-200 dark:border-slate-700 overflow-hidden"
                      data-shiur={shiur.id}
                      data-qi={qi}
                    >
                      <div class="bg-slate-50 dark:bg-slate-900/50 px-4 py-3 border-b border-slate-200 dark:border-slate-700">
                        <p class="text-sm font-medium text-gray-800 dark:text-gray-100 leading-snug">
                          <span class="text-cyan-500 dark:text-cyan-400 font-bold mr-1.5">{qi + 1}.</span>
                          {q.q}
                        </p>
                      </div>
                      <div class="p-3 space-y-2">
                        {q.options.map((opt: string, oi: number) => (
                          <button
                            type="button"
                            class="quiz-option w-full text-left px-3.5 py-2.5 rounded-lg border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800/50 text-sm text-gray-700 dark:text-gray-300 hover:bg-slate-50 dark:hover:bg-slate-700/50 hover:border-cyan-300 dark:hover:border-cyan-600 transition-all cursor-pointer"
                            data-option={oi}
                            data-correct={q.correct}
                            data-shiur={shiur.id}
                            data-qi={qi}
                          >
                            <span class="font-semibold text-gray-400 dark:text-gray-500 mr-2 text-xs">{['A', 'B', 'C', 'D'][oi]}.</span>
                            {opt}
                          </button>
                        ))}
                        <div class="quiz-explanation hidden mt-2 px-3.5 py-3 rounded-lg bg-sky-50 dark:bg-sky-900/20 border border-sky-200 dark:border-sky-800 text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
                          <span class="font-semibold text-sky-700 dark:text-sky-400 text-xs uppercase tracking-wide block mb-1">Explanation</span>
                          {q.explanation}
                        </div>
                      </div>
                    </div>
                  ))}

                  <div class="flex items-center justify-between pt-1 pb-2">
                    <div id={`quiz-result-${shiur.id}`} class="text-sm text-gray-500 dark:text-gray-400"></div>
                    <button
                      type="button"
                      class="quiz-reset-btn text-xs text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-400 underline"
                      data-shiur={shiur.id}
                    >
                      Reset quiz
                    </button>
                  </div>
                </div>
              </div>
            )}

          </article>
        );
      })}
    </div>

  </main>
</Layout>

<script>
  // Auth
  const isAuthenticated = sessionStorage.getItem('scp_authenticated') === 'true';
  const easterEggUnlocked = sessionStorage.getItem('scp_easter_egg') === 'true';

  if (isAuthenticated) {
    document.getElementById('password-section')?.classList.add('hidden');
    document.getElementById('main-content')?.classList.remove('hidden');
    if (easterEggUnlocked) {
      document.getElementById('running-tallies')?.classList.remove('hidden');
      document.querySelectorAll('.shiur-easter-egg').forEach(el => el.classList.remove('hidden'));
    }
  }

  document.getElementById('password-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const input = document.getElementById('password-input') as HTMLInputElement;
    const error = document.getElementById('password-error');
    if (input.value === 'SCPKINS') {
      sessionStorage.setItem('scp_authenticated', 'true');
      document.getElementById('password-section')?.classList.add('hidden');
      document.getElementById('main-content')?.classList.remove('hidden');
      error?.classList.add('hidden');
    } else {
      error?.classList.remove('hidden');
      input.value = '';
    }
  });

  // Easter egg
  let triggerClicks = 0;
  document.getElementById('easter-egg-trigger')?.addEventListener('click', () => {
    triggerClicks++;
    if (triggerClicks >= 3) {
      sessionStorage.setItem('scp_easter_egg', 'true');
      document.getElementById('running-tallies')?.classList.remove('hidden');
      document.querySelectorAll('.shiur-easter-egg').forEach(el => el.classList.remove('hidden'));
      triggerClicks = 0;
    }
  });

  // Timestamp click → seek audio
  document.querySelectorAll<HTMLButtonElement>('.timestamp-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const audioId = btn.dataset.audio;
      const seconds = parseFloat(btn.dataset.seconds ?? '0');
      if (!audioId) return;
      const audio = document.getElementById(audioId) as HTMLAudioElement | null;
      if (!audio) return;
      audio.currentTime = seconds;
      audio.play();
      audio.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  });

  // Audio seek buttons
  document.querySelectorAll<HTMLButtonElement>('.audio-seek-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const audioId = btn.dataset.audio;
      const seekSeconds = parseFloat(btn.dataset.seek ?? '0');
      if (!audioId) return;
      const audio = document.getElementById(audioId) as HTMLAudioElement | null;
      if (!audio) return;
      audio.currentTime = Math.max(0, Math.min(audio.duration || Infinity, audio.currentTime + seekSeconds));
    });
  });

  // Transcript toggle
  document.querySelectorAll<HTMLButtonElement>('[id^="toggle-"]').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.id.replace('toggle-', '');
      const panel = document.getElementById(`transcript-${id}`);
      const chevron = document.getElementById(`chevron-${id}`);
      if (!panel) return;
      const nowHidden = panel.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', nowHidden ? 'false' : 'true');
      chevron?.classList.toggle('rotate-90', !nowHidden);
    });
  });

  // Transcript search
  document.querySelectorAll<HTMLInputElement>('[id^="search-"]').forEach(input => {
    input.addEventListener('input', () => {
      const q = input.value.toLowerCase().trim();
      const targetId = input.dataset.target;
      if (!targetId) return;
      document.getElementById(targetId)
        ?.querySelectorAll<HTMLElement>('.transcript-para')
        .forEach(para => {
          para.style.display = !q || (para.dataset.text ?? '').includes(q) ? '' : 'none';
        });
    });
  });

  // Notes inline toggle — starts expanded (aria-expanded="true", no 'hidden' class)
  document.querySelectorAll<HTMLButtonElement>('[id^="notes-toggle-"]').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.id.replace('notes-toggle-', '');
      const pdfEl = document.getElementById(`notes-pdf-${id}`);
      const chevron = document.getElementById(`notes-chevron-${id}`);
      if (!pdfEl) return;
      const nowHidden = pdfEl.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', nowHidden ? 'false' : 'true');
      chevron?.classList.toggle('rotate-90', !nowHidden);
      // Update button style to reflect state
      if (nowHidden) {
        btn.classList.remove('text-cyan-600', 'dark:text-cyan-400', 'border-cyan-300', 'dark:border-cyan-600', 'hover:bg-cyan-50', 'dark:hover:bg-cyan-900/20');
        btn.classList.add('text-slate-500', 'dark:text-slate-400', 'border-slate-200', 'dark:border-slate-600', 'hover:text-cyan-600', 'dark:hover:text-cyan-400', 'hover:border-cyan-300', 'dark:hover:border-cyan-600');
      } else {
        btn.classList.add('text-cyan-600', 'dark:text-cyan-400', 'border-cyan-300', 'dark:border-cyan-600', 'hover:bg-cyan-50', 'dark:hover:bg-cyan-900/20');
        btn.classList.remove('text-slate-500', 'dark:text-slate-400', 'border-slate-200', 'dark:border-slate-600', 'hover:text-cyan-600', 'dark:hover:text-cyan-400', 'hover:border-cyan-300', 'dark:hover:border-cyan-600');
        pdfEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
  });

  // Quiz
  const quizState: Record<string, { answered: number; correct: number }> = {};

  function updateQuizScore(shiurId: string, total: number) {
    const state = quizState[shiurId] ?? { answered: 0, correct: 0 };
    const scoreEl = document.getElementById(`quiz-score-${shiurId}`);
    const resultEl = document.getElementById(`quiz-result-${shiurId}`);
    if (scoreEl) {
      scoreEl.textContent = state.answered > 0 ? `${state.correct}/${state.answered}` : '';
    }
    if (resultEl && state.answered === total) {
      const pct = Math.round((state.correct / total) * 100);
      resultEl.textContent = pct === 100
        ? `Perfect score! ${state.correct}/${total}`
        : `${state.correct}/${total} correct (${pct}%)`;
    }
  }

  document.querySelectorAll<HTMLButtonElement>('.quiz-option').forEach(btn => {
    btn.addEventListener('click', () => {
      const shiurId = btn.dataset.shiur!;
      const qi = btn.dataset.qi!;
      const optionIdx = parseInt(btn.dataset.option!);
      const correctIdx = parseInt(btn.dataset.correct!);

      const questionEl = btn.closest('.quiz-question') as HTMLElement;
      if (!questionEl) return;

      // Already answered?
      if (questionEl.dataset.answered === 'true') return;
      questionEl.dataset.answered = 'true';

      const allOptions = questionEl.querySelectorAll<HTMLButtonElement>('.quiz-option');
      const explanationEl = questionEl.querySelector<HTMLElement>('.quiz-explanation');

      // Lock options
      allOptions.forEach(opt => {
        opt.classList.remove('hover:bg-slate-50', 'dark:hover:bg-slate-700/50', 'hover:border-cyan-300', 'dark:hover:border-cyan-600', 'cursor-pointer');
        opt.style.cursor = 'default';
      });

      // Highlight correct answer
      allOptions[correctIdx]?.classList.add(
        'bg-emerald-50', 'dark:bg-emerald-900/20',
        'border-emerald-400', 'dark:border-emerald-500',
        '!text-emerald-800', 'dark:!text-emerald-200'
      );

      // Highlight wrong selection
      if (optionIdx !== correctIdx) {
        btn.classList.add(
          'bg-red-50', 'dark:bg-red-900/20',
          'border-red-400', 'dark:border-red-500',
          '!text-red-800', 'dark:!text-red-200'
        );
      }

      // Show explanation
      explanationEl?.classList.remove('hidden');

      // Update score
      if (!quizState[shiurId]) quizState[shiurId] = { answered: 0, correct: 0 };
      quizState[shiurId].answered++;
      if (optionIdx === correctIdx) quizState[shiurId].correct++;

      const total = document.querySelectorAll(`.quiz-question[data-shiur="${shiurId}"]`).length;
      updateQuizScore(shiurId, total);
    });
  });

  // Quiz toggle
  document.querySelectorAll<HTMLButtonElement>('[id^="quiz-toggle-"]').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.id.replace('quiz-toggle-', '');
      const body = document.getElementById(`quiz-body-${id}`);
      const chevron = document.getElementById(`quiz-chevron-${id}`);
      if (!body) return;
      const nowHidden = body.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', nowHidden ? 'false' : 'true');
      chevron?.classList.toggle('rotate-90', !nowHidden);
    });
  });

  // Quiz reset
  document.querySelectorAll<HTMLButtonElement>('.quiz-reset-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const shiurId = btn.dataset.shiur!;

      document.querySelectorAll<HTMLElement>(`.quiz-question[data-shiur="${shiurId}"]`).forEach(qEl => {
        qEl.dataset.answered = '';
        qEl.querySelectorAll<HTMLButtonElement>('.quiz-option').forEach(opt => {
          opt.classList.remove(
            'bg-emerald-50', 'dark:bg-emerald-900/20', 'border-emerald-400', 'dark:border-emerald-500', '!text-emerald-800', 'dark:!text-emerald-200',
            'bg-red-50', 'dark:bg-red-900/20', 'border-red-400', 'dark:border-red-500', '!text-red-800', 'dark:!text-red-200'
          );
          opt.classList.add('hover:bg-slate-50', 'dark:hover:bg-slate-700/50', 'hover:border-cyan-300', 'dark:hover:border-cyan-600', 'cursor-pointer');
          opt.style.cursor = '';
        });
        qEl.querySelector<HTMLElement>('.quiz-explanation')?.classList.add('hidden');
      });

      quizState[shiurId] = { answered: 0, correct: 0 };
      updateQuizScore(shiurId, document.querySelectorAll(`.quiz-question[data-shiur="${shiurId}"]`).length);
      const resultEl = document.getElementById(`quiz-result-${shiurId}`);
      if (resultEl) resultEl.textContent = '';
    });
  });
</script>
