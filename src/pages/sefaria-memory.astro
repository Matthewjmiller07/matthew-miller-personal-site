    function updateTextInput() {
      var parshaSelect = document.getElementById('parsha-select');
      var textInput = document.getElementById('text-input');
      textInput.value = parshaSelect.value;
      updateAliyahOptions();
    }

    function updateAliyahOptions() {
      var parshaSelect = document.getElementById('parsha-select');
      var aliyahSelect = document.getElementById('aliyah-select');
      var textInput = document.getElementById('text-input');

      if (parshaSelect.selectedIndex === -1) parshaSelect.selectedIndex = 0;

      aliyahSelect.innerHTML = '';

      if (parshaSelect.value) {
        aliyahSelect.disabled = false;
        var selectedParsha = parshas[parshaSelect.options[parshaSelect.selectedIndex].text];
        textInput.value = selectedParsha["Whole Parsha"];

        var wholeParshaOption = document.createElement('option');
        wholeParshaOption.value = selectedParsha["Whole Parsha"];
        wholeParshaOption.textContent = "Whole Parsha";
        aliyahSelect.appendChild(wholeParshaOption);

        Object.keys(selectedParsha).forEach(function(aliyah) {
          if (aliyah !== "Whole Parsha") {
            var option = document.createElement('option');
            option.value = selectedParsha[aliyah];
            option.textContent = aliyah;
            aliyahSelect.appendChild(option);
          }
        });
      } else {
        aliyahSelect.disabled = true;
      }
    }

    function updateTextInputFromAliyah() {
      var aliyahSelect = document.getElementById('aliyah-select');
      var textInput = document.getElementById('text-input');
      textInput.value = aliyahSelect.value;
    }

    // Populate Parsha dropdown
    var parshaSelect = document.getElementById('parsha-select');
    Object.keys(parshas).forEach(function(parshaName) {
      var option = document.createElement('option');
      option.value = parshas[parshaName]["Whole Parsha"];
      option.textContent = parshaName;
      parshaSelect.appendChild(option);
    });

    parshaSelect.addEventListener('change', updateTextInput);
    document.getElementById('aliyah-select').addEventListener('change', updateTextInputFromAliyah);
    updateAliyahOptions();
  </script>

