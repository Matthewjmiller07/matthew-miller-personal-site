  <script define:vars={{ standardPrice: pricing.standard, promoPrice: pricing.promo }}>
    const promoInput = document.getElementById('promo-input');
    const promoApply = document.getElementById('promo-apply');
    const promoHint = document.getElementById('promo-hint');
    const currentPrice = document.getElementById('current-price');
    const promoBadge = document.getElementById('promo-badge');
    const promoMessage = document.getElementById('promo-message');
    const ctaButton = document.getElementById('cta-button');

    function applyPromo() {
      const code = promoInput.value.trim().toLowerCase();
      if (code === 'chezchaya') {
        currentPrice.textContent = '$' + promoPrice;
        currentPrice.classList.add('text-green-600', 'dark:text-green-400');
        promoBadge.classList.remove('hidden');
        promoMessage.classList.remove('hidden');
        promoHint.textContent = 'Partner pricing unlocked!';
        promoHint.classList.add('text-green-600', 'dark:text-green-400');
        ctaButton.href = 'mailto:matthewjmiller07@gmail.com?subject=AI Training Inquiry - Partner Rate (chezchaya)';
        ctaButton.textContent = 'Claim Partner Rate';
      } else if (code === '') {
        promoHint.textContent = 'Please enter a code';
        promoHint.classList.remove('text-green-600', 'dark:text-green-400');
      } else {
        promoHint.textContent = 'Invalid code. Contact for partnership inquiries.';
        promoHint.classList.remove('text-green-600', 'dark:text-green-400');
      }
    }

    promoApply.addEventListener('click', applyPromo);
    promoInput.addEventListener('keypress', (e) => { if (e.key === 'Enter') applyPromo(); });
  </script>
