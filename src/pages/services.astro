---
import Layout from '../layouts/Layout.astro';
import FaceTracker from '../components/FaceTracker.tsx';

const pricing = {
  standard: 2000,
  promo: 1500,
  promoCode: 'CHEZCHAYA'
};
---

<Layout
  title="Services — AI Training & G2 Strategy"
  description="Services from Matthew Miller: AI & Claude training, and G2 Positioning & Answer Engine Optimization (AEO). Former G2 Principal Analyst in AI, Automation, and Analytics."
  image="/og-services.png"
>
  <main class="min-h-screen bg-gradient-to-br from-slate-50 to-blue-50 dark:from-gray-900 dark:to-slate-800">
    <!-- Hero Section -->
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-r from-primary-light/10 to-purple-500/10 dark:from-primary-dark/20 dark:to-purple-500/20"></div>
      <div class="container mx-auto px-4 py-20 relative">
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center gap-2 px-4 py-2 bg-white dark:bg-gray-800 rounded-full shadow-sm mb-8">
            <span class="text-2xl">🤖</span>
            <span class="text-sm font-medium text-gray-600 dark:text-gray-300">AI Training · G2 Strategy · AEO</span>
          </div>

          <h1 class="text-5xl md:text-6xl font-bold text-gray-900 dark:text-white mb-6 leading-tight">
            Services by <span class="text-primary-light dark:text-primary-dark">Matthew Miller</span>
          </h1>

          <p class="text-xl text-gray-600 dark:text-gray-300 mb-8 max-w-2xl mx-auto">
            Former Principal Analyst at G2, specializing in AI, Automation, and Analytics.
            I offer personalized AI training and G2 positioning strategy to help you compete and win.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center flex-wrap">
            <a href="#pricing" class="px-8 py-4 bg-primary-light dark:bg-primary-dark text-white rounded-lg font-semibold hover:bg-primary-dark/80 transition-all shadow-lg hover:shadow-xl">
              AI Training
            </a>
            <a href="#g2-aeo" class="px-8 py-4 bg-gradient-to-r from-indigo-600 to-violet-600 text-white rounded-lg font-semibold hover:from-indigo-700 hover:to-violet-700 transition-all shadow-lg hover:shadow-xl">
              G2 & AEO Strategy
            </a>
            <a href="#web-dev" class="px-8 py-4 bg-white dark:bg-gray-800 text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700 rounded-lg font-semibold hover:bg-gray-50 dark:hover:bg-gray-700 transition-all">
              Web Development
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- What You Get Section -->
    <section class="py-16 bg-white dark:bg-gray-900">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-bold text-center text-gray-900 dark:text-white mb-12">
          What You'll Master
        </h2>

        <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
          <div class="bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-gray-800 dark:to-gray-700 p-8 rounded-2xl">
            <div class="w-12 h-12 bg-blue-500 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Prompt Engineering</h3>
            <ul class="space-y-2 text-gray-600 dark:text-gray-300 text-sm">
              <li>• Chain-of-thought prompting</li>
              <li>• Few-shot & zero-shot techniques</li>
              <li>• Context window optimization</li>
              <li>• System prompt design</li>
              <li>• Claude-specific features (Artifacts, Projects)</li>
            </ul>
          </div>

          <div class="bg-gradient-to-br from-purple-50 to-pink-50 dark:from-gray-800 dark:to-gray-700 p-8 rounded-2xl">
            <div class="w-12 h-12 bg-purple-500 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
