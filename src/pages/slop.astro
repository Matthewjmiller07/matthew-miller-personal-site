---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="The Slop Kitchen"
  description="A cookbook for food that should never exist. TypeSafe's Jev model hunts for the nastiest food combinations, Claude writes a perfectly serious recipe, and FLUX.2 Klein shoots the magazine photo. Then send it to WhatsApp."
>
  <main class="slop">
    <header class="sk-head">
      <div class="sk-kicker">Est. tonight · No refunds</div>
      <h1>The Slop Kitchen</h1>
      <p class="sk-lede">
        Food that should never exist, plated like it belongs in a magazine.
        <a href="https://typesafe.ai" target="_blank" rel="noopener">TypeSafe</a>'s Jev model tastes ten random
        combinations and ranks how revolting each one is (and quietly throws out anything actually unsafe).
        Claude writes the recipe with a straight face. FLUX.2 [klein] takes the photo.
      </p>
    </header>

    <section class="sk-panel">
      <div class="sk-tabs" role="tablist">
        <button type="button" class="sk-tab is-on" data-mode="pantry" role="tab" aria-selected="true">Raid the pantry</button>
        <button type="button" class="sk-tab" data-mode="fridge" role="tab" aria-selected="false">My fridge</button>
      </div>
      <form id="sk-form" class="sk-form" autocomplete="off">
        <div id="sk-fridge" class="sk-fridge" hidden>
          <label for="sk-items">What have you got? (comma separated, at least 2)</label>
          <input id="sk-items" type="text" maxlength="600" placeholder="e.g. tuna, gummy bears, tahini, cornflakes, pickles" />
        </div>
        <button id="sk-go" type="submit" class="sk-go">Find me something vile</button>
      </form>
      <p id="sk-status" class="sk-status" aria-live="polite"></p>
    </section>

    <section id="sk-board" class="sk-board" hidden>
      <h2>Jev's tasting notes</h2>
      <p class="sk-sub">Nastiest first. Pick any combo to cook it.</p>
      <ol id="sk-combos" class="sk-combos"></ol>
      <p id="sk-rejected" class="sk-rejected" hidden></p>
    </section>

    <article id="sk-dish" class="sk-dish" hidden>
      <figure class="sk-photo">
        <div id="sk-photo-wait" class="sk-photo-wait"><span>FLUX is styling the plate…</span></div>
        <img id="sk-img" alt="" hidden />
      </figure>
      <div class="sk-card">
        <div id="sk-combo-line" class="sk-combo-line"></div>
        <h2 id="sk-name"></h2>
        <p id="sk-tagline" class="sk-tagline"></p>
        <p id="sk-meta" class="sk-meta"></p>
        <div class="sk-cols">
          <div>
            <h3>Ingredients</h3>
            <ul id="sk-ingredients"></ul>
          </div>
          <div>
            <h3>Method</h3>
            <ol id="sk-steps"></ol>
          </div>
        </div>
        <p id="sk-note" class="sk-note"></p>
        <div class="sk-actions">
          <button type="button" id="sk-wa" class="sk-wa">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z"/></svg>
            Send to WhatsApp
          </button>
          <button type="button" id="sk-dl" class="sk-ghost">Download recipe card</button>
          <button type="button" id="sk-again" class="sk-ghost">Cook something worse</button>
        </div>
        <p class="sk-fine">Every dish is checked to be safe to eat. Whether you should is between you and your rabbi.</p>
      </div>
    </article>
  </main>
</Layout>

<script>
  const $ = (id) => document.getElementById(id);
  const CRIMES = {
    flavor: 'flavor clash',
    texture: 'texture crime',
    smell: 'olfactory hazard',
    category: 'breaks the laws of dinner',
    nothing: 'suspiciously fine',
  };
  const VERDICTS = ['Pleasant', 'Odd', 'Questionable', 'Gross', 'Abomination'];

  let mode = 'pantry';
  let current = null; // { combo, recipe, image }

  const status = (msg, err = false) => {
    $('sk-status').textContent = msg || '';
    $('sk-status').classList.toggle('is-err', err);
  };
  const el = (tag, cls, text) => {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text != null) n.textContent = text;
    return n;
  };
  const postJSON = async (url, body) => {
    const res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const data = await res.json().catch(() => ({}));
    if (!res.ok || data.error) throw new Error(data.error || `HTTP ${res.status}`);
    return data;
  };

  document.querySelectorAll('.sk-tab').forEach((t) =>
    t.addEventListener('click', () => {
      mode = t.dataset.mode;
      document.querySelectorAll('.sk-tab').forEach((x) => {
        x.classList.toggle('is-on', x === t);
        x.setAttribute('aria-selected', String(x === t));
      });
      $('sk-fridge').hidden = mode !== 'fridge';
      $('sk-go').textContent = mode === 'fridge' ? 'Ruin my fridge' : 'Find me something vile';
    }),
  );

  $('sk-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const body = {};
    if (mode === 'fridge') {
      const items = $('sk-items').value.split(/[,\n]/).map((s) => s.trim()).filter(Boolean);
      if (items.length < 2) return status('Give me at least two ingredients to ruin.', true);
      body.ingredients = items;
    }
    $('sk-go').disabled = true;
    $('sk-dish').hidden = true;
    status('Jev is tasting ten combinations…');
    try {
      const data = await postJSON('/api/slop/combos', body);
      showCombos(data);
      if (!data.combos.length) return status('Jev found nothing safe to cook. Try other ingredients.', true);
      status('');
      cook(data.combos[0]);
    } catch (err) {
      status(`The kitchen is closed: ${err.message}`, true);
    } finally {
      $('sk-go').disabled = false;
    }
  });

  function showCombos({ combos, rejected }) {
    const list = $('sk-combos');
    list.replaceChildren();
    combos.forEach((c, i) => {
      const li = el('li', 'sk-combo');
      const btn = el('button', 'sk-combo-btn');
      btn.type = 'button';
      btn.append(el('span', 'sk-combo-name', c.ingredients.join(' + ')));
      const meter = el('span', 'sk-meter');
      const fill = el('span', 'sk-meter-fill');
      fill.style.width = `${c.nastiness}%`;
      meter.append(fill);
      btn.append(meter);
      btn.append(el('span', 'sk-combo-tag', `${VERDICTS[c.score] || ''} · ${c.nastiness}/100 · ${CRIMES[c.crime] || c.crime}`));
      btn.addEventListener('click', () => cook(c));
      if (i === 0) li.classList.add('is-worst');
      li.append(btn);
      list.append(li);
    });
    $('sk-rejected').hidden = !rejected?.length;
    if (rejected?.length) {
      $('sk-rejected').textContent = `Thrown out as actually unsafe: ${rejected.map((r) => r.join(' + ')).join('; ')}.`;
    }
    $('sk-board').hidden = false;
  }

  async function cook(combo) {
    document.querySelectorAll('.sk-combo').forEach((li, i) => li.classList.toggle('is-cooking', li.querySelector('.sk-combo-name').textContent === combo.ingredients.join(' + ')));
    current = { combo, recipe: null, image: null };
    const mine = current;
    $('sk-dish').hidden = true;
    status(`Claude is writing a recipe for ${combo.ingredients.join(' + ')}…`);
    let recipe;
    try {
      recipe = (await postJSON('/api/slop/recipe', { ingredients: combo.ingredients })).recipe;
    } catch (err) {
      return status(`The chef walked out: ${err.message}`, true);
    }
    if (current !== mine) return;
    mine.recipe = recipe;
    renderRecipe(combo, recipe);
    status('');
    photograph(mine, recipe.photo_prompt || recipe.name);
  }

  function renderRecipe(combo, r) {
    $('sk-combo-line').textContent = `${combo.ingredients.join(' + ')} · Jev: ${combo.nastiness}/100 nasty`;
    $('sk-name').textContent = r.name;
    $('sk-tagline').textContent = r.tagline || '';
    $('sk-meta').textContent = [r.serves && `Serves ${r.serves}`, r.time].filter(Boolean).join(' · ');
    $('sk-ingredients').replaceChildren(...(r.ingredients || []).map((x) => el('li', null, x)));
    $('sk-steps').replaceChildren(...(r.steps || []).map((x) => el('li', null, x)));
    $('sk-note').textContent = r.chef_note ? `Chef's note: ${r.chef_note}` : '';
    $('sk-img').hidden = true;
    $('sk-photo-wait').hidden = false;
    $('sk-photo-wait').querySelector('span').textContent = 'FLUX is styling the plate…';
    $('sk-dish').hidden = false;
    $('sk-dish').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  async function photograph(mine, prompt) {
    try {
      let p = await postJSON('/api/slop/photo', { prompt });
      for (let i = 0; i < 40 && !p.image && !['failed', 'canceled'].includes(p.status); i++) {
        await new Promise((r) => setTimeout(r, 1500));
        const res = await fetch(`/api/slop/photo?id=${encodeURIComponent(p.id)}`);
        p = await res.json();
      }
      if (!p.image) throw new Error(p.error || 'no photo');
      if (current !== mine) return;
      mine.image = p.image;
      const img = $('sk-img');
      img.onload = () => {
        img.hidden = false;
        $('sk-photo-wait').hidden = true;
      };
      img.alt = `Food photograph of ${mine.recipe.name}`;
      img.src = p.image;
    } catch (err) {
      if (current === mine) $('sk-photo-wait').querySelector('span').textContent = `The photographer fainted (${err.message}).`;
    }
  }

  function recipeText({ combo, recipe: r }) {
    return [
      `🍽️ *${r.name}*`,
      `_${r.tagline || ''}_`,
      `(${combo.ingredients.join(' + ')}, rated ${combo.nastiness}/100 nasty by Jev)`,
      '',
      '*Ingredients*',
      ...(r.ingredients || []).map((x) => `• ${x}`),
      '',
      '*Method*',
      ...(r.steps || []).map((x, i) => `${i + 1}. ${x}`),
      '',
      r.chef_note ? `Chef's note: ${r.chef_note}` : '',
      `Cook your own: ${location.origin}/slop`,
    ].filter((l, i, a) => l !== '' || a[i - 1] !== '').join('\n');
  }

  // Recipe card: the photo with the dish name under it, drawn on a canvas so it can be shared as one image.
  async function cardBlob(state) {
    const W = 1080, PH = 1350, FOOT = 330;
    const c = document.createElement('canvas');
    c.width = W;
    c.height = PH + FOOT;
    const g = c.getContext('2d');
    g.fillStyle = '#fff8ec';
    g.fillRect(0, 0, W, PH + FOOT);
    if (state.image) {
      const img = new Image();
      img.crossOrigin = 'anonymous';
      img.src = state.image;
      await img.decode();
      const s = Math.max(W / img.width, PH / img.height);
      g.drawImage(img, (W - img.width * s) / 2, (PH - img.height * s) / 2, img.width * s, img.height * s);
    }
    g.fillStyle = '#b3261e';
    g.fillRect(0, PH, W, 14);
    g.fillStyle = '#2a1a10';
    g.font = '700 64px Georgia, serif';
    const words = state.recipe.name.split(' ');
    const lines = [];
    let line = '';
    for (const w of words) {
      const t = line ? `${line} ${w}` : w;
      if (g.measureText(t).width > W - 120 && line) { lines.push(line); line = w; } else line = t;
    }
    lines.push(line);
    lines.slice(0, 2).forEach((l, i) => g.fillText(l, 60, PH + 100 + i * 74));
    g.font = '32px Georgia, serif';
    g.fillStyle = '#6b4a35';
    g.fillText(`${state.combo.ingredients.join(' + ')} · ${state.combo.nastiness}/100 nasty`, 60, PH + 100 + Math.min(lines.length, 2) * 74 + 20, W - 120);
    g.font = 'italic 28px Georgia, serif';
    g.fillText(`The Slop Kitchen · ${location.host}/slop`, 60, PH + FOOT - 40);
    return new Promise((r) => c.toBlob(r, 'image/jpeg', 0.9));
  }

  $('sk-wa').addEventListener('click', async () => {
    if (!current?.recipe) return;
    const text = recipeText(current);
    // On phones, share the card image plus the recipe straight into WhatsApp's share sheet.
    if (current.image && navigator.canShare) {
      try {
        const blob = await cardBlob(current);
        const file = new File([blob], 'slop-kitchen.jpg', { type: 'image/jpeg' });
        if (navigator.canShare({ files: [file] })) {
          await navigator.share({ files: [file], text, title: current.recipe.name });
          return;
        }
      } catch (err) {
        if (err?.name === 'AbortError') return;
      }
    }
    // Desktop or no file sharing: open WhatsApp with the recipe text.
    window.open(`https://wa.me/?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
  });

  $('sk-dl').addEventListener('click', async () => {
    if (!current?.recipe) return;
    try {
      const blob = await cardBlob(current);
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `${current.recipe.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}.jpg`;
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 2000);
    } catch (err) {
      status(`Could not draw the card: ${err.message}`, true);
    }
  });

  $('sk-again').addEventListener('click', () => $('sk-form').requestSubmit());
</script>

<style is:global>
  /* Global (every class is sk- prefixed) because the combo rows and recipe lists are built in JS. */
  .slop {
    --sk-paper: #fff8ec;
    --sk-ink: #2a1a10;
    --sk-muted: #6b4a35;
    --sk-red: #b3261e;
    --sk-line: #e8d6bd;
    --sk-card: #fffdf8;
    --sk-slime: #7a9a1f;
    max-width: 980px;
    margin: 0 auto;
    padding: 2.5rem 1rem 4rem;
    color: var(--sk-ink);
    font-family: Georgia, 'Times New Roman', serif;
  }
  html.dark .slop {
    --sk-paper: #1d1612;
    --sk-ink: #f3e7d6;
    --sk-muted: #c4a98f;
    --sk-line: #3d2f25;
    --sk-card: #251c16;
  }
  .sk-head { text-align: center; margin-bottom: 1.75rem; }
  .sk-kicker { font: 600 0.75rem/1 system-ui, sans-serif; letter-spacing: 0.18em; text-transform: uppercase; color: var(--sk-red); }
  .sk-head h1 { font-size: clamp(2.4rem, 7vw, 4rem); margin: 0.4rem 0 0.6rem; font-style: italic; letter-spacing: -0.01em; }
  .sk-lede { max-width: 40rem; margin: 0 auto; color: var(--sk-muted); line-height: 1.6; }
  .sk-lede a { color: inherit; text-decoration: underline; }

  .sk-panel, .sk-board { background: var(--sk-card); border: 1px solid var(--sk-line); border-radius: 14px; padding: 1.25rem; margin-bottom: 1.25rem; }
  .sk-tabs { display: flex; gap: 0.5rem; margin-bottom: 1rem; }
  .sk-tab { font: 600 0.9rem system-ui, sans-serif; padding: 0.45rem 0.9rem; border-radius: 999px; border: 1px solid var(--sk-line); background: transparent; color: var(--sk-muted); cursor: pointer; }
  .sk-tab.is-on { background: var(--sk-ink); color: var(--sk-paper); border-color: var(--sk-ink); }
  .sk-form { display: flex; flex-direction: column; gap: 0.75rem; }
  .sk-fridge label { display: block; font: 0.85rem system-ui, sans-serif; color: var(--sk-muted); margin-bottom: 0.35rem; }
  .sk-fridge input { width: 100%; box-sizing: border-box; font: 1rem system-ui, sans-serif; padding: 0.7rem 0.85rem; border: 1px solid var(--sk-line); border-radius: 10px; background: var(--sk-paper); color: var(--sk-ink); }
  .sk-go { font: 700 1.05rem system-ui, sans-serif; padding: 0.85rem 1.2rem; border: 0; border-radius: 10px; background: var(--sk-red); color: #fff; cursor: pointer; }
  .sk-go:disabled { opacity: 0.6; cursor: wait; }
  .sk-status { min-height: 1.2em; margin: 0.75rem 0 0; font: 0.95rem system-ui, sans-serif; color: var(--sk-muted); }
  .sk-status.is-err { color: var(--sk-red); }

  .sk-board h2 { margin: 0; font-size: 1.3rem; }
  .sk-sub { margin: 0.2rem 0 0.9rem; font: 0.85rem system-ui, sans-serif; color: var(--sk-muted); }
  .sk-combos { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
  .sk-combo-btn { width: 100%; text-align: left; display: grid; grid-template-columns: 1fr; gap: 0.3rem; padding: 0.65rem 0.8rem; border: 1px solid var(--sk-line); border-radius: 10px; background: transparent; color: inherit; cursor: pointer; font: inherit; }
  .sk-combo-btn:hover { border-color: var(--sk-red); }
  .sk-combo.is-cooking .sk-combo-btn { border-color: var(--sk-red); box-shadow: inset 4px 0 0 var(--sk-red); }
  .sk-combo-name { font-weight: 700; }
  .sk-combo.is-worst .sk-combo-name::before { content: '☠ '; color: var(--sk-red); }
  .sk-meter { height: 6px; border-radius: 3px; background: var(--sk-line); overflow: hidden; }
  .sk-meter-fill { display: block; height: 100%; background: linear-gradient(90deg, var(--sk-slime), var(--sk-red)); }
  .sk-combo-tag { font: 0.8rem system-ui, sans-serif; color: var(--sk-muted); }
  .sk-rejected { margin: 0.8rem 0 0; font: italic 0.85rem system-ui, sans-serif; color: var(--sk-muted); }

  .sk-dish { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 0; background: var(--sk-card); border: 1px solid var(--sk-line); border-radius: 14px; overflow: hidden; scroll-margin-top: 1rem; }
  .sk-photo { margin: 0; position: relative; aspect-ratio: 4 / 5; background: var(--sk-line); }
  .sk-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .sk-photo-wait { position: absolute; inset: 0; display: grid; place-items: center; text-align: center; padding: 1rem; font: italic 1rem Georgia, serif; color: var(--sk-muted); background: repeating-linear-gradient(45deg, transparent 0 14px, rgba(179, 38, 30, 0.06) 14px 28px); animation: sk-pulse 1.6s ease-in-out infinite; }
  .sk-photo-wait[hidden] { display: none; }
  @keyframes sk-pulse { 50% { opacity: 0.6; } }
  .sk-card { padding: 1.5rem 1.5rem 1.25rem; }
  .sk-combo-line { font: 600 0.75rem system-ui, sans-serif; letter-spacing: 0.08em; text-transform: uppercase; color: var(--sk-red); }
  .sk-card h2 { font-size: clamp(1.6rem, 4vw, 2.2rem); margin: 0.35rem 0 0.4rem; line-height: 1.15; }
  .sk-tagline { font-style: italic; color: var(--sk-muted); margin: 0 0 0.4rem; }
  .sk-meta { font: 0.85rem system-ui, sans-serif; color: var(--sk-muted); margin: 0 0 1rem; }
  .sk-cols { display: grid; grid-template-columns: 1fr; gap: 0.5rem; }
  .sk-card h3 { font: 700 0.8rem system-ui, sans-serif; letter-spacing: 0.12em; text-transform: uppercase; margin: 0.6rem 0 0.4rem; }
  .sk-card ul, .sk-card ol { margin: 0; padding-left: 1.2rem; line-height: 1.55; }
  .sk-card ul { list-style: disc; }
  .sk-card ol { list-style: decimal; }
  .sk-card li { margin-bottom: 0.25rem; }
  .sk-note { margin: 1rem 0 0; padding: 0.75rem 0.9rem; border-left: 3px solid var(--sk-red); background: var(--sk-paper); font-style: italic; }
  .sk-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.25rem; }
  .sk-wa { display: inline-flex; align-items: center; gap: 0.45rem; font: 700 0.95rem system-ui, sans-serif; padding: 0.7rem 1rem; border: 0; border-radius: 10px; background: #25d366; color: #073b1c; cursor: pointer; }
  .sk-ghost { font: 600 0.9rem system-ui, sans-serif; padding: 0.7rem 1rem; border: 1px solid var(--sk-line); border-radius: 10px; background: transparent; color: var(--sk-ink); cursor: pointer; }
  .sk-fine { font: 0.75rem system-ui, sans-serif; color: var(--sk-muted); margin: 1rem 0 0; }

  @media (max-width: 760px) {
    .sk-dish { grid-template-columns: 1fr; }
    .sk-card { padding: 1.1rem; }
  }
</style>
