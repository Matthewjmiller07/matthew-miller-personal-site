---
import Layout from '../layouts/Layout.astro';
import menu from '../data/slop/menu.json';

// Preloaded menu: combos scored by Jev, recipes written by Claude, photos by FLUX.2 [klein] 4B.
// Built with scripts/slop/score.mjs. Live generation (/api/slop/*) is wired up but not on the page yet.
const { dishes, tasting } = menu;
const CRIMES: Record<string, string> = {
  flavor: 'flavor clash',
  texture: 'texture crime',
  smell: 'olfactory hazard',
  category: 'breaks the laws of dinner',
  nothing: 'suspiciously fine',
};
const VERDICTS = ['Pleasant', 'Odd', 'Questionable', 'Gross', 'Abomination'];
const cooked = new Set(dishes.map((d) => [...d.ingredients].sort().join('|')));
---

<Layout
  title="The Slop Kitchen"
  description="A cookbook for food that should never exist. TypeSafe's Jev model tasted 80 food combinations and ranked how revolting each one is, Claude wrote perfectly serious recipes for the worst, and FLUX.2 Klein shot the magazine photos. Send one to WhatsApp."
  image="/slop/harvest-tide-tartine.jpg"
  imageAlt="Sardines and candy corn on sour cream rye toast"
>
  <main class="slop">
    <header class="sk-head">
      <div class="sk-kicker">Est. tonight · No refunds</div>
      <h1>The Slop Kitchen</h1>
      <p class="sk-lede">
        Food that should never exist, plated like it belongs in a magazine.
        <a href="https://typesafe.ai" target="_blank" rel="noopener">TypeSafe</a>'s Jev model tasted {tasting.length}
        random combinations, ranked how revolting each one is, and threw out anything actually unsafe.
        Claude wrote recipes for the worst of them with a straight face. FLUX.2 [klein] took the photos.
      </p>
      <button id="sk-go" type="button" class="sk-go">Serve me something vile</button>
    </header>

    <article id="sk-dish" class="sk-dish" hidden>
      <figure class="sk-photo"><img id="sk-img" alt="" /></figure>
      <div class="sk-card">
        <div id="sk-combo-line" class="sk-combo-line"></div>
        <h2 id="sk-name"></h2>
        <p id="sk-tagline" class="sk-tagline"></p>
        <p id="sk-meta" class="sk-meta"></p>
        <h3>Ingredients</h3>
        <ul id="sk-ingredients"></ul>
        <h3>Method</h3>
        <ol id="sk-steps"></ol>
        <p id="sk-note" class="sk-note"></p>
        <div class="sk-actions">
          <button type="button" id="sk-wa" class="sk-wa">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z"/></svg>
            Send to WhatsApp
          </button>
          <button type="button" id="sk-dl" class="sk-ghost">Download recipe card</button>
          <button type="button" id="sk-again" class="sk-ghost">Something worse</button>
        </div>
        <p class="sk-fine">Jev checked every dish is safe to eat. Whether you should is between you and your rabbi.</p>
      </div>
    </article>

    <section class="sk-menu">
      <h2>The menu</h2>
      <p class="sk-sub">Twelve dishes, nastiest first by Jev's reckoning.</p>
      <ul class="sk-grid">
        {dishes.map((d) => (
          <li>
            <a class="sk-tile" href={`#${d.slug}`} data-slug={d.slug}>
              <img src={d.image} alt={`Food photograph of ${d.name}`} loading="lazy" width="896" height="1088" />
              <span class="sk-tile-score">{d.jev.nastiness}</span>
              <span class="sk-tile-name">{d.name}</span>
              <span class="sk-tile-combo">{d.ingredients.join(' + ')}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="sk-board">
      <details>
        <summary>Jev's tasting notes: all {tasting.length} combinations</summary>
        <p class="sk-sub">How the menu was chosen. Combos marked ✕ were flagged as actually unsafe and thrown out; ★ made the menu.
          A few nasty ones were skipped because they mix meat with dairy.</p>
        <ol class="sk-combos">
          {tasting.map((c) => {
            const isCooked = cooked.has([...c.ingredients].sort().join('|'));
            return (
              <li class:list={['sk-combo', { 'is-unsafe': c.unsafe, 'is-cooked': isCooked }]}>
                <span class="sk-combo-name">{c.unsafe ? '✕ ' : isCooked ? '★ ' : ''}{c.ingredients.join(' + ')}</span>
                <span class="sk-meter"><span class="sk-meter-fill" style={`width:${c.nastiness}%`}></span></span>
                <span class="sk-combo-tag">{VERDICTS[c.score] ?? ''} · {c.nastiness}/100 · {c.unsafe ? 'unsafe' : CRIMES[c.crime] ?? c.crime}</span>
              </li>
            );
          })}
        </ol>
      </details>
    </section>
  </main>
</Layout>

<script define:vars={{ dishes }}>
  const $ = (id) => document.getElementById(id);
  const el = (tag, text) => { const n = document.createElement(tag); n.textContent = text; return n; };
  const bySlug = Object.fromEntries(dishes.map((d) => [d.slug, d]));
  let current = null;

  function show(d, scroll = true) {
    current = d;
    $('sk-img').src = d.image;
    $('sk-img').alt = `Food photograph of ${d.name}`;
    $('sk-combo-line').textContent = `${d.ingredients.join(' + ')} · Jev: ${d.jev.nastiness}/100 nasty`;
    $('sk-name').textContent = d.name;
    $('sk-tagline').textContent = d.tagline;
    $('sk-meta').textContent = `Serves ${d.serves} · ${d.time}`;
    $('sk-ingredients').replaceChildren(...d.recipe.map((x) => el('li', x)));
    $('sk-steps').replaceChildren(...d.steps.map((x) => el('li', x)));
    $('sk-note').textContent = `Chef's note: ${d.chef_note}`;
    $('sk-dish').hidden = false;
    if (location.hash !== `#${d.slug}`) history.replaceState(null, '', `#${d.slug}`);
    if (scroll) $('sk-dish').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  const random = () => {
    const pool = dishes.filter((d) => d !== current);
    show(pool[Math.floor(Math.random() * pool.length)]);
  };

  document.querySelectorAll('.sk-tile').forEach((a) =>
    a.addEventListener('click', (e) => { e.preventDefault(); show(bySlug[a.dataset.slug]); }),
  );
  $('sk-go').addEventListener('click', random);
  $('sk-again').addEventListener('click', random);
  const fromHash = bySlug[location.hash.slice(1)];
  if (fromHash) show(fromHash, true);

  const link = (d) => `${location.origin}/slop#${d.slug}`;
  function recipeText(d) {
    return [
      `🍽️ *${d.name}*`,
      `_${d.tagline}_`,
      `(${d.ingredients.join(' + ')}, rated ${d.jev.nastiness}/100 nasty by Jev)`,
      '',
      '*Ingredients*',
      ...d.recipe.map((x) => `• ${x}`),
      '',
      '*Method*',
      ...d.steps.map((x, i) => `${i + 1}. ${x}`),
      '',
      `Chef's note: ${d.chef_note}`,
      '',
      `Photo and more slop: ${link(d)}`,
    ].join('\n');
  }

  // Recipe card: the photo with the dish name under it, as one image to share or save.
  async function cardBlob(d) {
    const W = 1080, PH = 1312, FOOT = 330;
    const c = document.createElement('canvas');
    c.width = W;
    c.height = PH + FOOT;
    const g = c.getContext('2d');
    g.fillStyle = '#fff8ec';
    g.fillRect(0, 0, W, PH + FOOT);
    const img = new Image();
    img.src = d.image;
    await img.decode();
    const s = Math.max(W / img.width, PH / img.height);
    g.drawImage(img, (W - img.width * s) / 2, (PH - img.height * s) / 2, img.width * s, img.height * s);
    g.fillStyle = '#b3261e';
    g.fillRect(0, PH, W, 14);
    g.fillStyle = '#2a1a10';
    g.font = '700 64px Georgia, serif';
    const lines = [];
    let line = '';
    for (const w of d.name.split(' ')) {
      const t = line ? `${line} ${w}` : w;
      if (g.measureText(t).width > W - 120 && line) { lines.push(line); line = w; } else line = t;
    }
    lines.push(line);
    lines.slice(0, 2).forEach((l, i) => g.fillText(l, 60, PH + 100 + i * 74));
    g.font = '32px Georgia, serif';
    g.fillStyle = '#6b4a35';
    g.fillText(`${d.ingredients.join(' + ')} · ${d.jev.nastiness}/100 nasty`, 60, PH + 120 + Math.min(lines.length, 2) * 74, W - 120);
    g.font = 'italic 28px Georgia, serif';
    g.fillText(`The Slop Kitchen · ${location.host}/slop`, 60, PH + FOOT - 36);
    return new Promise((r) => c.toBlob(r, 'image/jpeg', 0.9));
  }

  $('sk-wa').addEventListener('click', async () => {
    if (!current) return;
    const text = recipeText(current);
    // Phones: share the card image and the recipe through the share sheet, straight into WhatsApp.
    if (navigator.canShare) {
      try {
        const file = new File([await cardBlob(current)], `${current.slug}.jpg`, { type: 'image/jpeg' });
        if (navigator.canShare({ files: [file] })) {
          await navigator.share({ files: [file], text, title: current.name });
          return;
        }
      } catch (err) {
        if (err?.name === 'AbortError') return;
      }
    }
    // Desktop: WhatsApp with the recipe text; the link at the end unfurls to the page.
    window.open(`https://wa.me/?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
  });

  $('sk-dl').addEventListener('click', async () => {
    if (!current) return;
    const a = document.createElement('a');
    a.href = URL.createObjectURL(await cardBlob(current));
    a.download = `${current.slug}.jpg`;
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 2000);
  });
</script>

<style is:global>
  /* Global (every class is sk- prefixed) because the recipe lists are filled in by JS. */
  .slop {
    --sk-paper: #fff8ec;
    --sk-ink: #2a1a10;
    --sk-muted: #6b4a35;
    --sk-red: #b3261e;
    --sk-line: #e8d6bd;
    --sk-card: #fffdf8;
    --sk-slime: #7a9a1f;
    max-width: 1040px;
    margin: 0 auto;
    padding: 2.5rem 1rem 4rem;
    color: var(--sk-ink);
    font-family: Georgia, 'Times New Roman', serif;
  }
  html.dark .slop {
    --sk-paper: #1d1612;
    --sk-ink: #f3e7d6;
    --sk-muted: #c4a98f;
    --sk-line: #3d2f25;
    --sk-card: #251c16;
  }
  .sk-head { text-align: center; margin-bottom: 2rem; }
  .sk-kicker { font: 600 0.75rem/1 system-ui, sans-serif; letter-spacing: 0.18em; text-transform: uppercase; color: var(--sk-red); }
  .sk-head h1 { font-size: clamp(2.4rem, 7vw, 4rem); margin: 0.4rem 0 0.6rem; font-style: italic; letter-spacing: -0.01em; }
  .sk-lede { max-width: 40rem; margin: 0 auto 1.25rem; color: var(--sk-muted); line-height: 1.6; }
  .sk-lede a { color: inherit; text-decoration: underline; }
  .sk-go { font: 700 1.05rem system-ui, sans-serif; padding: 0.85rem 1.6rem; border: 0; border-radius: 10px; background: var(--sk-red); color: #fff; cursor: pointer; }

  .sk-dish { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); background: var(--sk-card); border: 1px solid var(--sk-line); border-radius: 14px; overflow: hidden; margin-bottom: 2rem; scroll-margin-top: 5rem; }
  .sk-dish[hidden] { display: none; }
  .sk-photo { margin: 0; aspect-ratio: 896 / 1088; background: var(--sk-line); }
  .sk-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .sk-card { padding: 1.5rem 1.5rem 1.25rem; }
  .sk-combo-line { font: 600 0.75rem system-ui, sans-serif; letter-spacing: 0.08em; text-transform: uppercase; color: var(--sk-red); }
  .sk-card h2 { font-size: clamp(1.6rem, 4vw, 2.2rem); margin: 0.35rem 0 0.4rem; line-height: 1.15; }
  .sk-tagline { font-style: italic; color: var(--sk-muted); margin: 0 0 0.4rem; }
  .sk-meta { font: 0.85rem system-ui, sans-serif; color: var(--sk-muted); margin: 0 0 0.6rem; }
  .sk-card h3 { font: 700 0.8rem system-ui, sans-serif; letter-spacing: 0.12em; text-transform: uppercase; margin: 0.9rem 0 0.4rem; }
  .sk-card ul, .sk-card ol { margin: 0; padding-left: 1.2rem; line-height: 1.55; }
  .sk-card ul { list-style: disc; }
  .sk-card ol { list-style: decimal; }
  .sk-card li { margin-bottom: 0.25rem; }
  .sk-note { margin: 1rem 0 0; padding: 0.75rem 0.9rem; border-left: 3px solid var(--sk-red); background: var(--sk-paper); font-style: italic; }
  .sk-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.25rem; }
  .sk-wa { display: inline-flex; align-items: center; gap: 0.45rem; font: 700 0.95rem system-ui, sans-serif; padding: 0.7rem 1rem; border: 0; border-radius: 10px; background: #25d366; color: #073b1c; cursor: pointer; }
  .sk-ghost { font: 600 0.9rem system-ui, sans-serif; padding: 0.7rem 1rem; border: 1px solid var(--sk-line); border-radius: 10px; background: transparent; color: var(--sk-ink); cursor: pointer; }
  .sk-fine { font: 0.75rem system-ui, sans-serif; color: var(--sk-muted); margin: 1rem 0 0; }

  .sk-menu h2 { font-size: 1.6rem; margin: 0; font-style: italic; }
  .sk-sub { margin: 0.2rem 0 1rem; font: 0.85rem system-ui, sans-serif; color: var(--sk-muted); }
  .sk-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; }
  .sk-tile { position: relative; display: block; border-radius: 12px; overflow: hidden; background: var(--sk-card); border: 1px solid var(--sk-line); color: inherit; text-decoration: none; transition: transform 0.15s, border-color 0.15s; }
  .sk-tile:hover { transform: translateY(-2px); border-color: var(--sk-red); }
  .sk-tile img { display: block; width: 100%; height: auto; aspect-ratio: 896 / 1088; object-fit: cover; }
  .sk-tile-score { position: absolute; top: 0.6rem; right: 0.6rem; font: 700 0.8rem system-ui, sans-serif; padding: 0.25rem 0.5rem; border-radius: 999px; background: var(--sk-red); color: #fff; }
  .sk-tile-score::before { content: '☠ '; }
  .sk-tile-name { display: block; padding: 0.7rem 0.8rem 0.15rem; font-weight: 700; line-height: 1.25; }
  .sk-tile-combo { display: block; padding: 0 0.8rem 0.8rem; font: 0.8rem system-ui, sans-serif; color: var(--sk-muted); }

  .sk-board { margin-top: 2rem; background: var(--sk-card); border: 1px solid var(--sk-line); border-radius: 14px; padding: 1rem 1.25rem; }
  .sk-board summary { cursor: pointer; font-weight: 700; font-size: 1.1rem; }
  .sk-board .sk-sub { margin-top: 0.75rem; }
  .sk-combos { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 0.5rem 1.25rem; }
  .sk-combo { display: grid; gap: 0.25rem; padding: 0.45rem 0; border-bottom: 1px solid var(--sk-line); }
  .sk-combo-name { font-weight: 700; font-size: 0.95rem; }
  .sk-combo.is-unsafe { opacity: 0.55; }
  .sk-combo.is-unsafe .sk-combo-name { text-decoration: line-through; }
  .sk-combo.is-cooked .sk-combo-name { color: var(--sk-red); }
  .sk-meter { height: 5px; border-radius: 3px; background: var(--sk-line); overflow: hidden; }
  .sk-meter-fill { display: block; height: 100%; background: linear-gradient(90deg, var(--sk-slime), var(--sk-red)); }
  .sk-combo-tag { font: 0.75rem system-ui, sans-serif; color: var(--sk-muted); }

  @media (max-width: 760px) {
    .sk-dish { grid-template-columns: 1fr; }
    .sk-card { padding: 1.1rem; }
    .sk-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; }
    .sk-tile-name { font-size: 0.9rem; }
  }
</style>
