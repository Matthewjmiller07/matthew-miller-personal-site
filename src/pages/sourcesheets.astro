---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Source Sheets | The Other Matthew Miller"
  description="Collection of Jewish source sheets on various topics"
>
  <main class="min-h-screen bg-gray-50 dark:bg-gray-900 py-12">
    <div class="max-w-4xl mx-auto px-4">
      <header class="text-center mb-12">
        <h1 class="text-4xl font-bold text-cyan-600 dark:text-cyan-400 mb-4">Source Sheets</h1>
        <p class="text-lg text-gray-600 dark:text-gray-400">A collection of Jewish source sheets on various topics</p>
      </header>

      <div class="grid md:grid-cols-2 gap-8">
        <!-- Memory Source Sheet -->
        <div class="bg-white dark:bg-gray-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="p-6">
            <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-3">On Memory and Forgetting</h2>
            <p class="text-gray-600 dark:text-gray-300 mb-4">
              Exploring the Jewish perspective on memory, forgetting, and the divine nature of remembrance.
            </p>
            <div class="flex flex-wrap gap-3">
              <a 
                href="/memory" 
                class="px-4 py-2 bg-cyan-600 hover:bg-cyan-700 text-white rounded-md transition-colors"
              >
                View Online
              </a>
              <a 
                href="/Source%20Sheets/Memory.pdf" 
                class="px-4 py-2 border border-cyan-600 text-cyan-600 dark:text-cyan-400 hover:bg-cyan-50 dark:hover:bg-gray-700 rounded-md transition-colors"
                download="Memory.pdf"
              >
                Download PDF
              </a>
            </div>
          </div>
        </div>

        <!-- Language Source Sheet -->
        <div class="bg-white dark:bg-gray-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="p-6">
            <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-3">On Language and Speech</h2>
            <p class="text-gray-600 dark:text-gray-300 mb-4">
              Examining the nature of language, naming, and speech in Jewish thought from Torah to modernity.
            </p>
            <div class="flex flex-wrap gap-3">
              <a 
                href="/language" 
                class="px-4 py-2 bg-cyan-600 hover:bg-cyan-700 text-white rounded-md transition-colors"
              >
                View Online
              </a>
              <a 
                href="/Source%20Sheets/Language.pdf" 
                class="px-4 py-2 border border-cyan-600 text-cyan-600 dark:text-cyan-400 hover:bg-cyan-50 dark:hover:bg-gray-700 rounded-md transition-colors"
                download="Language.pdf"
              >
                Download PDF
              </a>
            </div>
          </div>
        </div>

        <!-- Pistachios Source Sheet -->
        <div class="bg-white dark:bg-gray-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="p-6">
            <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-3">On Pistachios</h2>
            <p class="text-gray-600 dark:text-gray-300 mb-4">
              A comprehensive source sheet examining pistachios through Jewish texts - from biblical references to modern halachic discussions on kashrut, agriculture, and contemporary applications.
            </p>
            <div class="flex flex-wrap gap-3">
              <a 
                href="/pistachios" 
                class="px-4 py-2 bg-cyan-600 hover:bg-cyan-700 text-white rounded-md transition-colors"
              >
                View Online
              </a>
            </div>
          </div>
        </div>

        <!-- Rav Nachman Source Sheet -->
        <div class="bg-white dark:bg-gray-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="p-6">
            <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-1">Likutei Moharan</h2>
            <p class="text-sm text-gray-400 dark:text-gray-500 mb-3 font-hebrew">ליקוטי מוהר״ן — Rebbe Nachman of Breslov</p>
            <p class="text-gray-600 dark:text-gray-300 mb-4">
              An annotated analysis of Likutei Moharan examining Rebbe Nachman's nuanced stance on intellect, external wisdom, and faith — exploring whether "anti-intellectual" captures his actual teaching.
            </p>
            <div class="flex flex-wrap gap-3">
              <a
                href="/rav-nachman"
                class="px-4 py-2 bg-cyan-600 hover:bg-cyan-700 text-white rounded-md transition-colors"
              >
                View Online
              </a>
              <a
                href="/Rav%20Nachman/likutei_moharan_annotated.pdf"
                class="px-4 py-2 border border-cyan-600 text-cyan-600 dark:text-cyan-400 hover:bg-cyan-50 dark:hover:bg-gray-700 rounded-md transition-colors"
                download="likutei_moharan_annotated.pdf"
              >
                Download PDF
              </a>
            </div>
          </div>
        </div>

        <!-- Yom Tov Sheini -->
        <div class="bg-white dark:bg-gray-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="p-6">
            <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-1">Yom Tov Sheini Shel Galuyot</h2>
            <p class="text-sm text-gray-400 dark:text-gray-500 mb-3 font-hebrew">יום טוב שני של גלויות</p>
            <p class="text-gray-600 dark:text-gray-300 mb-4">
              A comprehensive analysis of the major halachic debates surrounding Yom Tov Sheini — especially whether Israelis must observe the second day in the diaspora and vice versa — drawing on 17 transcribed shiurim from leading contemporary poskim.
            </p>
            <div class="flex flex-wrap gap-3">
              <a
                href="/yom-tov-sheini"
                class="px-4 py-2 bg-cyan-600 hover:bg-cyan-700 text-white rounded-md transition-colors"
              >
                View Online
              </a>
            </div>
          </div>
        </div>

        <!-- Coffee in Judaism Source Sheet -->
        <div class="bg-white dark:bg-gray-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="p-6">
            <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-1">Coffee in Judaism</h2>
            <p class="text-sm text-gray-400 dark:text-gray-500 mb-3 font-hebrew">קאווע</p>
            <p class="text-gray-600 dark:text-gray-300 mb-4">
              A living source sheet on four centuries of coffee in halacha — berachot, Shabbat, Pesach, bishul akum, coffee before davening, and chassidut — rendered live from a growing database of sources from Sefaria, Hakirah, and OU Kosher.
            </p>
            <div class="flex flex-wrap gap-3">
              <a
                href="/coffee"
                class="px-4 py-2 bg-cyan-600 hover:bg-cyan-700 text-white rounded-md transition-colors"
              >
                View Online
              </a>
            </div>
          </div>
        </div>

        <!-- Stiff-Necked People Source Sheet -->
        <div class="bg-white dark:bg-gray-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="p-6">
            <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-3">Stiff-Necked People</h2>
            <p class="text-gray-600 dark:text-gray-300 mb-4">
              A study of <span class="font-hebrew">קְשֵׁה-עֹרֶף</span> in Exodus 32:9 — exploring how six English translations render this vivid Hebrew idiom, with word-by-word analysis and context.
            </p>
            <div class="flex flex-wrap gap-3">
              <a 
                href="/stiff-necked-people" 
                class="px-4 py-2 bg-cyan-600 hover:bg-cyan-700 text-white rounded-md transition-colors"
              >
                View Online
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-12 text-center">
        <p class="text-gray-500 dark:text-gray-400">
          More source sheets coming soon...
        </p>
      </div>
    </div>
  </main>
</Layout>

<style>
  /* Add any custom styles here if needed */
</style>
