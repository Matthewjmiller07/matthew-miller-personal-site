---
import Layout from '../layouts/Layout.astro';

// Coffee in Halacha series — print-ready sheets generated from the live coffee DB
const coffeeSheets = [
  { n: 1, slug: 'brachot', he: 'בִּרְכַּת הַקָּפֶה', en: 'The Blessing on Coffee' },
  { n: 2, slug: 'shabbat', he: 'קָפֶה בְּשַׁבָּת', en: 'Making Coffee on Shabbat' },
  { n: 3, slug: 'chamar-medina', he: 'חֲמַר מְדִינָה', en: 'Chamar Medina — Kiddush & Havdalah' },
  { n: 4, slug: 'bishul-akum', he: 'בִּשּׁוּל עַכּוּ״ם', en: 'Bishul Akum & the Kosher Cup' },
  { n: 5, slug: 'coffee-out', he: 'קָפֶה בַּחוּץ', en: 'Coffee Out — Marit Ayin & the Café' },
  { n: 6, slug: 'pesach-yomtov', he: 'קָפֶה בְּפֶסַח', en: 'Coffee on Pesach & Yom Tov' },
  { n: 7, slug: 'tefillah', he: 'קָפֶה וּתְפִלָּה', en: 'Coffee & Prayer' },
  { n: 8, slug: 'home', he: 'קָפֶה בַּבַּיִת', en: 'Coffee in the Jewish Home' },
  { n: 9, slug: 'history', he: 'הַקָּפֶה בְּבֵית הַמִּדְרָשׁ', en: 'How Coffee Entered the Literature' },
];
const csBase = (sh: (typeof coffeeSheets)[number]) =>
  `/coffee-sheets/sheets/${String(sh.n).padStart(2, '0')}-${sh.slug}`;
const csPdf = (sh: (typeof coffeeSheets)[number], student = false) =>
  `/coffee-sheets/pdf/${String(sh.n).padStart(2, '0')}-${sh.slug}${student ? '-student' : ''}.pdf`;
---

<Layout 
  title="Source Sheets | The Other Matthew Miller"
  description="Collection of Jewish source sheets on various topics"
>
  <main class="min-h-screen bg-gray-50 dark:bg-gray-900 py-12">
    <div class="max-w-4xl mx-auto px-4">
      <header class="text-center mb-12">
        <h1 class="text-4xl font-bold text-cyan-600 dark:text-cyan-400 mb-4">Source Sheets</h1>
        <p class="text-lg text-gray-600 dark:text-gray-400">A collection of Jewish source sheets on various topics</p>
      </header>

      <div class="grid md:grid-cols-2 gap-8">
        <!-- Memory Source Sheet -->
        <div class="bg-white dark:bg-gray-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="p-6">
            <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-3">On Memory and Forgetting</h2>
            <p class="text-gray-600 dark:text-gray-300 mb-4">
              Exploring the Jewish perspective on memory, forgetting, and the divine nature of remembrance.
            </p>
            <div class="flex flex-wrap gap-3">
              <a 
                href="/memory" 
                class="px-4 py-2 bg-cyan-600 hover:bg-cyan-700 text-white rounded-md transition-colors"
              >
                View Online
              </a>
              <a 
                href="/Source%20Sheets/Memory.pdf" 
                class="px-4 py-2 border border-cyan-600 text-cyan-600 dark:text-cyan-400 hover:bg-cyan-50 dark:hover:bg-gray-700 rounded-md transition-colors"
                download="Memory.pdf"
              >
                Download PDF
              </a>
            </div>
          </div>
        </div>

        <!-- Language Source Sheet -->
        <div class="bg-white dark:bg-gray-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="p-6">
            <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-3">On Language and Speech</h2>
            <p class="text-gray-600 dark:text-gray-300 mb-4">
              Examining the nature of language, naming, and speech in Jewish thought from Torah to modernity.
            </p>
            <div class="flex flex-wrap gap-3">
              <a 
                href="/language" 
                class="px-4 py-2 bg-cyan-600 hover:bg-cyan-700 text-white rounded-md transition-colors"
              >
                View Online
              </a>
              <a 
                href="/Source%20Sheets/Language.pdf" 
                class="px-4 py-2 border border-cyan-600 text-cyan-600 dark:text-cyan-400 hover:bg-cyan-50 dark:hover:bg-gray-700 rounded-md transition-colors"
                download="Language.pdf"
              >
                Download PDF
              </a>
            </div>
          </div>
        </div>

        <!-- Pistachios Source Sheet -->
        <div class="bg-white dark:bg-gray-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="p-6">
            <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-3">On Pistachios</h2>
            <p class="text-gray-600 dark:text-gray-300 mb-4">
              A comprehensive source sheet examining pistachios through Jewish texts - from biblical references to modern halachic discussions on kashrut, agriculture, and contemporary applications.
            </p>
            <div class="flex flex-wrap gap-3">
              <a 
                href="/pistachios" 
                class="px-4 py-2 bg-cyan-600 hover:bg-cyan-700 text-white rounded-md transition-colors"
              >
                View Online
              </a>
            </div>
          </div>
        </div>

        <!-- Rav Nachman Source Sheet -->
        <div class="bg-white dark:bg-gray-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="p-6">
            <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-1">Likutei Moharan</h2>
            <p class="text-sm text-gray-400 dark:text-gray-500 mb-3 font-hebrew">ליקוטי מוהר״ן — Rebbe Nachman of Breslov</p>
            <p class="text-gray-600 dark:text-gray-300 mb-4">
              An annotated analysis of Likutei Moharan examining Rebbe Nachman's nuanced stance on intellect, external wisdom, and faith — exploring whether "anti-intellectual" captures his actual teaching.
            </p>
            <div class="flex flex-wrap gap-3">
              <a
                href="/rav-nachman"
                class="px-4 py-2 bg-cyan-600 hover:bg-cyan-700 text-white rounded-md transition-colors"
              >
                View Online
              </a>
              <a
                href="/Rav%20Nachman/likutei_moharan_annotated.pdf"
                class="px-4 py-2 border border-cyan-600 text-cyan-600 dark:text-cyan-400 hover:bg-cyan-50 dark:hover:bg-gray-700 rounded-md transition-colors"
                download="likutei_moharan_annotated.pdf"
              >
                Download PDF
              </a>
            </div>
          </div>
        </div>

        <!-- Yom Tov Sheini -->
        <div class="bg-white dark:bg-gray-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="p-6">
            <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-1">Yom Tov Sheini Shel Galuyot</h2>
            <p class="text-sm text-gray-400 dark:text-gray-500 mb-3 font-hebrew">יום טוב שני של גלויות</p>
            <p class="text-gray-600 dark:text-gray-300 mb-4">
              A comprehensive analysis of the major halachic debates surrounding Yom Tov Sheini — especially whether Israelis must observe the second day in the diaspora and vice versa — drawing on 17 transcribed shiurim from leading contemporary poskim.
            </p>
            <div class="flex flex-wrap gap-3">
              <a
                href="/yom-tov-sheini"
                class="px-4 py-2 bg-cyan-600 hover:bg-cyan-700 text-white rounded-md transition-colors"
              >
                View Online
              </a>
            </div>
          </div>
        </div>

        <!-- Coffee in Halacha — series -->
        <div class="md:col-span-2 bg-white dark:bg-gray-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="p-6">
            <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
              <h2 class="text-2xl font-bold text-gray-800 dark:text-white">Coffee in Halacha</h2>
              <span class="text-sm font-semibold uppercase tracking-widest text-amber-600 dark:text-amber-400">A nine-sheet series</span>
            </div>
            <p class="text-sm text-gray-400 dark:text-gray-500 mb-3 font-hebrew">קָפֶה בַּהֲלָכָה · קאווע</p>
            <p class="text-gray-600 dark:text-gray-300 mb-4">
              Four centuries of coffee in halacha, brewed from a living database into nine print-ready
              source sheets — original texts with translation and linked citations. Each sheet comes in a
              full <em>teacher's edition</em> and a two-page <em>student handout</em> with the key questions,
              core texts, and discussion points.
            </p>
            <div class="flex flex-wrap gap-3 mb-6">
              <a
                href="/coffee"
                class="px-4 py-2 bg-cyan-600 hover:bg-cyan-700 text-white rounded-md transition-colors"
              >
                Live Source Sheet
              </a>
              <a
                href="/coffee-sheets/"
                class="px-4 py-2 border border-cyan-600 text-cyan-600 dark:text-cyan-400 hover:bg-cyan-50 dark:hover:bg-gray-700 rounded-md transition-colors"
              >
                Series Index
              </a>
            </div>
            <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
              {coffeeSheets.map((sh) => (
                <li class="rounded-md border border-gray-200 dark:border-gray-700 p-3">
                  <p class="text-xs uppercase tracking-widest text-amber-600 dark:text-amber-400 mb-0.5">Sheet {sh.n}</p>
                  <a href={`${csBase(sh)}.html`} class="block font-hebrew text-lg text-gray-800 dark:text-white hover:text-cyan-600 dark:hover:text-cyan-400" dir="rtl" lang="he">{sh.he}</a>
                  <a href={`${csBase(sh)}.html`} class="block font-semibold text-sm text-gray-700 dark:text-gray-200 hover:text-cyan-600 dark:hover:text-cyan-400 mb-1.5">{sh.en}</a>
                  <p class="text-xs text-gray-500 dark:text-gray-400 flex flex-wrap gap-x-2">
                    <a class="underline hover:text-cyan-600 dark:hover:text-cyan-400" href={`${csBase(sh)}.html`}>Read</a>
                    <a class="underline hover:text-cyan-600 dark:hover:text-cyan-400" href={csPdf(sh)}>PDF</a>
                    <a class="underline hover:text-cyan-600 dark:hover:text-cyan-400" href={`${csBase(sh)}-student.html`}>Student</a>
                    <a class="underline hover:text-cyan-600 dark:hover:text-cyan-400" href={csPdf(sh, true)}>Student PDF</a>
                  </p>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Stiff-Necked People Source Sheet -->
        <div class="bg-white dark:bg-gray-800 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="p-6">
            <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-3">Stiff-Necked People</h2>
            <p class="text-gray-600 dark:text-gray-300 mb-4">
              A study of <span class="font-hebrew">קְשֵׁה-עֹרֶף</span> in Exodus 32:9 — exploring how six English translations render this vivid Hebrew idiom, with word-by-word analysis and context.
            </p>
            <div class="flex flex-wrap gap-3">
              <a 
                href="/stiff-necked-people" 
                class="px-4 py-2 bg-cyan-600 hover:bg-cyan-700 text-white rounded-md transition-colors"
              >
                View Online
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-12 text-center">
        <p class="text-gray-500 dark:text-gray-400">
          More source sheets coming soon...
        </p>
      </div>
    </div>
  </main>
</Layout>

<style>
  /* Add any custom styles here if needed */
</style>
