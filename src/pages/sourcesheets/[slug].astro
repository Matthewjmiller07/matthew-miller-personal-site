---
// A source sheet rendered live from Supabase (source_sheets + source_sheet_sources).
// Add or reorder sources in the database and the page updates on the next request.
import Layout from '../../layouts/Layout.astro';
import { getSheet, parseYouTube, sefariaUrl, type SheetSource } from '../../lib/sourcesheets';

export const prerender = false;

const sheet = await getSheet(Astro.params.slug ?? '');
if (!sheet) return Astro.redirect('/sourcesheets', 302);

// Group consecutive sources under their section heading.
const sections: { title: string | null; sources: SheetSource[] }[] = [];
for (const src of sheet.sources ?? []) {
  const last = sections[sections.length - 1];
  if (last && last.title === src.section) last.sources.push(src);
  else sections.push({ title: src.section, sources: [src] });
}
let n = 0;

// Render http(s) URLs in notes as clickable links; everything else HTML-escaped.
function linkify(text: string): string {
  const esc = text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
  return esc.replace(/(https?:\/\/[^\s<)"]+)/g, (url) => {
    const clean = url.replace(/[.,;:!?]+$/, '');
    const trail = url.slice(clean.length);
    return `<a href="${clean}" target="_blank" rel="noopener">${clean}</a>${trail}`;
  });
}

// Highlight ==marked== spans in source text; everything else HTML-escaped.
function renderRich(text: string): string {
  const esc = text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
  return esc.replace(/==(.+?)==/g, '<mark>$1</mark>');
}

// Sources tagged not-on-sefaria (e.g. research papers) get no Sefaria ref link.
const onSefaria = (src: SheetSource) => !(src.tags ?? []).includes('not-on-sefaria');

// Original-text language: Hebrew (RTL) by default; a lang:XX tag (e.g. lang:de)
// renders it left-to-right in a Latin serif face instead.
const srcLang = (src: SheetSource) => {
  const t = (src.tags ?? []).find((t) => t.startsWith('lang:'));
  return t ? t.slice(5) : 'he';
};
---

<Layout title={sheet.title} description={sheet.subtitle ?? sheet.intro ?? `A source sheet: ${sheet.title}`}>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;700&family=Crimson+Pro:ital,wght@0,400;0,600;1,400&display=swap"
    rel="stylesheet"
  />

  <main class="ss">
    <a class="ss-back" href="/sourcesheets">← All source sheets</a>
    <header class="ss-head">
      {sheet.title_he && <p class="ss-title-he" dir="rtl" lang="he">{sheet.title_he}</p>}
      <h1>{sheet.title}</h1>
      {sheet.subtitle && <p class="ss-sub">{sheet.subtitle}</p>}
      {sheet.intro && <p class="ss-intro">{sheet.intro}</p>}
      <button class="ss-print" type="button" onclick="window.print()">Print sheet</button>
    </header>

    {sections.map((sec) => (
      <section>
        {sec.title && <h2 class="ss-section">{sec.title}</h2>}
        {sec.sources.map((src) => (
          <article class="ss-source">
            <p class="ss-ref">
              <span class="ss-num">{++n}</span>
              {src.author && src.author !== src.ref ? (
                <>
                  <span class="ss-author">{src.author}</span>
                  {onSefaria(src) ? (
                    <a class="ss-ref-link" href={sefariaUrl(src.ref)} target="_blank" rel="noopener">{src.ref}</a>
                  ) : (
                    <span class="ss-ref-text">{src.ref}</span>
                  )}
                </>
              ) : onSefaria(src) ? (
                <a class="ss-author" href={sefariaUrl(src.ref)} target="_blank" rel="noopener">{src.ref}</a>
              ) : (
                <span class="ss-author">{src.ref}</span>
              )}
            </p>
            <div class="ss-texts">
              {src.he_text && (
                <p
                  class:list={['ss-he', { 'ss-src-ltr': srcLang(src) !== 'he' }]}
                  dir={srcLang(src) === 'he' ? 'rtl' : 'ltr'}
                  lang={srcLang(src)}
                  set:html={renderRich(src.he_text)}
                />
              )}
              {src.en_text && <p class="ss-en" set:html={renderRich(src.en_text)} />}
            </div>
            {(() => {
              const yt = parseYouTube(src.video_url, src.video_start);
              if (!yt) return null;
              const q = yt.start ? `&start=${yt.start}` : '';
              return (
                <div class="ss-video">
                  <div class="ss-frame">
                    <iframe
                      src={`https://www.youtube-nocookie.com/embed/${yt.id}?rel=0${q}`}
                      title={`Video: ${src.ref}`}
                      loading="lazy"
                      allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
                      allowfullscreen
                    ></iframe>
                  </div>
                  <a class="ss-video-print" href={`https://youtu.be/${yt.id}`}>https://youtu.be/{yt.id}</a>
                  {src.video_summary && <p class="ss-vsum">{src.video_summary}</p>}
                  {src.video_transcript && (
                    <details class="ss-vtrans">
                      <summary>Transcript</summary>
                      <p>{src.video_transcript}</p>
                    </details>
                  )}
                </div>
              );
            })()}
            {src.note && <p class="ss-note" set:html={linkify(src.note)} />}
          </article>
        ))}
      </section>
    ))}

    {!sheet.sources?.length && <p class="ss-intro">Sources are on their way.</p>}
  </main>
</Layout>

<style>
  .ss {
    --ink: #1f2933; --muted: #5f6b76; --line: #e3ddd0; --paper: #fffdf8; --accent: #0e7490;
    max-width: 880px; margin: 0 auto; padding: 40px 16px 80px; color: var(--ink);
    font-family: 'Crimson Pro', Georgia, serif; font-size: 1.15rem; line-height: 1.6;
  }
  :global(.dark) .ss { --ink: #ece7da; --muted: #a8a294; --line: #3a372f; --paper: #1d1b16; --accent: #22d3ee; }
  .ss-back { color: var(--accent); font-size: .95rem; text-decoration: none; }
  .ss-head { text-align: center; margin: 24px 0 40px; }
  .ss-title-he { font-family: 'Frank Ruhl Libre', serif; font-size: 1.6rem; color: var(--muted); margin: 0; }
  .ss h1 { font-size: 2.6rem; font-weight: 600; margin: 4px 0 8px; color: var(--accent); }
  .ss-sub { font-style: italic; font-size: 1.25rem; margin: 0 0 12px; }
  .ss-intro { color: var(--muted); max-width: 640px; margin: 0 auto 16px; }
  .ss-print { font: inherit; font-size: .95rem; border: 1px solid var(--accent); color: var(--accent); background: none; border-radius: 6px; padding: 4px 14px; cursor: pointer; }
  .ss-section { font-size: 1.1rem; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); border-bottom: 1px solid var(--line); padding-bottom: 6px; margin: 32px 0 16px; }
  .ss-source { background: var(--paper); border: 1px solid var(--line); border-radius: 8px; padding: 16px 20px; margin-bottom: 18px; break-inside: avoid; }
  .ss-ref { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px; margin: 0 0 10px; }
  .ss-num { display: inline-grid; place-items: center; min-width: 1.6em; height: 1.6em; border-radius: 50%; background: var(--accent); color: #fff; font-size: .85rem; font-weight: 600; }
  .ss-author { font-weight: 600; font-size: 1.25rem; color: var(--ink); text-decoration: none; }
  a.ss-author:hover { text-decoration: underline; }
  .ss-ref-link, .ss-ref-text { color: var(--muted); font-weight: 400; font-size: .95rem; }
  .ss-ref-link { text-decoration: none; }
  .ss-ref-link:hover { text-decoration: underline; }
  .ss-texts { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .ss-texts > :only-child { grid-column: 1 / -1; }
  .ss-he { font-family: 'Frank Ruhl Libre', serif; font-size: 1.3rem; line-height: 1.75; margin: 0; }
  .ss-src-ltr { font-family: 'Crimson Pro', Georgia, serif; font-size: 1.15rem; line-height: 1.6; }
  .ss-en { margin: 0; }
  .ss-texts mark { background: #fef08a; color: inherit; padding: 0 2px; border-radius: 2px; }
  :global(.dark) .ss-texts mark { background: #713f12; }
  .ss-note { margin: 12px 0 0; padding-top: 10px; border-top: 1px dashed var(--line); color: var(--muted); font-style: italic; }
  .ss-note a { color: var(--accent); }
  .ss-video { margin-top: 14px; }
  .ss-frame { position: relative; aspect-ratio: 16 / 9; border-radius: 6px; overflow: hidden; background: #000; }
  .ss-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .ss-video-print { display: none; }
  .ss-vsum { margin: 10px 0 0; }
  .ss-vtrans { margin-top: 8px; color: var(--muted); font-size: 1rem; }
  .ss-vtrans summary { cursor: pointer; color: var(--accent); }
  .ss-vtrans p { white-space: pre-wrap; margin: 8px 0 0; max-height: 18rem; overflow-y: auto; }
  @media (max-width: 640px) {
    .ss-texts { grid-template-columns: 1fr; gap: 12px; }
    .ss h1 { font-size: 2rem; }
  }
  @media print {
    .ss-back, .ss-print, .ss-frame, .ss-vtrans { display: none; }
    .ss-video-print { display: block; }
    .ss { padding: 0; }
    .ss-source { border-color: #ccc; }
  }
</style>
