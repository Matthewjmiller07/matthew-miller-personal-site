---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Stiff-Necked People | The Other Matthew Miller"
  description="A source sheet exploring Exodus 32:9 and the phrase קשה עורף (stiff-necked) across translations and Jewish commentary"
>
  <main class="min-h-screen bg-gray-50 dark:bg-gray-900">
    <div class="max-w-4xl mx-auto px-4 py-12">

      <header class="mb-12 text-center">
        <h1 class="text-4xl font-bold text-cyan-600 dark:text-cyan-400 mb-2">Stiff-Necked People</h1>
        <p class="text-lg text-gray-600 dark:text-gray-400 mb-1">Matthew Miller</p>
        <p class="text-sm text-gray-500 dark:text-gray-500">A study of <span class="font-hebrew text-base">קְשֵׁה-עֹרֶף</span> · <em>qəšēh-ʿōrep</em></p>
      </header>

      <!-- The Verse -->
      <div class="mb-12">
        <h2 class="text-2xl font-bold text-gray-800 dark:text-gray-200 mb-6 pb-2 border-b-2 border-cyan-500">The Verse — Exodus 32:9</h2>

        <div class="space-y-4">

          <!-- Hebrew -->
          <section class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-lg border border-gray-200 dark:border-gray-700">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-lg font-semibold text-cyan-600 dark:text-cyan-400">Hebrew (Masoretic Text)</h3>
              <span class="text-xs bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200 px-2 py-1 rounded font-medium">Source</span>
            </div>
            <p class="font-hebrew text-2xl text-right leading-loose text-gray-800 dark:text-gray-100 mb-3">
              וַיֹּ֤אמֶר יְהוָה֙ אֶל־מֹשֶׁ֔ה רָאִ֖יתִי אֶת־הָעָ֣ם הַזֶּ֑ה וְהִנֵּ֥ה עַם־<mark class="bg-yellow-200 dark:bg-yellow-800 text-gray-900 dark:text-yellow-100 px-1 rounded">קְשֵׁה־עֹ֖רֶף</mark> הֽוּא׃
            </p>
            <p class="text-sm text-gray-500 dark:text-gray-400 italic">Transliteration: <em>vayomer Adonai el-Mosheh ra'iti et-ha'am hazeh v'hinneh am-<strong>qəšēh-ʿōrep</strong> hu</em></p>
          </section>

        </div>
      </div>

      <!-- Translation Comparison -->
      <div class="mb-12">
        <h2 class="text-2xl font-bold text-gray-800 dark:text-gray-200 mb-2 pb-2 border-b-2 border-cyan-500">Translation Comparison</h2>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">How translators render <span class="font-hebrew">קְשֵׁה-עֹרֶף</span> — literally "hard of neck"</p>

        <div class="space-y-4">

          <!-- WEB -->
          <section class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-lg border border-gray-200 dark:border-gray-700">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-lg font-semibold text-cyan-600 dark:text-cyan-400">World English Bible (WEB)</h3>
              <span class="text-xs bg-cyan-100 dark:bg-cyan-900 text-cyan-800 dark:text-cyan-200 px-2 py-1 rounded font-medium">Modern</span>
            </div>
            <blockquote class="text-gray-700 dark:text-gray-300 text-lg pl-4 border-l-4 border-cyan-400">
              Yahweh said to Moses, "I have seen these people, and behold, they are a <mark class="bg-yellow-200 dark:bg-yellow-800 text-gray-900 dark:text-yellow-100 px-1 rounded font-semibold">stiff-necked people</mark>."
            </blockquote>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">Rendering: <strong class="text-gray-700 dark:text-gray-300">stiff-necked</strong> (hyphenated adjective)</p>
          </section>

          <!-- KJV -->
          <section class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-lg border border-gray-200 dark:border-gray-700">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-lg font-semibold text-cyan-600 dark:text-cyan-400">King James Version (KJV, 1611)</h3>
              <span class="text-xs bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200 px-2 py-1 rounded font-medium">Classic</span>
            </div>
            <blockquote class="text-gray-700 dark:text-gray-300 text-lg pl-4 border-l-4 border-purple-400">
              And the LORD said unto Moses, I have seen this people, and, behold, it is a <mark class="bg-yellow-200 dark:bg-yellow-800 text-gray-900 dark:text-yellow-100 px-1 rounded font-semibold">stiffnecked people</mark>:
            </blockquote>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">Rendering: <strong class="text-gray-700 dark:text-gray-300">stiffnecked</strong> (single compound word, no hyphen)</p>
          </section>

          <!-- ASV -->
          <section class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-lg border border-gray-200 dark:border-gray-700">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-lg font-semibold text-cyan-600 dark:text-cyan-400">American Standard Version (ASV, 1901)</h3>
              <span class="text-xs bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 px-2 py-1 rounded font-medium">Classic</span>
            </div>
            <blockquote class="text-gray-700 dark:text-gray-300 text-lg pl-4 border-l-4 border-blue-400">
              And Jehovah said unto Moses, I have seen this people, and, behold, it is a <mark class="bg-yellow-200 dark:bg-yellow-800 text-gray-900 dark:text-yellow-100 px-1 rounded font-semibold">stiffnecked people</mark>:
            </blockquote>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">Rendering: <strong class="text-gray-700 dark:text-gray-300">stiffnecked</strong> (identical to KJV compound)</p>
          </section>

          <!-- Darby -->
          <section class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-lg border border-gray-200 dark:border-gray-700">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-lg font-semibold text-cyan-600 dark:text-cyan-400">Darby Bible (1890)</h3>
              <span class="text-xs bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 px-2 py-1 rounded font-medium">Classic</span>
            </div>
            <blockquote class="text-gray-700 dark:text-gray-300 text-lg pl-4 border-l-4 border-blue-400">
              And Jehovah said to Moses, I see this people, and behold, it is a <mark class="bg-yellow-200 dark:bg-yellow-800 text-gray-900 dark:text-yellow-100 px-1 rounded font-semibold">stiff-necked people</mark>.
            </blockquote>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">Rendering: <strong class="text-gray-700 dark:text-gray-300">stiff-necked</strong> (hyphenated; uses present tense "I see" rather than past)</p>
          </section>

          <!-- BBE -->
          <section class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-lg border border-gray-200 dark:border-gray-700">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-lg font-semibold text-cyan-600 dark:text-cyan-400">Bible in Basic English (BBE, 1949)</h3>
              <span class="text-xs bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 px-2 py-1 rounded font-medium">Modern</span>
            </div>
            <blockquote class="text-gray-700 dark:text-gray-300 text-lg pl-4 border-l-4 border-green-400">
              And the Lord said to Moses, I have been watching this people, and I see that they are a <mark class="bg-yellow-200 dark:bg-yellow-800 text-gray-900 dark:text-yellow-100 px-1 rounded font-semibold">stiff-necked people</mark>.
            </blockquote>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">Rendering: <strong class="text-gray-700 dark:text-gray-300">stiff-necked</strong> (hyphenated; notably uses continuous "I have been watching" — an extended gaze)</p>
          </section>

          <!-- Douay-Rheims -->
          <section class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-lg border border-gray-200 dark:border-gray-700">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-lg font-semibold text-cyan-600 dark:text-cyan-400">Douay-Rheims (DRA, 1899)</h3>
              <span class="text-xs bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200 px-2 py-1 rounded font-medium">Catholic</span>
            </div>
            <blockquote class="text-gray-700 dark:text-gray-300 text-lg pl-4 border-l-4 border-red-400">
              And again the Lord said to Moses: See that this people is <mark class="bg-yellow-200 dark:bg-yellow-800 text-gray-900 dark:text-yellow-100 px-1 rounded font-semibold">stiffnecked</mark>:
            </blockquote>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">Rendering: <strong class="text-gray-700 dark:text-gray-300">stiffnecked</strong> (predicate adjective rather than "a stiffnecked people" — subtly different grammar)</p>
          </section>

        </div>
      </div>

      <!-- International Translations (via Sefaria) -->
      <div class="mb-12">
        <h2 class="text-2xl font-bold text-gray-800 dark:text-gray-200 mb-2 pb-2 border-b-2 border-cyan-500">International Translations</h2>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">How other languages render <span class="font-hebrew">קְשֵׁה-עֹרֶף</span> — via <a href="https://www.sefaria.org/Exodus.32.9" class="text-cyan-600 dark:text-cyan-400 hover:underline" target="_blank">Sefaria</a></p>

        <div class="space-y-4">

          <!-- Russian -->
          <section class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-lg border border-gray-200 dark:border-gray-700">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-lg font-semibold text-cyan-600 dark:text-cyan-400">Russian — Slivniak / Da Project (2011)</h3>
              <span class="text-xs bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200 px-2 py-1 rounded font-medium">🇷🇺 Russian</span>
            </div>
            <blockquote class="text-gray-700 dark:text-gray-300 text-lg pl-4 border-l-4 border-red-400 mb-2">
              И сказал Господь Моше: Вижу я, что народ это <mark class="bg-yellow-200 dark:bg-yellow-800 text-gray-900 dark:text-yellow-100 px-1 rounded font-semibold">упрямый</mark>.
            </blockquote>
            <p class="text-sm text-gray-500 dark:text-gray-400">Rendering: <strong class="text-gray-700 dark:text-gray-300">упрямый</strong> (upryamy) — "stubborn, obstinate" — an abstract rendering, dropping the physical neck metaphor</p>
          </section>

          <!-- Yiddish -->
          <section class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-lg border border-gray-200 dark:border-gray-700">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-lg font-semibold text-cyan-600 dark:text-cyan-400">Yiddish — Yehoyesh Tanakh (1941)</h3>
              <span class="text-xs bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200 px-2 py-1 rounded font-medium">יידיש Yiddish</span>
            </div>
            <blockquote class="text-gray-700 dark:text-gray-300 text-lg pl-4 border-l-4 border-yellow-400 mb-2" dir="rtl" lang="yi">
              און גאָט האָט געזאָגט צו משהן: איך האָב געזען דאָסדאָזיקע פֿאָלק, ערשט עס איז אַ <mark class="bg-yellow-200 dark:bg-yellow-800 text-gray-900 dark:text-yellow-100 px-1 rounded font-semibold">האַרטנעקיק פֿאָלק</mark>;
            </blockquote>
            <p class="text-sm text-gray-500 dark:text-gray-400">Rendering: <strong class="text-gray-700 dark:text-gray-300">האַרטנעקיק</strong> (hartnekik) — literally "hard-necked" — preserves the physical metaphor directly in Yiddish</p>
          </section>

          <!-- French -->
          <section class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-lg border border-gray-200 dark:border-gray-700">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-lg font-semibold text-cyan-600 dark:text-cyan-400">French — Bible du Rabbinat (1899)</h3>
              <span class="text-xs bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 px-2 py-1 rounded font-medium">🇫🇷 French</span>
            </div>
            <blockquote class="text-gray-700 dark:text-gray-300 text-lg pl-4 border-l-4 border-blue-400 mb-2" lang="fr">
              L'Éternel dit à Moïse: "Je vois que ce peuple est un peuple <mark class="bg-yellow-200 dark:bg-yellow-800 text-gray-900 dark:text-yellow-100 px-1 rounded font-semibold">rétif</mark>.
            </blockquote>
            <p class="text-sm text-gray-500 dark:text-gray-400">Rendering: <strong class="text-gray-700 dark:text-gray-300">rétif</strong> — "refractory, unruly, restive" — an animal metaphor (a horse that won't move), still embodied but different</p>
          </section>

          <!-- German -->
          <section class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-lg border border-gray-200 dark:border-gray-700">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-lg font-semibold text-cyan-600 dark:text-cyan-400">German — Bernfeld (1902)</h3>
              <span class="text-xs bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200 px-2 py-1 rounded font-medium">🇩🇪 German</span>
            </div>
            <blockquote class="text-gray-700 dark:text-gray-300 text-lg pl-4 border-l-4 border-gray-400 mb-2" lang="de">
              Der Herr sprach ferner zu Mose: Ich sehe dieses Volk, es ist ein <mark class="bg-yellow-200 dark:bg-yellow-800 text-gray-900 dark:text-yellow-100 px-1 rounded font-semibold">hartnäckig Volk</mark>.
            </blockquote>
            <p class="text-sm text-gray-500 dark:text-gray-400">Rendering: <strong class="text-gray-700 dark:text-gray-300">hartnäckig</strong> — literally "hard-necked" in German (hart = hard, Nacken = neck/nape) — the bodily metaphor survives perfectly</p>
          </section>

          <!-- Italian -->
          <section class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-lg border border-gray-200 dark:border-gray-700">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-lg font-semibold text-cyan-600 dark:text-cyan-400">Italian — Luzzatto (1872)</h3>
              <span class="text-xs bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 px-2 py-1 rounded font-medium">🇮🇹 Italian</span>
            </div>
            <blockquote class="text-gray-700 dark:text-gray-300 text-lg pl-4 border-l-4 border-green-400 mb-2" lang="it">
              Ed il Signore soggiunse a Mosè: Vedo che questo popolo è gente di <mark class="bg-yellow-200 dark:bg-yellow-800 text-gray-900 dark:text-yellow-100 px-1 rounded font-semibold">dura cervice</mark> [caparbia].
            </blockquote>
            <p class="text-sm text-gray-500 dark:text-gray-400">Rendering: <strong class="text-gray-700 dark:text-gray-300">dura cervice</strong> — "hard nape/back of neck" — the most literal of all; also glosses it with <em>caparbia</em> (stubborn)</p>
          </section>

          <!-- Polish -->
          <section class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-lg border border-gray-200 dark:border-gray-700">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-lg font-semibold text-cyan-600 dark:text-cyan-400">Polish — Cylkow (1895)</h3>
              <span class="text-xs bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200 px-2 py-1 rounded font-medium">🇵🇱 Polish</span>
            </div>
            <blockquote class="text-gray-700 dark:text-gray-300 text-lg pl-4 border-l-4 border-red-400 mb-2" lang="pl">
              I rzekł Wiekuisty do Mojżesza: "Widzę lud ten, a oto lud to <mark class="bg-yellow-200 dark:bg-yellow-800 text-gray-900 dark:text-yellow-100 px-1 rounded font-semibold">twardego karku</mark>.
            </blockquote>
            <p class="text-sm text-gray-500 dark:text-gray-400">Rendering: <strong class="text-gray-700 dark:text-gray-300">twardego karku</strong> — "of hard neck/nape" — preserves the anatomical image; <em>kark</em> is specifically the back of the neck</p>
          </section>

          <!-- Esperanto -->
          <section class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-lg border border-gray-200 dark:border-gray-700">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-lg font-semibold text-cyan-600 dark:text-cyan-400">Esperanto — Zamenhof (1910)</h3>
              <span class="text-xs bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 px-2 py-1 rounded font-medium">🌍 Esperanto</span>
            </div>
            <blockquote class="text-gray-700 dark:text-gray-300 text-lg pl-4 border-l-4 border-green-400 mb-2" lang="eo">
              Kaj la Eternulo diris al Moseo: Mi vidas ĉi tiun popolon, ĝi estas popolo <mark class="bg-yellow-200 dark:bg-yellow-800 text-gray-900 dark:text-yellow-100 px-1 rounded font-semibold">malmolnuka</mark>.
            </blockquote>
            <p class="text-sm text-gray-500 dark:text-gray-400">Rendering: <strong class="text-gray-700 dark:text-gray-300">malmolnuka</strong> — literally "un-soft-nape" (mal = un/not, mol = soft, nuk = nape/neck) — Zamenhof's constructed language transparently preserves the anatomy</p>
          </section>

          <!-- Portuguese -->
          <section class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-lg border border-gray-200 dark:border-gray-700">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-lg font-semibold text-cyan-600 dark:text-cyan-400">Portuguese — Pires da Silva (2024)</h3>
              <span class="text-xs bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200 px-2 py-1 rounded font-medium">🇧🇷 Portuguese</span>
            </div>
            <blockquote class="text-gray-700 dark:text-gray-300 text-lg pl-4 border-l-4 border-yellow-400 mb-2" lang="pt">
              E Hashem disse a Moshe: "Vi este povo, e eis que é um povo <mark class="bg-yellow-200 dark:bg-yellow-800 text-gray-900 dark:text-yellow-100 px-1 rounded font-semibold">obstinado</mark>.
            </blockquote>
            <p class="text-sm text-gray-500 dark:text-gray-400">Rendering: <strong class="text-gray-700 dark:text-gray-300">obstinado</strong> — "obstinate, stubborn" — abstract, dropping the neck metaphor; retains Hebrew divine names (Hashem, Moshe)</p>
          </section>

          <!-- Spanish -->
          <section class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-lg border border-gray-200 dark:border-gray-700">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-lg font-semibold text-cyan-600 dark:text-cyan-400">Spanish — Biblia de Jerusalén (Cerhy)</h3>
              <span class="text-xs bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200 px-2 py-1 rounded font-medium">🇪🇸 Spanish</span>
            </div>
            <blockquote class="text-gray-700 dark:text-gray-300 text-lg pl-4 border-l-4 border-red-400 mb-2" lang="es">
              Y añadió Yahvé a Moisés: "Ya veo que este pueblo es un pueblo de <mark class="bg-yellow-200 dark:bg-yellow-800 text-gray-900 dark:text-yellow-100 px-1 rounded font-semibold">dura cerviz</mark>.
            </blockquote>
            <p class="text-sm text-gray-500 dark:text-gray-400">Rendering: <strong class="text-gray-700 dark:text-gray-300">dura cerviz</strong> — "hard neck/nape" — preserves the bodily image; <em>cerviz</em> (back of the neck) is archaic and poetic in modern Spanish</p>
          </section>

        </div>
      </div>

      <!-- Hebrew Breakdown -->
      <div class="mb-12">
        <h2 class="text-2xl font-bold text-gray-800 dark:text-gray-200 mb-6 pb-2 border-b-2 border-cyan-500">Understanding <span class="font-hebrew">קְשֵׁה-עֹרֶף</span></h2>

        <div class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-lg border border-gray-200 dark:border-gray-700 mb-6">
          <h3 class="text-lg font-semibold text-cyan-600 dark:text-cyan-400 mb-4">Word-by-Word Breakdown</h3>
          <div class="grid md:grid-cols-2 gap-6">
            <div class="bg-gray-50 dark:bg-gray-900 rounded-lg p-4">
              <p class="font-hebrew text-3xl text-center text-gray-800 dark:text-gray-100 mb-2">קְשֵׁה</p>
              <p class="text-center font-medium text-gray-700 dark:text-gray-300"><em>qəšēh</em></p>
              <p class="text-center text-gray-600 dark:text-gray-400 text-sm mt-1">
                adjective: <strong>hard, difficult, severe</strong><br/>
                from root <span class="font-hebrew">ק-ש-ה</span> (to be hard/harsh)
              </p>
            </div>
            <div class="bg-gray-50 dark:bg-gray-900 rounded-lg p-4">
              <p class="font-hebrew text-3xl text-center text-gray-800 dark:text-gray-100 mb-2">עֹרֶף</p>
              <p class="text-center font-medium text-gray-700 dark:text-gray-300"><em>ʿōrep</em></p>
              <p class="text-center text-gray-600 dark:text-gray-400 text-sm mt-1">
                noun: <strong>the back of the neck, the nape</strong><br/>
                the part that stiffens when refusing to bow or turn
              </p>
            </div>
          </div>
          <div class="mt-4 p-4 bg-cyan-50 dark:bg-cyan-950 rounded-lg border border-cyan-200 dark:border-cyan-800">
            <p class="text-gray-700 dark:text-gray-300 text-center">
              Together: <span class="font-hebrew text-xl">קְשֵׁה-עֹרֶף</span> = <strong>"hard of neck"</strong> — 
              the image of a draft animal that refuses to turn its head, resisting the yoke or the driver's guidance.
            </p>
          </div>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-lg border border-gray-200 dark:border-gray-700">
          <h3 class="text-lg font-semibold text-cyan-600 dark:text-cyan-400 mb-4">Translation Spectrum</h3>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-gray-200 dark:border-gray-700">
                  <th class="text-left py-2 px-3 text-gray-600 dark:text-gray-400 font-semibold">Translation</th>
                  <th class="text-left py-2 px-3 text-gray-600 dark:text-gray-400 font-semibold">Rendering of <span class="font-hebrew">קְשֵׁה-עֹרֶף</span></th>
                  <th class="text-left py-2 px-3 text-gray-600 dark:text-gray-400 font-semibold">Form</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                <tr class="bg-gray-50 dark:bg-gray-900">
                  <td class="py-2 px-3 text-gray-500 dark:text-gray-400 text-xs font-semibold uppercase" colspan="3">English</td>
                </tr>
                <tr>
                  <td class="py-2 px-3 text-gray-700 dark:text-gray-300">WEB</td>
