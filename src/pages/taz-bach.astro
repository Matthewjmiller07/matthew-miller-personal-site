---
import Layout from '../layouts/Layout.astro';
import data from '../data/taz-bach/citations.json';

const pageTitle = 'Does the Taz Mostly Disagree with the Bach?';
const pageDescription = 'Testing Rav Asher Weiss’s remark that most of the time the Taz quotes the Bach, he disagrees with him — by classifying all 502 places the Taz cites his father-in-law in the full text, with an independent check by TypeSafe’s Jev.';

const { results, citations } = data;
const mine = results.mine;
const jev = results.jev;

const verdictLabel = { disagree: 'Disagrees', agree: 'Agrees', neutral: 'Neutral' };
const verdictClass = {
  disagree: 'bg-red-100 text-red-900 dark:bg-red-900/40 dark:text-red-100',
  agree: 'bg-green-100 text-green-900 dark:bg-green-900/40 dark:text-green-100',
  neutral: 'bg-stone-200 text-stone-700 dark:bg-stone-700 dark:text-stone-200',
};
import approaches from '../data/taz-bach/approaches.json';

const mindsTotal = approaches.length;
const mindsBach = approaches.filter((a) => a.stricter === 'bach').length;
const mindsTaz = approaches.filter((a) => a.stricter === 'taz').length;
const mindsNone = approaches.filter((a) => a.stricter === 'none').length;
const mindsSA = approaches.filter((a) => a.tags.includes('SA')).length;
const domainOrder = ['Pesach', 'Festivals & fasts', 'Meals & blessings', 'Prayer & blessings', 'Shabbat & eruvin', 'Shechita & treifot', 'Kashrut', 'Nidda', 'Gittin, agunah & kiddushin', 'Other'];
const domainRows = domainOrder.map((name) => {
  const rows = approaches.filter((a) => a.domain === name);
  return { name, bach: rows.filter((a) => a.stricter === 'bach').length, taz: rows.filter((a) => a.stricter === 'taz').length, none: rows.filter((a) => a.stricter === 'none').length };
});
// Authority named in the passage around the citation: disagree rate among position-taking citations.
const authPatterns = [
  ['Maharshal (Rashal)', 'Acharon, Poland', /רש"ל/],
  ['Levush', 'Acharon, Poland', /לבוש/],
  ['Rema', 'Codifier', /רמ"א/],
  ['Shulchan Arukh', 'Codifier', /ש"ע|השו"ע|השלחן ערוך/],
  ['Tur', 'Codifier', /הטור/],
  ['Beit Yosef', 'Codifier', /ב"י/],
  ['Rosh', 'Rishon', /רא"ש/],
  ['Rambam', 'Rishon', /רמב"ם/],
  ['Rashba', 'Rishon', /רשב"א/],
  ['Mordechai', 'Rishon', /מרדכי/],
  ['Tosafot', 'Rishon', /תוס/],
  ['Ran', 'Rishon', /ר"ן/],
  ['Rashi', 'Rishon', /רש"י/],
];
const authRows = authPatterns.map(([name, kind, re]) => {
  const rows = citations.filter((c) => re.test(c.hebrew.replace(/״/g, '"')));
  const dis = rows.filter((c) => c.mine === 'disagree').length;
  const agr = rows.filter((c) => c.mine === 'agree').length;
  return { name, kind, n: rows.length, dis, pct: dis + agr ? Math.round((100 * dis) / (dis + agr)) : 0 };
});
const strictLabel = { bach: 'Bach stricter', taz: 'Taz stricter', none: 'No practical gap' };
const strictClass = {
  bach: 'bg-red-100 text-red-900 dark:bg-red-900/40 dark:text-red-100',
  taz: 'bg-sky-100 text-sky-900 dark:bg-sky-900/40 dark:text-sky-100',
  none: 'bg-stone-200 text-stone-700 dark:bg-stone-700 dark:text-stone-200',
};
---

<Layout title={pageTitle} description={pageDescription} image="/og/taz-bach.jpg" imageAlt="Does the Taz Mostly Disagree with the Bach? 56% disagree, of the 421 times the Taz takes a position — 236 disagree, 185 agree, 81 neutral, across all 502 citations.">
  <main class="max-w-5xl mx-auto px-4 py-10">
    <header class="mb-8">
      <p class="text-sm uppercase tracking-widest opacity-60 mb-2">A full count — every citation · 8 November 2026</p>
      <h1 class="text-3xl md:text-4xl font-bold mb-3">Does the Taz Mostly Disagree with the Bach?</h1>
      <p class="text-lg opacity-80 max-w-3xl">
        In his shiur on <em>Parshat Toldot: Indirectly Causing an Obstacle</em>, Rav Asher Weiss
        said of the Taz and the Bach — father-in-law and son-in-law — “I didn't check it out
        statistically, but I think most of the times the Taz quotes the Bach, he disagrees with
        him.” He left the count open — this page runs it.
      </p>
      <p class="mt-3 text-sm opacity-70">
        The shiur:
        <a class="underline hover:no-underline" href="https://yutorah-rss.netlify.app/transcripts/#265883@00:08:28" target="_blank" rel="noopener">transcript, 8:28</a>
        · <a class="underline hover:no-underline" href="https://www.torahanytime.com/lectures/265883" target="_blank" rel="noopener">TorahAnytime lecture 265883</a>
      </p>
    </header>

    <nav class="mb-8 flex gap-2 border-b border-current/20" role="tablist" aria-label="Sections">
      <button class="tab-btn px-4 py-2 -mb-px border-b-2 font-semibold" role="tab" data-tab="count">The count</button>
      <button class="tab-btn px-4 py-2 -mb-px border-b-2 font-semibold" role="tab" data-tab="minds">Two minds <span class="ml-1 text-xs align-top px-1.5 py-0.5 rounded-full bg-red-700 text-white">new</span></button>
    </nav>

    <div data-panel="count">

    <section class="mb-10 rounded-xl border border-current/20 p-5 md:p-6">
      <h2 class="text-xl font-bold mb-2">The verdict: yes, mostly — but by a narrow majority</h2>
      <p class="mb-3">
        Every one of the <strong>502</strong> places where the Taz cites the Bach was classified:
        he <strong>disagrees 236 times, agrees 185, and takes no position 81</strong>.
        Among the 421 citations where he takes a position at all, he disagrees
        <strong>56% of the time</strong>. That is a majority, not a landslide — and it is not a
        sample, so there is no sampling error to hide behind: the uncertainty here is
        classification judgment, not chance.
        TypeSafe's Jev, classifying the same 502 independently, is more disagree-leaning:
        <strong>271 disagree, 110 agree, 121 neutral — 71%</strong> among position-takers.
        The two methods bracket the answer; the human reading sits at the lower end.
      </p>
      <p>
        The pattern is not uniform. In <strong>Even HaEzer he disagrees in 62 of 76</strong>
        position-taking citations (82%). In <strong>Orach Chaim he agrees slightly more often
        than he disagrees</strong> (92 agree, 82 disagree). The “mostly disagrees” is real,
        and it lives mostly in Even HaEzer.
      </p>
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-3">How it was counted</h2>
      <ol class="list-decimal ml-6 space-y-2 max-w-3xl">
        <li>
          <strong>Source.</strong> The full Hebrew text of the Taz (<em>Turei Zahav</em>) on all
          four parts of Shulchan Arukh, from Sefaria — 1,705 simanim, fetched siman by siman.
        </li>
        <li>
          <strong>Finding the Bach.</strong> There are 794 references to the Bach in the Taz.
          The trap: the abbreviation <span dir="rtl" lang="he">ב״ח</span> usually does
          <em>not</em> mean the Bach — in the Taz it is mostly <span dir="rtl" lang="he">בעל חוב</span> (a
          creditor), and also <span dir="rtl" lang="he">בבא בתרא</span>, <span dir="rtl" lang="he">ברכת חתנים</span>
          and <span dir="rtl" lang="he">בן חורין</span>. Only about 30% of
          <span dir="rtl" lang="he">ב״ח</span> tokens are the Bach at all, and they cannot be told
          apart without reading each one — so they are not in this count. The clean population is
          <span dir="rtl" lang="he">מו״ח</span> — “my teacher, my father-in-law” — which is
          unambiguously the Bach: <strong>499 occurrences</strong>, plus 6 standalone
          <span dir="rtl" lang="he">חמי</span> and the single spelled-out
          <span dir="rtl" lang="he">בית חדש</span> — 506 candidates. Two were excluded on inspection:
          <span dir="rtl" lang="he">רמי בר חמי</span> (Rami bar Chama, not “my father-in-law”) and a
          <span dir="rtl" lang="he">חמי זקיני הט״ז</span> that is a later glossator's voice, not the
          Taz's. Final population: <strong>502</strong> (Orach Chaim 218, Yoreh De'ah 193,
          Even HaEzer 89, Choshen Mishpat 2).
        </li>
        <li>
          <strong>Census, not a sample.</strong> All 502 citations were read in context and
          classified <em>disagree / agree / neutral</em> — 60 by hand, the other 442 by nine
          classifiers working to the same rubric, each reading the full seif where the passage
          did not settle it. “Neutral” covers citations where the Taz reports the Bach, and cases
          where he answers the Bach's difficulty without ruling on the Bach's position. Later
          editor glosses (<span dir="rtl" lang="he">דברי המגיה</span>) were excluded. Sixteen
          citations are marked uncertain even after a full-seif read.
        </li>
        <li>
          <strong>Independent check.</strong> Jev (jev-1.14.0) classified all 502 passages.
          It agreed on 315 of 502 (63%) — see below.
        </li>
        <li>
          <strong>Earlier sample.</strong> A first pass classified a random sample of 60 before the
          full count was commissioned: 30 disagree, 20 agree, 10 neutral — 60% among
          position-takers. The census comes in a little lower (56%), as a full count should.
        </li>
      </ol>
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-3">By section</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-current/20">
              <th class="py-2 pr-4">Section</th>
              <th class="py-2 pr-4">Citations</th>
              <th class="py-2 pr-4">Disagree</th>
              <th class="py-2 pr-4">Agree</th>
              <th class="py-2 pr-4">Neutral</th>
              <th class="py-2">Disagree, of those taking a position</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-current/10"><td class="py-2 pr-4">Orach Chaim</td><td class="py-2 pr-4">218</td><td class="py-2 pr-4">82</td><td class="py-2 pr-4">92</td><td class="py-2 pr-4">44</td><td class="py-2">47%</td></tr>
            <tr class="border-b border-current/10"><td class="py-2 pr-4">Yoreh De'ah</td><td class="py-2 pr-4">193</td><td class="py-2 pr-4">91</td><td class="py-2 pr-4">78</td><td class="py-2 pr-4">24</td><td class="py-2">54%</td></tr>
            <tr class="border-b border-current/10"><td class="py-2 pr-4">Even HaEzer</td><td class="py-2 pr-4">89</td><td class="py-2 pr-4">62</td><td class="py-2 pr-4">14</td><td class="py-2 pr-4">13</td><td class="py-2">82%</td></tr>
            <tr class="border-b border-current/10"><td class="py-2 pr-4">Choshen Mishpat</td><td class="py-2 pr-4">2</td><td class="py-2 pr-4">1</td><td class="py-2 pr-4">1</td><td class="py-2 pr-4">0</td><td class="py-2">50%</td></tr>
            <tr class="font-bold"><td class="py-2 pr-4">Total</td><td class="py-2 pr-4">502</td><td class="py-2 pr-4">236</td><td class="py-2 pr-4">185</td><td class="py-2 pr-4">81</td><td class="py-2">56%</td></tr>
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-sm opacity-70 max-w-3xl">
        Choshen Mishpat has only 2 unambiguous citations in the whole Taz — the Bach is cited
        there almost entirely as <span dir="rtl" lang="he">ב״ח</span>, where he is indistinguishable
        from a creditor without reading.
      </p>
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-3">Three moments that show the range</h2>
      <div class="space-y-5 max-w-3xl">
        <div>
          <p class="font-semibold">The bluntest disagreement — Yoreh De'ah 98:7</p>
          <p>
            The one place the Bach is spelled out in full — <span dir="rtl" lang="he">בספר בית חדש פסק מו״ח ז״ל</span> —
            he rules leniently, that after the fact the food is permitted. The Taz answers:
            <span dir="rtl" lang="he">ולע״ד נראה דלא להקל כלל בזה</span> — “in my humble opinion, one should
            not be lenient in this at all.”
          </p>
        </div>
        <div>
          <p class="font-semibold">The sharpest language — Even HaEzer 129:25</p>
          <p>
            On the Bach's ruling about a get: <span dir="rtl" lang="he">מכשול יצא מתחת ידי מו״ח ז״ל בזה</span> —
            “a stumbling block came from under the Bach's hand in this.” The Taz says the Bach
            himself was not happy with it.
          </p>
        </div>
        <div>
          <p class="font-semibold">The reverse — Yoreh De'ah 204:5</p>
          <p>
            The Taz presented his reading to the Bach in person after the Bach had printed his
            work — <span dir="rtl" lang="he">והסכים לדברי ואמר בפירוש שרמ״א טעה בכך</span> — “and he agreed
            with my words, and said explicitly that the Rema had erred in this.” Sometimes the
            father-in-law conceded.
          </p>
        </div>
        <div>
          <p class="font-semibold">The shiur's own case — Yoreh De'ah 147</p>
          <p>
            The dispute Weiss was teaching — whether a non-Jew may say thank you to idolatry —
            leaves no named trace: the Taz's comment on Yoreh De'ah 147 never mentions the Bach
            at all. The disagreement there is substantive, not a citation.
          </p>
        </div>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-3">The Jev check — same direction, further apart</h2>
      <p class="max-w-3xl mb-3">
        Jev classified all 502 passages: 271 disagree, 110 agree, 121 neutral — 71% disagree
        among position-takers, against the human reading's 56%. It agreed with the human verdict
        on 315 of 502 (63%). The gap is systematic: Jev rarely calls a citation an agreement.
        Of the 185 citations the human reading calls agree, Jev agreed on only 77 — it called
        56 of them disagree and 52 neutral. And it misreads characteristic Taz idiom:
        <span dir="rtl" lang="he">יפה הקשה</span> (“he asked well” — praise, not a fight),
        <span dir="rtl" lang="he">ובחנם</span> (“for nothing” — a dismissal),
        <span dir="rtl" lang="he">ולא כדעת</span> (“not like the view of” — an explicit disagreement).
        The two methods agree on the direction and the section pattern — Jev too puts Even
        HaEzer highest (58 of 65 position-takers, 89%) — but the exact disagree share depends
        on the reader.
      </p>
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-3">Caveats</h2>
      <ul class="list-disc ml-6 space-y-2 max-w-3xl">
        <li>
          This is a census, so there is no sampling error — but classification is judgment.
          Sixteen citations are marked uncertain even after a full-seif read, and the Jev check
          lands 15 points higher on the disagree share. Treat 56% as the human reading, with Jev's
          71% as the upper bracket.
        </li>
        <li>
          Each verdict rests on the passage around the citation, extended to the full seif where
          needed. Longer context — the Bach's own text, or the sugya — could flip a few.
          The contested ones are marked in the table where Jev and the human reading differ.
        </li>
        <li>
          “Disagree” covers a range, from the blunt <span dir="rtl" lang="he">דזה אינו</span> (“this is
          not so”) to the mild <span dir="rtl" lang="he">בחנם</span> (“for nothing” — the Bach's
          move was unnecessary) and <span dir="rtl" lang="he">לא נהירא</span> (“it is not clear to me”).
        </li>
        <li>
          The Taz often answers the Bach's difficulty rather than ruling on it; those are counted
          neutral, which is why the disagree share is higher among position-takers (56%) than
          across all citations (47%).
        </li>
        <li>
          The ~119 <span dir="rtl" lang="he">ב״ח</span> tokens that look like the Bach are not in
          this count: each would need to be read individually to separate the Bach from creditors
          and the other abbreviations. They would move the totals, not the method.
        </li>
      </ul>
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-3">All 502 citations</h2>
      <div class="mb-4 flex flex-wrap gap-2 text-sm" id="filters">
        <button class="filter-btn px-3 py-1 rounded-full border border-current/30" data-filter="all">All · 502</button>
        <button class="filter-btn px-3 py-1 rounded-full border border-current/30" data-filter="disagree">Disagree · 236</button>
        <button class="filter-btn px-3 py-1 rounded-full border border-current/30" data-filter="agree">Agree · 185</button>
        <button class="filter-btn px-3 py-1 rounded-full border border-current/30" data-filter="neutral">Neutral · 81</button>
        <button class="filter-btn px-3 py-1 rounded-full border border-current/30" data-filter="differ">Muse–Jev differ · 187</button>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm" id="citeTable">
          <thead>
            <tr class="border-b border-current/20">
              <th class="py-2 pr-3">#</th>
              <th class="py-2 pr-3">Source</th>
              <th class="py-2 pr-3">Passage</th>
              <th class="py-2 pr-3">Taz vs Bach</th>
              <th class="py-2">Jev</th>
            </tr>
          </thead>
          <tbody>
            {citations.map((c) => (
              <tr class="border-b border-current/10 align-top cite-row" data-verdict={c.mine} data-differ={String(!c.agree)}>
                <td class="py-2 pr-3 whitespace-nowrap opacity-70">{c.id}</td>
                <td class="py-2 pr-3 whitespace-nowrap">
                  <a class="underline hover:no-underline" href={c.url} target="_blank" rel="noopener">{c.ref}</a>
                </td>
                <td class="py-2 pr-3" dir="rtl" lang="he">{c.hebrew}</td>
                <td class="py-2 pr-3 whitespace-nowrap">
                  <span class={`px-2 py-0.5 rounded-full text-xs font-semibold ${verdictClass[c.mine]}`}>{verdictLabel[c.mine]}</span>
                </td>
                <td class="py-2 whitespace-nowrap">
                  <span class={`px-2 py-0.5 rounded-full text-xs font-semibold ${verdictClass[c.jev]}`}>{verdictLabel[c.jev]}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="mb-6 text-sm opacity-70 max-w-3xl">
      <h2 class="text-base font-bold mb-2 opacity-100">Sources</h2>
      <p>
        Taz text: Sefaria, <em>Turei Zahav on Shulchan Arukh</em> (Ashlei Ravrevei, Lemberg 1888).
        The claim: Rav Asher Weiss, “Parshat Toldot: Indirectly Causing an Obstacle,” 16 November 2023,
        at 8:28 — <a class="underline hover:no-underline" href="https://yutorah-rss.netlify.app/transcripts/#265883@00:08:28" target="_blank" rel="noopener">transcript</a>.
        Classification: all 502 unambiguous Bach citations in the Taz (499
        <span dir="rtl" lang="he">מו״ח</span>, 6 <span dir="rtl" lang="he">חמי</span>, 1 spelled-out
        <span dir="rtl" lang="he">בית חדש</span>, minus 2 false positives), read in context;
        Jev (jev-1.14.0) classified the same 502 independently.
      </p>
    </section>
    </div>
    <div data-panel="minds" hidden>
    <section class="mb-10">
      <h2 class="text-2xl md:text-3xl font-bold mb-3">Two minds: how the Taz and the Bach differ</h2>
      <p class="text-lg opacity-80 max-w-3xl mb-3">
        The count settles <em>how often</em> the Taz disagrees with his father-in-law. This tab asks
        <em>how</em>. Is one of them simply the stricter posek? What does each one care about, and
        whose authority does each of them lean on?
      </p>
      <p class="max-w-3xl opacity-80">
        Method: each of the {mindsTotal} distinct disagreements (the 236 citations, less 12 where two
        citations quote the same passage) was coded for three things: whether a practical
        stringency is at stake and who holds it, whether the Taz is defending the text of the
        Shulchan Arukh, Beit Yosef, Rema or Tur against the Bach, and the area of halacha. The
        coding was done from the passage. The full seif was read on Sefaria for every case quoted
        below, and one case was recoded as a result (YD 293:4, below). This is a single reader's
        first pass, not a census of the same rigour as the count.
      </p>
    </section>

    <section class="mb-10 rounded-xl border border-current/20 p-5 md:p-6">
      <h3 class="text-xl font-bold mb-3">1. Is one of them more machmir?</h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-4">
        <div class="rounded-lg bg-stone-100 dark:bg-stone-800 p-4">
          <p class="text-3xl font-bold">{mindsNone}</p>
          <p class="text-sm opacity-80">of {mindsTotal} disagreements involve no difference in practice. They are about how to read a text ({Math.round(100*mindsNone/mindsTotal)}%).</p>
        </div>
        <div class="rounded-lg bg-red-50 dark:bg-red-950/40 p-4">
          <p class="text-3xl font-bold">{mindsBach}</p>
          <p class="text-sm opacity-80">practical disputes where the <strong>Bach</strong> is the stricter one.</p>
        </div>
        <div class="rounded-lg bg-sky-50 dark:bg-sky-950/40 p-4">
          <p class="text-3xl font-bold">{mindsTaz}</p>
          <p class="text-sm opacity-80">practical disputes where the <strong>Taz</strong> is the stricter one.</p>
        </div>
      </div>
      <p class="max-w-3xl mb-4">
        Overall, the Bach is somewhat more stringent: he holds the stricter position in
        {mindsBach} of the {mindsBach + mindsTaz} disagreements with a practical gap
        ({Math.round(100*mindsBach/(mindsBach+mindsTaz))}%). But the first finding is that most
        of the time stringency is not what they are fighting about. Nearly two-thirds of the
        disagreements are over how to read the Tur, the Beit Yosef, Rashi or a sugya, with no
        change to the ruling. The second finding is that the overall tilt hides a sharp split by
        area of halacha:
      </p>
      <div class="overflow-x-auto mb-3">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="border-b border-current/20">
              <th class="py-2 pr-4">Area</th>
              <th class="py-2 pr-4">Bach stricter</th>
              <th class="py-2 pr-4">Taz stricter</th>
              <th class="py-2 pr-4">No practical gap</th>
              <th class="py-2">Lean</th>
            </tr>
          </thead>
          <tbody>
            {domainRows.map((d) => (
              <tr class="border-b border-current/10">
                <td class="py-2 pr-4">{d.name}</td>
                <td class="py-2 pr-4">{d.bach}</td>
                <td class="py-2 pr-4">{d.taz}</td>
                <td class="py-2 pr-4 opacity-70">{d.none}</td>
                <td class="py-2 whitespace-nowrap">
                  <span class="inline-flex h-2.5 w-32 rounded-full overflow-hidden bg-stone-200 dark:bg-stone-700 align-middle">
                    <span class="bg-red-700" style={`width:${d.bach+d.taz ? 100*d.bach/(d.bach+d.taz) : 0}%`}></span>
                    <span class="bg-sky-700" style={`width:${d.bach+d.taz ? 100*d.taz/(d.bach+d.taz) : 0}%`}></span>
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs opacity-70 mb-4">Red = Bach stricter, blue = Taz stricter, as a share of the practical disputes in each area.</p>
      <p class="max-w-3xl">
        <strong>The Bach is the stricter one about practice. The Taz is the stricter one about
        status.</strong> On Pesach the Bach holds the stricter view in all nine practical
        disputes, and on fasts and festivals in all four. These are chumrot of conduct and piety:
        lock the chametz dishes in a room, don't kasher wooden bowls, fast a yahrzeit even in
        Nisan, don't slaughter on Tisha b'Av until after the fast. Where the question is whether
        a woman is married, whether a get is valid, or whether an agunah may remarry, the balance
        turns: the Taz is stricter 8 to 5, and in gittin 4 to 0. Kashrut, where the two concerns
        meet, is close to even (10 to 8 the Taz's way).
      </p>
    </section>

    <section class="mb-10">
      <h3 class="text-xl font-bold mb-4">2. What each of them cares about</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div class="rounded-xl border border-current/20 p-5">
          <p class="text-xs uppercase tracking-widest opacity-60 mb-1">The Bach · Rabbi Yoel Sirkis</p>
          <p class="text-lg font-bold mb-2">He reasons up from the sources.</p>
          <p class="mb-3 text-sm">
            The <em>Bayit Chadash</em> is a commentary on the Tur. The Bach argues from the Talmud
            and the Rishonim, and when he thinks the codes have misread them he overrules the codes.
            He rejects a ruling of the Rema on the blessing of a convert (OC 46:5). He sets aside the
            Shulchan Arukh and Beit Yosef because "all the posekim hold like Rashi" (OC 81:1). He
            narrows a ruling of the Rema on washing for bread (OC 164:4). On chadash he proposes his
            own reading of the Yerushalmi, against the reading of the Ri that all later authorities
            had followed (YD 293:4).
          </p>
          <p class="mb-3 text-sm">
            His chumrot tend to be ones of practice and piety:
            <span dir="rtl" lang="he">כל ירא שמים לא יאכל</span> rice and millet outside the meal
            (OC 208:11); wooden bowls can't be kashered for Pesach (OC 451:24); a stain shouldn't be
            ruled on until it dries (YD 188:1).
          </p>
          <p class="text-sm">
            His leniencies are often after the fact (<em>bedi'avad</em>) and rest on his own reading:
            milk that floated to the top leaves the food permitted even without sixty (YD 98:7); a
            man seen hanged may be presumed dead even if the witnesses left at once (EH 17:43); an old
            vessel doesn't absorb even after a full day (YD 93:2).
          </p>
        </div>
        <div class="rounded-xl border border-current/20 p-5">
          <p class="text-xs uppercase tracking-widest opacity-60 mb-1">The Taz · Rabbi David HaLevi Segal</p>
          <p class="text-lg font-bold mb-2">He guards the code, and holds the line in both directions.</p>
          <p class="mb-3 text-sm">
            The <em>Turei Zahav</em> is a commentary on the Shulchan Arukh, and in {mindsSA} of the
            disagreements the Taz is defending the Shulchan Arukh, Beit Yosef, Rema or Tur against the
            Bach's criticism. His signature word is <span dir="rtl" lang="he">ובחנם</span>, "for
            nothing": the Bach's question was never a question. It appears in 25 citations, and in
            all but one of them he disagrees.
          </p>
          <p class="mb-3 text-sm">
            He won't accept a chumra that has no source:
            <span dir="rtl" lang="he">ואיני יודע טעם להחמיר</span> (OC 451:24);
            <span dir="rtl" lang="he">אין זה אלא חומרא בעלמא</span> (OC 466:4);
            <span dir="rtl" lang="he">עוד המציא מו״ח ז״ל חומרא אחת</span>, "my father-in-law
            invented another stringency" (YD 188:1). For him a stringency has costs. Requiring a get
            where every posek says none is needed would cast doubt on the Maharil's own ruling in a
            real case (EH 28:2).
          </p>
          <p class="text-sm">
            Nor will he accept a leniency built on a new reading where a married woman could be
            permitted to remarry: <span dir="rtl" lang="he">ואין לסמוך על הוראה זו כלל</span> on
            the hanged man (EH 17:43); <span dir="rtl" lang="he">מכשול יצא מתחת ידי מו״ח</span> on
            the name in a get (EH 129:25). When he is the lenient one, the code is usually
            behind him: against the Bach and the Rashal, he keeps the lenient custom that the Rema
            endorsed (YD 104:6).
          </p>
        </div>
      </div>

      <div class="mt-5 rounded-xl bg-stone-100 dark:bg-stone-800 p-5 md:p-6">
        <p class="text-xs uppercase tracking-widest opacity-60 mb-1">The clearest case · Yoreh De'ah 293:4, chadash</p>
        <p class="mb-2">
          Both of them permit the new grain in Poland, where people lived on barley beer. They
          differ only in how they get there. The Bach offers his own reading of the Yerushalmi, one
          that undoes the Ri's proof. The Taz refuses:
          <span dir="rtl" lang="he">אף אם היה לנו פי׳ נכון על הירושלמי אין לנו להרים ראש נגד כל הפוסקים</span>,
          "even if we had a correct reading of the Yerushalmi, we may not raise our heads against
          all the posekim." Instead he builds the leniency from the rules of halachic decision:
          the Mishnah's anonymous first Tanna holds that chadash doesn't apply outside the Land,
          and <span dir="rtl" lang="he">כדאי הוא לסמוך עליו בשעת הדחק</span>, "he is worthy of
          being relied on in a time of need."
        </p>
        <p class="text-sm opacity-80">
          The two rulings are the same, but the jurisprudence differs. The Bach will reread the
          sources. The Taz works within the conclusions that the line of posekim has already
          reached.
        </p>
      </div>
    </section>

    <section class="mb-10">
      <h3 class="text-xl font-bold mb-3">3. Whose authority they lean on</h3>
      <p class="max-w-3xl mb-3">
        For each earlier authority, this counts the citations where he is named in the passage
        around the Bach, and how often the Taz disagrees with the Bach in those (among the
        citations where the Taz takes a position; the overall rate is 56%).
      </p>
      <div class="overflow-x-auto mb-3">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="border-b border-current/20">
              <th class="py-2 pr-4">Named in the passage</th>
              <th class="py-2 pr-4">Citations</th>
              <th class="py-2 pr-4">Disagree</th>
              <th class="py-2">Disagree rate</th>
            </tr>
          </thead>
          <tbody>
            {authRows.map((a) => (
              <tr class="border-b border-current/10">
                <td class="py-2 pr-4">{a.name} <span class="opacity-60 text-xs">· {a.kind}</span></td>
                <td class="py-2 pr-4">{a.n}</td>
                <td class="py-2 pr-4">{a.dis}</td>
                <td class="py-2 whitespace-nowrap">
                  <span class="inline-block h-2.5 rounded-full bg-red-700 align-middle mr-2" style={`width:${a.pct}px`}></span>{a.pct}%
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <ul class="list-disc ml-6 space-y-2 max-w-3xl">
        <li>
          <strong>The Maharshal (Rashal) is common ground.</strong> When he is in the passage, the
          Taz disagrees with the Bach only 31% of the time, the lowest rate of any authority.
          Often the Taz cites both of them as support, and sometimes the two join against the
          Rashal (OC 551:10, YD 69:19, YD 399:4). These are three generations of the same Polish
          school.
        </li>
        <li>
          <strong>Arguments over the Rishonim are where they fight most.</strong> When the dispute
          reaches Rashi (88%), the Ran (83%), Tosafot (77%) or the Mordechai (76%), they usually
          disagree. These are the cases where the Bach reads a source for himself and the Taz
          reads it differently.
        </li>
        <li>
          <strong>On the Rema, the Taz follows the Rema, not a direction.</strong> Twice the Bach
          sides with the Rashal against the Rema in the laws of kashrut, once stricter (YD 104:6)
          and once more lenient (YD 108:5). Both times the Taz takes the Rema's side, so he is the
          more lenient of the two in the first case and the stricter in the second.
        </li>
      </ul>
      <p class="mt-3 text-xs opacity-70 max-w-3xl">
        A name appearing in the roughly 200 characters around a citation is a rough signal, not a
        measure of reliance. The numbers for Tosafot, the Ran and the Rashba are small.
      </p>
    </section>

    <section class="mb-10 rounded-xl border-2 border-current/30 p-5 md:p-6">
      <h3 class="text-xl font-bold mb-2">In one line</h3>
      <p class="text-lg">
        The Bach judges the codes by the sources: he will read the Rishonim afresh, rule against
        the Shulchan Arukh, and add a chumra out of piety. The Taz guards the code: he defends its
        text, refuses a chumra or a kula without a source, and is strictest where a mistake would
        leave a married woman free to remarry.
      </p>
    </section>

    <section class="mb-10">
      <h3 class="text-xl font-bold mb-3">Caveats</h3>
      <ul class="list-disc ml-6 space-y-2 max-w-3xl">
        <li>Every practical dispute is coded from one side: "stricter" means the more restrictive position in that case, not a general leaning.</li>
        <li>The coding is one reader's first pass. Most of it is from the passage, with the full seif read for every case quoted on this tab. That check moved one case (YD 293:4) from "Taz stricter" to "no practical gap."</li>
        <li>The areas of halacha are coarse groupings, and several have fewer than ten practical disputes.</li>
        <li>Whether Rav Asher Weiss took up the character of the two in the shiur isn't checked here. This tab goes beyond the remark that the count tested.</li>
      </ul>
    </section>

    <section class="mb-10">
      <h3 class="text-xl font-bold mb-3">All {mindsTotal} coded disagreements</h3>
      <div class="mb-4 flex flex-wrap gap-2 text-sm" id="mindFilters">
        <button class="mind-btn px-3 py-1 rounded-full border border-current/30 font-bold" data-f="all">All · {mindsTotal}</button>
        <button class="mind-btn px-3 py-1 rounded-full border border-current/30" data-f="bach">Bach stricter · {mindsBach}</button>
        <button class="mind-btn px-3 py-1 rounded-full border border-current/30" data-f="taz">Taz stricter · {mindsTaz}</button>
        <button class="mind-btn px-3 py-1 rounded-full border border-current/30" data-f="none">No practical gap · {mindsNone}</button>
        <button class="mind-btn px-3 py-1 rounded-full border border-current/30" data-f="SA">Taz defends the code · {mindsSA}</button>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="border-b border-current/20">
              <th class="py-2 pr-3">Source</th>
              <th class="py-2 pr-3">Area</th>
              <th class="py-2 pr-3">Stricter</th>
              <th class="py-2">Taz defends the code</th>
            </tr>
          </thead>
          <tbody>
            {approaches.map((a) => (
              <tr class="border-b border-current/10 mind-row" data-s={a.stricter} data-sa={String(a.tags.includes('SA'))}>
                <td class="py-1.5 pr-3 whitespace-nowrap"><a class="underline hover:no-underline" href={a.url} target="_blank" rel="noopener">{a.ref}</a></td>
                <td class="py-1.5 pr-3">{a.domain}</td>
                <td class="py-1.5 pr-3">
                  <span class={`px-2 py-0.5 rounded-full text-xs font-semibold ${strictClass[a.stricter]}`}>{strictLabel[a.stricter]}</span>
                </td>
                <td class="py-1.5">{a.tags.includes('SA') ? 'Yes' : ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
    </div>
  </main>

  <script>
    const btns = document.querySelectorAll('.filter-btn');
    const rows = document.querySelectorAll('.cite-row');
    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const f = btn.getAttribute('data-filter');
        rows.forEach((row) => {
          let show = true;
          if (f === 'differ') show = row.getAttribute('data-differ') === 'true';
          else if (f !== 'all') show = row.getAttribute('data-verdict') === f;
          row.style.display = show ? '' : 'none';
        });
        btns.forEach((b) => b.classList.remove('opacity-100', 'font-bold'));
        btn.classList.add('opacity-100', 'font-bold');
      });
    });
    // Tabs: "#minds" opens the Two minds tab; anything else shows the count.
    const tabBtns = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('[data-panel]');
    function showTab(name) {
      panels.forEach((p) => { p.hidden = p.getAttribute('data-panel') !== name; });
      tabBtns.forEach((b) => {
        const on = b.getAttribute('data-tab') === name;
        b.setAttribute('aria-selected', String(on));
        b.classList.toggle('border-current', on);
        b.classList.toggle('border-transparent', !on);
        b.classList.toggle('opacity-60', !on);
      });
    }
    tabBtns.forEach((b) => b.addEventListener('click', () => {
      const name = b.getAttribute('data-tab');
      showTab(name);
      history.replaceState(null, '', name === 'minds' ? '#minds' : location.pathname);
    }));
    showTab(location.hash === '#minds' ? 'minds' : 'count');

    const mindBtns = document.querySelectorAll('.mind-btn');
    const mindRows = document.querySelectorAll('.mind-row');
    mindBtns.forEach((btn) => btn.addEventListener('click', () => {
      const f = btn.getAttribute('data-f');
      mindRows.forEach((row) => {
        let show = true;
        if (f === 'SA') show = row.getAttribute('data-sa') === 'true';
        else if (f !== 'all') show = row.getAttribute('data-s') === f;
        row.style.display = show ? '' : 'none';
      });
      mindBtns.forEach((b) => b.classList.toggle('font-bold', b === btn));
    }));
  </script>
</Layout>
