---
// The Knot Explorer: one shel yad on a 3D arm, and every way of tying it and keeping its yud by the
// bayit, from Shiur 6 of the Hilchot Tefillin chabura (siman 27, sheet #81-94) and the video played
// in the shiur. Built from games/tefillin-trials/src/knots/ by the game's Vite build.
// Deep link to a method: ?m=chabad (ids in src/knots/data.js).
import { tefillinBundle } from '../../lib/tefillin-trials';

const { js, css } = tefillinBundle('knots.html');

const title = 'The Knot Explorer: every way to tie the shel yad | Matthew Miller';
const description = 'The shel yad on a 3D arm: the Ashkenaz and Sefardi knots, the Chabad slipknot, the Chazon Ish’s piece in the ma’abarta, Or LeTzion’s wrap around the bayit, the “Chafetz Chaim knot”, and which way tightening pulls the yud. From the Hilchot Tefillin shiur, with the video.';
const url = 'https://theothermatthewmiller.com/tefillin-trials/knots';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://theothermatthewmiller.com/og-default.jpg" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#14161f" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="canonical" href={url} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;700;900&family=Inter:wght@400;600;800&display=swap" />
  {css.map((href) => <link rel="stylesheet" href={href} />)}
</head>
<body style="margin:0;background:#14161f">
  <div id="knots-root">
    <div style="position:fixed;inset:0;display:grid;place-items:center;color:#e0b54a;font:900 2.4rem 'Frank Ruhl Libre',serif" lang="he" dir="rtl">קֶשֶׁר שֶׁל יָד</div>
  </div>
  {js ? <script type="module" src={js}></script> : <p style="color:#fff;text-align:center;margin-top:40vh">The bundle isn’t built yet.</p>}
</body>
</html>
