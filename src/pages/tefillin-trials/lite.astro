---
// Hineni Lite: the whole Tefillin Trials game on plain three.js (no React, no physics engine, no
// post-processing), so it loads fast on any phone, and playable in VR through WebXR. Built from
// games/tefillin-trials/src/lite/ by the same Vite build as the full game (/tefillin-trials).
// Deep links: ?shiur=5 (or ?level=5), ?level=ward, ?leaderboard.
import { tefillinBundle } from '../../lib/tefillin-trials';

const { js, css } = tefillinBundle('lite.html');

const title = 'Hineni Lite: The Tefillin Trials, fast and in VR | Matthew Miller';
const description = 'The Tefillin Trials on plain three.js: every shiur of Hilchot Tefillin as a level, loads fast on any phone, and playable in a VR headset. Link straight to a shiur with ?shiur=6.';
const url = 'https://theothermatthewmiller.com/tefillin-trials/lite';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://theothermatthewmiller.com/og-default.jpg" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#07080d" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="canonical" href={url} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;700;900&family=Inter:wght@400;600;800&display=swap" />
  {css.map((href) => <link rel="stylesheet" href={href} />)}
  <style is:global>
    .tt-loading { position: fixed; inset: 0; display: grid; place-items: center; color: #e0b54a; font: 900 3rem 'Frank Ruhl Libre', serif; letter-spacing: .1em; background: #07080d; }
    .tt-loading small { display: block; text-align: center; font: 600 .8rem Inter, sans-serif; color: #a9afc6; letter-spacing: .2em; margin-top: .6rem; }
  </style>
</head>
<body style="margin:0;background:#07080d">
  <div id="tefillin-trials-root">
    <div class="tt-loading"><div lang="he" dir="rtl">הִנֵּנִי<small>LITE · LOADING…</small></div></div>
  </div>
  {js ? <script type="module" src={js}></script> : <p style="color:#fff;text-align:center;margin-top:40vh">The game bundle isn’t built yet.</p>}
</body>
</html>
