---
import Layout from '../layouts/Layout.astro';
import TraderJoesSpicesApp from '../components/TraderJoesSpicesApp';
---

<Layout
  title="Trader Joe's Spice Matrix"
  description="An interactive data visualization mapping ingredient crossovers and ratios across 25 Trader Joe's seasoning blends."
>
  <main class="container mx-auto px-4 sm:px-6 lg:px-8 py-12 max-w-7xl">
    <div class="mb-8">
      <a 
        href="/projects" 
        class="inline-flex items-center text-xs font-semibold text-slate-400 hover:text-cyan-400 transition-colors group mb-4"
      >
        <svg class="w-4 h-4 mr-1.5 transform group-hover:-translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Projects
      </a>
    </div>

    <TraderJoesSpicesApp client:load />
  </main>
</Layout>
