      } catch (error) {
        console.error('A critical error occurred in loadVerseNotes:', error);
      }
    }
    
    // Save note for a specific verse
    // *** NEW AND IMPROVED saveNote function ***
    // Saves a specific verse note directly to the Google Sheet via the API.
    async function saveNote(reference) {
      if (!reference) return;

      const saveButton = document.querySelector(`.save-note-btn[data-reference="${reference}"]`);
      const noteElement = document.querySelector(`.verse-note[data-reference="${reference}"]`);

      if (!saveButton || !noteElement) {
        console.error(`Could not find button or textarea for reference: ${reference}`);
        return;
      }
      
      const originalButtonHTML = saveButton.innerHTML;
      saveButton.innerHTML = '<span class="english-ui">Saving...</span><span class="hebrew-ui hidden">שומר...</span>';
      saveButton.disabled = true;

      try {
        // --- DATA COLLECTION ---
        // 1. Get the current value from the general notes textarea.
        const generalNotes = document.getElementById('general-note-textarea').value;

        // 2. Get the current values from ALL verse note textareas on the page.
        //    This ensures we send a complete and up-to-date record to the sheet.
        const verseNotes = {};
        document.querySelectorAll('.verse-note').forEach(textarea => {
          const ref = textarea.dataset.reference;
          if (ref) {
            verseNotes[ref] = textarea.value;
          }
        });
        
        const payload = {
          date: currentDateParam,
          notes: generalNotes,
          verseNotes: verseNotes,
          sheet: currentSchedule || 'default'
        };

        console.log('Sending updated payload to sheet:', payload);

        // --- API CALL ---
        const response = await fetch('/api/save-verse-notes', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        // Always try to parse the response body, whether successful or not
        const responseData = await response.json();
        
        if (!response.ok) {
          // Create an enhanced error with the response data attached
          const error = new Error(responseData.error || responseData.message || `Server responded with status ${response.status}`);
          error.errorData = responseData; // Attach the full error data for detailed error handling
          throw error;
        }

        // --- SUCCESS FEEDBACK ---
        console.log(`Successfully saved note for ${reference} to the sheet.`);
        saveButton.innerHTML = '<span class="english-ui">✓ Saved!</span><span class="hebrew-ui hidden">✓ נשמר!</span>';
        saveButton.classList.remove('bg-blue-600');
        saveButton.classList.add('bg-green-600');

      } catch (error) {
        // --- ERROR FEEDBACK ---
        console.error(`Failed to save note for ${reference}:`, error);
        
        // Get detailed error info if available
        let errorMessage = error.message || 'Unknown error';
        
        // Try to parse more detailed error information from the response
        try {
          if (error.errorData) {
            // Log all error details for debugging
            console.error('Server error details:', error.errorData);
            
            // Create a more informative error message
            if (error.errorData.error) {
              errorMessage = `Error: ${error.errorData.error}`;
            }
            
            // If we have detailed error info from Google Sheets, display it
            if (error.errorData.details?.errorObj) {
              try {
                const parsedError = JSON.parse(error.errorData.details.errorObj);
                if (parsedError.errors && parsedError.errors.length > 0) {
                  const gsError = parsedError.errors[0];
                  errorMessage = `Google Sheets API Error: ${gsError.message} (${gsError.reason})`;
                }
              } catch (e) {
                console.error('Failed to parse Google Sheets error details', e);
              }
            }
          }
        } catch (e) {
          console.error('Failed to process error details', e);
        }
        
        // Show error state in the UI
        saveButton.innerHTML = `<span class="english-ui">Error: ${errorMessage.slice(0, 20)}${errorMessage.length > 20 ? '...' : ''}</span><span class="hebrew-ui hidden">שגיאה</span>`;
        saveButton.classList.remove('bg-blue-600');
        saveButton.classList.add('bg-red-600');
        saveButton.title = errorMessage; // Show full error on hover
        alert(`Could not save note for ${reference}. Error: ${error.message}`);

      } finally {
        // --- RESET BUTTON ---
        // After a few seconds, reset the button's appearance.
        setTimeout(() => {
          saveButton.innerHTML = originalButtonHTML;
          saveButton.disabled = false;
          saveButton.classList.remove('bg-green-600', 'bg-red-600');
          saveButton.classList.add('bg-blue-600');
        }, 2500);
      }
    }

    // Sets up all button clicks and interactions.
    function addAllEventListeners() {
      // *** UPDATE THIS LISTENER ***
      // Individual "Save Note" buttons now trigger a direct save to the sheet.
      document.addEventListener('click', async (e) => { // Make the callback async
        const saveBtn = e.target.closest('.save-note-btn');
        if (saveBtn) {
          e.preventDefault();
          const reference = saveBtn.dataset.reference;
          // The saveNote function now handles everything else.
          await saveNote(reference); 
        }
      });
      
      // Auto-save when textarea loses focus
      document.addEventListener('blur', (e) => {
        if (e.target.matches('.verse-note')) {
          const noteElement = e.target;
          const reference = noteElement.dataset.reference;
          const content = noteElement.value;
          saveNote(reference, content);
        }
      }, true);
      
      // Language toggle for verse text only
      const langButtons = document.querySelectorAll('.lang-toggle');
      if (langButtons.length) {
        langButtons.forEach(button => {
          button.addEventListener('click', () => {
            langButtons.forEach(btn => {
              btn.classList.remove('active', 'bg-blue-600', 'text-white');
              btn.classList.add('bg-gray-200', 'dark:bg-gray-700', 'text-black', 'dark:text-white');
            });
            button.classList.add('active', 'bg-blue-600', 'text-white');
            button.classList.remove('bg-gray-200', 'dark:bg-gray-700', 'text-black', 'dark:text-white');

            const grids = document.querySelectorAll('.grid.md\\:grid-cols-2');
            if (button.id === 'hebrewOnly') {
              document.querySelectorAll('.hebrew-text').forEach(el => el.style.display = 'block');
              document.querySelectorAll('.english-text').forEach(el => el.style.display = 'none');
              grids.forEach(grid => grid.classList.add('single-lang'));
            } else if (button.id === 'englishOnly') {
              document.querySelectorAll('.hebrew-text').forEach(el => el.style.display = 'none');
              document.querySelectorAll('.english-text').forEach(el => el.style.display = 'block');
              grids.forEach(grid => grid.classList.add('single-lang'));
            } else {
              document.querySelectorAll('.hebrew-text').forEach(el => el.style.display = 'block');
              document.querySelectorAll('.english-text').forEach(el => el.style.display = 'block');
              grids.forEach(grid => grid.classList.remove('single-lang'));
            }
          });
        });
      }
      
      // Site-wide UI language toggle
      const siteLanguageToggle = document.getElementById('siteLanguageToggle');
      if (siteLanguageToggle) {
        const applyLanguage = (lang) => {
          if (lang === 'hebrew') {
            document.body.classList.add('hebrew-ui-active');
            document.querySelectorAll('.english-ui').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.hebrew-ui').forEach(el => el.classList.remove('hidden'));
            document.documentElement.dir = 'rtl';
          } else {
            document.body.classList.remove('hebrew-ui-active');
            document.querySelectorAll('.english-ui').forEach(el => el.classList.remove('hidden'));
            document.querySelectorAll('.hebrew-ui').forEach(el => el.classList.add('hidden'));
            document.documentElement.dir = 'ltr';
          }
        };

        // Apply saved language preference
        const savedLang = localStorage.getItem('aviyaUiLanguage') || 'english';
        applyLanguage(savedLang);
        
        siteLanguageToggle.addEventListener('click', () => {
          const newLang = document.body.classList.contains('hebrew-ui-active') ? 'english' : 'hebrew';
          localStorage.setItem('aviyaUiLanguage', newLang);
          applyLanguage(newLang);
        });
      }
      // General Notes "Save" button
      const generalNoteSaveBtn = document.getElementById('general-note-save-btn');
      if (generalNoteSaveBtn) {
        generalNoteSaveBtn.addEventListener('click', async () => {
          const generalNotesTextarea = document.getElementById('general-note-textarea');
          const originalText = generalNoteSaveBtn.innerHTML;
          try {
            await fetch('/api/save-verse-notes', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                date: currentDateParam,
                notes: generalNotesTextarea?.value || '',
                verseNotes: window.currentVerseNotesData || {},
                sheet: currentSchedule || 'default'
              }),
            });
            generalNoteSaveBtn.innerHTML = '<span class="english-ui">✓ Saved</span><span class="hebrew-ui hidden">✓ נשמר</span>';
            setTimeout(() => { generalNoteSaveBtn.innerHTML = originalText; }, 2000);
          } catch (error) {
            console.error('Error saving general notes:', error);
            alert('Error saving general notes');
          }
        });
      }
      
      // Auto-save when textarea loses focus
      document.addEventListener('blur', (e) => {
        if (e.target.matches('.verse-note')) {
          const noteElement = e.target;
          const reference = noteElement.dataset.reference;
          const content = noteElement.value;
          saveNote(reference, content);
        }
      }, true);
      
      // Set up drag and drop for image uploads
      setupImageUpload();
      
      
      
      // Handle window resize for responsive design
      window.addEventListener('resize', () => {
        // Any responsive adjustments can go here
      });
      
      // Handle delete button clicks
      document.addEventListener('click', async (e) => {
        const deleteBtn = e.target.closest('.delete-note-btn');
        if (!deleteBtn) return;
        
        e.preventDefault();
        const reference = deleteBtn.dataset.reference;
        const textarea = document.querySelector(`.verse-note[data-reference="${reference}"]`);
        if (!textarea) return;
        
        const originalButtonText = deleteBtn.innerHTML;
        deleteBtn.disabled = true;
        
        // Update button text
        if (deleteBtn.querySelector('.english-ui')) {
          deleteBtn.querySelector('.english-ui').textContent = 'Deleting...';
        }
        
        try {
          const response = await fetch('/api/delete-verse-note', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              date: currentDateParam,
              reference: reference,
              sheet: currentSchedule || 'default'
            }),
          });
          
          if (response.ok) {
            // Remove from localStorage
            localStorage.removeItem(`note-${reference}`);
            
            // Clear the textarea
            textarea.value = '';
            
            // Show success message
            deleteBtn.innerHTML = '<span class="english-ui">Deleted!</span><span class="hebrew-ui hidden">נמחק!</span>';
            deleteBtn.classList.remove('bg-red-600');
            deleteBtn.classList.add('bg-green-600');
            
            // Reset button after delay
            setTimeout(() => {
              deleteBtn.innerHTML = originalButtonText;
              deleteBtn.disabled = false;
              deleteBtn.classList.remove('bg-green-600');
              deleteBtn.classList.add('bg-red-600');
            }, 2000);
          } else {
            throw new Error('Failed to delete note');
          }
        } catch (error) {
          console.error('Error deleting note:', error);
          deleteBtn.innerHTML = '<span class="english-ui">Error!</span><span class="hebrew-ui hidden">שגיאה!</span>';
          deleteBtn.classList.remove('bg-red-600');
          deleteBtn.classList.add('bg-red-800');
          
          setTimeout(() => {
            deleteBtn.innerHTML = originalButtonText;
            deleteBtn.disabled = false;
            deleteBtn.classList.remove('bg-red-800');
            deleteBtn.classList.add('bg-red-600');
          }, 2000);
        }
      });
      
      console.log('All event listeners are set up.');
    }

    // Setup image upload functionality
    function setupImageUpload() {
      const fileInput = document.getElementById('image-upload');
      const dragDropArea = document.getElementById('drag-drop-area');
      const uploadProgress = document.getElementById('upload-progress');
      const uploadProgressBar = document.getElementById('upload-progress-bar');
      const uploadPercentage = document.getElementById('upload-percentage');
      const uploadStatusEl = document.getElementById('upload-status');

      if (!fileInput) return;

      // Resize client-side to ~400px so the base64 fits in a Google Sheets cell (50K char limit)
      function resizeImage(file, maxWidth = 400, quality = 0.75) {
        return new Promise((resolve, reject) => {
          const img = new Image();
          const url = URL.createObjectURL(file);
          img.onload = () => {
            URL.revokeObjectURL(url);
            const scale = Math.min(1, maxWidth / img.width);
            const canvas = document.createElement('canvas');
            canvas.width = Math.round(img.width * scale);
            canvas.height = Math.round(img.height * scale);
            canvas.getContext('2d').drawImage(img, 0, 0, canvas.width, canvas.height);
            resolve(canvas.toDataURL('image/jpeg', quality));
          };
          img.onerror = reject;
          img.src = url;
        });
      }

      async function uploadFile(file) {
        if (!file || !file.type.startsWith('image/')) {
          alert('Please select an image file.');
          return;
        }

        if (uploadProgress) uploadProgress.classList.remove('hidden');
        if (uploadStatusEl) uploadStatusEl.textContent = 'Processing image...';
        if (uploadProgressBar) uploadProgressBar.style.width = '20%';
        if (uploadPercentage) uploadPercentage.textContent = '20%';

        try {
          // Resize client-side, then send as base64 JSON (avoids FormData/multipart issues on Netlify)
          const dataUrl = await resizeImage(file);

          if (uploadStatusEl) uploadStatusEl.textContent = 'Uploading...';
          if (uploadProgressBar) uploadProgressBar.style.width = '40%';
          if (uploadPercentage) uploadPercentage.textContent = '40%';

          const response = await fetch('/api/upload-image', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              image: dataUrl,
              filename: file.name,
              date: currentDateParam,
              schedule: currentSchedule || 'default',
            }),
          });

          if (uploadProgressBar) uploadProgressBar.style.width = '90%';
          if (uploadPercentage) uploadPercentage.textContent = '90%';

          let result;
          try {
            result = await response.json();
          } catch {
            const text = await response.text().catch(() => '');
            throw new Error(`Server returned non-JSON (${response.status}): ${text.slice(0, 100)}`);
          }

          if (response.ok && result.success) {
            if (uploadProgressBar) uploadProgressBar.style.width = '100%';
            if (uploadPercentage) uploadPercentage.textContent = '100%';
            if (uploadStatusEl) uploadStatusEl.textContent = 'Upload complete!';
            addImageToGallery(result.imageUrl);
            setTimeout(() => {
              if (uploadProgress) uploadProgress.classList.add('hidden');
              if (uploadProgressBar) uploadProgressBar.style.width = '0%';
            }, 2000);
          } else {
            throw new Error(result.error || 'Failed to upload image');
          }
        } catch (error) {
          console.error('Upload error:', error);
          if (uploadStatusEl) {
            uploadStatusEl.textContent = `Error: ${error.message}`;
            uploadStatusEl.className = 'text-xs font-semibold inline-block py-1 px-2 uppercase rounded-full text-red-600 bg-red-200';
          }
          setTimeout(() => {
            if (uploadProgress) uploadProgress.classList.add('hidden');
          }, 4000);
        }
      }

      function addImageToGallery(imageUrl) {
        // Find existing grid or create one
        let imageGrid = document.querySelector('.grid.grid-cols-1.md\\:grid-cols-2');
        if (!imageGrid) {
          // Remove "no images" placeholder if present
          const placeholder = document.querySelector('.mt-10 .bg-gray-100, .mt-10 .bg-gray-800');
          if (placeholder) placeholder.remove();
          imageGrid = document.createElement('div');
          imageGrid.className = 'grid grid-cols-1 md:grid-cols-2 gap-4';
          document.querySelector('.mt-10')?.appendChild(imageGrid);
        }

        const container = document.createElement('div');
        container.className = 'border dark:border-gray-700 rounded-lg overflow-hidden relative group';
        container.innerHTML = `
          <img
            src="${imageUrl}"
            alt="Study image"
            class="w-full h-auto"
            loading="lazy"
            style="opacity:1;"
          />
          <button
            class="delete-image-btn absolute top-2 right-2 bg-red-600 text-white rounded-full w-8 h-8 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-200 shadow-md"
            title="Delete image"
            data-image-path="${imageUrl}"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
        `;
        imageGrid.appendChild(container);
      }

      // File input change
      fileInput.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (file) uploadFile(file);
        fileInput.value = ''; // reset so same file can be re-uploaded
      });

      // Drag and drop
      if (dragDropArea) {
        dragDropArea.addEventListener('dragover', (e) => {
          e.preventDefault();
          dragDropArea.classList.add('border-blue-400', 'bg-blue-50', 'dark:bg-blue-900/30');
        });
        dragDropArea.addEventListener('dragleave', () => {
          dragDropArea.classList.remove('border-blue-400', 'bg-blue-50', 'dark:bg-blue-900/30');
        });
        dragDropArea.addEventListener('drop', (e) => {
          e.preventDefault();
          dragDropArea.classList.remove('border-blue-400', 'bg-blue-50', 'dark:bg-blue-900/30');
          const file = e.dataTransfer.files[0];
          if (file) uploadFile(file);
        });
        dragDropArea.addEventListener('click', () => fileInput.click());
        dragDropArea.style.cursor = 'pointer';
      }
    }
    
    // --- 3. EXECUTE INITIALIZATION LOGIC ---
    addAllEventListeners();

    // Initialize verse notes store so fetchSefariaTexts never hits undefined
    window.currentVerseNotesData = window.currentVerseNotesData || {};

    // Run Sefaria fetch immediately; load notes in parallel (they're independent)
    Promise.allSettled([
      fetchSefariaTexts().catch(e => console.error('Error fetching Sefaria texts:', e)),
      loadVerseNotes().catch(e => console.error('Error loading verse notes:', e)),
    ]);

    // Load available English translations from Sefaria for the first reading
    async function loadTranslationOptions() {
      const select = document.getElementById('translation-select');
      if (!select) return;
      const firstContainer = document.querySelector('div[id^="verse-"]');
      if (!firstContainer) return;
      const refEl = firstContainer.querySelector('h4 .english-ui, h3 .english-ui');
      if (!refEl) return;
      const ref = refEl.textContent.trim().replace(/\s/g, '.');
      try {
        // The text endpoint returns a `versions` array with all available translations
        const resp = await fetch(`https://www.sefaria.org/api/texts/${ref}?context=0`);
        if (!resp.ok) throw new Error('texts fetch failed');
        const data = await resp.json();
        const englishVersions = Array.isArray(data.versions)
          ? data.versions.filter(v => v.language === 'en' && v.versionTitle)
          : [];
        select.innerHTML = '';
        const defaultOpt = document.createElement('option');
        defaultOpt.value = '';
        defaultOpt.textContent = `Default — ${data.versionTitle || 'Sefaria'}`;
        select.appendChild(defaultOpt);
        englishVersions.forEach(v => {
          if (v.versionTitle === data.versionTitle) return; // skip default, already listed
          const opt = document.createElement('option');
          opt.value = v.versionTitle;
          const label = v.shortVersionTitle || v.versionTitle;
          opt.textContent = label.length > 45 ? label.slice(0, 43) + '…' : label;
          opt.title = v.versionTitle;
          select.appendChild(opt);
        });
      } catch (e) {
        select.innerHTML = '<option value="">Default (Sefaria)</option>';
        console.warn('Could not load translation versions:', e);
      }
    }

    // Re-fetch verses when translation changes
    const translationSelect = document.getElementById('translation-select');
    if (translationSelect) {
      translationSelect.addEventListener('change', () => {
        fetchSefariaTexts(translationSelect.value).catch(e => console.error('Error fetching Sefaria texts:', e));
      });
    }

    loadTranslationOptions().catch(() => {});
    
    // Delete image handler (via event delegation so it works for dynamically added images too)
    document.addEventListener('click', async (e) => {
      const deleteBtn = e.target.closest('.delete-image-btn');
      if (!deleteBtn) return;

      e.preventDefault();
      if (!confirm('Are you sure you want to delete this image?')) return;

      const imagePath = deleteBtn.dataset.imagePath;
      const imageContainer = deleteBtn.closest('.relative, .border');
      if (!imageContainer) return;

      imageContainer.style.opacity = '0.5';
      deleteBtn.disabled = true;

      try {
        const response = await fetch('/api/delete-image', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            date: currentDateParam,
            imagePath,
            schedule: currentSchedule || 'default'
          })
        });

        const result = await response.json();
        if (result.success) {
          imageContainer.style.transition = 'opacity 0.4s, transform 0.4s';
          imageContainer.style.opacity = '0';
          imageContainer.style.transform = 'scale(0.9)';
          setTimeout(() => {
            imageContainer.remove();
            const imageGrid = document.querySelector('.grid.grid-cols-1.md\\:grid-cols-2');
            if (imageGrid && imageGrid.children.length === 0) {
              const noImagesDiv = document.createElement('div');
              noImagesDiv.className = 'bg-gray-100 dark:bg-gray-800 border border-dashed dark:border-gray-700 rounded-lg p-10 text-center';
              noImagesDiv.innerHTML = `<p class="text-gray-500 dark:text-gray-400">No images available for this day</p>`;
              imageGrid.parentNode.replaceChild(noImagesDiv, imageGrid);
            }
          }, 450);
        } else {
          throw new Error(result.error || 'Unknown error');
        }
      } catch (error) {
        console.error('Error deleting image:', error);
        alert('Failed to delete image: ' + error.message);
        imageContainer.style.opacity = '1';
        deleteBtn.disabled = false;
      }
    });
    
  } // --- END of initializePage ---
    
    // Initialize the page
    initializePage();
    
    // Also run on Astro page load
    document.addEventListener('astro:page-load', initializePage);
    
    window.initializeSchedulePage = initializePage;
  }); // End DOMContentLoaded
</script>

<script is:inline>
  // Audio recording feature
  document.addEventListener('DOMContentLoaded', function () {
    const getUrlParams = () => {
      const pathParts = window.location.pathname.split('/').filter(Boolean);
      const urlParams = new URLSearchParams(window.location.search);
      const dateParam = pathParts[pathParts.length - 1];
      const schedule = urlParams.get('schedule') || 'default';
      return { dateParam, schedule };
    };

    const { dateParam, schedule } = getUrlParams();

    // Deep-link seek: ?f=filename&t=seconds
    const _searchParams = new URLSearchParams(window.location.search);
    const seekFile = _searchParams.get('f') || '';
    const seekTime = parseFloat(_searchParams.get('t') || '');

    const recordBtn = document.getElementById('record-btn');
    const recordLabel = document.getElementById('record-label');
    const recordTimer = document.getElementById('record-timer');
    const recordingIndicator = document.getElementById('recording-indicator');
    const audioUploadProgress = document.getElementById('audio-upload-progress');
    const recordingsList = document.getElementById('recordings-list');
    const noRecordingsMsg = document.getElementById('no-recordings-msg');

    if (!recordBtn) return;

    // Hide record button entirely if MediaRecorder isn't supported
    if (typeof MediaRecorder === 'undefined' || !navigator.mediaDevices?.getUserMedia) {
      recordBtn.title = 'Audio recording not supported in this browser';
      recordBtn.disabled = true;
      recordBtn.classList.add('opacity-50', 'cursor-not-allowed');
    }

    let mediaRecorder = null;
    let audioChunks = [];
    let timerInterval = null;
    let startTime = null;

    // Pick best supported MIME type — mp4 first for iOS Safari, then webm for Chrome/Firefox
    function getSupportedMimeType() {
      const types = [
        'audio/mp4',
        'audio/webm;codecs=opus',
        'audio/webm',
        'audio/ogg;codecs=opus',
        'audio/ogg',
      ];
      for (const type of types) {
        try {
          if (MediaRecorder.isTypeSupported(type)) return type;
        } catch {}
      }
      return ''; // let browser decide
    }

    function formatDuration(seconds) {
      const m = Math.floor(seconds / 60);
      const s = seconds % 60;
      return `${m}:${s.toString().padStart(2, '0')}`;
    }

    function formatSegmentTime(secs) {
      if (secs == null || isNaN(secs) || secs < 0) return '';
      const m = Math.floor(secs / 60);
      const s = Math.floor(secs % 60);
      return `${m}:${String(s).padStart(2, '0')}`;
    }

    // Speaker label storage keyed per-schedule so "daughter" assignment persists across page reloads
    const SPEAKER_KEY = `speaker-labels-${schedule}`;
    function getSpeakerLabels() {
      try { return JSON.parse(localStorage.getItem(SPEAKER_KEY) || '{}'); } catch { return {}; }
    }
    function setSpeakerLabel(speakerId, name) {
      const labels = getSpeakerLabels();
      labels[speakerId] = name;
      localStorage.setItem(SPEAKER_KEY, JSON.stringify(labels));
    }

    // Returns an HTML string for a diarized transcript with speaker bubbles
    function renderSegments(segments, labels) {
      if (!segments?.length) return '';
      const colors = { SPEAKER_00: 'blue', SPEAKER_01: 'purple' };
      const colorMap = {
        blue: 'bg-blue-50 dark:bg-blue-950 border-blue-200 dark:border-blue-800 text-blue-800 dark:text-blue-200',
        purple: 'bg-purple-50 dark:bg-purple-950 border-purple-200 dark:border-purple-800 text-purple-800 dark:text-purple-200',
        labelBlue: 'text-blue-600 dark:text-blue-400',
        labelPurple: 'text-purple-600 dark:text-purple-400',
      };
      return segments.map(seg => {
        const color = colors[seg.speaker] || 'blue';
        const label = labels[seg.speaker] || seg.speaker.replace('SPEAKER_', 'Speaker ');
        const labelColor = color === 'blue' ? colorMap.labelBlue : colorMap.labelPurple;
        const t = seg.start ?? 0;
        return `<div class="flex flex-col gap-0.5 mb-2 segment-block group" data-start="${t}">
          <div class="flex items-center gap-1.5">
            <span class="text-xs font-semibold ${labelColor} speaker-label" data-speaker="${seg.speaker}">${label}</span>
            <span class="text-xs text-gray-400 dark:text-gray-500">${formatSegmentTime(t)}</span>
            <button class="share-segment text-xs opacity-0 group-hover:opacity-50 hover:!opacity-100 transition-opacity ml-1" title="Copy link to this moment" data-start="${t}">🔗</button>
          </div>
          <div class="px-3 py-1.5 rounded-lg border text-sm leading-relaxed cursor-pointer hover:opacity-80 transition-opacity ${colorMap[color]}">${seg.text}</div>
        </div>`;
      }).join('');
    }

    // Extracts questions from a speaker's turns (sentences ending with ?)
    function extractQuestions(segments, speakerId) {
      return segments
        .filter(s => s.speaker === speakerId)
        .flatMap(s => s.text.split(/(?<=[.!?])\s+/))
        .filter(sent => sent.trim().endsWith('?'))
        .map(sent => sent.trim());
    }

    // Renders the daughter insights panel for a recording item
    function renderInsightsPanel(item, segments, labels) {
      let panel = item.querySelector('.insights-panel');
      if (!panel) return;

      const daughterSpeaker = Object.entries(labels).find(([, name]) => name.toLowerCase().includes('daughter') || name.toLowerCase().includes('aviya'))?.[0];
      if (!daughterSpeaker) {
        panel.innerHTML = '<p class="text-xs text-gray-400 dark:text-gray-500 italic">Tap a speaker label below to mark it as your daughter\'s voice to see her questions.</p>';
        return;
      }
      const questions = extractQuestions(segments, daughterSpeaker);
      const name = labels[daughterSpeaker];
      if (!questions.length) {
        panel.innerHTML = `<p class="text-xs text-gray-400 dark:text-gray-500 italic">No questions detected from ${name} yet.</p>`;
        return;
      }
      panel.innerHTML = `
        <p class="text-xs font-semibold text-amber-700 dark:text-amber-400 mb-1">${name}'s Questions</p>
        <ul class="space-y-1">
          ${questions.map(q => `<li class="text-sm text-amber-800 dark:text-amber-200 leading-relaxed">• ${q}</li>`).join('')}
        </ul>`;
    }

    function addRecordingToList(rec) {
      const existingNoMsg = document.getElementById('no-recordings-msg');
      if (existingNoMsg) existingNoMsg.remove();

      const item = document.createElement('div');
      item.className = 'flex flex-col gap-2 p-3 bg-gray-50 dark:bg-gray-800 rounded-lg border dark:border-gray-700';
      if (rec.filename) item.dataset.filename = rec.filename;

      const ts = rec.createdAt ? new Date(rec.createdAt).toLocaleString() : '';
      const dur = rec.duration && parseInt(rec.duration) > 0 ? ` · ${formatDuration(parseInt(rec.duration))}` : '';
      const filename = rec.filename || '';
      const labels = getSpeakerLabels();
      const hasSegments = rec.segments?.length > 0;
      const transcriptHTML = hasSegments
        ? renderSegments(rec.segments, labels)
        : rec.transcript
          ? `<p class="transcript-text text-sm text-gray-700 dark:text-gray-300 leading-relaxed">${rec.transcript}</p>`
          : '';

      item.innerHTML = `
        <div class="flex items-center gap-3">
          <audio controls src="${rec.url}" class="flex-1 h-8 min-w-0"></audio>
          <div class="text-xs text-gray-500 dark:text-gray-400 whitespace-nowrap">${ts}${dur}</div>
          <button class="delete-recording-btn flex-shrink-0 text-red-500 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300 p-1 rounded" title="Delete recording" data-filename="${filename}">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 pointer-events-none" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
          </button>
        </div>
        ${hasSegments ? `<div class="insights-panel p-2 rounded-lg bg-amber-50 dark:bg-amber-950 border border-amber-200 dark:border-amber-800"></div>` : ''}
        <div class="transcript-area">
          ${transcriptHTML || '<p class="transcript-status text-xs text-gray-400 dark:text-gray-500 italic">Transcribing with Whisper…</p>'}
        </div>
        ${rec.transcript && !hasSegments ? `<button class="analyze-speakers-btn self-start text-xs text-purple-600 dark:text-purple-400 hover:underline" data-url="${rec.url}" data-filename="${filename}">Analyze speakers ✦</button>` : ''}
      `;

      if (hasSegments) renderInsightsPanel(item, rec.segments, labels);

      // "Analyze speakers" button on already-transcribed recordings
      item.addEventListener('click', e => {
        const btn = e.target.closest('.analyze-speakers-btn');
        if (btn) {
          btn.textContent = 'Analyzing…';
          btn.disabled = true;
          autoTranscribe(item, btn.dataset.url, btn.dataset.filename).then(() => btn.remove());
          return;
        }
      });

      // Tap a speaker label → prompt to name that speaker
      item.addEventListener('click', e => {
        const el = e.target.closest('.speaker-label');
        if (!el) return;
        const speakerId = el.dataset.speaker;
        const currentLabel = getSpeakerLabels()[speakerId] || '';
        const newName = prompt(`Name this speaker (e.g. "Daughter", "Aviya", "Me"):`, currentLabel);
        if (newName === null) return;
        setSpeakerLabel(speakerId, newName.trim() || speakerId.replace('SPEAKER_', 'Speaker '));
        // Re-render all speaker labels and insights in this item
        const segments = item._segments;
        if (segments) {
          const updatedLabels = getSpeakerLabels();
          item.querySelector('.transcript-area').innerHTML = renderSegments(segments, updatedLabels);
          renderInsightsPanel(item, segments, updatedLabels);
        }
      });

      // Click a segment bubble → seek audio to that timestamp and play
      item.addEventListener('click', e => {
        if (e.target.closest('.speaker-label') || e.target.closest('.share-segment')) return;
        const block = e.target.closest('.segment-block');
        if (!block) return;
        const audio = item.querySelector('audio');
        if (!audio) return;
        const t = parseFloat(block.dataset.start);
        if (!isNaN(t)) { audio.currentTime = t; audio.play().catch(() => {}); }
      });

      // Share-segment button → copy deep link to clipboard
      item.addEventListener('click', e => {
        const btn = e.target.closest('.share-segment');
        if (!btn) return;
        e.stopPropagation();
        const t = parseFloat(btn.dataset.start);
        const url = new URL(window.location.href);
        url.searchParams.set('f', item.dataset.filename || '');
        url.searchParams.set('t', isNaN(t) ? 0 : t);
        navigator.clipboard.writeText(url.toString()).then(() => {
          const orig = btn.textContent;
          btn.textContent = '✓';
          setTimeout(() => { btn.textContent = orig; }, 2000);
        }).catch(() => {
          prompt('Copy this link:', url.toString());
        });
      });

      // If this recording matches a deep-link seek param, jump to that time
      if (seekFile && rec.filename === seekFile && !isNaN(seekTime)) {
        const audio = item.querySelector('audio');
        if (audio) {
          const doSeek = () => {
            audio.currentTime = seekTime;
            audio.play().catch(() => {});
            item.scrollIntoView({ behavior: 'smooth', block: 'center' });
          };
          if (audio.readyState >= 1) doSeek();
          else audio.addEventListener('loadedmetadata', doSeek, { once: true });
        }
      }

      recordingsList.appendChild(item);
      return item;
    }

    function showTranscribeRetry(area, url, filename, msg) {
      area.innerHTML = `
        <p class="text-xs text-red-400 italic mb-1">${msg}</p>
        <button class="retry-transcribe-btn text-xs text-purple-600 dark:text-purple-400 hover:underline">Retry ↺</button>`;
      area.querySelector('.retry-transcribe-btn').addEventListener('click', e => {
        e.stopPropagation();
        area.innerHTML = '<p class="transcript-status text-xs text-gray-400 dark:text-gray-500 italic">Transcribing with Whisper…</p>';
        const item = area.closest('[data-filename]') || area.parentElement;
        autoTranscribe(item, url, filename);
      });
    }

    async function autoTranscribe(item, url, filename) {
      const area = item.querySelector('.transcript-area');
      if (!area) return;
      area.innerHTML = '<p class="transcript-status text-xs text-gray-400 dark:text-gray-500 italic">Transcribing… may take 30–60 sec ⏳</p>';

      try {
        const res = await fetch('/.netlify/functions/transcribe-audio-background', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url, date: dateParam, schedule, filename }),
        });
        if (!res.ok && res.status !== 202) {
          showTranscribeRetry(area, url, filename, 'Failed to start transcription. Try again.');
          return;
        }
      } catch (err) {
        showTranscribeRetry(area, url, filename, `Transcription error: ${err.message}`);
        return;
      }

      // Poll until the transcript appears in the sheet
      const started = Date.now();
      const maxWait = 3 * 60 * 1000;
      const pollInterval = 6000;

      const poll = async () => {
        if (Date.now() - started > maxWait) {
          showTranscribeRetry(area, url, filename, 'Transcription timed out. Try again.');
          return;
        }
        try {
          const pollRes = await fetch(`/api/load-audio?date=${encodeURIComponent(dateParam)}&schedule=${encodeURIComponent(schedule)}`);
          const pollData = await pollRes.json();
          const updated = (pollData.recordings || []).find(r => r.filename === filename);
          if (updated?.segments?.length) {
            item._segments = updated.segments;
            const labels = getSpeakerLabels();
            area.innerHTML = renderSegments(updated.segments, labels);
            if (!item.querySelector('.insights-panel')) {
              const panel = document.createElement('div');
              panel.className = 'insights-panel p-2 rounded-lg bg-amber-50 dark:bg-amber-950 border border-amber-200 dark:border-amber-800';
              area.insertAdjacentElement('beforebegin', panel);
            }
            renderInsightsPanel(item, updated.segments, labels);
          } else if (updated?.transcript) {
            area.innerHTML = `<p class="transcript-text text-sm text-gray-700 dark:text-gray-300 leading-relaxed">${updated.transcript}</p>`;
          } else {
            setTimeout(poll, pollInterval);
          }
        } catch {
          setTimeout(poll, pollInterval);
        }
      };

      setTimeout(poll, pollInterval);
    }

    async function loadRecordings() {
      try {
        const res = await fetch(`/api/load-audio?date=${encodeURIComponent(dateParam)}&schedule=${encodeURIComponent(schedule)}`);
        const data = await res.json();
        for (const rec of (data.recordings || [])) {
          const item = addRecordingToList(rec);
          if (rec.segments?.length) item._segments = rec.segments;
          if (!rec.transcript) {
            autoTranscribe(item, rec.url, rec.filename);
          }
        }
      } catch (e) {
        console.warn('Could not load recordings:', e);
      }
    }

    loadRecordings();

    recordBtn.addEventListener('click', async () => {
      if (mediaRecorder && mediaRecorder.state === 'recording') {
        mediaRecorder.stop();
        return;
      }

      try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
        const mimeType = getSupportedMimeType();

        mediaRecorder = mimeType
          ? new MediaRecorder(stream, { mimeType })
          : new MediaRecorder(stream);

        audioChunks = [];
        startTime = Date.now();

        mediaRecorder.ondataavailable = (e) => {
          if (e.data.size > 0) audioChunks.push(e.data);
        };

        mediaRecorder.onstop = async () => {
          clearInterval(timerInterval);
          stream.getTracks().forEach(t => t.stop());

          recordBtn.disabled = true;
          recordLabel.textContent = 'Saving...';
          recordTimer.classList.add('hidden');
          recordingIndicator.classList.add('hidden');
          audioUploadProgress.classList.remove('hidden');

          const durationSec = Math.round((Date.now() - startTime) / 1000);
          // Use the recorder's actual mimeType with a guaranteed fallback
          const actualMime = (mediaRecorder.mimeType && mediaRecorder.mimeType !== '')
            ? mediaRecorder.mimeType
            : (mimeType || 'audio/webm');
          const blob = new Blob(audioChunks, { type: actualMime });

          const reader = new FileReader();
          reader.onloadend = async () => {
            try {
              const res = await fetch('/api/save-audio', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  audio: reader.result,
                  date: dateParam,
                  schedule,
                  duration: durationSec,
                }),
              });
              const result = await res.json();
              if (result.success) {
                const rec = {
                  filename: result.filename,
                  url: result.url,
                  duration: durationSec,
                  createdAt: new Date().toISOString(),
                };
                const item = addRecordingToList(rec);
                autoTranscribe(item, result.url, result.filename);
              } else {
                alert('Error saving recording: ' + (result.error || 'Unknown error'));
              }
            } catch (err) {
              alert('Error uploading recording: ' + err.message);
            } finally {
              audioUploadProgress.classList.add('hidden');
              recordBtn.disabled = false;
              recordLabel.textContent = 'Start Recording';
              recordBtn.classList.remove('bg-gray-500');
              recordBtn.classList.add('bg-red-600');
            }
          };
          reader.readAsDataURL(blob);
        };

        mediaRecorder.start();

        recordLabel.textContent = 'Stop Recording';
        recordTimer.classList.remove('hidden');
        recordingIndicator.classList.remove('hidden');
        recordBtn.classList.remove('bg-red-600');
        recordBtn.classList.add('bg-gray-500');

        let elapsed = 0;
        timerInterval = setInterval(() => {
          elapsed++;
          recordTimer.textContent = formatDuration(elapsed);
        }, 1000);

      } catch (err) {
        if (err.name === 'NotAllowedError') {
          alert('Microphone permission denied. Please allow microphone access in your browser settings and reload the page.');
        } else if (err.name === 'NotFoundError') {
          alert('Microphone not accessible. On Mac: check System Settings → Privacy & Security → Microphone and make sure Chrome/Safari is allowed. On phone: close other apps that may be using the mic, then try again.');
        } else {
          alert('Could not start recording: ' + err.message);
        }
      }
    });

    // Upload an existing audio file — uses a signed URL so the file goes
    // directly from the browser to Supabase (no serverless body size limit).
    const audioFileUpload = document.getElementById('audio-file-upload');
    if (audioFileUpload) {
      audioFileUpload.addEventListener('change', async (e) => {
        const file = e.target.files[0];
        if (!file) return;
        audioFileUpload.value = '';

        audioUploadProgress.classList.remove('hidden');
        audioUploadProgress.textContent = 'Preparing upload...';

        try {
          const ext = (file.name.split('.').pop() || 'mp3').toLowerCase();

          // 1. Get a signed upload URL from the server
          const signRes = await fetch('/api/sign-audio-upload', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ date: dateParam, schedule, ext }),
          });
          const signData = await signRes.json();
          if (!signData.signedUrl) throw new Error(signData.error || 'Could not get upload URL');

          // 2. PUT the file directly to Supabase — no 6MB limit
          audioUploadProgress.textContent = 'Uploading...';
          const uploadRes = await fetch(signData.signedUrl, {
            method: 'PUT',
            body: file,
            headers: { 'Content-Type': file.type || 'audio/mpeg' },
          });
          if (!uploadRes.ok) throw new Error('Upload failed (' + uploadRes.status + ')');

          // 3. Record metadata in Google Sheets
          audioUploadProgress.textContent = 'Saving...';
          const metaRes = await fetch('/api/save-audio-meta', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              date: dateParam,
              schedule,
              filename: signData.filename,
              url: signData.publicUrl,
              duration: 0,
            }),
          });
          const metaData = await metaRes.json();
          if (!metaData.success) throw new Error(metaData.error || 'Failed to save metadata');

          const newRec = {
            filename: signData.filename,
            url: signData.publicUrl,
            duration: '',
            createdAt: new Date().toISOString(),
          };
          const item = addRecordingToList(newRec);
          autoTranscribe(item, signData.publicUrl, signData.filename);
        } catch (err) {
          alert('Error uploading file: ' + err.message);
        } finally {
          audioUploadProgress.classList.add('hidden');
        }
      });
    }

    // Delete a recording
    document.addEventListener('click', async (e) => {
      const deleteBtn = e.target.closest('.delete-recording-btn');
      if (!deleteBtn) return;

      if (!confirm('Delete this recording?')) return;

      const filename = deleteBtn.dataset.filename;
      if (!filename) return;

      const item = deleteBtn.closest('[data-filename]');
      if (item) {
        item.style.opacity = '0.5';
        deleteBtn.disabled = true;
      }

      try {
        const res = await fetch('/api/delete-audio', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ filename }),
        });
        const result = await res.json();
        if (result.success) {
          item?.remove();
          if (recordingsList && !recordingsList.querySelector('[data-filename]')) {
            const msg = document.createElement('p');
            msg.className = 'text-gray-400 dark:text-gray-500 text-sm italic';
            msg.id = 'no-recordings-msg';
            msg.textContent = 'No recordings yet for this day.';
            recordingsList.appendChild(msg);
          }
        } else {
          throw new Error(result.error || 'Unknown error');
        }
      } catch (err) {
        alert('Error deleting recording: ' + err.message);
        if (item) {
          item.style.opacity = '1';
          deleteBtn.disabled = false;
        }
      }
    });
  });
</script>