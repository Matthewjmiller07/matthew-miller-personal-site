---
// /transcriptions — hub for the shiur transcription collections.
import Layout from '../../layouts/Layout.astro';

const pageTitle = 'Transcriptions';
---

<Layout title={pageTitle}>
  <main class="raw-page">
    <header class="hero">
      <div class="kicker">TorahAnytime</div>
      <h1>Shiur Transcriptions</h1>
      <p class="sub">
        Full shiurim, transcribed with Whisper and searchable — with listenable
        audio. Click any timestamp to jump the audio to that moment.
        Transcripts are auto-generated: a close paraphrase, not an exact quote.
      </p>
    </header>

    <div class="grid">
      <a class="card" href="/transcriptions/dayan-fuerst">
        <div class="card-body">
          <h2>Dayan Fuerst</h2>
          <p class="count" id="fuerstCount">Loading…</p>
          <p>Shailos, kashrus, tefillah and more — the full TorahAnytime archive,
             transcribed as it completes.</p>
          <span class="go">Browse transcripts →</span>
        </div>
      </a>
      <a class="card" href="https://yutorah-rss.netlify.app/transcripts/" target="_blank" rel="noopener">
        <div class="card-body">
          <h2>Rav Asher Weiss</h2>
          <p class="count">1,114 shiurim</p>
          <p>The complete Rav Asher Weiss TorahAnytime archive, transcribed —
             browsed on the transcript browser.</p>
          <span class="go">Browse transcripts →</span>
        </div>
      </a>
    </div>
  </main>

  <script>
    fetch('/data/fuerst-transcripts.json')
      .then((r) => r.json())
      .then((d) => {
        document.getElementById('fuerstCount').textContent =
          d.length + ' of 408 shiurim transcribed';
      })
      .catch(() => {
        document.getElementById('fuerstCount').textContent = 'Transcription in progress';
      });
  </script>

  <style>
    .raw-page { max-width: 860px; margin: 0 auto; padding: 2.5rem 1.25rem 4rem; }
    .hero { text-align: center; margin-bottom: 2rem; }
    .kicker { font-size: 1.1rem; color: #d4a017; margin: 0 0 .4rem; font-weight: 700;
              text-transform: uppercase; letter-spacing: .12em; }
    .hero h1 { font-size: 2.2rem; margin: 0 0 .8rem; letter-spacing: -.01em; }
    .hero .sub { max-width: 640px; margin: .5rem auto; color: #555; line-height: 1.6; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.4rem; }
    .card { background: #fff; border: 1px solid #e8e2d4; border-radius: 14px;
            padding: 1.6rem; text-decoration: none; transition: border-color .15s; }
    .card:hover { border-color: #d4a017; }
    .card h2 { margin: 0 0 .3rem; color: #1d1a14; font-size: 1.4rem; }
    .card .count { color: #d4a017; font-weight: 700; margin: 0 0 .6rem; }
    .card p { color: #555; line-height: 1.6; margin: 0 0 1rem; }
    .card .go { color: #8a6d1f; font-weight: 600; }
  </style>
</Layout>
