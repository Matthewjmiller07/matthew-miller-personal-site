---
import Layout from '../../layouts/Layout.astro';
import { sheets, source, closing } from '../../data/uriel-simon-reader';

const fmt = (iso: string) =>
  new Date(`${iso}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', timeZone: 'UTC' });
---

<Layout
  title="The Uriel Simon Reader"
  description="A weekly two-page text and teaching on the parasha, in memory of Prof. Uriel Simon z&quot;l (1929–2026), built from his own words."
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,600;1,400&family=Frank+Ruhl+Libre:wght@400;700&display=swap"
  />

  <main class="usi">
    <header class="usi-head">
      <div class="usi-kicker">A text and a teaching, every week</div>
      <h1>The Uriel Simon Reader</h1>
      <div class="usi-zl"><span class="he">לזכר פרופ׳ אוריאל סימון ז״ל</span> · 1929–2026</div>
      <p class="usi-lede">
        Uriel Simon, who taught Bible at Bar-Ilan University for most of his life, died in Jerusalem on
        30 September 2026, at 97. He read the plain sense of the text more closely than almost anyone, and
        argued that doing so is itself a religious act. Each week this reader sets one passage from the
        parasha beside his own words about it, on two printable pages: a text, and a teaching.
      </p>
    </header>

    <ol class="usi-list">
      {sheets.map((s) => (
        <li>
          <a href={`/uriel-simon/${s.slug}`}>
            <div class="usi-row">
              <span class="he usi-he">{s.parshaHe}</span>
              <span class="usi-parsha">{s.parsha}</span>
              <span class="usi-date">Shabbat {fmt(s.shabbat)} · {s.hebDate}</span>
            </div>
            <div class="usi-title">{s.title}</div>
            <div class="usi-dek">{s.dek}</div>
          </a>
          <a class="usi-pdf" href={`/uriel-simon/${s.slug}.pdf`} download>PDF</a>
        </li>
      ))}
    </ol>

    <blockquote class="usi-close">
      <p class="he" lang="he">{closing.he}</p>
      <p class="usi-close-en">{closing.en}</p>
      <cite>
        Uriel Simon, <a href={source.href} target="_blank" rel="noopener noreferrer"><span class="he">{source.title}</span></a>
      </cite>
    </blockquote>

    <p class="usi-note">
      The first weeks follow Simon's essay on Abraham, "{source.titleEn}," from <em>Bakesh Shalom
      Verodfehu</em> (2002). His Hebrew is quoted from the essay as published on Daat; the English
      renderings are ours.
    </p>
  </main>
</Layout>

<style>
  .usi {
    max-width: 46rem; margin: 0 auto; padding: 3rem 1rem 4rem;
    font-family: 'EB Garamond', Georgia, serif; color: #e7e3da;
  }
  :global(.dark) .usi :global(*) { color: inherit; }
  .he { font-family: 'Frank Ruhl Libre', serif; direction: rtl; unicode-bidi: isolate; }
  .usi-kicker { font-size: .75rem; letter-spacing: .18em; text-transform: uppercase; color: #9cc3dd !important; }
  h1 { font-size: 2.6rem; font-weight: 600; line-height: 1.1; margin: .35rem 0; }
  .usi-zl { font-size: 1.15rem; color: #b9b4aa !important; }
  .usi-lede { font-size: 1.15rem; line-height: 1.6; margin-top: 1.25rem; color: #d4cfc5 !important; }

  .usi-list { list-style: none; padding: 0; margin: 2.5rem 0; border-top: 1px solid #3a3f45; }
  .usi-list li { display: flex; gap: 1rem; align-items: flex-start; border-bottom: 1px solid #3a3f45; }
  .usi-list li > a:first-child { flex: 1; display: block; padding: 1.1rem 0; text-decoration: none; }
  .usi-list li > a:first-child:hover .usi-title { text-decoration: underline; }
  .usi-row { display: flex; flex-wrap: wrap; align-items: baseline; gap: .4rem .9rem; }
  .usi-he { font-size: 1.5rem; font-weight: 700; }
  .usi-parsha { font-size: 1.05rem; font-weight: 600; }
  .usi-date { font-size: .85rem; color: #9aa0a7 !important; }
  .usi-title { font-size: 1.35rem; color: #9cc3dd !important; margin-top: .2rem; }
  .usi-dek { font-size: 1rem; color: #b9b4aa !important; font-style: italic; }
  .usi-pdf {
    margin-top: 1.3rem; padding: .3rem .7rem; border: 1px solid #36546a; border-radius: 3px;
    font-size: .75rem; letter-spacing: .1em; color: #d6e6f1 !important; text-decoration: none;
  }
  .usi-pdf:hover { background: #22323d; }

  .usi-close { margin: 2rem 0; padding: 1rem 1.25rem; border-left: 2px solid #5a84a3; background: #1b1f23; }
  .usi-close .he { font-size: 1.2rem; line-height: 1.7; text-align: right; margin: 0 0 .5rem; }
  .usi-close-en { font-style: italic; margin: 0 0 .5rem; }
  .usi-close cite { font-style: normal; font-size: .9rem; color: #9aa0a7 !important; }
  .usi-close a { color: #9cc3dd !important; }
  .usi-note { font-size: .9rem; color: #9aa0a7 !important; }
</style>
