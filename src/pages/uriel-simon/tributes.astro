---
import Layout from '../../layouts/Layout.astro';
import { bio, principalWorks, tributes } from '../../data/uriel-simon-tributes';

const fullText = tributes.filter((t) => t.kind !== 'video' && t.fullText);
const linked = tributes.filter((t) => t.kind !== 'video' && t.kind !== 'audio' && !t.fullText);
const videos = tributes.filter((t) => t.kind === 'video');
const audio = tributes.filter((t) => t.kind === 'audio');

// Short label for the browse index. Facebook posts are labelled by the
// person's name; newspaper pieces by author, with the two Haaretz pieces
// (one Hebrew, one English) told apart by the title's script.
const navLabel = (t: (typeof tributes)[number]): string => {
  if (t.id === 'prof-uriel-simon-z-l') return 'Tradition Online';
  if (t.id === 'the-expulsion-of-ishmael-and-the-binding') return 'Bavua — Expulsion of Ishmael';
  if (t.id === 'frispark') return 'Frispark (Norway)';
  if (t.role === 'Weekly parsha column') return 'Davar — Lech Lecha column';
  if (t.kind === 'audio') return 'The Promised Podcast';
  if (t.kind === 'facebook' || t.kind === 'video' || t.kind === 'essay') return t.title;
  if (t.role.startsWith('Ofer Aderet'))
    return /[\u0590-\u05FF]/.test(t.title)
      ? 'Ofer Aderet (Haaretz, Hebrew)'
      : 'Ofer Aderet (Haaretz, English)';
  return t.role.split(' — ')[0].split(',')[0];
};
---

<Layout
  title="Uriel Simon — Tributes"
  description="Tributes to Prof. Uriel Simon z&quot;l (1929–2026), Bible scholar and spokesman of religious Zionist humanism: reproduced in full where they could be retrieved, linked with the reason stated where they could not."
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,600;1,400&family=Frank+Ruhl+Libre:wght@400;700&display=swap"
  />

  <main class="ust" id="top">
    <nav class="ust-nav" aria-label="Sections">
      <a href="#life">Life &amp; work</a>
      <a href="#browse">Browse</a>
      <a href="#full">In full</a>
      <a href="#linked">Linked</a>
      <a href="#video">Video</a>
      <a href="#funeral">Funeral</a>
      <a href="#gather">Still to gather</a>
    </nav>
    <header class="ust-head">
      <div class="ust-kicker">In memory · <span class="he">לזכר</span></div>
      <h1>Uriel Simon — Tributes</h1>
      <div class="ust-zl"><span class="he">פרופ׳ אוריאל סימון ז״ל</span> · 1929–2026</div>
      <figure class="ust-portrait">
        <img
          src="/uriel-simon/images/simon-van-leer.jpg"
          alt="Prof. Uriel Simon speaking at the Van Leer Jerusalem Institute"
          width="480"
          height="360"
        />
        <figcaption>Prof. Uriel Simon speaking at the Van Leer Jerusalem Institute.</figcaption>
      </figure>
      <p class="ust-lede">
        Uriel Simon, who taught Bible at Bar-Ilan University for most of his life, died at his home in
        Jerusalem on Wednesday 30 September 2026, at 97. This page gathers what was published in his
        memory — the tributes of students, colleagues, family, and institutions, and the newspaper
        obituaries. Where a text could be retrieved it is reproduced here in full; where it sits behind
        a paywall, could not be opened, or is audio-only, it is listed as a linked entry with the reason
        stated.
      </p>
      <p class="ust-links">
        Companion pages: <a href="/uriel-simon/">The Uriel Simon Reader</a> — a weekly text and teaching
        from his own words · <a href="/uriel-simon/uriel-simon-shloshim.pdf">Shloshim volume (PDF, 31 pages)</a> —
        the bilingual tribute book compiled for the shloshim, 29 October 2026.
      </p>
    </header>

    <nav class="ust-index" id="browse" aria-label="Browse the tributes">
      <h2>Browse the tributes</h2>
      <p>Jump straight to any entry — 28 in all.</p>
      <h3>In full · {fullText.length}</h3>
      <ul>
        {fullText.map((t, i) => (
          <li><a href={`#full-${i}`}>{navLabel(t)}</a></li>
        ))}
      </ul>
      <h3>Linked entries · {linked.length}</h3>
      <ul>
        {linked.map((t, i) => (
          <li><a href={`#link-${i}`}>{navLabel(t)}</a></li>
        ))}
      </ul>
      <h3>Video &amp; audio · {videos.length + audio.length}</h3>
      <ul>
        {videos.map((t, i) => (
          <li><a href={`#vid-${i}`}>{navLabel(t)}</a></li>
        ))}
        {audio.map((t, i) => (
          <li><a href={`#aud-${i}`}>{navLabel(t)}</a></li>
        ))}
      </ul>
    </nav>

    <section class="ust-sec" id="life">
      <h2>His life &amp; work</h2>
      {bio.map((p) => <p>{p}</p>)}
      <h3>Principal works</h3>
      <ul class="ust-works">
        {principalWorks.map((w) => <li>{w}</li>)}
      </ul>
    </section>

    <section class="ust-sec" id="full">
      <h2>The tributes — in full</h2>
      <p class="ust-secnote">
        {fullText.length} tributes reproduced in full: Lawrence Kaplan's Facebook essay, ten further
        Facebook tributes from students, colleagues, family, and institutions (pulled in full on
        19 October 2026), <em>Tradition Online</em>'s memorial, and Davar's Lech Lecha column.
      </p>
      {fullText.map((t, i) => (
        <article class="ust-trib" id={`full-${i}`}>
          <h3 lang={t.lang} dir={t.lang === 'he' ? 'rtl' : 'ltr'}>{t.title}</h3>
          <div class="ust-meta">
            {t.role} · {t.date} · {t.lang === 'he' ? 'Hebrew' : t.lang === 'es' ? 'Spanish' : 'English'}
            <span class="ust-badge">Full text</span>
          </div>
          <div class={t.lang === 'he' ? 'ust-body he' : 'ust-body'} dir={t.lang === 'he' ? 'rtl' : 'ltr'}>
            {t.body.map((p) => <p>{p}</p>)}
          </div>
          {t.image && (
            <figure class="ust-photo">
              <img src={t.image} alt={t.imageAlt ?? ''} loading="lazy" />
              {t.imageAlt && <figcaption>{t.imageAlt}</figcaption>}
            </figure>
          )}
          <div class="ust-src">
            {t.sourceUrl ? (
              <a href={t.sourceUrl} target="_blank" rel="noopener noreferrer">Original post</a>
            ) : (
              <span>Original post — link not recorded</span>
            )}
            {t.note && <span class="ust-note"> · {t.note}</span>}
            <a class="ust-top-link" href="#top">↑ Top</a>
          </div>
        </article>
      ))}
    </section>

    <section class="ust-sec" id="linked">
      <h2>Linked entries — summaries &amp; further reading</h2>
      <p class="ust-secnote">
        These are not reproduced in full. The newspaper pieces are summarised here with short
        quotations and linked to the original — most sit behind paywalls or could not be opened from
        here, though the two Makor Rishon memorials are now freely readable in full at the source;
        the podcast tribute is audio-only, and the notices are short.
      </p>
      {linked.map((t, i) => (
        <article class="ust-trib ust-linked" id={`link-${i}`}>
          <h3 lang={t.lang} dir={t.lang === 'he' ? 'rtl' : 'ltr'}>{t.title}</h3>
          <div class="ust-meta">
            {t.role} · {t.date} · {t.lang === 'he' ? 'Hebrew' : t.lang === 'es' ? 'Spanish' : 'English'}
            <span class="ust-badge ust-badge-link">Linked entry</span>
          </div>
          <div class={t.lang === 'he' ? 'ust-body he' : 'ust-body'} dir={t.lang === 'he' ? 'rtl' : 'ltr'}>
            {t.body.map((p) => <p>{p}</p>)}
          </div>
          <div class="ust-src">
            {t.sourceUrl ? (
              <a href={t.sourceUrl} target="_blank" rel="noopener noreferrer">Read / listen at the source</a>
            ) : (
              <span>Source link not recorded</span>
            )}
            {t.note && <span class="ust-note"> · {t.note}</span>}
            <a class="ust-top-link" href="#top">↑ Top</a>
          </div>
        </article>
      ))}
      {audio.map((t, i) => (
        <article class="ust-trib ust-linked" id={`aud-${i}`}>
          <h3>{t.title}</h3>
          <div class="ust-meta">
            {t.role} · {t.date} · English
            <span class="ust-badge ust-badge-link">Audio</span>
          </div>
          <div class="ust-body">
            {t.body.map((p) => <p>{p}</p>)}
          </div>
          <div class="ust-src">
            <a href={t.sourceUrl} target="_blank" rel="noopener noreferrer">Listen at TLV1</a>
            {t.note && <span class="ust-note"> · {t.note}</span>}
            <a class="ust-top-link" href="#top">↑ Top</a>
          </div>
        </article>
      ))}
    </section>

    <section class="ust-sec" id="video">
      <h2>In his memory — video</h2>
      {videos.map((t, i) => (
        <article class="ust-trib" id={`vid-${i}`}>
          <h3 lang={t.lang} dir={t.lang === 'he' ? 'rtl' : 'ltr'}>{t.title}</h3>
          <div class="ust-meta">{t.role} · {t.date}</div>
          <div class="ust-body">
            {t.body.map((p) => <p>{p}</p>)}
          </div>
          {t.sourceUrl && t.sourceUrl.includes('youtube.com') ? (
            <div class="ust-video">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${new URL(t.sourceUrl).searchParams.get('v')}`}
                title={t.title}
                loading="lazy"
                allow="accelerometer; autoplay; encrypted-media; picture-in-picture"
                allowfullscreen
              />
            </div>
          ) : (
            <div class="ust-src">
              <a href={t.sourceUrl} target="_blank" rel="noopener noreferrer">Watch on YouTube</a>
            </div>
          )}
          <p class="ust-top"><a href="#top">↑ Back to top</a></p>
        </article>
      ))}
    </section>

    <section class="ust-sec" id="funeral">
      <h2>Funeral &amp; shloshim</h2>
      <div class="ust-box">
        <p>
          <strong>Funeral:</strong> Wednesday 30 September 2026, 17:00 (19 Tishrei 5787, Chol HaMoed
          Sukkot), Beit Hespeid Kehilat Yerushalayim, Givat Shaul, Jerusalem; burial at Har HaMenuchot.
        </p>
        <p>
          <strong>Shiva:</strong> at his home, Eliezer HaGadol St. 6, apt. 79, Jerusalem, beginning
          motzei Simchat Torah.
        </p>
        <p>
          <strong>Shloshim:</strong> Thursday 29 October 2026 (18 Cheshvan 5787). The bilingual tribute
          volume compiled for the shloshim is linked above as a PDF.
        </p>
      </div>
    </section>

    <section class="ust-sec" id="gather">
      <h2>Still to be gathered</h2>
      <p>
        Two further Facebook posts — by שלמה אהרון (2 October, “my teacher and rabbi,” on Ibn Ezra, the
        Psalms, and the prophetic narratives) and a memorial portrait with a detailed biographical summary
        by ליאה מורן (1 October) — were found in search results; their full captions are still to be
        pulled. No tributes were found on X via the public index, and the platform remains unchecked from
        a logged-in account. Beyond Yeshivat Otniel's notice above, no official memorial pages were found
        from Bar-Ilan University, the Hebrew University, Yad Ben Zvi, Matan, Midreshet Lindenbaum, the
        Shalom Hartman Institute, or the World Zionist Organization. This page will be updated as further
        material is gathered.
      </p>
    </section>

    <p class="ust-note">
      Compiled from the public web, 19 October – 16 November 2026. Texts are reproduced as published;
      the English renderings of Simon's Hebrew in the Reader are the editor's own. Where a newspaper
      piece is summarised rather than reproduced, the reason is stated on its entry.
    </p>
  </main>
</Layout>

<style>
  .ust {
    max-width: 46rem; margin: 0 auto; padding: 3rem 1rem 4rem;
    font-family: 'EB Garamond', Georgia, serif; color: #e7e3da;
  }
  :global(.dark) .ust :global(*) { color: inherit; }
  .he { font-family: 'Frank Ruhl Libre', serif; direction: rtl; unicode-bidi: isolate; }
  .ust-kicker { font-size: .75rem; letter-spacing: .18em; text-transform: uppercase; color: #9cc3dd !important; }
  h1 { font-size: 2.6rem; font-weight: 600; line-height: 1.1; margin: .35rem 0; }
  .ust-zl { font-size: 1.15rem; color: #b9b4aa !important; }
  .ust-lede { font-size: 1.15rem; line-height: 1.6; margin-top: 1.25rem; color: #d4cfc5 !important; }
  .ust-links { font-size: 1rem; line-height: 1.6; }
  .ust-links a { color: #9cc3dd !important; }
  .ust-portrait { margin: 1.5rem 0 0; }
  .ust-portrait img { display: block; max-width: 22rem; width: 100%; height: auto; border: 1px solid #3a3f45; }
  .ust-portrait figcaption { font-size: .85rem; color: #9aa0a7 !important; margin-top: .4rem; }

  .ust-sec { margin-top: 3rem; }
  .ust-sec > h2 { font-size: 1.7rem; font-weight: 600; border-bottom: 1px solid #3a3f45; padding-bottom: .4rem; }
  .ust-sec > h3 { font-size: 1.25rem; font-weight: 600; margin-top: 1.5rem; }
  .ust-sec p { font-size: 1.1rem; line-height: 1.65; }
  .ust-secnote { font-size: 1rem !important; color: #b9b4aa !important; font-style: italic; }
  .ust-works { font-size: 1.05rem; line-height: 1.7; padding-left: 1.25rem; }
  .ust-works li { margin-bottom: .3rem; }

  .ust-trib { border-top: 1px solid #3a3f45; padding: 1.5rem 0; }
  .ust-trib h3 { font-size: 1.4rem; font-weight: 600; margin: 0 0 .3rem; line-height: 1.3; }
  .ust-meta { font-size: .9rem; color: #9aa0a7 !important; margin-bottom: .9rem; }
  .ust-badge {
    display: inline-block; margin-left: .6rem; padding: .1rem .5rem; border: 1px solid #36546a;
    border-radius: 3px; font-size: .72rem; letter-spacing: .08em; text-transform: uppercase;
    color: #d6e6f1 !important;
  }
  .ust-badge-link { border-color: #5a5344; color: #d8cfae !important; }
  .ust-body p { font-size: 1.1rem; line-height: 1.65; margin: 0 0 .8rem; }
  .ust-body.he { text-align: right; font-size: 1.15rem; line-height: 1.8; }
  .ust-body.he p { font-size: 1.15rem; }
  .ust-photo { margin: 1rem 0 0; }
  .ust-photo img { display: block; max-width: 100%; height: auto; border: 1px solid #3a3f45; }
  .ust-photo figcaption { font-size: .85rem; color: #9aa0a7 !important; margin-top: .4rem; }
  .ust-src { font-size: .95rem; margin-top: .9rem; }
  .ust-src a { color: #9cc3dd !important; }
  .ust-note { color: #9aa0a7 !important; }
  .ust-video { position: relative; padding-bottom: 56.25%; height: 0; margin-top: 1rem; }
  .ust-video iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; }
  .ust-box { background: #1b1f23; border-left: 2px solid #5a84a3; padding: 1rem 1.25rem; }
  .ust-box p { margin: 0 0 .6rem; }
  .ust-box p:last-child { margin-bottom: 0; }
  .ust-note { font-size: .9rem; color: #9aa0a7 !important; margin-top: 3rem; }

  /* In-page navigation: sticky section bar + browse index. The global navbar
     is sticky at 4rem high, so this bar sticks just below it, and anchors
     clear both bars. */
  .ust-nav {
    position: sticky; top: 4rem; z-index: 40; display: flex; gap: .4rem;
    overflow-x: auto; margin: -2rem -1rem 0; padding: .7rem 1rem;
    background: #111827; border-bottom: 1px solid #3a3f45; scrollbar-width: none;
  }
  .ust-nav::-webkit-scrollbar { display: none; }
  .ust-nav a {
    flex: 0 0 auto; padding: .3rem .8rem; border: 1px solid #3a3f45; border-radius: 999px;
    color: #9cc3dd !important; font-size: .9rem; white-space: nowrap; text-decoration: none;
  }
  .ust-index { margin-top: 2.5rem; border: 1px solid #3a3f45; background: #1b1f23; padding: 1.25rem 1.5rem; }
  .ust-index h2 { font-size: 1.3rem; font-weight: 600; margin: 0; }
  .ust-index > p { font-size: 1rem !important; color: #b9b4aa !important; font-style: italic; margin: .3rem 0 0; }
  .ust-index h3 { font-size: .85rem; font-weight: 600; text-transform: uppercase; letter-spacing: .1em; color: #9aa0a7 !important; margin: 1.1rem 0 .4rem; }
  .ust-index ul { columns: 2; column-gap: 2rem; margin: 0; padding-left: 1.1rem; }
  .ust-index li { break-inside: avoid; margin-bottom: .35rem; font-size: 1rem; line-height: 1.45; }
  .ust-index a { color: #9cc3dd !important; }
  .ust-sec, .ust-trib, .ust-index { scroll-margin-top: 7.5rem; }
  .ust-top-link { margin-left: .6rem; color: #9aa0a7 !important; font-size: .85rem; }
  .ust-top { font-size: .9rem !important; margin-top: 1rem; }
  .ust-top a { color: #9aa0a7 !important; }
  @media (max-width: 640px) {
    .ust-index { padding: 1rem; }
    .ust-index ul { columns: 1; }
  }
</style>
