---
import Layout from '../layouts/Layout.astro';

// Every explainer and trailer on the site, newest first. Vertical (9:16) videos get a narrower card.
const videos = [
  { title: 'The Painted Torah', kicker: 'Painted Torah · trailer', src: '/videos/painted-torah-trailer.mp4', poster: '/videos/painted-torah-trailer-poster.jpg',
    blurb: 'Every chapter of the Torah as a painting: Jev picks the verse and art-directs it, FLUX.2 [klein] paints it.', href: '/painted-torah', cta: 'See all 187' },
  { title: 'The Sugya Map', kicker: 'Mega Talmud · trailer', src: '/videos/sugya-map-trailer.mp4', poster: '/videos/sugya-map-trailer-poster.jpg', vertical: true,
    blurb: 'Every segment of Shas, coloured by the move it makes in the argument: 81,709 judgments by Jev.', href: '/mega-talmud#flow', cta: 'Open the Mega Talmud' },
  { title: 'The Bechdel Test, for Tanakh', kicker: 'Mega Bible · trailer', src: '/videos/bechdel-trailer.mp4', poster: '/videos/bechdel-trailer-poster.jpg', vertical: true,
    blurb: 'Two named women who talk to each other about something other than a man. Of 929 chapters, four pass.', href: '/mega-bible?mode=bechdel', cta: 'See every chapter' },
  { title: 'The Language of Blessing', kicker: 'Rav Yaakov Kamenetsky · full video', src: '/videos/language-of-blessing.mp4', poster: '/videos/language-of-blessing-poster.jpg',
    blurb: 'Emet LeYaakov on why the Mechaber and the Rema word Havdalah, Challah and Shemini Atzeret differently.', href: '/language-of-blessing', cta: 'Sources and translations' },
  { title: 'The Language of Blessing', kicker: 'Rav Yaakov Kamenetsky · trailer', src: '/videos/language-of-blessing-trailer.mp4', poster: '/videos/language-of-blessing-poster.jpg', vertical: true,
    blurb: 'Biblical Hebrew vs. the language of the Sages, in 34 seconds.', href: '/language-of-blessing', cta: 'Watch the full video' },
  { title: 'The Book of Generations', kicker: 'Genealogies · trailer', src: '/videos/genealogies-trailer.mp4', poster: '/images/genealogies/poster.jpg',
    blurb: 'Every name in the genealogies of Bereshit and Noach, and who in Israel is still named for them.', href: '/genealogies', cta: 'Explore the family tree' },
  { title: 'The Book of Generations', kicker: 'Genealogies · vertical trailer', src: '/videos/genealogies-trailer-vertical.mp4', poster: '/images/genealogies/poster.jpg', vertical: true,
    blurb: 'The same family tree, cut for a phone screen.', href: '/genealogies', cta: 'Explore the family tree' },
  { title: 'Solomon Learns to Talk', kicker: 'The Workshop · 12 Oct trailer', src: '/newsletter/2026-10-12/trailer.mp4', poster: '/newsletter/2026-10-12/trailer-poster.jpg',
    blurb: 'Solomon learns to talk, the Mishnah goes Mega, and four goats walk into a tithe pen.', href: '/newsletter/2026-10-12', cta: 'Read the issue' },
  { title: 'A Siddur That Knows What Time It Is', kicker: 'The Workshop · 5 Oct trailer', src: '/newsletter/2026-10-05/trailer.mp4', poster: '/newsletter/2026-10-05/trailer-poster.jpg',
    blurb: 'A siddur that knows what time it is, a lamb nobody can claim, and my face in 10,000 letters.', href: '/newsletter/2026-10-05', cta: 'Read the issue' },
  { title: '1 Kings, Out Loud', kicker: 'Mega Bible · lip-sync', src: '/video/929-lipsync/melakhim1-1.mp4', poster: '/videos/melakhim-lipsync-poster.jpg',
    blurb: 'Melakhim Aleph chapter 1 as a full dramatic reading, lip-synced. All 13 chapters play inside the Mega Bible.', href: '/mega-bible', cta: 'Open the Mega Bible' },
  { title: 'Coffee in Halacha', kicker: 'Source sheets · explainer', src: '/coffee-sheets/explainer.mp4', poster: '/videos/coffee-explainer-poster.jpg',
    blurb: 'A source-sheet series tracing the coffee cup through the halachic literature.', href: '/coffee-sheets/', cta: 'Read the sheets' },
  { title: "Trader Joe's Spice Matrix", kicker: 'Data viz · explainer', src: '/tjs-explainer.mp4', poster: '/videos/tjs-explainer-poster.jpg',
    blurb: "Ingredient crossovers and ratios across 25 Trader Joe's seasoning blends.", href: '/tjs', cta: 'Explore the matrix' },
  { title: 'See You Tomorrow', kicker: 'Aaron at 33 · film', src: '/aaron33/see-you-tomorrow.mp4', poster: '/aaron33/poster.jpg',
    blurb: 'A birthday film for my twin brother, made from a WhatsApp archive, a photo album and $2 of API calls.', href: '/aaron-33-film', cta: 'How it was made' },
  { title: 'Kohelet', kicker: 'Kohelet Reader · trailer', src: '/videos/kohelet-trailer.mp4', poster: '/images/kohelet/trailer-a.jpg',
    blurb: "Ecclesiastes with notes and essays drawn from J.J. Kimche's lecture series.", href: '/kohelet', cta: 'Read Kohelet' },
  { title: 'Parasha Books: Bereshit', kicker: 'Parasha Books · trailer', src: '/parasha-books/bereshit/trailer.mp4', poster: '/parasha-books/bereshit/trailer-poster.jpg',
    blurb: 'A peshat picture book, with pesukim from Sefaria on every page.', href: '/parasha-books/bereshit', cta: 'Read the book' },
  { title: 'Parasha Books: Noach', kicker: 'Parasha Books · trailer', src: '/parasha-books/noach/trailer.mp4', poster: '/parasha-books/noach/trailer-poster.jpg',
    blurb: 'A peshat picture book, with pesukim from Sefaria on every page.', href: '/parasha-books/noach', cta: 'Read the book' },
  { title: 'Parasha Books: Lech Lecha', kicker: 'Parasha Books · trailer', src: '/parasha-books/lech-lecha/trailer.mp4', poster: '/parasha-books/lech-lecha/trailer-poster.jpg',
    blurb: 'A peshat picture book, with pesukim from Sefaria on every page.', href: '/parasha-books/lech-lecha', cta: 'Read the book' },
  { title: 'The Workshop', kicker: 'Projects · trailer', src: '/videos/projects-trailer.mp4', poster: '/images/projects/trailer-poster.jpg',
    blurb: 'Everything being built here, in half a minute.', href: '/projects', cta: 'See the projects' },
];
---

<Layout title="Videos" description="Explainers and trailers from the workshop: the Sugya Map, the Bechdel test for Tanakh, Rav Yaakov Kamenetsky's Language of Blessing, and more.">
<main class="vids">
  <div class="kicker">The workshop</div>
  <h1>Videos</h1>
  <p class="lede">Explainers and trailers for what's being built here. Each one links to the thing itself.</p>
  <div class="grid">
    {videos.map((v) => (
      <article class={`v ${v.vertical ? 'tall' : ''}`}>
        <video src={v.src} poster={v.poster} controls playsinline preload="none"></video>
        <div class="k">{v.kicker}</div>
        <h2>{v.title}</h2>
        <p>{v.blurb}</p>
        <a href={v.href}>{v.cta} →</a>
      </article>
    ))}
  </div>
</main>
</Layout>

<style is:global>
  body:has(.vids) { background: #0c0b09 !important; }
  .vids { max-width: 1180px; margin: 0 auto; padding: 3.5rem 16px 5rem; color: #e8d4aa; font-family: 'Cormorant Garamond', Georgia, serif; }
  .vids :is(h1, h2, p, div) { color: inherit; }
  .vids .kicker, .vids .k { font-family: 'Cormorant SC', Georgia, serif; font-size: .72rem; letter-spacing: .3em; text-transform: uppercase; color: #c9a257; }
  .vids h1 { font-weight: 300; font-size: clamp(2.6rem, 7vw, 4.2rem); margin: .4rem 0 .8rem; }
  .vids .lede { font-size: 1.2rem; color: #a8977a; margin-bottom: 2.4rem; }
  .vids .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 2rem 1.6rem; align-items: start; }
  .vids .v video { width: 100%; aspect-ratio: 16 / 9; background: #000; border: 1px solid rgba(201,162,87,.3); display: block; }
  .vids .v.tall video { aspect-ratio: 9 / 16; max-height: 560px; object-fit: contain; }
  .vids .v .k { margin-top: .8rem; letter-spacing: .18em; }
  .vids .v h2 { font-weight: 400; font-size: 1.6rem; margin: .2rem 0 .3rem; }
  .vids .v p { font-size: 1.08rem; line-height: 1.5; color: #a8977a; margin: 0 0 .5rem; }
  .vids .v a { color: #c9a257; text-decoration: none; border-bottom: 1px solid rgba(201,162,87,.5); font-size: 1.05rem; }
</style>
