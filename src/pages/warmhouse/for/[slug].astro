---
// One personal landing page per agent in src/data/warmhouse/agents.json (see the README there).
import WarmHousePage from '../../../components/warmhouse/WarmHousePage.astro';
import agents from '../../../data/warmhouse/agents.json';

export function getStaticPaths() {
  return agents.map((agent) => ({ params: { slug: agent.slug }, props: { agent } }));
}
const { agent } = Astro.props;
---

<WarmHousePage agent={agent} />
