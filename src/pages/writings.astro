---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Writings"
  description="A collection of personal writings, reflections, and thoughts."
>
  <main class="container mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <header class="max-w-3xl mx-auto text-center space-y-4 mb-12">
      <p class="text-sm uppercase tracking-[0.3em] text-secondary-light dark:text-secondary-dark">Personal Reflections</p>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-primary-light dark:text-primary-dark">
        Writings
      </h1>
      <p class="text-base sm:text-lg text-secondary-light dark:text-secondary-dark">
        A collection of personal writings, reflections, and thoughts on life, family, and faith.
      </p>
    </header>

    <section class="max-w-4xl mx-auto">
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        <article class="bg-card-bg-light dark:bg-card-bg-dark border border-border-light dark:border-border-dark rounded-xl shadow-md p-6 hover:shadow-lg transition-shadow duration-300">
          <div class="space-y-4">
            <div class="flex items-center text-sm text-secondary-light dark:text-secondary-dark">
              <time datetime="2024-03-11">March 11, 2024</time>
              <span class="mx-2">•</span>
              <span>Eulogy</span>
            </div>
            <h2 class="text-xl font-semibold text-primary-light dark:text-primary-dark">
              A Legacy of Blessed Contentment
            </h2>
            <p class="text-secondary-light dark:text-secondary-dark line-clamp-3">
              A reflection on the life of Baruch Asher, a man who embodied both blessed self-sufficiency and the pursuit of happiness. A grandfather who raised a beautiful family and left an enduring legacy.
            </p>
            <a 
              href="/writings/legacy-of-blessed-contentment" 
              class="inline-flex items-center text-accent dark:text-accent-dark hover:text-accent-hover dark:hover:text-accent-hover font-medium transition-colors"
            >
              Read More
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </article>

        <!-- Placeholder for future writings -->
        <article class="bg-card-bg-light dark:bg-card-bg-dark border border-border-light dark:border-border-dark rounded-xl shadow-md p-6 opacity-75">
          <div class="space-y-4">
            <div class="flex items-center text-sm text-secondary-light dark:text-secondary-dark">
              <span>Coming Soon</span>
            </div>
            <h2 class="text-xl font-semibold text-primary-light dark:text-primary-dark">
              More Reflections
            </h2>
            <p class="text-secondary-light dark:text-secondary-dark">
              Additional writings and thoughts will be shared here in the future.
            </p>
          </div>
        </article>
      </div>
    </section>
  </main>
</Layout>
