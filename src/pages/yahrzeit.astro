---
import Layout from '../layouts/Layout.astro';

const DAILY_ROOM_URL = import.meta.env.DAILY_ROOM_URL || 'https://theothermatthewmiller.daily.co/Yahrzeit';
---

<Layout
    title="Yahrzeit Shiur Live Stream | Matthew Miller"
    description="Join the live Yahrzeit commemoration shiur. Participate with video, audio, and questions."
>
    <div class="min-h-[calc(100vh-4rem)] bg-gray-950 text-white flex flex-col">
        <div class="container mx-auto px-4 py-8 flex flex-col flex-1">
            <div class="text-center mb-6">
                <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl text-white">
                    Yahrzeit Shiur
                </h1>
                <p class="mt-3 text-lg text-gray-400">
                    Live stream — join with video, audio, and chat
                </p>
            </div>

            <div class="flex-1 rounded-xl overflow-hidden shadow-2xl border border-gray-800" style="min-height: 600px;">
                <iframe
                    id="daily-iframe"
                    src={DAILY_ROOM_URL}
                    allow="camera; microphone; fullscreen; speaker; display-capture"
                    style="width: 100%; height: 100%; min-height: 600px; border: none;"
                    title="Yahrzeit Shiur Live Stream"
                ></iframe>
            </div>

            <div class="mt-6 grid md:grid-cols-3 gap-4 text-sm text-gray-400">
                <div class="bg-gray-900 rounded-lg p-4 border border-gray-800">
                    <div class="text-white font-semibold mb-1">📚 About This Shiur</div>
                    <p>A live Yahrzeit commemoration shiur with interactive participation.</p>
                </div>
                <div class="bg-gray-900 rounded-lg p-4 border border-gray-800">
                    <div class="text-white font-semibold mb-1">🎥 Participating</div>
                    <p>Enable your camera and mic to show your face and ask questions live.</p>
                </div>
                <div class="bg-gray-900 rounded-lg p-4 border border-gray-800">
                    <div class="text-white font-semibold mb-1">💬 Questions</div>
                    <p>Use the built-in chat to ask questions or just watch along quietly.</p>
                </div>
            </div>
        </div>
    </div>
</Layout>
