---
import Layout from '../layouts/Layout.astro';

const DAILY_ROOM_URL = import.meta.env.DAILY_ROOM_URL || 'https://theothermatthewmiller.daily.co/Yahrzeit';
---

<Layout
    title="Yahrzeit Shiur Live Stream | Matthew Miller"
    description="Join the live Yahrzeit commemoration shiur. Participate with video, audio, and questions."
>
    <div class="min-h-[calc(100vh-4rem)] bg-gray-950 text-white flex flex-col">
        <div class="container mx-auto px-4 py-8 flex flex-col flex-1">
            <div class="text-center mb-6">
                <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl text-white">
                    Yahrzeit Shiur
                </h1>
                <p class="mt-3 text-lg text-gray-400">
                    Live stream — join with video, audio, and chat
                </p>
                <!-- Countdown timer -->
                <div id="countdown-container" class="mt-6 bg-gray-900 rounded-lg p-4 border border-gray-800 max-w-md mx-auto">
                    <p class="text-sm text-gray-400 mb-2">Next shiur begins:</p>
                    <div class="text-2xl font-bold text-yellow-400" id="countdown">Loading...</div>
                    <div class="mt-2 text-xs text-gray-500">
                        <div>1:00 PM <span class="text-gray-600">Chicago (CST)</span></div>
                        <div>9:00 PM <span class="text-gray-600">Jerusalem (IST)</span></div>
                        <div>7:00 PM <span class="text-gray-600">London (GMT)</span></div>
                    </div>
                </div>
                <!-- Admin login button -->
                <button
                    id="admin-toggle-btn"
                    class="mt-3 text-xs text-gray-600 hover:text-gray-400 transition-colors underline"
                >
                    Host login
                </button>
            </div>

            <!-- Admin login panel (hidden by default) -->
            <div id="admin-panel" class="hidden mb-4 max-w-sm mx-auto bg-gray-900 border border-gray-700 rounded-lg p-4">
                <p class="text-sm text-gray-300 mb-3 font-semibold">Enter host password to join as admin</p>
                <div class="flex gap-2">
                    <input
                        id="admin-password"
                        type="password"
                        placeholder="Password"
                        class="flex-1 bg-gray-800 border border-gray-600 rounded px-3 py-2 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-blue-500"
                    />
                    <button
                        id="admin-submit-btn"
                        class="bg-blue-600 hover:bg-blue-700 text-white text-sm px-4 py-2 rounded transition-colors"
                    >
                        Join as Host
                    </button>
                </div>
                <p id="admin-error" class="hidden mt-2 text-xs text-red-400">Incorrect password. Try again.</p>
                <p id="admin-success" class="hidden mt-2 text-xs text-green-400">Joined as host!</p>
            </div>

            <div class="flex-1 rounded-xl overflow-hidden shadow-2xl border border-gray-800" style="min-height: 600px;">
                <iframe
                    id="daily-iframe"
                    src={DAILY_ROOM_URL}
                    allow="camera; microphone; fullscreen; speaker; display-capture"
                    style="width: 100%; height: 100%; min-height: 600px; border: none;"
                    title="Yahrzeit Shiur Live Stream"
                ></iframe>
            </div>

            <script define:vars={{ DAILY_ROOM_URL }}>
                const toggleBtn = document.getElementById('admin-toggle-btn');
                const adminPanel = document.getElementById('admin-panel');
                const submitBtn = document.getElementById('admin-submit-btn');
                const passwordInput = document.getElementById('admin-password');
                const errorMsg = document.getElementById('admin-error');
                const successMsg = document.getElementById('admin-success');
                const iframe = document.getElementById('daily-iframe');
                const countdownEl = document.getElementById('countdown');

                // Countdown timer
                function updateCountdown() {
                    const now = new Date();
                    
                    // Calculate today at 1:00 PM CST
                    let todayAt1PM = new Date(now);
                    todayAt1PM.setHours(13, 0, 0, 0); // 1:00 PM
                    
                    // If we've passed today's 1:00 PM, show "Starting now!"
                    const diff = todayAt1PM - now;
                    
                    if (diff <= 0) {
                        countdownEl.textContent = 'Starting now!';
                        return;
                    }
                    
                    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
                    const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                    const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                    const seconds = Math.floor((diff % (1000 * 60)) / 1000);
                    
                    let text = '';
                    if (days > 0) text += `${days}d `;
                    if (hours > 0 || days > 0) text += `${hours}h `;
                    if (minutes > 0 || hours > 0 || days > 0) text += `${minutes}m `;
                    text += `${seconds}s`;
                    
                    countdownEl.textContent = text;
                }
                
                updateCountdown();
                setInterval(updateCountdown, 1000);

                // Admin login functionality
                toggleBtn.addEventListener('click', () => {
                    adminPanel.classList.toggle('hidden');
                    passwordInput.focus();
                });

                async function attemptAdminLogin() {
                    const password = passwordInput.value;
                    if (!password) return;

                    submitBtn.disabled = true;
                    submitBtn.textContent = 'Checking...';
                    errorMsg.classList.add('hidden');
                    successMsg.classList.add('hidden');

                    try {
                        const res = await fetch('/api/yahrzeit-token', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ password }),
                        });
                        const data = await res.json();

                        if (res.ok && data.token) {
                            iframe.src = `${DAILY_ROOM_URL}?t=${data.token}`;
                            successMsg.classList.remove('hidden');
                            toggleBtn.textContent = '✓ Joined as Host';
                            toggleBtn.classList.remove('text-gray-600');
                            toggleBtn.classList.add('text-green-500');
                            setTimeout(() => adminPanel.classList.add('hidden'), 1500);
                        } else {
                            errorMsg.classList.remove('hidden');
                            submitBtn.disabled = false;
                            submitBtn.textContent = 'Join as Host';
                        }
                    } catch {
                        errorMsg.textContent = 'Network error. Try again.';
                        errorMsg.classList.remove('hidden');
                        submitBtn.disabled = false;
                        submitBtn.textContent = 'Join as Host';
                    }
                }

                submitBtn.addEventListener('click', attemptAdminLogin);
                passwordInput.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter') attemptAdminLogin();
                });
            </script>

            <div class="mt-6 grid md:grid-cols-3 gap-4 text-sm text-gray-400">
                <div class="bg-gray-900 rounded-lg p-4 border border-gray-800">
                    <div class="text-white font-semibold mb-1">📚 About This Shiur</div>
                    <p>A live Yahrzeit commemoration shiur with interactive participation.</p>
                </div>
                <div class="bg-gray-900 rounded-lg p-4 border border-gray-800">
                    <div class="text-white font-semibold mb-1">🎥 Participating</div>
                    <p>Enable your camera and mic to show your face and ask questions live.</p>
                </div>
                <div class="bg-gray-900 rounded-lg p-4 border border-gray-800">
                    <div class="text-white font-semibold mb-1">💬 Questions</div>
                    <p>Use the built-in chat to ask questions or just watch along quietly.</p>
                </div>
            </div>

            <section class="mt-12 pb-12">
                <h2 class="text-3xl font-bold text-white mb-2">Source Sheet: Education & Teaching</h2>
                <p class="text-gray-400 text-sm mb-8">Matthew Miller — compiled for the Yahrzeit Shiur</p>

                <!-- TOPIC 1: What is Education? -->
                <div class="mb-10">
                    <h3 class="text-lg font-bold text-yellow-400 uppercase tracking-widest mb-4">I. What Is Education?</h3>
                    <div class="space-y-5">

                        <div class="bg-gray-900 rounded-lg p-5 border border-gray-800 border-l-4 border-l-pink-500">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="text-xs font-bold uppercase tracking-wider bg-pink-900 text-pink-200 px-2 py-0.5 rounded">Philosophy</span>
                                <span class="text-xs text-gray-500">Enlightenment</span>
                            </div>
                            <p class="font-semibold text-white">1. Gotthold Ephraim Lessing (1729–1781), <em>The Education of The Human Race</em>, 1778</p>
                            <blockquote class="mt-2 text-gray-300 italic">Education gives to Man nothing which he might not educe out of himself; it gives him that which he might educe out of himself, only quicker and more easily.</blockquote>
                        </div>

                        <div class="bg-gray-900 rounded-lg p-5 border border-gray-800 border-l-4 border-l-orange-400">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="text-xs font-bold uppercase tracking-wider bg-orange-900 text-orange-200 px-2 py-0.5 rounded">Rabbi</span>
                                <span class="text-xs text-gray-500">Contemporary</span>
                            </div>
                            <p class="font-semibold text-white">2. Rabbi Adin Even-Israel Steinsaltz — <a href="https://www.youtube.com/watch?v=YpF4ZncYqXY&t=334s" target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:underline">What is Love?</a></p>
                            <blockquote class="mt-2 text-gray-300 italic">What is education? In many ways, education is teaching people to appreciate the subject.</blockquote>
                        </div>

                        <div class="bg-gray-900 rounded-lg p-5 border border-gray-800 border-l-4 border-l-green-400">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="text-xs font-bold uppercase tracking-wider bg-green-900 text-green-200 px-2 py-0.5 rounded">Education</span>
                                <span class="text-xs text-gray-500">Contemporary</span>
                            </div>
                            <p class="font-semibold text-white">3. Fred Rogers, <em>The Good Neighbor: The Life and Work of Fred Rogers</em>, p. 328</p>
                            <blockquote class="mt-2 text-gray-300 italic">One of the major goals of education must be to help students discover a greater awareness of their own unique selves, in order to increase their feelings of personal worth, responsibility, and freedom.</blockquote>
                        </div>

                        <div class="bg-gray-900 rounded-lg p-5 border border-gray-800 border-l-4 border-l-indigo-400">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="text-xs font-bold uppercase tracking-wider bg-indigo-900 text-indigo-200 px-2 py-0.5 rounded">Quote</span>
                                <span class="text-xs text-gray-500">Modern</span>
                            </div>
                            <p class="font-semibold text-white">4. Albert Einstein — Plaque, Pasadena City College</p>
                            <blockquote class="mt-2 text-gray-300 italic">It is the supreme art of the teacher to awaken joy in creative expression and knowledge.</blockquote>
                            <p class="mt-1 text-xs text-gray-500">Es ist die wichtigste Kunst des Lehrers, die Freude am Schaffen und am Erkennen zu wecken.</p>
                        </div>

                    </div>
                </div>

                <!-- TOPIC 2: Asking Good Questions -->
                <div class="mb-10">
                    <h3 class="text-lg font-bold text-yellow-400 uppercase tracking-widest mb-4">II. Asking Good Questions</h3>
                    <div class="space-y-5">

                        <div class="bg-gray-900 rounded-lg p-5 border border-gray-800 border-l-4 border-l-lime-400">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="text-xs font-bold uppercase tracking-wider bg-lime-900 text-lime-200 px-2 py-0.5 rounded">Quote</span>
                                <span class="text-xs text-gray-500">Modern</span>
                            </div>
                            <p class="font-semibold text-white">5. <a href="https://www.nytimes.com/1988/01/19/opinion/l-izzy-did-you-ask-a-good-question-today-712388.html" target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:underline">Isidor I. Rabi</a> — Nobel Prize-winning physicist</p>
                            <blockquote class="mt-2 text-gray-300 italic">"My mother made me a scientist without ever intending it. Every other Jewish mother in Brooklyn would ask her child after school: 'So? Did you learn anything today?' But not my mother. She always asked me a different question. 'Izzy,' she would say, 'did you ask a good question today?' That difference — asking good questions — made me become a scientist!"</blockquote>
                        </div>

                        <div class="bg-gray-900 rounded-lg p-5 border border-gray-800 border-l-4 border-l-red-400">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="text-xs font-bold uppercase tracking-wider bg-red-900 text-red-200 px-2 py-0.5 rounded">Talmud</span>
                                <span class="text-xs text-gray-500">Bavli</span>
                            </div>
                            <p class="font-semibold text-white">6. Megillah 32a</p>
                            <blockquote class="mt-2 text-gray-300 italic">Teach mishnah with a melody.</blockquote>
                        </div>

                    </div>
                </div>

                <!-- TOPIC 3: Jewish Sources on Education -->
                <div class="mb-10">
                    <h3 class="text-lg font-bold text-yellow-400 uppercase tracking-widest mb-4">III. Jewish Sources on Education</h3>
                    <div class="space-y-5">

                        <div class="bg-gray-900 rounded-lg p-5 border border-gray-800 border-l-4 border-l-teal-400">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="text-xs font-bold uppercase tracking-wider bg-teal-800 text-teal-200 px-2 py-0.5 rounded">Rashi</span>
                                <span class="text-xs text-gray-500">Medieval Commentary</span>
                            </div>
                            <p class="font-semibold text-white">7. Rashi, Genesis 14:14 — Defining <em>Chinuch</em></p>
                            <p class="mt-3 text-gray-300 text-right text-sm leading-loose" dir="rtl">
                                <strong>חניכיו.</strong> חנכו כְּתִיב (ס"א קְרֵי), זֶה אֱלִיעֶזֶר שֶׁחִנְּכוֹ לְמִצְוֹת וְהוּא לְשׁוֹן הַתְחָלַת כְּנִיסַת הָאָדָם אוֹ כְלִי לָאֻמָּנוּת שֶׁהוּא עָתִיד לַעֲמֹד בָּהּ, וְכֵן חֲנֹךְ לַנַּעַר (משלי כ"ב), חֲנֻכַּת הַמִּזְבֵּחַ (במד' ז'), חֲנֻכַּת הַבַּיִת (תה' ל') ובלע"ז קוֹרִין לוֹ אינצ"נייר:
                            </p>
                            <p class="mt-2 text-gray-400 text-sm italic">"His trained men" — <em>chanecho</em> is the written form (ketiv). This refers to Eliezer, whom he had initiated into the commandments. The word denotes the beginning of a person's or vessel's entry into the craft or role it is destined to fulfill. So too: "Train (<em>chanoch</em>) the youth" (Proverbs 22); "Dedication (<em>chanukat</em>) of the altar" (Numbers 7); "Dedication (<em>chanukat</em>) of the House" (Psalms 30). In Old French this is called <em>enseigner</em> (to initiate/dedicate).</p>
                            <p class="mt-2 text-xs text-gray-500">The root חנ"ך (chinuch) connects <strong>education</strong>, <strong>dedication</strong>, and <strong>initiation</strong> — the first entry of a person or object into its destined purpose.</p>
                        </div>

                        <div class="bg-gray-900 rounded-lg p-5 border border-gray-800 border-l-4 border-l-teal-400">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="text-xs font-bold uppercase tracking-wider bg-teal-800 text-teal-200 px-2 py-0.5 rounded">Rashi</span>
                                <span class="text-xs text-gray-500">Medieval Commentary</span>
                            </div>
                            <p class="font-semibold text-white">8. Rashi, Genesis 18:7</p>
                            <p class="mt-2 text-gray-300 text-right" dir="rtl"><strong>אל הנער.</strong> זֶה יִשְׁמָעֵאל, לְחַנְּכוֹ בְּמִצְוֹת (בראשית רבה)</p>
                            <p class="mt-2 text-gray-400 text-sm italic">"To the young man" — this refers to Ishmael, to educate him in the commandments (Bereishit Rabbah).</p>
                        </div>

                        <div class="bg-gray-900 rounded-lg p-5 border border-gray-800 border-l-4 border-l-purple-400">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="text-xs font-bold uppercase tracking-wider bg-purple-900 text-purple-200 px-2 py-0.5 rounded">Responsa</span>
                                <span class="text-xs text-gray-500">20th Century</span>
                            </div>
                            <p class="font-semibold text-white">9. R. Moshe Feinstein, <em>Darash Moshe</em>, Parshat Emor</p>
                            <p class="mt-2 text-gray-300 text-right text-sm leading-relaxed" dir="rtl">אמר אל הכהנים בני אהרן ואמרת וגו'. פרוש רש"י אמר ואמרת להזהיר גדולים על הקטנים... רק כשישמעו מהאב שאומר שאין שום נסיון בקיום התורה והמצות מכיון שהוא ענין חביב כל כך שהוא חיינו ואורך ימינו אז יתחנכו בטוב.</p>
                            <p class="mt-2 text-gray-400 text-sm italic">Children are not educated merely by being told what to do — they are educated when they see that Torah is beloved to their father, not a burden. Only when they hear that observance is a joy and "our life and the length of our days" will they truly be educated.</p>
                        </div>

                        <div class="bg-gray-900 rounded-lg p-5 border border-gray-800 border-l-4 border-l-purple-600">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="text-xs font-bold uppercase tracking-wider bg-purple-900 text-purple-200 px-2 py-0.5 rounded">Chassidut</span>
                                <span class="text-xs text-gray-500">Chabad</span>
                            </div>
                            <p class="font-semibold text-white">10. <a href="https://outorah.org/p/69296/" target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:underline">R. Menachem Mendel Schneerson, Parshat Emor</a></p>
                            <blockquote class="mt-2 text-gray-300 italic">The opening of our Parsha is hinting to a more advanced approach to education, which becomes relevant after a child has already been taught the basic principles of right and wrong... Chasidic thought explains that Counting the Omer is an advanced form of education, where a person progressively advances to higher levels of spiritual achievement as he refines different aspects of his personality step by step, on a daily basis.</blockquote>
                            <p class="mt-2 text-gray-400 text-sm">The Hebrew term <em>l'hazhir</em> (להזהיר) derives from <em>zohar</em> (זהר), meaning "light" — education is a never-ending process that needs to grow constantly, bringing light to our children.</p>
                            <p class="mt-1 text-xs text-gray-500">Based on Sichas Shabbos Parshas Emor 5750</p>
                        </div>

                        <div class="bg-gray-900 rounded-lg p-5 border border-gray-800 border-l-4 border-l-yellow-500">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="text-xs font-bold uppercase tracking-wider bg-yellow-900 text-yellow-200 px-2 py-0.5 rounded">Rabbi</span>
                                <span class="text-xs text-gray-500">Contemporary</span>
                            </div>
                            <p class="font-semibold text-white">11. R. Yitz Greenberg, <em>The Jewish Way</em>, Chapter 3 (Shavuot)</p>
                            <blockquote class="mt-2 text-gray-300 italic">To teach successfully, teachers must offer a reliable and consistent model. Then God, as parent and teacher, must bind God's own self to humans.</blockquote>
                        </div>

                        <div class="bg-gray-900 rounded-lg p-5 border border-gray-800 border-l-4 border-l-cyan-400">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="text-xs font-bold uppercase tracking-wider bg-cyan-900 text-cyan-200 px-2 py-0.5 rounded">Essay</span>
                                <span class="text-xs text-gray-500">Hebrew Literature</span>
                            </div>
                            <p class="font-semibold text-white">12. <a href="https://benyehuda.org/xayut/bein_haam_031.html" target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:underline">חשיבותה של האוניברסיטה העברית בירושלים — צבי פרץ חיות</a></p>
                        </div>

                        <div class="bg-gray-900 rounded-lg p-5 border border-gray-800 border-l-4 border-l-cyan-600">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="text-xs font-bold uppercase tracking-wider bg-cyan-900 text-cyan-200 px-2 py-0.5 rounded">Talmud</span>
                                <span class="text-xs text-gray-500">Bavli</span>
                            </div>
                            <p class="font-semibold text-white">13. Gemara Sotah 12b</p>
                            <p class="mt-2 text-gray-300 text-right text-sm leading-relaxed" dir="rtl">אמרה אחותו לבת פרעה הלכה וקראתי לך אשה עברית מיניקת לילד. ואמאי עברית? מלמד שהיו מגישין משה לכל נשי מצרים ואינו יונק. אמר: פי שעתיד לדבר עם השכינה יינק מדבר טמא? שנאמר: את דע ידוע ואת הבין שמע זונות משדים ומפרקת שדים.</p>
                            <p class="mt-2 text-gray-400 text-sm italic">"His [Moshe Rabbenu's] sister said to Pharaoh's daughter: 'Shall I go and call for you a Hebrew woman to nurse the child?' Why specifically a Hebrew woman? This teaches us that they presented Moshe to all the Egyptian women but he refused to nurse. He said: 'Shall the mouth that will speak with the Shechina nurse from something impure?' As it states: '[To] whom will he teach knowledge, and to whom will he give understanding? Those weaned from milk, drawn from breasts' (Yeshayahu 28:9)."</p>
                        </div>

                        <div class="bg-gray-900 rounded-lg p-5 border border-gray-800 border-l-4 border-l-cyan-700">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="text-xs font-bold uppercase tracking-wider bg-cyan-900 text-cyan-200 px-2 py-0.5 rounded">Halacha</span>
                                <span class="text-xs text-gray-500">Shulchan Aruch</span>
                            </div>
                            <p class="font-semibold text-white">14. Rema, Yoreh De'ah 81:7</p>
                            <blockquote class="mt-2 text-gray-300 italic">"The milk of a Nachri woman is equivalent to that of a Jewish woman."</blockquote>
                            <p class="mt-2 text-gray-400 text-sm italic">The Gra considers Moshe's refusal of Egyptian wet nurses (Gemara Sotah 12b) as the source for this ruling.</p>
                        </div>

                        
                    </div>
                </div>

                <!-- TOPIC 4: Authenticity & Kavanah in Teaching -->
                <div class="mb-10">
                    <h3 class="text-lg font-bold text-yellow-400 uppercase tracking-widest mb-4">IV. Authenticity & Kavanah in Teaching</h3>
                    <div class="space-y-5">

                        <div class="bg-gray-900 rounded-lg p-5 border border-gray-800 border-l-4 border-l-blue-400">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="text-xs font-bold uppercase tracking-wider bg-blue-900 text-blue-200 px-2 py-0.5 rounded">Rabbi</span>
                                <span class="text-xs text-gray-500">Reconstructionist</span>
                            </div>
                            <p class="font-semibold text-white">15. Mordecai Kaplan, <em>Communings With the Spirit</em>, Vol. 3, p. 132</p>
                            <blockquote class="mt-2 text-gray-300 italic">To pray without "kavanah" (without thinking of what one is saying) is the beginning of emotional dishonesty. The test of any teaching or practice, as to whether it is worthwhile, is whether it can be transmitted to the child. The liturgy in which parents or teachers do not believe cannot be transmitted. This has made of our liturgy a sort of jabberwocky of a people praying like automatons.</blockquote>
                        </div>

                        <div class="bg-gray-900 rounded-lg p-5 border border-gray-800 border-l-4 border-l-blue-600">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="text-xs font-bold uppercase tracking-wider bg-blue-900 text-blue-200 px-2 py-0.5 rounded">Rabbi</span>
                                <span class="text-xs text-gray-500">Reconstructionist</span>
                            </div>
                            <p class="font-semibold text-white">16. Mordecai Kaplan, <em>Communings With the Spirit</em>, Vol. 3, p. 179</p>
                            <blockquote class="mt-2 text-gray-300 italic">The Jewish education system corresponds to the general educational system — elementary, high school, college, and postgraduate stages — corresponding to the four children of the Haggadah. The rebellious spirit of the college-age student, especially the Jewish student, is alluded to in <em>u'lefi shehotzi et atzmo</em> — "because he has withdrawn from the community."</blockquote>
                        </div>

                        <div class="bg-gray-900 rounded-lg p-5 border border-gray-800 border-l-4 border-l-amber-500">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="text-xs font-bold uppercase tracking-wider bg-amber-900 text-amber-200 px-2 py-0.5 rounded">Rabbi</span>
                                <span class="text-xs text-gray-500">Contemporary</span>
                            </div>
                            <p class="font-semibold text-white">17. Rabbi Shai Held, <em>Heart of Torah</em>, Vayera #2, p. 36</p>
                            <blockquote class="mt-2 text-gray-300 italic">Abraham cannot teach what he himself has not yet learned. Abraham needs to learn how to stand up for justice and how to plead for mercy...</blockquote>
                        </div>

                    </div>
                </div>

                <!-- TOPIC 5: Martyrdom & the Limits of Education -->
                <div class="mb-10">
                    <h3 class="text-lg font-bold text-yellow-400 uppercase tracking-widest mb-4">V. Martyrdom & the Limits of Education</h3>
                    <div class="space-y-5">

                        <div class="bg-gray-900 rounded-lg p-5 border border-gray-800 border-l-4 border-l-gray-500">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="text-xs font-bold uppercase tracking-wider bg-gray-700 text-gray-200 px-2 py-0.5 rounded">Halacha</span>
                                <span class="text-xs text-gray-500">Contemporary</span>
                            </div>
                            <p class="font-semibold text-white">18. <a href="https://www.yalkut.info/2019/01/31/%D7%A1%D7%99%D7%9E%D7%9F-%D7%A7%D7%A0%D7%96-%D7%A2%D7%9C-%D7%90%D7%99%D7%96%D7%94-%D7%A2%D7%91%D7%99%D7%A8%D7%95%D7%AA-%D7%99%D7%94%D7%A8%D7%92-%D7%95%D7%90%D7%9C-%D7%99%D7%A2%D7%91%D7%95%D7%A8/" target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:underline">Yalkut Yosef, סימן קנז – על איזה עבירות יהרג ואל יעבור</a></p>
                            <p class="mt-2 text-gray-300 text-right text-sm leading-relaxed" dir="rtl">ג יש אומרים שגם ילד קטן רשאי למסור עצמו להריגה על פי המבואר בסעיף הנ"ל. ויש חולקים, שאיך אפשר לחנכו ליהרג, כאשר לא יגדל להיות מחוייב.</p>
                            <p class="mt-2 text-gray-400 text-sm italic">Some say even a minor child may give his life [for the sanctification of God's name]. Others disagree: how can we educate a child to die, when he will not grow up to become obligated in mitzvot?</p>
                        </div>

                    </div>
                </div>

