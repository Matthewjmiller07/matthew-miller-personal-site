---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Sof Zman Krias Shma — Embeddable Widget"
  description="Live weekly zmanim board for 13 cities. Embed in any website with two lines of HTML."
>
  <main class="container mx-auto px-4 sm:px-6 py-10 max-w-4xl">

    <header class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">
        Sof Zman Krias Shma Board
      </h1>
      <p class="text-gray-600 dark:text-gray-400 max-w-2xl">
        Live weekly zmanim for 13 cities, powered by
        <a href="https://www.hebcal.com" target="_blank" rel="noopener" class="text-cyan-600 dark:text-cyan-400 hover:underline">hebcal.com</a>.
        Embed anywhere with two lines of HTML — no build tools, no React, no setup.
      </p>
    </header>

    <!-- Live demo -->
    <section class="mb-12">
      <h2 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-4">Live Demo</h2>
      <div class="max-w-xs mx-auto">
        <div id="zmanim-widget"></div>
        <script src="/zmanim-widget.js" is:inline></script>
      </div>
    </section>

    <!-- Embed snippet -->
    <section class="mb-10">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">
          Embed on your site
        </h2>
        <button id="copy-embed-btn"
          class="inline-flex items-center gap-1.5 text-xs font-semibold px-4 py-2 rounded-lg bg-cyan-600 hover:bg-cyan-700 text-white transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
          </svg>
          <span id="copy-embed-label">Copy</span>
        </button>
      </div>
      <div class="rounded-xl overflow-hidden border border-slate-200 dark:border-slate-700">
        <pre id="embed-code" class="bg-slate-900 text-slate-100 p-5 text-sm font-mono leading-relaxed overflow-x-auto"><code><span class="text-slate-400">&lt;!-- Paste wherever you want the widget --&gt;</span>
<span class="text-cyan-300">&lt;div</span> <span class="text-yellow-300">id</span>=<span class="text-green-300">"zmanim-widget"</span><span class="text-cyan-300">&gt;&lt;/div&gt;</span>
<span class="text-cyan-300">&lt;script</span> <span class="text-yellow-300">src</span>=<span class="text-green-300">"https://theothermatthewmiller.com/zmanim-widget.js"</span><span class="text-cyan-300">&gt;&lt;/script&gt;</span></code></pre>
      </div>
      <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">
        Works in any HTML page, WordPress, Squarespace, Webflow, or React app.
        Fetches live data from hebcal.com each time it loads.
      </p>
    </section>

    <!-- Full source -->
    <section>
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">
          Full source
        </h2>
        <button id="copy-src-btn"
          class="inline-flex items-center gap-1.5 text-xs font-semibold px-4 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 text-white transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
          </svg>
          <span id="copy-src-label">Copy source</span>
        </button>
      </div>
      <div class="rounded-xl overflow-hidden border border-slate-200 dark:border-slate-700">
        <pre id="src-block" class="bg-slate-900 text-slate-100 p-5 text-xs font-mono leading-relaxed overflow-x-auto max-h-[480px]"><code id="src-code">Loading…</code></pre>
      </div>
    </section>

  </main>
</Layout>

<script>
  fetch('/zmanim-widget.js').then(r => r.text()).then(src => {
    const el = document.getElementById('src-code');
    if (el) el.textContent = src;
  });

  function setupCopy(btnId: string, labelId: string, getText: () => string) {
    const btn   = document.getElementById(btnId);
    const label = document.getElementById(labelId);
    if (!btn || !label) return;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(getText());
        label.textContent = 'Copied!';
        btn.classList.add('!bg-emerald-600');
        setTimeout(() => { label.textContent = labelId.includes('embed') ? 'Copy' : 'Copy source'; btn.classList.remove('!bg-emerald-600'); }, 2000);
      } catch { label.textContent = 'Failed'; setTimeout(() => { label.textContent = labelId.includes('embed') ? 'Copy' : 'Copy source'; }, 2000); }
    });
  }

  setupCopy('copy-embed-btn', 'copy-embed-label', () => document.getElementById('embed-code')?.innerText ?? '');
  setupCopy('copy-src-btn',   'copy-src-label',   () => document.getElementById('src-code')?.textContent ?? '');
</script>
