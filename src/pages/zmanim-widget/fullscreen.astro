---
// Bare page — no nav, no Layout — just the widget filling the screen
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sof Zman Krias Shma</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      height: 100%;
      background: linear-gradient(160deg, #b8956a 0%, #8b6914 40%, #6b4e0a 100%);
      overflow: hidden;
    }

    /* Subtle wood-grain overlay */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        repeating-linear-gradient(2deg, transparent 0px, rgba(0,0,0,0.03) 1px, transparent 2px, transparent 8px),
        repeating-linear-gradient(178deg, transparent 0px, rgba(255,255,255,0.015) 1px, transparent 2px, transparent 20px);
      pointer-events: none;
      z-index: 0;
    }

    #stage {
      position: fixed;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1;
    }

    /* Widget fills as much of the screen as possible while keeping 3:4 ratio */
    #zmanim-widget {
      /* Portrait: limited by height; Landscape: limited by height too (widget is tall) */
      height: 100vh;
      width: calc(100vh * 1086 / 1448);
      max-width: 100vw;
      /* If viewport is portrait and widget would be wider than screen: */
      max-height: calc(100vw * 1448 / 1086);
    }

    /* Utility controls — bottom-left corner */
    #controls {
      position: fixed;
      bottom: 16px;
      left: 16px;
      z-index: 50;
      display: flex;
      gap: 8px;
      opacity: 0.55;
      transition: opacity .2s;
    }
    #controls:hover { opacity: 1; }

    .ctrl-btn {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 6px 12px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 600;
      font-family: system-ui, sans-serif;
      cursor: pointer;
      border: none;
      letter-spacing: .3px;
      text-decoration: none;
    }
    .ctrl-btn-dark  { background: rgba(0,0,0,.55); color: #fff; }
    .ctrl-btn-dark:hover  { background: rgba(0,0,0,.8); }
  </style>
</head>
<body>

  <div id="stage">
    <div id="zmanim-widget"></div>
  </div>

  <!-- Controls: fullscreen toggle + back link -->
  <div id="controls">
    <button id="fs-btn" class="ctrl-btn ctrl-btn-dark" title="Toggle fullscreen">
      <svg id="fs-icon-expand" width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M4 8V6a2 2 0 012-2h2M4 16v2a2 2 0 002 2h2m8-16h2a2 2 0 012 2v2m0 8v2a2 2 0 01-2 2h-2"/>
      </svg>
      <svg id="fs-icon-shrink" width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display:none">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M9 9V7a2 2 0 00-2-2H5m4 4H5m4 0v4m0-4L3 3m12 6V7a2 2 0 012-2h2m-4 2h4m0 0v4m0-4l3-3M9 15v2a2 2 0 01-2 2H5m4-2H5m4 0v-4m0 4l-6 6m12-6v2a2 2 0 002 2h2m-4-2h4m0 0v-4m0 4l3 3"/>
      </svg>
      <span id="fs-label">Fullscreen</span>
    </button>
    <a href="/zmanim-widget" class="ctrl-btn ctrl-btn-dark">
      ← Back
    </a>
  </div>

  <script src="/zmanim-widget.js" is:inline></script>

  <script>
    const fsBtn    = document.getElementById('fs-btn')!;
    const fsExpand = document.getElementById('fs-icon-expand')!;
    const fsShrink = document.getElementById('fs-icon-shrink')!;
    const fsLabel  = document.getElementById('fs-label')!;

    function updateFsUI() {
      const inFs = !!document.fullscreenElement;
      fsExpand.style.display = inFs ? 'none' : '';
      fsShrink.style.display = inFs ? ''     : 'none';
      fsLabel.textContent    = inFs ? 'Exit fullscreen' : 'Fullscreen';
    }

    fsBtn.addEventListener('click', () => {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(() => {});
      } else {
        document.exitFullscreen().catch(() => {});
      }
    });

    document.addEventListener('fullscreenchange', updateFsUI);

    // Auto-enter fullscreen on load if user navigated here intentionally
    // (browsers require a gesture, so we just make it one click away)
  </script>

</body>
</html>
