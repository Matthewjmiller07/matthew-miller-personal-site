---
import Layout from '../layouts/Layout.astro';
import ZmanimApp from '../components/ZmanimApp.tsx';
---

<Layout
  title="Zmanim | Jewish Prayer Times"
  description="Live Jewish prayer times (zmanim) for any location worldwide. Minimalist clock, countdowns, and yearly explorer."
>
  <ZmanimApp client:load />

  <!-- Watchface callout -->
  <div class="fixed bottom-4 right-4 z-50">
    <a
      href="/zmanim-watchface"
      class="flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl bg-black/70 backdrop-blur border border-white/10 hover:border-white/30 text-white/60 hover:text-white/90 transition-all duration-200 text-xs shadow-xl group"
    >
      <span class="text-lg leading-none">⌚</span>
      <div class="leading-tight">
        <div class="font-semibold text-white/80 group-hover:text-white transition-colors">ZmanimFace</div>
        <div class="text-white/40 text-[10px]">Garmin Instinct 2 watchface</div>
      </div>
      <svg class="w-3.5 h-3.5 text-white/30 group-hover:text-white/60 group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</Layout>
